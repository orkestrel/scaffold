{
	"name": "@orkestrel/scaffold",
	"version": "0.0.116",
	"description": "Scaffold workspaces with commands: new, audit, surface, repair, catalog, and overwrite.",
	"keywords": [
		"audit",
		"catalog",
		"new",
		"overwrite",
		"repair",
		"surface"
	],
	"homepage": "https://github.com/orkestrel/scaffold#readme",
	"bugs": "https://github.com/orkestrel/scaffold/issues",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/orkestrel/scaffold.git"
	},
	"bin": {
		"scaffold": "dist/bin/main.js"
	},
	"files": [
		"dist/src",
		"dist/bin",
		"dist/host",
		"dist/agents",
		"README.md"
	],
	"type": "module",
	"sideEffects": [
		"./src/bin/main.ts",
		"./dist/bin/main.js"
	],
	"main": "./dist/src/core/index.cjs",
	"module": "./dist/src/core/index.js",
	"exports": {
		".": {
			"import": {
				"types": "./dist/src/core/index.d.ts",
				"default": "./dist/src/core/index.js"
			},
			"require": {
				"types": "./dist/src/core/index.d.cts",
				"default": "./dist/src/core/index.cjs"
			}
		},
		"./server": {
			"import": {
				"types": "./dist/src/server/index.d.ts",
				"default": "./dist/src/server/index.js"
			},
			"require": {
				"types": "./dist/src/server/index.d.cts",
				"default": "./dist/src/server/index.cjs"
			}
		},
		"./package.json": "./package.json"
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
		"copy": "node -e \"const fs=require('node:fs'),p=require('node:path'),a=process.argv[1],b=process.argv[2];fs.mkdirSync(p.dirname(b),{recursive:true});fs.cpSync(a,b,{force:true});console.log('Copied: '+a+' to '+b)\"",
		"scaffold": "node ./dist/bin/main.js",
		"lint": "oxlint --config .oxlintrc.json --fix .",
		"check": "tsc --noEmit --project tsconfig.json && npm run check:src && npm run check:skills",
		"check:src": "npm run check:src:core && npm run check:src:server && npm run check:src:bin",
		"check:src:core": "tsc --noEmit -p configs/src/tsconfig.core.json",
		"check:src:server": "tsc --noEmit -p configs/src/tsconfig.server.json",
		"check:src:bin": "tsc --noEmit -p configs/src/tsconfig.bin.json",
		"check:skills": "tsc --noEmit -p configs/agents/tsconfig.skills.json",
		"format": "oxfmt --config .oxfmtrc.json --write .",
		"format:check": "oxfmt --config .oxfmtrc.json --check .",
		"lint:check": "oxlint --config .oxlintrc.json --deny-warnings .",
		"test": "npm run test:src:core && npm run test:src:server && npm run test:src:bin && npm run test:policy && npm run test:config && npm run test:setup && npm run test:skills && npm run test:guides",
		"test:src:core": "vitest run --config vite.config.ts --no-cache --reporter=dot --project src:core",
		"test:src:server": "vitest run --config vite.config.ts --no-cache --reporter=dot --project src:server",
		"test:src:bin": "vitest run --config vite.config.ts --no-cache --reporter=dot --project src:bin",
		"test:policy": "vitest run --config vite.config.ts --no-cache --reporter=dot --project policy",
		"test:config": "vitest run --config vite.config.ts --no-cache --reporter=dot --project config",
		"test:guides": "node --experimental-strip-types tests/guides.test.ts",
		"test:skills": "vitest run --config vite.config.ts --no-cache --reporter=dot --project skills",
		"test:templates": "vitest run --config vite.config.ts --no-cache --reporter=dot --project templates",
		"test:distribution": "vitest run --config vite.config.ts --no-cache --reporter=dot --project distribution",
		"test:probe": "vitest run --config vite.config.ts --no-cache --reporter=verbose --project probe",
		"test:bench": "vitest bench --config vite.config.ts --no-cache --project \"probe (bench)\" --mode benchmark",
		"test:setup": "vitest run --config vite.config.ts --no-cache --reporter=dot --project setup",
		"build": "npm run clean && npm run build:src && npm run build:host && npm run build:skills && npm run build:inventory",
		"build:src": "npm run build:src:core && npm run build:src:server && npm run build:src:bin",
		"build:src:core": "vite build --config configs/src/vite.core.config.ts && npm run copy dist/src/core/index.d.ts dist/src/core/index.d.cts",
		"build:src:server": "vite build --config configs/src/vite.server.config.ts && npm run copy dist/src/server/index.d.ts dist/src/server/index.d.cts",
		"build:src:bin": "vite build --config configs/src/vite.bin.config.ts",
		"build:host": "node -e \"import('./dist/src/server/index.js').then((m)=>{const n=m.stageHost(process.cwd(),'dist/host',{report: (message) => console.error(message)}).length;console.log('build-host: staged '+n+' file(s) into dist/host')})\"",
		"build:inventory": "node -e \"import('./dist/src/server/index.js').then((m)=>{const p=process.argv[1]??'host.json',n=m.stageInventory(process.cwd(),p).entries.length;console.log('build-inventory: staged '+n+' file(s) into '+p)})\"",
		"build:skills": "tsc -p configs/agents/tsconfig.skills.json --noEmit false --allowImportingTsExtensions false --rewriteRelativeImportExtensions --declaration false --sourceMap false --rootDir .agents/skills --outDir dist/agents/skills && npm run copy .agents/templates/brief.md dist/agents/templates/brief.md",
		"prepack": "npm run build",
		"prepublishOnly": "npm run format:check && npm run lint:check && npm run check && npm run build && npm test && npm run test:templates && npm run test:distribution -- --mode release"
	},
	"dependencies": {
		"@orkestrel/console": "^0.0.17",
		"@orkestrel/contract": "^0.0.20",
		"@orkestrel/emitter": "^0.0.13",
		"@orkestrel/markdown": "^0.0.18",
		"@orkestrel/process": "^0.0.16",
		"@orkestrel/template": "^0.0.11"
	},
	"devDependencies": {
		"@microsoft/api-extractor": "^7.60.0",
		"@orkestrel/browser": "^0.0.30",
		"@orkestrel/guide": "^0.0.26",
		"@orkestrel/html": "^0.0.13",
		"@orkestrel/probe": "^0.0.26",
		"@orkestrel/test": "^0.0.31",
		"@types/node": "^24.19.2",
		"@vitest/browser-playwright": "^5.0.5",
		"oxfmt": "^0.75.0",
		"oxlint": "^1.90.0",
		"playwright": "^1.64.1",
		"typescript": "^7.0.2",
		"vite": "^8.3.5",
		"vitest": "^5.0.5"
	},
	"engines": {
		"node": ">=22.18.0"
	}
}
