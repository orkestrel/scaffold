diff --git a/tmp/release/run-anchor-gates.mjs b/tmp/release/run-anchor-gates.mjs
new file mode 100644
index 00000000..750e3a10
--- /dev/null
+++ b/tmp/release/run-anchor-gates.mjs
@@ -0,0 +1,197 @@
+import { spawn, spawnSync } from 'node:child_process';
+import { closeSync, lstatSync, mkdirSync, openSync, readFileSync, writeFileSync } from 'node:fs';
+import { dirname, join, resolve } from 'node:path';
+import { performance } from 'node:perf_hooks';
+import { fileURLToPath } from 'node:url';
+
+export class GateRunner {
+  #root = resolve(dirname(fileURLToPath(import.meta.url)), '..', '..');
+  #cap = 900;
+
+  #read(argv, cwd) {
+    const result = spawnSync('git', argv, {
+      cwd,
+      encoding: 'utf8',
+      windowsHide: true,
+      timeout: 30_000,
+      maxBuffer: 16 * 1024 * 1024,
+    });
+    if (result.error || result.status !== 0 || result.signal !== null) {
+      throw new Error(`git ${argv.join(' ')} failed: ${result.error?.message ?? result.stderr}`);
+    }
+    return result.stdout;
+  }
+
+  #inspect(cwd) {
+    return {
+      head: this.#read(['rev-parse', 'HEAD'], cwd).trim(),
+      status: this.#read(['status', '--short'], cwd).split(/\r\n|\n/).filter((line) => line.length > 0),
+    };
+  }
+
+  #terminate(pid) {
+    if (process.platform !== 'win32') {
+      throw new Error('This instrument requires Windows process-tree termination.');
+    }
+    const system = process.env.SystemRoot;
+    if (typeof system !== 'string' || system.length === 0) {
+      throw new Error('SystemRoot is unavailable for recorded-PID termination.');
+    }
+    const result = spawnSync(join(system, 'System32', 'taskkill.exe'), ['/PID', String(pid), '/T', '/F'], {
+      encoding: 'utf8',
+      windowsHide: true,
+      timeout: 30_000,
+    });
+    return {
+      pid,
+      exit: result.status,
+      signal: result.signal,
+      error: result.error?.message,
+      stdout: result.stdout,
+      stderr: result.stderr,
+    };
+  }
+
+  async run() {
+    const [expected, flag, extra] = process.argv.slice(2);
+    if (typeof expected !== 'string' || !/^[a-f0-9]{40}$/.test(expected) ||
+      (flag !== undefined && flag !== '--control') || extra !== undefined) {
+      throw new Error('Usage: node tmp/release/run-anchor-gates.mjs EXPECTED_COMMIT [--control]');
+    }
+    if (process.platform !== 'win32') {
+      throw new Error('This instrument is scoped to the dispatched Windows host.');
+    }
+    const cwd = join(this.#root, 'tmp', 'release', 'scaffold-0.0.75');
+    const before = this.#inspect(cwd);
+    if (before.head !== expected) {
+      throw new Error(`wrong-head: expected ${expected}; found ${before.head}; no output created.`);
+    }
+    const control = flag === '--control';
+    const output = control
+      ? join(this.#root, 'tmp', 'units', 'anchor-gates-control-node-2')
+      : join(cwd, 'tmp', 'units', 'anchor-release-gates-node');
+    try {
+      lstatSync(output);
+      throw new Error(`existing-output: refusing ${output}; retained evidence unchanged.`);
+    } catch (error) {
+      if (!(error instanceof Error) || !('code' in error) || error.code !== 'ENOENT') {
+        throw error;
+      }
+    }
+    // mkdir without recursion is the atomic existing-output refusal, including a raced creation.
+    const npm = join('C:', 'Users', 'mikes', 'scoop', 'apps', 'nodejs-lts', 'current', 'bin', 'node_modules', 'npm');
+    const entry = join(npm, 'bin', 'npm-cli.js');
+    if (!lstatSync(entry).isFile()) {
+      throw new Error(`npm JavaScript entry is not a file: ${entry}`);
+    }
+    const manifest = JSON.parse(readFileSync(join(npm, 'package.json'), 'utf8'));
+    if (typeof manifest !== 'object' || manifest === null || typeof manifest.version !== 'string') {
+      throw new Error('The installed npm manifest supplies no version.');
+    }
+    const packagefile = JSON.parse(readFileSync(join(cwd, 'package.json'), 'utf8'));
+    if (typeof packagefile !== 'object' || packagefile === null ||
+      typeof packagefile.scripts !== 'object' || packagefile.scripts === null ||
+      typeof packagefile.scripts.prepublishOnly !== 'string') {
+      throw new Error('The candidate has no prepublishOnly script.');
+    }
+    try {
+      mkdirSync(output);
+    } catch (error) {
+      if (error instanceof Error && 'code' in error && error.code === 'EEXIST') {
+        throw new Error(`existing-output: refusing ${output}; retained evidence unchanged.`);
+      }
+      throw error;
+    }
+    const logs = {
+      stdout: join(output, 'stdout.log.txt'),
+      stderr: join(output, 'stderr.log.txt'),
+    };
+    const argv = control
+      ? [join(this.#root, 'tmp', 'release', 'anchor-gate-control.mjs')]
+      : [entry, 'run', 'prepublishOnly'];
+    const started = new Date().toISOString();
+    const clock = performance.now();
+    const command = { file: process.execPath, argv, cwd, pid: undefined };
+    const result = { native: undefined, signal: undefined, expired: false, exit: 1, failure: undefined, termination: undefined };
+    let stdout;
+    let stderr;
+    let after;
+    try {
+      stdout = openSync(logs.stdout, 'wx');
+      stderr = openSync(logs.stderr, 'wx');
+      const child = spawn(command.file, argv, {
+        cwd,
+        stdio: ['ignore', stdout, stderr],
+        windowsHide: true,
+      });
+      command.pid = child.pid;
+      const timer = setTimeout(() => {
+        if (child.exitCode !== null || child.signalCode !== null) {
+          return;
+        }
+        result.expired = true;
+        result.failure = `The ${this.#cap}-second cap expired.`;
+        if (typeof command.pid !== 'number') {
+          result.failure = 'The cap expired without a recorded child PID.';
+          return;
+        }
+        try {
+          result.termination = this.#terminate(command.pid);
+        } catch (error) {
+          result.failure = error instanceof Error ? error.message : String(error);
+        }
+      }, this.#cap * 1000);
+      await new Promise((resolve) => {
+        child.once('error', (error) => {
+          result.failure = error.message;
+        });
+        child.once('close', (code, signal) => {
+          clearTimeout(timer);
+          result.native = code;
+          result.signal = signal;
+          if (result.expired) {
+            result.exit = 124;
+          } else if (result.failure !== undefined || code === null || signal !== null) {
+            result.failure ??= `Child closed without a native exit: code=${code}; signal=${signal}`;
+            result.exit = 1;
+          } else {
+            result.exit = code;
+          }
+          resolve();
+        });
+      });
+      after = this.#inspect(cwd);
+    } catch (error) {
+      result.failure = error instanceof Error ? error.message : String(error);
+      result.exit = 1;
+    } finally {
+      if (typeof stdout === 'number') {
+        closeSync(stdout);
+      }
+      if (typeof stderr === 'number') {
+        closeSync(stderr);
+      }
+    }
+    const summary = {
+      started,
+      ended: new Date().toISOString(),
+      duration: (performance.now() - clock) / 1000,
+      cap: this.#cap,
+      labels: control ? ['exit-seven', 'stdout-marker', 'stderr-marker'] : ['prepublishOnly'],
+      candidate: { path: cwd, expected, before, after },
+      toolchain: { node: { path: process.execPath, version: process.version }, npm: { entry, version: manifest.version } },
+      command,
+      script: packagefile.scripts.prepublishOnly,
+      result,
+      logs,
+    };
+    writeFileSync(join(output, 'summary.json'), `${JSON.stringify(summary, undefined, 2)}\n`, { flag: 'wx' });
+    process.stdout.write(`${join(output, 'summary.json')}\n`);
+    process.exitCode = result.exit;
+  }
+}
+
+new GateRunner().run().catch((error) => {
+  process.stderr.write(`${error instanceof Error ? error.message : String(error)}\n`);
+  process.exitCode = 1;
+});
