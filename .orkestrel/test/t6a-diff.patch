+		},
+		add(handler) {
+			handlers.push(handler)
+		},
+		async destroy() {
+			const snapshot = handlers
+			handlers = []
+			const failures: unknown[] = []
+			for (const handler of snapshot.reverse()) {
+				try {
+					await handler()
+				} catch (error) {
+					failures.push(error)
+				}
+			}
+			if (failures.length === 1) throw failures[0]
+			if (failures.length > 1) throw new AggregateError(failures)
+		},
+	}
+}
