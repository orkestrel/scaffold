{
	"name": "roughnotes",
	"version": "0.0.1",
	"private": true,
	"description": "The roughnotes application.",
	"keywords": [],
	"license": "MIT",
	"files": [
		"dist/app",
		"README.md"
	],
	"type": "module",
	"scripts": {
		"clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
		"copy": "node -e \"const fs=require('node:fs'),p=require('node:path'),a=process.argv[1],b=process.argv[2];fs.mkdirSync(p.dirname(b),{recursive:true});fs.cpSync(a,b,{force:true});console.log('Copied: '+a+' to '+b)\"",
		"format": "oxfmt --config .oxfmtrc.json --write .",
		"format:check": "oxfmt --config .oxfmtrc.json --check .",
		"lint": "oxlint --config .oxlintrc.json --fix .",
		"lint:check": "oxlint --config .oxlintrc.json --deny-warnings .",
		"check": "tsc --noEmit --project tsconfig.json && npm run check:app",
		"check:app": "npm run check:app:core && npm run check:app:browser",
		"check:app:core": "tsc --noEmit -p configs/app/tsconfig.core.json",
		"check:app:browser": "vue-tsc --noEmit -p configs/app/tsconfig.browser.json",
		"test": "npm run test:app && npm run test:journey && npm run test:policy && npm run test:config && npm run test:setup && npm run test:conformance",
		"test:app": "vitest run --config vite.config.ts --no-cache --reporter=dot --project app:core --project app:browser",
		"test:app:core": "vitest run --config vite.config.ts --no-cache --reporter=dot --project app:core",
		"test:app:browser": "vitest run --config vite.config.ts --no-cache --reporter=dot --project app:browser",
		"test:journey": "vitest run --config vite.config.ts --no-cache --reporter=dot --project 'journey:*'",
		"test:policy": "vitest run --config vite.config.ts --no-cache --reporter=dot --project policy",
		"test:config": "vitest run --config vite.config.ts --no-cache --reporter=dot --project config",
		"test:setup": "vitest run --config vite.config.ts --no-cache --reporter=dot --project setup",
		"test:conformance": "vitest run --config vite.config.ts --no-cache --reporter=dot --project conformance",
		"test:probe": "vitest run --config vite.config.ts --no-cache --reporter=verbose --project probe",
		"test:bench": "vitest bench --config vite.config.ts --no-cache --project probe",
		"build": "npm run clean && npm run build:app",
		"build:app": "npm run build:app:browser",
		"build:app:browser": "vite build --config configs/app/vite.browser.config.ts",
		"dev": "vite --config configs/app/vite.browser.config.ts"
	},
	"dependencies": {
		"@orkestrel/emitter": "^0.0.10",
		"@orkestrel/router": "^0.0.15"
	},
	"devDependencies": {
		"@orkestrel/contract": "^0.0.17",
		"@orkestrel/guide": "^0.0.20",
		"@orkestrel/html": "^0.0.10",
		"@orkestrel/probe": "^0.0.16",
		"@orkestrel/scaffold": "^0.0.72",
		"@orkestrel/test": "^0.0.16",
		"@popperjs/core": "^2.11.8",
		"@types/bootstrap": "^5.2.11",
		"@types/node": "^26.6.1",
		"@vitejs/plugin-vue": "^6.0.9",
		"@vitest/browser-playwright": "^4.1.11",
		"bootstrap": "^5.3.8",
		"bootstrap-icons": "^1.13.1",
		"oxfmt": "^0.68.0",
		"oxlint": "^1.83.0",
		"playwright": "^1.63.0",
		"sass": "^1.104.0",
		"typescript": "^6.0.3",
		"vite": "^8.3.0",
		"vitest": "^4.1.11",
		"vue": "^3.5.43",
		"vue-tsc": "^3.3.11"
	},
	"engines": {
		"node": ">=22.12.0"
	}
}
