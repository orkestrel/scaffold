+
+function Normalize-Path {
+    param([string]$Path)
+    return [System.IO.Path]::GetFullPath($Path).TrimEnd([System.IO.Path]::DirectorySeparatorChar)
+}
+
+function Invoke-Git {
+    param([string[]]$Arguments)
+    $output = @(& $git -C $root @Arguments)
+    if ($LASTEXITCODE -ne 0) { throw "Git failed: $($Arguments -join ' ')" }
+    return $output
+}
+
+function Get-Snapshot {
+    $hashes = @()
+    foreach ($path in (@('package.json', 'package-lock.json') + $codex)) {
+        $hashes += [ordered]@{
+            path = $path
+            sha256 = (Get-FileHash -LiteralPath (Join-Path $root $path) -Algorithm SHA256).Hash
+        }
+    }
+    return [ordered]@{
+        root = (Normalize-Path -Path (Resolve-Path -LiteralPath $root).ProviderPath)
+        top = (Normalize-Path -Path ((Invoke-Git @('rev-parse', '--show-toplevel')) -join '').Trim())
+        branch = ((Invoke-Git @('branch', '--show-current')) -join '').Trim()
+        head = ((Invoke-Git @('rev-parse', 'HEAD')) -join '').Trim()
+        status = @(Invoke-Git @('status', '--porcelain=v1', '--untracked-files=all'))
+        index = @(Invoke-Git @('ls-files', '-s'))
+        hashes = $hashes
+    }
+}
+
+function Assert-Admission {
+    param($Snapshot)
+    $physical = Normalize-Path -Path $root
+    if ((Normalize-Path $Snapshot.root) -cne $physical -or (Normalize-Path $Snapshot.top) -cne $physical) {
+        throw 'Original root admission failed.'
+    }
+    if ($Snapshot.branch -cne 'main' -or $Snapshot.head -cne $expected) {
+        throw 'Original commit admission failed.'
+    }
+    if ((@($Snapshot.status) -join "`n") -cne ($allowed -join "`n")) {
+        throw 'Original status admission failed.'
+    }
+}
+
+function Assert-Destination {
+    param([string]$Path)
+    if (Test-Path -LiteralPath $Path) { throw 'Install evidence exists; refusing replacement.' }
+}
+
+function Write-Record {
+    param([string]$Path, $Record)
+    [System.IO.File]::WriteAllText($Path, ($Record | ConvertTo-Json -Depth 12), [System.Text.UTF8Encoding]::new($false))
+}
+
+function Invoke-Npm {
+    param([string]$Name, [string[]]$Arguments)
+    $stdout = Join-Path $run ($Name + '.stdout.log.txt')
+    $stderr = Join-Path $run ($Name + '.stderr.log.txt')
+    $command = [ordered]@{
+        executable = $node
+        arguments = @($npm) + $Arguments
+        directory = $root
+        command = ('"' + $node + '" "' + $npm + '" ' + ($Arguments -join ' '))
+        cap = 300
+        time = [DateTime]::UtcNow.ToString('o')
+    }
+    Write-Record -Path (Join-Path $run ($Name + '.command.json')) -Record $command
+    $process = $null
+    $record = [ordered]@{ pid = $null; handle = $null; native = $null; exit = 1; expired = $false; termination = $null; error = $null; time = $null }
+    try {
+        # Start-Process joins arguments on Windows; quote the native npm entry explicitly.
+        $nativeArguments = @('"' + $npm + '"') + $Arguments
+        $process = Start-Process -FilePath $node -ArgumentList $nativeArguments -WorkingDirectory $root -RedirectStandardOutput $stdout -RedirectStandardError $stderr -WindowStyle Hidden -PassThru
+        $record.handle = $process.Handle.ToInt64()
+        $record.pid = $process.Id
+        Write-Record -Path (Join-Path $run ($Name + '.started.json')) -Record $record
+        Write-Host "$Name PID $($record.pid); cap 300 seconds."
+        $record.expired = -not $process.WaitForExit(300000)
+        if ($record.expired) {
+            & "$env:SystemRoot\System32\taskkill.exe" /PID $record.pid /T /F 1> (Join-Path $run ($Name + '.termination.stdout.log.txt')) 2> (Join-Path $run ($Name + '.termination.stderr.log.txt'))
+            $record.termination = $LASTEXITCODE
+            $record.exit = 124
+            if (-not $process.WaitForExit(10000)) { throw "$Name process remained alive after tree termination." }
+        } else {
+            $process.WaitForExit()
+            $record.exit = $process.ExitCode
+        }
+        $record.native = $process.ExitCode
+    } catch {
+        $record.error = $_.Exception.Message
+        if ($null -ne $process -and -not $process.HasExited) {
+            & "$env:SystemRoot\System32\taskkill.exe" /PID $process.Id /T /F 1> (Join-Path $run ($Name + '.termination.stdout.log.txt')) 2> (Join-Path $run ($Name + '.termination.stderr.log.txt'))
+            $record.termination = $LASTEXITCODE
+            if ($process.WaitForExit(10000)) { $record.native = $process.ExitCode }
+        }
+        throw
+    } finally {
+        $record.time = [DateTime]::UtcNow.ToString('o')
+        try { Write-Record -Path (Join-Path $run ($Name + '.result.json')) -Record $record }
+        finally { if ($null -ne $process) { $process.Dispose() } }
+    }
+    return [pscustomobject]$record
+}
