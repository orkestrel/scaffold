diff --git a/tests/src/styles/elements/code.test.ts b/tests/src/styles/elements/code.test.ts
index 378d37d..480a194 100644
--- a/tests/src/styles/elements/code.test.ts
+++ b/tests/src/styles/elements/code.test.ts
@@ -1,8 +1,9 @@
 import { requireValue } from '@orkestrel/test'
 import { matchesColor, readPixels, readStyle, readToken } from '@orkestrel/test/browser'
+import { page } from 'vitest/browser'
 import { afterEach, describe, expect, it } from 'vitest'
 import { scene } from '../../../setupBrowser.js'
-import { TEXT_CODE_CASES } from '../../../setupStyles.js'
+import { TEXT_CODE_CASES, TEXT_MODES } from '../../../setupStyles.js'
 
 afterEach(() => {
 	scene.clear()
@@ -31,4 +32,63 @@ describe('code text treatment', () => {
 			expect(readPixels(element, 'border-top-left-radius')).toBe(radius)
 		},
 	)
+	// Code inside a link takes the link's color, the release's `a > code` rule, so a linked
+	// identifier reads as the link it is at rest and on hover.
+	it.each(TEXT_MODES)(
+		'gives code inside a link the link color at rest and on hover in %s mode',
+		async (mode) => {
+			const host = scene.mount(
+				`<div data-bs-theme="${mode}" style="color: var(--vn-text-body-base)"><a href="#content"><code>identifier</code></a></div>`,
+			)
+			const anchor = requireValue(host.querySelector('a'), 'No anchor')
+			const element = requireValue(host.querySelector('a > code'), 'No linked code')
+			const resting = readStyle(anchor, 'color')
+			expect(matchesColor(readStyle(element, 'color'), resting)).toBe(true)
+			await page.elementLocator(element).hover()
+			// The hover must move the link, or the second reading repeats the first.
+			expect(matchesColor(readStyle(anchor, 'color'), resting)).toBe(false)
+			expect(matchesColor(readStyle(element, 'color'), readStyle(anchor, 'color'))).toBe(true)
+		},
+	)
+	// Code inside a block takes the block's size and color and the release's normal word breaking,
+	// and draws no chip inside the block's surface, the release's `pre code` rule. The block wears a
+	// color of its own and sits under a breaking ancestor, so each inherited reading differs from
+	// the one the bare code rule would give.
+	it.each(TEXT_MODES)(
+		'gives code inside a block the block size, color, and word breaking with no chip in %s mode',
+		(mode) => {
+			const host = scene.mount(
+				`<div data-bs-theme="${mode}" style="word-break: break-all"><pre style="color: var(--vn-text-muted)"><code>alpha\nbeta</code></pre></div>`,
+			)
+			const block = requireValue(host.querySelector('pre'), 'No pre specimen')
+			const element = requireValue(host.querySelector('pre > code'), 'No block code')
+			expect(matchesColor(readStyle(block, 'color'), readToken(block, '--vn-text-code'))).toBe(
+				false,
+			)
+			expect(readStyle(block, 'word-break')).toBe('break-all')
+			expect(readPixels(element, 'font-size')).toBe(readPixels(block, 'font-size'))
+			expect(matchesColor(readStyle(element, 'color'), readStyle(block, 'color'))).toBe(true)
+			expect(
+				Object.fromEntries(
+					[
+						'word-break',
+						'padding-top',
+						'padding-right',
+						'padding-bottom',
+						'padding-left',
+						'background-color',
+						'border-top-left-radius',
+					].map((property) => [property, readStyle(element, property)]),
+				),
+			).toEqual({
+				'word-break': 'normal',
+				'padding-top': '0px',
+				'padding-right': '0px',
+				'padding-bottom': '0px',
+				'padding-left': '0px',
+				'background-color': 'rgba(0, 0, 0, 0)',
+				'border-top-left-radius': '0px',
+			})
+		},
+	)
 })
