new file mode 100644
index 0000000..9ce36e0
--- /dev/null
+++ b/app/browser/sections/ValidationSection.ts
@@ -0,0 +1,20 @@
+import { VALIDATION_COPY, VALIDATION_SPECIMENS } from '../constants.js'
+import { SpecimenSection } from './SpecimenSection.js'
+
+/**
+ * Renders the declared validation specimens into a named region.
+ * @example
+ * ```ts
+ * const section = new ValidationSection(document.body)
+ * section.destroy()
+ * ```
+ */
+export class ValidationSection extends SpecimenSection {
+	/**
+	 * Mounts the Validation region and its specimens.
+	 * @param host - The element receiving the section.
+	 */
+	constructor(host: HTMLElement) {
+		super(host, VALIDATION_COPY, VALIDATION_SPECIMENS)
+	}
+}
