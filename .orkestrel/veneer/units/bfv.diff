+			expect(Object.isFrozen(VALIDATION_SPECIMENS)).toBe(true)
+			expect(VALIDATION_SPECIMENS.every((entry) => Object.isFrozen(entry))).toBe(true)
+		} finally {
+			section.destroy()
+			host.remove()
+		}
+	})
