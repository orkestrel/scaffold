+import { afterEach, describe, expect, it } from 'vitest'
+import { scene } from '../../../setupBrowser.js'
+import { extractShadowLayers, FORM_ICON_CASES } from '../../../setupStyles.js'
+
+afterEach(async () => {
+	await releaseMedia()
+	document.documentElement.removeAttribute('data-bs-theme')
+	scene.clear()
+})
+
+describe('validation classes', () => {
+	it.each(FORM_ICON_CASES)(
+		'paints the $state border and text from the alias the theme declares, in both modes',
+		({ state }) => {
+			const container = scene.mount(
+				`<div data-bs-theme="light" id="light"><input class="form-control is-${state}" aria-label="Light entry"><div class="${state}-feedback">Read this</div></div>` +
+					`<div data-bs-theme="dark" id="dark"><input class="form-control is-${state}" aria-label="Dark entry"><div class="${state}-feedback">Read this</div></div>`,
+			)
+			const readings = ['light', 'dark'].map((mode) => {
+				const scope = requireValue(container.querySelector(`#${mode}`), `No ${mode} island`)
+				const control = requireValue(scope.querySelector('input'), `No ${mode} control`)
+				const feedback = requireValue(
+					scope.querySelector(`.${state}-feedback`),
+					`No ${mode} feedback`,
+				)
+				// The token is read beside the property it drives, so a rule painting the right color
+				// through the wrong name reports here rather than agreeing by coincidence.
+				const border = readToken(control, `--bs-form-${state}-border-color`)
+				const text = readToken(feedback, `--bs-form-${state}-color`)
+				expect(matchesColor(readStyle(control, 'border-top-color'), border)).toBe(true)
+				expect(matchesColor(readStyle(feedback, 'color'), text)).toBe(true)
+				return border
+			})
+			// The valid and invalid aliases resolve through `--vn-form-valid` and `--vn-form-invalid`,
+			// whose values are the role's base fill in light and its emphasis tier in dark, so a mode
+			// the theme never reached would report one color twice.
+			expect(matchesColor(readings[0] ?? '', readings[1] ?? '')).toBe(false)
+		},
+	)
+
+	it.each(FORM_ICON_CASES)(
+		'carries the $state mark on a validated text control and on a single-value select',
+		({ state, image }) => {
+			const container = scene.mount(
+				`<input class="form-control is-${state}" aria-label="Marked entry">` +
+					`<select class="form-select is-${state}" aria-label="Marked choice"><option>One</option></select>` +
+					`<select class="form-select is-${state}" multiple aria-label="Marked choices"><option>One</option></select>` +
+					`<textarea class="form-control is-${state}" aria-label="Marked note"></textarea>` +
+					`<input type="color" class="form-control-color is-${state}" aria-label="Marked shade">`,
+			)
+			const control = requireValue(container.querySelector('input'), 'No marked control')
+			const single = requireValue(container.querySelector('select'), 'No single-value select')
+			const multiple = requireValue(
+				container.querySelector('select[multiple]'),
+				'No multiple select',
+			)
+			const area = requireValue(container.querySelector('textarea'), 'No marked area')
+			const swatch = requireValue(container.querySelector('[type="color"]'), 'No marked swatch')
+			expect(readStyle(control, 'background-image')).toBe(`url("${image}")`)
+			expect(readStyle(control, 'background-repeat')).toBe('no-repeat')
+			// The mark's inset is `calc(0.375em + 0.1875rem)`, which resolves to 8.25px against the
+			// published 14px body type; the reading is the measurement rather than a target, so a
+			// retuned body size moves it and reports here.
+			expect(readStyle(control, 'background-position')).toBe('right 8.25px 50%')
+			expect(readToken(single, '--bs-form-select-bg-icon')).toBe(`url("${image}")`)
+			expect(readPixels(single, 'padding-right')).toBe(66)
+			// The release withholds the mark from a select showing more than one value, so a rule
