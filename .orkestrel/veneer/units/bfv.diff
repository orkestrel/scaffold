+++ b/src/styles/components/_validation.scss
@@ -0,0 +1,127 @@
+@use 'sass:map';
+@use '../tokens';
+
+// Bootstrap emits one validation cascade per state from a single mixin, so the states are a list
+// here and the rules are written once. Each entry carries the state's own name, the role whose
+// published fill and channel triplet the tooltip and the focus ring read, and the stacking order
+// an input-group child takes: invalid sits above valid, which is how a control carrying both
+// states shows the failure.
+$states: ('valid' 'success' 3), ('invalid' 'danger' 4);
+
+@layer components {
+	@each $state, $role, $stack in $states {
+		.#{$state}-feedback {
+			display: none;
+			width: 100%;
+			margin-top: var(--vn-space-2);
+			font-size: 0.875em;
+			color: var(--bs-form-#{$state}-color);
+		}
+
+		.#{$state}-tooltip {
+			position: absolute;
+			top: 100%;
+			z-index: 5;
+			display: none;
+			max-width: 100%;
+			padding: var(--vn-space-2) var(--vn-space-4);
+			margin-top: 0.1rem;
+			font-size: var(--vn-size-2);
+			color: var(--vn-palette-white-base);
+			background-color: var(--bs-#{$role});
+			border-radius: var(--bs-border-radius);
+		}
+
+		.was-validated :#{$state} ~ .#{$state}-feedback,
+		.was-validated :#{$state} ~ .#{$state}-tooltip,
+		.is-#{$state} ~ .#{$state}-feedback,
+		.is-#{$state} ~ .#{$state}-tooltip {
+			display: block;
+		}
+
+		.was-validated .form-control:#{$state},
+		.form-control.is-#{$state} {
+			border-color: var(--bs-form-#{$state}-border-color);
+			padding-right: calc(1.5em + 0.75rem);
+			background-image: #{map.get(tokens.$icons, $state)};
+			background-repeat: no-repeat;
+			background-position: right calc(0.375em + 0.1875rem) center;
+			background-size: calc(0.75em + 0.375rem) calc(0.75em + 0.375rem);
+		}
+
+		.was-validated .form-control:#{$state}:focus,
+		.form-control.is-#{$state}:focus {
+			border-color: var(--bs-form-#{$state}-border-color);
+			box-shadow: 0 0 0 var(--vn-focus-width) rgba(var(--bs-#{$role}-rgb), 0.25);
+		}
+
+		.was-validated textarea.form-control:#{$state},
+		textarea.form-control.is-#{$state} {
+			padding-right: calc(1.5em + 0.75rem);
+			background-position: top calc(0.375em + 0.1875rem) right calc(0.375em + 0.1875rem);
+		}
+
+		.was-validated .form-select:#{$state},
+		.form-select.is-#{$state} {
+			border-color: var(--bs-form-#{$state}-border-color);
+		}
+
+		.was-validated .form-select:#{$state}:not([multiple]):not([size]),
+		.was-validated .form-select:#{$state}:not([multiple])[size='1'],
+		.form-select.is-#{$state}:not([multiple]):not([size]),
+		.form-select.is-#{$state}:not([multiple])[size='1'] {
+			--bs-form-select-bg-icon: #{map.get(tokens.$icons, $state)};
+			padding-right: 4.125rem;
+			background-position:
+				right 0.75rem center,
+				center right 2.25rem;
+			background-size:
+				16px 12px,
+				calc(0.75em + 0.375rem) calc(0.75em + 0.375rem);
+		}
+
+		.was-validated .form-select:#{$state}:focus,
+		.form-select.is-#{$state}:focus {
+			border-color: var(--bs-form-#{$state}-border-color);
+			box-shadow: 0 0 0 var(--vn-focus-width) rgba(var(--bs-#{$role}-rgb), 0.25);
+		}
+
+		.was-validated .form-control-color:#{$state},
+		.form-control-color.is-#{$state} {
+			width: calc(3rem + calc(1.5em + 0.75rem));
+		}
+
+		.was-validated .form-check-input:#{$state},
+		.form-check-input.is-#{$state} {
+			border-color: var(--bs-form-#{$state}-border-color);
+		}
+
+		.was-validated .form-check-input:#{$state}:checked,
+		.form-check-input.is-#{$state}:checked {
+			background-color: var(--bs-form-#{$state}-color);
+		}
+
+		.was-validated .form-check-input:#{$state}:focus,
+		.form-check-input.is-#{$state}:focus {
+			box-shadow: 0 0 0 var(--vn-focus-width) rgba(var(--bs-#{$role}-rgb), 0.25);
+		}
+
+		.was-validated .form-check-input:#{$state} ~ .form-check-label,
+		.form-check-input.is-#{$state} ~ .form-check-label {
+			color: var(--bs-form-#{$state}-color);
+		}
+
+		.form-check-inline .form-check-input ~ .#{$state}-feedback {
+			margin-left: 0.5em;
+		}
+
+		.was-validated .input-group > .form-control:not(:focus):#{$state},
+		.input-group > .form-control:not(:focus).is-#{$state},
+		.was-validated .input-group > .form-select:not(:focus):#{$state},
+		.input-group > .form-select:not(:focus).is-#{$state},
+		.was-validated .input-group > .form-floating:not(:focus-within):#{$state},
+		.input-group > .form-floating:not(:focus-within).is-#{$state} {
+			z-index: #{$stack};
+		}
+	}
+}
