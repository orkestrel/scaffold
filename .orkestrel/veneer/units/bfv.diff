 		}),
 	),
 )
+
+/** Holds the Validation region's accessible name and lead paragraph. */
+export const VALIDATION_COPY = Object.freeze({
+	region: 'Validation',
+	paragraph:
+		'Compare the marks, borders, feedback, and stacking a passing and a failing control carry.',
+})
+
+/**
+ * Holds the validation specimens for the passing and failing form of each host the state reaches.
+ *
+ * @remarks
+ * Each row names the host, the state, the control's own identifier, and the text it announces, and
+ * the markup is derived from that row rather than written twice, so a passing specimen and its
+ * failing twin cannot drift apart. Every class a specimen writes is one the cascade declares a rule
+ * for, and no specimen carries an inline style, which is what the showcase census and the style
+ * sweep hold the whole surface to. No row renders a validation tooltip: the release positions one
+ * against the ancestor an input group or a floating label positions, those rules belong to other
+ * partials, and a tooltip with no positioned ancestor resolves `top: 100%` against the initial
+ * containing block, which grows the document by the height of every pane the capture stages
+ * against it.
+ */
+export const VALIDATION_SPECIMENS: readonly MarkupSpecimen[] = Object.freeze(
+	[
+		{
+			name: 'Valid control',
+			host: 'control',
+			state: 'valid',
+			id: 'valid-entry',
+			label: 'Valid material',
+			value: 'Oak',
+		},
+		{
+			name: 'Invalid control',
+			host: 'control',
+			state: 'invalid',
+			id: 'invalid-entry',
+			label: 'Invalid material',
+			value: '',
+		},
+		{
+			name: 'Valid select',
+			host: 'select',
+			state: 'valid',
+			id: 'valid-choice',
+			label: 'Valid warehouse',
+			value: 'Northworks',
+		},
+		{
+			name: 'Invalid select',
+			host: 'select',
+			state: 'invalid',
+			id: 'invalid-choice',
+			label: 'Invalid warehouse',
+			value: 'Unassigned',
+		},
+		{
+			name: 'Valid check',
+			host: 'check',
+			state: 'valid',
+			id: 'valid-box',
+			label: 'Valid inspection',
+			value: '',
+		},
+		{
+			name: 'Invalid check',
+			host: 'check',
+			state: 'invalid',
+			id: 'invalid-box',
+			label: 'Invalid inspection',
+			value: '',
+		},
+		{
+			name: 'Valid feedback',
+			host: 'feedback',
+			state: 'valid',
+			id: 'accepted-batch',
+			label: 'Accepted batch',
+			value: 'VN20260921',
+		},
+		{
+			name: 'Invalid feedback',
+			host: 'feedback',
+			state: 'invalid',
+			id: 'rejected-batch',
+			label: 'Rejected batch',
+			value: '',
+		},
+		{
+			name: 'Validated form',
+			host: 'form',
+			state: 'invalid',
+			id: 'required-destination',
+			label: 'Required destination',
+			value: '',
+		},
+	].map(({ name, host, state, id, label, value }) => {
+		const field = `<label for="${id}">${label}</label>`
+		const note = state === 'valid' ? 'Accepted.' : 'Enter a value.'
+		if (host === 'select') {
+			return Object.freeze({
+				name,
+				markup: `${field}<select class="form-select is-${state}" id="${id}"><option>${value}</option></select>`,
+			})
+		}
+		if (host === 'check') {
+			return Object.freeze({
+				name,
+				markup: `<div><input class="form-check-input is-${state}" type="checkbox" id="${id}" checked=""><label class="form-check-label" for="${id}">${label}</label></div>`,
+			})
+		}
+		if (host === 'feedback') {
+			return Object.freeze({
+				name,
+				markup: `${field}<input class="form-control is-${state}" id="${id}" value="${value}"><div class="${state}-feedback">${note}</div>`,
+			})
+		}
+		if (host === 'form') {
+			return Object.freeze({
+				name,
+				markup: `<form class="was-validated">${field}<input class="form-control" id="${id}" required=""><div class="invalid-feedback">${note}</div></form>`,
+			})
+		}
+		return Object.freeze({
+			name,
+			markup: `${field}<input class="form-control is-${state}" id="${id}" value="${value}">`,
+		})
+	}),
+)
