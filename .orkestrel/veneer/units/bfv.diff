+				'form-select',
+				'form-check-input',
+				'form-check-label',
+				'is-valid',
+				'is-invalid',
+				'valid-feedback',
+				'invalid-feedback',
+				'was-validated',
+			])
+				expect({ name, present: region.querySelector(`.${name}`) !== null }).toEqual({
+					name,
+					present: true,
+				})
+			const validated = requireValue(region.querySelector('.was-validated'), 'No validated form')
+			const required = requireValue(validated.querySelector('input'), 'No required control')
+			expect(required.required).toBe(true)
+			expect(required.value).toBe('')
+			expect(required.classList.contains('is-invalid')).toBe(false)
+			// Each control announces a name of its own, which is what lets the journey reach one by
+			// keyboard rather than by position.
+			const names = [...region.querySelectorAll('label')].map((label) => label.textContent)
+			expect(new Set(names).size).toBe(names.length)
+			for (const label of region.querySelectorAll('label[for]')) {
