 export const scene = new SceneManager()
 
+/** Names a state the {@link readFormDifferences} reader drives a form into before reading it. */
+export type FormState = 'rest' | 'hovered' | 'pressed' | 'focused' | 'disabled'
+
+/**
+ * Describes one class's button form beside the class's counterpart that is no button, as the
+ * {@link readFormDifferences} reader mounts them.
+ */
+export interface FormPair {
+	/** Names the pair in the reader's refusal, such as `btn-close`. */
+	readonly name: string
+	/** Holds the selector that finds the class's element inside each form's markup. */
+	readonly selector: string
+	/** Holds the markup that mounts the button form. */
+	readonly button: string
+	/** Holds the markup that mounts the counterpart. */
+	readonly counterpart: string
+	/**
+	 * True if the counterpart enters the disabled state through the `disabled` class and the
+	 * `aria-disabled` attribute; false if it stays at rest beside the disabled button.
+	 */
+	readonly paired: boolean
+}
+
+/**
+ * Maps each state a pair was read in to every longhand its button form resolves apart from its
+ * counterpart, each with the button form's value.
+ */
+export type FormDifference = Readonly<Partial<Record<FormState, Readonly<Record<string, string>>>>>
+
+/** Carries one pair's form differences under the document's cascade and under the release's. */
+export interface FormComparison {
+	/** Holds the differences under the document's cascade, this package's in the styles project. */
+	readonly veneer: FormDifference
+	/** Holds the differences under the release's stylesheet alone. */
+	readonly release: FormDifference
+}
+
+/**
+ * Lists, for each form, the selector its element matches after it is driven into each state: the
+ * button form's, a paired counterpart's, and an unpaired counterpart's.
+ *
+ * @remarks
+ * A counterpart cannot be `:disabled`, so a paired counterpart enters the disabled state through
+ * the `disabled` class, and an unpaired one stays at rest, where the universal selector is its
+ * entry. Every other state is entered through the same pseudo-class on every form, and the rest
+ * state through no drive at all.
+ */
+export const FORM_ENTRIES = Object.freeze({
+	button: Object.freeze({
+		rest: '*',
+		hovered: ':hover',
+		pressed: ':active',
+		focused: ':focus-visible',
+		disabled: ':disabled',
+	}),
+	paired: Object.freeze({
+		rest: '*',
+		hovered: ':hover',
+		pressed: ':active',
+		focused: ':focus-visible',
+		disabled: '.disabled',
+	}),
+	unpaired: Object.freeze({
+		rest: '*',
+		hovered: ':hover',
+		pressed: ':active',
+		focused: ':focus-visible',
+		disabled: '*',
+	}),
+})
+
+/**
+ * Reads where one class's button form resolves apart from its counterpart, state by state, under
+ * the document's cascade and under the release's stylesheet.
+ *
+ * @param pair - The class's two forms and the selector that finds the class's element in each.
+ * @param states - The states to read, in order. List `disabled` last, because a disabled element
+ *   takes no later drive.
+ * @param holder - The inline style of the holder both forms mount in, such as a holder that
+ *   retunes the tokens the button surface reads.
+ * @returns For each cascade and each state, every longhand the button form resolves apart from its
+ *   counterpart, with the button form's value. Custom properties are left out.
+ * @throws An `Error` when an element does not match its entry in {@link FORM_ENTRIES} after its
+ *   drive, naming every such element and state.
+ *
+ * @remarks
+ * Both forms mount under the holder twice: once in the document, under the cascade the page loads,
+ * which is this package's in the styles project, and once in a shadow root holding the release's
+ * stylesheet alone, so the release's forms inherit the same page and none of the document's rules
+ * reach them. The release declares its root variables on the light theme attribute as well as on
+ * the root, which a shadow tree does not match, so the shadow copy sits inside that attribute. The
+ * stylesheet is read as a file and never imported, so no release module enters the test graph.
+ *
+ * Each element is driven into each state on its own with the browser's real input: a hover, a held
+ * pointer, and a keyboard focus. The disabled drive sets the button form's `disabled` property and
+ * gives a paired counterpart the `disabled` class and the `aria-disabled` attribute. The pointer is
+ * released after every reading, which parks it outside the page, so no later reading carries a
+ * hover or a press. The rest reading is taken with motion allowed, so a transition a rule writes
+ * shows in it, and every later state is read with motion reduced, so no reading lands partway
+ * through a transition. The reader releases the pointer and every staged media feature before it
+ * returns, so stage no media feature around a call. The mounts are recorded in {@link scene}.
+ *
+ * A value a class writes resolves alike on both forms and drops out of the difference, so comparing
+ * the two cascades' differences asks whether the button form adds to the class what the release's
+ * button form adds, and nothing else.
+ *
+ * @example
+ * ```ts
+ * const { veneer, release } = await readFormDifferences(pair, ['rest', 'hovered'], holder)
+ * ```
+ */
+export async function readFormDifferences(
+	pair: FormPair,
+	states: readonly FormState[],
+	holder: string,
+): Promise<FormComparison> {
+	const markup = `<div style="${holder}"><div data-form="button">${pair.button}</div><div data-form="counterpart">${pair.counterpart}</div></div>`
+	const shelf = scene.mount('')
+	const shadow = shelf.attachShadow({ mode: 'open' })
+	shadow.append(
+		build('style', {
+			text: await commands.readFile('node_modules/bootstrap/dist/css/bootstrap.css'),
+		}),
+		scene.mount(`<div data-bs-theme="light">${markup}</div>`),
+	)
+	const elements = (
+		[
+			['veneer', scene.mount(markup)],
+			['release', shadow],
+		] as const
+	).flatMap(([cascade, root]) =>
+		(['button', 'counterpart'] as const).map((form) => ({
+			key: `${cascade} ${form}`,
+			form,
+			entries: FORM_ENTRIES[form === 'button' ? 'button' : pair.paired ? 'paired' : 'unpaired'],
+			element: requireValue(
+				root.querySelector<HTMLElement>(`[data-form="${form}"] ${pair.selector}`),
+				`No ${cascade} ${form} ${pair.name}`,
+			),
+		})),
+	)
+	const readings = new Map<string, Readonly<Record<string, string>>>()
+	const missed: string[] = []
+	try {
+		for (const state of states) {
+			if (state !== 'rest') await stageMedia({ motion: false })
+			for (const { key, form, entries, element } of elements) {
+				if (state === 'hovered') {
+					await userEvent.hover(element)
+				} else if (state === 'pressed') {
+					await driveHold(() => element, `${key} ${pair.name}`)
+				} else if (state === 'focused') {
+					element.blur()
+					element.focus()
+					await pressKeys('{ArrowRight}')
+				} else if (state === 'disabled') {
+					element.blur()
+					if (form === 'button' && element instanceof HTMLButtonElement) element.disabled = true
+					if (form === 'counterpart' && pair.paired) {
+						element.classList.add('disabled')
+						element.setAttribute('aria-disabled', 'true')
+					}
+				}
+				if (!element.matches(entries[state])) missed.push(`${key} ${state}`)
+				readings.set(
+					`${key} ${state}`,
+					Object.fromEntries(
+						Array.from(getComputedStyle(element))
+							.filter((longhand) => !longhand.startsWith('--'))
+							.map((longhand) => [longhand, readStyle(element, longhand)]),
+					),
+				)
+				await releasePointer()
+			}
+		}
+	} finally {
+		await releasePointer()
+		await releaseMedia()
+	}
+	if (missed.length > 0)
+		throw new Error(`The ${pair.name} forms did not enter every state: ${missed.join(', ')}`)
+	const [veneer, release] = (['veneer', 'release'] as const).map((cascade) =>
+		Object.fromEntries(
+			states.map((state) => {
+				const buttonReading = requireValue(
+					readings.get(`${cascade} button ${state}`),
+					`No ${cascade} button ${state} reading`,
+				)
+				const counterpartReading = requireValue(
+					readings.get(`${cascade} counterpart ${state}`),
+					`No ${cascade} counterpart ${state} reading`,
+				)
+				return [
+					state,
+					Object.fromEntries(
+						Object.entries(buttonReading).filter(
+							([longhand, value]) => counterpartReading[longhand] !== value,
+						),
+					),
+				]
+			}),
+		),
+	)
+	return {
+		veneer: requireValue(veneer, 'No veneer differences'),
+		release: requireValue(release, 'No release differences'),
+	}
+}
