+import type { SectionInterface } from '@app/browser'
+import { COLLAPSE_COPY, COLLAPSE_SPECIMENS, CollapseSection, SpecimenSection } from '@app/browser'
+import { requireValue } from '@orkestrel/test'
+import { build, isRendered, mount, readPixels, readStyle } from '@orkestrel/test/browser'
+import { beforeAll, describe, expect, it } from 'vitest'
+import { readSpecimen } from '../../../setupBrowser.js'
+
+// Each specimen claims a state the published cascade renders from a class, so the cascade has to be
+// in the document before a reading of that state means anything.
+beforeAll(async () => {
+	await import('../../../../src/styles/index.scss')
+	await import('../../../../app/browser/styles/index.scss')
+})
+
+describe('CollapseSection', () => {
+	it('renders a shown and a hidden panel on each axis through the shared section contract', () => {
+		const host = mount(build('div'))
+		const section: SectionInterface = new CollapseSection(host)
+		try {
+			expect(section).toBeInstanceOf(SpecimenSection)
+			expect(section.host).toBe(host)
+			const region = requireValue(host.querySelector('section'), 'No Collapse region')
+			expect(region.getAttribute('aria-label')).toBe('Collapse')
+			expect(region.querySelector('p')?.textContent).toBe(COLLAPSE_COPY.paragraph)
+			const rendered = [...region.querySelectorAll('[data-specimen]')]
+			expect(rendered.map((element) => element.getAttribute('data-specimen'))).toEqual([
+				'Collapse shown',
+				'Collapse hidden',
+				'Horizontal collapse shown',
+				'Horizontal collapse hidden',
+			])
+			expect(rendered.map((element) => element.innerHTML)).toEqual(
+				COLLAPSE_SPECIMENS.map(({ markup }) => markup),
+			)
+			// Every resting class this key ships reaches the region. The closing class is the one
+			// declined: it rests at zero height until an engine writes an inline size, and no specimen
+			// writes an inline style, so the cascade proof reads it instead.
+			for (const name of ['collapse', 'show', 'collapse-horizontal'])
+				expect(region.querySelector(`.${name}`)).not.toBeNull()
+			expect(region.querySelector('.collapsing')).toBeNull()
+			expect(region.querySelector('[style]')).toBeNull()
+			// Each state is a class written in the markup, so no specimen carries a trigger an engine
+			// would bind: moving a panel between the states is the plugin's obligation, not the key's.
+			expect(region.querySelector('[data-bs-toggle], [data-bs-target], button')).toBeNull()
+			expect(Object.isFrozen(COLLAPSE_COPY)).toBe(true)
+			expect(Object.isFrozen(COLLAPSE_SPECIMENS)).toBe(true)
+			expect(COLLAPSE_SPECIMENS.every((entry) => Object.isFrozen(entry))).toBe(true)
+		} finally {
+			section.destroy()
+			host.remove()
+		}
+	})
+
+	// The mutation this catches is a specimen that stops carrying the class its name claims: a shown
+	// panel that drops the `show` class reads hidden here, and a hidden panel that gains it reads
+	// shown, on either axis.
+	it('renders each panel in the state its specimen names', () => {
+		const host = mount(build('div'))
+		const section: SectionInterface = new CollapseSection(host)
+		try {
+			const region = requireValue(host.querySelector('section'), 'No Collapse region')
+			const panels = [
+				'Collapse shown',
+				'Collapse hidden',
+				'Horizontal collapse shown',
+				'Horizontal collapse hidden',
+			].map((name) =>
+				requireValue(
+					readSpecimen(region, name).querySelector('.collapse'),
+					`The "${name}" specimen renders no panel`,
+				),
+			)
+			expect(
+				panels.map((panel) => [
+					panel.classList.contains('show'),
+					panel.classList.contains('collapse-horizontal'),
+					readStyle(panel, 'display'),
+					isRendered(requireValue(panel.firstElementChild, 'No panel body')),
+				]),
+			).toEqual([
+				[true, false, 'block', true],
+				[false, false, 'none', false],
+				[true, true, 'block', true],
+				[false, true, 'none', false],
+			])
+			// A hidden panel leaves the flow, so its card is as tall as its header and its borders,
+			// and a shown panel adds its body below the header.
+			expect(
+				panels.map((panel) => {
+					const card = requireValue(panel.parentElement, 'No card')
+					const header = requireValue(card.querySelector('.card-header'), 'No header')
+					return (
+						card.getBoundingClientRect().height -
+							header.getBoundingClientRect().height -
+							2 * readPixels(card, 'border-top-width') >
+						0.5
+					)
+				}),
+			).toEqual([true, false, true, false])
+		} finally {
+			section.destroy()
+			host.remove()
+		}
+	})
+
+	it('releases the region and preserves adjacent content on repeated destruction', () => {
+		const host = mount(build('div'))
+		const neighbor = build('p', { text: 'Existing content' })
+		host.append(neighbor)
+		const section: SectionInterface = new CollapseSection(host)
+		try {
+			const region = requireValue(host.querySelector('section'), 'No Collapse region')
+			expect(region.isConnected).toBe(true)
+			section.destroy()
+			expect(region.isConnected).toBe(false)
+			section.destroy()
+			expect([...host.children]).toEqual([neighbor])
+		} finally {
+			section.destroy()
+			host.remove()
+		}
+	})
+})
