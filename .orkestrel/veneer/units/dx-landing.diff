+++ b/tests/app/browser/sections/DropdownSection.test.ts
@@ -0,0 +1,218 @@
+import type { SectionInterface } from '@app/browser'
+import { DROPDOWN_COPY, DROPDOWN_SPECIMENS, DropdownSection, SpecimenSection } from '@app/browser'
+import { requireValue } from '@orkestrel/test'
+import { build, isRendered, mount } from '@orkestrel/test/browser'
+import { beforeAll, describe, expect, it } from 'vitest'
+import { visitBreakpoint } from '../../../setupBrowser.js'
+
+// The room each shown specimen reserves is a claim about layout, and the layout is the published
+// cascade's, so the cascade has to be in the document before a box reading means anything.
+beforeAll(async () => {
+	await import('../../../../src/styles/index.scss')
+	await import('../../../../app/browser/styles/index.scss')
+})
+
+describe('DropdownSection', () => {
+	it('renders every dropdown specimen through the shared section contract', () => {
+		const host = mount(build('div'))
+		const section: SectionInterface = new DropdownSection(host)
+		try {
+			expect(section).toBeInstanceOf(SpecimenSection)
+			expect(section.host).toBe(host)
+			const region = requireValue(host.querySelector('section'), 'No Dropdown region')
+			expect(region.querySelector('[style]')).toBeNull()
+			expect(region.getAttribute('aria-label')).toBe('Dropdown')
+			expect(region.querySelector('p')?.textContent).toBe(DROPDOWN_COPY.paragraph)
+			const rendered = [...region.querySelectorAll('[data-specimen]')]
+			expect(rendered.map((element) => element.getAttribute('data-specimen'))).toEqual([
+				'Dropdown closed',
+				'Dropdown menu',
+				'Dropdown menu end',
+				'Dropup',
+				'Dropend',
+				'Dropstart',
+				'Dropdown center',
+				'Dropup center',
+				'Dropdown menu inverted',
+				'Dropdown align sm',
+				'Dropdown align md',
+				'Dropdown align lg',
+				'Dropdown align xl',
+				'Dropdown align xxl',
+			])
+			expect(rendered.map((element) => element.innerHTML)).toEqual(
+				DROPDOWN_SPECIMENS.map(({ markup }) => markup),
+			)
+			expect(Object.isFrozen(DROPDOWN_COPY)).toBe(true)
+			expect(Object.isFrozen(DROPDOWN_SPECIMENS)).toBe(true)
+			expect(DROPDOWN_SPECIMENS.every((entry) => Object.isFrozen(entry))).toBe(true)
+		} finally {
+			section.destroy()
+			host.remove()
+		}
+	})
+
+	it('sets every state in markup and announces each toggle as its menu stands', () => {
+		const host = mount(build('div'))
+		const section: SectionInterface = new DropdownSection(host)
+		try {
+			const region = requireValue(host.querySelector('section'), 'No Dropdown region')
+			// Every specimen but the closed one shows its menu through the class and the placement
+			// attribute alone, and the closed one shows none, so a specimen that dropped either
+			// reads as the other state here rather than photographing a menu that is not there.
+			const shown = new Map(
+				[...region.querySelectorAll('[data-specimen]')].map((specimen) => [
+					specimen.getAttribute('data-specimen'),
+					[...specimen.querySelectorAll('.dropdown-menu')].map(
+						(menu) =>
+							`${String(menu.classList.contains('show'))}|${String(menu.getAttribute('data-bs-popper'))}`,
+					),
+				]),
+			)
+			const closed = shown.get('Dropdown closed') ?? []
+			expect(closed).not.toStrictEqual([])
+			expect(closed.filter((menu) => menu !== 'false|null')).toStrictEqual([])
+			expect(
+				[...shown].filter(
+					([name, menus]) =>
+						name !== 'Dropdown closed' &&
+						(menus.length === 0 || menus.some((menu) => menu !== 'true|static')),
+				),
+			).toStrictEqual([])
+			// A toggle announces the state its own menu is in, so the accessible tree and the paint
+			// the frames show tell one story.
+			for (const toggle of region.querySelectorAll('.dropdown-toggle')) {
+				const menu = requireValue(toggle.nextElementSibling, 'A toggle has no menu after it')
+				expect(toggle.getAttribute('aria-expanded')).toBe(String(menu.classList.contains('show')))
+			}
+			// Every name the partial writes a rule for reaches a rendered host: each direction and
+			// centered wrapper, the end alignment and every step of its ramp, the header, the item
+			// states on an anchor and on a button, the divider, the item text, and the dark menu.
+			const rendered = [
+				'.dropdown',
+				'.dropup',
+				'.dropend',
+				'.dropstart',
+				'.dropdown-center',
+				'.dropup-center',
+				'.dropdown-menu-end',
+				'.dropdown-header',
+				'a.dropdown-item.active',
+				'a.dropdown-item.disabled',
+				'button.dropdown-item:disabled',
+				'hr.dropdown-divider',
+				'.dropdown-item-text',
+				'.dropdown-menu-dark',
+				...['sm', 'md', 'lg', 'xl', 'xxl'].flatMap((step) => [
+					`.dropdown-menu-end.dropdown-menu-${step}-start`,
+					`.dropdown-menu-${step}-end`,
+				]),
+			]
+			expect(rendered.filter((selector) => region.querySelector(selector) === null)).toStrictEqual(
+				[],
+			)
+			// The release's `:empty` caret rules reach a toggle with no content, so the closed
+			// specimen carries one in each direction, each named through its own label.
+			const empty = [
+				...requireValue(
+					region.querySelector('[data-specimen="Dropdown closed"]'),
+					'No closed specimen',
+				).querySelectorAll('.dropdown-toggle:empty'),
+			]
+			expect(empty.map((toggle) => toggle.getAttribute('aria-label'))).toEqual([
+				'Carrier options below',
+				'Carrier options above',
+				'Carrier options after',
+				'Carrier options before',
+			])
+			expect(empty.map((toggle) => toggle.parentElement?.className)).toEqual([
+				'btn-group',
+				'btn-group dropup',
+				'btn-group dropend',
+				'btn-group dropstart',
+			])
+			// Each toggle and each focusable item announces a name no other control in the region
+			// repeats, because the journey reaches a control by that name.
+			const names = [...region.querySelectorAll('button, a[href]')].map(
+				(control) => control.getAttribute('aria-label') ?? control.textContent,
+			)
+			expect(new Set(names).size).toBe(names.length)
+		} finally {
+			section.destroy()
+			host.remove()
+		}
+	})
+
+	// The journey photographs each specimen at 390 and at 1280 pixels, and the grid columns that seat
+	// each toggle reflow between those widths, so the room each menu keeps is read at each of them.
+	it.each([390, 1280])(
+		'keeps each shown menu inside the specimen that holds it at a %i-pixel viewport',
+		async (width) => {
+			const host = mount(build('div'))
+			const section: SectionInterface = new DropdownSection(host)
+			try {
+				const region = requireValue(host.querySelector('section'), 'No Dropdown region')
+				const { measured, escaped } = await visitBreakpoint(width, () => {
+					expect(window.innerWidth).toBe(width)
+					const names: string[] = []
+					const outside: string[] = []
+					for (const specimen of region.querySelectorAll('[data-specimen]')) {
+						const frame = specimen.getBoundingClientRect()
+						for (const menu of specimen.querySelectorAll('.dropdown-menu.show')) {
+							expect(isRendered(menu)).toBe(true)
+							names.push(String(specimen.getAttribute('data-specimen')))
+							const box = menu.getBoundingClientRect()
+							// The frame is shot on the specimen's own box, so a menu reaching past any edge
+							// of it is cropped out of the frame that claims to show it.
+							if (
+								box.top < frame.top ||
+								box.bottom > frame.bottom ||
+								box.left < frame.left ||
+								box.right > frame.right
+							)
+								outside.push(String(specimen.getAttribute('data-specimen')))
+						}
+					}
+					return { measured: names, escaped: outside }
+				})
+				// Every specimen but the closed one is measured, and each ramp step measures both of its
+				// menus, so a specimen whose menu lost its class is missing here rather than passing.
+				expect(new Set(measured)).toEqual(
+					new Set(
+						DROPDOWN_SPECIMENS.map(({ name }) => name).filter((name) => name !== 'Dropdown closed'),
+					),
+				)
+				for (const step of ['sm', 'md', 'lg', 'xl', 'xxl'])
+					expect(measured.filter((name) => name === `Dropdown align ${step}`)).toHaveLength(2)
+				expect(escaped).toStrictEqual([])
+				// The closed menu stays out of the layout, so the closed specimen is its toggles alone.
+				const closed = requireValue(
+					region.querySelector('[data-specimen="Dropdown closed"] .dropdown-menu'),
+					'No closed menu',
+				)
+				expect(isRendered(closed)).toBe(false)
+			} finally {
+				section.destroy()
+				host.remove()
+			}
+		},
+	)
+
+	it('releases the region and preserves adjacent content on repeated destruction', () => {
+		const host = mount(build('div'))
+		const neighbor = build('p', { text: 'Existing content' })
+		host.append(neighbor)
+		const section: SectionInterface = new DropdownSection(host)
+		try {
+			const region = requireValue(host.querySelector('section'), 'No Dropdown region')
+			expect(region.isConnected).toBe(true)
+			section.destroy()
+			expect(region.isConnected).toBe(false)
+			section.destroy()
+			expect([...host.children]).toEqual([neighbor])
+		} finally {
+			section.destroy()
+			host.remove()
+		}
+	})
+})
