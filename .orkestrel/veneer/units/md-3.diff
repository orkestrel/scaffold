diff --git a/src/styles/components/_modal.scss b/src/styles/components/_modal.scss
new file mode 100644
index 0000000..8818684
--- /dev/null
+++ b/src/styles/components/_modal.scss
@@ -0,0 +1,264 @@
+@use '../mixins' as *;
+
+@layer components {
+	// The modal ships Bootstrap's recorded surface. Every state is a class set in markup: the `show`
+	// class settles the dialog, the `fade` class starts it from its entrance offset, and the
+	// `modal-static` class is the bounce an engine gives a dialog that refuses to close. No rule here
+	// shows the modal: an engine writes its display inline, and the `.modal` rule keeps it hidden
+	// otherwise. No rule reads the `modal-open` class; an engine sets it on the document body while a
+	// dialog is open.
+	//
+	// The stacking level reads the dialog rung of Veneer's ladder, and every length the release
+	// writes at a density step reads the space token that already resolves to it, so the density
+	// factor moves the dialog's margin, its insets, and its footer gap together. The widths and the
+	// wider margin from the small boundary up stay literal, because no published Veneer scale
+	// resolves to them.
+	.modal {
+		--bs-modal-zindex: var(--vn-stack-dialog-base);
+		--bs-modal-width: 500px;
+		--bs-modal-padding: var(--vn-space-8);
+		--bs-modal-margin: var(--vn-space-4);
+		--bs-modal-color: var(--bs-body-color);
+		--bs-modal-bg: var(--bs-body-bg);
+		--bs-modal-border-color: var(--bs-border-color-translucent);
+		--bs-modal-border-width: var(--bs-border-width);
+		--bs-modal-border-radius: var(--bs-border-radius-lg);
+		--bs-modal-box-shadow: var(--bs-box-shadow-sm);
+		--bs-modal-inner-border-radius: calc(var(--bs-border-radius-lg) - (var(--bs-border-width)));
+		--bs-modal-header-padding-x: var(--vn-space-8);
+		--bs-modal-header-padding-y: var(--vn-space-8);
+		--bs-modal-header-padding: var(--vn-space-8) var(--vn-space-8);
+		--bs-modal-header-border-color: var(--bs-border-color);
+		--bs-modal-header-border-width: var(--bs-border-width);
+		--bs-modal-title-line-height: var(--vn-line-body);
+		--bs-modal-footer-gap: var(--vn-space-4);
+		// The release declares the footer fill with no value. The interpolation compiles to that same
+		// empty declaration, so the footer paints through the content's own fill.
+		--bs-modal-footer-bg: #{''};
+		--bs-modal-footer-border-color: var(--bs-border-color);
+		--bs-modal-footer-border-width: var(--bs-border-width);
+		position: fixed;
+		top: 0;
+		left: 0;
+		z-index: var(--bs-modal-zindex);
+		display: none;
+		width: 100%;
+		height: 100%;
+		overflow-x: hidden;
+		overflow-y: auto;
+		outline: 0;
+	}
+
+	// The dialog lets the pointer through to the modal around it, so a press outside the content lands
+	// on the modal, and the content takes the pointer back.
+	.modal-dialog {
+		position: relative;
+		width: auto;
+		margin: var(--bs-modal-margin);
+		pointer-events: none;
+	}
+
+	// The entrance offset and the move that settles it are written through the `transition` mixin, so
+	// the move resolves to no transition under the reduced-motion preference. The duration is the
+	// release's literal, because no published motion token resolves to the `0.3s` duration.
+	.modal.fade .modal-dialog {
+		transform: translate(0, -50px);
+		@include transition(transform 0.3s ease-out);
+	}
+
+	.modal.show .modal-dialog {
+		transform: none;
+	}
+
+	.modal.modal-static .modal-dialog {
+		transform: scale(1.02);
+	}
+
+	// The scrollable dialog holds the content inside the modal's height less its margins, and the body
+	// scrolls inside it while the header and the footer stay in place.
+	.modal-dialog-scrollable {
+		height: calc(100% - var(--bs-modal-margin) * 2);
+	}
+
+	.modal-dialog-scrollable .modal-content {
+		max-height: 100%;
+		overflow: hidden;
+	}
+
+	.modal-dialog-scrollable .modal-body {
+		overflow-y: auto;
+	}
+
+	.modal-dialog-centered {
+		display: flex;
+		align-items: center;
+		min-height: calc(100% - var(--bs-modal-margin) * 2);
+	}
+
+	.modal-content {
+		position: relative;
+		display: flex;
+		flex-direction: column;
+		width: 100%;
+		color: var(--bs-modal-color);
+		pointer-events: auto;
+		background-color: var(--bs-modal-bg);
+		background-clip: padding-box;
+		border: var(--bs-modal-border-width) solid var(--bs-modal-border-color);
+		border-radius: var(--bs-modal-border-radius);
+		outline: 0;
+	}
+
+	// The backdrop reads its stacking level from the rung below the dialog's and its fill from the
+	// palette token that holds the release's black. It is transparent while it carries the `fade`
+	// class alone and at its opacity when it also carries the `show` class, which is the pair an
+	// engine writes as it fades the backdrop in.
+	.modal-backdrop {
+		--bs-backdrop-zindex: var(--vn-stack-dialog-backdrop);
+		--bs-backdrop-bg: var(--vn-palette-black-base);
+		--bs-backdrop-opacity: 0.5;
+		@include overlay-backdrop(
+			var(--bs-backdrop-zindex),
+			var(--bs-backdrop-bg),
+			var(--bs-backdrop-opacity)
+		);
+	}
+
+	.modal-header {
+		display: flex;
+		flex-shrink: 0;
+		align-items: center;
+		padding: var(--bs-modal-header-padding);
+		border-bottom: var(--bs-modal-header-border-width) solid var(--bs-modal-header-border-color);
+		border-top-left-radius: var(--bs-modal-inner-border-radius);
+		border-top-right-radius: var(--bs-modal-inner-border-radius);
+	}
+
+	// The close control in the header takes half the header's inset as its own padding and gives it
+	// back through negative margins, so its target grows without moving the header's edge, and the
+	// automatic start margin pushes it to the header's end. The rule selects the control through the
+	// header, so a close control elsewhere in a modal keeps its own box.
+	.modal-header .btn-close {
+		padding: calc(var(--bs-modal-header-padding-y) * 0.5)
+			calc(var(--bs-modal-header-padding-x) * 0.5);
+		margin-top: calc(-0.5 * var(--bs-modal-header-padding-y));
+		margin-right: calc(-0.5 * var(--bs-modal-header-padding-x));
+		margin-bottom: calc(-0.5 * var(--bs-modal-header-padding-y));
+		margin-left: auto;
+	}
+
+	.modal-title {
+		margin-bottom: 0;
+		line-height: var(--bs-modal-title-line-height);
+	}
+
+	.modal-body {
+		position: relative;
+		flex: 1 1 auto;
+		padding: var(--bs-modal-padding);
+	}
+
+	// The footer's inset is the body's less half the gap, and each child takes half the gap as its
+	// margin, so the children sit one gap apart and the outer ones line up with the body's inset.
+	.modal-footer {
+		display: flex;
+		flex-shrink: 0;
+		flex-wrap: wrap;
+		align-items: center;
+		justify-content: flex-end;
+		padding: calc(var(--bs-modal-padding) - var(--bs-modal-footer-gap) * 0.5);
+		background-color: var(--bs-modal-footer-bg);
+		border-top: var(--bs-modal-footer-border-width) solid var(--bs-modal-footer-border-color);
+		border-bottom-right-radius: var(--bs-modal-inner-border-radius);
+		border-bottom-left-radius: var(--bs-modal-inner-border-radius);
+	}
+
+	.modal-footer > * {
+		margin: calc(var(--bs-modal-footer-gap) * 0.5);
+	}
+
+	// From the small boundary up the dialog takes a wider margin, and it is capped at the width its
+	// size class names and centered in the modal.
+	@include breakpoint-up(sm) {
+		.modal {
+			--bs-modal-margin: 1.75rem;
+			--bs-modal-box-shadow: var(--bs-box-shadow);
+		}
+
+		.modal-dialog {
+			max-width: var(--bs-modal-width);
+			margin-right: auto;
+			margin-left: auto;
+		}
+
+		.modal-sm {
+			--bs-modal-width: 300px;
+		}
+	}
+
+	@include breakpoint-up(lg) {
+		.modal-lg,
+		.modal-xl {
+			--bs-modal-width: 800px;
+		}
+	}
+
+	@include breakpoint-up(xl) {
+		.modal-xl {
+			--bs-modal-width: 1140px;
+		}
+	}
+
+	// The release's unsuffixed fullscreen class fills the viewport at every width and drops the
+	// content's edge and corners.
+	.modal-fullscreen {
+		width: 100vw;
+		max-width: none;
+		height: 100%;
+		margin: 0;
+	}
+
+	.modal-fullscreen .modal-content {
+		height: 100%;
+		border: 0;
+		border-radius: 0;
+	}
+
+	.modal-fullscreen .modal-header,
+	.modal-fullscreen .modal-footer {
+		border-radius: 0;
+	}
+
+	.modal-fullscreen .modal-body {
+		overflow-y: auto;
+	}
+
+	// Each named fullscreen class carries the same rule set below its own boundary alone. The walk
+	// reaches the zero name as well, where the `breakpoint-down` mixin emits nothing, because no
+	// viewport is below it; the unsuffixed class is the release's rule for every width instead.
+	@each $name, $_width in breakpoints() {
+		@include breakpoint-down($name) {
+			.modal-fullscreen-#{$name}-down {
+				width: 100vw;
+				max-width: none;
+				height: 100%;
+				margin: 0;
+			}
+
+			.modal-fullscreen-#{$name}-down .modal-content {
+				height: 100%;
+				border: 0;
+				border-radius: 0;
+			}
+
+			.modal-fullscreen-#{$name}-down .modal-header,
+			.modal-fullscreen-#{$name}-down .modal-footer {
+				border-radius: 0;
+			}
+
+			.modal-fullscreen-#{$name}-down .modal-body {
+				overflow-y: auto;
+			}
+		}
+	}
+}
diff --git a/tests/src/styles/components/modal.test.ts b/tests/src/styles/components/modal.test.ts
new file mode 100644
index 0000000..3df7e78
--- /dev/null
+++ b/tests/src/styles/components/modal.test.ts
@@ -0,0 +1,567 @@
+import { TOKEN_NAMES } from '@src/core'
+import { requireValue } from '@orkestrel/test'
+import {
+	matchesColor,
+	readPixels,
+	readRootToken,
+	readStyle,
+	readToken,
+	releaseMedia,
+	stageMedia,
+} from '@orkestrel/test/browser'
+import { afterEach, describe, expect, it } from 'vitest'
+import {
+	collectLayer,
+	collectMediaConditions,
+	scene,
+	visitBreakpoint,
+} from '../../../setupBrowser.js'
+import {
+	MODAL_FULLSCREEN_CASES,
+	MODAL_GEOMETRY,
+	MODAL_MARKUP,
+	MODAL_SELECTORS,
+	MODAL_SIZE_CASES,
+	MODAL_SPACE_CASES,
+	MODAL_STACK,
+	REDUCED_MOTION,
+	TEXT_MODES,
+	VIEWPORT_WIDTHS,
+	normalizeComplexSelector,
+	splitTopLevelList,
+	trimCSSWhitespace,
+} from '../../../setupStyles.js'
+
+afterEach(async () => {
+	await releaseMedia()
+	document.documentElement.style.removeProperty(TOKEN_NAMES.factor.density)
+	scene.clear()
+})
+
+// Every shown modal in these cases carries the `d-block` utility, which stands in for the display an
+// engine writes inline when it opens a dialog; the `.modal` rule hides a modal otherwise.
+
+describe('modal box', () => {
+	// The mutation this catches is a rule the partial stops writing, or one it writes beyond the
+	// release: the reading is every components-layer selector naming one of the key's own classes,
+	// so a missing rule and an extra rule on the same classes each report here.
+	it('writes the recorded modal selectors and no other rule on their classes', () => {
+		const written = new Set(
+			collectLayer('components').flatMap((rule) =>
+				rule instanceof CSSStyleRule
+					? splitTopLevelList(rule.selectorText)
+							.map((part) => normalizeComplexSelector(trimCSSWhitespace(part)))
+							.filter((selector) => /\.modal[\w-]*(?![\w-])/u.test(selector))
+					: [],
+			),
+		)
+		expect([...written].sort()).toEqual(
+			MODAL_SELECTORS.map((selector) => normalizeComplexSelector(selector)).sort(),
+		)
+	})
+
+	// The mutation this catches is a modal that shows itself: no rule displays a modal, so a modal
+	// without the display an engine writes stays hidden, and the stand-in shows it over the viewport.
+	it('hides a modal at rest and lays a shown one over the whole viewport as a scrolling layer', () => {
+		const host = scene.mount(
+			'<div class="modal"><div class="modal-dialog"><div class="modal-content">Harbor manifest</div></div></div>' +
+				'<div class="modal d-block"><div class="modal-dialog"><div class="modal-content">Harbor manifest</div></div></div>',
+		)
+		const [hidden, shown] = [...host.querySelectorAll('.modal')]
+		expect(readStyle(requireValue(hidden, 'No hidden modal'), 'display')).toBe('none')
+		const modal = requireValue(shown, 'No shown modal')
+		const box = modal.getBoundingClientRect()
+		expect([box.left, box.top, box.width, box.height]).toEqual([
+			0,
+			0,
+			document.documentElement.clientWidth,
+			window.innerHeight,
+		])
+		for (const [property, value] of [
+			['position', 'fixed'],
+			['overflow-x', 'hidden'],
+			['overflow-y', 'auto'],
+			['outline-style', 'none'],
+		] as const)
+			expect({ property, value: readStyle(modal, property) }).toEqual({ property, value })
+		const dialog = requireValue(modal.querySelector('.modal-dialog'), 'No dialog')
+		const content = requireValue(modal.querySelector('.modal-content'), 'No content')
+		// The dialog lets the pointer through to the modal and the content takes it back, so a press
+		// beside the content lands on the modal.
+		expect(readStyle(dialog, 'pointer-events')).toBe('none')
+		expect(readStyle(content, 'pointer-events')).toBe('auto')
+		expect(readStyle(dialog, 'position')).toBe('relative')
+	})
+
+	// The mutations this catches are a literal written for either stacking level. The rungs are
+	// retuned on a wrapper, where each resolves for the modal and the backdrop inside it, so a level
+	// written as the release's number reads the same at rest and follows no retune.
+	it('stacks the modal and the backdrop on the dialog rungs and follows a wrapper retuning them', () => {
+		const { dialog, backdrop } = MODAL_STACK
+		const pair = '<div class="modal"></div><div class="modal-backdrop fade show"></div>'
+		const host = scene.mount(
+			`<div data-scope="rest">${pair}</div><div data-scope="retuned" style="${dialog.token}: 7; ${backdrop.token}: 3">${pair}</div>`,
+		)
+		const readings = ['rest', 'retuned'].map((scope) =>
+			['.modal', '.modal-backdrop'].map((selector) =>
+				readStyle(
+					requireValue(
+						host.querySelector(`[data-scope="${scope}"] ${selector}`),
+						`No ${scope} ${selector}`,
+					),
+					'z-index',
+				),
+			),
+		)
+		expect(readings).toEqual([
+			[dialog.level, backdrop.level],
+			['7', '3'],
+		])
+		expect(readRootToken(dialog.token)).toBe(dialog.level)
+		expect(readRootToken(backdrop.token)).toBe(backdrop.level)
+	})
+
+	it.each(MODAL_SPACE_CASES)(
+		'reads $property from its own token',
+		({ property, token, pixels }) => {
+			const host = scene.mount(
+				`<div class="modal"><span data-probe style="display: block; width: var(${property})"></span></div>`,
+			)
+			const modal = requireValue(host.querySelector('.modal'), 'No modal')
+			expect(readToken(modal, property)).toBe(readToken(modal, token))
+			// The slot is read as a length as well, because a slot and the token it reads stay equal
+			// through a retune that moves them together and away from the release.
+			expect(
+				readPixels(requireValue(modal.querySelector('[data-probe]'), 'No probe'), 'width'),
+			).toBe(pixels)
+		},
+	)
+
+	// The mutation this catches is a length written as the release's literal: the literal ignores the
+	// density factor, and each space token rescales with it.
+	it('rescales the insets, the dialog margin, and the footer gap with the density factor', async () => {
+		const host = scene.mount(
+			`<div class="modal d-block"><div class="modal-dialog">${MODAL_MARKUP}</div></div>`,
+		)
+		const dialog = requireValue(host.querySelector('.modal-dialog'), 'No dialog')
+		const header = requireValue(host.querySelector('.modal-header'), 'No header')
+		const body = requireValue(host.querySelector('.modal-body'), 'No body')
+		const footer = requireValue(host.querySelector('.modal-footer'), 'No footer')
+		const action = requireValue(footer.firstElementChild, 'No footer action')
+		const readings: Array<readonly number[]> = []
+		await visitBreakpoint(390, () => {
+			for (const factor of ['1', '2']) {
+				document.documentElement.style.setProperty(TOKEN_NAMES.factor.density, factor)
+				readings.push([
+					readPixels(dialog, 'margin-top'),
+					readPixels(header, 'padding-top'),
+					readPixels(header, 'padding-left'),
+					readPixels(body, 'padding-top'),
+					readPixels(footer, 'padding-top'),
+					readPixels(action, 'margin-top'),
+				])
+			}
+		})
+		const [resting, doubled] = readings
+		expect(resting).toEqual([MODAL_GEOMETRY.margin, 16, 16, 16, 12, 4])
+		expect(doubled).toEqual([MODAL_GEOMETRY.margin * 2, 32, 32, 32, 24, 8])
+	})
+})
+
+describe('modal content', () => {
+	it('lays the content out as a rounded column of header, body, and footer', () => {
+		const host = scene.mount(
+			`<div class="modal d-block"><div class="modal-dialog">${MODAL_MARKUP}</div></div>`,
+		)
+		const content = requireValue(host.querySelector('.modal-content'), 'No content')
+		const header = requireValue(host.querySelector('.modal-header'), 'No header')
+		const title = requireValue(host.querySelector('.modal-title'), 'No title')
+		const body = requireValue(host.querySelector('.modal-body'), 'No body')
+		const footer = requireValue(host.querySelector('.modal-footer'), 'No footer')
+		for (const [element, property, value] of [
+			[content, 'display', 'flex'],
+			[content, 'flex-direction', 'column'],
+			[content, 'position', 'relative'],
+			[content, 'background-clip', 'padding-box'],
+			[content, 'border-top-width', '1px'],
+			[content, 'border-top-style', 'solid'],
+			[content, 'border-top-left-radius', '8px'],
+			[content, 'outline-style', 'none'],
+			[header, 'display', 'flex'],
+			[header, 'flex-shrink', '0'],
+			[header, 'align-items', 'center'],
+			[header, 'border-bottom-width', '1px'],
+			[header, 'border-top-left-radius', '7px'],
+			[header, 'border-top-right-radius', '7px'],
+			[title, 'margin-bottom', '0px'],
+			[title, 'line-height', `${String(readPixels(title, 'font-size') * 1.5)}px`],
+			[body, 'position', 'relative'],
+			[body, 'flex-grow', '1'],
+			[body, 'flex-shrink', '1'],
+			[footer, 'display', 'flex'],
+			[footer, 'flex-wrap', 'wrap'],
+			[footer, 'flex-shrink', '0'],
+			[footer, 'align-items', 'center'],
+			[footer, 'justify-content', 'flex-end'],
+			[footer, 'border-top-width', '1px'],
+			[footer, 'border-bottom-left-radius', '7px'],
+			[footer, 'border-bottom-right-radius', '7px'],
+			// The release declares the footer fill with no value, so the footer paints nothing of its
+			// own over the content's fill.
+			[footer, 'background-color', 'rgba(0, 0, 0, 0)'],
+		] as const)
+			expect({ property, value: readStyle(element, property) }).toEqual({ property, value })
+		// The footer's children sit one gap apart, and the outer ones line up with the body's inset.
+		const [hold, release] = [...footer.children]
+		const first = requireValue(hold, 'No first action').getBoundingClientRect()
+		const last = requireValue(release, 'No last action').getBoundingClientRect()
+		expect(last.left - first.right).toBe(8)
+		expect(footer.getBoundingClientRect().right - last.right).toBe(16)
+	})
+
+	describe.each(TEXT_MODES)('in %s', (mode) => {
+		// The mutation this catches is a content color written as a literal: the content reads the
+		// body aliases, which the theme scopes retune, so a literal matching one mode misses the other.
+		it('paints the content, its edge, and its dividers from the body aliases', () => {
+			const host = scene.mount(
+				`<div data-bs-theme="${mode}"><div class="modal d-block"><div class="modal-dialog">${MODAL_MARKUP}</div></div></div>`,
+			)
+			const island = requireValue(host.querySelector<HTMLElement>('[data-bs-theme]'), 'No island')
+			const content = requireValue(host.querySelector('.modal-content'), 'No content')
+			const header = requireValue(host.querySelector('.modal-header'), 'No header')
+			const footer = requireValue(host.querySelector('.modal-footer'), 'No footer')
+			const other = mode === 'light' ? 'dark' : 'light'
+			const probe = scene.mount(`<div data-bs-theme="${other}"></div>`)
+			const opposite = requireValue(probe.firstElementChild, 'No opposite island')
+			// Each alias is first held apart from the other mode's, so a literal matching this mode
+			// reddens the other mode's run of this case.
+			for (const alias of ['--bs-body-color', '--bs-body-bg'])
+				expect(matchesColor(readToken(island, alias), readToken(opposite, alias))).toBe(false)
+			for (const [element, property, alias] of [
+				[content, 'color', '--bs-body-color'],
+				[content, 'background-color', '--bs-body-bg'],
+				[content, 'border-top-color', '--bs-border-color-translucent'],
+				[header, 'border-bottom-color', '--bs-border-color'],
+				[footer, 'border-top-color', '--bs-border-color'],
+			] as const)
+				expect({
+					property,
+					matched: matchesColor(readStyle(element, property), readToken(island, alias)),
+				}).toEqual({
+					property,
+					matched: true,
+				})
+		})
+	})
+})
+
+describe('modal header close control', () => {
+	// The mutation this catches is the combinator written against the modal rather than the header: a
+	// control in the body would then take the header's inset and margins, and here it keeps its own.
+	it('fits the header control into the header inset and leaves a control outside the header alone', () => {
+		const host = scene.mount(
+			'<div class="modal d-block"><div class="modal-dialog"><div class="modal-content">' +
+				'<div class="modal-header"><h2 class="modal-title">Harbor manifest</h2><button type="button" class="btn-close" aria-label="Close"></button></div>' +
+				'<div class="modal-body"><button type="button" class="btn-close" aria-label="Dismiss"></button></div>' +
+				'</div></div></div>',
+		)
+		const header = requireValue(host.querySelector('.modal-header'), 'No header')
+		const inside = requireValue(header.querySelector('.btn-close'), 'No header control')
+		const outside = requireValue(host.querySelector('.modal-body .btn-close'), 'No body control')
+		for (const side of ['top', 'right', 'bottom', 'left'])
+			expect(readPixels(inside, `padding-${side}`)).toBe(8)
+		for (const side of ['top', 'right', 'bottom'])
+			expect(readPixels(inside, `margin-${side}`)).toBe(-8)
+		// The automatic start margin pushes the control to the header's end, and the negative end
+		// margin moves it half the header's inset past the inset's edge.
+		expect(readPixels(inside, 'margin-left')).toBeGreaterThan(0)
+		const edge = header.getBoundingClientRect().right - readPixels(header, 'padding-right')
+		expect(inside.getBoundingClientRect().right).toBeCloseTo(edge + 8, 3)
+		const em = readPixels(outside, 'font-size')
+		for (const side of ['top', 'right', 'bottom', 'left']) {
+			expect(readPixels(outside, `padding-${side}`)).toBeCloseTo(em * 0.25, 3)
+			expect(readPixels(outside, `margin-${side}`)).toBe(0)
+		}
+	})
+
+	// The mutation this catches is the control's inset written as a length: it reads the header's own
+	// slots, so a retune of those slots on the modal moves the control with the header.
+	it('follows a retune of the header inset on the modal', () => {
+		const host = scene.mount(
+			'<div class="modal d-block" style="--bs-modal-header-padding-x: 40px; --bs-modal-header-padding-y: 20px"><div class="modal-dialog"><div class="modal-content"><div class="modal-header"><h2 class="modal-title">Harbor manifest</h2><button type="button" class="btn-close" aria-label="Close"></button></div></div></div></div>',
+		)
+		const control = requireValue(host.querySelector('.btn-close'), 'No header control')
+		expect([
+			readPixels(control, 'padding-top'),
+			readPixels(control, 'padding-right'),
+			readPixels(control, 'margin-top'),
+			readPixels(control, 'margin-right'),
+			readPixels(control, 'margin-bottom'),
+		]).toEqual([10, 20, -10, -20, -10])
+	})
+})
+
+describe('modal dialog sizes', () => {
+	// The mutation this catches is a size class gated at the wrong boundary: each cap is read one
+	// pixel below the boundary where it takes effect and at that boundary, so a gate moved to a
+	// neighbouring name changes one of those readings.
+	it.each(MODAL_SIZE_CASES)(
+		'caps the $name dialog at each boundary its size names',
+		async ({ classes, caps }) => {
+			const host = scene.mount(
+				`<div class="modal d-block"><div class="modal-dialog ${classes}"><div class="modal-content">Harbor manifest</div></div></div>`,
+			)
+			const modal = requireValue(host.querySelector('.modal'), 'No modal')
+			const dialog = requireValue(host.querySelector('.modal-dialog'), 'No dialog')
+			const measured = []
+			const expected: unknown[] = []
+			for (const [index, { boundary, cap }] of caps.entries()) {
+				const previous = index === 0 ? undefined : caps[index - 1]?.cap
+				for (const [width, limit] of [
+					[boundary - 1, previous],
+					[boundary, cap],
+				] as const) {
+					measured.push(
+						await visitBreakpoint(width, () => ({
+							width,
+							cap: readStyle(dialog, 'max-width'),
+							margin: readPixels(dialog, 'margin-top'),
+							size: dialog.getBoundingClientRect().width,
+							room: modal.clientWidth,
+						})),
+					)
+					const margin = width < 576 ? MODAL_GEOMETRY.margin : MODAL_GEOMETRY.wide
+					expected.push({ width, cap: limit === undefined ? 'none' : `${String(limit)}px`, margin })
+				}
+			}
+			expect(measured.map(({ width, cap, margin }) => ({ width, cap, margin }))).toEqual(expected)
+			// The dialog takes its cap where the room allows and the room less its margins otherwise.
+			for (const { width, size, room, margin, cap } of measured) {
+				const limit = cap === 'none' ? Number.POSITIVE_INFINITY : Number.parseFloat(cap)
+				expect({ width, size }).toEqual({ width, size: Math.min(limit, room - margin * 2) })
+			}
+		},
+	)
+
+	// The mutation this catches is a fullscreen class gated from its boundary up rather than below
+	// it: each named class is read one pixel below its boundary, where it fills the viewport, and at
+	// the boundary, where the dialog is the default one again. The unsuffixed class fills the
+	// viewport at every variant.
+	it.each(
+		MODAL_FULLSCREEN_CASES.map(({ classes, boundary }) => ({
+			classes,
+			readings:
+				boundary === undefined
+					? VIEWPORT_WIDTHS.map((width) => ({ width, filled: true }))
+					: [
+							{ width: boundary - 1, filled: true },
+							{ width: boundary, filled: false },
+						],
+		})),
+	)(
+		'fills the viewport with the $classes dialog only where its class applies',
+		async ({ classes, readings }) => {
+			const host = scene.mount(
+				`<div class="modal d-block"><div class="modal-dialog ${classes}">${MODAL_MARKUP}</div></div>`,
+			)
+			const modal = requireValue(host.querySelector('.modal'), 'No modal')
+			const dialog = requireValue(host.querySelector('.modal-dialog'), 'No dialog')
+			const content = requireValue(host.querySelector('.modal-content'), 'No content')
+			const header = requireValue(host.querySelector('.modal-header'), 'No header')
+			const footer = requireValue(host.querySelector('.modal-footer'), 'No footer')
+			const body = requireValue(host.querySelector('.modal-body'), 'No body')
+			const measured = []
+			for (const { width } of readings)
+				measured.push(
+					await visitBreakpoint(width, () => {
+						const box = dialog.getBoundingClientRect()
+						return {
+							width,
+							filled: box.width === window.innerWidth && box.height === modal.clientHeight,
+							margin: readPixels(dialog, 'margin-top'),
+							cap: readStyle(dialog, 'max-width'),
+							edge: readPixels(content, 'border-top-width'),
+							corners: [
+								readPixels(content, 'border-top-left-radius'),
+								readPixels(header, 'border-top-left-radius'),
+								readPixels(footer, 'border-bottom-right-radius'),
+							],
+							body: readStyle(body, 'overflow-y'),
+						}
+					}),
+				)
+			expect(measured).toEqual(
+				readings.map(({ width, filled }) =>
+					filled
+						? { width, filled, margin: 0, cap: 'none', edge: 0, corners: [0, 0, 0], body: 'auto' }
+						: {
+								width,
+								filled,
+								margin: MODAL_GEOMETRY.wide,
+								cap: '500px',
+								edge: 1,
+								corners: [8, 7, 7],
+								body: 'visible',
+							},
+				),
+			)
+		},
+	)
+})
+
+describe('modal dialog placement', () => {
+	// The mutations this catches are the centering rule's flex layout, its cross-axis alignment, or its
+	// height floor dropped: each leaves the content at the top of the dialog.
+	it('centers the content of a centered dialog in the modal and leaves a plain dialog at the top', async () => {
+		const host = scene.mount(
+			'<div class="modal d-block" data-place="centered"><div class="modal-dialog modal-dialog-centered"><div class="modal-content" style="height: 100px">Harbor manifest</div></div></div>' +
+				'<div class="modal d-block" data-place="plain"><div class="modal-dialog"><div class="modal-content" style="height: 100px">Harbor manifest</div></div></div>',
+		)
+		// The narrowest variant is read, where the dialog takes its narrow margin.
+		const [centered, plain] = await visitBreakpoint(390, () =>
+			['centered', 'plain'].map((place) => {
+				const modal = requireValue(
+					host.querySelector(`[data-place="${place}"]`),
+					`No ${place} modal`,
+				)
+				const box = modal.getBoundingClientRect()
+				const content = requireValue(modal.querySelector('.modal-content'), 'No content')
+				const inner = content.getBoundingClientRect()
+				return {
+					height: modal.clientHeight,
+					viewport: window.innerHeight,
+					middle: box.top + modal.clientHeight / 2,
+					center: inner.top + inner.height / 2,
+					top: inner.top - box.top,
+				}
+			}),
+		)
+		const middle = requireValue(centered, 'No centered reading')
+		const top = requireValue(plain, 'No plain reading')
+		// Each modal covers the viewport, so the centered content sits halfway down the viewport and
+		// the plain content sits one dialog margin below the viewport's top.
+		expect([middle.height, top.height]).toEqual([middle.viewport, top.viewport])
+		expect(middle.center).toBeCloseTo(middle.middle, 0)
+		expect(top.top).toBe(MODAL_GEOMETRY.margin)
+	})
+
+	// The mutations this catches are the scrollable dialog's height, the content's cap, or the body's
+	// scroll dropped: each lets the content grow past the modal instead of scrolling its body.
+	it('holds a scrollable dialog inside the modal and scrolls its body between a fixed header and footer', () => {
+		const host = scene.mount(
+			'<div class="modal d-block"><div class="modal-dialog modal-dialog-scrollable"><div class="modal-content">' +
+				'<div class="modal-header"><h2 class="modal-title">Harbor manifest</h2></div>' +
+				'<div class="modal-body"><div style="height: 2000px">The oak order clears the north gate at noon.</div></div>' +
+				'<div class="modal-footer"><button type="button" class="btn btn-primary">Release</button></div>' +
+				'</div></div></div>',
+		)
+		const modal = requireValue(host.querySelector('.modal'), 'No modal')
+		const dialog = requireValue(host.querySelector('.modal-dialog'), 'No dialog')
+		const body = requireValue(host.querySelector('.modal-body'), 'No body')
+		const footer = requireValue(host.querySelector('.modal-footer'), 'No footer')
+		const margin = readPixels(dialog, 'margin-top')
+		const frame = dialog.getBoundingClientRect()
+		expect(frame.height).toBe(modal.clientHeight - margin * 2)
+		expect(readStyle(body, 'overflow-y')).toBe('auto')
+		expect(body.scrollHeight).toBeGreaterThan(body.clientHeight)
+		expect(footer.getBoundingClientRect().bottom).toBeLessThanOrEqual(frame.bottom)
+		// The modal itself does not scroll, because the dialog fits inside it.
+		expect(modal.scrollHeight).toBe(modal.clientHeight)
+	})
+})
+
+describe('modal motion', () => {
+	// The mutations this catches are the entrance offset dropped, the shown state failing to settle
+	// it, and the transition written without the `transition` mixin, which keeps its duration under
+	// the reduced-motion preference where the mixin collapses it.
+	it('starts a fading dialog from its entrance offset and settles it when shown, with no motion under the reduced-motion preference', async () => {
+		const host = scene.mount(
+			'<div class="modal fade d-block" data-state="fading"><div class="modal-dialog"></div></div>' +
+				'<div class="modal fade show d-block" data-state="shown"><div class="modal-dialog"></div></div>' +
+				'<div class="modal d-block" data-state="plain"><div class="modal-dialog"></div></div>',
+		)
+		const dialogs = ['fading', 'shown', 'plain'].map((state) =>
+			requireValue(
+				host.querySelector(`[data-state="${state}"] .modal-dialog`),
+				`No ${state} dialog`,
+			),
+		)
+		const readings: Array<ReadonlyArray<readonly string[]>> = []
+		for (const motion of [true, false]) {
+			await stageMedia({ motion })
+			readings.push(
+				dialogs.map((dialog) => [
+					readStyle(dialog, 'transform'),
+					readStyle(dialog, 'transition-property'),
+					readStyle(dialog, 'transition-duration'),
+					readStyle(dialog, 'transition-timing-function'),
+				]),
+			)
+		}
+		const offset = 'matrix(1, 0, 0, 1, 0, -50)'
+		expect(readings).toEqual([
+			[
+				[offset, 'transform', '0.3s', 'ease-out'],
+				['none', 'transform', '0.3s', 'ease-out'],
+				['none', 'all', '0s', 'ease'],
+			],
+			[
+				[offset, 'none', '0s', 'ease'],
+				['none', 'none', '0s', 'ease'],
+				['none', 'all', '0s', 'ease'],
+			],
+		])
+		expect(collectMediaConditions(collectLayer('components'), '.modal.fade .modal-dialog')).toEqual(
+			[REDUCED_MOTION],
+		)
+	})
+
+	// The mutation this catches is the static rule dropped: the bounce an engine gives a dialog that
+	// refuses to close scales it over the settled dialog, which otherwise holds no transform.
+	it('scales a static dialog over the settled one', () => {
+		const host = scene.mount(
+			'<div class="modal fade show modal-static d-block"><div class="modal-dialog"></div></div><div class="modal fade show d-block"><div class="modal-dialog"></div></div>',
+		)
+		expect(
+			[...host.querySelectorAll('.modal-dialog')].map((dialog) => readStyle(dialog, 'transform')),
+		).toEqual(['matrix(1.02, 0, 0, 1.02, 0, 0)', 'none'])
+	})
+})
+
+describe('modal backdrop', () => {
+	// The mutations this catches are the backdrop's shown opacity dropped, which leaves a fading and
+	// shown backdrop transparent, and its opacity written as a literal, which a retune of the variable
+	// on the backdrop leaves in place. A backdrop carrying the `fade` class alone is what an engine
+	// writes for the frame before it adds the `show` class; it paints nothing, so no specimen renders
+	// it and it is read here instead.
+	it('covers the viewport in the black token, transparent while fading and at its opacity when shown', () => {
+		const host = scene.mount(
+			'<div class="modal-backdrop"></div><div class="modal-backdrop fade"></div><div class="modal-backdrop fade show"></div><div class="modal-backdrop fade show" style="--bs-backdrop-opacity: 0.8"></div>',
+		)
+		const backdrops = [...host.querySelectorAll('.modal-backdrop')]
+		expect(backdrops.map((backdrop) => readStyle(backdrop, 'opacity'))).toEqual([
+			'1',
+			'0',
+			MODAL_GEOMETRY.opacity,
+			'0.8',
+		])
+		const backdrop = requireValue(backdrops[0], 'No backdrop')
+		const box = backdrop.getBoundingClientRect()
+		expect([box.left, box.top, box.width, box.height]).toEqual([
+			0,
+			0,
+			window.innerWidth,
+			window.innerHeight,
+		])
+		expect(readStyle(backdrop, 'position')).toBe('fixed')
+		expect(
+			matchesColor(
+				readStyle(backdrop, 'background-color'),
+				readRootToken('--vn-palette-black-base'),
+			),
+		).toBe(true)
+		// The fill reads its variable, so a retune on the backdrop moves it.
+		backdrop.setAttribute('style', '--bs-backdrop-bg: rgb(10, 20, 30)')
+		expect(readStyle(backdrop, 'background-color')).toBe('rgb(10, 20, 30)')
+	})
+})
