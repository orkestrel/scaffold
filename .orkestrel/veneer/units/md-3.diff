+import { MODAL_COPY, MODAL_SPECIMENS } from '../constants.js'
+import { SpecimenSection } from './SpecimenSection.js'
+
+/**
+ * Renders the declared modal specimens into a named region.
+ * @example
+ * ```ts
+ * const section = new ModalSection(document.body)
+ * section.destroy()
+ * ```
+ */
+export class ModalSection extends SpecimenSection {
+	/**
+	 * Mounts the Modal region and its specimens.
+	 * @param host - The element receiving the section.
+	 */
+	constructor(host: HTMLElement) {
+		super(host, MODAL_COPY, MODAL_SPECIMENS)
+	}
+}
