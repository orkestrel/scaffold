+import type { SectionInterface } from '@app/browser'
+import { MODAL_COPY, MODAL_SPECIMENS, ModalSection, SpecimenSection } from '@app/browser'
+import { requireValue } from '@orkestrel/test'
+import {
+	build,
+	mount,
+	readClipEdge,
+	readName,
+	readStyle,
+	resolveAccessible,
+} from '@orkestrel/test/browser'
+import { beforeAll, describe, expect, it } from 'vitest'
+import { readSpecimen, visitBreakpoint } from '../../../setupBrowser.js'
+import { CASCADE_KEYS } from '../../../setup.js'
+import {
+	MODAL_FULLSCREEN_CASES,
+	MODAL_SELECTORS,
+	MODAL_SIZE_CASES,
+	VIEWPORT_WIDTHS,
+} from '../../../setupStyles.js'
+
+// Each specimen claims a state the published cascade renders from a class inside the shell's
+// frame, so the published cascade and the shell's stylesheet have to be in the document before a
+// reading of that state means anything.
+beforeAll(async () => {
+	await import('../../../../src/styles/index.scss')
+	await import('../../../../app/browser/styles/index.scss')
+})
+
+describe('ModalSection', () => {
+	it('renders every dialog state and class inside a frame through the shared section contract', () => {
+		const host = mount(build('div'))
+		const section: SectionInterface = new ModalSection(host)
+		try {
+			expect(section).toBeInstanceOf(SpecimenSection)
+			expect(section.host).toBe(host)
+			const region = requireValue(host.querySelector('section'), 'No Modal region')
+			expect(region.getAttribute('aria-label')).toBe('Modal')
+			expect(region.querySelector('p')?.textContent).toBe(MODAL_COPY.paragraph)
+			const rendered = [...region.querySelectorAll('[data-specimen]')]
+			expect(rendered.map((element) => element.getAttribute('data-specimen'))).toEqual(
+				MODAL_SPECIMENS.map(({ name }) => name),
+			)
+			expect(rendered.map((element) => element.innerHTML)).toEqual(
+				MODAL_SPECIMENS.map(({ markup }) => markup),
+			)
+			// The engine writes a modal's display inline; the specimens carry the `d-block` utility in
+			// its place, so no element in the region carries an inline style.
+			expect(region.querySelector('[style]')).toBeNull()
+			// Every class a recorded modal selector names renders in the region, so a developer-written
+			// class no specimen carries reports here by name.
+			const classes = new Set(
+				MODAL_SELECTORS.flatMap((selector) =>
+					[...selector.matchAll(/\.([\w-]+)/gu)].flatMap(([, name]) =>
+						name === undefined ? [] : [name],
+					),
+				),
+			)
+			expect([...classes].filter((name) => region.querySelector(`.${name}`) === null)).toEqual([])
+			// Each size class and each fullscreen class sits on the dialog of one specimen of its own.
+			const dialogs = [
+				...MODAL_SIZE_CASES.flatMap(({ classes: size }) => (size === '' ? [] : [size])),
+				...MODAL_FULLSCREEN_CASES.map(({ classes: fullscreen }) => fullscreen),
+			]
+			expect(
+				dialogs.map((name) => [name, region.querySelectorAll(`.modal-dialog.${name}`).length]),
+			).toEqual(dialogs.map((name) => [name, 1]))
+			// Each specimen is a registered capture subject whose declared selector it renders.
+			expect(
+				MODAL_SPECIMENS.map(({ name }) => {
+					const keys = CASCADE_KEYS.filter(({ subject }) => subject === name)
+					return [
+						name,
+						keys.length,
+						keys.every(
+							({ selector }) => readSpecimen(region, name).querySelector(selector) !== null,
+						),
+					]
+				}),
+			).toEqual(MODAL_SPECIMENS.map(({ name }) => [name, 1, true]))
+			expect(Object.isFrozen(MODAL_COPY)).toBe(true)
+			expect(Object.isFrozen(MODAL_SPECIMENS)).toBe(true)
+			expect(MODAL_SPECIMENS.every((entry) => Object.isFrozen(entry))).toBe(true)
+		} finally {
+			section.destroy()
+			host.remove()
+		}
+	})
+
+	// The mutations this catches are a specimen that leaves the frame, drops the display stand-in or
+	// the shown classes, claims the engine's body class, or carries a backdrop the shown specimen
+	// alone renders.
+	it('opens each dialog inside its frame with the shown classes, and renders the backdrop in the shown specimen alone', () => {
+		const host = mount(build('div'))
+		const section: SectionInterface = new ModalSection(host)
+		try {
+			const region = requireValue(host.querySelector('section'), 'No Modal region')
+			const readings = MODAL_SPECIMENS.map(({ name }) => {
+				const specimen = readSpecimen(region, name)
+				const frame = requireValue(specimen.firstElementChild, `No frame in ${name}`)
+				const modal = requireValue(frame.querySelector(':scope > .modal'), `No modal in ${name}`)
+				return {
+					name,
+					frame: frame.classList.contains('viewport') && specimen.children.length === 1,
+					classes: ['fade', 'show', 'd-block'].every((token) => modal.classList.contains(token)),
+					display: readStyle(modal, 'display'),
+					backdrops: [...frame.children]
+						.filter((child) => child.classList.contains('modal-backdrop'))
+						.map((backdrop) => [...backdrop.classList].join(' ')),
+					nested: specimen.querySelectorAll('.modal-backdrop').length,
+				}
+			})
+			expect(readings).toEqual(
+				MODAL_SPECIMENS.map(({ name }) => ({
+					name,
+					frame: true,
+					classes: true,
+					display: 'block',
+					backdrops: name === 'Shown modal' ? ['modal-backdrop fade show'] : [],
+					nested: name === 'Shown modal' ? 1 : 0,
+				})),
+			)
+			// An engine sets the `modal-open` class on the document body and no rule reads it, so a
+			// specimen carrying it would claim a paint the cascade does not make.
+			expect(region.querySelector('.modal-open')).toBeNull()
+			expect(document.body.classList.contains('modal-open')).toBe(false)
+			// The backdrop sits one rung below the dialog it lies behind, at the recorded opacity.
+			const shown = readSpecimen(region, 'Shown modal')
+			const backdrop = requireValue(shown.querySelector('.modal-backdrop'), 'No backdrop')
+			const modal = requireValue(shown.querySelector('.modal'), 'No shown modal')
+			expect(Number(readStyle(backdrop, 'z-index'))).toBeLessThan(
+				Number(readStyle(modal, 'z-index')),
+			)
+			expect(readStyle(backdrop, 'opacity')).toBe('0.5')
+		} finally {
+			section.destroy()
+			host.remove()
+		}
+	})
+
+	// The mutations this catches are a dialog that claims to be modal, which would take every control
+	// outside it out of reach, and a dialog or a close control left without a name.
+	it('names each dialog by its title and each close control by its label, and claims no modality', () => {
+		const host = mount(build('div'))
+		const outside = build('button', {
+			text: 'Outside the showcase',
+			attributes: { type: 'button' },
+		})
+		host.append(outside)
+		const section: SectionInterface = new ModalSection(host)
+		try {
+			const region = requireValue(host.querySelector('section'), 'No Modal region')
+			const dialogs = [...region.querySelectorAll('.modal')]
+			expect(
+				dialogs.map((dialog) => [
+					dialog.getAttribute('role'),
+					dialog.hasAttribute('aria-modal'),
+					readName(dialog),
+				]),
+			).toEqual(MODAL_SPECIMENS.map(({ name }) => ['dialog', false, name]))
+			const controls = [...region.querySelectorAll('.modal-header .btn-close')]
+			expect(controls).toHaveLength(MODAL_SPECIMENS.length)
+			for (const control of controls) {
+				expect(control.getAttribute('aria-label')).toBe('Close')
+				expect(readName(control)).toBe('Close')
+				expect(control.textContent).toBe('')
+			}
+			// A dialog carrying the `aria-modal` attribute makes the resolver refuse every control
+			// outside it, which is the reading that separates a dialog claiming modality from one that
+			// does not. The shown dialog is read with the attribute and without it.
+			expect(resolveAccessible('button', 'Outside the showcase')).toBe(outside)
+			const shown = requireValue(
