+++ b/app/browser/sections/FadeSection.ts
@@ -0,0 +1,20 @@
+import { TRANSITION_COPY, TRANSITION_SPECIMENS } from '../constants.js'
+import { SpecimenSection } from './SpecimenSection.js'
+
+/**
+ * Renders the declared fade specimens into a named region.
+ * @example
+ * ```ts
+ * const section = new FadeSection(document.body)
+ * section.destroy()
+ * ```
+ */
+export class FadeSection extends SpecimenSection {
+	/**
+	 * Mounts the Fade region and its specimens.
+	 * @param host - The element receiving the section.
+	 */
+	constructor(host: HTMLElement) {
+		super(host, TRANSITION_COPY, TRANSITION_SPECIMENS)
+	}
+}
diff --git a/tests/app/browser/sections/FadeSection.test.ts b/tests/app/browser/sections/FadeSection.test.ts
new file mode 100644
index 0000000..7771482
--- /dev/null
+++ b/tests/app/browser/sections/FadeSection.test.ts
@@ -0,0 +1,111 @@
+import type { SectionInterface } from '@app/browser'
+import { FadeSection, SpecimenSection, TRANSITION_COPY, TRANSITION_SPECIMENS } from '@app/browser'
+import { requireValue } from '@orkestrel/test'
+import { build, mount, readPixels, readStyle } from '@orkestrel/test/browser'
+import { beforeAll, describe, expect, it } from 'vitest'
+import { readSpecimen } from '../../../setupBrowser.js'
+
+// Each specimen claims a state the published cascade renders from a class, so the cascade has to be
+// in the document before a reading of that state means anything.
+beforeAll(async () => {
+	await import('../../../../src/styles/index.scss')
+	await import('../../../../app/browser/styles/index.scss')
+})
+
+describe('FadeSection', () => {
+	it('renders the declared fade specimens through the shared section contract', () => {
+		const host = mount(build('div'))
+		const section: SectionInterface = new FadeSection(host)
+		try {
+			expect(section).toBeInstanceOf(SpecimenSection)
+			expect(section.host).toBe(host)
+			const region = requireValue(host.querySelector('section'), 'No Fade region')
+			expect(region.getAttribute('aria-label')).toBe('Fade')
+			expect(region.querySelector('p')?.textContent).toBe(TRANSITION_COPY.paragraph)
+			expect(TRANSITION_SPECIMENS).not.toStrictEqual([])
+			const rendered = [...region.querySelectorAll('[data-specimen]')]
+			expect(rendered.map((element) => element.getAttribute('data-specimen'))).toEqual(
+				TRANSITION_SPECIMENS.map(({ name }) => name),
+			)
+			expect(rendered.map((element) => element.innerHTML)).toEqual(
+				TRANSITION_SPECIMENS.map(({ markup }) => markup),
+			)
+			// Both resting states this key ships reach the region, each as a class in markup, and no
+			// specimen writes an inline style or carries a trigger an engine would bind: moving an
+			// element between the states is a plugin's obligation, not the key's.
+			expect(region.querySelector('.fade.show')).not.toBeNull()
+			expect(region.querySelector('.fade:not(.show)')).not.toBeNull()
+			expect(region.querySelector('[style]')).toBeNull()
+			expect(
+				region.querySelector('[data-bs-toggle], [data-bs-target], [data-bs-dismiss], button'),
+			).toBeNull()
+			expect(Object.isFrozen(TRANSITION_COPY)).toBe(true)
+			expect(Object.isFrozen(TRANSITION_SPECIMENS)).toBe(true)
+			expect(TRANSITION_SPECIMENS.every((entry) => Object.isFrozen(entry))).toBe(true)
+		} finally {
+			section.destroy()
+			host.remove()
+		}
+	})
+
+	// The mutations this catches are a specimen that stops carrying the class its name claims and a
+	// wrapper that stops reserving the hidden body's box: a shown body that drops the `show` class
+	// reads transparent, a hidden body that gains it reads opaque, and a hidden body taken out of the
+	// flow leaves its card as tall as its header and borders. The state each specimen claims is the
+	// last word of its name.
+	it('renders each body in the state its specimen names, inside a card that keeps its box', () => {
+		const host = mount(build('div'))
+		const section: SectionInterface = new FadeSection(host)
+		try {
+			const region = requireValue(host.querySelector('section'), 'No Fade region')
+			const readings = TRANSITION_SPECIMENS.map(({ name }) => {
+				const specimen = readSpecimen(region, name)
+				const bodies = [...specimen.querySelectorAll('.fade')]
+				expect({ name, bodies: bodies.length }).toEqual({ name, bodies: 1 })
+				const body = requireValue(bodies[0], `No fading body in ${name}`)
+				const card = requireValue(body.parentElement, `No card in ${name}`)
+				const header = requireValue(card.querySelector('.card-header'), `No header in ${name}`)
+				return {
+					state: name.split(' ').at(-1),
+					shown: body.classList.contains('show'),
+					opacity: readStyle(body, 'opacity'),
+					hidden: body.getAttribute('aria-hidden'),
+					reserved:
+						card.getBoundingClientRect().height -
+							header.getBoundingClientRect().height -
+							2 * readPixels(card, 'border-top-width') >
+						0.5,
+				}
+			})
+			expect(new Set(readings.map(({ state }) => state))).toEqual(new Set(['shown', 'hidden']))
+			expect(readings).toEqual(
+				readings.map(({ state }) =>
+					state === 'shown'
+						? { state, shown: true, opacity: '1', hidden: null, reserved: true }
+						: { state, shown: false, opacity: '0', hidden: 'true', reserved: true },
+				),
+			)
+		} finally {
+			section.destroy()
+			host.remove()
+		}
+	})
+
+	it('releases the region and preserves adjacent content on repeated destruction', () => {
+		const host = mount(build('div'))
+		const neighbor = build('p', { text: 'Existing content' })
+		host.append(neighbor)
+		const section: SectionInterface = new FadeSection(host)
+		try {
+			const region = requireValue(host.querySelector('section'), 'No Fade region')
+			expect(region.isConnected).toBe(true)
+			section.destroy()
+			expect(region.isConnected).toBe(false)
+			section.destroy()
+			expect([...host.children]).toEqual([neighbor])
+		} finally {
+			section.destroy()
+			host.remove()
+		}
+	})
+})
