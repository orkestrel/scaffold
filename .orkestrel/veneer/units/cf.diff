index 0000000..831b36f
--- /dev/null
+++ b/src/styles/components/_fade.scss
@@ -0,0 +1,25 @@
+@use '../mixins' as *;
+
+@layer components {
+	// These rules ship the release's `.fade` class and its hidden state as recorded. The state is a
+	// class set in markup: an element carrying the `fade` class rests transparent until the `show`
+	// class joins it. Opacity is the only property the hidden state writes, so a hidden element keeps
+	// its box, its pointer target, and its place in the accessible tree. No rule here paints a color,
+	// so no color mode retunes one. The release records the dialog, modal backdrop, and offcanvas
+	// backdrop compounds under the same key; the modal and offcanvas partials write those beside the
+	// rules they compound.
+	//
+	// The duration reads the `--vn-motion-feedback` token, which resolves to the release's `0.15s`
+	// value, so the motion factor rescales it. The `transition` mixin emits the reduced-motion twin
+	// the release records beside the transition. The barrel loads this partial ahead of the collapse
+	// partial, the order in which the release's `transitions` partial writes the fade rules and the
+	// collapse rules, so on an element carrying the `fade` class and the `collapsing` class the
+	// `.collapsing` rule's transition wins the tie at equal specificity.
+	.fade {
+		@include transition(opacity var(--vn-motion-feedback) linear);
+	}
+
+	.fade:not(.show) {
+		opacity: 0;
+	}
+}
diff --git a/tests/src/styles/components/fade.test.ts b/tests/src/styles/components/fade.test.ts
new file mode 100644
index 0000000..4c83df0
--- /dev/null
+++ b/tests/src/styles/components/fade.test.ts
@@ -0,0 +1,218 @@
+import { TOKEN_NAMES } from '@src/core'
+import { requireValue } from '@orkestrel/test'
+import { readHit, readStyle, releaseMedia, stageMedia } from '@orkestrel/test/browser'
+import { afterEach, describe, expect, it } from 'vitest'
+import { collectLayer, collectMediaConditions, scene } from '../../../setupBrowser.js'
+import {
+	FADE_COMPONENT_CASES,
+	FADE_SELECTORS,
+	normalizeComplexSelector,
+	REDUCED_MOTION,
+	splitTopLevelList,
+	TEXT_MODES,
+	trimCSSWhitespace,
+} from '../../../setupStyles.js'
+
+afterEach(async () => {
+	await releaseMedia()
+	document.documentElement.style.removeProperty(TOKEN_NAMES.factor.motion)
+	scene.clear()
+})
+
+describe('fade classes', () => {
+	// The mutation this catches is a rule the partial stops writing, or one it writes beyond the
+	// release: the reading is every components-layer selector whose classes are the `fade` class and
+	// the `show` class alone, so a missing hidden state and an added shown state each report here.
+	// The compounds the modal and offcanvas partials write carry their own classes and stay out.
+	it('writes the recorded fade selectors and no other rule on the fade and show classes alone', () => {
+		const written = new Set(
+			collectLayer('components').flatMap((rule) =>
+				rule instanceof CSSStyleRule
+					? splitTopLevelList(rule.selectorText)
+							.map((part) => normalizeComplexSelector(trimCSSWhitespace(part)))
+							.filter((selector) => {
+								const classes = [...selector.matchAll(/\.([\w-]+)/gu)].map(([, name]) => name)
+								return (
+									classes.includes('fade') &&
+									classes.every((name) => name === 'fade' || name === 'show')
+								)
+							})
+					: [],
+			),
+		)
+		expect(FADE_SELECTORS).not.toStrictEqual([])
+		expect([...written].sort()).toEqual(
+			FADE_SELECTORS.map((selector) => normalizeComplexSelector(selector)).sort(),
+		)
+	})
+
+	// The mutations this catches are the duration written as a literal, the reduced-motion twin
+	// dropped, and the hidden state dropped: the reading is each rule's own declarations at rest and
+	// under the reduced-motion condition, beside the resolved readings the following cases take.
+	it('declares the transition over the motion token, no transition under the reduced-motion condition, and the hidden opacity', () => {
+		const rules = collectLayer('components').flatMap((rule) =>
+			rule instanceof CSSStyleRule ? [rule] : [],
+		)
+		expect(
+			FADE_SELECTORS.map((selector) =>
+				rules
+					.filter(
+						(rule) =>
+							normalizeComplexSelector(trimCSSWhitespace(rule.selectorText)) ===
+							normalizeComplexSelector(selector),
+					)
+					.map((rule) => [
+						rule.parentRule instanceof CSSMediaRule ? rule.parentRule.conditionText : undefined,
+						...['transition', 'opacity'].map((property) => rule.style.getPropertyValue(property)),
+					]),
+			),
+		).toEqual([
+			[
+				[undefined, 'opacity var(--vn-motion-feedback) linear', ''],
+				[REDUCED_MOTION, 'none', ''],
+			],
+			[[undefined, '', '0']],
+		])
+	})
+
+	// The mutation this catches is the hidden state dropped: without it the hidden element paints at
+	// full strength, and written as a bare `.fade` rule it hides the shown element as well. The
+	// hidden element's box and hit target are read beside a plain element carrying the same text,
+	// so a hidden state that removed the element from the flow or from hit testing reports here too.
+	it('hides an element carrying the fade class until the show class joins it, and keeps the hidden box and hit target', () => {
+		const host = scene.mount(
+			'<div class="fade">Harbor notice</div><div class="fade show">Harbor notice</div><div>Harbor notice</div>',
+		)
+		const [hidden, shown, plain] = [...host.children]
+		const faded = requireValue(hidden, 'No hidden element')
+		const visible = requireValue(shown, 'No shown element')
+		const control = requireValue(plain, 'No plain element')
+		expect([faded, visible, control].map((element) => readStyle(element, 'opacity'))).toEqual([
+			'0',
+			'1',
+			'1',
+		])
+		expect(readStyle(faded, 'display')).toBe('block')
+		expect(readStyle(faded, 'visibility')).toBe('visible')
+		expect(faded.getBoundingClientRect().height).toBeGreaterThan(0)
+		expect(faded.getBoundingClientRect().height).toBe(control.getBoundingClientRect().height)
+		expect(readHit(faded)).toBe(faded)
+	})
+
+	// The mutation this catches is the reduced-motion twin dropped: the resting and the staged
+	// readings are taken on the same elements, so a transition that keeps its duration under the
+	// preference reports here. The hidden state carries no motion and no condition of its own.
+	it('transitions the opacity linearly over the feedback duration and collapses the transition under the reduced-motion preference', async () => {
+		const host = scene.mount(
+			'<div class="fade">Pier notice</div><div class="fade show">Pier notice</div>',
+		)
+		const elements = [...host.children]
+		const readings: Array<ReadonlyArray<readonly string[]>> = []
+		for (const motion of [true, false]) {
+			await stageMedia({ motion })
+			readings.push(
+				elements.map((element) =>
+					[
+						'transition-property',
+						'transition-duration',
+						'transition-delay',
+						'transition-timing-function',
+					].map((property) => readStyle(element, property)),
+				),
+			)
+		}
+		expect(readings).toEqual([
+			[
+				['opacity', '0.15s', '0s', 'linear'],
+				['opacity', '0.15s', '0s', 'linear'],
+			],
+			[
+				['none', '0s', '0s', 'ease'],
+				['none', '0s', '0s', 'ease'],
+			],
+		])
+		expect(collectMediaConditions(collectLayer('components'), '.fade')).toEqual([REDUCED_MOTION])
+		expect(collectMediaConditions(collectLayer('components'), '.fade:not(.show)')).toEqual([])
+	})
+
+	// The mutation this catches is the duration written as the release's `0.15s` literal: the
+	// literal ignores the motion factor, and the feedback token rescales with it where the factor
+	// is set on the root, which is where the motion scale is declared.
+	it('rescales the transition with the published motion factor', () => {
+		const host = scene.mount('<div class="fade show">Quay notice</div>')
+		const element = requireValue(host.firstElementChild, 'No fading element')
+		expect(readStyle(element, 'transition-duration')).toBe('0.15s')
+		document.documentElement.style.setProperty(TOKEN_NAMES.factor.motion, '2')
+		expect(readStyle(element, 'transition-duration')).toBe('0.3s')
+	})
+
+	// The mutation this catches is the partial loaded after the collapse partial. The `.fade` rule
+	// and the `.collapsing` rule each write a transition at one specificity, so the later rule wins
+	// on an element carrying the `fade` class and the `collapsing` class. The release loads the fade
+	// rule first, so that element transitions its size. The lone fading element is the reading that
+	// the fade rule is present.
+	it('yields the transition to the collapsing rule on an element carrying the fade and collapsing classes', () => {
+		const host = scene.mount(
+			'<div class="fade collapsing" style="height: 24px">Tide table</div><div class="fade">Tide table</div>',
+		)
+		expect(
+			[...host.children].map((element) => [
+				readStyle(element, 'transition-property'),
+				readStyle(element, 'transition-duration'),
+				readStyle(element, 'transition-timing-function'),
+			]),
+		).toEqual([
+			['height', '0.35s', 'ease'],
+			['opacity', '0.15s', 'linear'],
+		])
+	})
+
+	// The mutation this catches is the hidden state dropped, which leaves an animated alert or
+	// popover painting before the engine shows it. Each component's shown reading is compared with
+	// the same classes less the `fade` class, so the fade rule changes no shown paint, and every set
+	// carrying the class transitions its opacity whichever rule hides it.
+	it('fades each component the release animates, and leaves each shown component its own opacity', () => {
+		expect(FADE_COMPONENT_CASES).not.toStrictEqual([])
+		const readings = FADE_COMPONENT_CASES.map(({ component, hidden, shown }) => {
+			const host = scene.mount(
+				[hidden, shown, shown.replace(/\bfade\b\s*/u, '')]
+					.map((classes) => `<div class="${classes}">Ferry notice</div>`)
+					.join(''),
+			)
+			const [faded, visible, control] = [...host.children].map((element) => [
+				readStyle(element, 'opacity'),
+				readStyle(element, 'transition-property'),
+			])
+			scene.clear()
+			return {
+				component,
+				read: { hidden: faded, shown: visible },
+				expected: { hidden: ['0', 'opacity'], shown: [control?.[0], 'opacity'] },
+			}
+		})
+		expect(readings.map(({ component, read }) => ({ component, ...read }))).toEqual(
+			readings.map(({ component, expected }) => ({ component, ...expected })),
+		)
+	})
+
+	// The mutation this catches is a treatment that moves with the color mode: the key paints
+	// nothing, so every reading it owns has to come back the same inside a dark island.
+	it('resolves every state the same inside a dark island as inside a light one', () => {
+		const readings = TEXT_MODES.map((mode) => {
+			const host = scene.mount(
+				`<div data-bs-theme="${mode}"><div class="fade">Lock notice</div><div class="fade show">Lock notice</div></div>`,
+			)
+			const island = requireValue(host.firstElementChild, 'No island')
+			const reading = [...island.children].flatMap((element) => [
+				readStyle(element, 'opacity'),
+				readStyle(element, 'transition-property'),
+				readStyle(element, 'transition-duration'),
+			])
+			scene.clear()
+			return reading
+		})
+		const [light, dark] = readings
+		expect(light).toEqual(['0', 'opacity', '0.15s', '1', 'opacity', '0.15s'])
+		expect(dark).toEqual(light)
+	})
+})
diff --git a/app/browser/sections/FadeSection.ts b/app/browser/sections/FadeSection.ts
