@@ -0,0 +1,26 @@
+/**
+ * Renders a captioned grid of swatches, one ratio box per class string.
+ *
+ * @param swatches - The class strings, one per swatch, in render order, such as the `bg-primary border` class string.
+ * @returns The grid markup: a row of three columns that widens to five from the md boundary, each
+ *   column holding a figure whose 4:3 ratio box carries the swatch's classes and whose caption
+ *   names them. An empty list returns the row alone.
+ *
+ * @remarks
+ * The caption is the class string itself, so a swatch's label cannot drift from the classes its box
+ * carries. The markup composes the grid, figure, and ratio classes the cascade ships; it writes no
+ * inline style.
+ *
+ * @example
+ * ```ts
+ * renderSwatches(['bg-success', 'bg-success bg-opacity-50'])
+ * ```
+ */
+export function renderSwatches(swatches: readonly string[]): string {
+	return `<div class="row row-cols-3 row-cols-md-5 g-2">${swatches
+		.map(
+			(classes) =>
+				`<div class="col"><figure class="figure w-100"><div class="ratio ratio-4x3 ${classes}"></div><figcaption class="figure-caption">${classes}</figcaption></figure></div>`,
+		)
+		.join('')}</div>`
+}
