+import { BORDER_COPY, BORDER_SPECIMENS } from '../constants.js'
+import { SpecimenSection } from './SpecimenSection.js'
+
+/**
+ * Renders the declared border side, color, width, opacity, and radius specimens into a named Border
+ * region.
+ *
+ * @example
+ * ```ts
+ * const section = new BorderSection(document.body)
+ * section.destroy()
+ * ```
+ */
+export class BorderSection extends SpecimenSection {
+	/**
+	 * Mounts the Border region and its specimens in table order.
+	 * @param host - The element receiving the section.
+	 */
+	constructor(host: HTMLElement) {
+		super(host, BORDER_COPY, BORDER_SPECIMENS)
+	}
+}
diff --git a/src/styles/utilities/_background.scss b/src/styles/utilities/_background.scss
new file mode 100644
index 0000000..8b07943
--- /dev/null
+++ b/src/styles/utilities/_background.scss
@@ -0,0 +1,64 @@
+@use 'sass:map';
+@use '../mixins' as *;
+@use '../tokens';
+
+@layer utilities {
+	// Stands in for the release's `$utilities-bg-colors` map: every aliased role reads its channel
+	// alias, then black, white, and the body surface, each under the opacity local; the
+	// `transparent` value takes no channels, and the two body tiers read the secondary and tertiary
+	// surface aliases the theme re-declares per mode. The role walk is the aliased list, so Veneer's own `tertiary` role,
+	// which carries no Bootstrap alias, writes no class.
+	$fills: ();
+	@each $role in tokens.$aliased {
+		$fills: map.set($fills, $role, rgba(var(--bs-#{$role}-rgb), var(--bs-bg-opacity)));
+	}
+	$fills: map.merge(
+		$fills,
+		(
+			'black': rgba(var(--bs-black-rgb), var(--bs-bg-opacity)),
+			'white': rgba(var(--bs-white-rgb), var(--bs-bg-opacity)),
+			'body': rgba(var(--bs-body-bg-rgb), var(--bs-bg-opacity)),
+			'transparent': transparent,
+			'body-secondary': rgba(var(--bs-secondary-bg-rgb), var(--bs-bg-opacity)),
+			'body-tertiary': rgba(var(--bs-tertiary-bg-rgb), var(--bs-bg-opacity)),
+		)
+	);
+	// Stands in for the release's `$utilities-bg-subtle` map, one subtle tier per aliased role.
+	$subtle: ();
+	@each $role in tokens.$aliased {
+		$subtle: map.set($subtle, '#{$role}-subtle', var(--bs-#{$role}-bg-subtle));
+	}
+	$opacities: (
+		10: 0.1,
+		25: 0.25,
+		50: 0.5,
+		75: 0.75,
+		100: 1,
+	);
+	// No background entry is responsive, so each writes at the empty infix alone. The opacity entry
+	// writes a custom property, which the `utility-variable` mixin writes at no infix, so the walk
+	// writes it at the empty infix as the `utility` mixin gates its own entries.
+	@include breakpoint-each using ($infix, $_boundary) {
+		@include utility(
+			bg,
+			background-color,
+			$fills,
+			$infix,
+			$locals: (
+				bg-opacity: 1,
+			)
+		);
+		@if $infix == '' {
+			@include utility-variable(bg-opacity, bg-opacity, $opacities);
+		}
+		@include utility(bg, background-color, $subtle, $infix);
+		@include utility(
+			bg,
+			background-image,
+			(
+				gradient: var(--bs-gradient),
+			),
+			$infix
+		);
+	}
+}
diff --git a/src/styles/utilities/_border.scss b/src/styles/utilities/_border.scss
new file mode 100644
index 0000000..1cafe78
--- /dev/null
+++ b/src/styles/utilities/_border.scss
@@ -0,0 +1,110 @@
+@use 'sass:map';
+@use '../mixins' as *;
+@use '../tokens';
+
+@layer utilities {
+	// Stands in for the release's border entries' shared map: the default border, then none.
+	$edges: (
+		null: var(--bs-border-width) var(--bs-border-style) var(--bs-border-color),
+		0: 0,
+	);
+	// Stands in for the release's `$utilities-border-colors` map: every aliased role reads its
+	// channel alias under the opacity local, then black and white. The role walk is the aliased
+	// list, so Veneer's own `tertiary` role, which carries no Bootstrap alias, writes no class.
+	$colors: ();
+	@each $role in tokens.$aliased {
+		$colors: map.set($colors, $role, rgba(var(--bs-#{$role}-rgb), var(--bs-border-opacity)));
+	}
+	$colors: map.merge(
+		$colors,
+		(
+			'black': rgba(var(--bs-black-rgb), var(--bs-border-opacity)),
+			'white': rgba(var(--bs-white-rgb), var(--bs-border-opacity)),
+		)
+	);
+	// Stands in for the release's `$utilities-border-subtle` map, one subtle tier per aliased role.
+	$subtle: ();
+	@each $role in tokens.$aliased {
+		$subtle: map.set($subtle, '#{$role}-subtle', var(--bs-#{$role}-border-subtle));
+	}
+	// Stands in for the release's `$border-widths` map. The widths stay literal, because no
+	// published Veneer token carries them.
+	$widths: (
+		1: 1px,
+		2: 2px,
+		3: 3px,
+		4: 4px,
+		5: 5px,
+	);
+	$opacities: (
+		10: 0.1,
+		25: 0.25,
+		50: 0.5,
+		75: 0.75,
+		100: 1,
+	);
+	// Stands in for the release's radius map, which the five rounded entries share.
+	$radii: (
+		null: var(--bs-border-radius),
+		0: 0,
+		1: var(--bs-border-radius-sm),
+		2: var(--bs-border-radius),
+		3: var(--bs-border-radius-lg),
+		4: var(--bs-border-radius-xl),
+		5: var(--bs-border-radius-xxl),
+		circle: 50%,
+		pill: var(--bs-border-radius-pill),
+	);
+	// No border or radius entry is responsive, so each writes at the empty infix alone, in the
+	// release's map order: the side entries follow the `border` shorthand and so beat it at one
+	// specificity. The opacity entry writes a custom property, which the `utility-variable` mixin
+	// writes at no infix, so the walk writes it at the empty infix as the `utility` mixin gates its
+	// own entries. The release writes the rounded entries later in its map; no utility between them
+	// sets a radius, so writing them here moves no resolution.
+	@include breakpoint-each using ($infix, $_boundary) {
+		@include utility(border, border, $edges, $infix);
+		@include utility(border-top, border-top, $edges, $infix);
+		@include utility(border-end, border-right, $edges, $infix);
+		@include utility(border-bottom, border-bottom, $edges, $infix);
+		@include utility(border-start, border-left, $edges, $infix);
+		@include utility(
+			border,
+			border-color,
+			$colors,
+			$infix,
+			$locals: (
+				border-opacity: 1,
+			)
+		);
+		@include utility(border, border-color, $subtle, $infix);
+		@include utility(border, border-width, $widths, $infix);
+		@if $infix == '' {
+			@include utility-variable(border-opacity, border-opacity, $opacities);
+		}
+		@include utility(rounded, border-radius, $radii, $infix);
+		@include utility(
+			rounded-top,
+			(border-top-left-radius, border-top-right-radius),
+			$radii,
+			$infix
+		);
+		@include utility(
+			rounded-end,
+			(border-top-right-radius, border-bottom-right-radius),
+			$radii,
+			$infix
+		);
+		@include utility(
+			rounded-bottom,
+			(border-bottom-right-radius, border-bottom-left-radius),
+			$radii,
+			$infix
+		);
+		@include utility(
+			rounded-start,
+			(border-bottom-left-radius, border-top-left-radius),
+			$radii,
+			$infix
+		);
+	}
+}
diff --git a/tests/app/browser/helpers.test.ts b/tests/app/browser/helpers.test.ts
new file mode 100644
index 0000000..81bdf6f
--- /dev/null
+++ b/tests/app/browser/helpers.test.ts
@@ -0,0 +1,67 @@
+import { renderSwatches } from '@app/browser'
+import { requireValue } from '@orkestrel/test'
+import { build } from '@orkestrel/test/browser'
+import { describe, expect, it } from 'vitest'
+
+describe('renderSwatches', () => {
+	it('renders one captioned ratio figure per class string inside the swatch grid, in order', () => {
+		const swatches = [
+			'bg-primary border',
+			'bg-success bg-opacity-50',
+			'border border-3 border-white bg-dark',
+		]
+		const container = build('div')
+		container.innerHTML = renderSwatches(swatches)
+		const grid = requireValue(container.firstElementChild, 'No grid')
+		expect(container.children).toHaveLength(1)
+		expect([...grid.classList]).toEqual(['row', 'row-cols-3', 'row-cols-md-5', 'g-2'])
+		const columns = [...grid.children]
+		expect(columns.map((column) => column.className)).toEqual(swatches.map(() => 'col'))
+		expect(
+			columns.map((column) => {
+				const figure = requireValue(column.firstElementChild, 'No figure')
+				const [box, caption] = [...figure.children]
+				return [
+					figure.tagName,
+					figure.className,
+					box?.className,
+					box?.childElementCount,
+					caption?.tagName,
+					caption?.className,
+					caption?.textContent,
+				]
+			}),
+		).toEqual(
+			swatches.map((classes) => [
+				'FIGURE',
+				'figure w-100',
+				`ratio ratio-4x3 ${classes}`,
+				0,
+				'FIGCAPTION',
+				'figure-caption',
+				classes,
+			]),
+		)
+		expect(container.querySelector('[style]')).toBeNull()
+	})
+
+	it('names in each caption the classes its own box carries beside the ratio classes', () => {
+		const container = build('div')
+		container.innerHTML = renderSwatches(['rounded-top-4 bg-primary', 'border border-0'])
+		expect(
+			[...container.querySelectorAll('figure')].map((figure) => [
+				[...(figure.querySelector('.ratio')?.classList ?? [])]
+					.filter((name) => !name.startsWith('ratio'))
+					.join(' '),
+				figure.querySelector('figcaption')?.textContent,
+			]),
+		).toEqual([
+			['rounded-top-4 bg-primary', 'rounded-top-4 bg-primary'],
+			['border border-0', 'border border-0'],
+		])
+	})
+
+	it('renders the grid alone for an empty list', () => {
+		expect(renderSwatches([])).toBe('<div class="row row-cols-3 row-cols-md-5 g-2"></div>')
+	})
+})
diff --git a/tests/app/browser/sections/BackgroundSection.test.ts b/tests/app/browser/sections/BackgroundSection.test.ts
new file mode 100644
index 0000000..18508b3
--- /dev/null
+++ b/tests/app/browser/sections/BackgroundSection.test.ts
@@ -0,0 +1,199 @@
+import type { SectionInterface } from '@app/browser'
+import {
+	BACKGROUND_COPY,
+	BACKGROUND_SPECIMENS,
+	BackgroundSection,
+	SpecimenSection,
+} from '@app/browser'
+import { requireValue } from '@orkestrel/test'
+import {
+	blendColor,
+	build,
+	measureContrast,
+	mount,
+	parseColor,
+	readStyle,
+} from '@orkestrel/test/browser'
+import { beforeAll, describe, expect, it } from 'vitest'
+import {
+	BACKGROUND_FILL_CASES,
+	PAINT_OPACITY_CASES,
+	SUBTLE_TIER_CASES,
+} from '../../../setupStyles.js'
+
+// The paint case reads the swatches as the published cascade and the shell lay them out, so both
+// stylesheets have to be in the document before a box is measured.
+beforeAll(async () => {
+	await import('../../../../src/styles/index.scss')
+	await import('../../../../app/browser/styles/index.scss')
+})
+
+describe('BackgroundSection', () => {
+	it('renders every declared specimen as captioned swatches through the shared section contract', () => {
+		const host = mount(build('div'))
+		const section: SectionInterface = new BackgroundSection(host)
+		try {
+			expect(section).toBeInstanceOf(SpecimenSection)
+			expect(section.host).toBe(host)
+			const region = requireValue(host.querySelector('section'), 'No Background region')
+			expect(region.getAttribute('aria-label')).toBe('Background')
+			expect(region.querySelector('p')?.textContent).toBe(BACKGROUND_COPY.paragraph)
+			const rendered = [...region.querySelectorAll('[data-specimen]')]
+			expect(rendered.map((element) => element.getAttribute('data-specimen'))).toEqual([
+				'Background roles',
+				'Subtle backgrounds',
+				'Body backgrounds',
+				'Background opacity',
+				'Background gradient',
+			])
+			expect(rendered.map((element) => element.innerHTML)).toEqual(
+				BACKGROUND_SPECIMENS.map((specimen) => specimen.markup),
+			)
+			// Each swatch's caption names the classes its box carries beside the ratio classes, so a
+			// caption that drifts from its swatch reddens here.
+			const swatches = [...region.querySelectorAll('figure.figure > .ratio.ratio-4x3')]
+			expect(swatches).not.toEqual([])
+			expect(
+				swatches.filter(
+					(swatch) =>
+						swatch.nextElementSibling?.textContent !==
+						[...swatch.classList].filter((name) => !name.startsWith('ratio')).join(' '),
+				),
+			).toEqual([])
+			// Every selector names a composition the specimens render, so the list of misses is empty.
+			expect(
+				[
+					...BACKGROUND_FILL_CASES.map(({ key }) =>
+						key.startsWith('body')
+							? `[data-specimen="Body backgrounds"] .ratio.bg-${key}.border`
+							: `[data-specimen="Background roles"] .ratio.bg-${key}`,
+					),
+					'[data-specimen="Body backgrounds"] .ratio.bg-transparent.border',
+					...SUBTLE_TIER_CASES.map(
+						({ role }) => `[data-specimen="Subtle backgrounds"] .ratio.bg-${role}-subtle`,
+					),
+					...PAINT_OPACITY_CASES.map(
+						({ step }) =>
+							`[data-specimen="Background opacity"] .ratio.bg-success.bg-opacity-${step}`,
+					),
+					'[data-specimen="Background gradient"] .ratio.bg-primary.bg-gradient',
+				].filter((selector) => region.querySelector(selector) === null),
+			).toEqual([])
+			expect(region.querySelector('[style]')).toBeNull()
+			expect(Object.isFrozen(BACKGROUND_COPY)).toBe(true)
+			expect(Object.isFrozen(BACKGROUND_SPECIMENS)).toBe(true)
+			expect(BACKGROUND_SPECIMENS.every((specimen) => Object.isFrozen(specimen))).toBe(true)
+		} finally {
+			section.destroy()
+			host.remove()
+		}
+	})
+
+	it('paints every swatch box, each opacity step at its alpha and each gradient over its fill', () => {
+		const host = mount(build('div'))
+		const section: SectionInterface = new BackgroundSection(host)
+		try {
+			const swatches = [...host.querySelectorAll('.ratio')]
+			expect(
+				swatches.filter((swatch) => {
+					const box = swatch.getBoundingClientRect()
+					return box.width === 0 || box.height === 0
+				}),
+			).toEqual([])
+			// Each opacity swatch is read against the step its own class names, so the reading holds
+			// whatever order the specimen renders the steps in.
+			const steps = [...host.querySelectorAll('[data-specimen="Background opacity"] .ratio')]
+			expect(
+				steps.map((swatch) => [
+					/\bbg-opacity-(\d+)\b/u.exec(swatch.className)?.[1],
+					parseColor(readStyle(swatch, 'background-color'))?.[3],
+				]),
+			).toEqual(
+				steps.map((swatch) => {
+					const step = /\bbg-opacity-(\d+)\b/u.exec(swatch.className)?.[1]
+					return [step, PAINT_OPACITY_CASES.find((entry) => entry.step === step)?.alpha]
+				}),
+			)
+			expect(steps).toHaveLength(PAINT_OPACITY_CASES.length)
+			const gradients = [...host.querySelectorAll('[data-specimen="Background gradient"] .ratio')]
+			expect(gradients).not.toEqual([])
+			expect(
+				gradients.filter(
+					(swatch) =>
+						!readStyle(swatch, 'background-image').startsWith('linear-gradient(') ||
+						parseColor(readStyle(swatch, 'background-color'))?.[3] !== 1,
+				),
+			).toEqual([])
+			// The body surfaces and the transparent fill match or show the page, so each draws the
+			// whole border that shows its box.
+			const surfaces = [...host.querySelectorAll('[data-specimen="Body backgrounds"] .ratio')]
+			expect(surfaces).not.toEqual([])
+			expect(surfaces.filter((swatch) => readStyle(swatch, 'border-top-width') !== '1px')).toEqual(
+				[],
+			)
+		} finally {
+			section.destroy()
+			host.remove()
+		}
+	})
+
+	it('draws every swatch box against the canvas in either mode, with a border where its fill matches the canvas', () => {
+		// A swatch shows its box where its fill, or the border it carries, reads at least 1.2:1 against
+		// the canvas; below that the fill matches the page, and the swatch carries a whole border.
+		const unseen: string[] = []
+		for (const mode of ['light', 'dark']) {
+			const host = mount(build('div'))
+			host.setAttribute('data-bs-theme', mode)
+			const surface = build('div')
+			surface.setAttribute('style', 'background-color: rgb(var(--bs-body-bg-rgb))')
+			host.append(surface)
+			const section: SectionInterface = new BackgroundSection(host)
+			try {
+				const canvas = requireValue(
+					parseColor(readStyle(surface, 'background-color')),
+					'No canvas color',
+				)
+				for (const swatch of host.querySelectorAll('.ratio')) {
+					const fill = blendColor(
+						requireValue(parseColor(readStyle(swatch, 'background-color')), 'No fill'),
+						canvas,
+					)
+					const edge =
+						readStyle(swatch, 'border-top-width') === '0px'
+							? 0
+							: measureContrast(
+									blendColor(
+										requireValue(parseColor(readStyle(swatch, 'border-top-color')), 'No edge'),
+										canvas,
+									),
+									canvas,
+								)
+					if (Math.max(measureContrast(fill, canvas), edge) < 1.2)
+						unseen.push(`${mode} ${swatch.className}`)
+				}
+			} finally {
+				section.destroy()
+				host.remove()
+			}
+		}
+		expect(unseen).toEqual([])
+	})
+
+	it('releases its region and preserves neighboring content through repeated destruction', () => {
+		const host = mount(build('div'))
+		const neighbor = build('p', { text: 'Existing content' })
+		host.append(neighbor)
+		const section: SectionInterface = new BackgroundSection(host)
+		try {
+			const region = requireValue(host.querySelector('section'), 'No Background region')
+			expect(region.isConnected).toBe(true)
+			section.destroy()
+			expect(region.isConnected).toBe(false)
+			section.destroy()
+			expect([...host.children]).toEqual([neighbor])
+		} finally {
+			section.destroy()
+			host.remove()
+		}
+	})
+})
