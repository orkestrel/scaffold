+import type { SectionInterface } from '@app/browser'
+import { BORDER_COPY, BORDER_SPECIMENS, BorderSection, SpecimenSection } from '@app/browser'
+import { requireValue } from '@orkestrel/test'
+import {
+	blendColor,
+	build,
+	measureContrast,
+	mount,
+	parseColor,
+	readStyle,
+} from '@orkestrel/test/browser'
+import { beforeAll, describe, expect, it } from 'vitest'
+import {
+	BORDER_COLOR_CASES,
+	BORDER_SIDE_CASES,
+	BORDER_WIDTH_CASES,
+	PAINT_OPACITY_CASES,
+	RADIUS_SIDE_CASES,
+	RADIUS_STEP_CASES,
+	SUBTLE_TIER_CASES,
+} from '../../../setupStyles.js'
+
+// The paint case reads the swatches as the published cascade and the shell lay them out, so both
+// stylesheets have to be in the document before a box is measured.
+beforeAll(async () => {
+	await import('../../../../src/styles/index.scss')
+	await import('../../../../app/browser/styles/index.scss')
+})
+
+describe('BorderSection', () => {
+	it('renders every declared specimen as captioned swatches through the shared section contract', () => {
+		const host = mount(build('div'))
+		const section: SectionInterface = new BorderSection(host)
+		try {
+			expect(section).toBeInstanceOf(SpecimenSection)
+			expect(section.host).toBe(host)
+			const region = requireValue(host.querySelector('section'), 'No Border region')
+			expect(region.getAttribute('aria-label')).toBe('Border')
+			expect(region.querySelector('p')?.textContent).toBe(BORDER_COPY.paragraph)
+			const rendered = [...region.querySelectorAll('[data-specimen]')]
+			expect(rendered.map((element) => element.getAttribute('data-specimen'))).toEqual([
+				'Additive borders',
+				'Subtractive borders',
+				'Border roles',
+				'Subtle borders',
+				'Border widths',
+				'Border opacity',
+				'Rounded corners',
+				'Rounded sizes',
+			])
+			expect(rendered.map((element) => element.innerHTML)).toEqual(
+				BORDER_SPECIMENS.map((specimen) => specimen.markup),
+			)
+			// Each swatch's caption names the classes its box carries beside the ratio classes, so a
+			// caption that drifts from its swatch reddens here.
+			const swatches = [...region.querySelectorAll('figure.figure > .ratio.ratio-4x3')]
+			expect(swatches).not.toEqual([])
+			expect(
+				swatches.filter(
+					(swatch) =>
+						swatch.nextElementSibling?.textContent !==
+						[...swatch.classList].filter((name) => !name.startsWith('ratio')).join(' '),
+				),
+			).toEqual([])
+			// Every selector names a composition the specimens render, so the list of misses is empty.
+			expect(
+				[
+					'[data-specimen="Additive borders"] .ratio.border',
+					...BORDER_SIDE_CASES.flatMap(({ name }) => [
+						`[data-specimen="Additive borders"] .ratio.border-${name}`,
+						`[data-specimen="Subtractive borders"] .ratio.border.border-${name}-0`,
+					]),
+					'[data-specimen="Subtractive borders"] .ratio.border.border-0',
+					...BORDER_COLOR_CASES.map(
+						({ key }) => `[data-specimen="Border roles"] .ratio.border.border-${key}`,
+					),
+					...SUBTLE_TIER_CASES.map(
+						({ role }) => `[data-specimen="Subtle borders"] .ratio.border.border-${role}-subtle`,
+					),
+					...BORDER_WIDTH_CASES.map(
+						({ step }) => `[data-specimen="Border widths"] .ratio.border.border-${step}`,
+					),
+					...PAINT_OPACITY_CASES.map(
+						({ step }) =>
+							`[data-specimen="Border opacity"] .ratio.border.border-success.border-opacity-${step}`,
+					),
+					'[data-specimen="Rounded corners"] .ratio.rounded',
+					...RADIUS_SIDE_CASES.map(
+						({ name }) => `[data-specimen="Rounded corners"] .ratio.rounded-${name}-4`,
+					),
+					...RADIUS_STEP_CASES.map(
+						({ step }) => `[data-specimen="Rounded sizes"] .ratio.rounded-${step}`,
+					),
+				].filter((selector) => region.querySelector(selector) === null),
+			).toEqual([])
+			expect(region.querySelector('[style]')).toBeNull()
+			expect(Object.isFrozen(BORDER_COPY)).toBe(true)
+			expect(Object.isFrozen(BORDER_SPECIMENS)).toBe(true)
+			expect(BORDER_SPECIMENS.every((specimen) => Object.isFrozen(specimen))).toBe(true)
+		} finally {
+			section.destroy()
+			host.remove()
+		}
+	})
+
+	it('draws every swatch box, each side, width, and opacity step as its class names it, and each rounded side on its own corners', () => {
+		const host = mount(build('div'))
+		const section: SectionInterface = new BorderSection(host)
+		try {
+			const swatches = [...host.querySelectorAll('.ratio')]
+			expect(
+				swatches.filter((swatch) => {
+					const box = swatch.getBoundingClientRect()
+					return box.width === 0 || box.height === 0
+				}),
+			).toEqual([])
+			const sides = BORDER_SIDE_CASES.map(({ side }) => side)
+			// Each additive side swatch draws its own side alone.
+			expect(
+				BORDER_SIDE_CASES.map(({ name }) => {
+					const swatch = requireValue(
+						host.querySelector(`[data-specimen="Additive borders"] .border-${name}`),
+						`No .border-${name} swatch`,
+					)
+					return sides.map((side) => readStyle(swatch, `border-${side}-width`))
+				}),
+			).toEqual(
+				BORDER_SIDE_CASES.map(({ side }) => sides.map((drawn) => (drawn === side ? '1px' : '0px'))),
+			)
+			// Each width and opacity swatch is read against the step its own class names, so the
+			// reading holds whatever order the specimen renders the steps in.
+			const widths = [...host.querySelectorAll('[data-specimen="Border widths"] .ratio')]
+			expect(widths).toHaveLength(BORDER_WIDTH_CASES.length)
+			expect(widths.map((swatch) => readStyle(swatch, 'border-top-width'))).toEqual(
+				widths.map((swatch) => {
+					const step = /\bborder-(\d)\b/u.exec(swatch.className)?.[1]
+					return `${String(BORDER_WIDTH_CASES.find((entry) => entry.step === step)?.pixels)}px`
+				}),
+			)
+			const steps = [...host.querySelectorAll('[data-specimen="Border opacity"] .ratio')]
+			expect(steps).toHaveLength(PAINT_OPACITY_CASES.length)
+			expect(steps.map((swatch) => parseColor(readStyle(swatch, 'border-top-color'))?.[3])).toEqual(
+				steps.map((swatch) => {
+					const step = /\bborder-opacity-(\d+)\b/u.exec(swatch.className)?.[1]
+					return PAINT_OPACITY_CASES.find((entry) => entry.step === step)?.alpha
+				}),
+			)
+			// Each rounded side swatch rounds its own corners and leaves the other two square.
+			const corners = [...new Set(RADIUS_SIDE_CASES.flatMap((entry) => entry.corners))]
+			expect(
+				RADIUS_SIDE_CASES.map(({ name }) => {
+					const swatch = requireValue(
+						host.querySelector(`[data-specimen="Rounded corners"] .rounded-${name}-4`),
+						`No .rounded-${name}-4 swatch`,
+					)
+					return corners.map((corner) => readStyle(swatch, `border-${corner}-radius`) !== '0px')
+				}),
+			).toEqual(
+				RADIUS_SIDE_CASES.map((entry) => corners.map((corner) => entry.corners.includes(corner))),
+			)
+		} finally {
+			section.destroy()
+			host.remove()
+		}
+	})
+
+	it('draws every color swatch border against its own fill in either mode, with a fill where the border matches the canvas', () => {
+		// A color swatch shows its border where the border reads at least 1.2:1 against what it rests
+		// on: the swatch's own fill over the canvas. Below that the border matches the page, and the
+		// swatch carries a fill the border stands against.
+		const colors = [
+			...BORDER_COLOR_CASES.map(({ key }) => `border-${key}`),
+			...SUBTLE_TIER_CASES.map(({ role }) => `border-${role}-subtle`),
+		]
+		const unseen: string[] = []
+		for (const mode of ['light', 'dark']) {
+			const host = mount(build('div'))
+			host.setAttribute('data-bs-theme', mode)
+			const surface = build('div')
+			surface.setAttribute('style', 'background-color: rgb(var(--bs-body-bg-rgb))')
+			host.append(surface)
+			const section: SectionInterface = new BorderSection(host)
+			try {
+				const canvas = requireValue(
+					parseColor(readStyle(surface, 'background-color')),
+					'No canvas color',
+				)
+				const swatches = [
+					...host.querySelectorAll(
+						'[data-specimen="Border roles"] .ratio, [data-specimen="Subtle borders"] .ratio',
+					),
+				]
+				expect(
+					swatches.map((swatch) => colors.filter((name) => swatch.classList.contains(name))),
+				).toEqual(colors.map((name) => [name]))
+
+				for (const swatch of swatches) {
+					const backdrop = blendColor(
+						requireValue(parseColor(readStyle(swatch, 'background-color')), 'No fill'),
+						canvas,
+					)
+					const edge = blendColor(
+						requireValue(parseColor(readStyle(swatch, 'border-top-color')), 'No edge'),
+						backdrop,
+					)
+					if (measureContrast(edge, backdrop) < 1.2) unseen.push(`${mode} ${swatch.className}`)
+				}
+			} finally {
+				section.destroy()
+				host.remove()
+			}
+		}
+		expect(unseen).toEqual([])
+	})
+
+	it('releases its region and preserves neighboring content through repeated destruction', () => {
+		const host = mount(build('div'))
+		const neighbor = build('p', { text: 'Existing content' })
+		host.append(neighbor)
+		const section: SectionInterface = new BorderSection(host)
+		try {
+			const region = requireValue(host.querySelector('section'), 'No Border region')
+			expect(region.isConnected).toBe(true)
+			section.destroy()
+			expect(region.isConnected).toBe(false)
+			section.destroy()
+			expect([...host.children]).toEqual([neighbor])
+		} finally {
+			section.destroy()
+			host.remove()
+		}
+	})
+})
