@@ -0,0 +1,263 @@
+import { TOKEN_NAMES } from '@src/core'
+import { requireValue } from '@orkestrel/test'
+import { matchesColor, parseColor, readRules, readStyle } from '@orkestrel/test/browser'
+import { afterEach, describe, expect, it } from 'vitest'
+import { scene, visitBreakpoint } from '../../../setupBrowser.js'
+import {
+	BACKGROUND_FILL_CASES,
+	BREAKPOINT_INFIXES,
+	GRID_BREAKPOINT_CASES,
+	PAINT_OPACITY_CASES,
+	SUBTLE_TIER_CASES,
+} from '../../../setupStyles.js'
+
+afterEach(() => {
+	scene.clear()
+})
+
+describe('background utilities', () => {
+	it('fills each role from its channel alias, so a retuned alias moves its fill and no other', () => {
+		// Each fill sits beside a reference that reads the same alias through an inline declaration,
+		// so the reading is the alias the class resolves rather than a color written here.
+		const host = scene.mount(
+			BACKGROUND_FILL_CASES.map(
+				({ key, alias }) =>
+					`<div class="bg-${key}"></div><div class="reference" style="background-color: rgb(var(${alias}))"></div>`,
+			).join(''),
+		)
+		const fills = BACKGROUND_FILL_CASES.map(({ key }) =>
+			readStyle(
+				requireValue(host.querySelector(`.bg-${key}`), `No .bg-${key}`),
+				'background-color',
+			),
+		)
+		const references = [...host.querySelectorAll('.reference')].map((element) =>
+			readStyle(element, 'background-color'),
+		)
+		expect(fills.filter((fill, index) => !matchesColor(fill, references[index] ?? ''))).toEqual([])
+		// Each alias takes its own channels on the host, so a class reading another role's alias, or a
+		// literal, keeps a color the retune does not name.
+		const channels = BACKGROUND_FILL_CASES.map((_, index) => [index * 10, 100 + index, 200 - index])
+		host.setAttribute(
+			'style',
+			BACKGROUND_FILL_CASES.map(
+				({ alias }, index) => `${alias}: ${(channels[index] ?? []).join(', ')}`,
+			).join('; '),
+		)
+		expect(
+			BACKGROUND_FILL_CASES.map(({ key }) =>
+				parseColor(
+					readStyle(
+						requireValue(host.querySelector(`.bg-${key}`), `No .bg-${key}`),
+						'background-color',
+					),
+				),
+			),
+		).toEqual(channels.map((triplet) => [...triplet, 1]))
+	})
+
+	it('writes the aliased roles alone, so no class names the role Veneer adds', () => {
+		const selectors = new Set(
+			readRules().flatMap((rule) =>
+				rule instanceof CSSStyleRule
+					? rule.selectorText.split(',').map((selector) => selector.trim())
+					: [],
+			),
+		)
+		expect(
+			['.bg-tertiary', '.bg-tertiary-subtle'].filter((selector) => selectors.has(selector)),
+		).toEqual([])
+		expect(
+			BACKGROUND_FILL_CASES.filter(({ key }) => !selectors.has(`.bg-${key}`)).map(({ key }) => key),
+		).toEqual([])
+		expect(selectors.has('.bg-transparent')).toBe(true)
+	})
+
+	it('sets the fill alpha from each opacity step, and a step alone paints nothing', () => {
+		const host = scene.mount(
+			PAINT_OPACITY_CASES.map(
+				({ step }) =>
+					`<div class="bg-success bg-opacity-${step}"></div><div class="lone bg-opacity-${step}"></div>`,
+			).join(''),
+		)
+		expect(
+			PAINT_OPACITY_CASES.map(
+				({ step }) =>
+					parseColor(
+						readStyle(
+							requireValue(
+								host.querySelector(`.bg-success.bg-opacity-${step}`),
+								`No .bg-opacity-${step} fill`,
+							),
+							'background-color',
+						),
+					)?.[3],
+			),
+		).toEqual(PAINT_OPACITY_CASES.map(({ alpha }) => alpha))
+		expect(
+			[...host.querySelectorAll('.lone')].map((element) => readStyle(element, 'background-color')),
+		).toEqual(PAINT_OPACITY_CASES.map(() => 'rgba(0, 0, 0, 0)'))
+	})
+
+	it('resets the opacity local on every fill, so an inherited step reaches no nested fill', () => {
+		// The release writes the local into each fill's own rule, so a fill nested inside an opacity
+		// class starts from the full alpha rather than inheriting the step.
+		const host = scene.mount(
+			'<div class="bg-opacity-25"><div class="bg-primary"></div></div><div class="bg-transparent bg-opacity-50"></div>',
+		)
+		expect(
+			parseColor(
+				readStyle(
+					requireValue(host.querySelector('.bg-primary'), 'No nested fill'),
+					'background-color',
+				),
+			)?.[3],
+		).toBe(1)
+		expect(
+			readStyle(
+				requireValue(host.querySelector('.bg-transparent'), 'No transparent fill'),
+				'background-color',
+			),
+		).toBe('rgba(0, 0, 0, 0)')
+	})
+
+	it('paints the subtle and body tiers from the aliases each mode re-declares, inside a dark island', () => {
+		const markup = [
+			...SUBTLE_TIER_CASES.map(
+				({ role, background }) =>
+					`<div class="bg-${role}-subtle"></div><div class="reference" style="background-color: var(${background})"></div>`,
+			),
+			...BACKGROUND_FILL_CASES.map(
+				({ key, alias }) =>
+					`<div class="bg-${key}"></div><div class="reference" style="background-color: rgb(var(${alias}))"></div>`,
+			),
+		].join('')
+		const host = scene.mount(
+			`<div data-bs-theme="light">${markup}</div><div data-bs-theme="dark">${markup}</div>`,
+		)
+		const [light, dark] = [...host.children].map((island) => {
+			const subjects = [...island.children].filter(
+				(element) => !element.classList.contains('reference'),
+			)
+			const references = [...island.querySelectorAll('.reference')]
+			return subjects.map((subject, index) => ({
+				name: subject.className,
+				fill: readStyle(subject, 'background-color'),
+				reference: readStyle(requireValue(references[index], 'No reference'), 'background-color'),
+			}))
+		})
+		// Each island's tier matches that island's own alias, so a tier written as one mode's value
+		// reads the other mode's alias wrongly in one of the two islands.
+		expect(
+			[...(light ?? []), ...(dark ?? [])].filter(
+				({ fill, reference }) => !matchesColor(fill, reference),
+			),
+		).toEqual([])
+		// The reading is only worth something where the modes differ: every subtle tier and every
+		// body tier retunes with the mode.
+		const moved = (light ?? []).flatMap(({ name, fill }, index) =>
+			matchesColor(fill, dark?.[index]?.fill ?? '') ? [] : [name],
+		)
+		expect(moved).toEqual(
+			expect.arrayContaining([
+				...SUBTLE_TIER_CASES.map(({ role }) => `bg-${role}-subtle`),
+				'bg-body',
+				'bg-body-secondary',
+				'bg-body-tertiary',
+			]),
+		)
+	})
+
+	it('lays the gradient over a fill from its alias, and leaves the fill beneath it', () => {
+		const host = scene.mount(
+			'<div class="bg-primary bg-gradient"></div><div class="reference bg-primary" style="background-image: var(--bs-gradient)"></div>',
+		)
+		const layered = requireValue(host.querySelector('.bg-gradient'), 'No gradient fill')
+		const reference = requireValue(host.querySelector('.reference'), 'No reference')
+		expect(readStyle(layered, 'background-image')).toBe(readStyle(reference, 'background-image'))
+		expect(readStyle(layered, 'background-image')).toMatch(/^linear-gradient\(/u)
+		expect(readStyle(layered, 'background-color')).toBe(readStyle(reference, 'background-color'))
+		host.setAttribute('style', '--bs-gradient: none')
+		expect(readStyle(layered, 'background-image')).toBe('none')
+	})
+
+	it('reads no density factor, so a doubled factor leaves every fill', () => {
+		const host = scene.mount(
+			BACKGROUND_FILL_CASES.map(({ key }) => `<div class="bg-${key} bg-gradient"></div>`).join(''),
+		)
+		const resting = [...host.children].flatMap((element) => [
+			readStyle(element, 'background-color'),
+			readStyle(element, 'background-image'),
+		])
+		document.documentElement.style.setProperty(TOKEN_NAMES.factor.density, '2')
+		try {
+			expect(
+				[...host.children].flatMap((element) => [
+					readStyle(element, 'background-color'),
+					readStyle(element, 'background-image'),
+				]),
+			).toEqual(resting)
+		} finally {
+			document.documentElement.style.removeProperty(TOKEN_NAMES.factor.density)
+		}
+	})
+
+	it('writes every entry once at the empty infix, so no background class answers to a boundary', async () => {
+		const rules = readRules().flatMap((rule) =>
+			rule instanceof CSSStyleRule &&
+			rule.selectorText.split(',').some((selector) => /^\.bg-/u.test(selector.trim()))
+				? [rule]
+				: [],
+		)
+		// Each class is written once, and outside every media block.
+		const names = rules.flatMap((rule) =>
+			rule.selectorText
+				.split(',')
+				.map((selector) => selector.trim())
+				.filter((selector) => /^\.bg-/u.test(selector)),
+		)
+		expect(names.filter((name, index) => names.indexOf(name) !== index)).toEqual([])
+		expect(rules.filter((rule) => rule.parentRule instanceof CSSMediaRule)).toEqual([])
+		expect(
+			BREAKPOINT_INFIXES.flatMap((infix) =>
+				names.filter((name) => name.startsWith(`.bg-${infix}-`)),
+			),
+		).toEqual([])
+		const host = scene.mount(
+			'<div class="bg-danger bg-opacity-50"></div><div class="bg-warning-subtle"></div>',
+		)
+		const resting = [...host.children].map((element) => readStyle(element, 'background-color'))
+		for (const { readings } of GRID_BREAKPOINT_CASES) {
+			for (const viewport of readings) {
+				expect(
+					await visitBreakpoint(viewport, () =>
+						[...host.children].map((element) => readStyle(element, 'background-color')),
+					),
+				).toEqual(resting)
+			}
+		}
+	})
+
+	it('keeps each fill over a later unlayered consumer rule, whose opacity local still reaches it', () => {
+		const host = scene.mount('<div class="probe bg-primary bg-gradient"></div>')
+		const element = requireValue(host.querySelector('.probe'), 'No probe')
+		const fill = readStyle(element, 'background-color')
+		scene.load('.probe { background-color: rgb(1, 2, 3); background-image: none }')
+		expect(readStyle(element, 'background-color')).toBe(fill)
+		expect(readStyle(element, 'background-image')).not.toBe('none')
+		// The opacity local is written normal, as the release writes a local, so an unlayered rule of
+		// the consumer's own sets it where the important property does not move.
+		scene.load('.probe { --bs-bg-opacity: 0.5 }')
+		expect(parseColor(readStyle(element, 'background-color'))?.[3]).toBe(0.5)
+	})
+
+	it('yields to an important override inside the utilities layer and to no unlayered one', () => {
+		const host = scene.mount('<div class="bg-primary"></div>')
+		const element = requireValue(host.querySelector('.bg-primary'), 'No fill')
+		const fill = readStyle(element, 'background-color')
+		scene.load('.bg-primary { background-color: rgb(1, 2, 3) !important }')
+		expect(readStyle(element, 'background-color')).toBe(fill)
+		scene.load('@layer utilities { .bg-primary { background-color: rgb(1, 2, 3) !important } }')
+		expect(readStyle(element, 'background-color')).toBe('rgb(1, 2, 3)')
+	})
+})
