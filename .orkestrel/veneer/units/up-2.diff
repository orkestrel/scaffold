+import { TOKEN_NAMES } from '@src/core'
+import { requireValue } from '@orkestrel/test'
+import { matchesColor, parseColor, readRules, readStyle } from '@orkestrel/test/browser'
+import { afterEach, describe, expect, it } from 'vitest'
+import { scene, visitBreakpoint } from '../../../setupBrowser.js'
+import {
+	BORDER_COLOR_CASES,
+	BORDER_SIDE_CASES,
+	BORDER_WIDTH_CASES,
+	BREAKPOINT_INFIXES,
+	GRID_BREAKPOINT_CASES,
+	PAINT_OPACITY_CASES,
+	RADIUS_SIDE_CASES,
+	RADIUS_STEP_CASES,
+	SUBTLE_TIER_CASES,
+} from '../../../setupStyles.js'
+
+afterEach(() => {
+	scene.clear()
+})
+
+describe('border utilities', () => {
+	it('draws the default border from the border aliases, so a retuned width token moves it', () => {
+		const sides = BORDER_SIDE_CASES.map(({ side }) => side)
+		const host = scene.mount(
+			'<div class="border"></div><div class="reference" style="border: 1px solid var(--bs-border-color)"></div>',
+		)
+		const edge = requireValue(host.querySelector('.border'), 'No border')
+		const reference = requireValue(host.querySelector('.reference'), 'No reference')
+		expect(
+			sides.map((side) => [
+				readStyle(edge, `border-${side}-width`),
+				readStyle(edge, `border-${side}-style`),
+				matchesColor(
+					readStyle(edge, `border-${side}-color`),
+					readStyle(reference, `border-${side}-color`),
+				),
+			]),
+		).toEqual(sides.map(() => ['1px', 'solid', true]))
+		document.documentElement.style.setProperty(TOKEN_NAMES.border.width, '3px')
+		try {
+			expect(sides.map((side) => readStyle(edge, `border-${side}-width`))).toEqual(
+				sides.map(() => '3px'),
+			)
+		} finally {
+			document.documentElement.style.removeProperty(TOKEN_NAMES.border.width)
+		}
+	})
