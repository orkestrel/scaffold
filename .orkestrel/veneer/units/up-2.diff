+import { BACKGROUND_COPY, BACKGROUND_SPECIMENS } from '../constants.js'
+import { SpecimenSection } from './SpecimenSection.js'
+
+/**
+ * Renders the declared role fill, subtle tier, body surface, opacity, and gradient specimens into a
+ * named Background region.
+ *
+ * @example
+ * ```ts
+ * const section = new BackgroundSection(document.body)
+ * section.destroy()
+ * ```
+ */
+export class BackgroundSection extends SpecimenSection {
+	/**
+	 * Mounts the Background region and its specimens in table order.
+	 * @param host - The element receiving the section.
+	 */
+	constructor(host: HTMLElement) {
+		super(host, BACKGROUND_COPY, BACKGROUND_SPECIMENS)
+	}
+}
