+		{ label: 'ordinary', arguments: ordinary, timeout: 240_000, files: {} },
+		{
+			label: 'malformed',
+			arguments: release,
+			timeout: 240_000,
+			files: { 'vite.config.ts': `${configuration}\nexport const =\n` },
+		},
