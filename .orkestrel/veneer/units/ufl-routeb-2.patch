@@ -22,6 +22,16 @@
 	color: var(--bs-heading-color);
 }
 
+// Emits the run that places a box over the whole of its containing block on the physical edges,
+// which the card's image overlay and the stretched link's generated box write.
+@mixin cover-block {
+	position: absolute;
+	top: 0;
+	right: 0;
+	bottom: 0;
+	left: 0;
+}
+
 @mixin image-size {
 	max-width: 100%;
 	height: auto;
