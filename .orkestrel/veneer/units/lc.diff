@@ -0,0 +1,44 @@
+// Runs the contrast rule the mixins declare over the release's own inputs: each fill of its
+// `$theme-colors` map, as an sRGB channel triplet, against its own light and dark contrast labels,
+// in the order its `color-contrast` function tries them. The release's partials declare variables
+// and functions and emit no CSS, so the fixture adds no second copy of any cascade to the page. They
+// predate the module system and read their functions as globals, so the fixture imports them.
+@use 'sass:color';
+@use 'sass:list';
+@use 'sass:map';
+@use '../../../../src/styles/mixins';
+@import 'bootstrap/scss/functions';
+@import 'bootstrap/scss/variables';
+
+// Returns a release color's sRGB channel triplet, the form the contrast rule reads.
+@function channels-of($color) {
+	$triplet: ();
+	@each $channel in ('red', 'green', 'blue') {
+		$triplet: list.append($triplet, color.channel($color, $channel, $space: rgb), comma);
+	}
+	@return $triplet;
+}
+
+$labels: (
+	$color-contrast-light: channels-of($color-contrast-light),
+	$color-contrast-dark: channels-of($color-contrast-dark),
+);
+
+// Writes the label the rule picks for each role onto a class named for the role, and the light
+// label's ratio against the role's fill beside it, so the proof reads the pick and can name the
+// fill that sits at the 4.5 to 1 boundary.
+@each $role, $fill in $theme-colors {
+	.vn-fixture-contrast-#{$role} {
+		--vn-fixture-ratio: #{mixins.ratio(channels-of($fill), channels-of($color-contrast-light))};
+		color: mixins.contrast(channels-of($fill), $labels);
+	}
+}
+
+// Writes the value the `scheme` function returns for a pair that agrees and a pair that differs.
+.vn-fixture-scheme-same {
+	color: mixins.scheme(var(--vn-palette-white-base), var(--vn-palette-white-base));
+}
+
+.vn-fixture-scheme-split {
+	color: mixins.scheme(var(--vn-palette-white-base), var(--vn-palette-black-base));
+}
