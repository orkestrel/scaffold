+			for (const rule of rules) {
+				const query = `#stage :is(${rule.selector})`
+				const standalone = await stage.read(query, rule.properties)
+				if (standalone.length === 0) continue
+				const paired = await recipe.read(query, rule.properties)
+				const dropped = await control.read(query, rule.properties)
+				expect(`${rule.selector} | ${String(paired.length)} | ${String(dropped.length)}`).toBe(
+					`${rule.selector} | ${String(standalone.length)} | ${String(standalone.length)}`,
+				)
+				const names = collectSelectorClasses(rule.selector)
+				for (const name of names)
+					for (const property of rule.properties) reached.push(`${name} | ${property}`)
+				standalone.forEach((snapshot, index) => {
+					for (const [property, value] of snapshot) {
+						const after = paired[index]?.get(property)
+						if (after !== value)
+							moved.push(`${rule.selector} | ${property}: ${value} became ${String(after)}`)
+						if (dropped[index]?.get(property) !== value) displaced.push(...names)
+					}
+				})
+			}
+			// Each floor class was read on a longhand the reset also writes, so the equality covers
+			// what the recipe could have moved rather than an empty population.
+			expect(
+				COMPONENT_FLOOR.filter(
+					(name) => !written.some((property) => reached.includes(`${name} | ${property}`)),
+				),
+			).toEqual([])
+			expect(moved).toEqual([])
+			// The same reading sees every floor class move on the control page, so an equality that
+			// holds is one this reading could have refused.
+			expect(COMPONENT_FLOOR.filter((name) => !displaced.includes(name))).toEqual([])
+		} finally {
+			await control.destroy()
+			controlScratch.destroy()
+		}
+	})
+
+	it("leaves every shared name resolving, on the recipe alone, what the cascade resolves over Tailwind's reset", async () => {
+		for (const name of CANDIDATE_FLOOR) expect(shared).toContain(name)
+		// The reset moves properties Veneer leaves alone, which the preflight pairing records, so
+		// the reading this equality is held against is the cascade with the recipe's reset and
+		// the tokens it reads loaded beneath it. What remains between the two pages is Tailwind's
+		// generated utilities, which is what the exclusion line and Veneer's importance govern.
+		await stage.mount(consumerMarkup)
+		await stage.load(reset)
+		const standalone: Array<readonly [string, ReadonlyMap<string, string>]> = []
+		for (const name of shared) {
+			for (const snapshot of await stage.read(`[class~="${name}"]`)) {
+				standalone.push([name, snapshot])
+			}
+		}
+		expect(standalone).not.toEqual([])
+		await recipe.mount(consumerMarkup)
+		const paired: Array<ReadonlyMap<string, string>> = []
+		for (const name of shared) paired.push(...(await recipe.read(`[class~="${name}"]`)))
+		expect(paired).toHaveLength(standalone.length)
+		expect(
+			standalone.flatMap(([name, snapshot], index) => {
+				const after = requireValue(paired[index], 'The paired snapshot was never taken')
+				return Array.from(snapshot).flatMap(([property, value]) =>
+					after.get(property) === value
+						? []
+						: [`${name} ${property}: ${value} became ${String(after.get(property))}`],
+				)
+			}),
+		).toEqual([])
+	})
+})
