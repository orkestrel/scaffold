@@ -0,0 +1,20 @@
+import { TOAST_COPY, TOAST_SPECIMENS } from '../constants.js'
+import { SpecimenSection } from './SpecimenSection.js'
+
+/**
+ * Renders the declared toast specimens into a named region.
+ * @example
+ * ```ts
+ * const section = new ToastSection(document.body)
+ * section.destroy()
+ * ```
+ */
+export class ToastSection extends SpecimenSection {
+	/**
+	 * Mounts the Toast region and its specimens.
+	 * @param host - The element receiving the section.
+	 */
+	constructor(host: HTMLElement) {
+		super(host, TOAST_COPY, TOAST_SPECIMENS)
+	}
+}
diff --git a/tests/app/browser/sections/ToastSection.test.ts b/tests/app/browser/sections/ToastSection.test.ts
new file mode 100644
index 0000000..79d6d46
--- /dev/null
+++ b/tests/app/browser/sections/ToastSection.test.ts
@@ -0,0 +1,210 @@
+import type { SectionInterface } from '@app/browser'
+import { SpecimenSection, TOAST_COPY, TOAST_SPECIMENS, ToastSection } from '@app/browser'
+import { requireValue } from '@orkestrel/test'
+import { build, findRule, mount, readName, readStyle } from '@orkestrel/test/browser'
+import { beforeAll, describe, expect, it } from 'vitest'
+import { readSpecimen, visitBreakpoint } from '../../../setupBrowser.js'
+import { VIEWPORT_WIDTHS } from '../../../setupStyles.js'
+
+// The frame cases read the specimens as the published cascade and the shell lay them out, so both
+// stylesheets have to be in the document before a box is measured.
+beforeAll(async () => {
+	await import('../../../../src/styles/index.scss')
+	await import('../../../../app/browser/styles/index.scss')
+})
+
+describe('ToastSection', () => {
+	it('renders a shown toast, a stacked pair, and a centered toast through the shared section contract', () => {
+		const host = mount(build('div'))
+		const section: SectionInterface = new ToastSection(host)
+		try {
+			expect(section).toBeInstanceOf(SpecimenSection)
+			expect(section.host).toBe(host)
+			const region = requireValue(host.querySelector('section'), 'No Toast region')
+			expect(region.querySelector('[style]')).toBeNull()
+			expect(region.getAttribute('aria-label')).toBe('Toast')
+			expect(region.querySelector('p')?.textContent).toBe(TOAST_COPY.paragraph)
+			const rendered = [...region.querySelectorAll('[data-specimen]')]
+			expect(rendered.map((element) => element.getAttribute('data-specimen'))).toEqual([
+				'Shown toast',
+				'Stacked toasts',
+				'Centered toast',
+			])
+			expect(rendered.map((element) => element.innerHTML)).toEqual(
+				TOAST_SPECIMENS.map(({ markup }) => markup),
+			)
+			// The release hides a toast without the `show` class, so every toast carries it, and each
+			// one displays.
+			const toasts = [...region.querySelectorAll('.toast')]
+			expect(toasts.length).toBeGreaterThan(0)
+			expect(toasts.filter((toast) => !toast.classList.contains('show'))).toStrictEqual([])
+			expect(toasts.filter((toast) => readStyle(toast, 'display') === 'none')).toStrictEqual([])
+			// The engine writes the `showing` class and the `fade` class, and a showing toast paints
+			// nothing, so no specimen carries either.
+			expect(region.querySelector('.showing, .fade')).toBeNull()
+			// Every toast announces itself through the pair the release's markup gives it: an alert
+			// role read out at once, and read whole.
+			expect(
+				toasts.map((toast) => [
+					toast.getAttribute('role'),
+					toast.getAttribute('aria-live'),
+					toast.getAttribute('aria-atomic'),
+				]),
+			).toEqual(toasts.map(() => ['alert', 'assertive', 'true']))
+			// Every toast carries a header and a body, and the header's close control paints a mark
+			// rather than a label, so it is named through its own `aria-label` attribute.
+			for (const toast of toasts) {
+				const header = requireValue(toast.querySelector(':scope > .toast-header'), 'No header')
+				expect(toast.querySelector(':scope > .toast-header + .toast-body')).not.toBeNull()
+				const control = requireValue(header.querySelector('.btn-close'), 'No close control')
+				expect(control.tagName).toBe('BUTTON')
+				expect(control.getAttribute('aria-label')).toBe('Close')
+				expect(readName(control)).toBe('Close')
+				expect(control.textContent).toBe('')
+			}
+			expect(Object.isFrozen(TOAST_COPY)).toBe(true)
+			expect(Object.isFrozen(TOAST_SPECIMENS)).toBe(true)
+			expect(TOAST_SPECIMENS.every((entry) => Object.isFrozen(entry))).toBe(true)
+		} finally {
+			section.destroy()
+			host.remove()
+		}
+	})
+
+	// The mutation this catches is a container specimen rendered outside the shell's frame: the
+	// container is absolutely positioned, so outside a frame it is placed against whatever positioned
+	// ancestor the page happens to carry. The framed specimens are read off the specimen table as the
+	// ones whose markup opens the shell's frame, so no specimen name is listed here.
+	it('renders each container inside the shell frame, placed with the shipped position utilities', () => {
+		const host = mount(build('div'))
+		const section: SectionInterface = new ToastSection(host)
+		try {
+			const region = requireValue(host.querySelector('section'), 'No Toast region')
+			const framed = TOAST_SPECIMENS.filter(({ markup }) => markup.includes('class="viewport"'))
+			expect(framed).not.toStrictEqual([])
+			// Every container sits directly inside the frame of a framed specimen, and every framed
+			// specimen holds one.
+			const containers = [...region.querySelectorAll('.toast-container')]
+			expect(
+				containers.map((container) =>
+					container.closest('[data-specimen]')?.getAttribute('data-specimen'),
+				),
+			).toEqual(framed.map(({ name }) => name))
+			for (const container of containers) {
+				expect(container.parentElement?.classList.contains('viewport')).toBe(true)
+				expect(container.parentElement?.parentElement?.hasAttribute('data-specimen')).toBe(true)
+				expect(readStyle(container, 'position')).toBe('absolute')
+				// Every other class the container carries is a position utility the cascade ships.
+				const placement = [...container.classList].filter((name) => name !== 'toast-container')
+				expect(placement).not.toStrictEqual([])
+				expect(
+					placement.filter(
+						(name) =>
+							!/^(?:(?:top|bottom|start|end)-(?:0|50|100)|translate-middle(?:-[xy])?)$/u.test(
+								name,
+							) || findRule(`.${name}`) === undefined,
+					),
+				).toStrictEqual([])
+			}
+			// A specimen outside the frame holds its toast in flow, because a toast alone is not
+			// positioned.
+			const loose = TOAST_SPECIMENS.filter((specimen) => !framed.includes(specimen))
+			expect(loose).not.toStrictEqual([])
+			for (const { name } of loose) {
+				const specimen = readSpecimen(region, name)
+				expect(specimen.querySelector('.viewport')).toBeNull()
+				expect(
+					[...specimen.querySelectorAll('.toast')].map((toast) => readStyle(toast, 'position')),
+				).toEqual(['static'])
+			}
+		} finally {
+			section.destroy()
+			host.remove()
+		}
+	})
+
+	// The population is read off the specimen table as the specimens whose markup opens the shell's
+	// frame, and is held against the rendered region, so a framed specimen the reading drops reddens
+	// here. Each placement class a container carries names where its box meets the frame.
+	it.each(VIEWPORT_WIDTHS)(
+		'holds every framed toast inside its frame, where the placement classes of its container put it, at the %i variant',
+		async (width) => {
+			const host = mount(build('div'))
+			const section: SectionInterface = new ToastSection(host)
+			try {
+				const region = requireValue(host.querySelector('section'), 'No Toast region')
+				const framed = TOAST_SPECIMENS.filter(({ markup }) =>
+					markup.includes('class="viewport"'),
+				).map(({ name }) => name)
+				expect(framed).toEqual(
+					[...region.querySelectorAll('[data-specimen]')]
+						.filter((specimen) => specimen.querySelector(':scope > .viewport') !== null)
+						.map((specimen) => specimen.getAttribute('data-specimen')),
+				)
+				const reading = await visitBreakpoint(width, () =>
+					framed.map((name) => {
+						const specimen = readSpecimen(region, name)
+						const frame = requireValue(
+							specimen.querySelector('.viewport'),
+							`No frame in ${name}`,
+						).getBoundingClientRect()
+						const container = requireValue(
+							specimen.querySelector('.toast-container'),
+							`No container in ${name}`,
+						)
+						const box = container.getBoundingClientRect()
+						const edges: ReadonlyArray<readonly [string, number]> = [
+							['top-0', box.top - frame.top],
+							['bottom-0', frame.bottom - box.bottom],
+							['start-0', box.left - frame.left],
+							['end-0', frame.right - box.right],
+							['translate-middle', box.left + box.width / 2 - (frame.left + frame.width / 2)],
+							['translate-middle', box.top + box.height / 2 - (frame.top + frame.height / 2)],
+						]
+						return {
+							// Every toast lies inside its frame on each edge, so the frame carries it whole.
+							inside: [...specimen.querySelectorAll('.toast')].every((toast) => {
+								const inner = toast.getBoundingClientRect()
+								return (
+									inner.left >= frame.left &&
+									inner.top >= frame.top &&
+									inner.right <= frame.right &&
+									inner.bottom <= frame.bottom
+								)
+							}),
+							distances: edges
+								.filter(([placement]) => container.classList.contains(placement))
+								.map(([, distance]) => Math.abs(distance)),
+						}
+					}),
+				)
+				expect(reading.map(({ inside }) => inside)).toEqual(framed.map(() => true))
+				for (const { distances } of reading) {
+					expect(distances).not.toStrictEqual([])
+					expect(distances.filter((distance) => distance >= 1)).toStrictEqual([])
+				}
+			} finally {
+				section.destroy()
+				host.remove()
+			}
+		},
+	)
+
+	it('releases the region and preserves adjacent content on repeated destruction', () => {
+		const host = mount(build('div'))
+		const neighbor = build('p', { text: 'Existing content' })
+		host.append(neighbor)
+		const section: SectionInterface = new ToastSection(host)
+		try {
+			const region = requireValue(host.querySelector('section'), 'No Toast region')
+			expect(region.isConnected).toBe(true)
+			section.destroy()
+			expect(region.isConnected).toBe(false)
+			section.destroy()
+			expect([...host.children]).toEqual([neighbor])
+		} finally {
+			section.destroy()
+			host.remove()
+		}
+	})
+})
