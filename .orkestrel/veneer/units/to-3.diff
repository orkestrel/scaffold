diff --git a/src/styles/components/_toast.scss b/src/styles/components/_toast.scss
new file mode 100644
index 0000000..9b022c7
--- /dev/null
+++ b/src/styles/components/_toast.scss
@@ -0,0 +1,91 @@
+@layer components {
+	// The toast ships Bootstrap's recorded surface. A toast displays only while it carries the `show`
+	// class, and the engine writes the `showing` class for each fade, in and out alike; each state is
+	// a class, so no rule here reads an inline style. The toast and the container each declare the
+	// stacking slot from the toast rung, and the container applies the level, so a retune of that
+	// rung moves every container and the toasts inside it. The insets read the density scale tokens
+	// that already resolve to the recorded lengths, the stacking gap reads the gutter token the
+	// release derives it from, and the text size reads the size token that holds the recorded
+	// `0.875rem` value. The fill, the edges, and the header text read the body aliases the release
+	// reads, so a theme scope retunes a toast through them. The text slot is the release's own empty
+	// value, so a toast paints the text of whatever carries it until a consumer sets the slot.
+	.toast {
+		--bs-toast-zindex: var(--vn-stack-toast);
+		--bs-toast-padding-x: var(--vn-space-6);
+		--bs-toast-padding-y: var(--vn-space-4);
+		--bs-toast-spacing: var(--vn-gutter-x);
+		--bs-toast-max-width: 350px;
+		--bs-toast-font-size: var(--vn-size-2);
+		--bs-toast-color: #{''};
+		--bs-toast-bg: rgba(var(--bs-body-bg-rgb), 0.85);
+		--bs-toast-border-width: var(--bs-border-width);
+		--bs-toast-border-color: var(--bs-border-color-translucent);
+		--bs-toast-border-radius: var(--bs-border-radius);
+		--bs-toast-box-shadow: var(--bs-box-shadow);
+		--bs-toast-header-color: var(--bs-secondary-color);
+		--bs-toast-header-bg: rgba(var(--bs-body-bg-rgb), 0.85);
+		--bs-toast-header-border-color: var(--bs-border-color-translucent);
+		width: var(--bs-toast-max-width);
+		max-width: 100%;
+		font-size: var(--bs-toast-font-size);
+		color: var(--bs-toast-color);
+		pointer-events: auto;
+		background-color: var(--bs-toast-bg);
+		background-clip: padding-box;
+		border: var(--bs-toast-border-width) solid var(--bs-toast-border-color);
+		box-shadow: var(--bs-toast-box-shadow);
+		border-radius: var(--bs-toast-border-radius);
+	}
+
+	.toast.showing {
+		opacity: 0;
+	}
+
+	.toast:not(.show) {
+		display: none;
+	}
+
+	// The container redeclares the stacking slot on itself, because it is the positioned box the
+	// level applies to and it is not a toast. The release lets the pointer pass through the
+	// container's own box and restores it on each toast.
+	.toast-container {
+		--bs-toast-zindex: var(--vn-stack-toast);
+		position: absolute;
+		z-index: var(--bs-toast-zindex);
+		width: max-content;
+		max-width: 100%;
+		pointer-events: none;
+	}
+
+	.toast-container > :not(:last-child) {
+		margin-bottom: var(--bs-toast-spacing);
+	}
+
+	// The header's top corners sit inside the toast's border, so each one takes the toast's radius
+	// less that border's width.
+	.toast-header {
+		display: flex;
+		align-items: center;
+		padding: var(--bs-toast-padding-y) var(--bs-toast-padding-x);
+		color: var(--bs-toast-header-color);
+		background-color: var(--bs-toast-header-bg);
+		background-clip: padding-box;
+		border-bottom: var(--bs-toast-border-width) solid var(--bs-toast-header-border-color);
+		border-top-left-radius: calc(var(--bs-toast-border-radius) - var(--bs-toast-border-width));
+		border-top-right-radius: calc(var(--bs-toast-border-radius) - var(--bs-toast-border-width));
+	}
+
+	// The combinator fits the close control into the header: it pulls the control half an inset into
+	// the header's end padding and parts it from the content before it by a whole one. It selects
+	// the control through the header class, so a close control elsewhere in a toast keeps its own
+	// margins. The margins are physical, as the release writes them.
+	.toast-header .btn-close {
+		margin-right: calc(-0.5 * var(--bs-toast-padding-x));
+		margin-left: var(--bs-toast-padding-x);
+	}
+
+	.toast-body {
+		padding: var(--bs-toast-padding-x);
+		word-wrap: break-word;
+	}
+}
diff --git a/tests/src/styles/components/toast.test.ts b/tests/src/styles/components/toast.test.ts
new file mode 100644
index 0000000..02c0245
--- /dev/null
+++ b/tests/src/styles/components/toast.test.ts
@@ -0,0 +1,351 @@
+import { TOKEN_NAMES } from '@src/core'
+import { requireValue } from '@orkestrel/test'
+import {
+	matchesColor,
+	readPixels,
+	readRootToken,
+	readStyle,
+	readToken,
+} from '@orkestrel/test/browser'
+import { afterEach, describe, expect, it } from 'vitest'
+import { collectLayer, scene } from '../../../setupBrowser.js'
+import {
+	TEXT_MODES,
+	TOAST_CLOSE_GEOMETRY,
+	TOAST_SELECTORS,
+	TOAST_SLOT_CASES,
+	normalizeComplexSelector,
+	splitTopLevelList,
+	trimCSSWhitespace,
+} from '../../../setupStyles.js'
+
+afterEach(() => {
+	scene.clear()
+	for (const token of [
+		TOKEN_NAMES.factor.density,
+		TOKEN_NAMES.factor.radius,
+		TOKEN_NAMES.stack.toast,
+	])
+		document.documentElement.style.removeProperty(token)
+})
+
+describe('toast box', () => {
+	// The mutations this catches are a rule the partial stops writing and a rule it writes beyond the
+	// release: the reading is every components-layer selector naming one of the key's own classes,
+	// so a missing rule and an extra rule on the same classes each report here, and a header
+	// combinator written against the bare toast class reads as both.
+	it('writes the recorded toast selectors and no other rule on their classes', () => {
+		const written = new Set(
+			collectLayer('components').flatMap((rule) =>
+				rule instanceof CSSStyleRule
+					? splitTopLevelList(rule.selectorText)
+							.map((part) => normalizeComplexSelector(trimCSSWhitespace(part)))
+							.filter((selector) => /\.toast(?:-[\w-]+)?(?![\w-])/u.test(selector))
+					: [],
+			),
+		)
+		expect([...written].sort()).toEqual(
+			TOAST_SELECTORS.map((selector) => normalizeComplexSelector(selector)).sort(),
+		)
+	})
+
+	it('sizes, edges, and rounds the toast from its own slots and paints the text of its host', () => {
+		const host = scene.mount(
+			'<div style="color: rgb(10, 20, 30)"><div class="toast show">Oak shipment</div><span data-probe style="box-shadow: var(--bs-box-shadow)"></span></div>',
+		)
+		const toast = requireValue(host.querySelector('.toast'), 'No toast')
+		const probe = requireValue(host.querySelector('[data-probe]'), 'No shadow probe')
+		expect(readPixels(toast, 'width')).toBe(350)
+		expect(readStyle(toast, 'max-width')).toBe('100%')
+		expect(readPixels(toast, 'font-size')).toBe(14)
+		expect(readStyle(toast, 'pointer-events')).toBe('auto')
+		expect(readStyle(toast, 'background-clip')).toBe('padding-box')
+		for (const side of ['top', 'right', 'bottom', 'left']) {
+			expect(readPixels(toast, `border-${side}-width`)).toBe(1)
+			expect(readStyle(toast, `border-${side}-style`)).toBe('solid')
+		}
+		for (const corner of ['top-left', 'top-right', 'bottom-right', 'bottom-left'])
+			expect(readPixels(toast, `border-${corner}-radius`)).toBeCloseTo(6, 3)
+		expect(readStyle(toast, 'box-shadow')).toBe(readStyle(probe, 'box-shadow'))
+		expect(readStyle(toast, 'box-shadow')).not.toBe('none')
+		// The text slot is the release's own empty value, so the color declaration reading it
+		// resolves nothing and the toast inherits the text its host carries.
+		expect(readToken(toast, '--bs-toast-color')).toBe('')
+		expect(readStyle(toast, 'color')).toBe('rgb(10, 20, 30)')
+		// The width is a cap the toast gives up inside a narrower host.
+		const narrow = scene.mount('<div style="width: 200px"><div class="toast show">Ash</div></div>')
+		expect(readPixels(requireValue(narrow.querySelector('.toast'), 'No toast'), 'width')).toBe(200)
+	})
+
+	// The mutation this catches is a row naming a token the slot does not read. Tokens can declare
+	// the same length, as the `--vn-gutter-x`, `--vn-size-6`, and `--vn-gap-4` tokens each declare
+	// the `1.5rem` length, so a length reading cannot tell them apart. A wrapper that retunes the
+	// row's token alone can: the slot follows the retune only when it reads that token.
+	it.each(TOAST_SLOT_CASES)(
+		'reads $property from its own token and follows a retune of that token alone',
+		({ property, token, pixels }) => {
+			const host = scene.mount(
+				`<div class="toast show">Oak shipment<span data-probe style="display:block;width:var(${property})"></span></div><div data-retune style="${token}: 37px"><div class="toast show">Ash shipment<span data-probe style="display:block;width:var(${property})"></span></div></div>`,
+			)
+			const [rest, retuned] = [...host.querySelectorAll('.toast')]
+			const toast = requireValue(rest, 'No toast')
+			const moved = requireValue(retuned, 'No retuned toast')
+			expect(readToken(toast, property)).toBe(readToken(toast, token))
+			// The slot is read as a length as well, because two properties resolving to one another stay
+			// equal through a retune that moves them together and away from the release.
+			expect(
+				readPixels(requireValue(toast.querySelector('[data-probe]'), 'No probe'), 'width'),
+			).toBe(pixels)
+			expect(pixels).not.toBe(37)
+			expect(
+				readPixels(requireValue(moved.querySelector('[data-probe]'), 'No retuned probe'), 'width'),
+			).toBe(37)
+		},
+	)
+
+	it('rescales the insets with the density factor and holds the stacking gap on the gutter', () => {
+		const host = scene.mount(
+			'<div class="toast-container"><div class="toast show"><div class="toast-header">Oak</div><div class="toast-body">Oak shipment</div></div><div class="toast show"><div class="toast-body">Ash shipment</div></div></div>',
+		)
+		const [first] = [...host.querySelectorAll('.toast')]
+		const toast = requireValue(first, 'No toast')
+		const header = requireValue(toast.querySelector('.toast-header'), 'No toast header')
+		const body = requireValue(toast.querySelector('.toast-body'), 'No toast body')
+		const radius = readPixels(toast, 'border-top-left-radius')
+		// The factors are published at the document root, where every token the toast reads resolves
+		// its own value, so the retune is applied there rather than on the toast.
+		document.documentElement.style.setProperty(TOKEN_NAMES.factor.density, '2')
+		expect(readPixels(header, 'padding-left')).toBe(24)
+		expect(readPixels(header, 'padding-top')).toBe(16)
+		expect(readPixels(body, 'padding-top')).toBe(24)
+		// The gap reads the container gutter, which no density factor scales; a gap written over the
+		// density scale's `1.5rem` step would double here.
+		expect(readPixels(toast, 'margin-bottom')).toBe(24)
+		expect(readPixels(toast, 'border-top-left-radius')).toBe(radius)
+		document.documentElement.style.setProperty(TOKEN_NAMES.factor.radius, '2')
+		expect(readPixels(toast, 'border-top-left-radius')).toBe(radius * 2)
+	})
+
+	it('moves the insets through a consumer scope retuning its slots and shadows an ancestor retune', () => {
+		const host = scene.mount(
+			'<div class="retuned" style="--bs-toast-padding-x: 40px; --bs-toast-padding-y: 40px"><div class="toast show"><div class="toast-header">Oak</div><div class="toast-body">Oak shipment</div></div></div>',
+		)
+		const header = requireValue(host.querySelector('.toast-header'), 'No toast header')
+		const body = requireValue(host.querySelector('.toast-body'), 'No toast body')
+		// The toast declares its slots on itself, so the same retune carried by an ancestor reaches
+		// nothing and the header and the body keep the release's insets.
+		expect(readPixels(header, 'padding-left')).toBe(12)
+		expect(readPixels(header, 'padding-top')).toBe(8)
+		expect(readPixels(body, 'padding-left')).toBe(12)
+		// A consumer rule that still selects the toast is where the compatibility contract puts a
+		// retune. An inset written as the recorded literal resolves the same at rest and follows no
+		// retune, so this reading is what separates the slot from the value.
+		scene.load('.retuned .toast { --bs-toast-padding-x: 30px; --bs-toast-padding-y: 10px; }')
+		expect(readPixels(header, 'padding-left')).toBe(30)
+		expect(readPixels(header, 'padding-right')).toBe(30)
+		expect(readPixels(header, 'padding-top')).toBe(10)
+		expect(readPixels(body, 'padding-top')).toBe(30)
+	})
+})
+
+describe('toast states', () => {
+	// The mutation this catches is the hiding rule dropped: a toast without the `show` class would
+	// then display, and every showcase specimen carries the class because of this rule.
+	it('hides a toast without the show class and displays one carrying it', () => {
+		const host = scene.mount(
+			'<div class="toast">Oak shipment</div><div class="toast show">Ash shipment</div>',
+		)
+		const [hidden, shown] = [...host.querySelectorAll('.toast')]
+		const rest = requireValue(hidden, 'No hidden toast')
+		const open = requireValue(shown, 'No shown toast')
+		expect(readStyle(rest, 'display')).toBe('none')
+		expect(rest.getBoundingClientRect().height).toBe(0)
+		expect(readStyle(open, 'display')).toBe('block')
+		expect(open.getBoundingClientRect().height).toBeGreaterThan(0)
+	})
+
+	// The engine writes the `showing` class for the length of a fade, in and out alike, and no
+	// specimen renders it: a showing toast paints nothing at all, so its frame would carry an empty
+	// box and no subject. This reading is its proof instead. The mutation it catches is the rule
+	// dropped, which leaves the showing toast at full opacity.
+	it('drops a showing toast to no opacity while it stays displayed', () => {
+		const host = scene.mount(
+			'<div class="toast show showing">Oak shipment</div><div class="toast show">Ash shipment</div><div class="toast showing">Elm shipment</div>',
+		)
+		const [showing, shown, closed] = [...host.querySelectorAll('.toast')]
+		const fading = requireValue(showing, 'No showing toast')
+		expect(readStyle(fading, 'opacity')).toBe('0')
+		expect(readStyle(fading, 'display')).toBe('block')
+		expect(fading.getBoundingClientRect().height).toBeGreaterThan(0)
+		expect(readStyle(requireValue(shown, 'No shown toast'), 'opacity')).toBe('1')
+		// The class alone shows nothing: a toast without the `show` class stays hidden whatever the
+		// engine writes beside it.
+		expect(readStyle(requireValue(closed, 'No closed toast'), 'display')).toBe('none')
+	})
+})
+
+describe('toast container', () => {
+	// The mutations this catches are the container's slot written as the recorded literal, which
+	// holds the `1090` value through the retune, and the slot dropped from the toast, which leaves
+	// the slot empty on a toast outside any container. The container applies the level; the toast
+	// declares the slot and applies none of its own.
+	it('reads the stacking level from the toast rung through its slot, on the container and on the toast', () => {
+		const host = scene.mount(
+			'<div class="rung"><div class="toast-container"><div class="toast show">Oak shipment</div></div><div class="toast show">Ash shipment</div></div>',
+		)
+		const rung = requireValue(host.querySelector<HTMLElement>('.rung'), 'No rung wrapper')
+		const container = requireValue(host.querySelector('.toast-container'), 'No toast container')
+		const toast = requireValue(host.querySelector('.rung > .toast'), 'No bare toast')
+		expect(readStyle(container, 'position')).toBe('absolute')
+		expect(readRootToken(TOKEN_NAMES.stack.toast)).toBe('1090')
+		expect(readStyle(container, 'z-index')).toBe('1090')
+		expect(readToken(container, '--bs-toast-zindex')).toBe('1090')
+		expect(readToken(toast, '--bs-toast-zindex')).toBe('1090')
+		rung.style.setProperty(TOKEN_NAMES.stack.toast, '1234')
+		expect(readStyle(container, 'z-index')).toBe('1234')
+		expect(readToken(container, '--bs-toast-zindex')).toBe('1234')
+		expect(readToken(toast, '--bs-toast-zindex')).toBe('1234')
+	})
+
+	// The mutation this catches is the last-child qualifier dropped, which spaces the last toast
+	// below itself as well.
+	it('fits its toasts, lets the pointer through, and spaces each toast but the last by the stacking gap', () => {
+		const host = scene.mount(
+			'<div class="position-relative" style="width: 600px; height: 400px"><div class="toast-container"><div class="toast show">Oak shipment</div><div class="toast show">Ash shipment</div><div class="toast show">Elm shipment</div></div></div>',
+		)
+		const container = requireValue(host.querySelector('.toast-container'), 'No toast container')
+		const toasts = [...container.querySelectorAll('.toast')]
+		const [first, second, last] = toasts
+		// The container is as wide as its widest toast rather than as wide as its host.
+		expect(readPixels(container, 'width')).toBe(350)
+		expect(readStyle(container, 'pointer-events')).toBe('none')
+		expect(toasts.map((toast) => readStyle(toast, 'pointer-events'))).toEqual([
+			'auto',
+			'auto',
+			'auto',
+		])
+		expect(toasts.map((toast) => readPixels(toast, 'margin-bottom'))).toEqual([24, 24, 0])
+		const upper = requireValue(first, 'No first toast').getBoundingClientRect()
+		const middle = requireValue(second, 'No second toast').getBoundingClientRect()
+		expect(middle.top - upper.bottom).toBe(24)
+		expect(container.getBoundingClientRect().bottom).toBeCloseTo(
+			requireValue(last, 'No last toast').getBoundingClientRect().bottom,
+			3,
+		)
+		// The gap is read on each toast from the slot it declares, so a retune set on one toast
+		// moves that toast's gap alone.
+		requireValue(second, 'No second toast').setAttribute('style', '--bs-toast-spacing: 10px')
+		expect(toasts.map((toast) => readPixels(toast, 'margin-bottom'))).toEqual([24, 10, 0])
+	})
+})
+
+describe('toast header and body', () => {
+	// The mutation this catches is the header rounded by the toast's full radius, which paints the
+	// header's corners outside the toast's inner border edge.
+	it('lays the header out in a row and rounds its top corners by the toast radius less the border width', () => {
+		const host = scene.mount(
+			'<div class="toast show"><div class="toast-header"><strong>Oak</strong><small>09:40</small></div><div class="toast-body">Oak shipment</div></div>',
+		)
+		const toast = requireValue(host.querySelector('.toast'), 'No toast')
+		const header = requireValue(toast.querySelector('.toast-header'), 'No toast header')
+		expect(readStyle(header, 'display')).toBe('flex')
+		expect(readStyle(header, 'align-items')).toBe('center')
+		expect(readPixels(header, 'padding-top')).toBe(8)
+		expect(readPixels(header, 'padding-left')).toBe(12)
+		expect(readStyle(header, 'background-clip')).toBe('padding-box')
+		expect(readPixels(header, 'border-bottom-width')).toBe(1)
+		expect(readStyle(header, 'border-bottom-style')).toBe('solid')
+		expect(readPixels(header, 'border-top-width')).toBe(0)
+		const inner =
+			readPixels(toast, 'border-top-left-radius') - readPixels(toast, 'border-top-width')
+		expect(inner).toBeCloseTo(5, 3)
+		expect(readPixels(header, 'border-top-left-radius')).toBeCloseTo(inner, 3)
+		expect(readPixels(header, 'border-top-right-radius')).toBeCloseTo(inner, 3)
+		expect(readPixels(header, 'border-bottom-left-radius')).toBe(0)
+		expect(readPixels(header, 'border-bottom-right-radius')).toBe(0)
+		// The inner radius follows the published radius factor, because both terms read the toast's
+		// own slots.
+		document.documentElement.style.setProperty(TOKEN_NAMES.factor.radius, '2')
+		expect(readPixels(header, 'border-top-left-radius')).toBeCloseTo(
+			readPixels(toast, 'border-top-left-radius') - 1,
+			3,
+		)
+	})
+
+	// The mutation this catches is the combinator written against the bare toast class, which
+	// reaches the control inside the body as well.
+	it('fits the header close control into the header and leaves a close control elsewhere in the toast with no margin', () => {
+		const host = scene.mount(
+			'<div class="toast show"><div class="toast-header"><strong class="flex-grow-1">Oak</strong><button type="button" class="btn-close" aria-label="Close"></button></div><div class="toast-body">Oak shipment <button type="button" class="btn-close" aria-label="Close"></button></div></div>',
+		)
+		const header = requireValue(host.querySelector('.toast-header'), 'No toast header')
+		const fitted = requireValue(header.querySelector('.btn-close'), 'No header close control')
+		const loose = requireValue(
+			host.querySelector('.toast-body .btn-close'),
+			'No body close control',
+		)
+		expect(readPixels(fitted, 'margin-left')).toBe(TOAST_CLOSE_GEOMETRY.left)
+		expect(readPixels(fitted, 'margin-right')).toBe(TOAST_CLOSE_GEOMETRY.right)
+		for (const side of ['top', 'right', 'bottom', 'left'])
+			expect(readPixels(loose, `margin-${side}`)).toBe(0)
+		// The negative end margin pulls the control into the header's end padding, so its outer edge
+		// sits half an inset from the header's edge rather than a whole one. The margins are
+		// physical, so the control sits at the right.
+		const edge = header.getBoundingClientRect().right
+		const target = fitted.getBoundingClientRect()
+		expect(target.right).toBeCloseTo(
+			edge - readPixels(header, 'padding-right') - TOAST_CLOSE_GEOMETRY.right,
+			3,
+		)
+		expect(target.left).toBeGreaterThan(header.getBoundingClientRect().left + 175)
+	})
+
+	it('insets the body by the horizontal inset on every side and breaks a long word', () => {
+		const word = 'Northworksharbordepotconsignmentreferencenumber'.repeat(3)
+		const host = scene.mount(`<div class="toast show"><div class="toast-body">${word}</div></div>`)
+		const toast = requireValue(host.querySelector('.toast'), 'No toast')
+		const body = requireValue(toast.querySelector('.toast-body'), 'No toast body')
+		for (const side of ['top', 'right', 'bottom', 'left'])
+			expect(readPixels(body, `padding-${side}`)).toBe(12)
+		expect(readStyle(body, 'overflow-wrap')).toBe('break-word')
+		// The word wraps inside the toast rather than overflowing its box.
+		expect(body.scrollWidth).toBe(body.clientWidth)
+	})
+})
+
+describe('toast paint', () => {
+	describe.each(TEXT_MODES)('in %s', (mode) => {
+		// The mutation this catches is a slot written as the literal its alias resolves to: it reads
+		// the same at rest in one mode and follows neither the other mode nor the retune.
+		it('paints the toast and its header from the body aliases', () => {
+			const host = scene.mount(
+				`<div data-bs-theme="${mode}"><div class="toast show"><div class="toast-header"><strong>Oak</strong></div><div class="toast-body">Oak shipment</div></div></div>`,
+			)
+			const island = requireValue(host.querySelector<HTMLElement>('[data-bs-theme]'), 'No island')
+			const toast = requireValue(island.querySelector('.toast'), 'No toast')
+			const header = requireValue(toast.querySelector('.toast-header'), 'No toast header')
+			// The island resolves its own mode's aliases: the root is light, so only a dark island
+			// reads another surface.
+			expect(readToken(island, '--bs-body-bg-rgb') === readRootToken('--bs-body-bg-rgb')).toBe(
+				mode === 'light',
+			)
+			const fill = `rgba(${readToken(island, '--bs-body-bg-rgb')}, 0.85)`
+			const edge = readToken(island, '--bs-border-color-translucent')
+			const muted = readToken(island, '--bs-secondary-color')
+			expect(matchesColor(readStyle(toast, 'background-color'), fill)).toBe(true)
+			expect(matchesColor(readStyle(toast, 'border-top-color'), edge)).toBe(true)
+			expect(matchesColor(readStyle(header, 'background-color'), fill)).toBe(true)
+			expect(matchesColor(readStyle(header, 'border-bottom-color'), edge)).toBe(true)
+			expect(matchesColor(readStyle(header, 'color'), muted)).toBe(true)
+			// Retuning the aliases on the island moves every paint with them, in either mode.
+			island.style.setProperty('--bs-body-bg-rgb', '11, 22, 33')
+			island.style.setProperty('--bs-border-color-translucent', 'rgb(44, 55, 66)')
+			island.style.setProperty('--bs-secondary-color', 'rgb(77, 88, 99)')
+			expect(readStyle(toast, 'background-color')).toBe('rgba(11, 22, 33, 0.85)')
+			expect(readStyle(toast, 'border-top-color')).toBe('rgb(44, 55, 66)')
+			expect(readStyle(header, 'background-color')).toBe('rgba(11, 22, 33, 0.85)')
+			expect(readStyle(header, 'border-bottom-color')).toBe('rgb(44, 55, 66)')
+			expect(readStyle(header, 'color')).toBe('rgb(77, 88, 99)')
+		})
+	})
+})
