/**
 * Carries the customization recipe `guides/veneer.md` shows under Tokens.
 *
 * @remarks
 * The guide claims what this recipe does to a consumer's spacing, to the primary role's whole tier
 * family, to a translucent fill written through the channel triplet, and to a dark island.
 * `tests/src/styles/integration.test.ts` loads this text and reads each of those results.
 *
 * Copy this string from that fence, and change it with the fence. The fence carries no `@example`
 * title for `tests/guides.test.ts` to match it by, so `tests/setupStyles.test.ts` reads
 * {@link VENEER_GUIDE_PATH} itself and requires this text inside it: an edit to the fence alone
 * reddens that case.
 */
export const CUSTOMIZATION_RECIPE = `:root {
	--vn-factor-density: 1.25;
	--vn-color-primary-base: #2e7d32;
	--vn-color-primary-rgb: 46, 125, 50;
}

[data-bs-theme='dark'] {
	--vn-color-primary-base: #66bb6a;
	--vn-color-primary-rgb: 102, 187, 106;
}

.brand-veil {
	background-color: rgba(var(--vn-color-primary-rgb), 0.5);
}`

/**
 * Carries the customization recipe cut down to the fill override, with the channel triplet left
 * out.
 *
 * @remarks
 * `guides/veneer.md` warns under Customization that a rule of the consumer's own reading the
 * triplet keeps painting the old brand where only the fill is overridden. This is that omission,
 * and `tests/src/styles/integration.test.ts` loads it and reads what the triplet still paints.
 */
export const FILL_ONLY_RECIPE = `:root {
	--vn-color-primary-base: #2e7d32;
}`
