import { isRecord } from '@orkestrel/contract'
import { parse } from 'postcss'
import { collectTokenNodes, normalizeSelectorText } from './setup.js'

/** Holds the physical inline-axis longhand properties that are direction-sensitive on their own. */
export const PHYSICAL_LONGHANDS: readonly string[] = Object.freeze([
	'margin-left',
	'margin-right',
	'padding-left',
	'padding-right',
	'left',
	'right',
	'border-left',
	'border-right',
	'border-left-width',
	'border-right-width',
	'border-left-style',
	'border-right-style',
	'border-left-color',
	'border-right-color',
	'border-top-left-radius',
	'border-top-right-radius',
	'border-bottom-left-radius',
	'border-bottom-right-radius',
	'background-position-x',
	'scroll-margin-left',
	'scroll-margin-right',
	'scroll-padding-left',
	'scroll-padding-right',
])

/**
 * Holds the four-value edge shorthands whose second and fourth values must match to stay
 * direction-neutral.
 */
export const EDGE_SHORTHANDS: readonly string[] = Object.freeze([
	'margin',
	'padding',
	'inset',
	'border-width',
	'border-style',
	'border-color',
])

/** Names the shorthand that carries corner order instead of edge order. */
export const RADIUS_SHORTHAND = 'border-radius'

/** Holds the properties whose direction keyword is flagged only when a token equals it exactly. */
export const SIDE_KEYWORD_PROPERTIES: readonly string[] = Object.freeze([
	'text-align',
	'text-align-last',
	'background-position',
	'background',
	'float',
	'clear',
])

/**
 * Holds the ancestor and descendant tag pairs the HTML content model mandates.
 *
 * @remarks
 * A rule in the `elements` layer normally selects one bare tag, because a second bare tag in the
 * same selector makes the treatment depend on a document structure the author of the markup chose.
 * The pairs here are the ones the markup cannot avoid: each descendant has no other legal parent.
 */
export const MANDATED_TAG_PAIRS: ReadonlyArray<readonly [string, string]> = Object.freeze([
	Object.freeze(['details', 'summary'] as const),
	Object.freeze(['dl', 'dt'] as const),
	Object.freeze(['dl', 'dd'] as const),
	Object.freeze(['fieldset', 'legend'] as const),
	Object.freeze(['figure', 'figcaption'] as const),
	Object.freeze(['ol', 'li'] as const),
	Object.freeze(['optgroup', 'option'] as const),
	Object.freeze(['ruby', 'rp'] as const),
	Object.freeze(['ruby', 'rt'] as const),
	Object.freeze(['select', 'option'] as const),
	Object.freeze(['table', 'caption'] as const),
	Object.freeze(['table', 'colgroup'] as const),
	Object.freeze(['table', 'tbody'] as const),
	Object.freeze(['table', 'tfoot'] as const),
	Object.freeze(['table', 'thead'] as const),
	Object.freeze(['tr', 'td'] as const),
	Object.freeze(['tr', 'th'] as const),
	Object.freeze(['ul', 'li'] as const),
])

/**
 * Splits a declaration value into its top-level whitespace-separated tokens.
 *
 * @param value - The declaration value to split.
 * @returns The value's top-level tokens, treating parenthesized content such as `calc()` and
 *   quoted content such as `"a b"` as part of the current token rather than a split point, never
 *   letting the tracked parenthesis depth go below zero, and emitting a bare `/` (outside
 *   parentheses and outside quoted strings) as its own token, whatever the surrounding spacing.
 */
export function splitTopLevelValues(value: string): readonly string[] {
	const values: string[] = []
	let current = ''
	let depth = 0
	let quote: '"' | "'" | undefined
	for (const char of value) {
		if (quote !== undefined) {
			current += char
			if (char === quote) quote = undefined
			continue
		}
		if (char === '"' || char === "'") {
			quote = char
			current += char
			continue
		}
		if (char === '(') depth += 1
		if (char === ')') depth = Math.max(0, depth - 1)
		if (/\s/u.test(char) && depth === 0) {
			if (current.length > 0) values.push(current)
			current = ''
			continue
		}
		if (char === '/' && depth === 0) {
			if (current.length > 0) values.push(current)
			values.push('/')
			current = ''
			continue
		}
		current += char
	}
	if (current.length > 0) values.push(current)
	return values
}

/**
 * Matches a four-token edge shorthand whose second and fourth tokens differ.
 *
 * @param values - The declaration value's top-level tokens.
 * @returns `true` when `values` holds four tokens whose second and fourth differ, `false`
 *   otherwise.
 */
export function matchesEdgeShorthand(values: readonly string[]): boolean {
	if (values.length !== 4) return false
	const second = values[1]
	const fourth = values[3]
	return second !== undefined && fourth !== undefined && second !== fourth
}

/**
 * Matches a `border-radius` value whose corner tokens are asymmetric on either side of a bare `/`.
 *
 * @param values - The declaration value's top-level tokens.
 * @returns `true` when a radius side (the tokens before the bare `/`, the tokens after it, or the
 *   whole list when no `/` is present) carries two differing tokens in a two-token side, a first or
 *   third token that differs from the second in a three-token side — the tokens `a b c` set the
 *   top-left corner to `a`, the top-right and bottom-left corners to `b`, and the bottom-right
 *   corner to `c`, so a right-to-left flip swaps top-left with top-right and bottom-right with
 *   bottom-left, and the first and third corners never swap with each other — or a first-second
 *   or third-fourth pair that differs in a four-token side; `false` otherwise.
 */
export function matchesRadiusShorthand(values: readonly string[]): boolean {
	const slashIndex = values.indexOf('/')
	const sides =
		slashIndex === -1 ? [values] : [values.slice(0, slashIndex), values.slice(slashIndex + 1)]
	return sides.some((side) => {
		if (side.length === 2) {
			const first = side[0]
			const second = side[1]
			return first !== undefined && second !== undefined && first !== second
		}
		if (side.length === 3) {
			const first = side[0]
			const second = side[1]
			const third = side[2]
			if (first !== undefined && second !== undefined && first !== second) return true
			return second !== undefined && third !== undefined && third !== second
		}
		if (side.length === 4) {
			const first = side[0]
			const second = side[1]
			const third = side[2]
			const fourth = side[3]
			if (first !== undefined && second !== undefined && first !== second) return true
			return third !== undefined && fourth !== undefined && third !== fourth
		}
		return false
	})
}

/**
 * Matches a value carrying a `left` or `right` token as a whole word.
 *
 * @param values - The declaration value's top-level tokens.
 * @returns `true` when a token equals `left` or `right` exactly, `false` otherwise.
 */
export function matchesSideKeyword(values: readonly string[]): boolean {
	return values.some((value) => value === 'left' || value === 'right')
}

/**
 * Normalizes the whitespace inside one parenthesized value token.
 *
 * @param token - The top-level value token to normalize.
 * @returns The token with every whitespace run collapsed to one space, and with the space that
 *   follows an opening parenthesis or precedes a closing one removed, so `calc( 1px )` and
 *   `calc(1px)` compare equal. A token carrying no parentheses is returned with its whitespace
 *   runs collapsed and nothing else changed.
 */
export function normalizeValueToken(token: string): string {
	return token.replace(/\s+/gu, ' ').replace(/\(\s+/gu, '(').replace(/\s+\)/gu, ')')
}

/**
 * Matches a declaration whose lowercased property and value make it direction-sensitive.
 *
 * @param prop - The declaration's property, in its original case.
 * @param value - The declaration's value, in its original case, without `!important`; the
 *   comparison is case-insensitive, and each token's parenthesized whitespace is normalized
 *   through {@link normalizeValueToken} before the comparison.
 * @returns `true` when the property is a physical longhand; or a side-keyword property carries a
 *   token equal to `left` or `right`; or an edge shorthand carries four tokens whose second and
 *   fourth differ; or `border-radius` carries an asymmetric side; `false` otherwise.
 */
export function matchesDirectionSensitive(prop: string, value: string): boolean {
	const lowerProp = prop.toLowerCase()
	const tokens = splitTopLevelValues(value.toLowerCase()).map(normalizeValueToken)
	if (PHYSICAL_LONGHANDS.includes(lowerProp)) return true
	if (SIDE_KEYWORD_PROPERTIES.includes(lowerProp)) return matchesSideKeyword(tokens)
	if (EDGE_SHORTHANDS.includes(lowerProp)) return matchesEdgeShorthand(tokens)
	if (lowerProp === RADIUS_SHORTHAND) return matchesRadiusShorthand(tokens)
	return false
}

/**
 * Scans a stylesheet for its first direction-sensitive declaration.
 *
 * @param css - The stylesheet text to scan.
 * @returns The first direction-sensitive declaration's property lowercased, then `: `, then its
 *   value as postcss reports it, without `!important`, in document order; or `undefined` when the
 *   stylesheet declares none. The guard covers the ruled property families only: gradient
 *   directions, shadow offsets, and transforms are not scanned, and a side-keyword property is
 *   scanned for a token equal to `left` or `right` alone, so a percentage or length side such as
 *   `background-position: 0% center` is not scanned either.
 * @throws The `CssSyntaxError` postcss raises when `css` cannot be parsed.
 */
export function scanPhysicalDeclaration(css: string): string | undefined {
	const root = parse(css)
	let found: string | undefined
	root.walkDecls((decl) => {
		if (matchesDirectionSensitive(decl.prop, decl.value)) {
			found = `${decl.prop.toLowerCase()}: ${decl.value}`
			return false
		}
	})
	return found
}

/** Names the Bootstrap scopes the compatibility oracle reads. */
export type BootstrapScope = 'root' | 'dark'

/**
 * Matches the selector each Bootstrap scope is written with, after the selector's whitespace is
 * collapsed.
 *
 * @remarks
 * The root pattern admits `:root` alone and `:root` at the head of a selector list, which is how
 * Bootstrap writes `:root, [data-bs-theme=light]`. The dark pattern is anchored at the start, so a
 * component rule painted inside a dark island — `.navbar-dark, .navbar[data-bs-theme=dark]` —
 * is outside the scope while `[data-bs-theme=dark] .btn-close` is inside it.
 */
export const BOOTSTRAP_SCOPE_PATTERNS: Readonly<Record<BootstrapScope, RegExp>> = Object.freeze({
	root: /^:root(,|$| )/u,
	dark: /^\[data-bs-theme=dark\]/u,
})

/** Names the Bootstrap release the compatibility oracle reads. */
export const BOOTSTRAP_VERSION = '5.3.8'

/** Records the SHA-256 digest of the stylesheet that release ships. */
export const BOOTSTRAP_DIGEST = '4a50207b956a4ab943640ee993118b554a34e96a23261cfe58b9aa1807a7849b'

/**
 * Locates the installed Bootstrap stylesheet the compatibility oracle reads.
 *
 * @remarks
 * This module is loaded by the Node `setup` project and the browser `src:styles` project,
 * imports no stylesheet, and takes no `node:fs` import; the styles project loads the built cascade
 * through its `setupFiles`. The Node proof reads the file itself and hands the text to
 * {@link extractBootstrapVariables}.
 */
export const BOOTSTRAP_CASCADE_PATH = 'node_modules/bootstrap/dist/css/bootstrap.css'

/**
 * Locates this package's guide, whose customization fence {@link CUSTOMIZATION_RECIPE} copies.
 *
 * @remarks
 * The path is here for the same reason {@link BOOTSTRAP_CASCADE_PATH} is: a browser project loads
 * this module, so it takes no `node:fs` import, and the Node proof reads the file itself.
 */
export const VENEER_GUIDE_PATH = 'guides/veneer.md'

/**
 * Extracts every custom property one Bootstrap scope declares, from the stylesheet's own text.
 *
 * @param cascade - The Bootstrap stylesheet's text, read from {@link BOOTSTRAP_CASCADE_PATH}.
 * @param scope - The scope to read, matched through {@link BOOTSTRAP_SCOPE_PATTERNS}.
 * @returns Each declaration's name and value, in source order, with a name a later rule
 *   re-declares reported once at its first position and carrying that first rule's value,
 *   trimmed.
 * @throws The `CssSyntaxError` postcss raises when `cascade` cannot be parsed.
 *
 * @remarks
 * The text arrives as an argument because this module imports no stylesheet: the Node `setup`
 * project and the browser `src:styles` project load it, and the styles project loads the built
 * cascade through its `setupFiles`. Keeping the reader pure also lets a case drive it with a
 * written stylesheet and a control that must report nothing.
 *
 * This is the second mechanism {@link BOOTSTRAP_ROOT_VARIABLES}, {@link BOOTSTRAP_DARK_VARIABLES},
 * and the retained value tables are compared against. Re-deriving those from the same hand-written
 * source they were copied from would pass for every value the copy ever held.
 */
export function extractBootstrapVariables(
	cascade: string,
	scope: BootstrapScope,
): ReadonlyArray<readonly [name: string, value: string]> {
	const pattern = BOOTSTRAP_SCOPE_PATTERNS[scope]
	const declared: Array<readonly [string, string]> = []
	const seen = new Set<string>()
	parse(cascade).walkRules((rule) => {
		if (!pattern.test(normalizeSelectorText(rule.selector))) return
		rule.walkDecls((declaration) => {
			if (!declaration.prop.startsWith('--') || seen.has(declaration.prop)) return
			seen.add(declaration.prop)
			declared.push([declaration.prop, declaration.value.trim()])
		})
	})
	return declared
}

