+/**
+ * Lists the weight steps the release's `font-weight` utility writes, in its map order, each beside
+ * the value the release records for it.
+ *
+ * @remarks
+ * The `lighter` and `bolder` values are relative keywords, so each resolves against the weight its
+ * parent resolves, and a step written as the number one parent weight resolves it to reads the same
+ * under that parent. A proof reads every step under each of the {@link FONT_WEIGHT_PARENTS}
+ * weights against an inline twin carrying the recorded value.
+ */
+export const FONT_WEIGHT_CASES = Object.freeze([
+	Object.freeze({ key: 'lighter', value: 'lighter' }),
+	Object.freeze({ key: 'light', value: '300' }),
+	Object.freeze({ key: 'normal', value: '400' }),
+	Object.freeze({ key: 'medium', value: '500' }),
+	Object.freeze({ key: 'semibold', value: '600' }),
+	Object.freeze({ key: 'bold', value: '700' }),
+	Object.freeze({ key: 'bolder', value: 'bolder' }),
+])
+
+/**
+ * Lists the parent weights a relative weight step is read under.
+ *
+ * @remarks
+ * CSS resolves the relative keywords in bands, and these weights sit in different bands: under a
+ * parent weight of 400 the `lighter` keyword resolves to 100 and the `bolder` keyword to 700, and
+ * under a parent weight of 600 they resolve to 400 and 900. So a relative step written as either
+ * number it resolves to reads differently under the other parent.
+ */
+export const FONT_WEIGHT_PARENTS = Object.freeze(['400', '600'])
+
+/** Lists the values the release's `font-style` utility writes, in its list order. */
+export const FONT_STYLE_VALUES = Object.freeze(['italic', 'normal'])
+
+/**
+ * Lists the steps the release's `line-height` utility writes, in its map order, each beside the
+ * value the release records for it.
+ *
+ * @remarks
+ * Every value is a unitless factor of the font size, so a proof reads each step over a fixed font
+ * size as that size times the recorded factor. The `base` step reads the `--vn-line-body` token,
+ * which carries the recorded factor by default.
+ */
+export const LINE_HEIGHT_CASES = Object.freeze([
