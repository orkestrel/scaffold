diff --git a/src/styles/utilities/_font.scss b/src/styles/utilities/_font.scss
new file mode 100644
index 0000000..2dabb3f
--- /dev/null
+++ b/src/styles/utilities/_font.scss
@@ -0,0 +1,54 @@
+@use 'sass:map';
+@use '../mixins' as *;
+
+@layer utilities {
+	// Stands in for the release's `$font-sizes` map. Each step reads the size token its heading
+	// class reads, so the `.fs-1` class resolves what the `.h1` class resolves and a retuned size
+	// token moves both. The release's fluid formula and its `(min-width: 1200px)` cap are not
+	// written, as the heading classes write neither.
+	$sizes: ();
+	@for $level from 1 through 6 {
+		$sizes: map.set($sizes, $level, var(--vn-size-#{9 - $level}));
+	}
+	// None of the release's font entries is responsive, so the walk writes each at the empty infix
+	// alone, ahead of every media block, in the release's map order.
+	@include breakpoint-each using ($infix, $_boundary) {
+		@include utility(
+			font,
+			font-family,
+			(
+				monospace: var(--bs-font-monospace),
+			),
+			$infix
+		);
+		@include utility(fs, font-size, $sizes, $infix);
+		@include utility(fst, font-style, (italic, normal), $infix);
+		@include utility(
+			fw,
+			font-weight,
+			(
+				lighter: lighter,
+				light: 300,
+				normal: 400,
+				medium: 500,
+				semibold: 600,
+				bold: 700,
+				bolder: bolder,
+			),
+			$infix
+		);
+		// The base step reads the body line-height token, so a retuned body line moves it with the
+		// body text; the other steps keep the release's literals, which no token carries.
+		@include utility(
+			lh,
+			line-height,
+			(
+				1: 1,
+				sm: 1.25,
+				base: var(--vn-line-body),
+				lg: 2,
+			),
+			$infix
+		);
+	}
+}
diff --git a/tests/src/styles/utilities/font.test.ts b/tests/src/styles/utilities/font.test.ts
new file mode 100644
index 0000000..2d8963a
--- /dev/null
+++ b/tests/src/styles/utilities/font.test.ts
@@ -0,0 +1,299 @@
+import { TOKEN_NAMES } from '@src/core'
+import { requireValue } from '@orkestrel/test'
+import { findRule, readStyle } from '@orkestrel/test/browser'
+import { afterEach, describe, expect, it } from 'vitest'
+import { scene, visitBreakpoint } from '../../../setupBrowser.js'
+import {
+	BREAKPOINT_INFIXES,
+	FONT_ENTRY_CASES,
+	FONT_STYLE_VALUES,
+	FONT_WEIGHT_CASES,
+	FONT_WEIGHT_PARENTS,
+	LINE_HEIGHT_CASES,
+	TYPE_HEADING_CASES,
+	TYPE_HEADING_TOKEN_CASES,
+	VIEWPORT_WIDTHS,
+} from '../../../setupStyles.js'
+
+afterEach(() => {
+	scene.clear()
+})
+
+describe('font utilities', () => {
+	// The release scales the `.fs-1` to `.fs-4` sizes with the viewport and caps them from 1200px, so
+	// a size class carrying the fluid formula reads smaller than its heading class at the narrow
+	// variant, and one carrying the release's capped literal reads larger at the wide one.
+	it.each(TYPE_HEADING_CASES)(
+		'resolves the size class of the $twin level to the size its heading class resolves at each journey viewport',
+		async ({ twin, size }) => {
+			const level = twin.slice(1)
+			const host = scene.mount(
+				`<div class="${twin}">Heading class</div><div class="fs-${level}">Size class</div>`,
+			)
+			const heading = requireValue(host.querySelector(`.${twin}`), 'No heading class')
+			const utility = requireValue(host.querySelector(`.fs-${level}`), 'No size class')
+			for (const viewport of VIEWPORT_WIDTHS) {
+				await visitBreakpoint(viewport, () => {
+					expect(readStyle(utility, 'font-size')).toBe(size)
+					expect(readStyle(utility, 'font-size')).toBe(readStyle(heading, 'font-size'))
+				})
+			}
+		},
+	)
+
+	// A resolved size agrees with its token and with a literal of the same value, so each level is
+	// read on a host that retunes the token that level names: a size class carrying a literal,
+	// or naming a sibling level's token, reads its default there.
+	it.each(TYPE_HEADING_TOKEN_CASES)(
+		'reads the size class of the $twin level from the $token token its heading class reads',
+		({ twin, token, value }) => {
+			const level = twin.slice(1)
+			const host = scene.mount(
+				`<div style="${token}: ${value}"><div class="${twin}">Heading class</div><div class="fs-${level}">Size class</div></div>`,
+			)
+			const heading = requireValue(host.querySelector(`.${twin}`), 'No heading class')
+			const utility = requireValue(host.querySelector(`.fs-${level}`), 'No size class')
+			expect(readStyle(utility, 'font-size')).toBe(value)
+			expect(readStyle(heading, 'font-size')).toBe(value)
+		},
+	)
+
+	it.each(LINE_HEIGHT_CASES)(
+		'resolves the $key line height as its recorded factor of a fixed font size',
+		({ key, value }) => {
+			const element = requireValue(
+				scene
+					.mount(`<div style="font-size: 20px; line-height: 7"><p class="lh-${key}">Line</p></div>`)
+					.querySelector(`.lh-${key}`),
+				`No lh-${key} element`,
+			)
+			expect(readStyle(element, 'line-height')).toBe(`${Number(value) * 20}px`)
+		},
+	)
+
+	// The body line token carries the release's factor, so the default reading cannot tell the token
+	// from the literal. A host retuning the token can: the literal keeps the release's factor there.
+	it('reads the base line height from the body line token', () => {
+		const host = scene.mount(
+			`<div style="font-size: 20px; ${TOKEN_NAMES.line.body}: 3"><p class="lh-base">Base</p><p class="lh-lg">Large</p></div>`,
+		)
+		const base = requireValue(host.querySelector('.lh-base'), 'No lh-base element')
+		const large = requireValue(host.querySelector('.lh-lg'), 'No lh-lg element')
+		expect(readStyle(base, 'line-height')).toBe('60px')
+		// The other steps are literals, so the same retune leaves them at their recorded factor.
+		expect(readStyle(large, 'line-height')).toBe('40px')
+	})
+
+	// The class reads the `--bs-font-monospace` alias the release names, and the root declares that
+	// alias over the Veneer token, so a root retune of either name reaches the class. The root
+	// resolves the alias from the token, so each retune is taken at the root.
+	it('reads the monospace stack from the alias the release names and the token the alias reads', () => {
+		const host = scene.mount(
+			`<p class="font-monospace">Monospace</p><p style="font-family: var(${TOKEN_NAMES.font.mono.base})">Token</p>`,
+		)
+		const utility = requireValue(host.querySelector('.font-monospace'), 'No monospace element')
+		const token = requireValue(host.lastElementChild, 'No token twin')
+		const resting = readStyle(utility, 'font-family')
+		expect(resting).toBe(readStyle(token, 'font-family'))
+		expect(resting).not.toBe(readStyle(document.body, 'font-family'))
+		const root = document.documentElement.style
+		root.setProperty('--bs-font-monospace', 'serif')
+		try {
+			expect(readStyle(utility, 'font-family')).toBe('serif')
+		} finally {
+			root.removeProperty('--bs-font-monospace')
+		}
+		root.setProperty(TOKEN_NAMES.font.mono.base, 'fantasy')
+		try {
+			expect(readStyle(utility, 'font-family')).toBe('fantasy')
+		} finally {
+			root.removeProperty(TOKEN_NAMES.font.mono.base)
+		}
+		expect(readStyle(utility, 'font-family')).toBe(resting)
+	})
+
+	// Each class is read against an inline twin carrying the value the release records, under a 400
+	// and a 600 parent weight: a relative keyword written as the number a parent resolves it to
+	// reads that number under the other parent, and a class that sets nothing inherits a parent
+	// weight that differs from its twin's under the 400 parent, the 600 parent, or both.
+	it.each(FONT_WEIGHT_PARENTS)('resolves every weight step under a %s parent weight', (parent) => {
+		const host = scene.mount(
+			`<div style="font-weight: ${parent}">${FONT_WEIGHT_CASES.map(
+				({ key, value }) =>
+					`<span class="fw-${key}">Class</span><span data-twin="${key}" style="font-weight: ${value}">Twin</span>`,
+			).join('')}</div>`,
+		)
+		const readings = FONT_WEIGHT_CASES.map(({ key }) => [
+			readStyle(requireValue(host.querySelector(`.fw-${key}`), `No fw-${key}`), 'font-weight'),
+			readStyle(
+				requireValue(host.querySelector(`[data-twin="${key}"]`), `No ${key} twin`),
+				'font-weight',
+			),
+		])
+		expect(readings.map(([utility]) => utility)).toEqual(readings.map(([, twin]) => twin))
+	})
+
+	it('resolves the relative weight steps differently under a 400 and a 600 parent weight', () => {
+		// This is the control the preceding case stands on: were the parents in a shared band, a
+		// relative step written as a number would pass under both.
+		const host = scene.mount(
+			FONT_WEIGHT_PARENTS.map(
+				(parent) =>
+					`<div style="font-weight: ${parent}"><span class="fw-lighter">Lighter</span><span class="fw-bolder">Bolder</span></div>`,
+			).join(''),
+		)
+		const lighter = [...host.querySelectorAll('.fw-lighter')].map((element) =>
+			readStyle(element, 'font-weight'),
+		)
+		const bolder = [...host.querySelectorAll('.fw-bolder')].map((element) =>
+			readStyle(element, 'font-weight'),
+		)
+		expect(lighter).toEqual(['100', '400'])
+		expect(bolder).toEqual(['700', '900'])
+	})
+
+	it('resolves every style step inside an oblique parent', () => {
+		// The parent carries a style neither step writes, so each reading can only come from its class.
+		const host = scene.mount(
+			`<div style="font-style: oblique 20deg">${FONT_STYLE_VALUES.map(
+				(value) => `<span class="fst-${value}">${value}</span>`,
+			).join('')}</div>`,
+		)
+		expect(
+			FONT_STYLE_VALUES.map((value) =>
+				readStyle(
+					requireValue(host.querySelector(`.fst-${value}`), `No fst-${value}`),
+					'font-style',
+				),
+			),
+		).toEqual([...FONT_STYLE_VALUES])
+	})
+
+	it('writes no infixed class for any font entry', async () => {
+		// Each entry's class is written again with the `-md` infix after its prefix, inside a
+		// paragraph declaring a value of each property that no entry writes. So an infixed class the
+		// cascade applied would read differently from the paragraph around it.
+		const infixed = FONT_ENTRY_CASES.map(({ prefix, property, name }) => ({
+			name: `${prefix}-md${name.slice(prefix.length)}`,
+			property,
+		}))
+		const host = scene.mount(
+			`<p style="font-size: 10px; font-style: oblique 20deg; font-weight: 100; line-height: 7; font-family: serif">${infixed
+				.map(({ name }) => `<span class="${name}">${name}</span>`)
+				.join('')}</p>`,
+		)
+		const paragraph = requireValue(host.firstElementChild, 'No paragraph')
+		await visitBreakpoint(1401, () => {
+			expect(
+				infixed.map(({ name, property }) =>
+					readStyle(requireValue(host.querySelector(`.${name}`), `No ${name} element`), property),
+				),
+			).toEqual(infixed.map(({ property }) => readStyle(paragraph, property)))
+		})
+		// Every class of every entry is looked up again under every breakpoint infix, so an infixed
+		// rule for any value, not only the `-md` class this case reads at the 1401 viewport, reddens
+		// here.
+		const steps = [
+			...FONT_ENTRY_CASES.filter(({ prefix }) => prefix === 'font').map(({ prefix, name }) => [
+				prefix,
+				name.slice(prefix.length + 1),
+			]),
+			...TYPE_HEADING_CASES.map(({ twin }) => ['fs', twin.slice(1)]),
+			...FONT_STYLE_VALUES.map((value) => ['fst', value]),
+			...FONT_WEIGHT_CASES.map(({ key }) => ['fw', key]),
+			...LINE_HEIGHT_CASES.map(({ key }) => ['lh', key]),
+		]
+		expect(
+			BREAKPOINT_INFIXES.flatMap((infix) =>
+				steps.map(([prefix, step]) => `.${prefix}-${infix}-${step}`),
+			).filter((selector) => findRule(selector) !== undefined),
+		).toEqual([])
+	})
+
+	it('reads no mode or density factor, so a dark island and a doubled factor leave every value', () => {
+		const classes = FONT_ENTRY_CASES.map(({ name }) => name).join(' ')
+		const properties = FONT_ENTRY_CASES.map(({ property }) => property)
+		const host = scene.mount(
+			`<p>Plain</p><p class="${classes}">Light</p><div data-bs-theme="dark"><p class="${classes}">Dark</p></div>`,
+		)
+		const [plain, light, dark] = [...host.querySelectorAll('p')]
+		const plainElement = requireValue(plain, 'No plain element')
+		const lightElement = requireValue(light, 'No light element')
+		const darkElement = requireValue(dark, 'No dark element')
+		const resting = properties.map((property) => readStyle(lightElement, property))
+		// Every class moves its property off the unclassed paragraph's value, so each reading that
+		// follows comes from a class rather than from inheritance.
+		expect(
+			properties.filter((property, index) => readStyle(plainElement, property) === resting[index]),
+		).toEqual([])
+		expect(properties.map((property) => readStyle(darkElement, property))).toEqual(resting)
+		document.documentElement.style.setProperty(TOKEN_NAMES.factor.density, '2')
+		try {
+			expect(properties.map((property) => readStyle(lightElement, property))).toEqual(resting)
+			expect(properties.map((property) => readStyle(darkElement, property))).toEqual(resting)
+		} finally {
+			document.documentElement.style.removeProperty(TOKEN_NAMES.factor.density)
+		}
+	})
+
+	it('resolves the later value of an entry where an element carries conflicting classes of it', () => {
+		// Class order in the attribute is the reverse of the map's, so only the written order decides.
+		const host = scene.mount(
+			'<p class="fs-6 fs-1">Size</p><p class="fw-bold fw-light">Weight</p><p class="fst-normal fst-italic" style="font-style: oblique 20deg">Style</p><p class="lh-lg lh-1" style="font-size: 20px">Line</p>',
+		)
+		const [size, weight, style, line] = [...host.querySelectorAll('p')]
+		expect(readStyle(requireValue(size, 'No size element'), 'font-size')).toBe('16px')
+		expect(readStyle(requireValue(weight, 'No weight element'), 'font-weight')).toBe('700')
+		expect(readStyle(requireValue(style, 'No style element'), 'font-style')).toBe('normal')
+		expect(readStyle(requireValue(line, 'No line element'), 'line-height')).toBe('40px')
+	})
+
+	it('overrides the heading and display classes on the same element', () => {
+		const host = scene.mount(
+			'<div class="h1 fs-6 fw-light lh-sm">Heading</div><div class="display-1 fw-bold fs-2">Display</div>',
+		)
+		const heading = requireValue(host.querySelector('.h1'), 'No heading element')
+		const display = requireValue(host.querySelector('.display-1'), 'No display element')
+		expect(
+			['font-size', 'font-weight', 'line-height'].map((property) => readStyle(heading, property)),
+		).toEqual(['16px', '300', '20px'])
+		expect(['font-size', 'font-weight'].map((property) => readStyle(display, property))).toEqual([
+			'30px',
+			'700',
+		])
+	})
+
+	it('keeps its priority over a later unlayered consumer rule', () => {
+		const classes = FONT_ENTRY_CASES.map(({ name }) => name).join(' ')
+		const properties = FONT_ENTRY_CASES.map(({ property }) => property)
+		const host = scene.mount(`<p class="probe ${classes}">Utility</p><p class="probe">Consumer</p>`)
+		const utility = requireValue(host.firstElementChild, 'No utility element')
+		const consumer = requireValue(host.lastElementChild, 'No consumer element')
+		const utilityResting = properties.map((property) => readStyle(utility, property))
+		const consumerResting = properties.map((property) => readStyle(consumer, property))
+		scene.load(
+			'.probe { font-size: 7px; font-weight: 100; font-style: oblique 20deg; line-height: 3px; font-family: serif }',
+		)
+		// The rule moves every property it sets on the unclassed paragraph, so it is in force, and it
+		// moves none on the paragraph carrying the classes.
+		expect(
+			properties.filter(
+				(property, index) => readStyle(consumer, property) === consumerResting[index],
+			),
+		).toEqual([])
+		expect(properties.map((property) => readStyle(utility, property))).toEqual(utilityResting)
+	})
+
+	it('yields to an important override inside the utilities layer and to no unlayered one', () => {
+		const host = scene.mount('<p class="fs-3 lh-base">Utility</p>')
+		const element = requireValue(host.firstElementChild, 'No utility element')
+		scene.load('.fs-3 { font-size: 7px !important } .lh-base { line-height: 3px !important }')
+		expect(readStyle(element, 'font-size')).toBe('24px')
+		expect(readStyle(element, 'line-height')).toBe('36px')
+		scene.load(
+			'@layer utilities { .fs-3 { font-size: 9px !important } .lh-base { line-height: 5px !important } }',
+		)
+		expect(readStyle(element, 'font-size')).toBe('9px')
+		expect(readStyle(element, 'line-height')).toBe('5px')
+	})
+})
