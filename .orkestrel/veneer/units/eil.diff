diff --git a/tests/src/styles/components/quote.test.ts b/tests/src/styles/components/quote.test.ts
index 9aca06b..3d99925 100644
--- a/tests/src/styles/components/quote.test.ts
+++ b/tests/src/styles/components/quote.test.ts
@@ -19,6 +19,25 @@ describe('quote classes', () => {
 		expect(readStyle(bare, 'margin-bottom')).toBe('0px')
 	})
 
+	// The bare element's bar, inset, and italics belong to a quotation written without classes, so
+	// Bootstrap's class-built quotation reads the release's upright, unruled block.
+	it('leaves the bare quotation bar, inset, and italics off the quotation class', () => {
+		const host = scene.mount(
+			'<blockquote class="blockquote"><p>A quotation</p></blockquote><blockquote>Bare</blockquote>',
+		)
+		const element = requireValue(host.querySelector('.blockquote'), 'No quote class')
+		const bare = requireValue(
+			host.querySelector('blockquote:not(.blockquote)'),
+			'No bare quotation',
+		)
+		expect(readStyle(element, 'border-left-width')).toBe('0px')
+		expect(readStyle(element, 'padding-left')).toBe('0px')
+		expect(readStyle(element, 'font-style')).toBe('normal')
+		expect(readStyle(bare, 'border-left-width')).toBe('4px')
+		expect(readStyle(bare, 'padding-left')).toBe('16px')
+		expect(readStyle(bare, 'font-style')).toBe('italic')
+	})
+
 	// The children are quotation tags because their own partial gives them a nonzero end margin, so
 	// the last-child rule has a value to take away. A child whose tag already resolved to zero would
 	// read the same whether the rule reached it or not.
diff --git a/tests/src/styles/elements/dl.test.ts b/tests/src/styles/elements/dl.test.ts
index 2af15c0..c70a4ed 100644
--- a/tests/src/styles/elements/dl.test.ts
+++ b/tests/src/styles/elements/dl.test.ts
@@ -1,7 +1,7 @@
 import { requireValue } from '@orkestrel/test'
-import { matchesColor, readStyle } from '@orkestrel/test/browser'
+import { matchesColor, readPixels, readStyle } from '@orkestrel/test/browser'
 import { afterEach, describe, expect, it } from 'vitest'
-import { scene } from '../../../setupBrowser.js'
+import { scene, visitBreakpoint } from '../../../setupBrowser.js'
 import { TEXT_DL_CASES } from '../../../setupStyles.js'
 
 afterEach(() => {
@@ -28,8 +28,60 @@ describe('dl text treatment', () => {
 				'600',
 			)
 			const dd = requireValue(host.querySelector('dd'), 'No description')
-			expect(readStyle(dd, 'margin')).toBe('0px')
+			expect(readStyle(dd, 'margin')).toBe('0px 0px 8px')
 			expect(matchesColor(readStyle(dd, 'color'), description)).toBe(true)
 		},
 	)
 })
+
+describe('dl layout', () => {
+	// Bootstrap's horizontal description list pairs each term and description through the grid
+	// classes alone. The 576px viewport is the sm breakpoint's lower bound, where the pairs share a
+	// line; the test page opens narrower, so the reading visits the breakpoint.
+	it('lays a horizontal description list out beside its terms from the sm breakpoint', async () => {
+		const host = scene.mount(
+			'<div class="container"><dl class="row"><dt class="col-sm-3">Term</dt><dd class="col-sm-9">Definition</dd><dt class="col-sm-3">Second</dt><dd class="col-sm-9">Another</dd></dl></div>',
+		)
+		const terms = [...host.querySelectorAll('dt')]
+		const descriptions = [...host.querySelectorAll('dd')]
+		expect(terms).toHaveLength(2)
+		expect(descriptions).toHaveLength(2)
+		await visitBreakpoint(576, () => {
+			expect(window.innerWidth).toBe(576)
+			const [first, second] = terms.map((term) => term.getBoundingClientRect())
+			const boxes = descriptions.map((description) => description.getBoundingClientRect())
+			terms.forEach((term, index) => {
+				const box = term.getBoundingClientRect()
+				const pair = requireValue(boxes[index], 'No paired description')
+				expect(pair.top, `description ${String(index)} top`).toBeCloseTo(box.top, 1)
+				expect(Math.abs(pair.left - box.right), `description ${String(index)} left`).toBeLessThan(1)
+			})
+			// Bootstrap spaces the pairs with the description's 0.5rem end margin and nothing else.
+			const height = requireValue(boxes[0], 'No first description').height
+			expect(
+				requireValue(second, 'No second term').top - requireValue(first, 'No first term').top,
+			).toBeCloseTo(height + 8, 1)
+			expect(readPixels(requireValue(descriptions[0], 'No description'), 'margin-bottom')).toBe(8)
+		})
+	})
+
+	// A bare list keeps the two-column grid when terms share a description or a term carries
+	// several, so each child is read against the first track and the column gap, never against its
+	// neighbor.
+	it('keeps every term in the term column and every description in the description column', () => {
+		const host = scene.mount(
+			'<dl style="width: 520px"><dt>A</dt><dt>B</dt><dd>Shared</dd><dt>C</dt><dd>One</dd><dd>Two</dd></dl>',
+		)
+		const list = requireValue(host.querySelector('dl'), 'No dl specimen')
+		const left = list.getBoundingClientRect().left
+		const terms = [...list.querySelectorAll('dt')]
+		const descriptions = [...list.querySelectorAll('dd')]
+		expect(terms).toHaveLength(3)
+		expect(descriptions).toHaveLength(3)
+		// The 520px list splits 504px of track space one to two beside its 16px column gap.
+		expect(terms.map((term) => term.getBoundingClientRect().left - left)).toEqual([0, 0, 0])
+		expect(
+			descriptions.map((description) => description.getBoundingClientRect().left - left),
+		).toEqual([184, 184, 184])
+	})
+})
