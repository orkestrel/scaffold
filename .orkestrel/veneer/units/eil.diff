@@ -30,3 +30,27 @@ describe('figure calibrated treatment', () => {
 		).toBe(true)
 	})
 })
+
+describe('figure around an attributed quotation', () => {
+	// Bootstrap's footer pulls its start margin up by the quotation's end margin, so the footer
+	// starts where the quotation ends. The bare figure's column gap would move it off that edge, and
+	// the display reading shows the column layout never reached the figure.
+	it.each([
+		{ holder: 'a bare figure', attribute: '' },
+		{ holder: 'a centered figure', attribute: ' class="text-center"' },
+		{ holder: 'an end-aligned figure', attribute: ' class="text-end"' },
+	])('starts the footer at the quotation edge inside $holder', ({ attribute }) => {
+		const host = scene.mount(
+			`<figure${attribute}><blockquote class="blockquote"><p>Quoted words.</p></blockquote><figcaption class="blockquote-footer">Source</figcaption></figure>`,
+		)
+		const quotation = requireValue(host.querySelector('.blockquote'), 'No quotation')
+		const footer = requireValue(host.querySelector('.blockquote-footer'), 'No footer')
+		expect(footer.getBoundingClientRect().top).toBeCloseTo(
+			quotation.getBoundingClientRect().bottom,
+			1,
+		)
+		expect(readStyle(requireValue(host.querySelector('figure'), 'No figure'), 'display')).toBe(
+			'block',
+		)
+	})
+})
