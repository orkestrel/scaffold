+export interface LonghandRule {
+	/** Holds the selector of the rule. */
+	readonly selector: string
+	/** Holds each longhand property name the rule declares. */
+	readonly properties: readonly string[]
+	/** Holds each of those longhand property names the rule declares with `!important`. */
+	readonly important: readonly string[]
