+
+/**
+ * Collects, for each class name, the longhands the rules naming it declare.
+ *
+ * @param rules - The expanded rules to read, such as a compiled Tailwind instrument's.
+ * @param names - The class names to report, such as the shared names.
+ * @returns One entry per name, in the order the names are given, each holding the union of the
+ *   properties of every rule whose selector names that class, once each, in first-seen order. A
+ *   name no rule names holds an empty list.
+ *
+ * @remarks
+ * A selector names a class when {@link collectSelectorClasses} reads it there, so a rule for a
+ * compound or a descendant selector counts toward every class it writes.
+ */
+export function collectRuleLonghands(
+	rules: readonly LonghandRule[],
+	names: readonly string[],
+): ReadonlyMap<string, readonly string[]> {
+	const longhands = new Map<string, readonly string[]>()
+	for (const name of names) {
+		if (longhands.has(name)) continue
+		const properties: string[] = []
+		for (const rule of rules) {
+			if (!collectSelectorClasses(rule.selector).includes(name)) continue
+			for (const property of rule.properties) {
+				if (!properties.includes(property)) properties.push(property)
+			}
+		}
+		longhands.set(name, properties)
+	}
+	return longhands
+}
