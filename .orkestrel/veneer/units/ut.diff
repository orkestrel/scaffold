@@ -0,0 +1,209 @@
+import { requireValue } from '@orkestrel/test'
+import { matchesColor, parseCSSColor, readStyle, readToken } from '@orkestrel/test/browser'
+import { page } from 'vitest/browser'
+import { afterEach, describe, expect, it } from 'vitest'
+import { scene } from '../../../setupBrowser.js'
+import {
+	LINK_OFFSET_CASES,
+	LINK_OPACITY_CASES,
+	LINK_ROLES,
+	LINK_UNDERLINE_OPACITY_CASES,
+	TEXT_MODES,
+} from '../../../setupStyles.js'
+
+afterEach(() => {
+	scene.clear()
+})
+
+describe.each(TEXT_MODES)('link classes in %s mode', (mode) => {
+	it.each(LINK_ROLES)('reads the %s role channels at rest, hover, and focus', async (role) => {
+		const host = scene.mount(
+			`<div data-bs-theme="${mode}"><a href="#content" class="link-${role}">Role link</a></div>`,
+		)
+		const anchor = requireValue(host.querySelector('a'), 'No role link')
+		const color = `rgb(${readToken(anchor, `--vn-color-${role}-rgb`)})`
+		expect(matchesColor(readStyle(anchor, 'color'), color)).toBe(true)
+		expect(matchesColor(readStyle(anchor, 'text-decoration-color'), color)).toBe(true)
+		await page.elementLocator(anchor).hover()
+		expect(matchesColor(readStyle(anchor, 'color'), color)).toBe(true)
+		expect(matchesColor(readStyle(anchor, 'text-decoration-color'), color)).toBe(true)
+		await page.elementLocator(host).hover({ position: { x: 500, y: 0 } })
+		anchor.focus()
+		expect(anchor.matches(':hover')).toBe(false)
+		expect(anchor.matches(':focus')).toBe(true)
+		expect(matchesColor(readStyle(anchor, 'color'), color)).toBe(true)
+		expect(matchesColor(readStyle(anchor, 'text-decoration-color'), color)).toBe(true)
+		anchor.style.setProperty(`--vn-color-${role}-rgb`, '20, 80, 140')
+		anchor.style.setProperty('--bs-link-opacity', '0.5')
+		anchor.style.setProperty('--bs-link-underline-opacity', '0.25')
+		expect(readStyle(anchor, 'color')).toBe('rgba(20, 80, 140, 0.5)')
+		expect(readStyle(anchor, 'text-decoration-color')).toBe('rgba(20, 80, 140, 0.25)')
+	})
+
+	it('retains the emphasis fallback and lets explicit opacities override it', async () => {
+		const host = scene.mount(
+			`<div data-bs-theme="${mode}"><a href="#content" class="link-body-emphasis">Emphasis</a></div>`,
+		)
+		const anchor = requireValue(host.querySelector('a'), 'No emphasis link')
+		const channels = readToken(anchor, '--vn-text-emphasis-rgb')
+		expect(matchesColor(readStyle(anchor, 'color'), `rgb(${channels})`)).toBe(true)
+		await page.elementLocator(anchor).hover()
+		expect(matchesColor(readStyle(anchor, 'color'), `rgba(${channels}, 0.75)`)).toBe(true)
+		expect(
+			matchesColor(readStyle(anchor, 'text-decoration-color'), `rgba(${channels}, 0.75)`),
+		).toBe(true)
+		await page.elementLocator(host).hover({ position: { x: 500, y: 0 } })
+		anchor.focus()
+		expect(matchesColor(readStyle(anchor, 'color'), `rgba(${channels}, 0.75)`)).toBe(true)
+		anchor.classList.add('link-opacity-100', 'link-underline-opacity-50')
+		expect(matchesColor(readStyle(anchor, 'color'), `rgb(${channels})`)).toBe(true)
+		expect(matchesColor(readStyle(anchor, 'text-decoration-color'), `rgba(${channels}, 0.5)`)).toBe(
+			true,
+		)
+	})
+
+	it.each(LINK_OPACITY_CASES)(
+		'resolves opacity $step and activates its hover twin',
+		async ({ step, value }) => {
+			const host = scene.mount(
+				`<div data-bs-theme="${mode}"><a href="#content" class="link-opacity-${step}">Opacity</a></div>`,
+			)
+			const anchor = requireValue(host.querySelector('a'), 'No opacity link')
+			expect(Number(readToken(anchor, '--bs-link-opacity'))).toBe(value)
+			expect(requireValue(parseCSSColor(readStyle(anchor, 'color')), 'No color')[3]).toBe(value)
+			anchor.className = `link-opacity-${step}-hover`
+			expect(requireValue(parseCSSColor(readStyle(anchor, 'color')), 'No color')[3]).toBe(1)
+			await page.elementLocator(anchor).hover()
+			expect(Number(readToken(anchor, '--bs-link-opacity'))).toBe(value)
+			expect(requireValue(parseCSSColor(readStyle(anchor, 'color')), 'No color')[3]).toBe(value)
+		},
+	)
+
+	it.each(LINK_OFFSET_CASES)(
+		'resolves offset $step and activates its hover twin',
+		async ({ step, value }) => {
+			const host = scene.mount(
+				`<div data-bs-theme="${mode}"><a href="#content" class="link-offset-${step}" style="font-size:16px">Offset</a></div>`,
+			)
+			const anchor = requireValue(host.querySelector('a'), 'No offset link')
+			expect(readStyle(anchor, 'text-underline-offset')).toBe(value)
+			anchor.className = `link-offset-${step}-hover`
+			expect(readStyle(anchor, 'text-underline-offset')).toBe('auto')
+			await page.elementLocator(anchor).hover()
+			expect(readStyle(anchor, 'text-underline-offset')).toBe(value)
+		},
+	)
+
+	it.each(LINK_ROLES)(
+		'paints the %s underline independently of text and reads its opacity',
+		(role) => {
+			const host = scene.mount(
+				`<div data-bs-theme="${mode}"><a href="#content" class="link-underline-${role}">Underline</a></div>`,
+			)
+			const anchor = requireValue(host.querySelector('a'), 'No underline link')
+			expect(readToken(anchor, '--bs-link-underline-opacity')).toBe('1')
+			expect(
+				matchesColor(
+					readStyle(anchor, 'text-decoration-color'),
+					`rgb(${readToken(anchor, `--vn-color-${role}-rgb`)})`,
+				),
+			).toBe(true)
+			const color = readStyle(anchor, 'color')
+			anchor.style.setProperty(`--vn-color-${role}-rgb`, '20, 80, 140')
+			anchor.classList.add('link-underline-opacity-25')
+			expect(readStyle(anchor, 'text-decoration-color')).toBe('rgba(20, 80, 140, 0.25)')
+			expect(readStyle(anchor, 'color')).toBe(color)
+		},
+	)
+
+	it.each(LINK_UNDERLINE_OPACITY_CASES)(
+		'resolves underline opacity $step and activates its hover twin',
+		async ({ step, value }) => {
+			const host = scene.mount(
+				`<div data-bs-theme="${mode}"><a href="#content" class="link-underline link-underline-opacity-${step}">Underline opacity</a></div>`,
+			)
+			const anchor = requireValue(host.querySelector('a'), 'No underline opacity link')
+			expect(Number(readToken(anchor, '--bs-link-underline-opacity'))).toBe(value)
+			expect(
+				matchesColor(
+					readStyle(anchor, 'text-decoration-color'),
+					`rgba(${readToken(anchor, '--vn-link-rgb')}, ${String(value)})`,
+				),
+			).toBe(true)
+			anchor.className = `link-underline link-underline-opacity-${step}-hover`
+			expect(readToken(anchor, '--bs-link-underline-opacity')).toBe('1')
+			expect(
+				requireValue(
+					parseCSSColor(readStyle(anchor, 'text-decoration-color')),
+					'No underline color',
+				)[3],
+			).toBe(1)
+			await page.elementLocator(anchor).hover()
+			expect(Number(readToken(anchor, '--bs-link-underline-opacity'))).toBe(value)
+			expect(
+				requireValue(
+					parseCSSColor(readStyle(anchor, 'text-decoration-color')),
+					'No underline color',
+				)[3],
+			).toBeCloseTo(value, 2)
+		},
+	)
+})
+
+describe('link classes in the utilities layer', () => {
+	it('yields a colored link to a text color on the same element, as the release does', () => {
+		const host = scene.mount(
+			'<a href="#content" class="link-primary text-danger">Colored and danger</a><span class="text-danger">Danger</span>',
+		)
+		const link = requireValue(host.querySelector('.link-primary'), 'No colored link')
+		const text = requireValue(host.querySelector('span.text-danger'), 'No text color')
+		// The helper heads the utilities layer, so the text color written later in that layer wins
+		// the one property both set.
+		expect(readStyle(link, 'color')).toBe(readStyle(text, 'color'))
+		expect(
+			matchesColor(
+				readStyle(link, 'text-decoration-color'),
+				`rgb(${readToken(link, '--vn-color-primary-rgb')})`,
+			),
+		).toBe(true)
+	})
+
+	it('keeps an underline color class over a text decoration utility on the same element, as the release does', () => {
+		const host = scene.mount(
+			'<span class="text-decoration-underline link-underline-danger">Underlined</span>',
+		)
+		const element = requireValue(host.querySelector('span'), 'No underlined element')
+		// The decoration utility's shorthand resets the underline color to the text color, and the
+		// underline entry follows it in the release's map, so the underline class wins the color.
+		expect(readStyle(element, 'text-decoration-line')).toBe('underline')
+		expect(
+			matchesColor(
+				readStyle(element, 'text-decoration-color'),
+				`rgb(${readToken(element, '--vn-color-danger-rgb')})`,
+			),
+		).toBe(true)
+		expect(readStyle(element, 'text-decoration-color')).not.toBe(readStyle(element, 'color'))
+	})
+
+	it('keeps its priority over a later unlayered consumer rule', () => {
+		const host = scene.mount(
+			'<a href="#content" class="probe link-success link-offset-2" style="font-size: 16px">Link</a><a href="#content" class="probe">Consumer</a>',
+		)
+		scene.load('.probe { color: rgb(1, 2, 3); text-underline-offset: 9px }')
+		const link = requireValue(host.querySelector('.link-success'), 'No link')
+		const consumer = requireValue(host.lastElementChild, 'No consumer link')
+		expect(readStyle(consumer, 'color')).toBe('rgb(1, 2, 3)')
+		expect(readStyle(link, 'color')).not.toBe('rgb(1, 2, 3)')
+		expect(readStyle(link, 'text-underline-offset')).toBe('4px')
+	})
+
+	it('yields to an important override inside the utilities layer and to no unlayered one', () => {
+		const host = scene.mount('<a href="#content" class="link-success">Link</a>')
+		const link = requireValue(host.querySelector('.link-success'), 'No link')
+		const resting = readStyle(link, 'color')
+		scene.load('.link-success { color: rgb(1, 2, 3) !important }')
+		expect(readStyle(link, 'color')).toBe(resting)
+		scene.load('@layer utilities { .link-success { color: rgb(1, 2, 3) !important } }')
+		expect(readStyle(link, 'color')).toBe('rgb(1, 2, 3)')
+	})
+})
diff --git a/tests/src/styles/utilities/text.test.ts b/tests/src/styles/utilities/text.test.ts
