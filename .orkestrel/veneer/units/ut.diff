+++ b/tests/src/styles/utilities/text.test.ts
@@ -0,0 +1,189 @@
+import { TOKEN_NAMES } from '@src/core'
+import { requireValue } from '@orkestrel/test'
+import { readStyle } from '@orkestrel/test/browser'
+import { afterEach, describe, expect, it } from 'vitest'
+import { scene, visitBreakpoint } from '../../../setupBrowser.js'
+import { GRID_BREAKPOINT_CASES, TEXT_ALIGN_CASES, TEXT_ENTRY_CASES } from '../../../setupStyles.js'
+
+// Every aligned element rests on an inline `justify` alignment, a value no class writes, so a
+// reading of any recorded value can only come from the class.
+const RESTING_ALIGN = 'justify'
+
+// A sentence long enough to overflow the constrained boxes the layout cases draw, and a word with no
+// break opportunity inside it.
+const SENTENCE =
+	'The parcel leaves the Harbor Street depot at eight and reaches most addresses before noon.'
+const WORD = 'Pneumonoultramicroscopicsilicovolcanoconiosis'
+
+afterEach(() => {
+	scene.clear()
+})
+
+describe('text utilities', () => {
+	it.each(GRID_BREAKPOINT_CASES)(
+		'aligns with every value around the $name boundary',
+		async ({ name, boundary, readings }) => {
+			const infix = boundary === 0 ? '' : `-${name}`
+			const host = scene.mount(
+				TEXT_ALIGN_CASES.map(
+					({ key }) =>
+						`<p class="text${infix}-${key}" style="text-align: ${RESTING_ALIGN}">Aligned</p>`,
+				).join(''),
+			)
+			for (const viewport of readings) {
+				await visitBreakpoint(viewport, () => {
+					expect(window.innerWidth).toBe(viewport)
+					for (const { key, value } of TEXT_ALIGN_CASES) {
+						const element = requireValue(
+							host.querySelector(`.text${infix}-${key}`),
+							`No text${infix}-${key} element`,
+						)
+						expect(readStyle(element, 'text-align')).toBe(
+							viewport >= boundary ? value : RESTING_ALIGN,
+						)
+					}
+				})
+			}
+		},
+	)
+
+	it('resolves a wider alignment infix over a narrower one whatever order the classes are written in', async () => {
+		const host = scene.mount(
+			'<p class="text-md-start text-sm-center">Medium start</p><p class="text-lg-end text-center">Large end</p>',
+		)
+		const medium = requireValue(host.querySelector('.text-md-start'), 'No medium element')
+		const large = requireValue(host.querySelector('.text-lg-end'), 'No large element')
+		const readings: Array<readonly string[]> = []
+		for (const viewport of [767, 768, 991, 992])
+			readings.push(
+				await visitBreakpoint(viewport, () => [
+					readStyle(medium, 'text-align'),
+					readStyle(large, 'text-align'),
+				]),
+			)
+		expect(readings).toEqual([
+			['center', 'center'],
+			['left', 'center'],
+			['left', 'center'],
+			['left', 'right'],
+		])
+	})
+
+	it('aligns to the physical side it names in a right-to-left scope', () => {
+		const host = scene.mount(
+			'<div dir="rtl"><p class="text-start">Start</p><p class="text-end">End</p></div>',
+		)
+		const start = requireValue(host.querySelector('.text-start'), 'No start element')
+		const end = requireValue(host.querySelector('.text-end'), 'No end element')
+		expect([readStyle(start, 'text-align'), readStyle(end, 'text-align')]).toEqual([
+			'left',
+			'right',
+		])
+	})
+
+	it('resolves every decoration, transform, wrapping, and break value over a resting value no class writes', () => {
+		for (const { prefix, readings, resting, values } of TEXT_ENTRY_CASES) {
+			const host = scene.mount(
+				values
+					.map(({ key }) => `<p class="${prefix}-${key}" style="${resting}">Recorded</p>`)
+					.join(''),
+			)
+			for (const { key, value } of values) {
+				const element = requireValue(
+					host.querySelector(`.${prefix}-${key}`),
+					`No ${prefix}-${key} element`,
+				)
+				expect(readings.map((property) => readStyle(element, property))).toEqual(
+					readings.map(() => value),
+				)
+			}
+		}
+	})
+
+	it('keeps a sentence on one line, wraps it again, and breaks a long word inside a constrained box', () => {
+		const host = scene.mount(
+			[
+				`<div style="width: 120px"><p class="nowrap text-nowrap">${SENTENCE}</p></div>`,
+				`<div class="text-nowrap" style="width: 120px"><p class="wrap text-wrap">${SENTENCE}</p><p class="inherited">${SENTENCE}</p></div>`,
+				`<div style="width: 80px"><p class="broken text-break">${WORD}</p><p class="whole">${WORD}</p></div>`,
+			].join(''),
+		)
+		const nowrap = requireValue(host.querySelector<HTMLElement>('.nowrap'), 'No nowrap box')
+		const wrap = requireValue(host.querySelector<HTMLElement>('.wrap'), 'No wrap box')
+		const inherited = requireValue(
+			host.querySelector<HTMLElement>('.inherited'),
+			'No inherited box',
+		)
+		const broken = requireValue(host.querySelector<HTMLElement>('.broken'), 'No broken box')
+		const whole = requireValue(host.querySelector<HTMLElement>('.whole'), 'No whole box')
+		// The unwrapped sentence overflows its box on one line; the wrapped one fits the same width
+		// across several lines, while its unclassed sibling inherits the box's `nowrap` value and
+		// overflows.
+		expect(nowrap.scrollWidth).toBeGreaterThan(nowrap.clientWidth)
+		expect(wrap.scrollWidth).toBeLessThanOrEqual(wrap.clientWidth)
+		expect(wrap.getBoundingClientRect().height).toBeGreaterThan(
+			nowrap.getBoundingClientRect().height,
+		)
+		expect(inherited.scrollWidth).toBeGreaterThan(inherited.clientWidth)
+		expect(broken.scrollWidth).toBeLessThanOrEqual(broken.clientWidth)
+		expect(whole.scrollWidth).toBeGreaterThan(whole.clientWidth)
+	})
+
+	it('writes the later value of one entry over an earlier one on the same element', () => {
+		const host = scene.mount(
+			'<p class="text-nowrap text-wrap">Space</p><p class="text-capitalize text-lowercase">Transform</p><p class="text-decoration-line-through text-decoration-none">Decoration</p>',
+		)
+		const [space, transform, decoration] = [...host.children]
+		expect([
+			readStyle(requireValue(space, 'No space element'), 'white-space'),
+			readStyle(requireValue(transform, 'No transform element'), 'text-transform'),
+			readStyle(requireValue(decoration, 'No decoration element'), 'text-decoration-line'),
+		]).toEqual(['nowrap', 'capitalize', 'line-through'])
+	})
+
+	it('reads no token or mode, so a dark island and a doubled density factor leave every value', () => {
+		const host = scene.mount(
+			'<div data-bs-theme="dark"><p class="text-center text-uppercase text-nowrap">Island</p></div>',
+		)
+		const element = requireValue(host.querySelector('p'), 'No island element')
+		const properties = ['text-align', 'text-transform', 'white-space']
+		expect(properties.map((property) => readStyle(element, property))).toEqual([
+			'center',
+			'uppercase',
+			'nowrap',
+		])
+		document.documentElement.style.setProperty(TOKEN_NAMES.factor.density, '2')
+		try {
+			expect(properties.map((property) => readStyle(element, property))).toEqual([
+				'center',
+				'uppercase',
+				'nowrap',
+			])
+		} finally {
+			document.documentElement.style.removeProperty(TOKEN_NAMES.factor.density)
+		}
+	})
+
+	it('keeps its priority over a later unlayered consumer rule', () => {
+		const host = scene.mount(
+			'<p class="probe text-center">Utility</p><p class="probe">Consumer</p>',
+		)
+		scene.load('.probe { text-align: right }')
+		const utility = requireValue(host.querySelector('.text-center'), 'No utility element')
+		const consumer = requireValue(host.lastElementChild, 'No consumer element')
+		expect(readStyle(consumer, 'text-align')).toBe('right')
+		expect(readStyle(utility, 'text-align')).toBe('center')
+	})
+
+	it('yields to an important override inside the utilities layer and to no unlayered one', () => {
+		const host = scene.mount('<p class="text-center">Utility</p>')
+		const element = requireValue(host.querySelector('.text-center'), 'No utility element')
+		// An unlayered `!important` declaration sorts after every layered one, so the shipped utility
+		// keeps its value; the same declaration re-opened inside the utilities layer arrives after the
+		// shipped rule in that layer and wins.
+		scene.load('.text-center { text-align: right !important }')
+		expect(readStyle(element, 'text-align')).toBe('center')
+		scene.load('@layer utilities { .text-center { text-align: justify !important } }')
+		expect(readStyle(element, 'text-align')).toBe('justify')
+	})
+})
