@@ -0,0 +1,22 @@
+import { COLOR_COPY, COLOR_SPECIMENS } from '../constants.js'
+import { SpecimenSection } from './SpecimenSection.js'
+
+/**
+ * Renders the declared text color, emphasis, body tier, opacity, reset, and color-and-background
+ * specimens into a named Color region.
+ *
+ * @example
+ * ```ts
+ * const section = new ColorSection(document.body)
+ * section.destroy()
+ * ```
+ */
+export class ColorSection extends SpecimenSection {
+	/**
+	 * Mounts the Color region and its specimens in table order.
+	 * @param host - The element receiving the section.
+	 */
+	constructor(host: HTMLElement) {
+		super(host, COLOR_COPY, COLOR_SPECIMENS)
+	}
+}
