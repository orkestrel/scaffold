+import { TEXT_COPY, TEXT_SPECIMENS } from '../constants.js'
+import { SpecimenSection } from './SpecimenSection.js'
+
+/**
+ * Renders the declared text alignment, wrapping, break, transform, decoration, and truncation
+ * specimens into a named Text region.
+ *
+ * @example
+ * ```ts
+ * const section = new TextSection(document.body)
+ * section.destroy()
+ * ```
+ */
+export class TextSection extends SpecimenSection {
+	/**
+	 * Mounts the Text region and its specimens in table order.
+	 * @param host - The element receiving the section.
+	 */
+	constructor(host: HTMLElement) {
+		super(host, TEXT_COPY, TEXT_SPECIMENS)
+	}
+}
diff --git a/src/styles/components/_text-truncation.scss b/src/styles/components/_text-truncation.scss
new file mode 100644
index 0000000..acbc391
--- /dev/null
+++ b/src/styles/components/_text-truncation.scss
@@ -0,0 +1,10 @@
+@layer components {
+	// The release writes the truncation helper as normal declarations, so an important white-space
+	// utility on the same element overrides the helper's `nowrap` value, and so does a rule of your
+	// own.
+	.text-truncate {
+		overflow: hidden;
+		text-overflow: ellipsis;
+		white-space: nowrap;
+	}
+}
diff --git a/src/styles/utilities/_color.scss b/src/styles/utilities/_color.scss
new file mode 100644
index 0000000..2bca1a0
--- /dev/null
+++ b/src/styles/utilities/_color.scss
@@ -0,0 +1,143 @@
+@use 'sass:list';
+@use 'sass:map';
+@use '../tokens' as *;
+@use '../mixins' as *;
+
+@layer utilities {
+	// The release writes the color-and-background pairs with the `!important` flag on both
+	// declarations, and its helpers load ahead of its utilities, so the pairs head this partial: a
+	// text color or a background utility on the same element still wins, as it does in the release.
+	// No entry the release's map writes ahead of the `color` entry sets a color or a background, so
+	// the pairs resolve here exactly as they would ahead of every utility partial. Each foreground is
+	// the one the release records for its role, read from the palette, because the release's
+	// `color-contrast` function chose it against the release's own fills.
+	$dark-labels: info, warning, light;
+	@each $role in $aliased {
+		$foreground: 'white';
+		@if list.index($dark-labels, $role) {
+			$foreground: 'black';
+		}
+		.text-bg-#{$role} {
+			color: var(--vn-palette-#{$foreground}-base) !important;
+			background-color: RGBA(var(--bs-#{$role}-rgb), var(--bs-bg-opacity, 1)) !important;
+		}
+	}
+
+	// Stand in for the release's text color maps. A role, black, white, and the body read the
+	// release's `--bs-*` channel aliases at the `--bs-text-opacity` variable the entry sets; the
+	// release's half-strength black and white literals read the palette's channels instead.
+	$colors: ();
+	@each $name in list.join($aliased, ('black', 'white')) {
+		$colors: map.set($colors, $name, rgba(var(--bs-#{$name}-rgb), var(--bs-text-opacity)));
+	}
+	$colors: map.merge(
+		$colors,
+		(
+			body: rgba(var(--bs-body-color-rgb), var(--bs-text-opacity)),
+			muted: var(--bs-secondary-color),
+			black-50: rgba(var(--vn-palette-black-rgb), 0.5),
+			white-50: rgba(var(--vn-palette-white-rgb), 0.5),
+			body-secondary: var(--bs-secondary-color),
+			body-tertiary: var(--bs-tertiary-color),
+			body-emphasis: var(--bs-emphasis-color),
+			reset: inherit,
+		)
+	);
+	$emphases: ();
+	@each $role in $aliased {
+		$emphases: map.set($emphases, '#{$role}-emphasis', var(--bs-#{$role}-text-emphasis));
+	}
+	$underlines: ();
+	@each $role in $aliased {
+		$underlines: map.set(
+			$underlines,
+			$role,
+			rgba(var(--vn-color-#{$role}-rgb), var(--bs-link-underline-opacity))
+		);
+	}
+	$underlines: map.set(
+		$underlines,
+		null,
+		rgba(var(--vn-link-rgb), var(--bs-link-underline-opacity, 1))
+	);
+
+	// The color and link entries of the release's utility map, in its order. None is responsive, so
+	// the walk writes every one at the empty infix alone. An opacity entry writes a custom property,
+	// which the `utility-variable` mixin writes at no infix, so the walk writes it at the empty infix
+	// as the `utility` mixin gates its own entries. The link entries follow the text colors here
+	// because the release's map writes them there: a text-decoration utility sets the underline
+	// color through its shorthand, and an underline class written later still wins over it.
+	@include breakpoint-each using ($infix, $_boundary) {
+		@include utility(
+			text,
+			color,
+			$colors,
+			$infix,
+			$locals: (
+				text-opacity: 1,
+			)
+		);
+		@if $infix == '' {
+			@include utility-variable(
+				text-opacity,
+				text-opacity,
+				(
+					25: 0.25,
+					50: 0.5,
+					75: 0.75,
+					100: 1,
+				)
+			);
+		}
+		@include utility(text, color, $emphases, $infix);
+		@if $infix == '' {
+			@include utility-variable(
+				link-opacity,
+				link-opacity,
+				(
+					10: 0.1,
+					25: 0.25,
+					50: 0.5,
+					75: 0.75,
+					100: 1,
+				),
+				$state: (hover)
+			);
+		}
+		@include utility(
+			link-offset,
+			text-underline-offset,
+			(
+				1: 0.125em,
+				2: 0.25em,
+				3: 0.375em,
+			),
+			$infix,
+			$state: (hover)
+		);
+		@include utility(
+			link-underline,
+			text-decoration-color,
+			$underlines,
+			$infix,
+			$locals: (
+				link-underline-opacity: 1,
+			)
+		);
+		@if $infix == '' {
+			@include utility-variable(
+				link-underline-opacity,
+				link-underline-opacity,
+				(
+					0: 0,
+					10: 0.1,
+					25: 0.25,
+					50: 0.5,
+					75: 0.75,
+					100: 1,
+				),
+				$state: (hover)
+			);
+		}
+	}
+}
diff --git a/src/styles/utilities/_link.scss b/src/styles/utilities/_link.scss
new file mode 100644
index 0000000..682338e
--- /dev/null
+++ b/src/styles/utilities/_link.scss
@@ -0,0 +1,38 @@
+@use '../tokens' as *;
+
+@layer utilities {
+	// The release writes the colored-link helper with the `!important` flag on every declaration, so
+	// it heads the utilities layer: an important declaration in an earlier layer beats one in a later
+	// layer, and in the components layer this rule would beat the text colors the release lets win
+	// over it, such as the `.text-danger` class. It is a helper rather than a utility entry, and each
+	// declaration carries its own value, so it is written here rather than through the `utility`
+	// mixin. The link key's utility entries are map entries, so the `_color.scss` partial writes them
+	// where the release's map does, after the text colors.
+	@each $role in $aliased {
+		.link-#{$role},
+		.link-#{$role}:hover,
+		.link-#{$role}:focus {
+			color: rgba(var(--vn-color-#{$role}-rgb), var(--bs-link-opacity, 1)) !important;
+			text-decoration-color: rgba(
+				var(--vn-color-#{$role}-rgb),
+				var(--bs-link-underline-opacity, 1)
+			) !important;
+		}
+	}
+
+	.link-body-emphasis {
+		color: rgba(var(--vn-text-emphasis-rgb), var(--bs-link-opacity, 1)) !important;
+		text-decoration-color: rgba(
+			var(--vn-text-emphasis-rgb),
+			var(--bs-link-underline-opacity, 1)
+		) !important;
+		&:hover,
+		&:focus {
+			color: rgba(var(--vn-text-emphasis-rgb), var(--bs-link-opacity, 0.75)) !important;
+			text-decoration-color: rgba(
+				var(--vn-text-emphasis-rgb),
+				var(--bs-link-underline-opacity, 0.75)
+			) !important;
+		}
+	}
+}
diff --git a/src/styles/utilities/_text.scss b/src/styles/utilities/_text.scss
new file mode 100644
index 0000000..a07319b
--- /dev/null
+++ b/src/styles/utilities/_text.scss
@@ -0,0 +1,41 @@
+@use '../mixins' as *;
+
+@layer utilities {
+	// The text entries of the release's utility map, in its order. Only the alignment entry is
+	// responsive, so the walk writes the other entries at the empty infix alone, ahead of every media
+	// block. The release writes each alignment as the physical side it names in a left-to-right
+	// document, and the break entry sets the legacy `word-wrap` property beside the `word-break`
+	// property, as the release does.
+	@include breakpoint-each using ($infix, $_boundary) {
+		@include utility(
+			text,
+			text-align,
+			(
+				start: left,
+				end: right,
+				center: center,
+			),
+			$infix,
+			true
+		);
+		@include utility(text-decoration, text-decoration, (none, underline, line-through), $infix);
+		@include utility(text, text-transform, (lowercase, uppercase, capitalize), $infix);
+		@include utility(
+			text,
+			white-space,
+			(
+				wrap: normal,
+				nowrap: nowrap,
+			),
+			$infix
+		);
+		@include utility(
+			text,
+			(word-wrap, word-break),
+			(
+				break: break-word,
+			),
+			$infix
+		);
+	}
+}
