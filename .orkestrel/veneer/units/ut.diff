+import type { SectionInterface } from '@app/browser'
+import { COLOR_COPY, COLOR_SPECIMENS, ColorSection, SpecimenSection } from '@app/browser'
+import { requireValue } from '@orkestrel/test'
+import { build, mount, parseCSSColor, readStyle } from '@orkestrel/test/browser'
+import { beforeAll, describe, expect, it } from 'vitest'
+import { LINK_ROLES, TEXT_OPACITY_CASES } from '../../../setupStyles.js'
+
+// The paint cases read the specimens as the published cascade paints them, so the cascade has to be
+// in the document before a color is read.
+beforeAll(async () => {
+	await import('../../../../src/styles/index.scss')
+	await import('../../../../app/browser/styles/index.scss')
+})
+
+describe('ColorSection', () => {
+	it('renders every declared specimen through the shared section contract', () => {
+		const host = mount(build('div'))
+		const section: SectionInterface = new ColorSection(host)
+		try {
+			expect(section).toBeInstanceOf(SpecimenSection)
+			expect(section.host).toBe(host)
+			const region = requireValue(host.querySelector('section'), 'No Color region')
+			expect(region.querySelector('[style]')).toBeNull()
+			expect(region.getAttribute('aria-label')).toBe('Color')
+			expect(region.querySelector('p')?.textContent).toBe(COLOR_COPY.paragraph)
+			const rendered = [...region.querySelectorAll('[data-specimen]')]
+			expect(rendered.map((element) => element.getAttribute('data-specimen'))).toEqual([
+				'Text roles',
+				'Text emphasis',
+				'Body text tiers',
+				'Text opacity',
+				'Text reset',
+				'Color and background pairs',
+			])
+			expect(rendered.map((element) => element.innerHTML)).toEqual(
+				COLOR_SPECIMENS.map((specimen) => specimen.markup),
+			)
+			for (const role of LINK_ROLES) {
+				expect(region.querySelector(`[data-specimen="Text roles"] .text-${role}`)).not.toBeNull()
+				expect(
+					region.querySelector(`[data-specimen="Text emphasis"] .text-${role}-emphasis`),
+				).not.toBeNull()
+				expect(
+					region.querySelector(
+						`[data-specimen="Color and background pairs"] .badge.text-bg-${role}`,
+					),
+				).not.toBeNull()
+			}
+			for (const { step } of TEXT_OPACITY_CASES)
+				expect(
+					region.querySelector(
+						`[data-specimen="Text opacity"] .text-primary.text-opacity-${String(step)}`,
+					),
+				).not.toBeNull()
+			// A color meant for a dark or a light surface sits on the pair that paints one.
+			expect(
+				region.querySelector('[data-specimen="Text roles"] .text-bg-dark > .text-light'),
+			).not.toBeNull()
+			expect(
+				region.querySelector(
+					'[data-specimen="Body text tiers"] .text-bg-dark > .text-white + .text-white-50',
+				),
+			).not.toBeNull()
+			expect(
+				region.querySelector(
+					'[data-specimen="Body text tiers"] .text-bg-light > .text-black + .text-black-50',
+				),
+			).not.toBeNull()
+			expect(
+				region.querySelector(
+					'[data-specimen="Text reset"] .text-danger > a:not([class]) + a.text-reset',
+				),
+			).not.toBeNull()
+			expect(Object.isFrozen(COLOR_COPY)).toBe(true)
+			expect(Object.isFrozen(COLOR_SPECIMENS)).toBe(true)
+			expect(COLOR_SPECIMENS.every((specimen) => Object.isFrozen(specimen))).toBe(true)
+		} finally {
+			section.destroy()
+			host.remove()
+		}
+	})
+
+	it('paints each pair badge on an opaque fill, and the reset link in its line color', () => {
+		const host = mount(build('div'))
+		const section: SectionInterface = new ColorSection(host)
+		try {
+			const region = requireValue(host.querySelector('section'), 'No Color region')
+			for (const role of LINK_ROLES) {
+				const badge = requireValue(
+					region.querySelector(`.badge.text-bg-${role}`),
+					`No ${role} badge`,
+				)
+				expect(
+					requireValue(parseCSSColor(readStyle(badge, 'background-color')), 'No fill')[3],
+				).toBe(1)
+				expect(readStyle(badge, 'color')).not.toBe(readStyle(badge, 'background-color'))
+			}
+			const line = requireValue(region.querySelector('[data-specimen="Text reset"] p'), 'No line')
+			const plain = requireValue(line.querySelector('a:not([class])'), 'No plain link')
+			const reset = requireValue(line.querySelector('.text-reset'), 'No reset link')
+			expect(readStyle(reset, 'color')).toBe(readStyle(line, 'color'))
+			expect(readStyle(plain, 'color')).not.toBe(readStyle(line, 'color'))
+		} finally {
+			section.destroy()
+			host.remove()
+		}
+	})
+
+	it('releases its region and preserves neighboring content through repeated destruction', () => {
+		const host = mount(build('div'))
+		const neighbor = build('p', { text: 'Existing content' })
+		host.append(neighbor)
+		const section: SectionInterface = new ColorSection(host)
+		try {
+			const region = requireValue(host.querySelector('section'), 'No Color region')
+			expect(region.isConnected).toBe(true)
+			section.destroy()
+			expect(region.isConnected).toBe(false)
+			section.destroy()
+			expect([...host.children]).toEqual([neighbor])
+		} finally {
+			section.destroy()
+			host.remove()
+		}
+	})
+})
diff --git a/tests/app/browser/sections/TextSection.test.ts b/tests/app/browser/sections/TextSection.test.ts
