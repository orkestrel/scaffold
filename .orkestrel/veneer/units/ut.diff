+++ b/tests/app/browser/sections/TextSection.test.ts
@@ -0,0 +1,154 @@
+import type { SectionInterface } from '@app/browser'
+import { SpecimenSection, TEXT_COPY, TEXT_SPECIMENS, TextSection } from '@app/browser'
+import { requireValue } from '@orkestrel/test'
+import { build, mount, readStyle } from '@orkestrel/test/browser'
+import { beforeAll, describe, expect, it } from 'vitest'
+import { visitBreakpoint } from '../../../setupBrowser.js'
+import { TEXT_ALIGN_CASES, TEXT_ENTRY_CASES } from '../../../setupStyles.js'
+
+// The layout cases read the specimens as the published cascade lays them out, so the cascade has to
+// be in the document before a box is measured.
+beforeAll(async () => {
+	await import('../../../../src/styles/index.scss')
+	await import('../../../../app/browser/styles/index.scss')
+})
+
+describe('TextSection', () => {
+	it('renders every declared specimen through the shared section contract', () => {
+		const host = mount(build('div'))
+		const section: SectionInterface = new TextSection(host)
+		try {
+			expect(section).toBeInstanceOf(SpecimenSection)
+			expect(section.host).toBe(host)
+			const region = requireValue(host.querySelector('section'), 'No Text region')
+			expect(region.querySelector('[style]')).toBeNull()
+			expect(region.getAttribute('aria-label')).toBe('Text')
+			expect(region.querySelector('p')?.textContent).toBe(TEXT_COPY.paragraph)
+			const rendered = [...region.querySelectorAll('[data-specimen]')]
+			expect(rendered.map((element) => element.getAttribute('data-specimen'))).toEqual([
+				'Text alignment',
+				'Responsive text alignment',
+				'Wrapping',
+				'Word break',
+				'Text transform',
+				'Text decoration',
+				'Truncated text',
+			])
+			expect(rendered.map((element) => element.innerHTML)).toEqual(
+				TEXT_SPECIMENS.map((specimen) => specimen.markup),
+			)
+			for (const { key } of TEXT_ALIGN_CASES)
+				expect(region.querySelector(`[data-specimen="Text alignment"] .text-${key}`)).not.toBeNull()
+			for (const { prefix, values } of TEXT_ENTRY_CASES)
+				for (const { key } of values)
+					expect(region.querySelector(`.${prefix}-${key}`)).not.toBeNull()
+			expect(
+				region.querySelector('[data-specimen="Truncated text"] .row > .col-4.text-truncate'),
+			).not.toBeNull()
+			expect(
+				region.querySelector('[data-specimen="Wrapping"] .row > .col-2.text-nowrap > .text-wrap'),
+			).not.toBeNull()
+			expect(
+				region.querySelector('[data-specimen="Word break"] .row > .col-2 > .text-break'),
+			).not.toBeNull()
+			expect(
+				region.querySelector('[data-specimen="Text decoration"] a.text-decoration-none[href]'),
+			).not.toBeNull()
+			expect(Object.isFrozen(TEXT_COPY)).toBe(true)
+			expect(Object.isFrozen(TEXT_SPECIMENS)).toBe(true)
+			expect(TEXT_SPECIMENS.every((specimen) => Object.isFrozen(specimen))).toBe(true)
+		} finally {
+			section.destroy()
+			host.remove()
+		}
+	})
+
+	it('moves the responsive alignment at its boundaries between the journey widths', async () => {
+		const host = mount(build('div'))
+		const section: SectionInterface = new TextSection(host)
+		try {
+			const specimen = requireValue(
+				host.querySelector('[data-specimen="Responsive text alignment"]'),
+				'No responsive specimen',
+			)
+			const medium = requireValue(specimen.querySelector('.text-md-start'), 'No medium line')
+			const large = requireValue(specimen.querySelector('.text-lg-end'), 'No large line')
+			const narrow = await visitBreakpoint(390, () => [
+				readStyle(medium, 'text-align'),
+				readStyle(large, 'text-align'),
+			])
+			const wide = await visitBreakpoint(1280, () => [
+				readStyle(medium, 'text-align'),
+				readStyle(large, 'text-align'),
+			])
+			expect([narrow, wide]).toEqual([
+				['center', 'left'],
+				['left', 'right'],
+			])
+		} finally {
+			section.destroy()
+			host.remove()
+		}
+	})
+
+	it('runs each constrained line against its column edge at both journey widths, inside the page', async () => {
+		const host = mount(build('div'))
+		const section: SectionInterface = new TextSection(host)
+		try {
+			const region = requireValue(host.querySelector('section'), 'No Text region')
+			const unwrapped = requireValue(
+				region.querySelector<HTMLElement>('[data-specimen="Wrapping"] p.text-nowrap'),
+				'No unwrapped line',
+			)
+			const wrapped = requireValue(
+				region.querySelector<HTMLElement>('[data-specimen="Wrapping"] .text-wrap'),
+				'No wrapped line',
+			)
+			const broken = requireValue(
+				region.querySelector<HTMLElement>('[data-specimen="Word break"] .text-break'),
+				'No broken word',
+			)
+			const truncated = requireValue(
+				region.querySelector<HTMLElement>('[data-specimen="Truncated text"] .text-truncate'),
+				'No truncated line',
+			)
+			for (const width of [390, 1280]) {
+				const reading = await visitBreakpoint(width, () => ({
+					unwrapped: unwrapped.scrollWidth > unwrapped.clientWidth,
+					wrapped: wrapped.scrollWidth <= wrapped.clientWidth,
+					broken: broken.scrollWidth <= broken.clientWidth,
+					truncated: truncated.scrollWidth > truncated.clientWidth,
+					inside: unwrapped.getBoundingClientRect().left + unwrapped.scrollWidth <= width,
+				}))
+				expect(reading).toEqual({
+					unwrapped: true,
+					wrapped: true,
+					broken: true,
+					truncated: true,
+					inside: true,
+				})
+			}
+		} finally {
+			section.destroy()
+			host.remove()
+		}
+	})
+
+	it('releases its region and preserves neighboring content through repeated destruction', () => {
+		const host = mount(build('div'))
+		const neighbor = build('p', { text: 'Existing content' })
+		host.append(neighbor)
+		const section: SectionInterface = new TextSection(host)
+		try {
+			const region = requireValue(host.querySelector('section'), 'No Text region')
+			expect(region.isConnected).toBe(true)
+			section.destroy()
+			expect(region.isConnected).toBe(false)
+			section.destroy()
+			expect([...host.children]).toEqual([neighbor])
+		} finally {
+			section.destroy()
+			host.remove()
+		}
+	})
+})
diff --git a/tests/src/styles/components/text-truncation.test.ts b/tests/src/styles/components/text-truncation.test.ts
