+++ b/tests/src/styles/components/text-truncation.test.ts
@@ -0,0 +1,84 @@
+import { TOKEN_NAMES } from '@src/core'
+import { requireValue } from '@orkestrel/test'
+import { readStyle } from '@orkestrel/test/browser'
+import { afterEach, describe, expect, it } from 'vitest'
+import { scene } from '../../../setupBrowser.js'
+
+// A sentence long enough to overflow the constrained box the cases draw.
+const SENTENCE =
+	'The parcel leaves the Harbor Street depot at eight and reaches most addresses before noon.'
+
+afterEach(() => {
+	scene.clear()
+})
+
+describe('text truncation helper', () => {
+	it('clips a sentence to one line with an ellipsis inside a constrained box', () => {
+		const host = scene.mount(
+			`<div style="width: 120px"><div class="text-truncate">${SENTENCE}</div><div class="wrapped">${SENTENCE}</div></div>`,
+		)
+		const truncated = requireValue(
+			host.querySelector<HTMLElement>('.text-truncate'),
+			'No truncated box',
+		)
+		const wrapped = requireValue(host.querySelector<HTMLElement>('.wrapped'), 'No wrapped box')
+		expect([
+			readStyle(truncated, 'overflow-x'),
+			readStyle(truncated, 'overflow-y'),
+			readStyle(truncated, 'text-overflow'),
+			readStyle(truncated, 'white-space'),
+		]).toEqual(['hidden', 'hidden', 'ellipsis', 'nowrap'])
+		// The sentence runs past the box on one line, where its untruncated twin wraps inside the same
+		// width over several lines.
+		expect(truncated.scrollWidth).toBeGreaterThan(truncated.clientWidth)
+		expect(wrapped.scrollWidth).toBeLessThanOrEqual(wrapped.clientWidth)
+		expect(truncated.getBoundingClientRect().height).toBeLessThan(
+			wrapped.getBoundingClientRect().height,
+		)
+	})
+
+	it('yields its normal declarations to an important white-space utility and to a later rule of your own', () => {
+		const host = scene.mount(
+			'<div class="text-truncate text-wrap">Wrapped</div><div class="text-truncate">Clipped</div>',
+		)
+		const wrapped = requireValue(host.querySelector('.text-wrap'), 'No wrapped element')
+		const clipped = requireValue(host.lastElementChild, 'No clipped element')
+		expect(readStyle(wrapped, 'white-space')).toBe('normal')
+		expect(readStyle(clipped, 'text-overflow')).toBe('ellipsis')
+		scene.load('.text-truncate { text-overflow: clip }')
+		expect(readStyle(clipped, 'text-overflow')).toBe('clip')
+	})
+
+	it('sits in the components layer, where a later rule inside that layer overrides it', () => {
+		const host = scene.mount('<div class="text-truncate">Clipped</div>')
+		const element = requireValue(host.querySelector('.text-truncate'), 'No clipped element')
+		scene.load('@layer components { .text-truncate { white-space: pre } }')
+		expect(readStyle(element, 'white-space')).toBe('pre')
+		// A rule inside the utilities layer outranks the components layer whatever its priority.
+		scene.load('@layer utilities { .text-truncate { white-space: pre-line } }')
+		expect(readStyle(element, 'white-space')).toBe('pre-line')
+	})
+
+	it('reads no token or mode, so a dark island and a doubled density factor leave the helper', () => {
+		const host = scene.mount(
+			'<div data-bs-theme="dark"><div class="text-truncate">Island</div></div>',
+		)
+		const element = requireValue(host.querySelector('.text-truncate'), 'No island element')
+		const properties = ['overflow-x', 'text-overflow', 'white-space']
+		expect(properties.map((property) => readStyle(element, property))).toEqual([
+			'hidden',
+			'ellipsis',
+			'nowrap',
+		])
+		document.documentElement.style.setProperty(TOKEN_NAMES.factor.density, '2')
+		try {
+			expect(properties.map((property) => readStyle(element, property))).toEqual([
+				'hidden',
+				'ellipsis',
+				'nowrap',
+			])
+		} finally {
+			document.documentElement.style.removeProperty(TOKEN_NAMES.factor.density)
+		}
+	})
+})
