+/** Holds the share of the role's fill in its on-canvas tier, as the percentage `color-mix()` takes. */
+export const TEXT_TIER_SHARE = '70%'
+
+/**
+ * Lists the roles whose text on the page paints the role's on-canvas tier, each with the tier as the
+ * appearance ruling defines it: the role's fill mixed in oklab at {@link TEXT_TIER_SHARE} with the
+ * body text.
+ *
+ * @remarks
+ * The value is written from the ruling rather than from the cascade's alias chain, so a `.text-*`
+ * class that reads the wrong token, or a tier mixed at another share, resolves to a different color
+ * than this expression does in the same scope. {@link TEXT_COLOR_CASES} stays the release's record,
+ * and a key this table names reads its expectation from here instead.
+ */
+export const TEXT_TIER_CASES = Object.freeze(
+	['primary', 'secondary', 'success', 'info', 'warning', 'danger'].map((key) =>
+		Object.freeze({
+			key,
+			value: `color-mix(in oklab, var(--vn-color-${key}-base) ${TEXT_TIER_SHARE}, var(--vn-text-body-base))`,
+		}),
+	),
+)
+
+/**
+ * Lists the neutral roles, whose text colors and colored links keep the role's own channels rather
+ * than its on-canvas tier.
+ */
+export const TEXT_NEUTRAL_ROLES = Object.freeze(['light', 'dark'])
