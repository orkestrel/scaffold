+describe('fade case tables', () => {
+	it('binds the fade selector table to the selectors the official inventory records under the transition key alone', () => {
+		const others = new Set(
+			Object.entries(oracle.components).flatMap(([key, vocabulary]) =>
+				key === 'transition' ? [] : vocabulary.selectors.map(({ selector }) => selector),
+			),
+		)
+		const recorded = oracle.components.transition.selectors.map(({ selector }) => selector)
+		expect(new Set(FADE_SELECTORS).size).toBe(FADE_SELECTORS.length)
+		expect(new Set(FADE_SELECTORS)).toEqual(
+			new Set(recorded.filter((selector) => !others.has(selector))),
+		)
+		// The compounds the table leaves out are the ones another key records, so the partial of that
+		// component writes each of them.
+		expect(recorded.filter((selector) => others.has(selector)).length).toBeGreaterThan(0)
+	})
+	it('names in each fade component case the classes its own key and the transition key record', () => {
+		const vocabularies = new Map(
+			Object.entries(oracle.components).map(
+				([key, vocabulary]): readonly [string, ReadonlySet<string>] => [
+					key,
+					new Set(vocabulary.selectors.flatMap(({ classes }) => classes)),
+				],
+			),
+		)
+		const transition = requireValue(vocabularies.get('transition'), 'No transition vocabulary')
+		expect(FADE_COMPONENT_CASES).not.toStrictEqual([])
+		for (const { component, hidden, shown } of FADE_COMPONENT_CASES) {
+			const own = requireValue(vocabularies.get(component), `No ${component} vocabulary`)
+			for (const classes of [hidden, shown]) {
+				const names = classes.split(' ')
+				expect({ component, classes, fade: names.includes('fade') }).toEqual({
+					component,
+					classes,
+					fade: true,
+				})
+				expect(names.filter((name) => !own.has(name) && !transition.has(name))).toEqual([])
+			}
+			expect(shown.split(' ')).toContain('show')
+			expect(
+				Object.isFrozen(FADE_COMPONENT_CASES.find((entry) => entry.component === component)),
+			).toBe(true)
+		}
+		expect(Object.isFrozen(FADE_SELECTORS)).toBe(true)
+		expect(Object.isFrozen(FADE_COMPONENT_CASES)).toBe(true)
+	})
+})
