@@ -255,6 +255,36 @@ export function readRegion(subject: Element, frame?: Element): FrameRegion {
 	}
 }
 
+/**
+ * Reads a square region at one element's centre in the coordinates of the frame it is photographed
+ * inside.
+ *
+ * @param subject - The element whose centre the region sits on.
+ * @param size - The square's side, in the frame's own device pixels.
+ * @param frame - The element the frame covers. Omit it for a page frame, whose origin is the
+ *   document's own.
+ * @returns The square, centred on the subject's box in the frame's device pixels.
+ *
+ * @remarks
+ * The box is the {@link readRegion} function's, so the same staging rule binds: read the region
+ * while the pane is staged at the geometry the shot uses. A shot taken with the pane unstaged is
+ * painted at the runner's fitting scale, so its pixels do not sit where the element's box says.
+ *
+ * @example
+ * ```ts
+ * const centre = readCentre(control, 4, control)
+ * ```
+ */
+export function readCentre(subject: Element, size: number, frame?: Element): FrameRegion {
+	const box = readRegion(subject, frame)
+	return {
+		x: box.x + box.width / 2 - size / 2,
+		y: box.y + box.height / 2 - size / 2,
+		width: size,
+		height: size,
+	}
+}
+
 /** Resizes the tester viewport to one size in CSS pixels, the way the installed page verb does. */
 export type ViewportHandler = (width: number, height: number) => Promise<void>
 
