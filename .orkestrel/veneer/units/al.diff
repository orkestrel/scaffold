@@ -0,0 +1,20 @@
+import { ALERT_COPY, ALERT_SPECIMENS } from '../constants.js'
+import { SpecimenSection } from './SpecimenSection.js'
+
+/**
+ * Renders the declared alert specimens into a named region.
+ * @example
+ * ```ts
+ * const section = new AlertSection(document.body)
+ * section.destroy()
+ * ```
+ */
+export class AlertSection extends SpecimenSection {
+	/**
+	 * Mounts the Alert region and its specimens.
+	 * @param host - The element receiving the section.
+	 */
+	constructor(host: HTMLElement) {
+		super(host, ALERT_COPY, ALERT_SPECIMENS)
+	}
+}
diff --git a/src/styles/components/_alert.scss b/src/styles/components/_alert.scss
new file mode 100644
index 0000000..4c3e130
--- /dev/null
+++ b/src/styles/components/_alert.scss
@@ -0,0 +1,68 @@
+@use '../tokens';
+
+@layer components {
+	// The alert ships Bootstrap's recorded box. Its inset and its bottom spacing route through the
+	// density scale token that already resolves to the recorded `1rem`, and its edge and radius read
+	// the compatibility variables the release reads. The fill and the edge color are transparent and
+	// the text and link slots inherit, so a plain alert paints nothing of its own until a role
+	// retunes it.
+	.alert {
+		--bs-alert-bg: transparent;
+		--bs-alert-padding-x: var(--vn-space-8);
+		--bs-alert-padding-y: var(--vn-space-8);
+		--bs-alert-margin-bottom: var(--vn-space-8);
+		--bs-alert-color: inherit;
+		--bs-alert-border-color: transparent;
+		--bs-alert-border: var(--bs-border-width) solid var(--bs-alert-border-color);
+		--bs-alert-border-radius: var(--bs-border-radius);
+		--bs-alert-link-color: inherit;
+		position: relative;
+		padding: var(--bs-alert-padding-y) var(--bs-alert-padding-x);
+		margin-bottom: var(--bs-alert-margin-bottom);
+		color: var(--bs-alert-color);
+		background-color: var(--bs-alert-bg);
+		border: var(--bs-alert-border);
+		border-radius: var(--bs-alert-border-radius);
+	}
+
+	// A heading inside an alert takes the alert's text rather than the heading slot the elements
+	// layer paints every other heading from.
+	.alert-heading {
+		color: inherit;
+	}
+
+	// The weight is the fixed `700` the release writes; no published Veneer weight resolves to it.
+	.alert-link {
+		font-weight: 700;
+		color: var(--bs-alert-link-color);
+	}
+
+	// The end padding reserves the room the close control is placed in, and the control's inset is
+	// the release's `1.25` multiple of the block inset beside the inline one, each written over the
+	// density token the alert's own inset reads. The placement selects the control through the
+	// dismissible class, so a close control inside a plain alert stays in flow.
+	.alert-dismissible {
+		padding-right: var(--vn-space-24);
+	}
+
+	.alert-dismissible .btn-close {
+		position: absolute;
+		top: 0;
+		right: 0;
+		z-index: 2;
+		padding: calc(var(--vn-space-8) * 1.25) var(--vn-space-8);
+	}
+
+	// The contextual roles walk the aliased role list, so the set is Bootstrap's own and Veneer's
+	// `tertiary` role emits no variant. Each variant retunes the alert's own slots from the role's
+	// aliases and declares no property of its own, so the base rule paints through the slots it
+	// moved, in either color mode.
+	@each $role in tokens.$aliased {
+		.alert-#{$role} {
+			--bs-alert-color: var(--bs-#{$role}-text-emphasis);
+			--bs-alert-bg: var(--bs-#{$role}-bg-subtle);
+			--bs-alert-border-color: var(--bs-#{$role}-border-subtle);
+			--bs-alert-link-color: var(--bs-#{$role}-text-emphasis);
+		}
+	}
+}
diff --git a/tests/app/browser/sections/AlertSection.test.ts b/tests/app/browser/sections/AlertSection.test.ts
