@@ -0,0 +1,92 @@
+import type { SectionInterface } from '@app/browser'
+import { ALERT_COPY, ALERT_SPECIMENS, AlertSection, SpecimenSection } from '@app/browser'
+import { requireValue } from '@orkestrel/test'
+import { build, mount, readName } from '@orkestrel/test/browser'
+import { describe, expect, it } from 'vitest'
+
+describe('AlertSection', () => {
+	it('renders the role ramp, the linked alert, and the dismissible alert through the shared section contract', () => {
+		const host = mount(build('div'))
+		const section: SectionInterface = new AlertSection(host)
+		try {
+			expect(section).toBeInstanceOf(SpecimenSection)
+			expect(section.host).toBe(host)
+			const region = requireValue(host.querySelector('section'), 'No Alert region')
+			expect(region.querySelector('[style]')).toBeNull()
+			expect(region.getAttribute('aria-label')).toBe('Alert')
+			expect(region.querySelector('p')?.textContent).toBe(ALERT_COPY.paragraph)
+			const rendered = [...region.querySelectorAll('[data-specimen]')]
+			expect(rendered.map((element) => element.getAttribute('data-specimen'))).toEqual([
+				'Role alerts',
+				'Linked alert',
+				'Dismissible alert',
+			])
+			expect(rendered.map((element) => element.innerHTML)).toEqual(
+				ALERT_SPECIMENS.map(({ markup }) => markup),
+			)
+			// The ramp renders the release's roles in the release's order, one alert each, and no
+			// alert for Veneer's own `tertiary` role, which emits no variant.
+			const ramp = requireValue(
+				region.querySelector('[data-specimen="Role alerts"]'),
+				'No role ramp specimen',
+			)
+			expect([...ramp.querySelectorAll('.alert')].map((alert) => alert.className)).toEqual(
+				['primary', 'secondary', 'success', 'info', 'warning', 'danger', 'light', 'dark'].map(
+					(role) => `alert alert-${role}`,
+				),
+			)
+			expect(region.querySelector('.alert-tertiary')).toBeNull()
+			// Every alert announces itself through the role the release's markup gives it.
+			expect(
+				[...region.querySelectorAll('.alert')].filter(
+					(alert) => alert.getAttribute('role') !== 'alert',
+				),
+			).toStrictEqual([])
+			const linked = requireValue(
+				region.querySelector('[data-specimen="Linked alert"] .alert'),
+				'No linked alert',
+			)
+			expect(linked.querySelector('.alert-heading')).not.toBeNull()
+			const link = requireValue(linked.querySelector('a.alert-link'), 'No alert link')
+			expect(link.getAttribute('href')).toBe('#main')
+			const dismissible = requireValue(
+				region.querySelector('[data-specimen="Dismissible alert"] .alert.alert-dismissible'),
+				'No dismissible alert',
+			)
+			// The close control paints a mark rather than a label, so it announces the dismissal
+			// through its own name.
+			const control = requireValue(dismissible.querySelector('.btn-close'), 'No close control')
+			expect(control.tagName).toBe('BUTTON')
+			expect(control.getAttribute('aria-label')).toBe('Close')
+			expect(readName(control)).toBe('Close')
+			expect(control.textContent).toBe('')
+			// The release's fade classes are the engine's to set, and every alert rule paints the
+			// same without them, so no specimen carries one.
+			expect(region.querySelector('.fade, .show')).toBeNull()
+			expect(Object.isFrozen(ALERT_COPY)).toBe(true)
+			expect(Object.isFrozen(ALERT_SPECIMENS)).toBe(true)
+			expect(ALERT_SPECIMENS.every((entry) => Object.isFrozen(entry))).toBe(true)
+		} finally {
+			section.destroy()
+			host.remove()
+		}
+	})
+
+	it('releases the region and preserves adjacent content on repeated destruction', () => {
+		const host = mount(build('div'))
+		const neighbor = build('p', { text: 'Existing content' })
+		host.append(neighbor)
+		const section: SectionInterface = new AlertSection(host)
+		try {
+			const region = requireValue(host.querySelector('section'), 'No Alert region')
+			expect(region.isConnected).toBe(true)
+			section.destroy()
+			expect(region.isConnected).toBe(false)
+			section.destroy()
+			expect([...host.children]).toEqual([neighbor])
+		} finally {
+			section.destroy()
+			host.remove()
+		}
+	})
+})
diff --git a/tests/src/styles/components/alert.test.ts b/tests/src/styles/components/alert.test.ts
new file mode 100644
index 0000000..c46ace2
--- /dev/null
+++ b/tests/src/styles/components/alert.test.ts
@@ -0,0 +1,238 @@
+import { TOKEN_NAMES } from '@src/core'
+import { requireValue } from '@orkestrel/test'
+import { findRule, matchesColor, readPixels, readStyle, readToken } from '@orkestrel/test/browser'
+import { afterEach, describe, expect, it } from 'vitest'
+import { scene } from '../../../setupBrowser.js'
+import {
+	ALERT_DISMISSIBLE_GEOMETRY,
+	ALERT_ROLES,
+	ALERT_SELECTORS,
+	ALERT_SPACE_CASES,
+	TEXT_MODES,
+} from '../../../setupStyles.js'
+
+afterEach(() => {
+	scene.clear()
+	for (const token of [TOKEN_NAMES.factor.density, TOKEN_NAMES.factor.radius])
+		document.documentElement.style.removeProperty(token)
+})
+
+describe('alert box', () => {
+	it('carries a rule for every shipped alert name', () => {
+		// The lookup reads the sheet the browser resolved rather than the source. It is a containment
+		// lookup and proves no completeness; the conformance ledger holds the recorded set whole.
+		const names = [...ALERT_SELECTORS, ...ALERT_ROLES.map((role) => `.alert-${role}`)]
+		expect(names.filter((selector) => findRule(selector) === undefined)).toEqual([])
+	})
+
+	it('pads, spaces, and rounds the box from its own slots and paints no fill or edge at rest', () => {
+		const host = scene.mount(
+			'<div style="color: rgb(10, 20, 30)"><div class="alert">Oak shipment</div></div>',
+		)
+		const alert = requireValue(host.querySelector('.alert'), 'No alert')
+		expect(readStyle(alert, 'position')).toBe('relative')
+		for (const side of ['top', 'right', 'bottom', 'left']) {
+			expect(readPixels(alert, `padding-${side}`)).toBe(16)
+			expect(readPixels(alert, `border-${side}-width`)).toBe(1)
+			expect(readStyle(alert, `border-${side}-style`)).toBe('solid')
+			expect(readStyle(alert, `border-${side}-color`)).toBe('rgba(0, 0, 0, 0)')
+		}
+		expect(readPixels(alert, 'margin-bottom')).toBe(16)
+		expect(readStyle(alert, 'background-color')).toBe('rgba(0, 0, 0, 0)')
+		// A plain alert declares its text slot as `inherit`, so it paints whatever text color its
+		// host carries rather than a color of its own.
+		expect(readStyle(alert, 'color')).toBe('rgb(10, 20, 30)')
+		expect(readPixels(alert, 'border-top-left-radius')).toBe(
+			readPixels(alert, 'border-bottom-right-radius'),
+		)
+		expect(readPixels(alert, 'border-top-left-radius')).toBeCloseTo(6, 3)
+	})
+
+	it.each(ALERT_SPACE_CASES)(
+		'reads $property from its own token',
+		({ property, token, pixels }) => {
+			const host = scene.mount(
+				`<div class="alert">Oak shipment<span data-probe style="display:block;width:var(${property})"></span></div>`,
+			)
+			const alert = requireValue(host.querySelector('.alert'), 'No alert')
+			expect(readToken(alert, property)).toBe(readToken(alert, token))
+			// The slot is read as a length as well, because two properties resolving to one another stay
+			// equal through a retune that moves them together and away from the release.
+			expect(
+				readPixels(requireValue(alert.querySelector('[data-probe]'), 'No probe'), 'width'),
+			).toBe(pixels)
+		},
+	)
+
+	it('moves the padding through a consumer scope retuning its slots and shadows an ancestor retune', () => {
+		const host = scene.mount(
+			'<div class="retuned" style="--bs-alert-padding-x: 40px; --bs-alert-padding-y: 40px"><div class="alert">Oak shipment</div></div>',
+		)
+		const alert = requireValue(host.querySelector('.alert'), 'No alert')
+		// The alert declares its slots on itself, so the same retune carried by an ancestor reaches
+		// nothing and the box keeps the release's inset.
+		expect(readPixels(alert, 'padding-left')).toBe(16)
+		expect(readPixels(alert, 'padding-top')).toBe(16)
+		// A consumer rule that still selects the alert and scopes it to an ancestor of their own is
+		// where the compatibility contract puts a retune. A padding written as the recorded literal
+		// resolves the same inset at rest and follows no retune, so this reading is what separates
+		// the slot from the value.
+		scene.load('.retuned .alert { --bs-alert-padding-x: 30px; --bs-alert-padding-y: 10px; }')
+		expect(readPixels(alert, 'padding-left')).toBe(30)
+		expect(readPixels(alert, 'padding-right')).toBe(30)
+		expect(readPixels(alert, 'padding-top')).toBe(10)
+		expect(readPixels(alert, 'padding-bottom')).toBe(10)
+	})
+
+	it('rescales the box with the density and radius factors', () => {
+		const host = scene.mount(
+			'<div class="alert">Oak shipment</div><div class="alert alert-dismissible">Ash shipment <button type="button" class="btn-close" aria-label="Close"></button></div>',
+		)
+		const [alert, dismissible] = [...host.querySelectorAll('.alert')]
+		const plain = requireValue(alert, 'No alert')
+		const room = requireValue(dismissible, 'No dismissible alert')
+		const control = requireValue(room.querySelector('.btn-close'), 'No close control')
+		const radius = readPixels(plain, 'border-top-left-radius')
+		// The factors are published at the document root, where every token the alert reads resolves
+		// its own value, so the retune is applied there rather than on the alert.
+		document.documentElement.style.setProperty(TOKEN_NAMES.factor.density, '2')
+		expect(readPixels(plain, 'padding-left')).toBe(32)
+		expect(readPixels(plain, 'margin-bottom')).toBe(32)
+		expect(readPixels(room, 'padding-right')).toBe(ALERT_DISMISSIBLE_GEOMETRY.end * 2)
+		expect(readPixels(control, 'padding-top')).toBe(ALERT_DISMISSIBLE_GEOMETRY.block * 2)
+		expect(readPixels(control, 'padding-left')).toBe(ALERT_DISMISSIBLE_GEOMETRY.inline * 2)
+		expect(readPixels(plain, 'border-top-left-radius')).toBe(radius)
+		document.documentElement.style.setProperty(TOKEN_NAMES.factor.radius, '2')
+		expect(readPixels(plain, 'border-top-left-radius')).toBe(radius * 2)
+	})
+})
+
+describe('alert content', () => {
+	it('paints the heading in the alert text color where a bare heading reads the heading slot', () => {
+		const host = scene.mount(
+			'<div class="alert alert-success" style="--bs-heading-color: rgb(1, 2, 3)"><h4 class="alert-heading">Oak delivered</h4><h4>Ash pending</h4></div>',
+		)
+		const alert = requireValue(host.querySelector('.alert'), 'No alert')
+		const heading = requireValue(alert.querySelector('.alert-heading'), 'No alert heading')
+		const bare = requireValue(alert.querySelector('h4:not(.alert-heading)'), 'No bare heading')
+		// The bare heading is the control: it reads the retuned heading slot, so a heading class that
+		// stopped declaring its own color would paint that slot as well.
+		expect(readStyle(bare, 'color')).toBe('rgb(1, 2, 3)')
+		expect(readStyle(heading, 'color')).toBe(readStyle(alert, 'color'))
+		expect(matchesColor(readStyle(heading, 'color'), 'rgb(1, 2, 3)')).toBe(false)
+	})
+
+	it('weights the link and paints it from its own slot, inheriting the alert text at rest', () => {
+		const host = scene.mount(
+			'<div style="color: rgb(10, 20, 30)"><div class="alert">Oak <a class="alert-link" href="#main">manifest</a> <a href="#main">archive</a></div></div>',
+		)
+		const alert = requireValue(host.querySelector<HTMLElement>('.alert'), 'No alert')
+		const link = requireValue(alert.querySelector('.alert-link'), 'No alert link')
+		const bare = requireValue(alert.querySelector('a:not(.alert-link)'), 'No bare link')
+		expect(readStyle(link, 'font-weight')).toBe('700')
+		expect(readStyle(bare, 'font-weight')).not.toBe('700')
+		// A plain alert declares its link slot as `inherit`, so the link paints the alert's own text
+		// where a bare anchor beside it paints the link color.
+		expect(readStyle(link, 'color')).toBe('rgb(10, 20, 30)')
+		expect(matchesColor(readStyle(bare, 'color'), 'rgb(10, 20, 30)')).toBe(false)
+		alert.style.setProperty('--bs-alert-link-color', 'rgb(40, 50, 60)')
+		expect(readStyle(link, 'color')).toBe('rgb(40, 50, 60)')
+		expect(readStyle(alert, 'color')).toBe('rgb(10, 20, 30)')
+	})
+})
+
+describe('contextual alert roles', () => {
+	describe.each(TEXT_MODES)('in %s', (mode) => {
+		it.each(ALERT_ROLES)('paints the %s alert from its own role aliases', (role) => {
+			const host = scene.mount(
+				`<div data-bs-theme="${mode}"><div class="alert alert-${role}">Oak <a class="alert-link" href="#main">manifest</a></div></div>`,
+			)
+			const island = requireValue(host.querySelector<HTMLElement>('[data-bs-theme]'), 'No island')
+			const alert = requireValue(host.querySelector('.alert'), 'No alert')
+			const link = requireValue(alert.querySelector('.alert-link'), 'No alert link')
+			const aliases = [
+				`--bs-${role}-text-emphasis`,
+				`--bs-${role}-bg-subtle`,
+				`--bs-${role}-border-subtle`,
+			] as const
+			const [text, fill, edge] = aliases
+			const resolved = aliases.map((name) => readToken(island, name))
+			// A variant reading another role's alias reddens here only where the two roles resolve
+			// apart, so every other role is first held apart from this one on each alias the variant
+			// reads, in the mode the island names.
+			for (const other of ALERT_ROLES.filter((name) => name !== role))
+				for (const [index, name] of aliases.entries())
+					expect(
+						matchesColor(readToken(island, name.replace(role, other)), resolved[index] ?? ''),
+					).toBe(false)
+			expect(matchesColor(readStyle(alert, 'color'), readToken(island, text))).toBe(true)
+			expect(matchesColor(readStyle(alert, 'background-color'), readToken(island, fill))).toBe(true)
+			expect(matchesColor(readStyle(alert, 'border-top-color'), readToken(island, edge))).toBe(true)
+			expect(matchesColor(readStyle(link, 'color'), readToken(island, text))).toBe(true)
+			// Retuning the aliases on the island moves every paint with them. A variant written
+			// as the literal its alias resolves to reads the same at rest and follows no retune, so
+			// this is what separates the routing from the value in either mode.
+			island.style.setProperty(text, 'rgb(11, 22, 33)')
+			island.style.setProperty(fill, 'rgb(44, 55, 66)')
+			island.style.setProperty(edge, 'rgb(77, 88, 99)')
+			expect(readStyle(alert, 'color')).toBe('rgb(11, 22, 33)')
+			expect(readStyle(alert, 'background-color')).toBe('rgb(44, 55, 66)')
+			expect(readStyle(alert, 'border-top-color')).toBe('rgb(77, 88, 99)')
+			expect(readStyle(link, 'color')).toBe('rgb(11, 22, 33)')
+		})
+	})
+
+	it('emits no variant for the role Bootstrap 5.3.8 does not name', () => {
+		const host = scene.mount(
+			'<div class="alert alert-tertiary">Oak shipment</div><div class="alert">Ash shipment</div>',
+		)
+		const [invented, plain] = [...host.querySelectorAll('.alert')]
+		// Veneer carries a `tertiary` role of its own, and the alert's role walk is the aliased list,
+		// so this class reaches no rule and the alert paints as a plain one.
+		for (const property of ['background-color', 'border-top-color', 'color'])
+			expect(readStyle(requireValue(invented, 'No invented alert'), property)).toBe(
+				readStyle(requireValue(plain, 'No plain alert'), property),
+			)
+	})
+})
+
+describe('dismissible alert', () => {
+	it('reserves the end padding and pins the close control to the top-right corner above the content', () => {
+		const host = scene.mount(
+			'<div class="alert alert-warning alert-dismissible">Oak shipment held <button type="button" class="btn-close" aria-label="Close"></button></div>',
+		)
+		const alert = requireValue(host.querySelector('.alert'), 'No alert')
+		const control = requireValue(alert.querySelector('.btn-close'), 'No close control')
+		const { end, block, inline, lift } = ALERT_DISMISSIBLE_GEOMETRY
+		expect(readPixels(alert, 'padding-right')).toBe(end)
+		expect(readPixels(alert, 'padding-left')).toBe(16)
+		expect(readStyle(control, 'position')).toBe('absolute')
+		expect(readStyle(control, 'z-index')).toBe(lift)
+		for (const side of ['top', 'bottom']) expect(readPixels(control, `padding-${side}`)).toBe(block)
+		for (const side of ['left', 'right'])
+			expect(readPixels(control, `padding-${side}`)).toBe(inline)
+		// The control is placed against the alert's padding box, so its outer edges meet the alert's
+		// inner border edges at the top and the end. A control placed from the start edge instead
+		// meets the start border and leaves the end corner empty.
+		const box = alert.getBoundingClientRect()
+		const target = control.getBoundingClientRect()
+		expect(target.top).toBeCloseTo(box.top + readPixels(alert, 'border-top-width'), 3)
+		expect(target.right).toBeCloseTo(box.right - readPixels(alert, 'border-right-width'), 3)
+		expect(target.left).toBeGreaterThan(box.left + box.width / 2)
+	})
+
+	it('leaves a close control inside a plain alert in flow', () => {
+		const host = scene.mount(
+			'<div class="alert alert-warning">Oak shipment held <button type="button" class="btn-close" aria-label="Close"></button></div>',
+		)
+		const alert = requireValue(host.querySelector('.alert'), 'No alert')
+		const control = requireValue(alert.querySelector('.btn-close'), 'No close control')
+		// The placement rule selects the control through the dismissible class, so a rule written
+		// against the bare alert class would lift this control out of flow as well.
+		expect(readStyle(control, 'position')).toBe('static')
+		expect(readStyle(control, 'z-index')).toBe('auto')
+		expect(readPixels(alert, 'padding-right')).toBe(16)
+		const em = readPixels(control, 'font-size')
+		expect(readPixels(control, 'padding-top')).toBeCloseTo(em * 0.25, 3)
+	})
+})
