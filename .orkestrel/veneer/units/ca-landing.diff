diff --git a/src/styles/components/_carousel.scss b/src/styles/components/_carousel.scss
new file mode 100644
index 0000000..1805bad
--- /dev/null
+++ b/src/styles/components/_carousel.scss
@@ -0,0 +1,207 @@
+@use 'sass:map';
+@use '../tokens';
+@use '../mixins' as *;
+
+@layer components {
+	// The carousel ships Bootstrap's recorded surface. Each state is a class set in markup: the
+	// `active` class marks the resting slide, the `carousel-item-next` and `carousel-item-prev`
+	// classes mark the incoming one, and the `carousel-item-start` and `carousel-item-end` classes
+	// mark the direction a slide is heading. No rule here reads the `slide` class; an engine reads it
+	// to decide whether a change animates.
+	.carousel {
+		position: relative;
+	}
+
+	.carousel.pointer-event {
+		touch-action: pan-y;
+	}
+
+	.carousel-inner {
+		position: relative;
+		width: 100%;
+		overflow: hidden;
+	}
+
+	// The slides float side by side, so the track clears them itself rather than through a helper
+	// class the markup would have to carry.
+	.carousel-inner::after {
+		display: block;
+		clear: both;
+		content: '';
+	}
+
+	// Each slide takes the whole track and pulls the next one back over itself with its negative
+	// margin, so every displayed slide sits at the same place until a transform moves it.
+	.carousel-item {
+		position: relative;
+		display: none;
+		float: left;
+		width: 100%;
+		margin-right: -100%;
+		backface-visibility: hidden;
+		@include transition(transform 0.6s ease-in-out);
+	}
+
+	.carousel-item.active,
+	.carousel-item-next,
+	.carousel-item-prev {
+		display: block;
+	}
+
+	.carousel-item-next:not(.carousel-item-start),
+	.active.carousel-item-end {
+		transform: translateX(100%);
+	}
+
+	.carousel-item-prev:not(.carousel-item-end),
+	.active.carousel-item-start {
+		transform: translateX(-100%);
+	}
+
+	// The fade variant stacks the slides in place and crosses their opacity instead of moving them.
+	// The outgoing slide holds its opacity for the whole slide duration before dropping it, so the
+	// incoming slide fades in over a slide that is still painted.
+	.carousel-fade .carousel-item {
+		opacity: 0;
+		transition-property: opacity;
+		transform: none;
+	}
+
+	.carousel-fade .carousel-item.active,
+	.carousel-fade .carousel-item-next.carousel-item-start,
+	.carousel-fade .carousel-item-prev.carousel-item-end {
+		z-index: 1;
+		opacity: 1;
+	}
+
+	.carousel-fade .active.carousel-item-start,
+	.carousel-fade .active.carousel-item-end {
+		z-index: 0;
+		opacity: 0;
+		@include transition(opacity 0s 0.6s);
+	}
+
+	// The controls paint the release's white through the palette token that holds it, and their
+	// opacity change reads the feedback duration, so the motion factor rescales it. The filter
+	// reads the variable the theme scopes and the dark class declare, which is what inverts the
+	// white marks over a light picture. Focus removes the outline and shows as the same opacity
+	// change the pointer makes, under forced colors as well.
+	.carousel-control-prev,
+	.carousel-control-next {
+		position: absolute;
+		top: 0;
+		bottom: 0;
+		z-index: 1;
+		display: flex;
+		align-items: center;
+		justify-content: center;
+		width: 15%;
+		padding: 0;
+		color: var(--vn-palette-white-base);
+		text-align: center;
+		background: none;
+		filter: var(--bs-carousel-control-icon-filter);
+		border: 0;
+		opacity: 0.5;
+		@include transition(opacity var(--vn-motion-feedback) var(--vn-ease-standard));
+	}
+
+	.carousel-control-prev:hover,
+	.carousel-control-prev:focus,
+	.carousel-control-next:hover,
+	.carousel-control-next:focus {
+		color: var(--vn-palette-white-base);
+		text-decoration: none;
+		outline: 0;
+		opacity: 0.9;
+	}
+
+	.carousel-control-prev {
+		left: 0;
+	}
+
+	.carousel-control-next {
+		right: 0;
+	}
+
+	.carousel-control-prev-icon,
+	.carousel-control-next-icon {
+		display: inline-block;
+		width: 2rem;
+		height: 2rem;
+		background-repeat: no-repeat;
+		background-position: 50%;
+		background-size: 100% 100%;
+	}
+
+	// Each mark is a data URI, which cannot read a custom property, so the white fill stays inside
+	// the asset and the control's filter is what retunes it. The release appends the other
+	// direction's mark in a right-to-left annotation; that annotation does not ship, so each mark
+	// points the same way whatever the document's writing direction.
+	.carousel-control-prev-icon {
+		background-image: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 16' fill='%23fff'%3e%3cpath d='M11.354 1.646a.5.5 0 0 1 0 .708L5.707 8l5.647 5.646a.5.5 0 0 1-.708.708l-6-6a.5.5 0 0 1 0-.708l6-6a.5.5 0 0 1 .708 0'/%3e%3c/svg%3e");
+	}
+
+	.carousel-control-next-icon {
+		background-image: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 16' fill='%23fff'%3e%3cpath d='M4.646 1.646a.5.5 0 0 1 .708 0l6 6a.5.5 0 0 1 0 .708l-6 6a.5.5 0 0 1-.708-.708L10.293 8 4.646 2.354a.5.5 0 0 1 0-.708'/%3e%3c/svg%3e");
+	}
+
+	// The indicators keep the control width clear on each side, so a pip never sits under a control.
+	.carousel-indicators {
+		position: absolute;
+		right: 0;
+		bottom: 0;
+		left: 0;
+		z-index: 2;
+		display: flex;
+		justify-content: center;
+		padding: 0;
+		margin-right: 15%;
+		margin-bottom: var(--vn-space-8);
+		margin-left: 15%;
+	}
+
+	// Each pip is a bar inside a transparent top and bottom border, which widens the target the
+	// pointer reaches without widening the bar it paints.
+	.carousel-indicators [data-bs-target] {
+		box-sizing: content-box;
+		flex: 0 1 auto;
+		width: 30px;
+		height: 3px;
+		padding: 0;
+		margin-right: 3px;
+		margin-left: 3px;
+		text-indent: -999px;
+		cursor: pointer;
+		background-color: var(--bs-carousel-indicator-active-bg);
+		background-clip: padding-box;
+		border: 0;
+		border-top: 10px solid transparent;
+		border-bottom: 10px solid transparent;
+		opacity: 0.5;
+		@include transition(opacity 0.6s ease);
+	}
+
+	.carousel-indicators .active {
+		opacity: 1;
+	}
+
+	.carousel-caption {
+		position: absolute;
+		right: 15%;
+		bottom: 1.25rem;
+		left: 15%;
+		padding-top: 1.25rem;
+		padding-bottom: 1.25rem;
+		color: var(--bs-carousel-caption-color);
+		text-align: center;
+	}
+
+	// The opt-in retune for a carousel over light pictures inside a light island. It declares the
+	// dark scope's own values, so the class and a dark island paint one carousel.
+	.carousel-dark {
+		--bs-carousel-indicator-active-bg: #{map.get(tokens.$dark, 'carousel-surface')};
+		--bs-carousel-caption-color: #{map.get(tokens.$dark, 'carousel-caption')};
+		--bs-carousel-control-icon-filter: #{map.get(tokens.$dark, 'carousel-icon-filter')};
+	}
+}
