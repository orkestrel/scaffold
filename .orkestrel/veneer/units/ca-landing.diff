+import { CAROUSEL_COPY, CAROUSEL_SPECIMENS } from '../constants.js'
+import { SpecimenSection } from './SpecimenSection.js'
+
+/**
+ * Renders the declared carousel specimens into a named region.
+ * @example
+ * ```ts
+ * const section = new CarouselSection(document.body)
+ * section.destroy()
+ * ```
+ */
+export class CarouselSection extends SpecimenSection {
+	/**
+	 * Mounts the Carousel region and its specimens.
+	 * @param host - The element receiving the section.
+	 */
+	constructor(host: HTMLElement) {
+		super(host, CAROUSEL_COPY, CAROUSEL_SPECIMENS)
+	}
+}
