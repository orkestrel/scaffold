diff --git a/tests/src/styles/components/collapse.test.ts b/tests/src/styles/components/collapse.test.ts
new file mode 100644
index 0000000..cb76b66
--- /dev/null
+++ b/tests/src/styles/components/collapse.test.ts
@@ -0,0 +1,216 @@
+import { requireValue } from '@orkestrel/test'
+import { readHit, readPixels, readStyle, releaseMedia, stageMedia } from '@orkestrel/test/browser'
+import { afterEach, describe, expect, it } from 'vitest'
+import { collectLayer, collectMediaConditions, scene } from '../../../setupBrowser.js'
+import {
+	normalizeComplexSelector,
+	REDUCED_MOTION,
+	splitTopLevelList,
+	TEXT_MODES,
+	trimCSSWhitespace,
+} from '../../../setupStyles.js'
+
+afterEach(async () => {
+	await releaseMedia()
+	scene.clear()
+})
+
+describe('collapse classes', () => {
+	// The mutation this catches is a rule the partial stops writing, or one it writes beyond the
+	// release: the reading is every components-layer selector naming one of the key's own classes,
+	// so a missing rule and an extra rule on the same classes each report here.
+	it('writes the recorded collapse and collapsing selectors and no other rule on their classes', () => {
+		const written = new Set(
+			collectLayer('components').flatMap((rule) =>
+				rule instanceof CSSStyleRule
+					? splitTopLevelList(rule.selectorText)
+							.map((part) => normalizeComplexSelector(trimCSSWhitespace(part)))
+							.filter((selector) => /\.(?:collapse|collapsing)(?![\w-])/u.test(selector))
+					: [],
+			),
+		)
+		expect([...written].sort()).toEqual([
+			'.collapse:not(.show)',
+			'.collapsing',
+			'.collapsing.collapse-horizontal',
+		])
+	})
+
+	// The mutation this catches is a declaration the partial stops writing or writes at another value:
+	// the reading is each closing rule's own declarations, at rest and under the reduced-motion
+	// condition, so a missing zero, a missing clip, a transition written outside the mixin, and a
+	// reduced-motion twin that kept its transition each report here beside the resolved readings the
+	// following cases take.
+	it('declares the recorded closing box at rest and no transition under the reduced-motion condition', () => {
+		const rules = collectLayer('components').flatMap((rule) =>
+			rule instanceof CSSStyleRule ? [rule] : [],
+		)
+		expect(
+			['.collapsing', '.collapsing.collapse-horizontal'].map((selector) =>
+				rules
+					.filter(
+						(rule) => normalizeComplexSelector(trimCSSWhitespace(rule.selectorText)) === selector,
+					)
+					.map((rule) => [
+						rule.parentRule instanceof CSSMediaRule ? rule.parentRule.conditionText : undefined,
+						...['height', 'width', 'overflow', 'transition'].map((property) =>
+							rule.style.getPropertyValue(property),
+						),
+					]),
+			),
+		).toEqual([
+			[
+				[undefined, '0px', '', 'hidden', 'height 0.35s'],
+				[REDUCED_MOTION, '', '', '', 'none'],
+			],
+			[
+				[undefined, 'auto', '0px', '', 'width 0.35s'],
+				[REDUCED_MOTION, '', '', '', 'none'],
+			],
+		])
+	})
+
+	// The mutation this catches is a hiding rule that reaches the shown state: dropping the
+	// `:not(.show)` qualifier hides the shown panel as well, and the shown reading is the element's
+	// own display, so a rule writing a display onto the shown state reports here too.
+	it('hides a collapse until the show class is set, and leaves the shown panel its own display', () => {
+		const host = scene.mount(
+			'<div class="collapse">Return policy</div><div class="collapse show">Delivery window</div><span class="collapse show">Tracking</span>',
+		)
+		const [hidden, shown, inline] = [...host.children]
+		const panel = requireValue(hidden, 'No hidden panel')
+		expect(readStyle(panel, 'display')).toBe('none')
+		expect(panel.getBoundingClientRect().height).toBe(0)
+		expect(readStyle(requireValue(shown, 'No shown panel'), 'display')).toBe('block')
+		expect(requireValue(shown, 'No shown panel').getBoundingClientRect().height).toBeGreaterThan(0)
+		expect(readStyle(requireValue(inline, 'No shown inline panel'), 'display')).toBe('inline')
+	})
+
+	// The mutation this catches is a closing panel that stopped clipping: the child is four times
+	// the host's height, so its centre sits below the host's bottom edge, and the hit test there
+	// lands on the page under the host rather than on the child only while the overflow is hidden.
+	it('clips a closing panel to the size set on it and lets the page show through below', () => {
+		const host = scene.mount(
+			'<div class="collapsing" style="height: 24px"><div style="height: 96px">Tracking history</div></div>',
+		)
+		const panel = requireValue(host.querySelector('.collapsing'), 'No closing panel')
+		const child = requireValue(panel.firstElementChild, 'No panel content')
+		expect(readStyle(panel, 'overflow')).toBe('hidden')
+		expect(panel.getBoundingClientRect().height).toBe(24)
+		expect(child.getBoundingClientRect().height).toBe(96)
+		expect(child.getBoundingClientRect().top + 48).toBeGreaterThan(
+			panel.getBoundingClientRect().bottom,
+		)
+		const hit = requireValue(readHit(child), 'The hit test below the panel reached nothing')
+		expect(child.contains(hit)).toBe(false)
+		expect(panel.contains(hit)).toBe(false)
+	})
+
+	// The mutation this catches is a closing panel that keeps its content height: the shown panel
+	// beside it carries the same content, so its height is what the closing panel would measure if
+	// the rule stopped zeroing it.
+	it('closes a panel carrying no size of its own to a zero-height box', () => {
+		const host = scene.mount(
+			'<div class="collapsing"><p>Picked up and out for delivery.</p></div><div class="collapse show"><p>Picked up and out for delivery.</p></div>',
+		)
+		const [closing, shown] = [...host.children]
+		const panel = requireValue(closing, 'No closing panel')
+		expect(readPixels(panel, 'height')).toBe(0)
+		expect(panel.getBoundingClientRect().height).toBe(0)
+		expect(requireValue(shown, 'No shown panel').getBoundingClientRect().height).toBeGreaterThan(0)
+	})
+
+	// The mutation this catches is the horizontal rule written as a descendant selector: the compound
+	// element would then keep the vertical zero and a full width, and the horizontal element nested
+	// inside a closing panel would lose its width. Both readings are taken here.
+	it('closes a horizontal panel on its width alone, and only where both classes sit on one element', () => {
+		const host = scene.mount(
+			'<div class="collapsing collapse-horizontal"><div style="width: 160px">Carrier filters</div></div><div class="collapsing" style="height: 48px"><div class="collapse-horizontal">Weight filters</div></div>',
+		)
+		const [compound, closing] = [...host.children]
+		const panel = requireValue(compound, 'No horizontal panel')
+		const content = requireValue(panel.firstElementChild, 'No horizontal content')
+		expect(readPixels(panel, 'width')).toBe(0)
+		expect(panel.getBoundingClientRect().width).toBe(0)
+		expect(panel.getBoundingClientRect().height).toBeGreaterThan(0)
+		expect(panel.getBoundingClientRect().height).toBe(content.getBoundingClientRect().height)
+		const nested = requireValue(
+			requireValue(closing, 'No closing panel').firstElementChild,
+			'No nested horizontal element',
+		)
+		expect(nested.getBoundingClientRect().width).toBeGreaterThan(0)
+		expect(readStyle(nested, 'transition-property')).toBe('all')
+	})
+
+	// The mutation this catches is a transition written outside the mixin: the resting reading and
+	// the staged reading are taken on the same elements, so a declaration that kept its duration
+	// under the preference reports here, and so does one that dropped its reduced-motion twin.
+	it('transitions the closing size and collapses that transition under the reduced-motion preference', async () => {
+		const host = scene.mount(
+			'<div class="collapsing" style="height: 24px">Tracking history</div><div class="collapsing collapse-horizontal" style="width: 80px">Carrier filters</div>',
+		)
+		const [vertical, horizontal] = [...host.children]
+		const readings = [vertical, horizontal].map((panel) =>
+			['transition-property', 'transition-duration', 'transition-timing-function'].map((property) =>
+				readStyle(requireValue(panel, 'No closing panel'), property),
+			),
+		)
+		expect(readings).toEqual([
+			['height', '0.35s', 'ease'],
+			['width', '0.35s', 'ease'],
+		])
+		await stageMedia({ motion: false })
+		expect(
+			[vertical, horizontal].map((panel) =>
+				readStyle(requireValue(panel, 'No closing panel'), 'transition-duration'),
+			),
+		).toEqual(['0s', '0s'])
+		await releaseMedia()
+		expect(
+			[vertical, horizontal].map((panel) =>
+				readStyle(requireValue(panel, 'No closing panel'), 'transition-duration'),
+			),
+		).toEqual(['0.35s', '0.35s'])
+		for (const selector of ['.collapsing', '.collapsing.collapse-horizontal'])
+			expect(collectMediaConditions(collectLayer('components'), selector)).toEqual([REDUCED_MOTION])
+		// The hiding rule carries no motion and no condition, so a shown or hidden panel changes
+		// state at once whatever the preference.
+		expect(collectMediaConditions(collectLayer('components'), '.collapse:not(.show)')).toEqual([])
+	})
+
+	// The mutation this catches is the partial writing the duration through
+	// `calc(0.35s * var(--vn-factor-motion))`: a wrapper doubling the motion factor would then read
+	// back a doubled duration, and the release's own literal reads back unchanged instead.
+	it('keeps the closing transition at the release duration under a doubled motion factor', () => {
+		const host = scene.mount(
+			'<div style="--vn-factor-motion: 2"><div class="collapsing" style="height: 24px">Tracking history</div></div>',
+		)
+		const panel = requireValue(host.querySelector('.collapsing'), 'No closing panel')
+		expect(readStyle(panel, 'transition-duration')).toBe('0.35s')
+	})
+
+	// The mutation this catches is a treatment that moves with the color mode: the key paints
+	// nothing, so every reading it owns has to come back the same inside a dark island.
+	it('resolves every state the same inside a dark island as inside a light one', () => {
+		const readings = TEXT_MODES.map((mode) => {
+			const host = scene.mount(
+				`<div data-bs-theme="${mode}"><div class="collapse">Return policy</div><div class="collapse show">Delivery window</div><div class="collapsing" style="height: 24px"><div style="height: 96px">Tracking history</div></div><div class="collapsing collapse-horizontal"><div style="width: 160px">Carrier filters</div></div></div>`,
+			)
+			const island = requireValue(host.firstElementChild, 'No island')
+			const [hidden, shown, closing, horizontal] = [...island.children]
+			const reading = [
+				readStyle(requireValue(hidden, 'No hidden panel'), 'display'),
+				readStyle(requireValue(shown, 'No shown panel'), 'display'),
+				readStyle(requireValue(closing, 'No closing panel'), 'overflow'),
+				readPixels(requireValue(closing, 'No closing panel'), 'height'),
+				readPixels(requireValue(horizontal, 'No horizontal panel'), 'width'),
+				readStyle(requireValue(horizontal, 'No horizontal panel'), 'transition-property'),
+			]
+			scene.clear()
+			return reading
+		})
+		const [light, dark] = readings
+		expect(light).toEqual(['none', 'block', 'hidden', 24, 0, 'width'])
+		expect(dark).toEqual(light)
+	})
+})
