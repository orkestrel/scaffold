+ * @remarks
+ * The proofs assert each refusal as a literal rather than reading it back from this table, so a
+ * helper that drops, reorders, or rewords a message disagrees with them.
+ */
+export const SAMPLE_MESSAGES: MatchMessages = Object.freeze({
+	absent: 'No sample in the root is named "Placeholder"',
+	duplicate: 'samples in the root are named "Placeholder"',
+	foreign: 'The "Placeholder" sample is not an HTML element',
+})
