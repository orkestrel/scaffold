+/**
+ * Words the refusals of one named lookup, so {@link requireMatch} can refuse in that lookup's own
+ * terms.
+ */
+export interface MatchMessages {
+	/** Refuses a name no candidate answers to. */
+	readonly absent: string
+	/** Refuses a name several candidates answer to, as the text that follows their count. */
+	readonly duplicate: string
+	/** Refuses a name whose one candidate is not an HTML element. */
+	readonly foreign: string
+}
+
+/**
+ * Returns the one candidate a named lookup matched, checked as an HTML element.
+ *
+ * @param matched - The candidates the lookup's selection policy kept for one name.
+ * @param messages - The refusals, worded in the lookup's own terms.
+ * @returns The one matched candidate.
+ * @throws An `Error` carrying `messages.duplicate` after the count when several candidates matched,
+ *   `messages.absent` when none did, and `messages.foreign` when the one match is not an HTML element.
+ *
+ * @remarks
+ * Every named lookup ends the same way: a name that addresses two elements addresses neither, a name
+ * that addresses none is a missing subject, and a typed answer must be checked rather than narrowed.
+ * The lookups differ only in which candidates they keep and how they word the refusal, so each keeps
+ * its selection and its wording and hands this the rest.
+ *
+ * Several matches are refused rather than answered with the first of them, and the refusal names
+ * their count, so a root that grew a second element of that name says so.
+ *
+ * @example
+ * ```ts
+ * requireMatch([...root.querySelectorAll('[data-specimen="Capped container"]')], {
+ * 	absent: 'No specimen in the root is named "Capped container"',
+ * 	duplicate: 'specimens in the root are named "Capped container"',
+ * 	foreign: 'The "Capped container" specimen is not an HTML element',
+ * })
+ * ```
+ */
+export function requireMatch(matched: readonly Element[], messages: MatchMessages): HTMLElement {
+	if (matched.length > 1) throw new Error(`${String(matched.length)} ${messages.duplicate}`)
+	const element = requireValue(matched[0], messages.absent)
+	if (!(element instanceof HTMLElement)) throw new Error(messages.foreign)
+	return element
+}
+
+/**
