+				const painted = rules.get(`.bs-${key}-${name} ${arrow}::before`) ?? []
+				expect(hung.some((entry) => entry.startsWith(`${edge}: `))).toBe(true)
+				expect(painted.some((entry) => entry.startsWith(`border-${side}-color: `))).toBe(true)
