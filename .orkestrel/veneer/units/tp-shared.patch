+describe('tip case tables', () => {
+	it('binds the tooltip and popover selector tables to the official inventory, each name once', () => {
+		for (const [table, key] of [
+			[TOOLTIP_SELECTORS, 'tooltip'],
+			[POPOVER_SELECTORS, 'popover'],
