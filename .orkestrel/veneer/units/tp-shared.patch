+			expect(new Set(table).size).toBe(table.length)
+			expect(new Set(table)).toEqual(
+				new Set(oracle.components[key].selectors.map(({ selector }) => selector)),
+			)
+		}
+	})
+	it('pairs every explicit placement rule with the automatic rule the release extends it into', () => {
+		for (const key of ['tooltip', 'popover'] as const) {
+			// The release records an arrow triangle's rule twice, so each selector's declarations are
+			// gathered across every rule recording it before two selectors are compared.
+			const rules = new Map<string, readonly string[]>()
+			for (const { selector, declarations } of oracle.components[key].selectors)
+				rules.set(selector, [
+					...(rules.get(selector) ?? []),
+					...declarations.map(({ property, value }) => `${property}: ${value}`),
+				])
+			const pairs = TIP_PLACEMENTS.flatMap(({ name, side }) =>
+				[...rules.keys()]
+					.filter((selector) => selector.startsWith(`.bs-${key}-${name} `))
+					.map((selector) => ({
+						explicit: selector,
+						automatic: selector.replace(
+							`.bs-${key}-${name}`,
+							`.bs-${key}-auto[data-popper-placement^=${side}]`,
+						),
+					})),
+			)
+			// Every automatic rule is some explicit rule's twin, and each twin records exactly the
+			// declarations of the explicit rule it extends, so an automatic placement resolves the
+			// geometry of the side its attribute names.
+			expect(new Set(pairs.map(({ automatic }) => automatic))).toEqual(
+				new Set([...rules.keys()].filter((selector) => selector.includes(`.bs-${key}-auto`))),
+			)
+			for (const { explicit, automatic } of pairs)
+				expect(rules.get(automatic)).toEqual(rules.get(explicit))
+			// The explicit arrow rule hangs the arrow from the pinned edge, and its first triangle
+			// paints on the pinned side, which is what a proof reading the table relies on.
+			const arrow = key === 'tooltip' ? '.tooltip-arrow' : '> .popover-arrow'
+			for (const { name, side, edge } of TIP_PLACEMENTS) {
