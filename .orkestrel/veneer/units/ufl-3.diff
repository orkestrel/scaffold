+import type { SectionInterface } from '@app/browser'
+import {
+	OBJECT_FIT_COPY,
+	OBJECT_FIT_SPECIMENS,
+	ObjectFitSection,
+	SpecimenSection,
+} from '@app/browser'
+import { requireValue } from '@orkestrel/test'
+import { build, mount, readStyle } from '@orkestrel/test/browser'
+import { beforeAll, describe, expect, it } from 'vitest'
+import { visitBreakpoint } from '../../../setupBrowser.js'
+import { GRID_BREAKPOINT_CASES, OBJECT_FIT_VALUES, VIEWPORT_WIDTHS } from '../../../setupStyles.js'
+
+// The layout case reads the specimens as the published cascade lays them out, so the cascade has to
+// be in the document before a box is measured.
+beforeAll(async () => {
+	await import('../../../../src/styles/index.scss')
+	await import('../../../../app/browser/styles/index.scss')
+})
+
+describe('ObjectFitSection', () => {
+	it('renders every declared specimen through the shared section contract', () => {
+		const host = mount(build('div'))
+		const section: SectionInterface = new ObjectFitSection(host)
+		try {
+			expect(section).toBeInstanceOf(SpecimenSection)
+			expect(section.host).toBe(host)
+			const region = requireValue(host.querySelector('section'), 'No Object fit region')
+			expect(region.querySelector('[style]')).toBeNull()
+			expect(region.getAttribute('aria-label')).toBe('Object fit')
+			expect(region.querySelector('p')?.textContent).toBe(OBJECT_FIT_COPY.paragraph)
+			const rendered = [...region.querySelectorAll('[data-specimen]')]
+			expect(rendered.map((element) => element.getAttribute('data-specimen'))).toEqual([
+				'Object fit values',
+				'Responsive object fit',
+			])
+			expect(rendered.map((element) => element.innerHTML)).toEqual(
+				OBJECT_FIT_SPECIMENS.map((specimen) => specimen.markup),
+			)
+			// Each picture sits in an aspect-ratio box, carries a description naming its classes, and
+			// the line after its box names the same classes.
+			const pictures = [...region.querySelectorAll('img')]
+			expect(pictures.map((picture) => picture.parentElement?.classList.contains('ratio'))).toEqual(
+				pictures.map(() => true),
+			)
+			for (const picture of pictures) {
+				const classes = [...picture.classList].filter((name) => name.startsWith('object-fit-'))
+				expect(classes).not.toEqual([])
+				expect(picture.parentElement?.nextElementSibling?.textContent).toBe(classes.join(' '))
+				for (const name of classes) expect(picture.alt).toContain(name)
+			}
+			expect(
+				[...region.querySelectorAll('[data-specimen="Object fit values"] img')].map((picture) =>
+					[...picture.classList].find((name) => name.startsWith('object-fit-')),
+				),
+			).toEqual(OBJECT_FIT_VALUES.map(({ key }) => `object-fit-${key}`))
+			expect(Object.isFrozen(OBJECT_FIT_COPY)).toBe(true)
+			expect(Object.isFrozen(OBJECT_FIT_SPECIMENS)).toBe(true)
+			expect(OBJECT_FIT_SPECIMENS.every((specimen) => Object.isFrozen(specimen))).toBe(true)
+		} finally {
+			section.destroy()
+			host.remove()
+		}
+	})
+
+	it('fits every picture in a box whose ratio differs from its own, switching the responsive picture at the md boundary', async () => {
+		const host = mount(build('div'))
+		const section: SectionInterface = new ObjectFitSection(host)
+		try {
+			const pictures = [...host.querySelectorAll('img')]
+			await Promise.all(pictures.map((picture) => picture.decode()))
+			const responsive = requireValue(
+				host.querySelector('.object-fit-md-cover'),
+				'No responsive picture',
+			)
+			const md = requireValue(
+				GRID_BREAKPOINT_CASES.find(({ name }) => name === 'md'),
+				'No md breakpoint case',
+			)
+			for (const viewport of VIEWPORT_WIDTHS) {
+				const reading = await visitBreakpoint(viewport, () => ({
+					// A picture whose box shares its ratio would fit every value alike, so each box's
+					// ratio is read against the picture's own.
+					unlike: pictures.map((picture) => {
+						const box = picture.getBoundingClientRect()
+						return (
+							Math.abs(box.width / box.height - picture.naturalWidth / picture.naturalHeight) > 0.5
+						)
+					}),
+					responsive: readStyle(responsive, 'object-fit'),
+				}))
+				expect(reading).toEqual({
+					unlike: pictures.map(() => true),
+					responsive: viewport >= md.boundary ? 'cover' : 'contain',
+				})
+			}
+		} finally {
+			section.destroy()
+			host.remove()
+		}
+	})
+
+	it('releases its region and preserves neighboring content through repeated destruction', () => {
+		const host = mount(build('div'))
+		const neighbor = build('p', { text: 'Existing content' })
+		host.append(neighbor)
+		const section: SectionInterface = new ObjectFitSection(host)
+		try {
+			const region = requireValue(host.querySelector('section'), 'No Object fit region')
+			expect(region.isConnected).toBe(true)
+			section.destroy()
+			expect(region.isConnected).toBe(false)
+			section.destroy()
+			expect([...host.children]).toEqual([neighbor])
+		} finally {
+			section.destroy()
+			host.remove()
+		}
+	})
+})
