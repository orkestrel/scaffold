+import { FLOAT_COPY, FLOAT_SPECIMENS } from '../constants.js'
+import { SpecimenSection } from './SpecimenSection.js'
+
+/**
+ * Renders the declared float and clearfix specimens into a named Float region.
+ *
+ * @example
+ * ```ts
+ * const section = new FloatSection(document.body)
+ * section.destroy()
+ * ```
+ */
+export class FloatSection extends SpecimenSection {
+	/**
+	 * Mounts the Float region and its specimens in table order.
+	 * @param host - The element receiving the section.
+	 */
+	constructor(host: HTMLElement) {
+		super(host, FLOAT_COPY, FLOAT_SPECIMENS)
+	}
+}
