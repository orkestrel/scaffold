new file mode 100644
index 0000000..e56d021
--- /dev/null
+++ b/src/styles/components/_stretched-link.scss
@@ -0,0 +1,15 @@
+@layer components {
+	// The release writes the helper with normal declarations and the physical edges, and it reads no
+	// published Veneer token: the stacking level is the literal the release carries. The generated box
+	// covers the link's nearest positioned ancestor, so a pointer anywhere on that ancestor lands on
+	// the link.
+	.stretched-link::after {
+		position: absolute;
+		top: 0;
+		right: 0;
+		bottom: 0;
+		left: 0;
+		z-index: 1;
+		content: '';
+	}
+}
diff --git a/src/styles/utilities/_float.scss b/src/styles/utilities/_float.scss
new file mode 100644
index 0000000..7d287a4
--- /dev/null
+++ b/src/styles/utilities/_float.scss
@@ -0,0 +1,19 @@
+@use '../mixins' as *;
+
+@layer utilities {
+	// The release's `float` entry is responsive and writes the physical sides, so the `start` key
+	// floats a box left and the `end` key floats it right whatever the writing direction.
+	@include breakpoint-each using ($infix, $_boundary) {
+		@include utility(
+			float,
+			float,
+			(
+				start: left,
+				end: right,
+				none: none,
+			),
+			$infix,
+			true
+		);
+	}
+}
diff --git a/src/styles/utilities/_object-fit.scss b/src/styles/utilities/_object-fit.scss
new file mode 100644
index 0000000..e234c3e
--- /dev/null
+++ b/src/styles/utilities/_object-fit.scss
@@ -0,0 +1,21 @@
+@use '../mixins' as *;
+
+@layer utilities {
+	// The release names the `scale-down` value by its `scale` key, so the key and the value differ
+	// only there.
+	@include breakpoint-each using ($infix, $_boundary) {
+		@include utility(
+			object-fit,
+			object-fit,
+			(
+				contain: contain,
+				cover: cover,
+				fill: fill,
+				scale: scale-down,
+				none: none,
+			),
+			$infix,
+			true
+		);
+	}
+}
diff --git a/src/styles/utilities/_overflow.scss b/src/styles/utilities/_overflow.scss
new file mode 100644
index 0000000..d5d3429
--- /dev/null
+++ b/src/styles/utilities/_overflow.scss
@@ -0,0 +1,13 @@
+@use '../mixins' as *;
+
+@layer utilities {
+	// The shorthand entry, then the axis entries, in the release's map order, so an axis class beats
+	// the shorthand on its own axis. The `overflow`, `overflow-x`, and `overflow-y` entries are not
+	// responsive, so the walk writes each at the empty infix alone.
+	$values: auto, hidden, visible, scroll;
+	@include breakpoint-each using ($infix, $_boundary) {
+		@include utility(overflow, overflow, $values, $infix);
+		@include utility(overflow-x, overflow-x, $values, $infix);
+		@include utility(overflow-y, overflow-y, $values, $infix);
+	}
+}
diff --git a/tests/app/browser/sections/FloatSection.test.ts b/tests/app/browser/sections/FloatSection.test.ts
new file mode 100644
index 0000000..31d575f
--- /dev/null
+++ b/tests/app/browser/sections/FloatSection.test.ts
@@ -0,0 +1,131 @@
+import type { SectionInterface } from '@app/browser'
+import { FLOAT_COPY, FLOAT_SPECIMENS, FloatSection, SpecimenSection } from '@app/browser'
+import { requireValue } from '@orkestrel/test'
+import { build, mount, readStyle } from '@orkestrel/test/browser'
+import { beforeAll, describe, expect, it } from 'vitest'
+import { visitBreakpoint } from '../../../setupBrowser.js'
+import { FLOAT_VALUES, GRID_BREAKPOINT_CASES, VIEWPORT_WIDTHS } from '../../../setupStyles.js'
+
+// Every float class the release writes, each side at each infix, and the classes among them that
+// float a box, derived from the side table and the breakpoint ramp rather than listed by hand.
+const FLOAT_CLASSES = FLOAT_VALUES.flatMap(({ key, value }) =>
+	GRID_BREAKPOINT_CASES.map(({ name, boundary }) => ({
+		name: `float${boundary === 0 ? '' : `-${name}`}-${key}`,
+		floats: value !== 'none',
+	})),
+)
+const FLOATING = FLOAT_CLASSES.flatMap(({ name, floats }) => (floats ? [`.${name}`] : [])).join(
+	', ',
+)
+
+// The layout cases read the specimens as the published cascade lays them out, so the cascade has to
+// be in the document before a box is measured.
+beforeAll(async () => {
+	await import('../../../../src/styles/index.scss')
+	await import('../../../../app/browser/styles/index.scss')
+})
+
+describe('FloatSection', () => {
+	it('renders every declared specimen through the shared section contract', () => {
+		const host = mount(build('div'))
+		const section: SectionInterface = new FloatSection(host)
+		try {
+			expect(section).toBeInstanceOf(SpecimenSection)
+			expect(section.host).toBe(host)
+			const region = requireValue(host.querySelector('section'), 'No Float region')
+			expect(region.querySelector('[style]')).toBeNull()
+			expect(region.getAttribute('aria-label')).toBe('Float')
+			expect(region.querySelector('p')?.textContent).toBe(FLOAT_COPY.paragraph)
+			const rendered = [...region.querySelectorAll('[data-specimen]')]
+			expect(rendered.map((element) => element.getAttribute('data-specimen'))).toEqual([
+				'Float sides',
+				'Responsive float',
+				'Cleared floats',
+			])
+			expect(rendered.map((element) => element.innerHTML)).toEqual(
+				FLOAT_SPECIMENS.map((specimen) => specimen.markup),
+			)
+			// Each side is a card naming the class it carries, and every host holding a float carries
+			// the clearfix helper, so no float hangs into the specimen after it.
+			for (const { key } of FLOAT_VALUES) {
+				const card = requireValue(
+					region.querySelector(`[data-specimen="Float sides"] .card.float-${key}`),
+					`No float-${key} card`,
+				)
+				expect(card.textContent).toBe(`float-${key}`)
+			}
+			// Every float class a specimen carries is one the release writes.
+			const written = FLOAT_CLASSES.map(({ name }) => name)
+			expect(
+				[...region.querySelectorAll('[class*="float-"]')]
+					.flatMap((element) => [...element.classList])
+					.filter((name) => name.startsWith('float-') && !written.includes(name)),
+			).toEqual([])
+			expect(
+				[...region.querySelectorAll(FLOATING)].filter(
+					(element) => element.parentElement?.classList.contains('clearfix') !== true,
+				),
+			).toEqual([])
+			expect(
+				region.querySelector(
+					'[data-specimen="Cleared floats"] > .alert.clearfix > .card.float-start + p',
+				)?.textContent,
+			).toContain('clearfix')
+			expect(Object.isFrozen(FLOAT_COPY)).toBe(true)
+			expect(Object.isFrozen(FLOAT_SPECIMENS)).toBe(true)
+			expect(FLOAT_SPECIMENS.every((specimen) => Object.isFrozen(specimen))).toBe(true)
+		} finally {
+			section.destroy()
+			host.remove()
+		}
+	})
+
+	it('moves the responsive card to the right at the md boundary and holds every float in its specimen', async () => {
+		const host = mount(build('div'))
+		const section: SectionInterface = new FloatSection(host)
+		try {
+			const card = requireValue(host.querySelector('.float-md-end'), 'No responsive card')
+			const holder = requireValue(card.parentElement, 'No holder')
+			const md = requireValue(
+				GRID_BREAKPOINT_CASES.find(({ name }) => name === 'md'),
+				'No md breakpoint case',
+			)
+			for (const viewport of VIEWPORT_WIDTHS)
+				expect(
+					await visitBreakpoint(viewport, () => [
+						readStyle(card, 'float'),
+						card.getBoundingClientRect().left === holder.getBoundingClientRect().left,
+						card.getBoundingClientRect().right === holder.getBoundingClientRect().right,
+					]),
+				).toEqual(viewport >= md.boundary ? ['right', false, true] : ['left', true, false])
+			// A specimen holding a float is as tall as the float's bottom edge, so the next specimen
+			// starts below it rather than beside it.
+			for (const specimen of host.querySelectorAll('[data-specimen]')) {
+				const bottom = specimen.getBoundingClientRect().bottom
+				for (const floated of specimen.querySelectorAll(FLOATING))
+					expect(floated.getBoundingClientRect().bottom).toBeLessThanOrEqual(bottom)
+			}
+		} finally {
+			section.destroy()
+			host.remove()
+		}
+	})
+
+	it('releases its region and preserves neighboring content through repeated destruction', () => {
+		const host = mount(build('div'))
+		const neighbor = build('p', { text: 'Existing content' })
+		host.append(neighbor)
+		const section: SectionInterface = new FloatSection(host)
+		try {
+			const region = requireValue(host.querySelector('section'), 'No Float region')
+			expect(region.isConnected).toBe(true)
+			section.destroy()
+			expect(region.isConnected).toBe(false)
+			section.destroy()
+			expect([...host.children]).toEqual([neighbor])
+		} finally {
+			section.destroy()
+			host.remove()
+		}
+	})
+})
