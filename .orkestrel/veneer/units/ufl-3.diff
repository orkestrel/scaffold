diff --git a/src/styles/components/_clearfix.scss b/src/styles/components/_clearfix.scss
new file mode 100644
index 0000000..1f6169c
--- /dev/null
+++ b/src/styles/components/_clearfix.scss
@@ -0,0 +1,10 @@
+@layer components {
+	// The release writes the helper with normal declarations, so it sits in the components layer at
+	// its `_helpers.scss` position. The generated box after the content clears every float before it,
+	// so the host's height reaches the bottom of its floated children.
+	.clearfix::after {
+		display: block;
+		clear: both;
+		content: '';
+	}
+}
