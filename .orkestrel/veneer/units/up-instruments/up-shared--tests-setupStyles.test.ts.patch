+					declarations.map(({ property, value }) => ({ selector, property, value })),
+				),
+			]),
+		)
+		const bg = requireValue(recorded.get('bg'), 'No bg key')
+		const border = requireValue(recorded.get('border'), 'No border key')
+		const rounded = requireValue(recorded.get('rounded'), 'No rounded key')
+		// A channelled color is the release's `rgba()` over one channel alias and the entry's opacity
+		// local, and its key is the rest of the class name after the entry's class.
+		for (const [cases, key, rules, property] of [
+			[BACKGROUND_FILL_CASES, 'bg', bg, 'background-color'],
+			[BORDER_COLOR_CASES, 'border', border, 'border-color'],
+		] as const) {
+			expect(cases.map((entry) => [entry.key, entry.alias])).toEqual(
+				rules.flatMap((rule) => {
+					const match = new RegExp(
+						`^rgba\\(var\\((--bs-[\\w-]+-rgb)\\), var\\(--bs-${key}-opacity\\)\\)$`,
+						'u',
+					).exec(rule.value)
+					return rule.property === property && match !== null
+						? [[rule.selector.replace(`.${key}-`, ''), match[1]]]
+						: []
+				}),
+			)
+		}
