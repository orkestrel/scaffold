+	it('binds the paint fills, tiers, opacity steps, border sides and widths, and radius steps to the inventory', () => {
+		// Each reading is derived from the inventory's own rules under the paint keys, read by the
+		// value each rule records rather than by the case tables, so a table narrowed, widened,
+		// reordered, or pointed at the wrong alias reddens here.
+		const recorded = new Map(
