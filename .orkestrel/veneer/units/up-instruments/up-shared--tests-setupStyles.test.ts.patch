+				SUBTLE_TIER_CASES.map((entry) => [`.${key}-${entry.role}-subtle`, entry[tier]]),
+			).toEqual(
+				rules.flatMap((rule) => {
+					const match = new RegExp(`^var\\((--bs-[\\w-]+-${key}-subtle)\\)$`, 'u').exec(rule.value)
+					return rule.property === property && match !== null ? [[rule.selector, match[1]]] : []
+				}),
+			)
+		}
+		// Each opacity step is the custom property its opacity class sets, read as a number.
+		for (const [key, rules] of [
+			['bg', bg],
+			['border', border],
+		] as const) {
+			expect(PAINT_OPACITY_CASES.map(({ step, alpha }) => [step, alpha])).toEqual(
+				rules.flatMap((rule) => {
+					const match = new RegExp(`^\\.${key}-opacity-(\\d+)$`, 'u').exec(rule.selector)
+					return match !== null && rule.property === `--bs-${key}-opacity`
+						? [[match[1], Number(rule.value)]]
+						: []
+				}),
+			)
+		}
+		// A side entry's bare class draws one physical side with the border shorthand's value.
