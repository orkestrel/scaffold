@@ -0,0 +1,177 @@
+@use 'sass:map';
+@use '../tokens';
+@use '../mixins' as *;
+
+@layer components {
+	// Every value here is Bootstrap 5.3.8's own, apart from the forced-colors focus outline. A block
+	// padding reads the Veneer space token that already resolves to it, so the density factor reaches
+	// it; the inline padding and the chevron size keep the release's `1.25rem` length, because no
+	// space token resolves to that length. A color reads the compatibility variable Bootstrap itself
+	// names, and the focus ring mixes the palette blue that carries the release's literal, because a
+	// partial declares no literal color of its own. Each chevron is the release's own glyph, read out
+	// of the icon map because a data URI cannot read a custom property.
+	.accordion {
+		--bs-accordion-color: var(--bs-body-color);
+		--bs-accordion-bg: var(--bs-body-bg);
+		--bs-accordion-transition:
+			color 0.15s ease-in-out, background-color 0.15s ease-in-out, border-color 0.15s ease-in-out,
+			box-shadow 0.15s ease-in-out, border-radius 0.15s ease;
+		--bs-accordion-border-color: var(--bs-border-color);
+		--bs-accordion-border-width: var(--bs-border-width);
+		--bs-accordion-border-radius: var(--bs-border-radius);
+		--bs-accordion-inner-border-radius: calc(var(--bs-border-radius) - (var(--bs-border-width)));
+		--bs-accordion-btn-padding-x: 1.25rem;
+		--bs-accordion-btn-padding-y: var(--vn-space-8);
+		--bs-accordion-btn-color: var(--bs-body-color);
+		--bs-accordion-btn-bg: var(--bs-accordion-bg);
+		--bs-accordion-btn-icon: #{map.get(tokens.$icons, 'accordion-icon')};
+		--bs-accordion-btn-icon-width: 1.25rem;
+		--bs-accordion-btn-icon-transform: rotate(-180deg);
+		--bs-accordion-btn-icon-transition: transform 0.2s ease-in-out;
+		--bs-accordion-btn-active-icon: #{map.get(tokens.$icons, 'accordion-active-icon')};
+		--bs-accordion-btn-focus-box-shadow: 0 0 0 0.25rem
+			color-mix(in srgb, var(--vn-palette-blue) 25%, transparent);
+		--bs-accordion-body-padding-x: 1.25rem;
+		--bs-accordion-body-padding-y: var(--vn-space-8);
+		--bs-accordion-active-color: var(--bs-primary-text-emphasis);
+		--bs-accordion-active-bg: var(--bs-primary-bg-subtle);
+	}
+
+	// The timing is the release's own rather than the motion tokens the `.btn` class reads, because
+	// this key ships the release's recorded surface. The `transition` mixin emits the reduced-motion
+	// twin the release records beside the button's transition and beside the chevron's.
+	.accordion-button {
+		position: relative;
+		display: flex;
+		align-items: center;
+		width: 100%;
+		padding: var(--bs-accordion-btn-padding-y) var(--bs-accordion-btn-padding-x);
+		font-size: var(--vn-size-3);
+		color: var(--bs-accordion-btn-color);
+		text-align: left;
+		background-color: var(--bs-accordion-btn-bg);
+		border: 0;
+		border-radius: 0;
+		overflow-anchor: none;
+		@include transition(var(--bs-accordion-transition));
+	}
+
+	// The classes are set in markup: a button without the `collapsed` class is the expanded one, and
+	// its inset rule draws the line between it and the panel under it.
+	.accordion-button:not(.collapsed) {
+		color: var(--bs-accordion-active-color);
+		background-color: var(--bs-accordion-active-bg);
+		box-shadow: inset 0 calc(-1 * var(--bs-accordion-border-width)) 0
+			var(--bs-accordion-border-color);
+	}
+
+	.accordion-button:not(.collapsed)::after {
+		background-image: var(--bs-accordion-btn-active-icon);
+		transform: var(--bs-accordion-btn-icon-transform);
+	}
+
+	.accordion-button::after {
+		flex-shrink: 0;
+		width: var(--bs-accordion-btn-icon-width);
+		height: var(--bs-accordion-btn-icon-width);
+		margin-left: auto;
+		content: '';
+		background-image: var(--bs-accordion-btn-icon);
+		background-repeat: no-repeat;
+		background-size: var(--bs-accordion-btn-icon-width);
+		@include transition(var(--bs-accordion-btn-icon-transition));
+	}
+
+	.accordion-button:hover {
+		z-index: 2;
+	}
+
+	// The focused button lifts over its neighbours so its ring paints over the borders they share.
+	// Forced colors paint no shadow, so the button takes the system-highlight outline there.
+	.accordion-button:focus {
+		z-index: 3;
+		outline: 0;
+		box-shadow: var(--bs-accordion-btn-focus-box-shadow);
+		@include forced-ring;
+	}
+
+	.accordion-header {
+		margin-bottom: 0;
+	}
+
+	.accordion-item {
+		color: var(--bs-accordion-color);
+		background-color: var(--bs-accordion-bg);
+		border: var(--bs-accordion-border-width) solid var(--bs-accordion-border-color);
+	}
+
+	// The group's outer corners belong to its boundary items, and each button at an end rounds its
+	// own corners inside the item's border so its fill does not cross the curve.
+	.accordion-item:first-of-type {
+		border-top-left-radius: var(--bs-accordion-border-radius);
+		border-top-right-radius: var(--bs-accordion-border-radius);
+	}
+
+	.accordion-item:first-of-type > .accordion-header .accordion-button {
+		border-top-left-radius: var(--bs-accordion-inner-border-radius);
+		border-top-right-radius: var(--bs-accordion-inner-border-radius);
+	}
+
+	// Each later item gives up its top border, so neighbouring items share one line.
+	.accordion-item:not(:first-of-type) {
+		border-top: 0;
+	}
+
+	.accordion-item:last-of-type {
+		border-bottom-right-radius: var(--bs-accordion-border-radius);
+		border-bottom-left-radius: var(--bs-accordion-border-radius);
+	}
+
+	// The last button rounds its bottom corners only while it is collapsed; an expanded last button
+	// meets its panel, and the panel takes the group's outer radius instead.
+	.accordion-item:last-of-type > .accordion-header .accordion-button.collapsed {
+		border-bottom-right-radius: var(--bs-accordion-inner-border-radius);
+		border-bottom-left-radius: var(--bs-accordion-inner-border-radius);
+	}
+
+	.accordion-item:last-of-type > .accordion-collapse {
+		border-bottom-right-radius: var(--bs-accordion-border-radius);
+		border-bottom-left-radius: var(--bs-accordion-border-radius);
+	}
+
+	.accordion-body {
+		padding: var(--bs-accordion-body-padding-y) var(--bs-accordion-body-padding-x);
+	}
+
+	// A flush group runs its items edge to edge: no side borders, no outer border at either end, and
+	// no rounded corner on an item, a button, or a panel. Each rule here ties the boundary rule it
+	// overrides on specificity and follows it, which is what the collapsed button's own selector is
+	// for.
+	.accordion-flush > .accordion-item {
+		border-right: 0;
+		border-left: 0;
+		border-radius: 0;
+	}
+
+	.accordion-flush > .accordion-item:first-child {
+		border-top: 0;
+	}
+
+	.accordion-flush > .accordion-item:last-child {
+		border-bottom: 0;
+	}
+
+	.accordion-flush > .accordion-item > .accordion-collapse,
+	.accordion-flush > .accordion-item > .accordion-header .accordion-button,
+	.accordion-flush > .accordion-item > .accordion-header .accordion-button.collapsed {
+		border-radius: 0;
+	}
+
+	// The release gives each chevron a second value under its dark component rule. Declared on the
+	// pseudo-element, it outranks the light value the accordion declares, and like the release's own
+	// rule it matches any button under a dark scope, a nested light island included.
+	[data-bs-theme='dark'] .accordion-button::after {
+		--bs-accordion-btn-icon: #{map.get(tokens.$dark, 'accordion-icon')};
+		--bs-accordion-btn-active-icon: #{map.get(tokens.$dark, 'accordion-active-icon')};
+	}
+}
