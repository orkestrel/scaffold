+
+/**
+ * Renders the declared accordion specimens into a named region.
+ * @example
+ * ```ts
+ * const section = new AccordionSection(document.body)
+ * section.destroy()
+ * ```
+ */
+export class AccordionSection extends SpecimenSection {
+	/**
+	 * Mounts the Accordion region and its specimens.
+	 * @param host - The element receiving the section.
