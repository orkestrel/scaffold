index 0000000..0053e89
--- /dev/null
+++ b/src/styles/components/_form-control.scss
@@ -0,0 +1,191 @@
+@use '../mixins' as *;
+
+// Names each control size, the block and inline padding it gives the control and the file button,
+// the type step it sets, and the radius variable it reads. The release writes the small and the
+// large size out once each with the same structure, so the pair is one list here and the rules are
+// written once. The minimum height of each size is its line box plus its block padding twice plus
+// its border twice, which is how the release derives it, so the padding token is multiplied rather
+// than a second length being written beside it: a density retune moves the padding and the height
+// together.
+$sizes: (
+	('sm', var(--vn-space-2), var(--vn-space-4), var(--vn-size-2), var(--bs-border-radius-sm)),
+	('lg', var(--vn-space-4), var(--vn-space-8), var(--vn-size-5), var(--bs-border-radius-lg))
+);
+
+// Names each engine's color swatch part. A selector naming one engine's pseudo-element is dropped
+// whole by the other, so the release writes the swatch rule once per engine and this list emits
+// the same rule from one declaration of it.
+$swatches: ('::-moz-color-swatch', '::-webkit-color-swatch');
+
+@layer components {
+	// The control reads the body text and surface variables the release reads, so a color mode
+	// retunes it through the theme scope. Its padding, type step, weight, and line height route
+	// through the Veneer tokens that hold the release's own values, which is what lets the density
+	// factor rescale the control with the rest of the cascade.
+	.form-control {
+		display: block;
+		width: 100%;
+		padding: var(--vn-space-3) var(--vn-space-6);
+		font-size: var(--vn-size-3);
+		font-weight: var(--vn-weight-body);
+		line-height: var(--vn-line-body);
+		color: var(--bs-body-color);
+		appearance: none;
+		background-color: var(--bs-body-bg);
+		background-clip: padding-box;
+		border: var(--bs-border-width) solid var(--bs-border-color);
+		border-radius: var(--bs-border-radius);
+		@include transition(
+			(
+				border-color var(--vn-motion-feedback) var(--vn-ease-standard),
+				box-shadow var(--vn-motion-feedback) var(--vn-ease-standard)
+			)
+		);
+	}
+
+	.form-control[type='file'] {
+		overflow: hidden;
+	}
+
+	.form-control[type='file']:not(:disabled):not([readonly]) {
+		cursor: pointer;
+	}
+
+	// The focus ring binds the focus pair `_button.scss` binds, so one retune of the focus tokens
+	// moves every ring the package paints. The border tint is half the blue palette entry over the
+	// white one, which is the tint the release bakes into its own literal; the entry rather than the
+	// role token is mixed because the release's own value is that blue in either mode.
+	.form-control:focus {
+		color: var(--bs-body-color);
+		background-color: var(--bs-body-bg);
+		border-color: color-mix(in srgb, var(--vn-palette-blue) 50%, var(--vn-palette-white-base));
+		outline: 0;
+		box-shadow: 0 0 0 var(--vn-focus-width) var(--vn-focus-color);
+	}
+
+	// The minimum width and the height are the release's literals: the width is a pixel floor with
+	// no Veneer scale behind it, and the height is one line box in the control's own `em`.
+	.form-control::-webkit-date-and-time-value {
+		min-width: 85px;
+		height: 1.5em;
+		margin: 0;
+	}
+
+	.form-control::-webkit-datetime-edit {
+		display: block;
+		padding: 0;
+	}
+
+	.form-control::placeholder {
+		color: var(--bs-secondary-color);
+		opacity: 1;
+	}
+
+	.form-control:disabled {
+		background-color: var(--bs-secondary-bg);
+		opacity: 1;
+	}
+
+	// The file button sits flush against the control's border by cancelling the control's own
+	// padding, then keeps the inline gap before the file name. The inline-end margin and border are
+	// the logical properties the release compiles, written as it writes them. The prefixed
+	// `::-webkit-file-upload-button` alias is not written: the guide's deferral table records it as
+	// excluded, because the standard part ships the same button.
+	.form-control::file-selector-button {
+		padding: var(--vn-space-3) var(--vn-space-6);
+		margin: calc(var(--vn-space-3) * -1) calc(var(--vn-space-6) * -1);
+		-webkit-margin-end: var(--vn-space-6);
+		margin-inline-end: var(--vn-space-6);
+		color: var(--bs-body-color);
+		background-color: var(--bs-tertiary-bg);
+		pointer-events: none;
+		@include border-reset;
+		border-inline-end-width: var(--bs-border-width);
+		border-radius: 0;
+		@include transition(
+			(
+				color var(--vn-motion-feedback) var(--vn-ease-standard),
+				background-color var(--vn-motion-feedback) var(--vn-ease-standard),
+				border-color var(--vn-motion-feedback) var(--vn-ease-standard),
+				box-shadow var(--vn-motion-feedback) var(--vn-ease-standard)
+			)
+		);
+	}
+
+	.form-control:hover:not(:disabled):not([readonly])::file-selector-button {
+		background-color: var(--bs-secondary-bg);
+	}
+
+	.form-control-plaintext {
+		display: block;
+		width: 100%;
+		padding: var(--vn-space-3) 0;
+		margin-bottom: 0;
+		line-height: var(--vn-line-body);
+		color: var(--bs-body-color);
+		background-color: transparent;
+		border: solid transparent;
+		border-width: var(--bs-border-width) 0;
+	}
+
+	.form-control-plaintext:focus {
+		outline: 0;
+	}
+
+	// The resting textarea precedes the sized ones, because each writes its minimum height at the
+	// same specificity and the sized height must win on a control carrying both classes.
+	textarea.form-control {
+		min-height: calc(1.5em + calc(var(--vn-space-3) * 2) + calc(var(--bs-border-width) * 2));
+	}
+
+	// The sized rules follow the resting control and plaintext rules they override at equal
+	// specificity, and precede the color control, whose own padding the release keeps on a sized
+	// color control.
+	@each $size, $block, $inline, $step, $radius in $sizes {
+		.form-control-plaintext.form-control-#{$size} {
+			padding-right: 0;
+			padding-left: 0;
+		}
+
+		.form-control-#{$size} {
+			min-height: calc(1.5em + calc(#{$block} * 2) + calc(var(--bs-border-width) * 2));
+			padding: #{$block} #{$inline};
+			font-size: #{$step};
+			border-radius: #{$radius};
+		}
+
+		.form-control-#{$size}::file-selector-button {
+			padding: #{$block} #{$inline};
+			margin: calc(#{$block} * -1) calc(#{$inline} * -1);
+			-webkit-margin-end: #{$inline};
+			margin-inline-end: #{$inline};
+		}
+
+		textarea.form-control-#{$size} {
+			min-height: calc(1.5em + calc(#{$block} * 2) + calc(var(--bs-border-width) * 2));
+		}
+
+		.form-control-color.form-control-#{$size} {
+			height: calc(1.5em + calc(#{$block} * 2) + calc(var(--bs-border-width) * 2));
+		}
+	}
+
+	// The width is the release's own `3rem`, routed through the space token that holds it so the
+	// control keeps its proportion when density retunes the height beside it.
+	.form-control-color {
+		width: var(--vn-space-24);
+		height: calc(1.5em + calc(var(--vn-space-3) * 2) + calc(var(--bs-border-width) * 2));
+		padding: var(--vn-space-3);
+	}
+
+	.form-control-color:not(:disabled):not([readonly]) {
+		cursor: pointer;
+	}
+
+	@each $swatch in $swatches {
+		.form-control-color#{$swatch} {
+			border: 0;
+			border-radius: var(--bs-border-radius);
+		}
+	}
+}
