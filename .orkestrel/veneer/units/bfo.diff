--- /dev/null
+++ b/app/browser/sections/FormControlSection.ts
@@ -0,0 +1,20 @@
+import { FORM_CONTROL_COPY, FORM_CONTROL_SPECIMENS } from '../constants.js'
+import { SpecimenSection } from './SpecimenSection.js'
+
+/**
+ * Renders the declared text-control specimens into a named region.
+ * @example
+ * ```ts
+ * const section = new FormControlSection(document.body)
+ * section.destroy()
+ * ```
+ */
+export class FormControlSection extends SpecimenSection {
+	/**
+	 * Mounts the Form control region and its specimens.
+	 * @param host - The element receiving the section.
+	 */
+	constructor(host: HTMLElement) {
+		super(host, FORM_CONTROL_COPY, FORM_CONTROL_SPECIMENS)
+	}
+}
