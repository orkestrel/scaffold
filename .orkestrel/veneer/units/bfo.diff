+			const gauge = requireValue(host.querySelector('#focus-gauge'), 'No focus gauge')
+			// The transition is collapsed first, so the ring is read at its end state rather than
+			// part of the way through the release's quarter-second fade.
+			await stageMedia({ motion: false })
+			expect(readStyle(control, 'box-shadow')).toBe('none')
+			const reached = await traverseAccessible('Text entry')
+			expect(reached).toBe(control)
+			expect(control.matches(':focus-visible')).toBe(true)
