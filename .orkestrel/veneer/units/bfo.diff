+import type { SectionInterface } from '@app/browser'
+import {
+	FORM_CONTROL_COPY,
+	FORM_CONTROL_SPECIMENS,
+	FormControlSection,
+	SpecimenSection,
+} from '@app/browser'
+import { requireValue } from '@orkestrel/test'
+import { build, mount, readName, readStates } from '@orkestrel/test/browser'
+import { describe, expect, it } from 'vitest'
+
+describe('FormControlSection', () => {
+	it('renders every text-control form through the shared section contract', () => {
+		const host = mount(build('div'))
+		const section: SectionInterface = new FormControlSection(host)
+		try {
+			expect(section).toBeInstanceOf(SpecimenSection)
+			expect(section.host).toBe(host)
+			const region = requireValue(host.querySelector('section'), 'No Form control region')
+			expect(region.querySelector('[style]')).toBeNull()
+			expect(region.getAttribute('aria-label')).toBe('Form control')
+			expect(region.querySelector('p')?.textContent).toBe(FORM_CONTROL_COPY.paragraph)
+			const rendered = [...region.querySelectorAll('[data-specimen]')]
+			expect(rendered.map((element) => element.getAttribute('data-specimen'))).toEqual([
+				'Form control text',
+				'Form control small',
+				'Form control large',
+				'Form control textarea',
+				'Form control file',
+				'Form control color',
+				'Form control plaintext',
+				'Form control disabled',
