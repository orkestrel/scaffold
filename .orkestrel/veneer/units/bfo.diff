+import { FOCUS_RING, normalizeSelectorText } from '../../../setup.js'
+import { collectLayer, collectMediaConditions, scene } from '../../../setupBrowser.js'
+import {
+	extractShadowLayers,
+	FORM_CONTROL_CASES,
+	FORM_CONTROL_MARKUP,
+	TEXT_MODES,
+} from '../../../setupStyles.js'
