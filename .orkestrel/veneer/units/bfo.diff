+		} finally {
+			document.documentElement.style.removeProperty(TOKEN_NAMES.factor.motion)
+		}
+		// Under the staged preference both transitions collapse: a twin the partial stopped emitting
+		// would leave the resting durations in place here.
+		await stageMedia({ motion: false })
+		expect(matchMedia(MOTION).matches).toBe(true)
+		expect(readStyle(text, 'transition-property')).toBe('none')
+		expect(readStyle(file, 'transition-property', '::file-selector-button')).toBe('none')
+		await releaseMedia()
+		expect(readStyle(text, 'transition-property')).toBe('border-color, box-shadow')
+	})
