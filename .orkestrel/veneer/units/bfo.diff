+const MOTION = '(prefers-reduced-motion: reduce)'
+
+afterEach(async () => {
+	await releasePointer()
+	await releaseMedia()
+	document.documentElement.removeAttribute('data-bs-theme')
+	scene.clear()
+})
+
+describe('form control classes', () => {
+	it.each(
+		FORM_CONTROL_CASES.filter((entry) => entry.evidence === 'resolved').map((entry) => ({
+			...entry,
+			name: entry.condition === undefined ? entry.selector : `${entry.selector} under ${MOTION}`,
+		})),
+	)('resolves every declaration $name records on the control it matches', async (entry) => {
+		const host = scene.mount(`<div>${FORM_CONTROL_MARKUP}</div>`)
+		const control = requireValue(
+			host.querySelector(`[aria-label="${entry.subject}"]`),
+			`No ${entry.subject} control`,
+		)
+		// The reduced-motion twin is read under the staged preference, which is the only state its
+		// rule matches in; every other case is read with the preference left alone.
+		if (entry.condition !== undefined) await stageMedia({ motion: false })
+		if (entry.state === 'focus') await traverseAccessible(entry.subject)
+		if (entry.state === 'hover') await hoverAccessible(entry.subject)
+		// A driven case is read only once the control is in the state its selector names: keyboard
+		// traversal is what earns `:focus-visible`, and the pointer is what earns `:hover`.
+		const drive = { focus: ':focus-visible', hover: ':hover' } as const
+		expect(entry.state === undefined || control.matches(drive[entry.state])).toBe(true)
+		// Each value is the release's own declaration converted to what the browser resolves at the
+		// root size and a density factor of 1, so a rule that dropped a declaration or wrote another
+		// length reports its own reading beside the release's.
+		const read = Object.fromEntries(
+			Object.keys(entry.values).map((property) => [
+				property,
+				readStyle(control, property, entry.pseudo),
+			]),
+		)
+		expect(read).toStrictEqual(entry.values)
+	})
+
+	it('reads the date, time, and swatch parts through their declarations, because Chromium answers a part request with the control', () => {
+		const host = scene.mount(`<div>${FORM_CONTROL_MARKUP}</div>`)
+		const declared = FORM_CONTROL_CASES.filter((entry) => entry.evidence === 'declared')
+		expect(declared.length).toBeGreaterThan(0)
+		for (const entry of declared) {
+			const control = requireValue(
+				host.querySelector(`[aria-label="${entry.subject}"]`),
+				`No ${entry.subject} control`,
+			)
+			// The part reading is the control's own for every property the rule writes, which is what
+			// sends a part rule down the ladder: a resolved reading of the part is unavailable here, so
+			// the declaration the CSSOM carries is the evidence, and the frame corroborates it. A rule
+			// naming no part reads the control itself, so its reading is its own.
+			for (const property of Object.keys(entry.values))
+				expect(readStyle(control, property, entry.pseudo)).toBe(readStyle(control, property))
+			// The CSSOM writes the attribute value quoted, so the rule is matched through the selector
+			// normalization the registry proofs use rather than by the inventory's spelling.
+			const rule = requireValue(
+				readRules().flatMap((candidate) =>
+					candidate instanceof CSSStyleRule &&
+					normalizeSelectorText(candidate.selectorText) === normalizeSelectorText(entry.selector)
+						? [candidate]
+						: [],
+				)[0],
+				`The cascade carries no ${entry.selector} rule`,
+			)
+			for (const [property, value] of Object.entries(entry.values))
+				expect(rule.style.getPropertyValue(property)).toBe(value)
+		}
+		// The user agent clips every text and file control already, so the file rule's `overflow` is
+		// unobservable in the computed style: the bare file control reads the same `clip`.
+		const file = requireValue(host.querySelector('[aria-label="File entry"]'), 'No file entry')
+		const bare = requireValue(host.querySelector('[aria-label="Bare file entry"]'), 'No bare file')
+		expect(readStyle(file, 'overflow-x')).toBe(readStyle(bare, 'overflow-x'))
+		// Chromium discards a selector naming a Gecko part at parse time, so the CSSOM carries none of
+		// those rules and `tests/setupStyles.test.ts` reads them out of the compiled cascade instead.
+		// This is what reports an engine that starts keeping them.
+		const compiled = FORM_CONTROL_CASES.filter((entry) => entry.evidence === 'compiled')
+		expect(compiled.length).toBeGreaterThan(0)
+		expect(compiled.filter((entry) => findRule(entry.selector) !== undefined)).toEqual([])
+		// The prefixed file-button alias is withheld under every condition: the guide's deferral
+		// table records each of its selectors as excluded, and the standard part ships in its place.
+		expect(
+			readRules().filter(
+				(rule) =>
+					rule instanceof CSSStyleRule && rule.selectorText.includes('-webkit-file-upload-button'),
+			),
+		).toEqual([])
+		expect(findRule('.form-control::file-selector-button')).toBeDefined()
+	})
+
+	it('sizes the control from the space and size tokens, the density factor, and a direct override', () => {
+		const host = scene.mount(`<div>${FORM_CONTROL_MARKUP}</div>`)
+		const text = requireValue(host.querySelector('[aria-label="Text entry"]'), 'No text entry')
+		const bare = requireValue(host.querySelector('[aria-label="Bare entry"]'), 'No bare entry')
+		const file = requireValue(host.querySelector('[aria-label="File entry"]'), 'No file entry')
+		const note = requireValue(host.querySelector('[aria-label="Note"]'), 'No note')
+		const small = requireValue(host.querySelector('[aria-label="Small entry"]'), 'No small entry')
+		const color = requireValue(host.querySelector('[aria-label="Color choice"]'), 'No color choice')
+		// The control spans its container where the bare control keeps its intrinsic width.
+		expect(readPixels(text, 'width')).toBe(host.clientWidth)
+		expect(readPixels(bare, 'width')).toBeLessThan(host.clientWidth)
+		expect(readToken(text, TOKEN_NAMES.space[3])).toBe('calc(.375rem * 1)')
+		expect(readToken(text, TOKEN_NAMES.size[3])).toBe('1rem')
+		// The factor is set on the document element because that is where the space tokens compute.
+		// Every height here is the line box plus the doubled padding plus the doubled border, so a
+		// height written as the release's literal would stay put while the padding beside it moved.
+		document.documentElement.style.setProperty(TOKEN_NAMES.factor.density, '2')
+		try {
+			expect(readPixels(text, 'padding-top')).toBe(12)
+			expect(readPixels(text, 'padding-left')).toBe(24)
+			expect(readPixels(file, 'margin-top', '::file-selector-button')).toBe(-12)
+			expect(readPixels(file, 'margin-right', '::file-selector-button')).toBe(24)
+			expect(readPixels(note, 'min-height')).toBe(50)
+			expect(readPixels(small, 'min-height')).toBe(39)
+			expect(readPixels(color, 'width')).toBe(96)
+			expect(readPixels(color, 'height')).toBe(50)
+		} finally {
+			document.documentElement.style.removeProperty(TOKEN_NAMES.factor.density)
+		}
+		expect(readPixels(text, 'padding-top')).toBe(6)
+		expect(readPixels(note, 'min-height')).toBe(38)
+		// The tokens are retunable at any ancestor, which is the other half of the binding.
+		host.style.setProperty(TOKEN_NAMES.space[3], '1rem')
+		host.style.setProperty(TOKEN_NAMES.size[3], '1.25rem')
+		try {
+			expect(readPixels(text, 'padding-top')).toBe(16)
+			expect(readPixels(text, 'font-size')).toBe(20)
+			expect(readPixels(note, 'min-height')).toBe(24 * 1.25 + 32 + 2)
+		} finally {
+			host.style.removeProperty(TOKEN_NAMES.space[3])
+			host.style.removeProperty(TOKEN_NAMES.size[3])
+		}
+		expect(readPixels(text, 'padding-top')).toBe(6)
+		expect(readPixels(text, 'font-size')).toBe(16)
+	})
+
+	it.each(TEXT_MODES)(
+		'paints the focus ring from the focus tokens and tints the border within one channel step of the release in %s mode',
+		async (mode) => {
+			document.documentElement.setAttribute('data-bs-theme', mode)
+			const host = scene.mount(
+				`<div>${FORM_CONTROL_MARKUP}<div id="focus-gauge" style="width: var(--vn-focus-width); color: var(--vn-focus-color)"></div></div>`,
+			)
+			const control = requireValue(
+				host.querySelector<HTMLElement>('[aria-label="Text entry"]'),
+				'No text entry',
