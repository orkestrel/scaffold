+			'0.15s, 0.15s, 0.15s, 0.15s',
+		)
+		// The resting duration reads the motion token, so the published factor rescales it.
+		document.documentElement.style.setProperty(TOKEN_NAMES.factor.motion, '2')
+		try {
+			expect(readStyle(text, 'transition-duration')).toBe('0.3s, 0.3s')
