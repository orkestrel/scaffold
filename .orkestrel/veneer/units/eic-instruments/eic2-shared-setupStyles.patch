+ *
+ * @remarks
+ * The house rule matches the release, so the `elements` layer writes the contextual rules the
+ * release's reboot writes: `pre code` for code inside a block, `a > code` for code inside a link,
+ * and `kbd kbd` for a key inside a key. These pairs are the second exception, beside the
+ * {@link MANDATED_TAG_PAIRS} constant, to the rule that an `elements` rule treats a tag by its name.
+ * A pair belongs here only when the release's `scss/_reboot.scss` source writes it.
+ */
+export const RELEASE_TAG_PAIRS: ReadonlyArray<readonly [string, string]> = Object.freeze([
+	Object.freeze(['pre', 'code'] as const),
+	Object.freeze(['a', 'code'] as const),
