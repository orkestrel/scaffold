index 0000000..f70f5b2
--- /dev/null
+++ b/tests/src/styles/components/form-range.test.ts
@@ -0,0 +1,208 @@
+import { TOKEN_NAMES } from '@src/core'
+import { requireValue } from '@orkestrel/test'
+import {
+	findRule,
+	readPixels,
+	readRing,
+	readStyle,
+	readToken,
+	releaseMedia,
+	stageMedia,
+	traverseAccessible,
+} from '@orkestrel/test/browser'
+import { afterEach, describe, expect, it } from 'vitest'
+import { collectLayer, collectMediaConditions, scene } from '../../../setupBrowser.js'
+import { FORM_RANGE_CASES, FORM_RANGE_MARKUP } from '../../../setupStyles.js'
+
+const MOTION = '(prefers-reduced-motion: reduce)'
+
+afterEach(async () => {
+	await releaseMedia()
+	scene.clear()
+})
+
+describe('form range classes', () => {
+	it('strips the native slider chrome and sizes the host over the whole line', () => {
+		const host = scene.mount(`<div>${FORM_RANGE_MARKUP}</div>`)
+		const element = requireValue(host.querySelector('.form-range'), 'No range control')
+		const bare = requireValue(host.querySelector('input:not(.form-range)'), 'No bare control')
+		expect(readStyle(element, 'appearance')).toBe('none')
+		expect(readPixels(element, 'height')).toBe(24)
+		for (const side of ['top', 'right', 'bottom', 'left'])
+			expect(readPixels(element, `padding-${side}`)).toBe(0)
+		expect(readStyle(element, 'background-color')).toBe('rgba(0, 0, 0, 0)')
+		expect(readPixels(element, 'width')).toBe(host.clientWidth)
+		// The bare control is what tells the class apart from the slider a browser already paints:
+		// it keeps the native appearance, its own intrinsic width, its own height, and the fill the
+		// user agent gives it. A partial that stopped declaring any of the four would report the
+		// bare reading here.
+		expect(readStyle(bare, 'appearance')).toBe('auto')
+		expect(readPixels(bare, 'height')).not.toBe(24)
+		expect(readPixels(bare, 'width')).toBeLessThan(host.clientWidth)
+		expect(readStyle(bare, 'background-color')).not.toBe('rgba(0, 0, 0, 0)')
+	})
+
+	it('reads the host height from the space token, the density factor, and a direct override', () => {
+		const host = scene.mount(`<div>${FORM_RANGE_MARKUP}</div>`)
+		const element = requireValue(host.querySelector('.form-range'), 'No range control')
+		expect(readToken(element, TOKEN_NAMES.space[12])).toBe('calc(1.5rem * 1)')
+		// The factor is what the published density retune moves, and it is set on the document
+		// element because that is where the token computes: a factor set on the control itself
+		// would leave the already-computed height untouched.
+		document.documentElement.style.setProperty(TOKEN_NAMES.factor.density, '2')
+		try {
+			expect(readPixels(element, 'height')).toBe(48)
+		} finally {
+			document.documentElement.style.removeProperty(TOKEN_NAMES.factor.density)
+		}
+		expect(readPixels(element, 'height')).toBe(24)
+		// The token itself is retunable at any ancestor, which is the other half of the binding: a
+		// rule writing the release's literal would ignore both readings and stay at 24.
+		host.style.setProperty(TOKEN_NAMES.space[12], '3rem')
+		try {
+			expect(readPixels(element, 'height')).toBe(48)
+		} finally {
+			host.style.removeProperty(TOKEN_NAMES.space[12])
+		}
+		expect(readPixels(element, 'height')).toBe(24)
+	})
+
+	it('clears the control outline under keyboard focus and leaves the ring to the thumb', async () => {
+		const host = scene.mount(`<div>${FORM_RANGE_MARKUP}</div>`)
+		const element = requireValue(host.querySelector('.form-range'), 'No range control')
+		const bare = requireValue(host.querySelector('input:not(.form-range)'), 'No bare control')
+		const reached = await traverseAccessible('Range value')
+		expect(reached).toBe(element)
+		expect(element.matches(':focus-visible')).toBe(true)
+		expect(readStyle(element, 'outline-style')).toBe('none')
+		expect(readPixels(element, 'outline-width')).toBe(0)
+		// `readRing` reports the chrome the focused element itself wears. This control wears none:
+		// the ring is painted on `::-webkit-slider-thumb`, and Chromium exposes no computed style
+		// for that part, so no rendered ratio for this key is reachable on this host. The reading is
+		// recorded rather than worked around, and the frames the journey writes are what show it.
+		expect(readRing(element)).toBeUndefined()
+		// The bare control keeps the user agent's own ring, which is what the `outline: 0`
+		// declaration removes.
+		const bareReached = await traverseAccessible('Bare range value')
+		expect(bareReached).toBe(bare)
+		expect(readStyle(bare, 'outline-style')).toBe('auto')
+		// The declaration the ring is made of binds the same focus pair `_button.scss` binds, which
+		// is what keeps one retune of the focus token moving every ring this package paints.
+		const ring = requireValue(
+			findRule('.form-range:focus::-webkit-slider-thumb'),
+			'The cascade carries no focused thumb rule',
+		)
+		const shadow = ring.style.getPropertyValue('box-shadow')
+		expect(shadow).toContain(`var(${TOKEN_NAMES.focus.width})`)
+		expect(shadow).toContain(`var(${TOKEN_NAMES.focus.color})`)
+		expect(shadow).toContain(`var(${TOKEN_NAMES.surface.body.base})`)
+		const button = requireValue(findRule('.btn'), 'The cascade carries no button rule')
+		const bound = button.style.getPropertyValue('--bs-btn-focus-box-shadow')
+		expect(bound).toContain(`var(${TOKEN_NAMES.focus.width})`)
+		expect(bound).toContain(`var(${TOKEN_NAMES.focus.color})`)
+	})
+
+	it('keeps the WebKit part rules in the cascade and reports the host style for a part pseudo', () => {
+		const host = scene.mount(`<div>${FORM_RANGE_MARKUP}</div>`)
+		const element = requireValue(host.querySelector('.form-range'), 'No range control')
+		const kept = FORM_RANGE_CASES.filter((entry) => entry.engine !== 'gecko')
+		expect(kept.filter((entry) => findRule(entry.selector) === undefined)).toEqual([])
+		for (const entry of kept) {
+			const declared = requireValue(
+				findRule(entry.selector),
+				`The cascade carries no ${entry.selector} rule`,
+			).style.cssText
+			expect([...entry.reads].filter((name) => !declared.includes(`var(${name})`))).toEqual([])
+		}
+		// Chromium discards a selector naming a Gecko pseudo-element at parse time, so the CSSOM
+		// carries none of those rules and no reading taken in this browser reaches them. They are
+		// read out of the compiled cascade in `tests/setupStyles.test.ts` instead. This assertion is
+		// what reports an engine that starts keeping them, so the reading moves back in here.
+		expect(
+			FORM_RANGE_CASES.filter(
+				(entry) => entry.engine === 'gecko' && findRule(entry.selector) !== undefined,
+			),
+		).toEqual([])
+		// Chromium answers a computed-style request for a slider part with the host's own resolved
+		// style rather than the part's, so the resolved reading is unavailable for the thumb as
+		// well: the width comes back as the control's line width rather than the declared 1rem.
+		expect(readStyle(element, 'width', '::-webkit-slider-thumb')).toBe(readStyle(element, 'width'))
+		expect(readPixels(element, 'width', '::-webkit-slider-thumb')).toBe(host.clientWidth)
+	})
+
+	it('gates the thumb transition on the reduced-motion preference and reads it from the motion tokens', async () => {
+		const host = scene.mount(`<div>${FORM_RANGE_MARKUP}</div>`)
+		const element = requireValue(host.querySelector('.form-range'), 'No range control')
+		const rules = collectLayer('components')
+		expect(collectMediaConditions(rules, '.form-range::-webkit-slider-thumb')).toEqual([MOTION])
+		const gated = rules.flatMap((rule) =>
+			rule instanceof CSSMediaRule && rule.conditionText === MOTION
+				? [...rule.cssRules].flatMap((nested) =>
+						nested instanceof CSSStyleRule &&
+						nested.selectorText === '.form-range::-webkit-slider-thumb'
+							? [nested.style]
+							: [],
+					)
+				: [],
+		)
+		const declarations = requireValue(gated[0], 'No gated thumb rule')
+		expect(gated).toHaveLength(1)
+		// The shorthand arrives expanded, so this names the axis the collapse acts on rather than
+		// the text the source wrote: a gated rule declaring anything beyond the transition longhands
+		// would report here.
+		expect([...declarations].filter((name) => !name.startsWith('transition-'))).toEqual([])
+		expect(declarations.getPropertyValue('transition-property')).toBe('none')
+		expect(declarations.getPropertyValue('transition-duration')).toBe('0s')
+		// The staged preference is read through the condition the gated rule keys on, because the
+		// transition itself sits on a part whose computed style this engine does not expose: the
+		// resolved collapse is unreachable here and the declaration above is what carries it.
+		expect(matchMedia(MOTION).matches).toBe(false)
+		await stageMedia({ motion: false })
+		expect(matchMedia(MOTION).matches).toBe(true)
+		await releaseMedia()
+		expect(matchMedia(MOTION).matches).toBe(false)
+		// The resting duration reads the motion token, so the published factor rescales it.
+		expect(readToken(element, TOKEN_NAMES.motion.feedback)).toBe('calc(.15s * 1)')
+		document.documentElement.style.setProperty(TOKEN_NAMES.factor.motion, '2')
+		try {
+			expect(readToken(element, TOKEN_NAMES.motion.feedback)).toBe('calc(.15s * 2)')
+		} finally {
+			document.documentElement.style.removeProperty(TOKEN_NAMES.factor.motion)
+		}
+	})
+
+	it('retunes the thumb fill and the track fill with the color mode and with a direct override', () => {
+		const host = scene.mount(
+			`<div><div>${FORM_RANGE_MARKUP}</div><div data-bs-theme="dark">${FORM_RANGE_MARKUP}</div></div>`,
+		)
+		const controls = [...host.querySelectorAll('.form-range')]
+		const light = requireValue(controls[0], 'No light range control')
+		const dark = requireValue(controls[2], 'No dark range control')
+		// Each value the part rules name is read where the part reads it, on the control itself:
+		// the rules paint a part whose computed style this engine withholds, and the custom
+		// property behind each declaration resolves on the host by inheritance.
+		for (const name of [
+			TOKEN_NAMES.color.primary.base,
+			'--bs-secondary-bg',
+			'--bs-secondary-color',
+		]) {
+			expect(readToken(light, name)).not.toBe('')
+			expect(readToken(dark, name)).not.toBe(readToken(light, name))
+		}
+		// The palette entry the held thumb mixes over is mode-independent, which is why the held
+		// fill lightens the same way in either mode.
+		expect(readToken(dark, TOKEN_NAMES.palette.white.base)).toBe(
+			readToken(light, TOKEN_NAMES.palette.white.base),
+		)
+		// The track reads a Bootstrap global, so a consumer retunes it at any ancestor without
+		// touching the partial.
+		const wrapper = requireValue(light.parentElement, 'No wrapper around the light control')
+		wrapper.style.setProperty('--bs-secondary-bg', 'rgb(1, 2, 3)')
+		try {
+			expect(readToken(light, '--bs-secondary-bg')).toBe('rgb(1, 2, 3)')
+		} finally {
+			wrapper.style.removeProperty('--bs-secondary-bg')
+		}
+		expect(readToken(light, '--bs-secondary-bg')).not.toBe('rgb(1, 2, 3)')
+	})
+})
