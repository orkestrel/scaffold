diff --git a/src/styles/components/_form-range.scss b/src/styles/components/_form-range.scss
new file mode 100644
index 0000000..c4caf47
--- /dev/null
+++ b/src/styles/components/_form-range.scss
@@ -0,0 +1,91 @@
+@use '../mixins' as *;
+
+// Names each engine's thumb and track pseudo-element, and whether that engine's thumb carries the
+// track-centring offset. WebKit lays the thumb against the top of a track that fills the control,
+// so the thumb is pulled up by half the difference between the two heights; Gecko centres its own
+// thumb and takes no offset. A selector naming one engine's pseudo-element is dropped whole by the
+// other, so a grouped selector would style neither: Bootstrap writes the family out once per
+// engine for that reason, and this list is what emits the same rules from one declaration of them.
+$engines: (
+	('::-webkit-slider-thumb', '::-webkit-slider-runnable-track', true),
+	('::-moz-range-thumb', '::-moz-range-track', false)
+);
+
+@layer components {
+	.form-range {
+		@include flush-box;
+		height: var(--vn-space-12);
+		appearance: none;
+		background-color: transparent;
+	}
+
+	.form-range:focus {
+		outline: 0;
+	}
+
+	.form-range::-moz-focus-outer {
+		border: 0;
+	}
+
+	.form-range:disabled {
+		pointer-events: none;
+	}
+
+	@each $thumb, $track, $offset in $engines {
+		// The ring is worn by the thumb rather than by the control, so the hairline underneath it
+		// separates the ring from the track the thumb sits on. Its width is Bootstrap's own
+		// literal rather than the border-width token, because the release writes a literal there
+		// too and a token would invent a retune the release does not offer; its paint is the body
+		// surface, which is the variable the release compiles to `#fff`.
+		.form-range:focus#{$thumb} {
+			box-shadow:
+				0 0 0 1px var(--vn-surface-body-base),
+				0 0 0 var(--vn-focus-width) var(--vn-focus-color);
+		}
+
+		.form-range#{$thumb} {
+			width: var(--vn-space-8);
+			height: var(--vn-space-8);
+			@if $offset {
+				margin-top: calc(var(--vn-space-2) * -1);
+			}
+			appearance: none;
+			background-color: var(--vn-color-primary-base);
+			border: 0;
+			border-radius: var(--vn-radius-xlarge);
+			@include transition(
+				(
+					background-color var(--vn-motion-feedback) var(--vn-ease-standard),
+					border-color var(--vn-motion-feedback) var(--vn-ease-standard),
+					box-shadow var(--vn-motion-feedback) var(--vn-ease-standard)
+				)
+			);
+		}
+
+		// The held thumb lightens to three tenths of the role fill over the white palette entry,
+		// which is the tint the release bakes into its own literal.
+		.form-range#{$thumb}:active {
+			background-color: color-mix(
+				in srgb,
+				var(--vn-color-primary-base) 30%,
+				var(--vn-palette-white-base)
+			);
+		}
+
+		.form-range#{$track} {
+			width: 100%;
+			height: var(--vn-space-4);
+			color: transparent;
+			cursor: pointer;
+			background-color: var(--bs-secondary-bg);
+			border-color: transparent;
+			border-radius: var(--vn-radius-xlarge);
+		}
+
+		// The disabled paint follows the focus and active rules at equal specificity, so a control
+		// that is both focused and disabled reads this one.
+		.form-range:disabled#{$thumb} {
+			background-color: var(--bs-secondary-color);
+		}
+	}
+}
