 		}),
 	),
 )
+
+/** Holds the Form range section's visible copy and accessible name. */
+export const FORM_RANGE_COPY = Object.freeze({
+	region: 'Form range',
+	paragraph:
+		'Compare the slider at rest and unavailable: its track, its thumb, and the ring keyboard focus paints on that thumb.',
+})
+
+/**
+ * Lists the range specimens the section renders, in render order.
+ *
+ * @remarks
+ * Each control carries its own accessible name, because the journey reaches the resting slider by
+ * name through keyboard traversal and a shared name would resolve to either control. The bounds
+ * and the starting value are written out so the thumb lands mid-track, where a frame shows the
+ * track on both sides of it.
+ */
+export const FORM_RANGE_SPECIMENS: readonly MarkupSpecimen[] = Object.freeze([
+	Object.freeze({
+		name: 'Range',
+		markup:
+			'<input class="form-range" type="range" aria-label="Range value" min="0" max="100" value="50">',
+	}),
+	Object.freeze({
+		name: 'Range disabled',
+		markup:
+			'<input class="form-range" type="range" aria-label="Unavailable range value" min="0" max="100" value="50" disabled="">',
+	}),
+])
