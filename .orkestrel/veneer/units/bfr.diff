diff --git a/app/browser/sections/FormRangeSection.ts b/app/browser/sections/FormRangeSection.ts
new file mode 100644
index 0000000..47bc5ba
--- /dev/null
+++ b/app/browser/sections/FormRangeSection.ts
@@ -0,0 +1,20 @@
+import { FORM_RANGE_COPY, FORM_RANGE_SPECIMENS } from '../constants.js'
+import { SpecimenSection } from './SpecimenSection.js'
+
+/**
+ * Renders the declared range specimens into a named region.
+ * @example
+ * ```ts
+ * const section = new FormRangeSection(document.body)
+ * section.destroy()
+ * ```
+ */
+export class FormRangeSection extends SpecimenSection {
+	/**
+	 * Mounts the Form range region and its specimens.
+	 * @param host - The element receiving the section.
+	 */
+	constructor(host: HTMLElement) {
+		super(host, FORM_RANGE_COPY, FORM_RANGE_SPECIMENS)
+	}
+}
