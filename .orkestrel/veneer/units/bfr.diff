@@ -0,0 +1,73 @@
+import type { SectionInterface } from '@app/browser'
+import {
+	FORM_RANGE_COPY,
+	FORM_RANGE_SPECIMENS,
+	FormRangeSection,
+	SpecimenSection,
+} from '@app/browser'
+import { requireValue } from '@orkestrel/test'
+import { build, mount, readName, readStates } from '@orkestrel/test/browser'
+import { describe, expect, it } from 'vitest'
+
+describe('FormRangeSection', () => {
+	it('renders the resting and unavailable sliders through the shared section contract', () => {
+		const host = mount(build('div'))
+		const section: SectionInterface = new FormRangeSection(host)
+		try {
+			expect(section).toBeInstanceOf(SpecimenSection)
+			expect(section.host).toBe(host)
+			const region = requireValue(host.querySelector('section'), 'No Form range region')
+			expect(region.querySelector('[style]')).toBeNull()
+			expect(region.getAttribute('aria-label')).toBe('Form range')
+			expect(region.querySelector('p')?.textContent).toBe(FORM_RANGE_COPY.paragraph)
+			const rendered = [...region.querySelectorAll('[data-specimen]')]
+			expect(rendered.map((element) => element.getAttribute('data-specimen'))).toEqual([
+				'Range',
+				'Range disabled',
+			])
+			expect(rendered.map((element) => element.innerHTML)).toEqual(
+				FORM_RANGE_SPECIMENS.map(({ markup }) => markup),
+			)
+			// Each control is a slider carrying the class the partial paints, and each announces a
+			// name of its own: the journey reaches the resting one by name through keyboard
+			// traversal, which a shared name would resolve to either control.
+			const controls = [...region.querySelectorAll('input.form-range')]
+			expect(controls).toHaveLength(2)
+			expect(controls.map((element) => element.getAttribute('type'))).toEqual(['range', 'range'])
+			expect(controls.map((element) => readName(element))).toEqual([
+				'Range value',
+				'Unavailable range value',
+			])
+			expect(new Set(controls.map((element) => readName(element))).size).toBe(controls.length)
+			// The unavailable control declares that state in the markup rather than through a class,
+			// so the disabled thumb rule has a host to paint at rest and the capture needs no drive.
+			const [resting, unavailable] = controls
+			expect(readStates(requireValue(resting, 'No resting slider'))).toEqual([])
+			expect(readStates(requireValue(unavailable, 'No unavailable slider'))).toEqual(['disabled'])
+			expect(Object.isFrozen(FORM_RANGE_COPY)).toBe(true)
+			expect(Object.isFrozen(FORM_RANGE_SPECIMENS)).toBe(true)
+			expect(FORM_RANGE_SPECIMENS.every((entry) => Object.isFrozen(entry))).toBe(true)
+		} finally {
+			section.destroy()
+			host.remove()
+		}
+	})
+
+	it('releases the region and preserves adjacent content on repeated destruction', () => {
+		const host = mount(build('div'))
+		const neighbor = build('p', { text: 'Existing content' })
+		host.append(neighbor)
+		const section: SectionInterface = new FormRangeSection(host)
+		try {
+			const region = requireValue(host.querySelector('section'), 'No Form range region')
+			expect(region.isConnected).toBe(true)
+			section.destroy()
+			expect(region.isConnected).toBe(false)
+			section.destroy()
+			expect([...host.children]).toEqual([neighbor])
+		} finally {
+			section.destroy()
+			host.remove()
+		}
+	})
+})
