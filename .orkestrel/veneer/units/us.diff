+
+// Calls the utility mixins the way a utility partial does: one `breakpoint-each` walk that includes
+// every entry at every infix, then the custom-property mixin outside the walk. The entries cover a
+// responsive entry, a static entry, an entry with no class, an entry keyed `null`, a list-valued
+// entry, and an entry carrying a local, so the proof reads each naming and priority branch from the
+// selectors and declarations the mixins emitted. Every name carries `vn-utility-`, which the proof
+// filters on and the shipped cascade never writes.
+@include breakpoint-each using ($infix, $_boundary) {
+	@include utility(
+		vn-utility-gap,
+		column-gap,
+		(
+			0: 0,
+			1: 1px,
+		),
+		$infix,
+		true
+	);
+	@include utility(
+		vn-utility-static,
+		padding-top,
+		(
+			1: 1px,
+		),
+		$infix
+	);
+	@include utility(
+		'',
+		visibility,
+		(
+			vn-utility-visible: visible,
+			vn-utility-invisible: hidden,
+		),
+		$infix
+	);
+	@include utility(
+		vn-utility-border,
+		border-top-width,
+		(
+			null: 3px,
+			0: 0,
+		),
+		$infix
+	);
+	@include utility(vn-utility-align, vertical-align, top middle, $infix);
