--- a/src/styles/_mixins.scss
+++ b/src/styles/_mixins.scss
@@ -1,4 +1,5 @@
 @use 'sass:map';
+@use 'sass:meta';
 
 @mixin alias-gutters {
 	--bs-gutter-x: var(--vn-gutter-x);
@@ -333,3 +334,62 @@
 	--bs-carousel-caption-color: #{map.get($values, 'carousel-caption')};
 	--bs-carousel-control-icon-filter: #{map.get($values, 'carousel-icon-filter')};
 }
+
+// Emits one utility class per entry of `$values`, named the way the release's utility API names it:
+// the class, then the infix, then a hyphen and the value's key. A `null` key adds no modifier, so a
+// value keyed `null` emits the bare class, and an empty `$class` at the empty infix emits the key
+// alone with no leading hyphen. `$values` is a map from key to value, or a list whose every member
+// is both its key and its value.
+//
+// Every property in `$properties` carries the `!important` the release writes on a utility, and
+// every entry of `$locals` is written first as a normal `--bs-*` declaration the properties can read.
+// A partial walks `breakpoint-each` once and includes each entry at every infix it yields, in the
+// release's map order; an entry that is not `$responsive` emits at the empty infix alone, so the
+// walk emits it once, ahead of every media block, as the release does.
+@mixin utility($class, $properties, $values, $infix: '', $responsive: false, $locals: ()) {
+	@if $responsive or $infix == '' {
+		$pairs: $values;
+		@if meta.type-of($values) != 'map' {
+			$pairs: ();
+			@each $value in $values {
+				$pairs: map.set($pairs, $value, $value);
+			}
+		}
+		@each $key, $value in $pairs {
+			$name: $class + $infix;
+			@if $key != null {
+				@if $name != '' {
+					$name: $name + '-';
+				}
+				$name: $name + $key;
+			}
+			.#{$name} {
+				@each $local, $setting in $locals {
+					--bs-#{$local}: #{$setting};
+				}
+				@each $property in $properties {
+					#{$property}: $value !important;
+				}
+			}
+		}
+	}
+}
+
+// Emits one class per entry of the `$values` map that sets the `--bs-{$variable}` custom property to
+// the entry's value, named as the `utility` mixin names a class at the empty infix. The declaration
+// is normal, as the release writes a `css-var` utility, so a rule reading the variable decides its
+// own priority.
+@mixin utility-variable($class, $variable, $values) {
+	@each $key, $value in $values {
+		$name: $class;
+		@if $key != null {
+			@if $name != '' {
+				$name: $name + '-';
+			}
+			$name: $name + $key;
+		}
+		.#{$name} {
+			--bs-#{$variable}: #{$value};
+		}
+	}
+}
