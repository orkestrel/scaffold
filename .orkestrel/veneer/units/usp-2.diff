+import { TOKEN_NAMES } from '@src/core'
+import { requireValue } from '@orkestrel/test'
+import { findRule, readPixels } from '@orkestrel/test/browser'
+import { afterEach, describe, expect, it } from 'vitest'
+import { scene, visitBreakpoint } from '../../../setupBrowser.js'
+import {
+	BREAKPOINT_INFIXES,
+	GRID_BREAKPOINT_CASES,
+	PLACEMENT_BOX,
+	PLACEMENT_CONTAINER,
+	SPACING_PROPERTY_CASES,
+	SPACING_SIDE_CASES,
+	SPACING_STEP_CASES,
+} from '../../../setupStyles.js'
+
+// The sides the shorthand entry sets, which are every side a computed style reports for a spacing
+// property, in the shorthand's own order.
+const SIDES = requireValue(
+	SPACING_SIDE_CASES.find(({ suffix }) => suffix === ''),
+	'No shorthand entry',
+).sides
+
+afterEach(() => {
+	scene.clear()
+})
+
+describe('spacing utilities', () => {
+	it.each(GRID_BREAKPOINT_CASES)(
+		'resolves every side and step around the $name boundary',
+		async ({ name, boundary, readings }) => {
+			const infix = boundary === 0 ? '' : `-${name}`
+			// Each box sits alone in a flex container of definite size, so an `auto` margin absorbs the
+			// container's free space on its axis rather than resolving to zero, and every other step
+			// reads as the length it sets.
+			const classes = SPACING_PROPERTY_CASES.flatMap(({ prefix, auto }) =>
+				SPACING_SIDE_CASES.flatMap(({ suffix }) =>
+					[...SPACING_STEP_CASES.map(({ step }) => String(step)), ...(auto ? ['auto'] : [])].map(
+						(step) => `${prefix}${suffix}${infix}-${step}`,
+					),
+				),
+			)
+			const host = scene.mount(
+				classes
+					.map(
+						(listed) =>
+							`<div style="${PLACEMENT_CONTAINER}; display: flex"><div class="${listed}" style="${PLACEMENT_BOX}"></div></div>`,
+					)
+					.join(''),
+			)
+			for (const viewport of readings) {
+				const reading = await visitBreakpoint(viewport, () => ({
+					width: window.innerWidth,
+					sides: SPACING_PROPERTY_CASES.flatMap(({ property, prefix, auto }) =>
+						SPACING_SIDE_CASES.flatMap(({ suffix, sides }) =>
+							[
+								...SPACING_STEP_CASES.map(({ step, pixels }) => [String(step), pixels] as const),
+								...(auto ? [['auto', undefined] as const] : []),
+							].map(([step, pixels]) => {
+								const box = requireValue(
+									host.querySelector(`.${prefix}${suffix}${infix}-${step}`),
+									`No .${prefix}${suffix}${infix}-${step}`,
+								)
+								return {
+									name: `${prefix}${suffix}${infix}-${step}`,
+									read: SIDES.map((side) => readPixels(box, `${property}-${side}`)),
+									// An `auto` margin shares its axis's free space with the other `auto`
+									// margin on that axis: the 380px left beside the 20px box, and the 190px
+									// left above and below the 10px box.
+									expected: SIDES.map((side) => {
+										if (viewport < boundary || !sides.includes(side)) return 0
+										if (pixels !== undefined) return pixels
+										const axis =
+											side === 'top' || side === 'bottom' ? ['top', 'bottom'] : ['right', 'left']
+										const free = axis[0] === 'top' ? 190 : 380
+										return free / axis.filter((edge) => sides.includes(edge)).length
+									}),
+								}
+							}),
+						),
+					),
+				}))
+				expect(reading.width).toBe(viewport)
+				expect(
+					reading.sides.filter(({ read, expected }) => read.join() !== expected.join()),
+				).toEqual([])
+				expect(reading.sides).toHaveLength(classes.length)
+			}
+		},
+	)
+
+	it('writes the end and start sides as the physical right and left sides in either direction', () => {
+		const host = scene.mount(
+			'<div dir="rtl"><div class="me-3 ps-2"></div></div><div dir="ltr"><div class="me-3 ps-2"></div></div>',
+		)
+		for (const box of host.querySelectorAll('.me-3')) {
+			expect([readPixels(box, 'margin-right'), readPixels(box, 'margin-left')]).toEqual([16, 0])
+			expect([readPixels(box, 'padding-left'), readPixels(box, 'padding-right')]).toEqual([8, 0])
+		}
+		expect(host.querySelectorAll('.me-3')).toHaveLength(2)
+	})
+
+	it('resolves a later entry over an earlier one at one infix, and a wider infix over a narrower one', async () => {
+		// The release writes every entry inside each boundary's block, in its map order, so at one
+		// infix a side entry follows the shorthand entry, and a wider infix's block follows every
+		// narrower one whichever entry each class belongs to.
+		const host = scene.mount(
+			'<div class="p-3 px-1"></div><div class="m-3 ms-1"></div><div class="m-md-3 mx-sm-1"></div>',
+		)
+		const padded = requireValue(host.querySelector('.px-1'), 'No padding pair')
+		const margined = requireValue(host.querySelector('.ms-1'), 'No margin pair')
+		const widths = requireValue(host.querySelector('.m-md-3'), 'No responsive pair')
+		expect(SIDES.map((side) => readPixels(padded, `padding-${side}`))).toEqual([16, 4, 16, 4])
+		expect(SIDES.map((side) => readPixels(margined, `margin-${side}`))).toEqual([16, 16, 16, 4])
+		// Each visit resizes the one page viewport, so the readings run one after the other.
+		const below = await visitBreakpoint(767, () =>
+			SIDES.map((side) => readPixels(widths, `margin-${side}`)),
+		)
+		const at = await visitBreakpoint(768, () =>
+			SIDES.map((side) => readPixels(widths, `margin-${side}`)),
+		)
+		expect([below, at]).toEqual([
+			[0, 4, 0, 4],
+			[16, 16, 16, 16],
+		])
+	})
+
+	it('reads each step from its space token, so the density factor and a retuned token move every side', () => {
+		const host = scene.mount(
+			SPACING_PROPERTY_CASES.flatMap(({ prefix }) =>
+				SPACING_SIDE_CASES.flatMap(({ suffix }) =>
+					SPACING_STEP_CASES.map(
+						({ step }) => `<div class="${prefix}${suffix}-${String(step)}"></div>`,
+					),
+				),
+			).join(''),
+		)
+		const scaled = SPACING_STEP_CASES.filter(({ token }) => token !== undefined)
+		expect(scaled).toHaveLength(SPACING_STEP_CASES.length - 1)
+		try {
+			// Each phase reads every side of every step: at rest, with the density factor doubled,
+			// and with the factor back and each token retuned one pixel past its resting length. The
+			// zero step reads no token, so it stays zero in every phase.
+			for (const phase of ['rest', 'density', 'retune'] as const) {
+				if (phase === 'density')
+					document.documentElement.style.setProperty(TOKEN_NAMES.factor.density, '2')
+				if (phase === 'retune') {
+					document.documentElement.style.removeProperty(TOKEN_NAMES.factor.density)
+					for (const { token, pixels } of scaled)
+						host.style.setProperty(requireValue(token, 'No step token'), `${String(pixels + 1)}px`)
+				}
+				const misses = SPACING_PROPERTY_CASES.flatMap(({ property, prefix }) =>
+					SPACING_SIDE_CASES.flatMap(({ suffix, sides }) =>
+						SPACING_STEP_CASES.flatMap(({ step, pixels, token }) => {
+							const name = `${prefix}${suffix}-${String(step)}`
+							const box = requireValue(host.querySelector(`.${name}`), `No .${name}`)
+							const expected =
+								token === undefined
+									? 0
+									: phase === 'retune'
+										? pixels + 1
+										: phase === 'density'
+											? pixels * 2
+											: pixels
+							return sides.flatMap((side) => {
+								const read = readPixels(box, `${property}-${side}`)
+								return read === expected ? [] : [`${name} ${side}: ${String(read)}`]
+							})
+						}),
+					),
+				)
+				expect({ phase, misses }).toEqual({ phase, misses: [] })
+			}
+		} finally {
+			document.documentElement.style.removeProperty(TOKEN_NAMES.factor.density)
+		}
+	})
+
+	it('writes no negative margin at any infix', () => {
+		// The control is a recorded step the same lookup finds, so an empty result is the absence of
+		// the negative steps rather than a lookup that finds nothing.
+		const keys = SPACING_SIDE_CASES.map(({ suffix }) => `m${suffix}`)
+		expect(keys.filter((key) => findRule(`.${key}-1`) === undefined)).toEqual([])
+		expect(
+			keys.flatMap((key) =>
+				['', ...BREAKPOINT_INFIXES.map((infix) => `-${infix}`)].flatMap((infix) =>
+					findRule(`.${key}${infix}-n`) === undefined ? [] : [`${key}${infix}-n`],
+				),
+			),
+		).toEqual([])
+		const host = scene.mount('<div class="m-n1 mt-n3"></div>')
+		const box = requireValue(host.querySelector('.m-n1'), 'No negative box')
+		expect(SIDES.map((side) => readPixels(box, `margin-${side}`))).toEqual([0, 0, 0, 0])
+	})
+
+	it('resolves the same steps inside a dark island', () => {
+		const host = scene.mount(
+			'<div data-bs-theme="dark"><div class="m-3 p-2"></div><div class="mx-5 py-4"></div></div>',
+		)
+		const both = requireValue(host.querySelector('.m-3'), 'No shorthand box')
+		const sides = requireValue(host.querySelector('.mx-5'), 'No side box')
+		expect(SIDES.map((side) => readPixels(both, `margin-${side}`))).toEqual([16, 16, 16, 16])
+		expect(SIDES.map((side) => readPixels(both, `padding-${side}`))).toEqual([8, 8, 8, 8])
+		expect(SIDES.map((side) => readPixels(sides, `margin-${side}`))).toEqual([0, 48, 0, 48])
+		expect(SIDES.map((side) => readPixels(sides, `padding-${side}`))).toEqual([24, 0, 24, 0])
+	})
+
+	it('keeps every side over a later unlayered consumer rule', () => {
+		const host = scene.mount(
+			'<div class="probe m-3 p-2"></div><div class="probe mt-4 pe-1"></div><div class="probe"></div>',
+		)
+		scene.load('.probe { margin: 7px; padding: 7px }')
+		const baseline = requireValue(host.querySelector('.probe:not([class*="-"])'), 'No consumer box')
+		const both = requireValue(host.querySelector('.m-3'), 'No shorthand box')
+		const sides = requireValue(host.querySelector('.mt-4'), 'No side box')
+		expect(SIDES.map((side) => readPixels(baseline, `margin-${side}`))).toEqual([7, 7, 7, 7])
+		expect(SIDES.map((side) => readPixels(both, `margin-${side}`))).toEqual([16, 16, 16, 16])
+		expect(SIDES.map((side) => readPixels(both, `padding-${side}`))).toEqual([8, 8, 8, 8])
+		// A side utility wins its own side alone, and the consumer rule keeps every other side.
+		expect(SIDES.map((side) => readPixels(sides, `margin-${side}`))).toEqual([24, 7, 7, 7])
+		expect(SIDES.map((side) => readPixels(sides, `padding-${side}`))).toEqual([7, 4, 7, 7])
+	})
+
+	it('yields to an important override inside the utilities layer and to no unlayered one', () => {
+		const host = scene.mount('<div class="m-3 px-2"></div>')
+		const box = requireValue(host.querySelector('.m-3'), 'No box')
+		// An unlayered `!important` declaration sorts after every layered one, so the shipped utility
+		// keeps its step; the same declaration re-opened inside the utilities layer arrives after the
+		// shipped rule in that layer and wins.
+		scene.load('.m-3 { margin-top: 9px !important } .px-2 { padding-left: 9px !important }')
+		expect([readPixels(box, 'margin-top'), readPixels(box, 'padding-left')]).toEqual([16, 8])
+		scene.load(
+			'@layer utilities { .m-3 { margin-top: 9px !important } .px-2 { padding-left: 9px !important } }',
+		)
+		expect([readPixels(box, 'margin-top'), readPixels(box, 'padding-left')]).toEqual([9, 9])
+		expect([readPixels(box, 'margin-left'), readPixels(box, 'padding-right')]).toEqual([16, 8])
+	})
+})
