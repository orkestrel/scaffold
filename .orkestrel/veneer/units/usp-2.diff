+import { SPACING_COPY, SPACING_SPECIMENS } from '../constants.js'
+import { SpecimenSection } from './SpecimenSection.js'
+
+/**
+ * Renders the declared margin, padding, auto margin, and responsive spacing specimens into a named
+ * Spacing region.
+ *
+ * @example
+ * ```ts
+ * const section = new SpacingSection(document.body)
+ * section.destroy()
+ * ```
+ */
+export class SpacingSection extends SpecimenSection {
+	/**
+	 * Mounts the Spacing region and its specimens in table order.
+	 * @param host - The element receiving the section.
+	 */
+	constructor(host: HTMLElement) {
+		super(host, SPACING_COPY, SPACING_SPECIMENS)
+	}
+}
