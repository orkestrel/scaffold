index 0000000..789a3e1
--- /dev/null
+++ b/src/styles/utilities/_interaction.scss
@@ -0,0 +1,11 @@
+@use '../mixins' as *;
+
+@layer utilities {
+	// Neither of the release's interaction entries is responsive, so the walk writes each at the
+	// empty infix alone, ahead of every media block. The pointer-events entry shares the `pe` class
+	// with the padding-end entry, and its `none` and `auto` keys are what keep the two apart.
+	@include breakpoint-each using ($infix, $_boundary) {
+		@include utility(user-select, user-select, (all, auto, none), $infix);
+		@include utility(pe, pointer-events, (none, auto), $infix);
+	}
+}
diff --git a/src/styles/utilities/_spacing.scss b/src/styles/utilities/_spacing.scss
new file mode 100644
index 0000000..ba19dc5
--- /dev/null
+++ b/src/styles/utilities/_spacing.scss
@@ -0,0 +1,41 @@
+@use 'sass:map';
+@use '../mixins' as *;
+
+@layer utilities {
+	// Stands in for the release's `$spacers` map. The zero step stays a literal, and each other step
+	// reads the density-scaled `--vn-space-*` token that resolves to the release's length, the scale
+	// the components' own internal space reads.
+	$spacers: (
+		0: 0,
+		1: var(--vn-space-2),
+		2: var(--vn-space-4),
+		3: var(--vn-space-8),
+		4: var(--vn-space-12),
+		5: var(--vn-space-24),
+	);
+	// The release merges an `auto` step into the margin entries alone.
+	$margins: map.merge(
+		$spacers,
+		(
+			auto: auto,
+		)
+	);
+	// The release's end and start entries write the physical right and left sides, so the partial
+	// writes those properties rather than the logical ones.
+	@include breakpoint-each using ($infix, $_boundary) {
+		@include utility(m, margin, $margins, $infix, true);
+		@include utility(mx, margin-right margin-left, $margins, $infix, true);
+		@include utility(my, margin-top margin-bottom, $margins, $infix, true);
+		@include utility(mt, margin-top, $margins, $infix, true);
+		@include utility(me, margin-right, $margins, $infix, true);
+		@include utility(mb, margin-bottom, $margins, $infix, true);
+		@include utility(ms, margin-left, $margins, $infix, true);
+		@include utility(p, padding, $spacers, $infix, true);
+		@include utility(px, padding-right padding-left, $spacers, $infix, true);
+		@include utility(py, padding-top padding-bottom, $spacers, $infix, true);
+		@include utility(pt, padding-top, $spacers, $infix, true);
+		@include utility(pe, padding-right, $spacers, $infix, true);
+		@include utility(pb, padding-bottom, $spacers, $infix, true);
+		@include utility(ps, padding-left, $spacers, $infix, true);
+	}
+}
