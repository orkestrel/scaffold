+import { INTERACTION_COPY, INTERACTION_SPECIMENS } from '../constants.js'
+import { SpecimenSection } from './SpecimenSection.js'
+
+/**
+ * Renders the declared text selection and pointer events specimens into a named Interaction region.
+ *
+ * @example
+ * ```ts
+ * const section = new InteractionSection(document.body)
+ * section.destroy()
+ * ```
+ */
+export class InteractionSection extends SpecimenSection {
+	/**
+	 * Mounts the Interaction region and its specimens in table order.
+	 * @param host - The element receiving the section.
+	 */
+	constructor(host: HTMLElement) {
+		super(host, INTERACTION_COPY, INTERACTION_SPECIMENS)
+	}
+}
