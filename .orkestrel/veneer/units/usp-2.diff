@@ -0,0 +1,112 @@
+import type { SectionInterface } from '@app/browser'
+import {
+	INTERACTION_COPY,
+	INTERACTION_SPECIMENS,
+	InteractionSection,
+	SpecimenSection,
+} from '@app/browser'
+import { requireValue } from '@orkestrel/test'
+import { build, mount, readHit, readStyle } from '@orkestrel/test/browser'
+import { beforeAll, describe, expect, it } from 'vitest'
+import { POINTER_EVENTS_VALUES, USER_SELECT_VALUES } from '../../../setupStyles.js'
+
+// The pointer case hit-tests the specimens as the published cascade lays them out, so the cascade
+// has to be in the document before a point is read.
+beforeAll(async () => {
+	await import('../../../../src/styles/index.scss')
+	await import('../../../../app/browser/styles/index.scss')
+})
+
+describe('InteractionSection', () => {
+	it('renders every declared specimen through the shared section contract', () => {
+		const host = mount(build('div'))
+		const section: SectionInterface = new InteractionSection(host)
+		try {
+			expect(section).toBeInstanceOf(SpecimenSection)
+			expect(section.host).toBe(host)
+			const region = requireValue(host.querySelector('section'), 'No Interaction region')
+			expect(region.getAttribute('aria-label')).toBe('Interaction')
+			expect(region.querySelector('p')?.textContent).toBe(INTERACTION_COPY.paragraph)
+			const rendered = [...region.querySelectorAll('[data-specimen]')]
+			expect(rendered.map((element) => element.getAttribute('data-specimen'))).toEqual([
+				'Text selection',
+				'Pointer events',
+			])
+			expect(rendered.map((element) => element.innerHTML)).toEqual(
+				INTERACTION_SPECIMENS.map((specimen) => specimen.markup),
+			)
+			// Every value the release writes is demonstrated, and every element carrying one of the
+			// classes opens its text with that class's full name.
+			const names = [
+				...USER_SELECT_VALUES.map((value) => `user-select-${value}`),
+				...POINTER_EVENTS_VALUES.map((value) => `pe-${value}`),
+			]
+			expect(names.filter((name) => region.querySelector(`.${name}`) === null)).toEqual([])
+			expect(
+				names.flatMap((name) =>
+					[...region.querySelectorAll(`.${name}`)].flatMap((element) =>
+						(element.textContent ?? '').startsWith(name) ? [] : [name],
+					),
+				),
+			).toEqual([])
+			// The link the pointer passes through is kept out of the focus order and announced as
+			// unavailable, as the release's own example marks it.
+			const passed = requireValue(
+				region.querySelector('[data-specimen="Pointer events"] a.pe-none'),
+				'No pointer-free link',
+			)
+			expect([passed.getAttribute('tabindex'), passed.getAttribute('aria-disabled')]).toEqual([
+				'-1',
+				'true',
+			])
+			expect(region.querySelector('[style]')).toBeNull()
+			expect(Object.isFrozen(INTERACTION_COPY)).toBe(true)
+			expect(Object.isFrozen(INTERACTION_SPECIMENS)).toBe(true)
+			expect(INTERACTION_SPECIMENS.every((specimen) => Object.isFrozen(specimen))).toBe(true)
+		} finally {
+			section.destroy()
+			host.remove()
+		}
+	})
+
+	it('passes the pointer through the pointer-free link and stops it on each link that takes it back', () => {
+		const host = mount(build('div'))
+		const section: SectionInterface = new InteractionSection(host)
+		try {
+			const specimen = requireValue(
+				host.querySelector('[data-specimen="Pointer events"]'),
+				'No pointer events specimen',
+			)
+			const passed = requireValue(specimen.querySelector('a.pe-none'), 'No pointer-free link')
+			// The hit test at the link's centre reaches the line that holds the link.
+			expect(readHit(passed)).toBe(passed.parentElement)
+			const taken = [...specimen.querySelectorAll('a.pe-auto')]
+			expect(taken).toHaveLength(2)
+			expect(taken.map((link) => readHit(link))).toEqual(taken)
+			expect(requireValue(taken.at(-1), 'No re-enabled link').closest('.pe-none')).not.toBeNull()
+			const lines = [...host.querySelectorAll('[data-specimen="Text selection"] p')]
+			expect(lines.map((line) => readStyle(line, 'user-select'))).toEqual(USER_SELECT_VALUES)
+		} finally {
+			section.destroy()
+			host.remove()
+		}
+	})
+
+	it('releases its region and preserves neighboring content through repeated destruction', () => {
+		const host = mount(build('div'))
+		const neighbor = build('p', { text: 'Existing content' })
+		host.append(neighbor)
+		const section: SectionInterface = new InteractionSection(host)
+		try {
+			const region = requireValue(host.querySelector('section'), 'No Interaction region')
+			expect(region.isConnected).toBe(true)
+			section.destroy()
+			expect(region.isConnected).toBe(false)
+			section.destroy()
+			expect([...host.children]).toEqual([neighbor])
+		} finally {
+			section.destroy()
+			host.remove()
+		}
+	})
+})
diff --git a/tests/app/browser/sections/SpacingSection.test.ts b/tests/app/browser/sections/SpacingSection.test.ts
new file mode 100644
index 0000000..88100aa
--- /dev/null
+++ b/tests/app/browser/sections/SpacingSection.test.ts
@@ -0,0 +1,253 @@
+import type { SectionInterface } from '@app/browser'
+import { SPACING_COPY, SPACING_SPECIMENS, SpacingSection, SpecimenSection } from '@app/browser'
+import { requireValue } from '@orkestrel/test'
+import { build, mount, readPixels } from '@orkestrel/test/browser'
+import { beforeAll, describe, expect, it } from 'vitest'
+import { visitBreakpoint } from '../../../setupBrowser.js'
+import {
+	BREAKPOINT_INFIXES,
+	SPACING_SIDE_CASES,
+	SPACING_STEP_CASES,
+	VIEWPORT_WIDTHS,
+} from '../../../setupStyles.js'
+
+// The sides the shorthand entry sets, which are every side a card's room is read on, in the
+// shorthand's own order.
+const SIDES = requireValue(
+	SPACING_SIDE_CASES.find(({ suffix }) => suffix === ''),
+	'No shorthand entry',
+).sides
+
+// The geometry case reads the specimens as the published cascade and the shell lay them out, so
+// both stylesheets have to be in the document before a box is measured.
+beforeAll(async () => {
+	await import('../../../../src/styles/index.scss')
+	await import('../../../../app/browser/styles/index.scss')
+})
+
+describe('SpacingSection', () => {
+	it('renders every declared specimen through the shared section contract', () => {
+		const host = mount(build('div'))
+		const section: SectionInterface = new SpacingSection(host)
+		try {
+			expect(section).toBeInstanceOf(SpecimenSection)
+			expect(section.host).toBe(host)
+			const region = requireValue(host.querySelector('section'), 'No Spacing region')
+			expect(region.getAttribute('aria-label')).toBe('Spacing')
+			expect(region.querySelector('p')?.textContent).toBe(SPACING_COPY.paragraph)
+			const rendered = [...region.querySelectorAll('[data-specimen]')]
+			expect(rendered.map((element) => element.getAttribute('data-specimen'))).toEqual([
+				'Margin steps',
+				'Padding steps',
+				'Side margins',
+				'Side padding',
+				'Auto margins',
+				'Responsive spacing',
+			])
+			expect(rendered.map((element) => element.innerHTML)).toEqual(
+				SPACING_SPECIMENS.map((specimen) => specimen.markup),
+			)
+			// Every step and every side the release writes is demonstrated, and every auto margin, so
+			// the list of misses is empty.
+			const sides = SPACING_SIDE_CASES.filter(({ suffix }) => suffix !== '')
+			expect(
+				[
+					...SPACING_STEP_CASES.flatMap(({ step }) => [
+						`[data-specimen="Margin steps"] .card > .card.m-${String(step)} > .card-body`,
+						`[data-specimen="Padding steps"] .vstack > .card.p-${String(step)}`,
+					]),
+					...sides.flatMap(({ suffix }) => [
+						`[data-specimen="Side margins"] .card > .card.m${suffix}-4 > .card-body`,
+						`[data-specimen="Side padding"] .vstack > .card.p${suffix}-4`,
+					]),
+					...SPACING_SIDE_CASES.map(
+						({ suffix }) => `[data-specimen="Auto margins"] .card.m${suffix}-auto > .card-body`,
+					),
+					...BREAKPOINT_INFIXES.map(
+						(infix) => `[data-specimen="Responsive spacing"] .card[class*="-${infix}-"]`,
+					),
+				].filter((selector) => region.querySelector(selector) === null),
+			).toEqual([])
+			// Every element carrying a spacing class names each such class in its own text, the card
+			// body inside it included, so a reader sees which class sets the room it shows.
+			const pattern = /^[mp][xytebs]?(?:-[a-z]+)?-(?:\d|auto)$/u
+			const carriers = [...region.querySelectorAll('[class]')].filter((element) =>
+				[...element.classList].some((name) => pattern.test(name)),
+			)
+			expect(carriers).not.toEqual([])
+			expect(
+				carriers.flatMap((element) =>
+					[...element.classList].filter(
+						(name) =>
+							pattern.test(name) && !(element.textContent ?? '').split(/\s+/u).includes(name),
+					),
+				),
+			).toEqual([])
+			expect(region.querySelector('[style]')).toBeNull()
+			expect(Object.isFrozen(SPACING_COPY)).toBe(true)
+			expect(Object.isFrozen(SPACING_SPECIMENS)).toBe(true)
+			expect(SPACING_SPECIMENS.every((specimen) => Object.isFrozen(specimen))).toBe(true)
+		} finally {
+			section.destroy()
+			host.remove()
+		}
+	})
+
+	it.each(VIEWPORT_WIDTHS)(
+		'opens the room each step and side sets between the card edges at the %i variant',
+		async (width) => {
+			const host = mount(build('div'))
+			const section: SectionInterface = new SpacingSection(host)
+			try {
+				// A margin card sits inside an outer card, so the room on each side is the distance
+				// from the outer card's inner border edge to the margin card's edge, in the order a
+				// margin shorthand names the sides. Every step is read on its own card, and every side
+				// on the step-4 card of its entry.
+				const margins = [
+					...SPACING_STEP_CASES.map(({ step, pixels }) => ({
+						selector: `[data-specimen="Margin steps"] .card.m-${String(step)}`,
+						expected: [pixels, pixels, pixels, pixels],
+					})),
+					...SPACING_SIDE_CASES.filter(({ suffix }) => suffix !== '').map(({ suffix, sides }) => ({
+						selector: `[data-specimen="Side margins"] .card.m${suffix}-4`,
+						expected: SIDES.map((side) => (sides.includes(side) ? 24 : 0)),
+					})),
+				]
+				const reading = await visitBreakpoint(width, () => ({
+					page: document.documentElement.scrollWidth,
+					margins: margins.map(({ selector }) => {
+						const inner = requireValue(host.querySelector(selector), `No ${selector}`)
+						const outer = requireValue(inner.parentElement, `No outer card for ${selector}`)
+						const box = inner.getBoundingClientRect()
+						const frame = outer.getBoundingClientRect()
+						return [
+							box.top - frame.top - readPixels(outer, 'border-top-width'),
+							frame.right - readPixels(outer, 'border-right-width') - box.right,
+							frame.bottom - readPixels(outer, 'border-bottom-width') - box.bottom,
+							box.left - frame.left - readPixels(outer, 'border-left-width'),
+						].map((room) => Math.round(room))
+					}),
+					// A padded card's label starts where its padding ends, so the room before the label's
+					// text is the padding on that side. The room above it also carries the line's
+					// half-leading, so the start side is the one read.
+					padding: SPACING_STEP_CASES.map(({ step }) => {
+						const card = requireValue(
+							host.querySelector(`[data-specimen="Padding steps"] .card.p-${String(step)}`),
+							`No padding step ${String(step)}`,
+						)
+						const range = document.createRange()
+						range.selectNodeContents(card)
+						return Math.round(
+							range.getBoundingClientRect().left -
+								card.getBoundingClientRect().left -
+								readPixels(card, 'border-left-width'),
+						)
+					}),
+					responsive: [
+						readPixels(
+							requireValue(
+								host.querySelector('[data-specimen="Responsive spacing"] .card.m-1'),
+								'No responsive margin',
+							),
+							'margin-top',
+						),
+						readPixels(
+							requireValue(
+								host.querySelector('[data-specimen="Responsive spacing"] .card.p-1'),
+								'No responsive padding',
+							),
+							'padding-top',
+						),
+					],
+				}))
+				expect(reading.margins).toEqual(margins.map(({ expected }) => expected))
+				expect(reading.padding).toEqual(SPACING_STEP_CASES.map(({ pixels }) => pixels))
+				// The narrow variant sits below the sm boundary and the wide one between the xl and xxl
+				// boundaries, so each responsive card takes its first step at one, and at the other the
+				// margin card takes its xl step while the padding card has not reached its xxl step.
+				expect(reading.responsive).toEqual(width < 576 ? [4, 4] : [48, 24])
+				expect(reading.page).toBe(width)
+			} finally {
+				section.destroy()
+				host.remove()
+			}
+		},
+	)
+
+	it('pushes each auto-margin card to the end, the start, or the middle of its line', () => {
+		const host = mount(build('div'))
+		const section: SectionInterface = new SpacingSection(host)
+		try {
+			const specimen = requireValue(
+				host.querySelector('[data-specimen="Auto margins"]'),
+				'No auto margin specimen',
+			)
+			// Each margin entry writes an auto step, and each auto-margin card's room is read on every
+			// side against the line that holds it, keyed by the card's class. The end margin's card is
+			// also read through the card after it, which the auto margin pushes to the end of the line.
+			const rooms = new Map(
+				SPACING_SIDE_CASES.map(({ suffix }) => {
+					const name = `m${suffix}-auto`
+					const card = requireValue(specimen.querySelector(`.${name}`), `No .${name}`)
+					const box = card.getBoundingClientRect()
+					const line = requireValue(
+						card.parentElement,
+						`No line for .${name}`,
+					).getBoundingClientRect()
+					const next = card.nextElementSibling?.getBoundingClientRect()
+					return [
+						name,
+						{
+							top: Math.round(box.top - line.top),
+							right: Math.round(line.right - box.right),
+							bottom: Math.round(line.bottom - box.bottom),
+							left: Math.round(box.left - line.left),
+							gap: next === undefined ? undefined : Math.round(next.left - box.right),
+							trail: next === undefined ? undefined : Math.round(line.right - next.right),
+						},
+					] as const
+				}),
+			)
+			// An auto margin takes the room left over on its side, and a pair of them shares it evenly.
+			// Each expectation fails where that auto margin is written as zero: the card then sits at
+			// the start of its line, or the line's stretch default fills the line's height.
+			const both = requireValue(rooms.get('m-auto'), 'No .m-auto reading')
+			expect([both.top, both.left]).toEqual([both.bottom, both.right])
+			expect(Math.min(both.top, both.left)).toBeGreaterThan(0)
+			const across = requireValue(rooms.get('mx-auto'), 'No .mx-auto reading')
+			expect(across.left).toBe(across.right)
+			const down = requireValue(rooms.get('my-auto'), 'No .my-auto reading')
+			expect(down.top).toBe(down.bottom)
+			expect(down.top).toBeGreaterThan(0)
+			const top = requireValue(rooms.get('mt-auto'), 'No .mt-auto reading')
+			expect([top.bottom, top.top > 0]).toEqual([0, true])
+			const end = requireValue(rooms.get('me-auto'), 'No .me-auto reading')
+			expect([end.left, end.trail, (end.gap ?? 0) > 0]).toEqual([0, 0, true])
+			const bottom = requireValue(rooms.get('mb-auto'), 'No .mb-auto reading')
+			expect([bottom.top, bottom.bottom > 0]).toEqual([0, true])
+			const start = requireValue(rooms.get('ms-auto'), 'No .ms-auto reading')
+			expect([start.right, start.left > 0]).toEqual([0, true])
+		} finally {
+			section.destroy()
+			host.remove()
+		}
+	})
+
+	it('releases its region and preserves neighboring content through repeated destruction', () => {
+		const host = mount(build('div'))
+		const neighbor = build('p', { text: 'Existing content' })
+		host.append(neighbor)
+		const section: SectionInterface = new SpacingSection(host)
+		try {
+			const region = requireValue(host.querySelector('section'), 'No Spacing region')
+			expect(region.isConnected).toBe(true)
+			section.destroy()
+			expect(region.isConnected).toBe(false)
+			section.destroy()
+			expect([...host.children]).toEqual([neighbor])
+		} finally {
+			section.destroy()
+			host.remove()
+		}
+	})
+})
diff --git a/tests/src/styles/utilities/interaction.test.ts b/tests/src/styles/utilities/interaction.test.ts
