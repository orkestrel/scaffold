+++ b/tests/src/styles/utilities/interaction.test.ts
@@ -0,0 +1,198 @@
+import { TOKEN_NAMES } from '@src/core'
+import { requireValue } from '@orkestrel/test'
+import {
+	driveHold,
+	findRule,
+	readHit,
+	readPixels,
+	readStyle,
+	releasePointer,
+	traverseAccessible,
+} from '@orkestrel/test/browser'
+import { afterEach, describe, expect, it } from 'vitest'
+import { mountTraversalStart, scene } from '../../../setupBrowser.js'
+import {
+	BREAKPOINT_INFIXES,
+	PLACEMENT_BOX,
+	PLACEMENT_CONTAINER,
+	POINTER_EVENTS_VALUES,
+	USER_SELECT_VALUES,
+} from '../../../setupStyles.js'
+
+afterEach(async () => {
+	document.getSelection()?.removeAllRanges()
+	await releasePointer()
+	scene.clear()
+})
+
+describe('interaction utilities', () => {
+	it('resolves each selection and pointer value the release writes', () => {
+		const host = scene.mount(
+			[
+				...USER_SELECT_VALUES.map((value) => `<p class="user-select-${value}">Selection</p>`),
+				...POINTER_EVENTS_VALUES.map((value) => `<p class="pe-${value}">Pointer</p>`),
+			].join(''),
+		)
+		expect(
+			USER_SELECT_VALUES.map((value) =>
+				readStyle(
+					requireValue(host.querySelector(`.user-select-${value}`), `No .user-select-${value}`),
+					'user-select',
+				),
+			),
+		).toEqual(USER_SELECT_VALUES)
+		expect(
+			POINTER_EVENTS_VALUES.map((value) =>
+				readStyle(
+					requireValue(host.querySelector(`.pe-${value}`), `No .pe-${value}`),
+					'pointer-events',
+				),
+			),
+		).toEqual(POINTER_EVENTS_VALUES)
+	})
+
+	it('selects the whole line, places a caret, or selects nothing under one press, by value', async () => {
+		// A press on an all-selecting line selects the whole line, a press on an ordinary line places
+		// a caret and selects no text, and a press on an unselectable line leaves no selection at all,
+		// so each value reads apart from the other two.
+		const host = scene.mount(
+			USER_SELECT_VALUES.map(
+				(value) => `<p class="user-select-${value}" style="font-size: 2rem">Line ${value}</p>`,
+			).join(''),
+		)
+		const selection = requireValue(document.getSelection(), 'No selection')
+		const readings: Array<readonly [string, string, string]> = []
+		for (const value of USER_SELECT_VALUES) {
+			selection.removeAllRanges()
+			const line = requireValue(
+				host.querySelector<HTMLElement>(`.user-select-${value}`),
+				`No .user-select-${value}`,
+			)
+			await driveHold(() => line, `Line ${value}`)
+			await releasePointer()
+			readings.push([value, selection.type, selection.toString()])
+		}
+		expect(readings).toEqual([
+			['all', 'Range', 'Line all'],
+			['auto', 'Caret', ''],
+			['none', 'None', ''],
+		])
+	})
+
+	it('lets the pointer reach the element beneath a box that takes no pointer events', () => {
+		// Each cover spans the button beneath it. The `.pe-none` cover lets the hit test through to
+		// the button; the `.pe-auto` cover takes the hit itself, and so does a `.pe-auto` child inside
+		// a `.pe-none` cover, which is how the release re-enables one element inside a disabled one.
+		const host = scene.mount(
+			['pe-none', 'pe-auto']
+				.map(
+					(name) =>
+						`<div style="${PLACEMENT_CONTAINER}"><button type="button" style="${PLACEMENT_CONTAINER}">Beneath</button><div class="${name}" style="position: absolute; inset: 0"></div></div>`,
+				)
+				.join('') +
+				`<div style="${PLACEMENT_CONTAINER}"><button type="button" style="${PLACEMENT_CONTAINER}">Beneath</button><div class="pe-none" style="position: absolute; inset: 0"><div class="pe-auto" style="${PLACEMENT_CONTAINER}"></div></div></div>`,
+		)
+		const [none, auto, parent] = [...host.children].map((frame) =>
+			requireValue(frame.querySelector(':scope > .pe-none, :scope > .pe-auto'), 'No cover'),
+		)
+		const beneath = requireValue(none?.previousElementSibling, 'No button beneath')
+		expect(readHit(requireValue(none, 'No none cover'))).toBe(beneath)
+		const covering = requireValue(auto, 'No auto cover')
+		expect(readHit(covering)).toBe(covering)
+		const child = requireValue(parent?.querySelector('.pe-auto'), 'No re-enabled child')
+		expect(readHit(child)).toBe(child)
+	})
+
+	it('keeps a link that takes no pointer events in the keyboard focus order', async () => {
+		// The class stops the pointer alone, so the next Tab from the start control reaches the link
+		// the pointer passes through.
+		mountTraversalStart()
+		const host = scene.mount('<a class="pe-none" href="#main">Pointer-free link</a>')
+		const link = requireValue(host.querySelector('a'), 'No pointer-free link')
+		expect(readStyle(link, 'pointer-events')).toBe('none')
+		expect(await traverseAccessible('Pointer-free link')).toBe(link)
+	})
+
+	it('writes the pointer values beside the padding steps under the one class', () => {
+		// The `pe` class writes the padding-end steps and the pointer-events values alike, and the
+		// keys keep the two apart, so an element can carry one of each and resolve both.
+		const host = scene.mount('<div class="pe-3 pe-none"></div>')
+		const box = requireValue(host.querySelector('.pe-3'), 'No box')
+		expect([readPixels(box, 'padding-right'), readStyle(box, 'pointer-events')]).toEqual([
+			16,
+			'none',
+		])
+	})
+
+	it('writes no breakpoint infix, so no interaction class answers to a boundary', () => {
+		// The control is a recorded class the same lookup finds, so an empty result is the absence of
+		// the infixed classes rather than a lookup that finds nothing.
+		expect(findRule('.user-select-none')).not.toBeUndefined()
+		expect(findRule('.pe-none')).not.toBeUndefined()
+		expect(
+			BREAKPOINT_INFIXES.flatMap((infix) => [
+				...USER_SELECT_VALUES.flatMap((value) =>
+					findRule(`.user-select-${infix}-${value}`) === undefined
+						? []
+						: [`user-select-${infix}-${value}`],
+				),
+				...POINTER_EVENTS_VALUES.flatMap((value) =>
+					findRule(`.pe-${infix}-${value}`) === undefined ? [] : [`pe-${infix}-${value}`],
+				),
+			]),
+		).toEqual([])
+	})
+
+	it('resolves the same values inside a dark island and under a doubled density factor', () => {
+		const host = scene.mount(
+			'<div data-bs-theme="dark"><p class="user-select-none pe-none">Unselectable and unreachable</p></div>',
+		)
+		const line = requireValue(host.querySelector('.user-select-none'), 'No line')
+		document.documentElement.style.setProperty(TOKEN_NAMES.factor.density, '2')
+		try {
+			expect([readStyle(line, 'user-select'), readStyle(line, 'pointer-events')]).toEqual([
+				'none',
+				'none',
+			])
+		} finally {
+			document.documentElement.style.removeProperty(TOKEN_NAMES.factor.density)
+		}
+	})
+
+	it('keeps each value over a later unlayered consumer rule', () => {
+		const host = scene.mount(
+			'<p class="probe user-select-all pe-none">Utility</p><p class="probe">Consumer</p>',
+		)
+		scene.load('.probe { user-select: text; pointer-events: stroke }')
+		const [utility, consumer] = [...host.querySelectorAll('.probe')].map((element) => [
+			readStyle(element, 'user-select'),
+			readStyle(element, 'pointer-events'),
+		])
+		expect([utility, consumer]).toEqual([
+			['all', 'none'],
+			['text', 'stroke'],
+		])
+	})
+
+	it('yields to an important override inside the utilities layer and to no unlayered one', () => {
+		const host = scene.mount(
+			`<div style="${PLACEMENT_BOX}" class="user-select-none pe-none"></div>`,
+		)
+		const box = requireValue(host.querySelector('.pe-none'), 'No box')
+		// An unlayered `!important` declaration sorts after every layered one, so the shipped utility
+		// keeps its value; the same declaration re-opened inside the utilities layer arrives after the
+		// shipped rule in that layer and wins.
+		scene.load('.pe-none { pointer-events: auto !important; user-select: text !important }')
+		expect([readStyle(box, 'pointer-events'), readStyle(box, 'user-select')]).toEqual([
+			'none',
+			'none',
+		])
+		scene.load(
+			'@layer utilities { .pe-none { pointer-events: auto !important; user-select: text !important } }',
+		)
+		expect([readStyle(box, 'pointer-events'), readStyle(box, 'user-select')]).toEqual([
+			'auto',
+			'text',
+		])
+	})
+})
