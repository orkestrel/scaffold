+++ b/tests/app/browser/sections/VisibilitySection.test.ts
@@ -0,0 +1,121 @@
+import type { SectionInterface } from '@app/browser'
+import {
+	SpecimenSection,
+	VISIBILITY_COPY,
+	VISIBILITY_SPECIMENS,
+	VisibilitySection,
+} from '@app/browser'
+import { requireValue } from '@orkestrel/test'
+import { build, mount, readName, readStyle, traverseAccessible } from '@orkestrel/test/browser'
+import { afterEach, beforeAll, describe, expect, it } from 'vitest'
+import { mountTraversalStart, scene } from '../../../setupBrowser.js'
+
+// The reveal case reads the skip link as the published cascade lays it out, so the cascade has to be
+// in the document before a box is measured.
+beforeAll(async () => {
+	await import('../../../../src/styles/index.scss')
+	await import('../../../../app/browser/styles/index.scss')
+})
+
+afterEach(() => {
+	scene.clear()
+})
+
+describe('VisibilitySection', () => {
+	it('renders every declared specimen beside visible text through the shared section contract', () => {
+		const host = mount(build('div'))
+		const section: SectionInterface = new VisibilitySection(host)
+		try {
+			expect(section).toBeInstanceOf(SpecimenSection)
+			expect(section.host).toBe(host)
+			const region = requireValue(host.querySelector('section'), 'No Visibility region')
+			expect(region.getAttribute('aria-label')).toBe('Visibility')
+			expect(region.querySelector('p')?.textContent).toBe(VISIBILITY_COPY.paragraph)
+			const rendered = [...region.querySelectorAll('[data-specimen]')]
+			expect(rendered.map((element) => element.getAttribute('data-specimen'))).toEqual([
+				'Visible and invisible',
+				'Visually hidden',
+				'Skip link',
+			])
+			expect(rendered.map((element) => element.innerHTML)).toEqual(
+				VISIBILITY_SPECIMENS.map((specimen) => specimen.markup),
+			)
+			// Every selector names a composition the specimens render, so the list of misses is empty.
+			expect(
+				[
+					'[data-specimen="Visible and invisible"] p > .visible + .invisible + span',
+					'[data-specimen="Visually hidden"] p.position-relative > .visually-hidden',
+					'[data-specimen="Skip link"] p.position-relative > a.visually-hidden-focusable[href="#main"]',
+				].filter((selector) => region.querySelector(selector) === null),
+			).toEqual([])
+			// Each hidden subject sits inside a sentence that paints, so the specimen shows context
+			// around what it hides.
+			for (const element of rendered)
+				expect(element.getBoundingClientRect().height).toBeGreaterThan(0)
+			const invisible = requireValue(region.querySelector('.invisible'), 'No invisible word')
+			expect(readStyle(invisible, 'visibility')).toBe('hidden')
+			expect(invisible.getBoundingClientRect().width).toBeGreaterThan(0)
+			const phrase = requireValue(
+				region.querySelector('[data-specimen="Visually hidden"] p'),
+				'No visually hidden sentence',
+			)
+			expect(phrase.textContent).toBe('Unread messages: 3, all sent since your last visit')
+			expect(region.querySelector('[style]')).toBeNull()
+			expect(Object.isFrozen(VISIBILITY_COPY)).toBe(true)
+			expect(Object.isFrozen(VISIBILITY_SPECIMENS)).toBe(true)
+			expect(VISIBILITY_SPECIMENS.every((specimen) => Object.isFrozen(specimen))).toBe(true)
+		} finally {
+			section.destroy()
+			host.remove()
+		}
+	})
+
+	it('reveals the skip link while the keyboard holds focus on it, and hides it again after', async () => {
+		// The traversal starts on a focused control of the case's own ahead of the region, so the
+		// first Tab the keyboard sends lands on the region's first focusable element.
+		mountTraversalStart()
+		const host = mount(build('div'))
+		const section: SectionInterface = new VisibilitySection(host)
+		try {
+			const link = requireValue(
+				host.querySelector<HTMLAnchorElement>('.visually-hidden-focusable'),
+				'No skip link',
+			)
+			expect(readName(link)).toBe('Skip to main content')
+			expect([link.getBoundingClientRect().width, readStyle(link, 'position')]).toEqual([
+				1,
+				'absolute',
+			])
+			const reached = await traverseAccessible('Skip to main content')
+			expect(reached).toBe(link)
+			expect(link.getBoundingClientRect().width).toBeGreaterThan(1)
+			expect(readStyle(link, 'position')).toBe('static')
+			link.blur()
+			expect([link.getBoundingClientRect().width, readStyle(link, 'position')]).toEqual([
+				1,
+				'absolute',
+			])
+		} finally {
+			section.destroy()
+			host.remove()
+		}
+	})
+
+	it('releases its region and preserves neighboring content through repeated destruction', () => {
+		const host = mount(build('div'))
+		const neighbor = build('p', { text: 'Existing content' })
+		host.append(neighbor)
+		const section: SectionInterface = new VisibilitySection(host)
+		try {
+			const region = requireValue(host.querySelector('section'), 'No Visibility region')
+			expect(region.isConnected).toBe(true)
+			section.destroy()
+			expect(region.isConnected).toBe(false)
+			section.destroy()
+			expect([...host.children]).toEqual([neighbor])
+		} finally {
+			section.destroy()
+			host.remove()
+		}
+	})
+})
