+		try {
+			const region = requireValue(host.querySelector('section'), 'No Sizing region')
+			expect(region.isConnected).toBe(true)
+			section.destroy()
+			expect(region.isConnected).toBe(false)
+			section.destroy()
+			expect([...host.children]).toEqual([neighbor])
+		} finally {
+			section.destroy()
+			host.remove()
+		}
