--- /dev/null
+++ b/tests/src/styles/utilities/visibility.test.ts
@@ -0,0 +1,81 @@
+import { requireValue } from '@orkestrel/test'
+import { findRule, readStyle } from '@orkestrel/test/browser'
+import { afterEach, describe, expect, it } from 'vitest'
+import { scene } from '../../../setupBrowser.js'
+import { BREAKPOINT_INFIXES } from '../../../setupStyles.js'
+
+afterEach(() => {
+	scene.clear()
+})
+
+describe('visibility utilities', () => {
+	it('hides an invisible element while it keeps its box and its room in the line', () => {
+		const host = scene.mount(
+			'<p style="width: 400px"><span class="first">Before</span> <span class="invisible">Kept</span> <span class="after">After</span></p><p style="width: 400px"><span class="first">Before</span> <span>Kept</span> <span class="after">After</span></p>',
+		)
+		const invisible = requireValue(host.querySelector('.invisible'), 'No .invisible')
+		expect(readStyle(invisible, 'visibility')).toBe('hidden')
+		const box = invisible.getBoundingClientRect()
+		expect(box.width).toBeGreaterThan(0)
+		expect(box.height).toBeGreaterThan(0)
+		// The word after the invisible one sits where it sits beside a visible twin, so the invisible
+		// word keeps its room rather than collapsing out of the line.
+		const [hidden, shown] = [...host.querySelectorAll('.after')].map(
+			(element) => element.getBoundingClientRect().left,
+		)
+		expect(hidden).toBe(shown)
+	})
+
+	it('shows a visible element inside an invisible ancestor', () => {
+		const host = scene.mount(
+			'<div class="invisible"><span class="visible">Shown</span><span class="plain">Hidden</span></div>',
+		)
+		expect(
+			readStyle(requireValue(host.querySelector('.visible'), 'No .visible'), 'visibility'),
+		).toBe('visible')
+		expect(readStyle(requireValue(host.querySelector('.plain'), 'No .plain'), 'visibility')).toBe(
+			'hidden',
+		)
+	})
+
+	it('writes the entry with no class, so each value names its own class at no infix', () => {
+		expect(findRule('.visible')).toBeDefined()
+		expect(findRule('.invisible')).toBeDefined()
+		expect(
+			BREAKPOINT_INFIXES.flatMap((infix) =>
+				[`.${infix}-visible`, `.${infix}-invisible`, `.visible-${infix}`].filter(
+					(selector) => findRule(selector) !== undefined,
+				),
+			),
+		).toEqual([])
+	})
+
+	it('resolves the later value where an element carries both', () => {
+		const host = scene.mount('<span class="invisible visible">Both</span>')
+		expect(readStyle(requireValue(host.querySelector('span'), 'No span'), 'visibility')).toBe(
+			'hidden',
+		)
+	})
+
+	it('keeps each value over a later unlayered consumer rule and inside a dark island', () => {
+		const host = scene.mount(
+			'<div data-bs-theme="dark"><span class="visible probe">Shown</span><span class="invisible probe">Hidden</span></div>',
+		)
+		scene.load('.probe.visible { visibility: hidden } .probe.invisible { visibility: visible }')
+		expect(
+			readStyle(requireValue(host.querySelector('.visible'), 'No .visible'), 'visibility'),
+		).toBe('visible')
+		expect(
+			readStyle(requireValue(host.querySelector('.invisible'), 'No .invisible'), 'visibility'),
+		).toBe('hidden')
+	})
+
+	it('yields to an important override inside the utilities layer and to no unlayered one', () => {
+		const host = scene.mount('<span class="invisible">Hidden</span>')
+		const element = requireValue(host.querySelector('.invisible'), 'No .invisible')
+		scene.load('.invisible { visibility: visible !important }')
+		expect(readStyle(element, 'visibility')).toBe('hidden')
+		scene.load('@layer utilities { .invisible { visibility: visible !important } }')
+		expect(readStyle(element, 'visibility')).toBe('visible')
+	})
+})
diff --git a/tests/src/styles/utilities/visually-hidden.test.ts b/tests/src/styles/utilities/visually-hidden.test.ts
new file mode 100644
index 0000000..78107f3
--- /dev/null
+++ b/tests/src/styles/utilities/visually-hidden.test.ts
@@ -0,0 +1,146 @@
+import { requireValue } from '@orkestrel/test'
+import { readName, readPixels, readStyle, traverseAccessible } from '@orkestrel/test/browser'
+import { afterEach, describe, expect, it } from 'vitest'
+import { mountTraversalStart, scene } from '../../../setupBrowser.js'
+import {
+	PLACEMENT_CONTAINER,
+	VISUALLY_HIDDEN_PROPERTIES,
+	VISUALLY_HIDDEN_READING,
+} from '../../../setupStyles.js'
+
+afterEach(() => {
+	scene.clear()
+})
+
+describe('visually hidden helpers', () => {
+	it('hides an element in a clipped one-pixel box while it stays in the accessible name', () => {
+		const host = scene.mount(
+			`<div style="${PLACEMENT_CONTAINER}"><button type="button">Delete<span class="visually-hidden" style="padding: 1rem; margin: 1rem; border: 2px solid; white-space: normal"> the draft <span class="inner" style="overflow: visible">now</span></span></button></div>`,
+		)
+		const hidden = requireValue(host.querySelector('.visually-hidden'), 'No hidden text')
+		expect([
+			hidden.getBoundingClientRect().width,
+			hidden.getBoundingClientRect().height,
+			...VISUALLY_HIDDEN_PROPERTIES.map((property) => readStyle(hidden, property)),
+		]).toEqual(VISUALLY_HIDDEN_READING)
+		// Every box edge the element's own rule sets is set back, and the text keeps to one line so
+		// no wrapped line escapes the clip.
+		expect(
+			['padding-top', 'margin-top', 'border-top-width'].map((property) =>
+				readPixels(hidden, property),
+			),
+		).toEqual([0, -1, 0])
+		expect(readStyle(hidden, 'white-space')).toBe('nowrap')
+		// A child overflowing the clipped box keeps its overflow hidden too.
+		expect(readStyle(requireValue(host.querySelector('.inner'), 'No child'), 'overflow-x')).toBe(
+			'hidden',
+		)
+		expect(readName(requireValue(host.querySelector('button'), 'No button'))).toBe(
+			'Delete the draft now',
+		)
+	})
+
+	it('keeps a caption in its table position, so it never becomes an anonymous cell', () => {
+		const host = scene.mount(
+			'<table><caption class="visually-hidden">Quarterly totals</caption><tbody><tr><td>Cell</td></tr></tbody></table>',
+		)
+		const caption = requireValue(host.querySelector('caption'), 'No caption')
+		expect(readStyle(caption, 'position')).toBe('static')
+		expect(caption.getBoundingClientRect().width).toBe(1)
+	})
+
+	it('reveals the focusable form while the element holds focus, and while a descendant does', async () => {
+		// The traversal starts on a focused control of the case's own ahead of the fixture, so the
+		// first Tab the keyboard sends lands on the fixture's first focusable element.
+		mountTraversalStart()
+		const host = scene.mount(
+			`<div style="${PLACEMENT_CONTAINER}"><a class="visually-hidden-focusable skip" href="#main">Skip to main content</a><div class="visually-hidden-focusable group"><a href="#main">Jump to the summary</a></div></div>`,
+		)
+		const skip = requireValue(host.querySelector('.skip'), 'No skip link')
+		const group = requireValue(host.querySelector('.group'), 'No hidden group')
+		const inner = requireValue(group.querySelector('a'), 'No inner link')
+		expect(
+			[skip, group].map((element) => [
+				element.getBoundingClientRect().width,
+				element.getBoundingClientRect().height,
+				...VISUALLY_HIDDEN_PROPERTIES.map((property) => readStyle(element, property)),
+			]),
+		).toEqual([VISUALLY_HIDDEN_READING, VISUALLY_HIDDEN_READING])
+		expect(await traverseAccessible('Skip to main content')).toBe(skip)
+		expect(skip.getBoundingClientRect().width).toBeGreaterThan(1)
+		expect([readStyle(skip, 'position'), readStyle(skip, 'clip')]).toEqual(['static', 'auto'])
+		// A descendant holding focus reveals its container, which is what lets a hidden group
+		// show the control the keyboard reached inside it.
+		inner.focus()
+		expect(group.matches(':focus-within')).toBe(true)
+		expect(group.getBoundingClientRect().width).toBe(400)
+		expect(readStyle(group, 'position')).toBe('static')
+		expect(skip.getBoundingClientRect().width).toBe(1)
+		inner.blur()
+		expect(group.getBoundingClientRect().width).toBe(1)
+		expect(readStyle(group, 'position')).toBe('absolute')
+	})
+
+	it('sits ahead of every utility, so a utility the release lets win still wins', () => {
+		// The release writes the helper before its utilities, so at equal specificity a utility's
+		// important declaration wins: `.w-100` widens a hidden element. The helper's own
+		// `:not(caption)` rule is more specific than `.position-relative`, so the release keeps a
+		// hidden element absolute there, and a caption, which that rule leaves alone, takes the
+		// utility.
+		const host = scene.mount(
+			`<div style="${PLACEMENT_CONTAINER}"><span class="visually-hidden w-100">Wide</span><span class="visually-hidden position-relative">Placed</span><table><caption class="visually-hidden position-relative">Totals</caption></table></div>`,
+		)
+		expect(
+			requireValue(host.querySelector('.w-100'), 'No widened element').getBoundingClientRect()
+				.width,
+		).toBe(400)
+		expect(
+			readStyle(requireValue(host.querySelector('span.position-relative'), 'No span'), 'position'),
+		).toBe('absolute')
+		expect(readStyle(requireValue(host.querySelector('caption'), 'No caption'), 'position')).toBe(
+			'relative',
+		)
+	})
+
+	it('keeps the hidden box over a later unlayered consumer rule, important or not', () => {
+		const host = scene.mount(
+			`<div style="${PLACEMENT_CONTAINER}"><span class="visually-hidden probe">Kept hidden</span><span class="visually-hidden rival">Also kept hidden</span></div>`,
+		)
+		scene.load(
+			'.probe { width: 50px; position: static; clip: auto } .rival { width: 50px !important; position: static !important; clip: auto !important }',
+		)
+		expect(
+			['.probe', '.rival'].map((selector) => {
+				const element = requireValue(host.querySelector(selector), `No ${selector}`)
+				return [
+					element.getBoundingClientRect().width,
+					element.getBoundingClientRect().height,
+					...VISUALLY_HIDDEN_PROPERTIES.map((property) => readStyle(element, property)),
+				]
+			}),
+		).toEqual([VISUALLY_HIDDEN_READING, VISUALLY_HIDDEN_READING])
+	})
+
+	it('yields to an important override inside the utilities layer', () => {
+		const host = scene.mount(
+			`<div style="${PLACEMENT_CONTAINER}"><span class="visually-hidden">Shown</span></div>`,
+		)
+		scene.load('@layer utilities { .visually-hidden { width: 20px !important } }')
+		expect(
+			requireValue(host.querySelector('.visually-hidden'), 'No hidden text').getBoundingClientRect()
+				.width,
+		).toBe(20)
+	})
+
+	it('hides the same box inside a dark island', () => {
+		const host = scene.mount(
+			`<div data-bs-theme="dark" style="${PLACEMENT_CONTAINER}"><span class="visually-hidden">Hidden in the dark</span></div>`,
+		)
+		const hidden = requireValue(host.querySelector('.visually-hidden'), 'No hidden text')
+		expect([
+			hidden.getBoundingClientRect().width,
+			hidden.getBoundingClientRect().height,
+			...VISUALLY_HIDDEN_PROPERTIES.map((property) => readStyle(hidden, property)),
+		]).toEqual(VISUALLY_HIDDEN_READING)
+	})
+})
