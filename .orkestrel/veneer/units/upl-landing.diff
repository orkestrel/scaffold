+import { TOKEN_NAMES } from '@src/core'
+import { requireValue } from '@orkestrel/test'
+import { findRule, readPixels, readStyle } from '@orkestrel/test/browser'
+import { afterEach, describe, expect, it } from 'vitest'
+import { scene } from '../../../setupBrowser.js'
+import {
+	BREAKPOINT_INFIXES,
+	OFFSET_EDGES,
+	OFFSET_STEP_CASES,
+	PLACEMENT_BOX,
+	PLACEMENT_CONTAINER,
+	POSITION_ENTRY_CASES,
+	POSITION_VALUES,
+	STACK_LEVEL_CASES,
+	TRANSLATION_BOX,
+} from '../../../setupStyles.js'
+
+afterEach(() => {
+	scene.clear()
+})
+
+describe('position utilities', () => {
+	it('resolves every position value', () => {
+		const host = scene.mount(
+			`<div style="${PLACEMENT_CONTAINER}">${POSITION_VALUES.map((value) => `<div class="position-${value}"></div>`).join('')}</div>`,
+		)
+		expect(
+			POSITION_VALUES.map((value) =>
+				readStyle(
+					requireValue(host.querySelector(`.position-${value}`), `No .position-${value}`),
+					'position',
+				),
+			),
+		).toEqual(POSITION_VALUES)
+	})
+
+	it('offsets each edge by a share of the containing block', () => {
+		const host = scene.mount(
+			`<div class="probe" style="${PLACEMENT_CONTAINER}">${OFFSET_STEP_CASES.map(({ step }) => OFFSET_EDGES.map((edge) => `<div class="position-absolute ${edge}-${step}" style="${PLACEMENT_BOX}"></div>`).join('')).join('')}</div>`,
+		)
+		const corner = requireValue(
+			host.querySelector('.probe'),
+			'No container',
+		).getBoundingClientRect()
+		// Each offset is read as the distance from the container's edge to the box's edge on the
+		// side the entry names.
+		expect(
+			OFFSET_STEP_CASES.map(({ step }) =>
+				OFFSET_EDGES.map((edge) => {
+					const box = requireValue(
+						host.querySelector(`.${edge}-${step}`),
+						`No .${edge}-${step}`,
+					).getBoundingClientRect()
+					if (edge === 'top') return box.top - corner.top
+					if (edge === 'bottom') return corner.bottom - box.bottom
+					if (edge === 'start') return box.left - corner.left
+					return corner.right - box.right
+				}),
+			),
+		).toEqual(
+			OFFSET_STEP_CASES.map(({ share }) => [200 * share, 200 * share, 400 * share, 400 * share]),
+		)
+	})
+
+	it('keeps the start and end offsets on the physical left and right edges in a right-to-left scope', () => {
+		// A right-to-left scope moves an absolute box's static position to the right edge, so a
+		// box written with no offset of its own lands at the right, and the `start` offset still
+		// places its twin at the left.
+		const host = scene.mount(
+			`<div class="probe" dir="rtl" style="${PLACEMENT_CONTAINER}"><div class="position-absolute start-0" style="${PLACEMENT_BOX}"></div><div class="position-absolute end-0" style="${PLACEMENT_BOX}"></div><div class="position-absolute bare" style="${PLACEMENT_BOX}"></div></div>`,
+		)
+		const corner = requireValue(
+			host.querySelector('.probe'),
+			'No container',
+		).getBoundingClientRect()
+		expect(
+			['.start-0', '.end-0', '.bare'].map((selector) => {
+				const box = requireValue(
+					host.querySelector(selector),
+					`No ${selector}`,
+				).getBoundingClientRect()
+				return [box.left - corner.left, box.right - corner.left]
+			}),
+		).toEqual([
+			[0, 20],
+			[380, 400],
+			[380, 400],
+		])
+	})
+
+	it('centers a box on each axis with the translation entries', () => {
+		const host = scene.mount(
+			`<div class="probe" style="${PLACEMENT_CONTAINER}"><div class="position-absolute top-50 start-50 translate-middle" style="${TRANSLATION_BOX}"></div><div class="position-absolute top-0 start-50 translate-middle-x" style="${TRANSLATION_BOX}"></div><div class="position-absolute top-50 start-0 translate-middle-y" style="${TRANSLATION_BOX}"></div></div>`,
+		)
+		const corner = requireValue(
+			host.querySelector('.probe'),
+			'No container',
+		).getBoundingClientRect()
+		expect(
+			['.translate-middle', '.translate-middle-x', '.translate-middle-y'].map((selector) => {
+				const box = requireValue(
+					host.querySelector(selector),
+					`No ${selector}`,
+				).getBoundingClientRect()
+				return [box.left - corner.left, box.top - corner.top]
+			}),
+		).toEqual([
+			[150, 80],
+			[150, 0],
+			[0, 80],
+		])
+	})
+
+	it('stacks the levels in order where their boxes overlap', () => {
+		// Each box covers the square an in-flow block fills, written in the reverse of the level
+		// order, so a box painting over the others does so by its level rather than by coming later
+		// in the document. The container opens a stacking context, so the lowest level paints under
+		// that in-flow block and every other level over it.
+		const host = scene.mount(
+			`<div class="probe" style="${PLACEMENT_CONTAINER}; z-index: 0"><div class="flow" style="width: 50px; height: 50px"></div>${[
+				...STACK_LEVEL_CASES,
+			]
+				.reverse()
+				.map(
+					({ level }) =>
+						`<div class="position-absolute top-0 start-0 z-${level}" style="width: 50px; height: 50px"></div>`,
+				)
+				.join('')}</div>`,
+		)
+		expect(
+			STACK_LEVEL_CASES.map(({ level }) =>
+				readStyle(requireValue(host.querySelector(`.z-${level}`), `No .z-${level}`), 'z-index'),
+			),
+		).toEqual(STACK_LEVEL_CASES.map(({ value }) => value))
+		const corner = requireValue(
+			host.querySelector('.probe'),
+			'No container',
+		).getBoundingClientRect()
+		// Every level from zero up paints over the in-flow block, highest first, and the negative
+		// level paints under it, so taking the boxes out from the top reaches the block last.
+		const over = STACK_LEVEL_CASES.filter(({ value }) => Number(value) >= 0).reverse()
+		const hits: string[] = []
+		for (const { level } of over) {
+			hits.push(document.elementFromPoint(corner.left + 25, corner.top + 25)?.className ?? '')
+			requireValue(host.querySelector(`.z-${level}`), `No .z-${level}`).remove()
+		}
+		hits.push(document.elementFromPoint(corner.left + 25, corner.top + 25)?.className ?? '')
+		expect(hits).toEqual([
+			...over.map(({ level }) => `position-absolute top-0 start-0 z-${level}`),
+			'flow',
+		])
+	})
+
+	it('writes no breakpoint infix, so no position class answers to a boundary', () => {
+		expect(POSITION_ENTRY_CASES.filter(({ name }) => findRule(`.${name}`) === undefined)).toEqual(
+			[],
+		)
+		expect(
+			POSITION_ENTRY_CASES.flatMap(({ prefix }) =>
+				BREAKPOINT_INFIXES.flatMap((infix) =>
+					findRule(`.${prefix}-${infix}-`) === undefined ? [] : [`${prefix}-${infix}`],
+				),
+			),
+		).toEqual([])
+	})
+
+	it('keeps every offset independent of the density factor and inside a dark island', () => {
+		const host = scene.mount(
+			`<div class="probe" data-bs-theme="dark" style="${PLACEMENT_CONTAINER}"><div class="position-absolute top-50 end-50" style="${PLACEMENT_BOX}"></div></div>`,
+		)
+		const container = requireValue(host.querySelector('.probe'), 'No container')
+		const box = requireValue(host.querySelector('.top-50'), 'No offset box')
+		document.documentElement.style.setProperty(TOKEN_NAMES.factor.density, '2')
+		try {
+			expect([
+				box.getBoundingClientRect().left - container.getBoundingClientRect().left,
+				box.getBoundingClientRect().top - container.getBoundingClientRect().top,
+			]).toEqual([180, 100])
+		} finally {
+			document.documentElement.style.removeProperty(TOKEN_NAMES.factor.density)
+		}
+		expect([
+			box.getBoundingClientRect().left - container.getBoundingClientRect().left,
+			box.getBoundingClientRect().top - container.getBoundingClientRect().top,
+		]).toEqual([180, 100])
+	})
+
+	it('resolves a later value over an earlier one inside an entry', () => {
+		// The release writes each entry's values in its map order, so where an element carries two
+		// values of one entry, the later value wins.
+		const host = scene.mount(
+			`<div style="${PLACEMENT_CONTAINER}"><div class="position-absolute position-relative"></div><div class="translate-middle-x translate-middle" style="${TRANSLATION_BOX}"></div><div class="z-3 z-n1 position-relative"></div></div>`,
+		)
+		expect(
+			readStyle(requireValue(host.querySelector('.position-absolute'), 'No pair'), 'position'),
+		).toBe('absolute')
+		expect(
+			readStyle(requireValue(host.querySelector('.translate-middle-x'), 'No pair'), 'transform'),
+		).toBe('matrix(1, 0, 0, 1, -50, 0)')
+		expect(readStyle(requireValue(host.querySelector('.z-n1'), 'No pair'), 'z-index')).toBe('3')
+	})
+
+	it('keeps every entry over a later unlayered consumer rule', () => {
+		const host = scene.mount(
+			`<div style="${PLACEMENT_CONTAINER}"><div class="probe position-absolute top-50 start-0 translate-middle-y z-2"></div></div>`,
+		)
+		scene.load('.probe { position: static; top: 7px; left: 7px; transform: none; z-index: 9 }')
+		const box = requireValue(host.querySelector('.probe'), 'No probe')
+		expect(
+			['position', 'top', 'left', 'z-index'].map((property) => readStyle(box, property)),
+		).toEqual(['absolute', '100px', '0px', '2'])
+		expect(readStyle(box, 'transform')).not.toBe('none')
+	})
+
+	it('yields to an important override inside the utilities layer and to no unlayered one', () => {
+		const host = scene.mount(
+			`<div style="${PLACEMENT_CONTAINER}"><div class="position-absolute top-50"></div></div>`,
+		)
+		const box = requireValue(host.querySelector('.top-50'), 'No offset box')
+		// An unlayered `!important` sorts after every layered one, so the shipped utility keeps its
+		// step; the same declaration re-opened inside the utilities layer arrives after the shipped
+		// rule in that layer and wins.
+		scene.load('.top-50 { top: 9px !important }')
+		expect(readPixels(box, 'top')).toBe(100)
+		scene.load('@layer utilities { .top-50 { top: 9px !important } }')
+		expect(readPixels(box, 'top')).toBe(9)
+	})
+})
