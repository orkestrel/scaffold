+	// beats one in a later layer, and in the components layer this rule would beat every utility the
+	// release lets win over it, such as `.w-100`. It is a helper rather than a utility entry, and each
+	// declaration carries its own value, so it is written here rather than through the `utility`
+	// mixin. The focusable form hides the element only while neither it nor a descendant holds focus.
+	.visually-hidden,
+	.visually-hidden-focusable:not(:focus):not(:focus-within) {
+		width: 1px !important;
+		height: 1px !important;
+		padding: 0 !important;
+		margin: -1px !important;
+		overflow: hidden !important;
+		clip: rect(0, 0, 0, 0) !important;
+		white-space: nowrap !important;
+		border: 0 !important;
+
+		// A positioned caption can become an anonymous table cell, so the caption keeps its position.
+		&:not(caption) {
+			position: absolute !important;
+		}
+
+		// A child overflowing the clipped box would stay focusable where it paints.
+		* {
+			overflow: hidden !important;
+		}
+	}
+}
