@@ -0,0 +1,41 @@
+@use '../mixins' as *;
+
+@layer utilities {
+	// Stands in for the release's `$position-values` map, which the edge entries share.
+	$edges: (
+		0: 0,
+		50: 50%,
+		100: 100%,
+	);
+	// The `z-index` entry is the last in the release's map; no other utility sets the property, so
+	// writing it beside the position entries moves no resolution.
+	@include breakpoint-each using ($infix, $_boundary) {
+		@include utility(position, position, static relative absolute fixed sticky, $infix);
+		@include utility(top, top, $edges, $infix);
+		@include utility(bottom, bottom, $edges, $infix);
+		@include utility(start, left, $edges, $infix);
+		@include utility(end, right, $edges, $infix);
+		@include utility(
+			translate-middle,
+			transform,
+			(
+				null: translate(-50%, -50%),
+				x: translateX(-50%),
+				y: translateY(-50%),
+			),
+			$infix
+		);
+		@include utility(
+			z,
+			z-index,
+			(
+				n1: -1,
+				0: 0,
+				1: 1,
+				2: 2,
+				3: 3,
+			),
+			$infix
+		);
+	}
+}
