@@ -0,0 +1,33 @@
+@use '../mixins' as *;
+
+@layer utilities {
+	// Stands in for the release's width and height maps, which share their steps.
+	$steps: (
+		25: 25%,
+		50: 50%,
+		75: 75%,
+		100: 100%,
+		auto: auto,
+	);
+	// Stand in for the single-value maps of the maximum, viewport, and viewport-floor entries: the
+	// whole container, the viewport's width, and the viewport's height.
+	$whole: (
+		100: 100%,
+	);
+	$across: (
+		100: 100vw,
+	);
+	$down: (
+		100: 100vh,
+	);
+	@include breakpoint-each using ($infix, $_boundary) {
+		@include utility(w, width, $steps, $infix);
+		@include utility(mw, max-width, $whole, $infix);
+		@include utility(vw, width, $across, $infix);
+		@include utility(min-vw, min-width, $across, $infix);
+		@include utility(h, height, $steps, $infix);
+		@include utility(mh, max-height, $whole, $infix);
+		@include utility(vh, height, $down, $infix);
+		@include utility(min-vh, min-height, $down, $infix);
+	}
+}
