+		top: 0;
+		right: 0;
+		left: 0;
+		z-index: var(--vn-stack-fixed);
+	}
+
+	.fixed-bottom {
+		position: fixed;
+		right: 0;
+		bottom: 0;
+		left: 0;
+		z-index: var(--vn-stack-fixed);
+	}
+
+	@include breakpoint-each using ($infix, $_boundary) {
+		.sticky#{$infix}-top {
+			position: sticky;
+			top: 0;
+			z-index: var(--vn-stack-sticky);
