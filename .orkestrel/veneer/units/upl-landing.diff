+++ b/app/browser/sections/PositionSection.ts
@@ -0,0 +1,22 @@
+import { POSITION_COPY, POSITION_SPECIMENS } from '../constants.js'
+import { SpecimenSection } from './SpecimenSection.js'
+
+/**
+ * Renders the declared position, offset, translation, stacking, and fixed and sticky bar specimens
+ * into a named Position region.
+ *
+ * @example
+ * ```ts
+ * const section = new PositionSection(document.body)
+ * section.destroy()
+ * ```
+ */
+export class PositionSection extends SpecimenSection {
+	/**
+	 * Mounts the Position region and its specimens in table order.
+	 * @param host - The element receiving the section.
+	 */
+	constructor(host: HTMLElement) {
+		super(host, POSITION_COPY, POSITION_SPECIMENS)
+	}
+}
