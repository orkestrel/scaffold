@@ -0,0 +1,20 @@
+import { NAVBAR_COPY, NAVBAR_SPECIMENS } from '../constants.js'
+import { SpecimenSection } from './SpecimenSection.js'
+
+/**
+ * Renders the declared navbar specimens into a named region.
+ * @example
+ * ```ts
+ * const section = new NavbarSection(document.body)
+ * section.destroy()
+ * ```
+ */
+export class NavbarSection extends SpecimenSection {
+	/**
+	 * Mounts the Navbar region and its specimens.
+	 * @param host - The element receiving the section.
+	 */
+	constructor(host: HTMLElement) {
+		super(host, NAVBAR_COPY, NAVBAR_SPECIMENS)
+	}
+}
diff --git a/home/user/veneer-nb/src/styles/components/_navbar.scss b/home/user/veneer-nb/src/styles/components/_navbar.scss
new file mode 100644
index 0000000..56d1b71
--- /dev/null
+++ b/home/user/veneer-nb/src/styles/components/_navbar.scss
@@ -0,0 +1,235 @@
+@use 'sass:map';
+@use '../tokens';
+@use '../mixins' as *;
+
+@layer components {
+	// Every value here is Bootstrap 5.3.8's own, apart from the forced-colors focus outline. A length
+	// reads the Veneer scale token that already resolves to it, so the density factor reaches the bar,
+	// link, text, and toggler insets; the brand's inset keeps the release's literal, because no scale
+	// token resolves to it. A light color reads the emphasis channels the release reads, so the bar's
+	// text follows the mode it sits in, and a dark color is the release's literal written as a mix
+	// over the palette, because a partial declares no literal color of its own. The container
+	// combinators the release writes here ship from the container partial, which the inventory
+	// records them under.
+	.navbar {
+		--bs-navbar-padding-x: 0;
+		--bs-navbar-padding-y: var(--vn-space-4);
+		--bs-navbar-color: rgba(var(--bs-emphasis-color-rgb), 0.65);
+		--bs-navbar-hover-color: rgba(var(--bs-emphasis-color-rgb), 0.8);
+		--bs-navbar-disabled-color: rgba(var(--bs-emphasis-color-rgb), 0.3);
+		--bs-navbar-active-color: rgba(var(--bs-emphasis-color-rgb), 1);
+		--bs-navbar-brand-padding-y: 0.3125rem;
+		--bs-navbar-brand-margin-end: var(--vn-space-8);
+		--bs-navbar-brand-font-size: var(--vn-size-5);
+		--bs-navbar-brand-color: rgba(var(--bs-emphasis-color-rgb), 1);
+		--bs-navbar-brand-hover-color: rgba(var(--bs-emphasis-color-rgb), 1);
+		--bs-navbar-nav-link-padding-x: var(--vn-space-4);
+		--bs-navbar-toggler-padding-y: var(--vn-space-2);
+		--bs-navbar-toggler-padding-x: var(--vn-space-6);
+		--bs-navbar-toggler-font-size: var(--vn-size-5);
+		--bs-navbar-toggler-icon-bg: #{map.get(tokens.$icons, 'toggler-icon')};
+		--bs-navbar-toggler-border-color: rgba(var(--bs-emphasis-color-rgb), 0.15);
+		--bs-navbar-toggler-border-radius: var(--bs-border-radius);
+		// The ring width stays the release's literal: the published focus width is a narrower ring.
+		--bs-navbar-toggler-focus-width: 0.25rem;
+		--bs-navbar-toggler-transition: box-shadow 0.15s ease-in-out;
+		position: relative;
+		display: flex;
+		flex-wrap: wrap;
+		align-items: center;
+		justify-content: space-between;
+		padding: var(--bs-navbar-padding-y) var(--bs-navbar-padding-x);
+	}
+
+	.navbar-brand {
+		padding-top: var(--bs-navbar-brand-padding-y);
+		padding-bottom: var(--bs-navbar-brand-padding-y);
+		margin-right: var(--bs-navbar-brand-margin-end);
+		font-size: var(--bs-navbar-brand-font-size);
+		color: var(--bs-navbar-brand-color);
+		text-decoration: none;
+		white-space: nowrap;
+	}
+
+	.navbar-brand:hover,
+	.navbar-brand:focus {
+		color: var(--bs-navbar-brand-hover-color);
+	}
+
+	// The list retunes the nav link slots to the bar's own colors, so a link inside it paints from the
+	// navbar variables through the nav partial's rules. The link sits flush with the bar's edge until
+	// an expanded bar gives it the navbar's own inline padding.
+	.navbar-nav {
+		@include nav-list;
+		--bs-nav-link-padding-x: 0;
+		--bs-nav-link-color: var(--bs-navbar-color);
+		--bs-nav-link-hover-color: var(--bs-navbar-hover-color);
+		--bs-nav-link-disabled-color: var(--bs-navbar-disabled-color);
+		flex-direction: column;
+	}
+
+	// A link carrying `show` is the toggle of an open menu, and it paints as the current link.
+	.navbar-nav .nav-link.active,
+	.navbar-nav .nav-link.show {
+		color: var(--bs-navbar-active-color);
+	}
+
+	// A menu in a collapsed bar opens in the column's flow and pushes the links after it down.
+	.navbar-nav .dropdown-menu {
+		position: static;
+	}
+
+	// The text takes the link's block inset, so it lines up with the links beside it.
+	.navbar-text {
+		padding-top: var(--vn-space-4);
+		padding-bottom: var(--vn-space-4);
+		color: var(--bs-navbar-color);
+	}
+
+	.navbar-text a,
+	.navbar-text a:hover,
+	.navbar-text a:focus {
+		color: var(--bs-navbar-active-color);
+	}
+
+	// The collapsible content takes a whole row of its own, so a collapsed bar wraps it under the
+	// brand and the toggler.
+	.navbar-collapse {
+		flex-grow: 1;
+		flex-basis: 100%;
+		align-items: center;
+	}
+
+	.navbar-toggler {
+		padding: var(--bs-navbar-toggler-padding-y) var(--bs-navbar-toggler-padding-x);
+		font-size: var(--bs-navbar-toggler-font-size);
+		line-height: 1;
+		color: var(--bs-navbar-color);
+		background-color: transparent;
+		border: var(--bs-border-width) solid var(--bs-navbar-toggler-border-color);
+		border-radius: var(--bs-navbar-toggler-border-radius);
+		// The mixin emits the reduced-motion twin the release records beside the transition.
+		@include transition(var(--bs-navbar-toggler-transition));
+	}
+
+	.navbar-toggler:hover {
+		text-decoration: none;
+	}
+
+	// The ring is a shadow in the toggler's own text color. Forced colors paint no shadow, so the
+	// toggler takes the system-highlight outline there.
+	.navbar-toggler:focus {
+		text-decoration: none;
+		outline: 0;
+		box-shadow: 0 0 0 var(--bs-navbar-toggler-focus-width);
+		@include forced-ring;
+	}
+
+	.navbar-toggler-icon {
+		display: inline-block;
+		width: 1.5em;
+		height: 1.5em;
+		vertical-align: middle;
+		background-image: var(--bs-navbar-toggler-icon-bg);
+		background-repeat: no-repeat;
+		background-position: center;
+		background-size: 100%;
+	}
+
+	// The list scrolls inside the height a consumer sets on it, and inside three quarters of the
+	// viewport until one is set.
+	.navbar-nav-scroll {
+		max-height: var(--bs-scroll-height, 75vh);
+		overflow-y: auto;
+	}
+
+	// Each expand class lays the bar out in one row from its boundary up: the links run in a row with
+	// the navbar's inline padding, a menu hangs over the content again, the collapsible content shows
+	// while its collapse class would hide it, and the toggler leaves. The class with no infix expands
+	// at every width. The offcanvas rules turn a panel into part of the row, and ship ahead of the
+	// panel's own partial. The `!important` flags are the release's own, so the expanded content and
+	// panel win over the hidden state their own classes write.
+	@include breakpoint-each using ($infix, $_boundary) {
+		.navbar-expand#{$infix} {
+			flex-wrap: nowrap;
+			justify-content: flex-start;
+		}
+
+		.navbar-expand#{$infix} .navbar-nav {
+			flex-direction: row;
+		}
+
+		.navbar-expand#{$infix} .navbar-nav .dropdown-menu {
+			position: absolute;
+		}
+
+		.navbar-expand#{$infix} .navbar-nav .nav-link {
+			padding-right: var(--bs-navbar-nav-link-padding-x);
+			padding-left: var(--bs-navbar-nav-link-padding-x);
+		}
+
+		.navbar-expand#{$infix} .navbar-nav-scroll {
+			overflow: visible;
+		}
+
+		.navbar-expand#{$infix} .navbar-collapse {
+			display: flex !important;
+			flex-basis: auto;
+		}
+
+		.navbar-expand#{$infix} .navbar-toggler {
+			display: none;
+		}
+
+		// The release resets the panel's motion to none, and its transition mixin records no
+		// reduced-motion twin beside a reset, so the declaration is written bare.
+		.navbar-expand#{$infix} .offcanvas {
+			position: static;
+			z-index: auto;
+			flex-grow: 1;
+			width: auto !important;
+			height: auto !important;
+			visibility: visible !important;
+			background-color: transparent !important;
+			border: 0 !important;
+			transform: none !important;
+			transition: none;
+		}
+
+		.navbar-expand#{$infix} .offcanvas .offcanvas-header {
+			display: none;
+		}
+
+		.navbar-expand#{$infix} .offcanvas .offcanvas-body {
+			display: flex;
+			flex-grow: 0;
+			padding: 0;
+			overflow-y: visible;
+		}
+	}
+
+	// The dark class and the dark attribute on the bar itself retune the bar's colors and toggler to
+	// the release's white literals. The release's light class emits no rule, so it has none here.
+	.navbar-dark,
+	.navbar[data-bs-theme='dark'] {
+		--bs-navbar-color: color-mix(in srgb, var(--vn-palette-white-base) 55%, transparent);
+		--bs-navbar-hover-color: color-mix(in srgb, var(--vn-palette-white-base) 75%, transparent);
+		--bs-navbar-disabled-color: color-mix(in srgb, var(--vn-palette-white-base) 25%, transparent);
+		--bs-navbar-active-color: var(--vn-palette-white-base);
+		--bs-navbar-brand-color: var(--vn-palette-white-base);
+		--bs-navbar-brand-hover-color: var(--vn-palette-white-base);
+		--bs-navbar-toggler-border-color: color-mix(
+			in srgb,
+			var(--vn-palette-white-base) 10%,
+			transparent
+		);
+		--bs-navbar-toggler-icon-bg: #{map.get(tokens.$dark, 'toggler-icon')};
+	}
+
+	// The release gives the icon a second value under its dark component rule. Declared on the icon,
+	// it outranks the value the bar carries, and like the release's own rule it matches any icon under
+	// a dark scope, a nested light island included.
+	[data-bs-theme='dark'] .navbar-toggler-icon {
+		--bs-navbar-toggler-icon-bg: #{map.get(tokens.$dark, 'toggler-icon')};
+	}
+}
diff --git a/home/user/veneer-nb/tests/app/browser/sections/NavbarSection.test.ts b/home/user/veneer-nb/tests/app/browser/sections/NavbarSection.test.ts
