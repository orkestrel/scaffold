+import { TOKEN_NAMES } from '@src/core'
+import { requireValue } from '@orkestrel/test'
+import {
+	hoverAccessible,
+	matchesColor,
+	readPixels,
+	readStyle,
+	readToken,
+	releaseMedia,
+	releasePointer,
+	stageMedia,
+	waitForAnimations,
+} from '@orkestrel/test/browser'
+import { afterEach, describe, expect, it } from 'vitest'
+import { normalizeSelectorText } from '../../../setup.js'
+import {
+	collectLayer,
+	collectMediaConditions,
+	scene,
+	visitBreakpoint,
+} from '../../../setupBrowser.js'
+import {
+	extractShadowLayers,
+	NAVBAR_COLOR_CASES,
+	NAVBAR_DARK_CASES,
+	NAVBAR_EXPAND_CASES,
+	NAVBAR_LENGTH_CASES,
+	NAVBAR_MARKUP,
+	NAVBAR_SELECTORS,
+	REDUCED_MOTION,
+	splitTopLevelList,
+	TEXT_MODES,
+} from '../../../setupStyles.js'
+
+afterEach(async () => {
+	await releasePointer()
+	await releaseMedia()
+	scene.clear()
+})
+
+describe('navbar classes', () => {
+	it('lays the bar out as a wrapping row, writes no rule for the light class, and every shipped selector reaches the components layer', () => {
+		const host = scene.mount(`<nav class="navbar navbar-light">${NAVBAR_MARKUP}</nav>`)
+		const bar = requireValue(host.querySelector('.navbar'), 'No bar')
+		expect(readStyle(bar, 'position')).toBe('relative')
+		expect(readStyle(bar, 'display')).toBe('flex')
+		expect(readStyle(bar, 'flex-wrap')).toBe('wrap')
+		expect(readStyle(bar, 'align-items')).toBe('center')
+		expect(readStyle(bar, 'justify-content')).toBe('space-between')
+		const brand = requireValue(host.querySelector('.navbar-brand'), 'No brand')
+		expect(readStyle(brand, 'white-space')).toBe('nowrap')
+		expect(readStyle(brand, 'text-decoration-line')).toBe('none')
+		const icon = requireValue(host.querySelector('.navbar-toggler-icon'), 'No icon')
+		expect(readStyle(icon, 'display')).toBe('inline-block')
+		expect(readPixels(icon, 'width')).toBe(30)
+		expect(readPixels(icon, 'height')).toBe(30)
+		expect(readStyle(icon, 'vertical-align')).toBe('middle')
+		expect(readStyle(icon, 'background-repeat')).toBe('no-repeat')
+		expect(readStyle(icon, 'background-size')).toBe('100%')
+		// The layer reading answers for the names no resolved style reaches on its own: a state rule
+		// the partial stopped writing resolves to the resting treatment and reads normal, so the
