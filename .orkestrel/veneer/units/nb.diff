+++ b/home/user/veneer-nb/tests/app/browser/sections/NavbarSection.test.ts
@@ -0,0 +1,151 @@
+import type { SectionInterface } from '@app/browser'
+import { NAVBAR_COPY, NAVBAR_SPECIMENS, NavbarSection, SpecimenSection } from '@app/browser'
+import { requireValue } from '@orkestrel/test'
+import { build, mount, readName } from '@orkestrel/test/browser'
+import { describe, expect, it } from 'vitest'
+
+describe('NavbarSection', () => {
+	it('renders every navbar form and every state class in markup through the shared section contract', () => {
+		const host = mount(build('div'))
+		const section: SectionInterface = new NavbarSection(host)
+		try {
+			expect(section).toBeInstanceOf(SpecimenSection)
+			expect(section.host).toBe(host)
+			const region = requireValue(host.querySelector('section'), 'No Navbar region')
+			expect(region.querySelector('[style]')).toBeNull()
+			expect(region.getAttribute('aria-label')).toBe('Navbar')
+			expect(region.querySelector('p')?.textContent).toBe(NAVBAR_COPY.paragraph)
+			const rendered = [...region.querySelectorAll('[data-specimen]')]
+			expect(rendered.map((element) => element.getAttribute('data-specimen'))).toEqual([
+				'Navbar expanded',
+				'Navbar collapsed',
+				'Navbar opened',
+				'Navbar scroll',
+				'Navbar inverted',
+				'Navbar inverted class',
+				'Navbar expand sm',
+				'Navbar expand md',
+				'Navbar expand lg',
+				'Navbar expand xl',
+				'Navbar expand xxl',
+			])
+			expect(rendered.map((element) => element.innerHTML)).toEqual(
+				NAVBAR_SPECIMENS.map(({ markup }) => markup),
+			)
+			// Every rule the key ships without the pointer or the keyboard has a subject in the region,
+			// each expand step and each dark spelling included, because no script sets a state class
+			// here: a region rendering one spelling alone leaves the other rule photographed by nothing.
+			// The expanded offcanvas panel is the exception, because its own partial has not shipped.
+			for (const selector of [
+				'.navbar',
+				'.navbar > .container-fluid',
+				'.navbar-brand',
+				'.navbar-nav',
+				'.navbar-nav .nav-link.active',
+				'.navbar-nav .nav-link.show',
+				'.navbar-nav .dropdown-menu',
+				'.navbar-nav .dropdown-menu.show',
+				'.navbar-nav .nav-link.disabled',
+				'.navbar-text',
+				'.navbar-text a',
+				'.navbar-collapse',
+				'.navbar-collapse.collapse:not(.show)',
+				'.navbar-collapse.collapse.show',
+				'.navbar-toggler',
+				'.navbar-toggler.collapsed',
+				'.navbar-toggler:not(.collapsed)',
+				'.navbar-toggler-icon',
+				'.navbar-nav-scroll',
+				'.navbar-dark',
+				'.navbar[data-bs-theme="dark"]',
+				'[data-bs-theme="dark"] .navbar-toggler-icon',
+				...['', '-sm', '-md', '-lg', '-xl', '-xxl'].flatMap((infix) => [
+					`.navbar-expand${infix}`,
+					`.navbar-expand${infix} .navbar-nav`,
+					`.navbar-expand${infix} .navbar-nav .dropdown-menu`,
+					`.navbar-expand${infix} .navbar-nav .nav-link`,
+					`.navbar-expand${infix} .navbar-nav-scroll`,
+					`.navbar-expand${infix} .navbar-collapse`,
+					`.navbar-expand${infix} .navbar-toggler`,
+				]),
+			])
+				expect({ selector, rendered: region.querySelector(selector) !== null }).toEqual({
+					selector,
+					rendered: true,
+				})
+			expect(region.querySelector('.offcanvas')).toBeNull()
+			expect(region.querySelector('.navbar-light')).toBeNull()
+			// The journey reaches a link and a toggler by its accessible name, so a repeated label would
+			// resolve to whichever specimen came first and photograph the wrong one.
+			const named = [...region.querySelectorAll('a, button')]
+			const names = named.map((element) => readName(element))
+			expect(new Set(names).size).toBe(names.length)
+			expect(
+				[...region.querySelectorAll('a')].filter(
+					(element) => element.getAttribute('href') !== '#main',
+				),
+			).toEqual([])
+			// Each toggler names the content it controls and announces whether that content is open, and
+			// the collapsed class and the content's show class tell the same story in every bar.
+			for (const toggler of region.querySelectorAll('.navbar-toggler')) {
+				const target = requireValue(
+					region.querySelector(`#${toggler.getAttribute('aria-controls') ?? ''}`),
+					'No controlled content',
+				)
+				const open = target.classList.contains('show')
+				expect(target.matches('.collapse.navbar-collapse')).toBe(true)
+				expect(toggler.getAttribute('aria-expanded')).toBe(String(open))
+				expect(toggler.classList.contains('collapsed')).toBe(!open)
+				expect(toggler.getAttribute('type')).toBe('button')
+				expect(toggler.querySelector(':scope > .navbar-toggler-icon')).not.toBeNull()
+			}
+			// A menu is open exactly where its toggle carries `show`, as the dropdown script leaves it,
+			// and the only open menu lies in a collapsed bar's column rather than hanging from a row.
+			for (const toggle of region.querySelectorAll('.dropdown-toggle')) {
+				const menu = requireValue(toggle.nextElementSibling, 'No menu')
+				expect(menu.classList.contains('show')).toBe(toggle.classList.contains('show'))
+				expect(toggle.getAttribute('aria-expanded')).toBe(String(toggle.classList.contains('show')))
+			}
+			const open = [...region.querySelectorAll('.dropdown-menu.show')]
+			expect(open).not.toStrictEqual([])
+			for (const menu of open)
+				expect(menu.closest('.navbar')?.matches('[class*="navbar-expand"]')).toBe(false)
+			// The current link announces itself through `aria-current`, and every disabled link is
+			// announced and taken out of the tab order rather than being dimmed alone.
+			for (const element of region.querySelectorAll('.nav-link.active'))
+				expect(element.getAttribute('aria-current')).toBe('page')
+			for (const element of region.querySelectorAll('.nav-link.disabled')) {
+				expect(element.getAttribute('aria-disabled')).toBe('true')
+				expect(element.getAttribute('tabindex')).toBe('-1')
+			}
+			// The dark forms sit on a card carrying the dark mode, so their light text has a surface.
+			for (const bar of region.querySelectorAll('.navbar-dark, .navbar[data-bs-theme="dark"]'))
+				expect(bar.parentElement?.matches('.card[data-bs-theme="dark"]')).toBe(true)
+			for (const bar of region.querySelectorAll('nav.navbar'))
+				expect(bar.getAttribute('aria-label')).not.toBeNull()
+			expect(Object.isFrozen(NAVBAR_COPY)).toBe(true)
+			expect(Object.isFrozen(NAVBAR_SPECIMENS)).toBe(true)
+			expect(NAVBAR_SPECIMENS.every((entry) => Object.isFrozen(entry))).toBe(true)
+		} finally {
+			section.destroy()
+			host.remove()
+		}
+	})
+	it('releases the region and preserves adjacent content on repeated destruction', () => {
+		const host = mount(build('div'))
+		const neighbor = build('p', { text: 'Existing content' })
+		host.append(neighbor)
+		const section: SectionInterface = new NavbarSection(host)
+		try {
+			const region = requireValue(host.querySelector('section'), 'No Navbar region')
+			expect(region.isConnected).toBe(true)
+			section.destroy()
+			expect(region.isConnected).toBe(false)
+			section.destroy()
+			expect([...host.children]).toEqual([neighbor])
+		} finally {
+			section.destroy()
+			host.remove()
+		}
+	})
+})
diff --git a/home/user/veneer-nb/tests/src/styles/components/navbar.test.ts b/home/user/veneer-nb/tests/src/styles/components/navbar.test.ts
