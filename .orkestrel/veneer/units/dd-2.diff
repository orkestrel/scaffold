+			expect(section.host).toBe(host)
+			const region = requireValue(host.querySelector('section'), 'No Dropdown region')
+			expect(region.querySelector('[style]')).toBeNull()
+			expect(region.getAttribute('aria-label')).toBe('Dropdown')
+			expect(region.querySelector('p')?.textContent).toBe(DROPDOWN_COPY.paragraph)
+			const rendered = [...region.querySelectorAll('[data-specimen]')]
+			expect(rendered.map((element) => element.getAttribute('data-specimen'))).toEqual([
+				'Dropdown closed',
+				'Dropdown menu',
+				'Dropdown menu end',
+				'Dropup',
+				'Dropend',
+				'Dropstart',
+				'Dropdown center',
+				'Dropup center',
+				'Dropdown menu inverted',
+				'Dropdown align sm',
+				'Dropdown align md',
+				'Dropdown align lg',
+				'Dropdown align xl',
+				'Dropdown align xxl',
+			])
+			expect(rendered.map((element) => element.innerHTML)).toEqual(
+				DROPDOWN_SPECIMENS.map(({ markup }) => markup),
+			)
+			expect(Object.isFrozen(DROPDOWN_COPY)).toBe(true)
+			expect(Object.isFrozen(DROPDOWN_SPECIMENS)).toBe(true)
+			expect(DROPDOWN_SPECIMENS.every((entry) => Object.isFrozen(entry))).toBe(true)
+		} finally {
+			section.destroy()
+			host.remove()
+		}
+	})
+
+	it('sets every state in markup and announces each toggle as its menu stands', () => {
+		const host = mount(build('div'))
+		const section: SectionInterface = new DropdownSection(host)
+		try {
+			const region = requireValue(host.querySelector('section'), 'No Dropdown region')
+			// Every specimen but the closed one shows its menu through the class and the placement
+			// attribute alone, and the closed one shows none, so a specimen that dropped either
+			// reads as the other state here rather than photographing a menu that is not there.
+			const shown = new Map(
+				[...region.querySelectorAll('[data-specimen]')].map((specimen) => [
+					specimen.getAttribute('data-specimen'),
+					[...specimen.querySelectorAll('.dropdown-menu')].map(
+						(menu) =>
+							`${String(menu.classList.contains('show'))}|${String(menu.getAttribute('data-bs-popper'))}`,
+					),
+				]),
+			)
+			const closed = shown.get('Dropdown closed') ?? []
+			expect(closed).not.toStrictEqual([])
+			expect(closed.filter((menu) => menu !== 'false|null')).toStrictEqual([])
+			expect(
+				[...shown].filter(
+					([name, menus]) =>
+						name !== 'Dropdown closed' &&
+						(menus.length === 0 || menus.some((menu) => menu !== 'true|static')),
+				),
+			).toStrictEqual([])
+			// A toggle announces the state its own menu is in, so the accessible tree and the paint
+			// the frames show tell one story.
+			for (const toggle of region.querySelectorAll('.dropdown-toggle')) {
+				const menu = requireValue(toggle.nextElementSibling, 'A toggle has no menu after it')
+				expect(toggle.getAttribute('aria-expanded')).toBe(String(menu.classList.contains('show')))
+			}
