@@ -0,0 +1,591 @@
+import { TOKEN_NAMES } from '@src/core'
+import { requireValue } from '@orkestrel/test'
+import {
+	holdAccessible,
+	matchesColor,
+	readPixels,
+	readRootToken,
+	readStyle,
+	readToken,
+	releasePointer,
+	waitForAnimations,
+} from '@orkestrel/test/browser'
+import { page } from 'vitest/browser'
+import { afterEach, describe, expect, it } from 'vitest'
+import { collectLayer, scene, visitBreakpoint } from '../../../setupBrowser.js'
+import {
+	DROPDOWN_ALIGNMENT_CASES,
+	DROPDOWN_DARK_CASES,
+	DROPDOWN_DIRECTION_CASES,
+	DROPDOWN_MARKUP,
+	DROPDOWN_SELECTORS,
+	DROPDOWN_SPACE_CASES,
+	splitTopLevelList,
+} from '../../../setupStyles.js'
+
+afterEach(async () => {
+	await releasePointer()
+	scene.clear()
+	for (const token of [TOKEN_NAMES.factor.density, TOKEN_NAMES.stack.dropdown])
+		document.documentElement.style.removeProperty(token)
+})
+
+describe('dropdown classes', () => {
+	it('hides the menu at rest, shows it through the class, and reaches the components layer with every recorded selector', () => {
+		const host = scene.mount(
+			`<div class="dropdown"><button type="button" class="btn dropdown-toggle">Menu</button><ul class="dropdown-menu">${DROPDOWN_MARKUP}</ul></div>`,
+		)
+		const menu = requireValue(
+			host.querySelector<HTMLElement>('.dropdown-menu'),
+			'No .dropdown-menu',
+		)
+		expect(readStyle(menu, 'display')).toBe('none')
+		menu.classList.add('show')
+		expect(readStyle(menu, 'display')).toBe('block')
+		// A state or placement rule the partial stopped writing resolves to the resting treatment
+		// on a fixture that never reaches it, so the selectors are held against the rules the
+		// shipped cascade carries.
+		const selected = new Set(
+			collectLayer('components').flatMap((rule) =>
+				rule instanceof CSSStyleRule ? splitTopLevelList(rule.selectorText) : [],
+			),
+		)
+		expect(DROPDOWN_SELECTORS.filter((selector) => !selected.has(selector))).toEqual([])
+	})
+
+	it('positions every wrapper and lays the menu box out from its own slots', () => {
+		const host = scene.mount(
+			`${['dropup', 'dropend', 'dropdown', 'dropstart', 'dropup-center', 'dropdown-center'].map((wrapper) => `<div class="${wrapper}" data-wrapper></div>`).join('')}<div class="dropdown"><button type="button" class="btn dropdown-toggle">Menu</button><ul class="dropdown-menu show">${DROPDOWN_MARKUP}</ul></div>`,
+		)
+		for (const wrapper of host.querySelectorAll('[data-wrapper]'))
+			expect(readStyle(wrapper, 'position')).toBe('relative')
+		const toggle = requireValue(
+			host.querySelector<HTMLElement>('.dropdown-toggle'),
+			'No .dropdown-toggle',
+		)
+		expect(readStyle(toggle, 'white-space')).toBe('nowrap')
+		const menu = requireValue(
+			host.querySelector<HTMLElement>('.dropdown-menu'),
+			'No .dropdown-menu',
+		)
+		expect(readStyle(menu, 'position')).toBe('absolute')
+		expect(readStyle(menu, 'z-index')).toBe('1000')
+		expect(readPixels(menu, 'min-width')).toBe(160)
+		expect(readPixels(menu, 'padding-top')).toBe(8)
+		expect(readPixels(menu, 'padding-bottom')).toBe(8)
+		expect(readPixels(menu, 'padding-left')).toBe(0)
+		expect(readPixels(menu, 'margin-top')).toBe(0)
+		expect(readPixels(menu, 'font-size')).toBe(16)
+		expect(readStyle(menu, 'text-align')).toBe('left')
+		expect(readStyle(menu, 'list-style-type')).toBe('none')
+		expect(readStyle(menu, 'background-clip')).toBe('padding-box')
+		expect(readPixels(menu, 'border-top-width')).toBe(1)
+		expect(readStyle(menu, 'border-top-style')).toBe('solid')
+		expect(readPixels(menu, 'border-top-left-radius')).toBeGreaterThan(0)
+		expect(matchesColor(readStyle(menu, 'background-color'), readRootToken('--bs-body-bg'))).toBe(
+			true,
+		)
+	})
+
+	it.each(DROPDOWN_DIRECTION_CASES)(
+		'opens the $wrapper menu on the $opens side of its toggle, one spacer away',
+		({ wrapper, opens }) => {
+			const host = scene.mount(
+				`<div style="padding:240px"><div class="btn-group ${wrapper}"><button type="button" class="btn dropdown-toggle">Menu</button><ul class="dropdown-menu show" data-bs-popper="static">${DROPDOWN_MARKUP}</ul></div></div>`,
+			)
+			const toggle = requireValue(
+				host.querySelector<HTMLElement>('.dropdown-toggle'),
+				'No .dropdown-toggle',
+			)
+			const menu = requireValue(
+				host.querySelector<HTMLElement>('.dropdown-menu'),
+				'No .dropdown-menu',
+			)
+			const readings: Array<readonly [number, number]> = []
+			// The spacer slot is what the gap reads, so a retune on the menu moves it.
+			for (const spacer of ['', '10px']) {
+				if (spacer !== '') menu.style.setProperty('--bs-dropdown-spacer', spacer)
+				const anchor = toggle.getBoundingClientRect()
+				const box = menu.getBoundingClientRect()
+				// Each reading pairs the distance across the side the menu opens on with the offset
+				// along the edge it aligns to, so a menu opening on the wrong side or sliding along
+				// the right one reads differently from the placement the release records.
+				readings.push(
+					opens === 'bottom'
+						? [box.top - anchor.bottom, box.left - anchor.left]
+						: opens === 'top'
+							? [anchor.top - box.bottom, box.left - anchor.left]
+							: opens === 'right'
+								? [box.left - anchor.right, box.top - anchor.top]
+								: [anchor.left - box.right, box.top - anchor.top],
+				)
+			}
+			expect(readings).toStrictEqual([
+				[2, 0],
+				[10, 0],
+			])
+		},
+	)
+
+	it.each(DROPDOWN_DIRECTION_CASES)(
+		'draws the $wrapper caret on $pseudo alone',
+		({ wrapper, pseudo, sides, raised }) => {
+			const host = scene.mount(
+				`<div class="btn-group ${wrapper}"><button type="button" class="btn dropdown-toggle" style="font-size:20px;color:rgb(10, 20, 30)">Menu</button></div>`,
+			)
+			const toggle = requireValue(
+				host.querySelector<HTMLElement>('.dropdown-toggle'),
+				'No .dropdown-toggle',
+			)
+			const readings = Object.fromEntries(
+				Object.keys(sides).map((side) => {
+					const width = readPixels(toggle, `border-${side}-width`, pseudo)
+					const color = readStyle(toggle, `border-${side}-color`, pseudo)
+					if (width === 0) return [side, 'none']
+					expect(width).toBeCloseTo(6)
+					expect(readStyle(toggle, `border-${side}-style`, pseudo)).toBe('solid')
+					return [side, matchesColor(color, 'rgb(10, 20, 30)') ? 'paint' : 'clear']
+				}),
+			)
+			expect(readings).toStrictEqual(sides)
+			expect(readStyle(toggle, 'display', pseudo)).toBe('inline-block')
+			expect(readPixels(toggle, 'vertical-align', pseudo)).toBeCloseTo(raised ? 5.1 : 0)
+			// The margin sits on the side the caret faces the label from, and the other
+			// pseudo-element paints nothing, so a toggle never draws two carets.
+			expect(
+				readPixels(toggle, pseudo === '::after' ? 'margin-left' : 'margin-right', pseudo),
+			).toBeCloseTo(5.1)
+			expect([
+				readStyle(toggle, 'content', '::before'),
+				readStyle(toggle, 'display', '::after'),
+			]).toStrictEqual(pseudo === '::after' ? ['none', 'inline-block'] : ['""', 'none'])
+		},
+	)
+
+	it.each(DROPDOWN_DIRECTION_CASES)(
+		'drops the caret margin on an empty $wrapper toggle',
+		({ wrapper }) => {
+			const host = scene.mount(
+				`<div class="btn-group ${wrapper}"><button type="button" class="btn dropdown-toggle" style="font-size:20px" data-labelled>Menu</button><button type="button" class="btn dropdown-toggle" style="font-size:20px" aria-label="Menu" data-empty></button></div>`,
+			)
+			expect(
+				readPixels(
+					requireValue(host.querySelector<HTMLElement>('[data-labelled]'), 'No [data-labelled]'),
+					'margin-left',
+					'::after',
+				),
+			).toBeCloseTo(5.1)
+			expect(
+				readPixels(
+					requireValue(host.querySelector<HTMLElement>('[data-empty]'), 'No [data-empty]'),
+					'margin-left',
+					'::after',
+				),
+			).toBe(0)
+		},
+	)
+})
+
+describe('dropdown alignment', () => {
+	it('aligns the end menu to its wrapper end under the placement attribute, the start and centered menus to its start, and publishes each side', () => {
+		const host = scene.mount(
+			`${['dropdown-menu-end', 'dropdown-menu-start', ''].map((classes) => `<div class="dropdown" style="width:400px"><ul class="dropdown-menu show ${classes}" data-bs-popper="static">${DROPDOWN_MARKUP}</ul></div>`).join('')}${['dropdown-center', 'dropup-center dropup'].map((wrapper) => `<div class="${wrapper}" style="width:400px;margin-top:320px"><ul class="dropdown-menu show" data-bs-popper="static">${DROPDOWN_MARKUP}</ul></div>`).join('')}<div class="dropdown" style="width:400px;margin-top:320px"><ul class="dropdown-menu show dropdown-menu-end">${DROPDOWN_MARKUP}</ul></div>`,
+		)
+		const edges = [...host.querySelectorAll('.dropdown-menu')].map((menu) => {
+			const wrapper = requireValue(
+				menu.parentElement,
+				'A menu has no wrapper',
+			).getBoundingClientRect()
+			const box = menu.getBoundingClientRect()
+			return [box.left - wrapper.left, wrapper.right - box.right === 0]
+		})
+		// The centered wrappers paint the menu at their start, as the cascade places it; centering is
+		// placement a dropdown engine performs. An end menu with no placement attribute keeps the
+		// start the flow gives it, because the class aligns nothing without the attribute.
+		expect(edges.map(([left, flush]) => `${String(left === 0)}|${String(flush)}`)).toStrictEqual([
+			'false|true',
+			'true|false',
+			'true|false',
+			'true|false',
+			'true|false',
+			'true|false',
+		])
+		const menus = [...host.querySelectorAll('.dropdown-menu')]
+		// The published side answers to the class alone, so the unplaced end menu still publishes it.
+		expect(menus.map((menu) => readToken(menu, '--bs-position'))).toStrictEqual([
+			'end',
+			'start',
+			'',
+			'',
+			'',
+			'end',
+		])
+	})
+
+	it.each(DROPDOWN_ALIGNMENT_CASES)(
+		'switches the $name alignment and the published side at its boundary',
+		async ({ name, boundary, readings }) => {
+			const host = scene.mount(
+				`<div class="dropdown" style="width:300px"><ul class="dropdown-menu show dropdown-menu-${name}-end" data-bs-popper="static" data-ramp="end">${DROPDOWN_MARKUP}</ul></div><div class="dropdown" style="width:300px"><ul class="dropdown-menu show dropdown-menu-end dropdown-menu-${name}-start" data-bs-popper="static" data-ramp="start">${DROPDOWN_MARKUP}</ul></div>`,
+			)
+			for (const viewport of readings)
+				await visitBreakpoint(viewport, () => {
+					expect(window.innerWidth).toBe(viewport)
+					const reached = viewport >= boundary
+					expect(
+						['end', 'start'].map((ramp) => {
+							const menu = requireValue(
+								host.querySelector<HTMLElement>(`[data-ramp="${ramp}"]`),
+								'No ramp menu',
+							)
+							const wrapper = requireValue(menu.parentElement, 'No wrapper').getBoundingClientRect()
+							const box = menu.getBoundingClientRect()
