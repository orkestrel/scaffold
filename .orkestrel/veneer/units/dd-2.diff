+			])
+			// Each toggle and each focusable item announces a name no other control in the region
+			// repeats, because the journey reaches a control by that name.
+			const names = [...region.querySelectorAll('button, a[href]')].map(
+				(control) => control.getAttribute('aria-label') ?? control.textContent,
+			)
+			expect(new Set(names).size).toBe(names.length)
+		} finally {
+			section.destroy()
+			host.remove()
+		}
+	})
+
+	// The journey photographs each specimen at these two widths, and the grid columns that seat each
+	// toggle reflow between them, so the room each menu keeps is read at both.
+	it.each([390, 1280])(
+		'keeps each shown menu inside the specimen that holds it at a %i-pixel viewport',
+		async (width) => {
+			const host = mount(build('div'))
+			const section: SectionInterface = new DropdownSection(host)
+			try {
+				const region = requireValue(host.querySelector('section'), 'No Dropdown region')
+				const { measured, escaped } = await visitBreakpoint(width, () => {
+					expect(window.innerWidth).toBe(width)
+					const names: string[] = []
+					const outside: string[] = []
+					for (const specimen of region.querySelectorAll('[data-specimen]')) {
+						const frame = specimen.getBoundingClientRect()
+						for (const menu of specimen.querySelectorAll('.dropdown-menu.show')) {
+							expect(isRendered(menu)).toBe(true)
+							names.push(String(specimen.getAttribute('data-specimen')))
+							const box = menu.getBoundingClientRect()
+							// The frame is shot on the specimen's own box, so a menu reaching past any edge
+							// of it is cropped out of the frame that claims to show it.
+							if (
+								box.top < frame.top ||
+								box.bottom > frame.bottom ||
+								box.left < frame.left ||
+								box.right > frame.right
+							)
+								outside.push(String(specimen.getAttribute('data-specimen')))
+						}
+					}
+					return { measured: names, escaped: outside }
+				})
+				// Every specimen but the closed one is measured, and each ramp step measures both of its
+				// menus, so a specimen whose menu lost its class is missing here rather than passing.
+				expect(new Set(measured)).toEqual(
+					new Set(
+						DROPDOWN_SPECIMENS.map(({ name }) => name).filter((name) => name !== 'Dropdown closed'),
+					),
+				)
+				for (const step of ['sm', 'md', 'lg', 'xl', 'xxl'])
+					expect(measured.filter((name) => name === `Dropdown align ${step}`)).toHaveLength(2)
+				expect(escaped).toStrictEqual([])
+				// The closed menu stays out of the layout, so the closed specimen is its toggles alone.
+				const closed = requireValue(
+					region.querySelector('[data-specimen="Dropdown closed"] .dropdown-menu'),
+					'No closed menu',
+				)
+				expect(isRendered(closed)).toBe(false)
+			} finally {
+				section.destroy()
+				host.remove()
+			}
+		},
+	)
+
+	it('releases the region and preserves adjacent content on repeated destruction', () => {
+		const host = mount(build('div'))
+		const neighbor = build('p', { text: 'Existing content' })
+		host.append(neighbor)
+		const section: SectionInterface = new DropdownSection(host)
+		try {
+			const region = requireValue(host.querySelector('section'), 'No Dropdown region')
+			expect(region.isConnected).toBe(true)
+			section.destroy()
+			expect(region.isConnected).toBe(false)
+			section.destroy()
+			expect([...host.children]).toEqual([neighbor])
+		} finally {
+			section.destroy()
+			host.remove()
+		}
+	})
+})
