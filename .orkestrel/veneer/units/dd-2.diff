+import { DROPDOWN_COPY, DROPDOWN_SPECIMENS } from '../constants.js'
+import { SpecimenSection } from './SpecimenSection.js'
+
+/**
+ * Renders the declared dropdown specimens into a named region.
+ * @example
+ * ```ts
+ * const section = new DropdownSection(document.body)
+ * section.destroy()
+ * ```
+ */
+export class DropdownSection extends SpecimenSection {
+	/**
+	 * Mounts the Dropdown region and its specimens.
+	 * @param host - The element receiving the section.
+	 */
+	constructor(host: HTMLElement) {
+		super(host, DROPDOWN_COPY, DROPDOWN_SPECIMENS)
+	}
+}
