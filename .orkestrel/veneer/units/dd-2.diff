new file mode 100644
index 0000000..7c2827b
--- /dev/null
+++ b/src/styles/components/_dropdown.scss
@@ -0,0 +1,300 @@
+@use '../mixins' as *;
+
+// Names each direction the release turns the toggle's caret in: the wrapper class that turns it,
+// or none for the downward caret the toggle carries on its own; the pseudo-element that paints it;
+// the border sides that draw it; and whether the caret sits above the baseline rather than on it.
+// One loop over this list emits every caret in the release's order, so a direction's rules cannot
+// drift from its siblings'.
+$carets: (
+	(
+		null,
+		after,
+		(
+			top: 0.3em solid,
+			right: 0.3em solid transparent,
+			bottom: 0,
+			left: 0.3em solid transparent,
+		),
+		true
+	),
+	(
+		'.dropup',
+		after,
+		(
+			top: 0,
+			right: 0.3em solid transparent,
+			bottom: 0.3em solid,
+			left: 0.3em solid transparent,
+		),
+		true
+	),
+	(
+		'.dropend',
+		after,
+		(
+			top: 0.3em solid transparent,
+			right: 0,
+			bottom: 0.3em solid transparent,
+			left: 0.3em solid,
+		),
+		false
+	),
+	(
+		'.dropstart',
+		before,
+		(
+			top: 0.3em solid transparent,
+			right: 0.3em solid,
+			bottom: 0.3em solid transparent,
+		),
+		false
+	)
+);
+
+@layer components {
+	// Every value here is Bootstrap 5.3.8's own. A length reads the Veneer scale token that already
+	// resolves to it, so the density factor reaches the menu; the stacking level reads the dropdown
+	// tier the stack scale publishes; a color reads the compatibility variable Bootstrap itself
+	// names, or the palette or gray token that carries Bootstrap's literal, because a partial
+	// declares no literal color of its own. The classes are set in markup: no rule here opens,
+	// closes, or places a menu on its own.
+	.dropup,
+	.dropend,
+	.dropdown,
+	.dropstart,
+	.dropup-center,
+	.dropdown-center {
+		position: relative;
+	}
+
+	.dropdown-toggle {
+		white-space: nowrap;
+	}
+
+	// The caret is drawn from borders on an empty inline box, and its margin and the sides that draw
+	// it are physical, because this cascade carries no right-to-left twin. The start caret moves to
+	// the `::before` pseudo-element and hides the `::after` caret, so a toggle never paints two.
+	@each $host, $pseudo, $sides, $raised in $carets {
+		$toggle: '.dropdown-toggle';
+		@if $host {
+			$toggle: '#{$host} .dropdown-toggle';
+		}
+
+		#{$toggle}::after {
+			display: inline-block;
+			margin-left: 0.255em;
+			vertical-align: 0.255em;
+			content: '';
+			@if $pseudo == after {
+				@each $side, $value in $sides {
+					border-#{$side}: $value;
+				}
+			}
+		}
+
+		@if $pseudo == before {
+			#{$toggle}::after {
+				display: none;
+			}
+
+			#{$toggle}::before {
+				display: inline-block;
+				margin-right: 0.255em;
+				vertical-align: 0.255em;
+				content: '';
+				@each $side, $value in $sides {
+					border-#{$side}: $value;
+				}
+			}
+		}
+
+		#{$toggle}:empty::after {
+			margin-left: 0;
+		}
+
+		@if not $raised {
+			#{$toggle}::#{$pseudo} {
+				vertical-align: 0;
+			}
+		}
+	}
+
+	.dropdown-menu {
+		--bs-dropdown-zindex: var(--vn-stack-dropdown);
+		--bs-dropdown-min-width: 10rem;
+		--bs-dropdown-padding-x: 0;
+		--bs-dropdown-padding-y: var(--vn-space-4);
+		--bs-dropdown-spacer: var(--vn-space-1);
+		--bs-dropdown-font-size: var(--vn-size-3);
+		--bs-dropdown-color: var(--bs-body-color);
+		--bs-dropdown-bg: var(--bs-body-bg);
+		--bs-dropdown-border-color: var(--bs-border-color-translucent);
+		--bs-dropdown-border-radius: var(--bs-border-radius);
+		--bs-dropdown-border-width: var(--bs-border-width);
+		--bs-dropdown-inner-border-radius: calc(var(--bs-border-radius) - var(--bs-border-width));
+		--bs-dropdown-divider-bg: var(--bs-border-color-translucent);
+		--bs-dropdown-divider-margin-y: var(--vn-space-4);
+		--bs-dropdown-box-shadow: var(--bs-box-shadow);
+		--bs-dropdown-link-color: var(--bs-body-color);
+		--bs-dropdown-link-hover-color: var(--bs-body-color);
+		--bs-dropdown-link-hover-bg: var(--bs-tertiary-bg);
+		--bs-dropdown-link-active-color: var(--vn-palette-white-base);
+		--bs-dropdown-link-active-bg: var(--vn-palette-blue);
+		--bs-dropdown-link-disabled-color: var(--bs-tertiary-color);
+		--bs-dropdown-item-padding-x: var(--vn-space-8);
+		--bs-dropdown-item-padding-y: var(--vn-space-2);
+		--bs-dropdown-header-color: var(--vn-gray-600);
+		--bs-dropdown-header-padding-x: var(--vn-space-8);
+		--bs-dropdown-header-padding-y: var(--vn-space-4);
+		position: absolute;
+		z-index: var(--bs-dropdown-zindex);
+		display: none;
+		min-width: var(--bs-dropdown-min-width);
+		padding: var(--bs-dropdown-padding-y) var(--bs-dropdown-padding-x);
+		margin: 0;
+		font-size: var(--bs-dropdown-font-size);
+		color: var(--bs-dropdown-color);
+		text-align: left;
+		list-style: none;
+		background-color: var(--bs-dropdown-bg);
+		background-clip: padding-box;
+		border: var(--bs-dropdown-border-width) solid var(--bs-dropdown-border-color);
+		border-radius: var(--bs-dropdown-border-radius);
+	}
+
+	// The attribute is what a placement engine writes when it leaves the menu to the stylesheet, so
+	// these placements answer to it rather than to the wrapper alone.
+	.dropdown-menu[data-bs-popper] {
+		top: 100%;
+		left: 0;
+		margin-top: var(--bs-dropdown-spacer);
+	}
+
+	// The release hardcodes the `bs-` prefix on the `--bs-position` property because its script
+	// reads the property to choose a placement. No rule here reads it; it ships so an engine can.
+	@include breakpoint-each using ($infix, $_boundary) {
+		.dropdown-menu#{$infix}-start {
+			--bs-position: start;
+		}
+
+		.dropdown-menu#{$infix}-start[data-bs-popper] {
+			right: auto;
+			left: 0;
+		}
+
+		.dropdown-menu#{$infix}-end {
+			--bs-position: end;
+		}
+
+		.dropdown-menu#{$infix}-end[data-bs-popper] {
+			right: 0;
+			left: auto;
+		}
+	}
+
+	.dropup .dropdown-menu[data-bs-popper] {
+		top: auto;
+		bottom: 100%;
+		margin-top: 0;
+		margin-bottom: var(--bs-dropdown-spacer);
+	}
+
+	.dropend .dropdown-menu[data-bs-popper] {
+		top: 0;
+		right: auto;
+		left: 100%;
+		margin-top: 0;
+		margin-left: var(--bs-dropdown-spacer);
+	}
+
+	.dropstart .dropdown-menu[data-bs-popper] {
+		top: 0;
+		right: 100%;
+		left: auto;
+		margin-top: 0;
+		margin-right: var(--bs-dropdown-spacer);
+	}
+
+	.dropdown-divider {
+		height: 0;
+		margin: var(--bs-dropdown-divider-margin-y) 0;
+		overflow: hidden;
+		border-top: 1px solid var(--bs-dropdown-divider-bg);
+		opacity: 1;
+	}
+
+	// The width, the alignment, the transparent fill, and the missing border are what make a button
+	// host read like the anchor beside it.
+	.dropdown-item {
+		display: block;
+		width: 100%;
+		padding: var(--bs-dropdown-item-padding-y) var(--bs-dropdown-item-padding-x);
+		clear: both;
+		font-weight: var(--vn-weight-body);
+		color: var(--bs-dropdown-link-color);
+		text-align: inherit;
+		text-decoration: none;
+		white-space: nowrap;
+		background-color: transparent;
+		border: 0;
+		border-radius: var(--bs-dropdown-item-border-radius, 0);
+	}
+
+	.dropdown-item:hover,
+	.dropdown-item:focus {
+		color: var(--bs-dropdown-link-hover-color);
+		background-color: var(--bs-dropdown-link-hover-bg);
+	}
+
+	.dropdown-item.active,
+	.dropdown-item:active {
+		color: var(--bs-dropdown-link-active-color);
+		text-decoration: none;
+		background-color: var(--bs-dropdown-link-active-bg);
+	}
+
+	.dropdown-item.disabled,
+	.dropdown-item:disabled {
+		color: var(--bs-dropdown-link-disabled-color);
+		pointer-events: none;
+		background-color: transparent;
+	}
+
+	.dropdown-menu.show {
+		display: block;
+	}
+
+	.dropdown-header {
+		display: block;
+		padding: var(--bs-dropdown-header-padding-y) var(--bs-dropdown-header-padding-x);
+		margin-bottom: 0;
+		font-size: var(--vn-size-2);
+		color: var(--bs-dropdown-header-color);
+		white-space: nowrap;
+	}
+
+	.dropdown-item-text {
+		display: block;
+		padding: var(--bs-dropdown-item-padding-y) var(--bs-dropdown-item-padding-x);
+		color: var(--bs-dropdown-link-color);
+	}
+
+	// The release's legacy dark menu retunes the menu's own slots on a class rather than under the
+	// theme attribute, so it paints dark inside a light island and needs no theme scope. It sits
+	// after the menu rule it retunes, which is what lets one class of equal weight win. The empty
+	// shadow is the release's own: the dark menu drops the shadow slot to nothing.
+	.dropdown-menu-dark {
+		--bs-dropdown-color: var(--vn-gray-300);
+		--bs-dropdown-bg: var(--vn-gray-800);
+		--bs-dropdown-border-color: var(--bs-border-color-translucent);
+		--bs-dropdown-box-shadow: ;
+		--bs-dropdown-link-color: var(--vn-gray-300);
+		--bs-dropdown-link-hover-color: var(--vn-palette-white-base);
+		--bs-dropdown-divider-bg: var(--bs-border-color-translucent);
+		--bs-dropdown-link-hover-bg: color-mix(in srgb, var(--vn-palette-white-base) 15%, transparent);
+		--bs-dropdown-link-active-color: var(--vn-palette-white-base);
+		--bs-dropdown-link-active-bg: var(--vn-palette-blue);
+		--bs-dropdown-link-disabled-color: var(--vn-gray-500);
+		--bs-dropdown-header-color: var(--vn-gray-500);
+	}
+}
diff --git a/tests/src/styles/components/dropdown.test.ts b/tests/src/styles/components/dropdown.test.ts
