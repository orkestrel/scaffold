+/**
+ * Collects the longhands whose resolved value moved between a standalone and a paired reading of
+ * the same elements.
+ *
+ * @param standalone - The standalone readings, each labelled, such as a class name and the computed
+ *   snapshot of one element carrying it under the cascade alone.
+ * @param paired - The paired readings, in the order of `standalone`, such as the same elements read
+ *   after a compiled profile arrived.
+ * @returns One line per moved longhand, in reading order and then in the order each standalone
+ *   reading enumerates its properties, written as `label property: value became after`. An empty
+ *   list means every longhand of every standalone reading resolved alike.
+ *
+ * @remarks
+ * The walk runs over the standalone reading's properties, so a longhand the paired reading lacks is
+ * a move to `undefined`, and a standalone reading with no paired reading at its index reports every
+ * longhand it holds. A paired reading taken on fewer properties, or never taken, therefore reports
+ * rather than passing unread. Each pair is compared by the value its map holds for a property,
+ * never by key order.
+ *
+ * @example
+ * ```ts
+ * collectMovedLonghands([['col-1', new Map([['grid-column-start', 'auto']])]], [new Map([['grid-column-start', '1']])])
+ * // ['col-1 grid-column-start: auto became 1']
+ * ```
+ */
+export function collectMovedLonghands(
+	standalone: ReadonlyArray<readonly [string, ReadonlyMap<string, string>]>,
+	paired: ReadonlyArray<ReadonlyMap<string, string>>,
+): readonly string[] {
+	const moved: string[] = []
+	for (const [index, [label, snapshot]] of standalone.entries()) {
+		const after = paired[index]
+		for (const [property, value] of snapshot) {
+			const settled = after?.get(property)
+			if (settled !== value) moved.push(`${label} ${property}: ${value} became ${String(settled)}`)
+		}
+	}
+	return moved
+}
