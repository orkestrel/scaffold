+ * {@link normalizeResolvedColors} helper.
+ *
+ * A pair resolves to nothing where a side writes no value, where Chromium parses none of a regular
+ * property's values on one side, where no syntax and no property parses both values of a custom
+ * property, or where Chromium serializes the computed value as empty. The resolver keeps every
+ * answer for the pair it read, so a comparison repeated over the same pairs reads each one once.
+ * Every `resolve` call rebuilds the pages' elements, so await each call before making the next.
+ */
+export class ValueResolver {
+	readonly #browser: Browser
+	readonly #recorded: Page
+	readonly #emitted: Page
+	readonly #neutral: Page
+	readonly #resolved = new Map<string, Resolution | undefined>()
+
+	/**
+	 * Wraps three pages of one launched browser, as the {@link createValueResolver} helper opens
+	 * them.
+	 * @param browser - The browser the pages belong to, which the `destroy` method closes.
+	 * @param recorded - The page carrying the stylesheet the recorded values read.
+	 * @param emitted - The page carrying the stylesheet the emitted values read.
+	 * @param neutral - The page carrying no stylesheet, with every probe registered.
+	 */
+	constructor(browser: Browser, recorded: Page, emitted: Page, neutral: Page) {
+		this.#browser = browser
+		this.#recorded = recorded
+		this.#emitted = emitted
+		this.#neutral = neutral
+	}
+
+	/**
+	 * Resolves each pair's two values in Chromium.
+	 * @param pairs - The pairs to resolve.
+	 * @returns Each pair's resolution in the order given, or undefined for a pair the resolver
+	 *   cannot decide.
+	 */
+	async resolve(pairs: readonly ValuePair[]): Promise<ReadonlyArray<Resolution | undefined>> {
+		const keys = pairs.map((pair) =>
+			JSON.stringify([pair.selector, pair.property, pair.recorded, pair.emitted]),
+		)
+		const pending = new Map<string, ValuePair>()
+		for (const [index, pair] of pairs.entries()) {
+			const key = keys[index] ?? ''
+			if (this.#resolved.has(key)) continue
+			if (pair.recorded.length === 0 || pair.emitted.length === 0)
+				this.#resolved.set(key, undefined)
+			else pending.set(key, pair)
+		}
+		const batch = [...pending.values()]
+		if (batch.length > 0) {
+			const contexts = batch.map((pair) => collectContextElements(pair.selector))
+			const [recorded, emitted] = await Promise.all([
+				this.#substitute(
+					this.#recorded,
+					batch,
+					contexts,
+					batch.map((pair) => pair.recorded),
+				),
+				this.#substitute(
+					this.#emitted,
+					batch,
+					contexts,
+					batch.map((pair) => pair.emitted),
+				),
+			])
+			const computed = await this.#neutral.evaluate(
+				({ items, prefix, count, properties }) => {
+					document.body.replaceChildren()
+					const hosts = ['light', 'dark'].map((scheme) => {
+						const host = document.createElement('div')
+						host.style.setProperty('color-scheme', scheme)
+						host.style.setProperty('font-size', '16px')
+						host.style.setProperty('width', '1000px')
+						document.body.append(host)
+						return host
+					})
+					const probes = Array.from(
+						{ length: count },
+						(_probe, index) => `${prefix}-${String(index)}`,
+					)
+					const chosen = items.map((item) =>
+						[item.recorded, item.emitted].map((values) =>
+							item.property.startsWith('--')
+								? values.at(-1)
+								: values.findLast((value) => CSS.supports(item.property, value)),
+						),
+					)
+					const twins = items.map((item, index) =>
+						(chosen[index] ?? []).map((value) => {
+							const element = document.createElement('div')
+							const host = item.dark ? hosts[1] : hosts[0]
+							host?.append(element)
+							if (value === undefined || value === '') return element
+							if (!item.property.startsWith('--')) {
+								element.style.setProperty(item.property, value)
+								return element
+							}
+							for (const probe of probes) {
+								element.style.setProperty(probe, value)
+								element.style.setProperty(`${probe}-control`, value)
+							}
+							for (const name of properties)
+								if (CSS.supports(name, value)) element.style.setProperty(name, value)
+							return element
+						}),
+					)
+					return items.map((item, index) => {
+						const [first, second] = chosen[index] ?? []
+						if (first === undefined || second === undefined) return undefined
+						const custom = item.property.startsWith('--')
+						if (custom && (first === '' || second === ''))
+							return { recorded: first, emitted: second }
+						const styles = (twins[index] ?? []).map((element) => getComputedStyle(element))
+						const name = !custom
+							? item.property
+							: (probes.find((probe) =>
+									styles.every(
+										(style) =>
+											style.getPropertyValue(probe) === style.getPropertyValue(`${probe}-control`),
+									),
+								) ??
+								properties.find(
+									(candidate) => CSS.supports(candidate, first) && CSS.supports(candidate, second),
+								))
+						if (name === undefined) return undefined
+						const [left, right] = styles.map((style) => style.getPropertyValue(name).trim())
+						if (left === undefined || right === undefined || left === '' || right === '')
+							return undefined
+						return { recorded: left, emitted: right }
+					})
+				},
+				{
+					items: batch.map((pair, index) => ({
+						property: pair.property,
+						dark: matchesDarkScope(pair.selector),
+						recorded: recorded[index] ?? [],
+						emitted: emitted[index] ?? [],
+					})),
+					prefix: PROBE_PREFIX,
+					count: Object.keys(PROBE_SYNTAXES).length,
+					properties: PROBE_PROPERTIES,
+				},
+			)
+			for (const [index, key] of [...pending.keys()].entries()) {
+				const resolution = computed[index]
+				this.#resolved.set(
+					key,
+					resolution === undefined
+						? undefined
+						: {
+								recorded: normalizeResolvedColors(resolution.recorded),
+								emitted: normalizeResolvedColors(resolution.emitted),
+							},
+				)
+			}
+		}
+		return keys.map((key) => this.#resolved.get(key))
+	}
+
+	/** Closes the browser, and every page with it. */
+	async destroy(): Promise<void> {
+		await this.#browser.close()
+	}
+
+	// Reads each side's values in its own page, with every variable substituted at the site.
+	async #substitute(
+		page: Page,
+		pairs: readonly ValuePair[],
+		contexts: ReadonlyArray<readonly ContextElement[]>,
+		sides: ReadonlyArray<readonly string[]>,
+	): Promise<ReadonlyArray<readonly string[]>> {
+		const items = pairs.flatMap((pair, index) =>
+			(sides[index] ?? []).map((value) => ({
+				elements: contexts[index] ?? [],
+				property: pair.property,
+				value,
+			})),
+		)
+		const read = await page.evaluate(
+			({ batch, raw }) => {
+				document.body.replaceChildren()
+				const subjects = batch.map((item) => {
+					let subject: HTMLElement = document.body
+					for (const described of item.elements) {
+						const element = document.createElement(described.tag)
+						for (const name of described.classes) element.classList.add(name)
+						for (const [name, value] of described.attributes) element.setAttribute(name, value)
+						const host = described.sibling ? (subject.parentElement ?? document.body) : subject
+						host.append(element)
+						subject = element
+					}
+					if (item.value.trim() !== '')
+						subject.style.setProperty(
+							item.property.startsWith('--') ? item.property : raw,
+							item.value,
+						)
+					return subject
+				})
+				return batch.map((item, index) => {
+					const subject = subjects[index]
+					if (subject === undefined || item.value.trim() === '') return item.value.trim()
+					const style = getComputedStyle(subject)
+					if (item.property.startsWith('--')) return style.getPropertyValue(item.property).trim()
+					if (!/var\(/iu.test(item.value)) return item.value
+					const substituted = style.getPropertyValue(raw).trim()
+					return substituted === '' ? 'unset' : substituted
+				})
+			},
+			{ batch: items, raw: `${PROBE_PREFIX}-raw` },
+		)
+		let offset = 0
+		return sides.map((values) => {
+			const slice = read.slice(offset, offset + values.length)
+			offset += values.length
+			return slice
+		})
+	}
+}
+
+/**
+ * Creates a value resolver over two stylesheets, in a Chromium it launches.
+ * @param recorded - The stylesheet text every recorded value reads, such as the release's.
+ * @param emitted - The stylesheet text every emitted value reads, such as the built cascade.
+ * @returns The resolver, whose `destroy` method closes the browser it launched.
+ * @throws When the browser options name a remote connection, and when the launch or a page fails,
+ *   after closing any browser it launched.
+ */
+export async function createValueResolver(
+	recorded: string,
+	emitted: string,
+): Promise<ValueResolver> {
+	const options = resolveBrowser(resolvePinnedBrowser(), process.platform, process.env)
+	if (options.connectOptions !== undefined)
+		throw new Error(
+			'The value resolver requires a local browser executable, not a remote connection',
+		)
+	const browser = await chromium.launch({ ...options.launchOptions, headless: true })
+	try {
+		const pages = await Promise.all(
+			[recorded, emitted, undefined].map(async (sheet) => {
+				const page = await browser.newPage()
+				await page.setContent(
+					'<!doctype html><html lang="en"><head><meta charset="utf-8"><title>Value resolver</title></head><body></body></html>',
+				)
+				if (sheet !== undefined) await page.addStyleTag({ content: sheet })
+				return page
+			}),
+		)
+		const [recordedPage, emittedPage, neutral] = pages
+		if (recordedPage === undefined || emittedPage === undefined || neutral === undefined)
+			throw new Error('The value resolver opened no page')
+		await neutral.evaluate(
+			({ prefix, syntaxes }) => {
+				for (const [index, [syntax, initial, control]] of syntaxes.entries()) {
+					const name = `${prefix}-${String(index)}`
+					CSS.registerProperty({ name, syntax, inherits: false, initialValue: initial })
+					CSS.registerProperty({
+						name: `${name}-control`,
+						syntax,
+						inherits: false,
+						initialValue: control,
+					})
+				}
+			},
+			{
+				prefix: PROBE_PREFIX,
+				syntaxes: Object.entries(PROBE_SYNTAXES).map(
+					([syntax, [initial, control]]) => [syntax, initial, control] as const,
+				),
+			},
+		)
+		return new ValueResolver(browser, recordedPage, emittedPage, neutral)
+	} catch (error) {
+		await browser.close()
+		throw error
+	}
+}
+
+/**
+ * Classifies every measured value difference by the values its two sides resolve to.
+ *
+ * @param gaps - The measured differences, as the {@link collectValueGaps} helper returns them.
+ * @param resolver - A resolver whose recorded side reads the release's stylesheet and whose
+ *   emitted side reads the built cascade.
+ * @returns Each difference the resolver decides as the departure row the guide records, in the
+ *   order given, and each one it cannot decide as the line the {@link describeValueGap} helper
+ *   writes for it.
+ *
+ * @remarks
+ * A difference the resolver cannot decide takes no member, so no pair falls back to the member its
+ * text alone would name. The ledger gate expects the undecided list empty, and a difference the
+ * cascade does not write is `dropped` without a reading.
+ */
+export async function classifyValueGaps(
+	gaps: readonly ValueGap[],
+	resolver: ValueResolver,
+): Promise<DepartureLedger> {
+	const resolutions = await resolver.resolve(
+		gaps.map((gap) => ({
+			selector: gap.selector,
+			property: gap.property,
+			recorded: gap.written,
+			emitted: gap.emitted === undefined ? [] : [gap.emitted],
+		})),
+	)
+	const departures: DepartureRow[] = []
+	const undecided: string[] = []
+	for (const [index, gap] of gaps.entries()) {
+		const departure = classifyDeparture(gap.recorded, gap.emitted, resolutions[index])
+		if (departure === undefined) {
+			undecided.push(describeValueGap(gap))
+			continue
+		}
+		departures.push({
+			component: gap.component,
+			selector: gap.selector,
+			property: gap.property,
+			condition: gap.condition,
+			recorded: gap.recorded,
+			emitted: gap.emitted,
+			departure,
+		})
+	}
+	return { departures, undecided }
+}
+
+/**
+ * Scans every site that declares a canonical token for a declaration that resolves apart from the
+ * token's § Reference map cell.
+ *
+ * @param blocks - The compiled cascade's blocks, as the {@link readCascadeBlocks} helper reads
+ *   them.
+ * @param references - The reference map's rows, as the `collectReferenceRows` helper reads them.
+ * @param resolver - A resolver whose two sides read one stylesheet, the built cascade, so a cell
+ *   and a declaration read the same variables.
+ * @returns One line per mapped token the `:root` selector does not declare, as its token, the
+ *   `:root` site, and its light cell; then one line per token and site whose declaration resolves
+ *   apart from its cell, as its token, selector, condition, cell, declaration, and both resolved
+ *   values, and one per pair the resolver cannot decide, ending in `undecided`, in reference order.
+ *
+ * @remarks
+ * A token resolves in each mode at that mode's scope. The light reading takes the
+ * `[data-bs-theme=light]` rule's declaration where that rule declares the token, and the `:root`
+ * rule's otherwise. The dark reading takes the `[data-bs-theme=dark]` rule's declaration, or the
+ * `:root` rule's where the dark scope declares none, and resolves it inside the dark scope, so a
+ * token every mode shares still reads the dark scope's variables. Every other site that declares a
+ * canonical token, under any selector or condition, compares against the cell of the mode its
+ * selector sits in, so a token a component rule redeclares is measured rather than left outside
+ * both ledgers. A token the registry names and the map does not carries no cell and is not read.
+ */
+export async function scanCanonicalValues(
+	blocks: readonly CascadeBlock[],
+	references: readonly ReferenceRow[],
+	resolver: ValueResolver,
+): Promise<readonly string[]> {
+	const scopes = [':root', '[data-bs-theme=light]', '[data-bs-theme=dark]']
+	const lines: string[] = []
+	const checks = new Map<string, readonly [string, string, string | undefined, string, string]>()
+	for (const row of references) {
+		const declared = new Map(
+			scopes.map((scope) => [
+				scope,
+				blocks
+					.filter((block) => block.selector === scope && block.condition === undefined)
+					.flatMap((block) => block.declarations.get(row.token) ?? [])
+					.at(-1),
+			]),
+		)
+		const root = declared.get(':root')
+		if (root === undefined) {
+			const line = [row.token, ':root', ABSENT_CELL, row.light, ABSENT_CELL].join(' | ')
+			if (!lines.includes(line)) lines.push(line)
+			continue
+		}
+		const light = declared.get('[data-bs-theme=light]')
+		const sites: Array<readonly [string, string, string | undefined, string, string]> = [
+			[
+				row.token,
+				light === undefined ? ':root' : '[data-bs-theme=light]',
+				undefined,
+				row.light,
+				light ?? root,
+			],
+			[
+				row.token,
+				'[data-bs-theme=dark]',
+				undefined,
+				row.dark,
+				declared.get('[data-bs-theme=dark]') ?? root,
+			],
+		]
+		for (const block of blocks) {
+			const value = block.declarations.get(row.token)
+			if (value === undefined || (block.condition === undefined && scopes.includes(block.selector)))
+				continue
+			sites.push([
+				row.token,
+				block.selector,
+				block.condition,
+				matchesDarkScope(block.selector) ? row.dark : row.light,
+				value,
+			])
+		}
+		for (const site of sites) checks.set(JSON.stringify(site), site)
+	}
+	const pending = [...checks.values()]
+	const resolutions = await resolver.resolve(
+		pending.map(([token, selector, , stated, value]) => ({
+			selector,
+			property: token,
+			recorded: [stated],
+			emitted: [value],
+		})),
+	)
+	for (const [index, [token, selector, condition, stated, value]] of pending.entries()) {
+		const resolution = resolutions[index]
+		const cells = [token, selector, condition ?? ABSENT_CELL, stated, value]
+		if (resolution === undefined) lines.push([...cells, 'undecided'].join(' | '))
+		else if (resolution.recorded !== resolution.emitted)
+			lines.push([...cells, resolution.recorded, resolution.emitted].join(' | '))
+	}
+	return lines
+}
