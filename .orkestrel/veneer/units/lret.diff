+/**
+ * Scans the departure ledger for each `bootstrap`-sourced token no row witnesses.
+ *
+ * @param departures - The classified departures.
+ * @param references - The reference map's rows, as the `collectReferenceRows` helper reads them.
+ * @returns Each token whose reference row's `Source` cell names `bootstrap` and that no departure
+ *   row witnesses, once each, in reference order.
+ *
+ * @remarks
+ * A witness is a row whose emitted value reads the token, as the {@link collectValueNames} helper
+ * reads names, and whose member is neither `retuned` nor `dropped`, so the value reading the token
+ * resolves to the release's own at a site the release writes. A `bootstrap` cell states that the
+ * token keeps the release's value, and a witness is the ledger's measurement of that statement: a
+ * token retuned away from the release leaves every row reading it `retuned`, and this scan names
+ * it, even where a row reads it beside a token the release never writes.
+ */
+export function scanWitnesses(
+	departures: readonly DepartureRow[],
+	references: readonly ReferenceRow[],
+): readonly string[] {
+	const witnessed = new Set(
+		departures
+			.filter((row) => row.departure !== 'retuned' && row.departure !== 'dropped')
+			.flatMap((row) => collectValueNames(row.emitted ?? '')),
+	)
+	return [
+		...new Set(references.filter((row) => row.source === 'bootstrap').map((row) => row.token)),
+	].filter((token) => !witnessed.has(token))
+}
