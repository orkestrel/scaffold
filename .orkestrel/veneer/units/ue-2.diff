+import type { SectionInterface } from '@app/browser'
+import { OPACITY_COPY, OPACITY_SPECIMENS, OpacitySection, SpecimenSection } from '@app/browser'
+import { requireValue } from '@orkestrel/test'
+import { build, mount, readStyle } from '@orkestrel/test/browser'
+import { beforeAll, describe, expect, it } from 'vitest'
+
+// The ramp case reads each bar's opacity as the published cascade resolves it, so the cascade has to
+// be in the document before a style is read.
+beforeAll(async () => {
+	await import('../../../../src/styles/index.scss')
+	await import('../../../../app/browser/styles/index.scss')
+})
+
+describe('OpacitySection', () => {
+	it('renders the declared opacity ramp beside visible class names through the shared section contract', () => {
+		const host = mount(build('div'))
+		const section: SectionInterface = new OpacitySection(host)
+		try {
+			expect(section).toBeInstanceOf(SpecimenSection)
+			expect(section.host).toBe(host)
+			const region = requireValue(host.querySelector('section'), 'No Opacity region')
+			expect(region.getAttribute('aria-label')).toBe('Opacity')
+			expect(region.querySelector('p')?.textContent).toBe(OPACITY_COPY.paragraph)
+			const rendered = [...region.querySelectorAll('[data-specimen]')]
+			expect(rendered.map((element) => element.getAttribute('data-specimen'))).toEqual([
+				'Opacity steps',
+			])
+			expect(rendered.map((element) => element.innerHTML)).toEqual(
+				OPACITY_SPECIMENS.map((specimen) => specimen.markup),
+			)
+			// Each bar is a placeholder hidden from assistive technology, faded by the one opacity step
+			// it carries, with that step's class name beside it as visible text that no step fades.
+			const bars = [...region.querySelectorAll('.placeholder')]
+			expect(bars).not.toEqual([])
+			expect(bars.map((bar) => bar.getAttribute('aria-hidden'))).toEqual(bars.map(() => 'true'))
+			const steps = bars.map((bar) =>
+				requireValue(
+					[...bar.classList].find((token) => /^opacity-\d+$/u.test(token)),
+					'A bar carries no opacity step',
+				),
+			)
+			expect(bars.map((bar) => Number(readStyle(bar, 'opacity')))).toEqual(
+				steps.map((step) => Number(step.slice('opacity-'.length)) / 100),
+			)
+			const labels = bars.map((bar) =>
+				requireValue(bar.closest('.row')?.firstElementChild, 'No bar label'),
+			)
+			expect(labels.map((label) => label.textContent)).toEqual(steps)
+			expect(labels.map((label) => readStyle(label, 'opacity'))).toEqual(labels.map(() => '1'))
+			// The ramp runs from a bar that paints nothing to a bar at full strength.
+			expect([steps.at(0), steps.at(-1)]).toEqual(['opacity-0', 'opacity-100'])
+			for (const bar of bars) expect(bar.getBoundingClientRect().width).toBeGreaterThan(0)
+			expect(region.querySelector('[style]')).toBeNull()
+			expect(Object.isFrozen(OPACITY_COPY)).toBe(true)
+			expect(Object.isFrozen(OPACITY_SPECIMENS)).toBe(true)
+			expect(OPACITY_SPECIMENS.every((specimen) => Object.isFrozen(specimen))).toBe(true)
+		} finally {
+			section.destroy()
+			host.remove()
+		}
+	})
+
+	it('releases its region and preserves neighboring content through repeated destruction', () => {
+		const host = mount(build('div'))
+		const neighbor = build('p', { text: 'Existing content' })
+		host.append(neighbor)
+		const section: SectionInterface = new OpacitySection(host)
+		try {
+			const region = requireValue(host.querySelector('section'), 'No Opacity region')
+			expect(region.isConnected).toBe(true)
+			section.destroy()
+			expect(region.isConnected).toBe(false)
+			section.destroy()
+			expect([...host.children]).toEqual([neighbor])
+		} finally {
+			section.destroy()
+			host.remove()
+		}
+	})
+})
