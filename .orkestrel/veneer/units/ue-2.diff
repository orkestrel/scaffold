diff --git a/src/styles/components/_focus-ring.scss b/src/styles/components/_focus-ring.scss
new file mode 100644
index 0000000..1a5fd63
--- /dev/null
+++ b/src/styles/components/_focus-ring.scss
@@ -0,0 +1,26 @@
+@use 'sass:map';
+@use '../mixins' as *;
+@use '../tokens';
+
+@layer components {
+	// The release writes the helper with normal declarations, so a rule of the consumer's own
+	// overrides it. It reads the ring's offsets and blur through fallbacks, because the release
+	// declares no `--bs-focus-ring-x`, `--bs-focus-ring-y`, or `--bs-focus-ring-blur` property.
+	// Forced colors paint no shadow, so the focused element takes the system-highlight outline there.
+	.focus-ring:focus {
+		outline: 0;
+		box-shadow: var(--bs-focus-ring-x, 0) var(--bs-focus-ring-y, 0) var(--bs-focus-ring-blur, 0)
+			var(--bs-focus-ring-width) var(--bs-focus-ring-color);
+		@include forced-ring;
+	}
+
+	// The release's `focus-ring` map entry is a `css-var` utility over the theme colors that carry a
+	// Bootstrap alias, which the `$aliased` list names: the `tertiary` role carries no
+	// `--bs-tertiary-rgb` alias. Each class sets the ring color the helper reads, with a normal
+	// declaration, so it sits beside the helper.
+	$colors: ();
+	@each $role in tokens.$aliased {
+		$colors: map.set($colors, $role, rgba(var(--bs-#{$role}-rgb), var(--bs-focus-ring-opacity)));
+	}
+	@include utility-variable(focus-ring, focus-ring-color, $colors);
+}
diff --git a/src/styles/utilities/_opacity.scss b/src/styles/utilities/_opacity.scss
new file mode 100644
index 0000000..2704d68
--- /dev/null
+++ b/src/styles/utilities/_opacity.scss
@@ -0,0 +1,21 @@
+@use '../mixins' as *;
+
+@layer utilities {
+	// The release's `opacity` entry is not responsive, so the walk writes it at the empty infix alone,
+	// ahead of every media block. Each step stays a literal, because no published Veneer token carries
+	// an opacity scale.
+	@include breakpoint-each using ($infix, $_boundary) {
+		@include utility(
+			opacity,
+			opacity,
+			(
+				0: 0,
+				25: 0.25,
+				50: 0.5,
+				75: 0.75,
+				100: 1,
+			),
+			$infix
+		);
+	}
+}
diff --git a/src/styles/utilities/_shadow.scss b/src/styles/utilities/_shadow.scss
new file mode 100644
index 0000000..f16942b
--- /dev/null
+++ b/src/styles/utilities/_shadow.scss
@@ -0,0 +1,21 @@
+@use '../mixins' as *;
+
+@layer utilities {
+	// The release's `shadow` entry is not responsive, so the walk writes it at the empty infix alone,
+	// ahead of every media block. Each value but the `none` value reads the release's own
+	// `--bs-box-shadow*` alias, which the tokens declare on the root element over Veneer's elevation
+	// ladder, so the elevation factor set on the root element scales each shadow that reads an alias.
+	@include breakpoint-each using ($infix, $_boundary) {
+		@include utility(
+			shadow,
+			box-shadow,
+			(
+				null: var(--bs-box-shadow),
+				sm: var(--bs-box-shadow-sm),
+				lg: var(--bs-box-shadow-lg),
+				none: none,
+			),
+			$infix
+		);
+	}
+}
diff --git a/tests/app/browser/sections/FocusRingSection.test.ts b/tests/app/browser/sections/FocusRingSection.test.ts
new file mode 100644
index 0000000..44168d4
--- /dev/null
+++ b/tests/app/browser/sections/FocusRingSection.test.ts
@@ -0,0 +1,122 @@
+import type { SectionInterface } from '@app/browser'
+import {
+	FOCUS_RING_COPY,
+	FOCUS_RING_SPECIMENS,
+	FocusRingSection,
+	SpecimenSection,
+} from '@app/browser'
+import { requireValue } from '@orkestrel/test'
+import {
+	build,
+	mount,
+	readName,
+	readRing,
+	readStyle,
+	traverseAccessible,
+} from '@orkestrel/test/browser'
+import { afterEach, beforeAll, describe, expect, it } from 'vitest'
+import { mountTraversalStart, scene } from '../../../setupBrowser.js'
+
+// The traversal case reads each ring as the published cascade paints it, so the cascade has to be in
+// the document before a ring is measured.
+beforeAll(async () => {
+	await import('../../../../src/styles/index.scss')
+	await import('../../../../app/browser/styles/index.scss')
+})
+
+afterEach(() => {
+	scene.clear()
+})
+
+describe('FocusRingSection', () => {
+	it('renders every declared ring specimen through the shared section contract', () => {
+		const host = mount(build('div'))
+		const section: SectionInterface = new FocusRingSection(host)
+		try {
+			expect(section).toBeInstanceOf(SpecimenSection)
+			expect(section.host).toBe(host)
+			const region = requireValue(host.querySelector('section'), 'No Focus ring region')
+			expect(region.getAttribute('aria-label')).toBe('Focus ring')
+			expect(region.querySelector('p')?.textContent).toBe(FOCUS_RING_COPY.paragraph)
+			const rendered = [...region.querySelectorAll('[data-specimen]')]
+			expect(rendered.map((element) => element.getAttribute('data-specimen'))).toEqual([
+				'Default focus ring',
+				'Focus ring roles',
+			])
+			expect(rendered.map((element) => element.innerHTML)).toEqual(
+				FOCUS_RING_SPECIMENS.map((specimen) => specimen.markup),
+			)
+			// Each link is labeled with the full name of the ring class it carries: its role class where
+			// it carries one, and the helper's own class otherwise.
+			const links = [...region.querySelectorAll<HTMLAnchorElement>('a.focus-ring')]
+			expect(links.length).toBeGreaterThan(1)
+			expect(links.map((link) => readName(link))).toEqual(
+				links.map(
+					(link) =>
+						[...link.classList].find((token) => token.startsWith('focus-ring-')) ?? 'focus-ring',
+				),
+			)
+			expect(
+				links.filter((link) => [...link.classList].some((token) => token.startsWith('focus-ring-')))
+					.length,
+			).toBe(links.length - 1)
+			// No ring paints at rest, because the helper paints only under focus.
+			expect(links.map((link) => readStyle(link, 'box-shadow'))).toEqual(links.map(() => 'none'))
+			expect(region.querySelector('[style]')).toBeNull()
+			expect(Object.isFrozen(FOCUS_RING_COPY)).toBe(true)
+			expect(Object.isFrozen(FOCUS_RING_SPECIMENS)).toBe(true)
+			expect(FOCUS_RING_SPECIMENS.every((specimen) => Object.isFrozen(specimen))).toBe(true)
+		} finally {
+			section.destroy()
+			host.remove()
+		}
+	})
+
+	it('paints a ring on each link the keyboard reaches, in its own color, and clears it after', async () => {
+		// The traversal starts on a focused control of the case's own ahead of the region, so the
+		// first Tab the keyboard sends lands on the region's first link.
+		mountTraversalStart()
+		const host = mount(build('div'))
+		const section: SectionInterface = new FocusRingSection(host)
+		try {
+			const links = [...host.querySelectorAll<HTMLAnchorElement>('a.focus-ring')]
+			const shadows: string[] = []
+			for (const link of links) {
+				const reached = await traverseAccessible(readName(link))
+				expect(reached).toBe(link)
+				expect(link.matches(':focus-visible')).toBe(true)
+				// The installed reader measures the painted ring against the surface behind it, so a
+				// link whose ring painted nothing reports no ratio here.
+				expect(readRing(link) ?? 0).toBeGreaterThan(1)
+				shadows.push(readStyle(link, 'box-shadow'))
+			}
+			// The default ring and every role ring are distinct paints, the default and the primary
+			// ring included, whose colors mix the same primary fill in different ways.
+			expect(new Set(shadows).size).toBe(links.length)
+			const last = requireValue(links.at(-1), 'No last link')
+			last.blur()
+			expect(readStyle(last, 'box-shadow')).toBe('none')
+		} finally {
+			section.destroy()
+			host.remove()
+		}
+	})
+
+	it('releases its region and preserves neighboring content through repeated destruction', () => {
+		const host = mount(build('div'))
+		const neighbor = build('p', { text: 'Existing content' })
+		host.append(neighbor)
+		const section: SectionInterface = new FocusRingSection(host)
+		try {
+			const region = requireValue(host.querySelector('section'), 'No Focus ring region')
+			expect(region.isConnected).toBe(true)
+			section.destroy()
+			expect(region.isConnected).toBe(false)
+			section.destroy()
+			expect([...host.children]).toEqual([neighbor])
+		} finally {
+			section.destroy()
+			host.remove()
+		}
+	})
+})
