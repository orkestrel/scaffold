@@ -0,0 +1,235 @@
+import { requireValue } from '@orkestrel/test'
+import {
+	findRule,
+	matchesColor,
+	pressKeys,
+	readPixels,
+	readRing,
+	readRootToken,
+	readStyle,
+	readToken,
+	releaseMedia,
+	stageMedia,
+} from '@orkestrel/test/browser'
+import { afterEach, describe, expect, it } from 'vitest'
+import { collectLayerRules, scene } from '../../../setupBrowser.js'
+import { extractShadowLayers, FOCUS_RING_ROLES } from '../../../setupStyles.js'
+
+// One link per role class beside a link carrying the helper alone, then a gauge whose width is the
+// focus width the ring spreads by.
+const RINGS = [
+	'<a class="focus-ring" href="#main">Default ring</a>',
+	...FOCUS_RING_ROLES.map(
+		(role) => `<a class="focus-ring focus-ring-${role}" href="#main">${role} ring</a>`,
+	),
+	'<div class="gauge" style="width: var(--bs-focus-ring-width)"></div>',
+].join(' ')
+
+afterEach(async () => {
+	await releaseMedia()
+	scene.clear()
+})
+
+describe('focus ring helper', () => {
+	it('paints nothing at rest and the default ring under keyboard focus, with the native outline cleared', async () => {
+		const host = scene.mount(RINGS)
+		const link = requireValue(host.querySelector<HTMLElement>('a.focus-ring'), 'No default link')
+		const gauge = requireValue(host.querySelector('.gauge'), 'No focus gauge')
+		expect(readStyle(link, 'box-shadow')).toBe('none')
+		expect(readRing(link)).toBeUndefined()
+		link.focus()
+		await pressKeys('{ArrowRight}')
+		expect(link.matches(':focus-visible')).toBe(true)
+		expect(readStyle(link, 'outline-style')).toBe('none')
+		// The ring spreads by the focus width at no offset and no blur, and paints the default ring
+		// color the theme binds, read as the painted layer rather than as the declared text.
+		const layers = extractShadowLayers(readStyle(link, 'box-shadow'))
+		expect(layers.map((layer) => layer.lengths)).toEqual([[0, 0, 0, readPixels(gauge, 'width')]])
+		expect(
+			matchesColor(
+				requireValue(layers[0], 'No ring layer').color,
+				readRootToken('--bs-focus-ring-color'),
+			),
+		).toBe(true)
+		// The installed reader composes the painted ring against the surface behind it, so a ring the
+		// cascade declared and painted at zero alpha would report nothing here.
+		expect(readRing(link) ?? 0).toBeGreaterThan(1)
+		link.blur()
+		expect(readStyle(link, 'box-shadow')).toBe('none')
+	})
+
+	it('offsets and blurs the ring through the variables the release reads with fallbacks', async () => {
+		const host = scene.mount(RINGS)
+		const link = requireValue(host.querySelector<HTMLElement>('a.focus-ring'), 'No default link')
+		scene.load(
+			'.offset { --bs-focus-ring-x: 2px; --bs-focus-ring-y: 3px; --bs-focus-ring-blur: 4px; --bs-focus-ring-width: 5px }',
+		)
+		link.classList.add('offset')
+		link.focus()
+		await pressKeys('{ArrowRight}')
+		expect(link.matches(':focus-visible')).toBe(true)
+		expect(
+			extractShadowLayers(readStyle(link, 'box-shadow')).map((layer) => layer.lengths),
+		).toEqual([[2, 3, 4, 5]])
+	})
+
+	it('paints each role class ring from its own channel alias at the ring opacity', async () => {
+		const host = scene.mount(RINGS)
+		// The alpha is retuned on the links alone, so a role class reading the alias on its own element
+		// takes the retune, and a ring left to the default color the root resolves does not. That is
+		// what separates the primary class from the default ring, whose color is a mix of the same
+		// primary fill at the same alpha.
+		scene.load('.focus-ring { --bs-focus-ring-opacity: 0.8 }')
+		const rings = new Map<string, number | undefined>()
+		for (const role of FOCUS_RING_ROLES) {
+			const link = requireValue(
+				host.querySelector<HTMLElement>(`.focus-ring-${role}`),
+				`No ${role} link`,
+			)
+			link.focus()
+			await pressKeys('{ArrowRight}')
+			expect(link.matches(':focus-visible')).toBe(true)
+			const [layer] = extractShadowLayers(readStyle(link, 'box-shadow'))
+			const channels = readRootToken(`--bs-${role}-rgb`)
+			expect({
+				role,
+				painted: matchesColor(
+					requireValue(layer, `No ${role} ring`).color,
+					`rgba(${channels}, 0.8)`,
+				),
+			}).toEqual({ role, painted: true })
+			rings.set(role, readRing(link))
+			link.blur()
+		}
+		// Each role's ring is painted, so the installed reader measures every one of them.
+		expect([...rings.values()].filter((ratio) => (ratio ?? 0) <= 1)).toEqual([])
+		const fallback = requireValue(
+			host.querySelector<HTMLElement>('a.focus-ring:not([class*="focus-ring-"])'),
+			'No default link',
+		)
+		fallback.focus()
+		await pressKeys('{ArrowRight}')
+		const [layer] = extractShadowLayers(readStyle(fallback, 'box-shadow'))
+		expect(
+			matchesColor(
+				requireValue(layer, 'No default ring').color,
+				readRootToken('--bs-focus-ring-color'),
+			),
+		).toBe(true)
+	})
+
+	it('reads each mode through its aliases, so a dark island repaints the default and the primary rings', async () => {
+		const light = scene.mount(RINGS)
+		const dark = scene.mount(`<div data-bs-theme="dark">${RINGS}</div>`)
+		const readings: string[] = []
+		for (const host of [light, dark])
+			for (const selector of ['a.focus-ring:not([class*="focus-ring-"])', '.focus-ring-primary']) {
+				const link = requireValue(host.querySelector<HTMLElement>(selector), `No ${selector}`)
+				link.focus()
+				await pressKeys('{ArrowRight}')
+				expect(link.matches(':focus-visible')).toBe(true)
+				readings.push(readStyle(link, 'box-shadow'))
+				link.blur()
+			}
+		const [lightDefault, lightPrimary, darkDefault, darkPrimary] = readings
+		expect(darkDefault).not.toBe(lightDefault)
+		expect(darkPrimary).not.toBe(lightPrimary)
+		// The dark island re-declares the primary channels, and the role class reads them on its own
+		// element inside the island.
+		const island = requireValue(dark.firstElementChild, 'No dark island')
+		const channels = readToken(island, '--bs-primary-rgb')
+		const [layer] = extractShadowLayers(darkPrimary ?? '')
+		expect(
+			matchesColor(
+				requireValue(layer, 'No dark primary ring').color,
+				`rgba(${channels}, ${readRootToken('--bs-focus-ring-opacity')})`,
+			),
+		).toBe(true)
+	})
+
+	it('writes the role classes in the release order, so a later role wins on one element', async () => {
+		const host = scene.mount(
+			'<a class="focus-ring focus-ring-danger focus-ring-primary" href="#main">Paired ring</a>',
+		)
+		const link = requireValue(host.querySelector<HTMLElement>('a'), 'No paired link')
+		link.focus()
+		await pressKeys('{ArrowRight}')
+		const [layer] = extractShadowLayers(readStyle(link, 'box-shadow'))
+		expect(
+			matchesColor(
+				requireValue(layer, 'No paired ring').color,
+				`rgba(${readRootToken('--bs-danger-rgb')}, ${readRootToken('--bs-focus-ring-opacity')})`,
+			),
+		).toBe(true)
+		expect(findRule('.focus-ring-md-primary')).toBeUndefined()
+	})
+
+	it('outlines the focused element at the focus width under forced colors, where its shadow ring is not painted', async () => {
+		const host = scene.mount(
+			`${RINGS}<div class="focus-gauge" style="width: var(--vn-focus-width)"></div>`,
+		)
+		const link = requireValue(host.querySelector<HTMLElement>('a.focus-ring'), 'No default link')
+		const gauge = requireValue(host.querySelector('.focus-gauge'), 'No focus gauge')
+		link.focus()
+		expect(link.matches(':focus')).toBe(true)
+		expect(readStyle(link, 'outline-style')).toBe('none')
+		// A color reading cannot fail under forced colors, because the installed color reader
+		// resolves each side through a probe whose color forced colors also replace, so the outline
+		// is read by its style and its width rather than by its paint.
+		await stageMedia({ forced: true })
+		expect(readStyle(link, 'outline-style')).toBe('solid')
+		expect(readPixels(link, 'outline-width')).toBe(readPixels(gauge, 'width'))
+		await releaseMedia()
+		expect(readStyle(link, 'outline-style')).toBe('none')
+	})
+
+	it('sits in the components layer with normal declarations, so a consumer rule and an important utility each win over it', async () => {
+		const components = collectLayerRules('components').flatMap((rule) =>
+			rule instanceof CSSStyleRule ? [rule.selectorText] : [],
+		)
+		expect(components).toEqual(
+			expect.arrayContaining([
+				'.focus-ring:focus',
+				...FOCUS_RING_ROLES.map((role) => `.focus-ring-${role}`),
+			]),
+		)
+		expect(
+			collectLayerRules('utilities').flatMap((rule) =>
+				rule instanceof CSSStyleRule && rule.selectorText.startsWith('.focus-ring')
+					? [rule.selectorText]
+					: [],
+			),
+		).toEqual([])
+		const host = scene.mount(
+			[
+				'<a class="focus-ring consumer" href="#main">Consumer ring</a>',
+				'<a class="focus-ring focus-ring-danger consumer-color" href="#main">Consumer color</a>',
+				'<a class="focus-ring shadow-none" href="#main">Cleared ring</a>',
+				'<a class="focus-ring escaped" href="#main">Escaped ring</a>',
+			].join(' '),
+		)
+		// A normal declaration outside every layer beats a normal one inside any layer, so the
+		// consumer's own rule wins where the helper's declarations and the role's variable are normal.
+		scene.load(
+			'.consumer:focus { box-shadow: 0 0 0 1px rgb(1, 2, 3) } .consumer-color { --bs-focus-ring-color: rgb(4, 5, 6) }',
+		)
+		scene.load('@layer utilities { .escaped:focus { box-shadow: 0 0 0 2px rgb(7, 8, 9) } }')
+		const readings: string[] = []
+		for (const link of host.querySelectorAll<HTMLElement>('a')) {
+			link.focus()
+			await pressKeys('{ArrowRight}')
+			expect(link.matches(':focus-visible')).toBe(true)
+			readings.push(readStyle(link, 'box-shadow'))
+			link.blur()
+		}
+		const [consumer, color, cleared, escaped] = readings
+		expect(consumer).toBe('rgb(1, 2, 3) 0px 0px 0px 1px')
+		expect(requireValue(extractShadowLayers(color ?? '')[0], 'No consumer color ring').color).toBe(
+			'rgb(4, 5, 6)',
+		)
+		// The important shadow utility beats the helper's normal declaration whatever layer each sits
+		// in, as it does in the release.
+		expect(cleared).toBe('none')
+		expect(escaped).toBe('rgb(7, 8, 9) 0px 0px 0px 2px')
+	})
+})
diff --git a/tests/src/styles/utilities/opacity.test.ts b/tests/src/styles/utilities/opacity.test.ts
new file mode 100644
index 0000000..3bead93
--- /dev/null
+++ b/tests/src/styles/utilities/opacity.test.ts
@@ -0,0 +1,97 @@
+import { TOKEN_NAMES } from '@src/core'
+import { requireValue } from '@orkestrel/test'
+import { findRule, readStyle } from '@orkestrel/test/browser'
+import { afterEach, describe, expect, it } from 'vitest'
+import { collectLayerRules, scene, visitBreakpoint } from '../../../setupBrowser.js'
+import { GRID_BREAKPOINT_CASES, OPACITY_STEPS } from '../../../setupStyles.js'
+
+// Every element rests on an inline opacity no step writes, so a reading of any step can only come
+// from the class, and the inline declaration is normal, so it yields to the utility's importance.
+const RESTING_OPACITY = '0.1'
+
+afterEach(() => {
+	document.documentElement.style.removeProperty(TOKEN_NAMES.factor.density)
+	scene.clear()
+})
+
+describe('opacity utilities', () => {
+	it.each(GRID_BREAKPOINT_CASES)(
+		'resolves every step at the empty infix around the $name boundary, and writes no infixed step there',
+		async ({ name, boundary, readings }) => {
+			// The release's entry is not responsive, so an infixed class exists at no boundary, and an
+			// element carrying one keeps its resting opacity on both sides of the boundary.
+			const infixed =
+				boundary === 0 ? [] : OPACITY_STEPS.map(({ step }) => `opacity-${name}-${step}`)
+			const host = scene.mount(
+				[...OPACITY_STEPS.map(({ step }) => `opacity-${step}`), ...infixed]
+					.map((token) => `<div class="${token}" style="opacity: ${RESTING_OPACITY}"></div>`)
+					.join(''),
+			)
+			for (const viewport of readings) {
+				await visitBreakpoint(viewport, () => {
+					expect(window.innerWidth).toBe(viewport)
+					for (const { step, value } of OPACITY_STEPS) {
+						const element = requireValue(
+							host.querySelector(`.opacity-${step}`),
+							`No opacity-${step} element`,
+						)
+						expect(readStyle(element, 'opacity')).toBe(value)
+					}
+					for (const token of infixed) {
+						const element = requireValue(host.querySelector(`.${token}`), `No ${token} element`)
+						expect(readStyle(element, 'opacity')).toBe(RESTING_OPACITY)
+					}
+				})
+			}
+			for (const token of infixed) expect(findRule(`.${token}`)).toBeUndefined()
+		},
+	)
+
+	it('writes the steps in the release order, so a later step wins on one element', () => {
+		const host = scene.mount(
+			'<div class="opacity-100 opacity-0"></div><div class="opacity-25 opacity-75"></div>',
+		)
+		const [whole, partial] = [...host.children]
+		// Class order in the attribute is irrelevant; the rule the cascade writes later wins.
+		expect(readStyle(requireValue(whole, 'No whole element'), 'opacity')).toBe('1')
+		expect(readStyle(requireValue(partial, 'No partial element'), 'opacity')).toBe('0.75')
+	})
+
+	it('reads no token or mode, so a dark island and a doubled density factor leave every step', () => {
+		const host = scene.mount(
+			`<div data-bs-theme="dark">${OPACITY_STEPS.map(({ step }) => `<div class="opacity-${step}"></div>`).join('')}</div>`,
+		)
+		for (const density of ['1', '2']) {
+			document.documentElement.style.setProperty(TOKEN_NAMES.factor.density, density)
+			expect(
+				OPACITY_STEPS.map(({ step }) =>
+					readStyle(requireValue(host.querySelector(`.opacity-${step}`), 'No step'), 'opacity'),
+				),
+			).toEqual(OPACITY_STEPS.map(({ value }) => value))
+		}
+	})
+
+	it('sits in the utilities layer and keeps its priority over a later unlayered consumer rule', () => {
+		const utilities = collectLayerRules('utilities').flatMap((rule) =>
+			rule instanceof CSSStyleRule ? [rule.selectorText] : [],
+		)
+		expect(utilities).toEqual(
+			expect.arrayContaining(OPACITY_STEPS.map(({ step }) => `.opacity-${step}`)),
+		)
+		const host = scene.mount('<div class="probe opacity-50"></div><div class="probe"></div>')
+		scene.load('.probe { opacity: 0.3 }')
+		const utility = requireValue(host.querySelector('.opacity-50'), 'No utility element')
+		const consumer = requireValue(host.lastElementChild, 'No consumer element')
+		expect(readStyle(consumer, 'opacity')).toBe('0.3')
+		expect(readStyle(utility, 'opacity')).toBe('0.5')
+	})
+
+	it('yields to an important override inside the utilities layer and to no unlayered one', () => {
+		const host = scene.mount('<div class="opacity-50"></div>')
+		const element = requireValue(host.querySelector('.opacity-50'), 'No utility element')
+		scene.load('.opacity-50 { opacity: 0.3 !important }')
+		expect(readStyle(element, 'opacity')).toBe('0.5')
+		scene.load('@layer utilities { .opacity-50 { opacity: 0.2 !important } }')
+		expect(readStyle(element, 'opacity')).toBe('0.2')
+	})
+})
diff --git a/tests/src/styles/utilities/shadow.test.ts b/tests/src/styles/utilities/shadow.test.ts
new file mode 100644
index 0000000..b928176
--- /dev/null
+++ b/tests/src/styles/utilities/shadow.test.ts
@@ -0,0 +1,185 @@
+import { TOKEN_NAMES } from '@src/core'
+import { requireValue } from '@orkestrel/test'
+import { findRule, readStyle } from '@orkestrel/test/browser'
+import { afterEach, describe, expect, it } from 'vitest'
+import { collectLayerRules, scene, visitBreakpoint } from '../../../setupBrowser.js'
+import { extractShadowLayers, GRID_BREAKPOINT_CASES, SHADOW_CASES } from '../../../setupStyles.js'
+
+// Every subject rests on an inline shadow no step writes, so a reading of any step can only come
+// from the class, and the inline declaration is normal, so it yields to the utility's importance.
+const RESTING_SHADOW = 'rgb(1, 2, 3) 0px 0px 0px 9px'
+
+afterEach(() => {
+	document.documentElement.style.removeProperty(TOKEN_NAMES.factor.elevation)
+	document.documentElement.style.removeProperty(TOKEN_NAMES.factor.density)
+	for (const { token } of SHADOW_CASES)
+		if (token !== undefined) document.documentElement.style.removeProperty(token)
+	scene.clear()
+})
+
+// One subject per shadow class, each resting on the inline shadow, beside a reference box per
+// elevation token that paints the token's own resolved shadow through a normal inline declaration.
+const SHADOWS = SHADOW_CASES.map(
+	({ name, token }) =>
+		`<div class="${name}" style="box-shadow: ${RESTING_SHADOW}"></div>${
+			token === undefined
+				? ''
+				: `<div data-token="${token}" style="box-shadow: var(${token})"></div>`
+		}`,
+).join('')
+
+describe('shadow utilities', () => {
+	it.each(GRID_BREAKPOINT_CASES)(
+		'resolves each class to the elevation step its alias reads around the $name boundary, and writes no infixed class there',
+		async ({ name, boundary, readings }) => {
+			// The release's entry is not responsive, so an infixed class exists at no boundary, and an
+			// element carrying one keeps its resting shadow on both sides of the boundary. The bare
+			// class at the sm and lg infixes spells a shipped class, so those names are read as the
+			// shipped classes they are rather than as infixed ones.
+			const infixed =
+				boundary === 0
+					? []
+					: SHADOW_CASES.map(({ name: step }) => step.replace('shadow', `shadow-${name}`)).filter(
+							(token) => !SHADOW_CASES.some(({ name: step }) => step === token),
+						)
+			const host = scene.mount(
+				`${SHADOWS}${infixed.map((token) => `<div class="${token}" style="box-shadow: ${RESTING_SHADOW}"></div>`).join('')}`,
+			)
+			for (const viewport of readings) {
+				await visitBreakpoint(viewport, () => {
+					expect(window.innerWidth).toBe(viewport)
+					for (const { name: step, token } of SHADOW_CASES) {
+						const element = requireValue(host.querySelector(`.${step}`), `No ${step} element`)
+						// The reference paints the token itself, so a class written with the release's own
+						// literal shadow, or reading a neighboring step's alias, reads apart from it.
+						const expected =
+							token === undefined
+								? 'none'
+								: readStyle(
+										requireValue(host.querySelector(`[data-token="${token}"]`), `No ${token} box`),
+										'box-shadow',
+									)
+						expect(readStyle(element, 'box-shadow')).toBe(expected)
+					}
+					for (const token of infixed) {
+						const element = requireValue(host.querySelector(`.${token}`), `No ${token} element`)
+						expect(readStyle(element, 'box-shadow')).toBe(RESTING_SHADOW)
+					}
+				})
+			}
+			for (const token of infixed) expect(findRule(`.${token}`)).toBeUndefined()
+			// Every value is a distinct paint, so the preceding reference reading cannot pass by every
+			// class resolving one shared shadow.
+			expect(
+				new Set(
+					SHADOW_CASES.map(({ name: step }) =>
+						readStyle(requireValue(host.querySelector(`.${step}`), `No ${step}`), 'box-shadow'),
+					),
+				).size,
+			).toBe(SHADOW_CASES.length)
+		},
+	)
+
+	it('scales every shadow step with the elevation factor', () => {
+		const host = scene.mount(SHADOWS)
+		const scaled = SHADOW_CASES.filter(({ token }) => token !== undefined)
+		// Each factor's reading is every scaled class's shadow layers as lengths, first at the resting
+		// factor and then at a doubled one.
+		const readings: Array<ReadonlyArray<ReadonlyArray<readonly number[]>>> = []
+		for (const factor of ['1', '2']) {
+			document.documentElement.style.setProperty(TOKEN_NAMES.factor.elevation, factor)
+			readings.push(
+				scaled.map(({ name }) =>
+					extractShadowLayers(
+						readStyle(requireValue(host.querySelector(`.${name}`), `No ${name}`), 'box-shadow'),
+					).map((layer) => layer.lengths),
+				),
+			)
+		}
+		const [resting, doubled] = readings
+		// Every step carries at least one nonzero length, so doubling the factor has something to move.
+		expect((resting ?? []).flat(2).some((length) => length !== 0)).toBe(true)
+		expect(doubled).toEqual(
+			(resting ?? []).map((layers) => layers.map((lengths) => lengths.map((length) => length * 2))),
+		)
+		const none = requireValue(host.querySelector('.shadow-none'), 'No shadow-none element')
+		expect(readStyle(none, 'box-shadow')).toBe('none')
+	})
+
+	it('moves each class with a retuned elevation step and with the alias a consumer sets on it', () => {
+		const host = scene.mount(SHADOWS)
+		for (const { name, token } of SHADOW_CASES) {
+			if (token === undefined) continue
+			const element = requireValue(host.querySelector(`.${name}`), `No ${name} element`)
+			document.documentElement.style.setProperty(token, '0 0 0 7px rgb(4, 5, 6)')
+			expect(readStyle(element, 'box-shadow')).toBe('rgb(4, 5, 6) 0px 0px 0px 7px')
+			document.documentElement.style.removeProperty(token)
+		}
+		// The release's alias is the value's own text, so a rule of the consumer's that sets it on the
+		// element repaints the class without reaching the elevation ladder.
+		scene.load('.retuned { --bs-box-shadow-lg: 0 0 0 5px rgb(7, 8, 9) }')
+		const element = requireValue(host.querySelector('.shadow-lg'), 'No shadow-lg element')
+		element.classList.add('retuned')
+		expect(readStyle(element, 'box-shadow')).toBe('rgb(7, 8, 9) 0px 0px 0px 5px')
+	})
+
+	it('reads the same elevation inside a dark island, and ignores the density factor', () => {
+		const light = scene.mount(SHADOWS)
+		const dark = scene.mount(`<div data-bs-theme="dark">${SHADOWS}</div>`)
+		// Each reading is every class's shadow on the light page, in the dark island, and on the
+		// light page again under a doubled density factor.
+		const readings: Array<readonly string[]> = []
+		for (const [host, density] of [
+			[light, '1'],
+			[dark, '1'],
+			[light, '2'],
+		] as const) {
+			document.documentElement.style.setProperty(TOKEN_NAMES.factor.density, density)
+			readings.push(
+				SHADOW_CASES.map(({ name }) =>
+					readStyle(requireValue(host.querySelector(`.${name}`), `No ${name}`), 'box-shadow'),
+				),
+			)
+		}
+		// The elevation ladder is declared on the root alone and no mode retunes it, so a dark island
+		// inherits the same shadows the light page resolves, and no step reads the density factor.
+		const [resting, island, dense] = readings
+		expect(island).toEqual(resting)
+		expect(dense).toEqual(resting)
+	})
+
+	it('writes the values in the release order, so a later value wins on one element', () => {
+		const host = scene.mount(SHADOWS)
+		const large = readStyle(requireValue(host.querySelector('.shadow-lg'), 'No lg'), 'box-shadow')
+		const pair = scene.mount(
+			'<div class="shadow-lg shadow-sm"></div><div class="shadow-lg shadow-none"></div>',
+		)
+		const [ladder, cleared] = [...pair.children]
+		expect(readStyle(requireValue(ladder, 'No ladder element'), 'box-shadow')).toBe(large)
+		expect(readStyle(requireValue(cleared, 'No cleared element'), 'box-shadow')).toBe('none')
+	})
+
+	it('sits in the utilities layer and keeps its priority over a later unlayered consumer rule', () => {
+		const utilities = collectLayerRules('utilities').flatMap((rule) =>
+			rule instanceof CSSStyleRule ? [rule.selectorText] : [],
+		)
+		expect(utilities).toEqual(expect.arrayContaining(SHADOW_CASES.map(({ name }) => `.${name}`)))
+		const host = scene.mount('<div class="probe shadow-none"></div><div class="probe"></div>')
+		scene.load('.probe { box-shadow: 0 0 0 2px rgb(1, 2, 3) }')
+		const utility = requireValue(host.querySelector('.shadow-none'), 'No utility element')
+		const consumer = requireValue(host.lastElementChild, 'No consumer element')
+		expect(readStyle(consumer, 'box-shadow')).toBe('rgb(1, 2, 3) 0px 0px 0px 2px')
+		expect(readStyle(utility, 'box-shadow')).toBe('none')
+	})
+
+	it('yields to an important override inside the utilities layer and to no unlayered one', () => {
+		const host = scene.mount('<div class="shadow-none"></div>')
+		const element = requireValue(host.querySelector('.shadow-none'), 'No utility element')
+		scene.load('.shadow-none { box-shadow: 0 0 0 2px rgb(1, 2, 3) !important }')
+		expect(readStyle(element, 'box-shadow')).toBe('none')
+		scene.load(
+			'@layer utilities { .shadow-none { box-shadow: 0 0 0 3px rgb(4, 5, 6) !important } }',
+		)
+		expect(readStyle(element, 'box-shadow')).toBe('rgb(4, 5, 6) 0px 0px 0px 3px')
+	})
+})
