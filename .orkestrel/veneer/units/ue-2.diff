+import { FOCUS_RING_COPY, FOCUS_RING_SPECIMENS } from '../constants.js'
+import { SpecimenSection } from './SpecimenSection.js'
+
+/**
+ * Renders the declared focus ring and role ring specimens into a named Focus ring region.
+ *
+ * @example
+ * ```ts
+ * const section = new FocusRingSection(document.body)
+ * section.destroy()
+ * ```
+ */
+export class FocusRingSection extends SpecimenSection {
+	/**
+	 * Mounts the Focus ring region and its specimens in table order.
+	 * @param host - The element receiving the section.
+	 */
+	constructor(host: HTMLElement) {
+		super(host, FOCUS_RING_COPY, FOCUS_RING_SPECIMENS)
+	}
+}
