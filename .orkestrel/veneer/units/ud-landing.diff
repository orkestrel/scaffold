+import { TOKEN_NAMES } from '@src/core'
+import { requireValue } from '@orkestrel/test'
+import { readStyle } from '@orkestrel/test/browser'
+import { afterEach, describe, expect, it } from 'vitest'
+import { scene, visitBreakpoint } from '../../../setupBrowser.js'
+import {
+	FLEX_ENTRY_CASES,
+	FLEX_RESTING_VALUES,
+	GRID_BREAKPOINT_CASES,
+} from '../../../setupStyles.js'
+
+afterEach(() => {
+	scene.clear()
+})
+
+describe('flex utilities', () => {
+	it.each(GRID_BREAKPOINT_CASES)(
+		'resolves every flex value around the $name boundary',
+		async ({ name, boundary, readings }) => {
+			const infix = boundary === 0 ? '' : `-${name}`
+			const host = scene.mount(
+				FLEX_ENTRY_CASES.flatMap(({ prefix, property, values }) =>
+					values.map(({ key }, index) => {
+						const next = requireValue(values[(index + 1) % values.length], 'No next value')
+						const resting = FLEX_RESTING_VALUES[property]?.declared ?? next.value
+						return `<div class="${prefix}${infix}-${key}" style="${property}: ${resting}"></div>`
+					}),
+				).join(''),
+			)
+			for (const viewport of readings) {
+				await visitBreakpoint(viewport, () => {
+					expect(window.innerWidth).toBe(viewport)
+					for (const { prefix, property, values } of FLEX_ENTRY_CASES) {
+						values.forEach(({ key, value }, index) => {
+							const element = requireValue(
+								host.querySelector(`.${prefix}${infix}-${key}`),
+								`No ${prefix}${infix}-${key} element`,
+							)
+							const next = requireValue(values[(index + 1) % values.length], 'No next value')
+							const resting = FLEX_RESTING_VALUES[property]?.computed ?? next.value
+							expect(readStyle(element, property)).toBe(viewport >= boundary ? value : resting)
+						})
+					}
+				})
+			}
+		},
+	)
+
+	it.each(GRID_BREAKPOINT_CASES)(
+		'moves each constrained layout at and above the $name boundary',
+		async ({ name, boundary, readings }) => {
+			const infix = boundary === 0 ? '' : `-${name}`
+			// Every container is sized inline and every item is sized inline, so the only declaration
+			// the utility class meets is the one it moves. Each class writes a value other than the
+			// property's initial one, so each reading below the boundary is the initial layout.
+			const host = scene.mount(
+				[
+					`<div data-case="fill" style="display: flex; width: 300px"><div class="flex${infix}-fill" style="width: 60px; height: 20px"></div><div style="flex: none; width: 60px"></div></div>`,
+					`<div data-case="direction" class="flex${infix}-column" style="display: flex; width: 300px"><div style="width: 60px; height: 20px"></div><div style="width: 60px; height: 20px"></div></div>`,
+					`<div data-case="grow" style="display: flex; width: 300px"><div class="flex${infix}-grow-1" style="width: 60px; height: 20px"></div><div style="flex: none; width: 60px"></div></div>`,
+					`<div data-case="shrink" style="display: flex; width: 100px"><div class="flex${infix}-shrink-0" style="width: 80px; height: 20px"></div><div style="width: 80px; height: 20px"></div></div>`,
+					`<div data-case="wrap" class="flex${infix}-wrap" style="display: flex; width: 100px"><div style="flex: none; width: 60px; height: 20px"></div><div style="flex: none; width: 60px; height: 20px"></div></div>`,
+					`<div data-case="justify" class="justify-content${infix}-end" style="display: flex; width: 300px"><div style="width: 60px; height: 20px"></div><div style="width: 60px; height: 20px"></div></div>`,
+					`<div data-case="items" class="align-items${infix}-end" style="display: flex; width: 300px; height: 120px"><div style="width: 60px; height: 20px"></div></div>`,
+					`<div data-case="content" class="align-content${infix}-end" style="display: flex; flex-wrap: wrap; width: 100px; height: 120px"><div style="flex: none; width: 60px"></div><div style="flex: none; width: 60px"></div></div>`,
+					`<div data-case="self" style="display: flex; width: 300px; height: 120px"><div class="align-self${infix}-end" style="width: 60px; height: 20px"></div></div>`,
+					`<div data-case="order" style="display: flex; width: 300px"><div style="width: 60px; height: 20px"></div><div class="order${infix}-first" style="width: 60px; height: 20px"></div></div>`,
+				].join(''),
+			)
+			for (const viewport of readings) {
+				await visitBreakpoint(viewport, () => {
+					const applied = viewport >= boundary
+					const cases = new Map(
+						[...host.querySelectorAll('[data-case]')].map((container) => [
+							container.getAttribute('data-case'),
+							{
+								container: container.getBoundingClientRect(),
+								items: [...container.children].map((item) => item.getBoundingClientRect()),
+							},
+						]),
+					)
+					const fill = requireValue(cases.get('fill'), 'No fill reading')
+					const direction = requireValue(cases.get('direction'), 'No direction reading')
+					const grow = requireValue(cases.get('grow'), 'No grow reading')
+					const shrink = requireValue(cases.get('shrink'), 'No shrink reading')
+					const wrap = requireValue(cases.get('wrap'), 'No wrap reading')
+					const justify = requireValue(cases.get('justify'), 'No justify reading')
+					const items = requireValue(cases.get('items'), 'No items reading')
+					const content = requireValue(cases.get('content'), 'No content reading')
+					const self = requireValue(cases.get('self'), 'No self reading')
+					const order = requireValue(cases.get('order'), 'No order reading')
+					// `flex-fill` and `flex-grow-1` each take the 180px the fixed neighbor leaves.
+					expect(fill.items[0]?.width).toBe(applied ? 240 : 60)
+					expect(grow.items[0]?.width).toBe(applied ? 240 : 60)
+					// A column puts the second item under the first rather than beside it.
+					expect(direction.items[1]?.top).toBe(
+						applied ? direction.items[0]?.bottom : direction.items[0]?.top,
+					)
+					// Two 80px items share 100px: the unshrinkable one keeps its width.
+					expect(shrink.items.map((item) => item.width)).toEqual(applied ? [80, 20] : [50, 50])
+					// Two 60px items in 100px wrap onto a second line rather than overflowing.
+					expect(wrap.items[1]?.left).toBe(applied ? wrap.container.left : wrap.container.left + 60)
+					expect(justify.items[1]?.right).toBe(
+						applied ? justify.container.right : justify.container.left + 120,
+					)
+					expect(items.items[0]?.bottom).toBe(
+						applied ? items.container.bottom : items.container.top + 20,
+					)
+					// Two wrapped lines of no height of their own: packed at the end they collapse to the
+					// bottom edge, and stretched they share the container's height.
+					expect(content.items.map((item) => item.bottom)).toEqual(
+						applied
+							? [content.container.bottom, content.container.bottom]
+							: [content.container.top + 60, content.container.bottom],
+					)
+					expect(self.items[0]?.bottom).toBe(
+						applied ? self.container.bottom : self.container.top + 20,
+					)
+					expect((order.items[1]?.left ?? 0) < (order.items[0]?.left ?? 0)).toBe(applied)
+				})
+			}
+		},
+	)
+
+	it('resolves a later entry over an earlier one at one infix, and a wider infix over a narrower one', async () => {
+		// The partial writes every entry inside each boundary's block, in the release's map order,
+		// so at one infix the `flex-grow` entry follows the `flex` entry, and a wider infix's block
+		// follows every narrower one whichever entry each class belongs to.
+		const host = scene.mount(
+			'<div class="flex-fill flex-grow-0"></div><div class="flex-grow-0 flex-md-fill"></div><div class="order-md-last order-first"></div>',
+		)
+		const later = requireValue(host.querySelector('.flex-fill'), 'No same-infix element')
+		const wider = requireValue(host.querySelector('.flex-md-fill'), 'No wider-infix element')
+		const ordered = requireValue(host.querySelector('.order-md-last'), 'No order element')
+		expect(readStyle(later, 'flex-grow')).toBe('0')
+		expect(readStyle(later, 'flex-basis')).toBe('auto')
+		const below = await visitBreakpoint(767, () => [
+			readStyle(wider, 'flex-grow'),
+			readStyle(ordered, 'order'),
+		])
+		const at = await visitBreakpoint(768, () => [
+			readStyle(wider, 'flex-grow'),
+			readStyle(ordered, 'order'),
+		])
+		expect([below, at]).toEqual([
+			['0', '-1'],
+			['1', '6'],
+		])
+	})
+
+	it('reads no token or mode, so a dark island and a doubled density factor leave every value', () => {
+		const host = scene.mount(
+			'<div data-bs-theme="dark"><div class="flex-column justify-content-between align-items-center order-last"></div></div>',
+		)
+		const element = requireValue(host.querySelector('.flex-column'), 'No flex element')
+		const properties = ['flex-direction', 'justify-content', 'align-items', 'order']
+		const expected = ['column', 'space-between', 'center', '6']
+		expect(properties.map((property) => readStyle(element, property))).toEqual(expected)
+		document.documentElement.style.setProperty(TOKEN_NAMES.factor.density, '2')
+		try {
+			expect(properties.map((property) => readStyle(element, property))).toEqual(expected)
+		} finally {
+			document.documentElement.style.removeProperty(TOKEN_NAMES.factor.density)
+		}
+	})
+
+	it('keeps every flex priority over a later unlayered consumer rule', () => {
+		const host = scene.mount(
+			'<div class="probe flex-row flex-wrap flex-shrink-0 justify-content-center align-items-start align-content-end align-self-center order-2 flex-fill"></div><div class="probe"></div>',
+		)
+		scene.load(
+			'.probe { flex: 0 1 5px; flex-direction: column; flex-wrap: nowrap; justify-content: space-around; align-items: baseline; align-content: center; align-self: end; order: 7 }',
+		)
+		const utility = requireValue(host.querySelector('.flex-row'), 'No utility element')
+		const consumer = requireValue(host.lastElementChild, 'No consumer element')
+		const properties = [
+			'flex-direction',
+			'flex-wrap',
+			'justify-content',
+			'align-items',
+			'align-content',
+			'align-self',
+			'order',
+			'flex-grow',
+			'flex-basis',
+		]
+		expect(properties.map((property) => readStyle(consumer, property))).toEqual([
+			'column',
+			'nowrap',
+			'space-around',
+			'baseline',
+			'center',
+			'end',
+			'7',
+			'0',
+			'5px',
+		])
+		// The `flex-shrink-0` entry follows the `flex` entry, so the shrink it writes survives the
+		// shorthand `flex-fill` sets.
+		expect(properties.map((property) => readStyle(utility, property))).toEqual([
+			'row',
+			'wrap',
+			'center',
+			'flex-start',
+			'flex-end',
+			'center',
+			'2',
+			'1',
+			'auto',
+		])
+		expect(readStyle(utility, 'flex-shrink')).toBe('0')
+	})
+
+	it('yields to an important override inside the utilities layer and to no unlayered one', () => {
+		const host = scene.mount('<div class="flex-column order-3"></div>')
+		const element = requireValue(host.querySelector('.flex-column'), 'No utility element')
+		scene.load('.flex-column { flex-direction: row !important } .order-3 { order: 8 !important }')
+		expect([readStyle(element, 'flex-direction'), readStyle(element, 'order')]).toEqual([
+			'column',
+			'3',
+		])
+		scene.load(
+			'@layer utilities { .flex-column { flex-direction: row-reverse !important } .order-3 { order: 8 !important } }',
+		)
+		expect([readStyle(element, 'flex-direction'), readStyle(element, 'order')]).toEqual([
+			'row-reverse',
+			'8',
+		])
+	})
+})
