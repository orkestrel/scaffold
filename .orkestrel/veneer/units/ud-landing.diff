+	}),
+	Object.freeze({
+		name: 'Aligned self',
+		context: '.d-flex > .display-6 ~ ',
+		properties: Object.freeze(['align-self']),
+	}),
+	Object.freeze({
+		name: 'Fill, grow, and shrink',
+		context: '.d-flex > ',
+		properties: Object.freeze(['flex', 'flex-grow', 'flex-shrink']),
+	}),
+	Object.freeze({
+		name: 'Flex order',
+		context: '.d-flex > ',
+		properties: Object.freeze(['order']),
