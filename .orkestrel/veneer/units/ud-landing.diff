+import { TOKEN_NAMES } from '@src/core'
+import { requireValue } from '@orkestrel/test'
+import { readPixels, readStyle } from '@orkestrel/test/browser'
+import { afterEach, describe, expect, it } from 'vitest'
+import { collectLayerRules, scene } from '../../../setupBrowser.js'
+
+afterEach(() => {
+	scene.clear()
+})
+
+describe('stack helpers', () => {
+	it('lays a horizontal stack out as a centered row that composes the gap utility', () => {
+		const host = scene.mount(
+			'<div class="hstack gap-3"><div style="width: 40px; height: 60px"></div><div style="width: 40px; height: 20px"></div></div>',
+		)
+		const stack = requireValue(host.querySelector('.hstack'), 'No horizontal stack')
+		const [tall, short] = [...stack.children].map((item) => item.getBoundingClientRect())
+		const first = requireValue(tall, 'No tall item')
+		const second = requireValue(short, 'No short item')
+		expect(
+			['display', 'flex-direction', 'align-items', 'align-self'].map((property) =>
+				readStyle(stack, property),
+			),
+		).toEqual(['flex', 'row', 'center', 'stretch'])
+		// The items sit side by side, spaced by the `gap-3` step, and the short one is centered on the
+		// tall one's height rather than resting at the top.
+		expect(second.left - first.right).toBe(16)
+		expect(second.top - first.top).toBe(20)
+		expect(stack.getBoundingClientRect().height).toBe(60)
+	})
+
+	it('lays a vertical stack out as a column that fills and stretches inside a flex row', () => {
+		const host = scene.mount(
+			'<div style="display: flex; width: 300px; height: 200px"><div class="vstack gap-2"><div style="height: 20px"></div><div style="height: 20px"></div></div></div>',
+		)
+		const stack = requireValue(host.querySelector('.vstack'), 'No vertical stack')
+		const [upper, lower] = [...stack.children].map((item) => item.getBoundingClientRect())
+		const first = requireValue(upper, 'No upper item')
+		const second = requireValue(lower, 'No lower item')
+		expect(
+			['display', 'flex-direction', 'flex-grow', 'flex-shrink', 'flex-basis', 'align-self'].map(
+				(property) => readStyle(stack, property),
+			),
+		).toEqual(['flex', 'column', '1', '1', 'auto', 'stretch'])
+		// The stack takes the row's whole width and height, and its items stretch across it with the
+		// `gap-2` step between them.
+		const box = stack.getBoundingClientRect()
+		expect([box.width, box.height]).toEqual([300, 200])
+		expect([first.width, second.width]).toEqual([300, 300])
+		expect(second.top - first.bottom).toBe(8)
+	})
+
+	it('keeps its declarations normal, so an important flex utility overrides each one', () => {
+		const host = scene.mount(
+			'<div class="hstack flex-column align-items-start align-self-center d-inline-flex"></div><div class="vstack flex-row flex-grow-0 align-self-end d-grid"></div>',
+		)
+		const horizontal = requireValue(host.querySelector('.hstack'), 'No horizontal stack')
+		const vertical = requireValue(host.querySelector('.vstack'), 'No vertical stack')
+		expect(
+			['display', 'flex-direction', 'align-items', 'align-self'].map((property) =>
+				readStyle(horizontal, property),
+			),
+		).toEqual(['inline-flex', 'column', 'flex-start', 'center'])
+		expect(
+			['display', 'flex-direction', 'flex-grow', 'align-self'].map((property) =>
+				readStyle(vertical, property),
+			),
+		).toEqual(['grid', 'row', '0', 'flex-end'])
+	})
+
+	it('sits in the components layer beneath a later unlayered consumer rule', () => {
+		const components = collectLayerRules('components').flatMap((rule) =>
+			rule instanceof CSSStyleRule ? [rule.selectorText] : [],
+		)
+		const utilities = collectLayerRules('utilities').flatMap((rule) =>
+			rule instanceof CSSStyleRule ? [rule.selectorText] : [],
+		)
+		expect(components).toEqual(expect.arrayContaining(['.hstack', '.vstack']))
+		expect(utilities.filter((selector) => /stack/u.test(selector))).toEqual([])
+		const host = scene.mount('<div class="hstack"></div><div class="vstack"></div>')
+		// A normal declaration outside every layer beats a normal one inside any layer, so the
+		// consumer's own rule wins where the helper's declaration is normal.
+		scene.load('.hstack { flex-direction: column } .vstack { flex-grow: 0 }')
+		const horizontal = requireValue(host.querySelector('.hstack'), 'No horizontal stack')
+		const vertical = requireValue(host.querySelector('.vstack'), 'No vertical stack')
+		expect(readStyle(horizontal, 'flex-direction')).toBe('column')
+		expect(readStyle(vertical, 'flex-grow')).toBe('0')
+		expect(readStyle(vertical, 'flex-direction')).toBe('column')
+	})
+
+	it('reads no token or mode, so a dark island and a doubled density factor leave the stacks', () => {
+		const host = scene.mount(
+			'<div data-bs-theme="dark"><div class="hstack gap-3"><div style="width: 40px; height: 40px"></div><div style="width: 40px; height: 20px"></div></div></div>',
+		)
+		const stack = requireValue(host.querySelector('.hstack'), 'No horizontal stack')
+		const short = requireValue(stack.lastElementChild, 'No short item')
+		expect(readStyle(stack, 'display')).toBe('flex')
+		expect(readPixels(short, 'margin-top')).toBe(0)
+		const offset = short.getBoundingClientRect().top - stack.getBoundingClientRect().top
+		expect(offset).toBe(10)
+		document.documentElement.style.setProperty(TOKEN_NAMES.factor.density, '2')
+		try {
+			expect(short.getBoundingClientRect().top - stack.getBoundingClientRect().top).toBe(offset)
+		} finally {
+			document.documentElement.style.removeProperty(TOKEN_NAMES.factor.density)
+		}
+	})
+})
