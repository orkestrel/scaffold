+			Object.freeze({ key: '3', value: '3' }),
+			Object.freeze({ key: '4', value: '4' }),
+			Object.freeze({ key: '5', value: '5' }),
+			Object.freeze({ key: 'last', value: '6' }),
+		]),
+	}),
+])
+
+/** Carries the inline declaration a flex proof rests an element on, beside the value a computed style reports for it. */
+export interface FlexRestingValue {
+	/** Holds the value the proof writes inline on the element. */
+	readonly declared: string
+	/** Holds the value a computed style reports for that declaration. */
+	readonly computed: string
+}
+
+/**
+ * Holds the resting declaration for each flex property whose entry writes one value alone.
+ *
+ * @remarks
+ * A flex proof rests each element on an inline declaration its class must override, so no class
