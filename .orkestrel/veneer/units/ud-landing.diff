index 0000000..b10ce93
--- /dev/null
+++ b/src/styles/utilities/_vertical-align.scss
@@ -0,0 +1,14 @@
+@use '../mixins' as *;
+
+@layer utilities {
+	// The release's `align` entry is not responsive, so the walk writes it at the empty infix alone,
+	// ahead of every media block.
+	@include breakpoint-each using ($infix, $_boundary) {
+		@include utility(
+			align,
+			vertical-align,
+			(baseline, top, middle, bottom, text-bottom, text-top),
+			$infix
+		);
+	}
+}
