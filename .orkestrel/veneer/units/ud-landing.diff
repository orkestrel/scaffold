+import { TOKEN_NAMES } from '@src/core'
+import { requireValue } from '@orkestrel/test'
+import { findRule, readStyle } from '@orkestrel/test/browser'
+import { afterEach, describe, expect, it } from 'vitest'
+import { scene, visitBreakpoint } from '../../../setupBrowser.js'
+import { ALIGN_VALUES } from '../../../setupStyles.js'
+
+afterEach(() => {
+	scene.clear()
+})
+
+describe('vertical-alignment utilities', () => {
+	it('resolves every value at every viewport, and writes no responsive class', async () => {
+		// Each element rests on an inline `sub`, a value the utility never writes, so each reading
+		// can only come from the class.
+		const host = scene.mount(
+			[
+				...ALIGN_VALUES.map(
+					(value) => `<span class="align-${value}" style="vertical-align: sub"></span>`,
+				),
+				'<span class="align-md-top" style="vertical-align: sub"></span>',
+			].join(''),
+		)
+		for (const viewport of [375, 1401]) {
+			await visitBreakpoint(viewport, () => {
+				for (const value of ALIGN_VALUES) {
+					const element = requireValue(
+						host.querySelector(`.align-${value}`),
+						`No align-${value} element`,
+					)
+					expect(readStyle(element, 'vertical-align')).toBe(value)
+				}
+				// The release's entry is not responsive, so no infixed class exists to switch.
+				const infixed = requireValue(host.querySelector('.align-md-top'), 'No infixed element')
+				expect(readStyle(infixed, 'vertical-align')).toBe('sub')
+			})
+		}
+		expect(findRule('.align-md-top')).toBeUndefined()
+	})
+
+	it('places each box on its own line position in an inline context', () => {
+		// One line holds a tall box on the baseline that sets the line's top, a taller box hung from
+		// the line's top that sets its bottom below the text, a text run in the parent's font that
+		// marks the text edges, and a small box per value beside an unclassed one that marks the
+		// baseline.
+		const host = scene.mount(
+			[
+				'<div style="font-size: 20px; line-height: 1">',
+				'<span class="tall" style="display: inline-block; width: 8px; height: 80px"></span>',
+				'<span style="display: inline-block; vertical-align: top; width: 8px; height: 120px"></span>',
+				'<span class="text">Xg</span>',
+				'<span class="rest" style="display: inline-block; width: 8px; height: 8px"></span>',
+				...ALIGN_VALUES.map(
+					(value) =>
+						`<span class="align-${value}" style="display: inline-block; width: 8px; height: 8px"></span>`,
+				),
+				'</div>',
+			].join(''),
+		)
+		const line = requireValue(host.firstElementChild, 'No line').getBoundingClientRect()
+		const tall = requireValue(host.querySelector('.tall'), 'No tall box').getBoundingClientRect()
+		const text = requireValue(host.querySelector('.text'), 'No text run').getBoundingClientRect()
+		const rest = requireValue(host.querySelector('.rest'), 'No resting box').getBoundingClientRect()
+		const baseline = requireValue(
+			host.querySelector('.align-baseline'),
+			'No baseline box',
+		).getBoundingClientRect()
+		const top = requireValue(host.querySelector('.align-top'), 'No top box').getBoundingClientRect()
+		const middle = requireValue(
+			host.querySelector('.align-middle'),
+			'No middle box',
+		).getBoundingClientRect()
+		const bottom = requireValue(
+			host.querySelector('.align-bottom'),
+			'No bottom box',
+		).getBoundingClientRect()
+		const textBottom = requireValue(
+			host.querySelector('.align-text-bottom'),
+			'No text-bottom box',
+		).getBoundingClientRect()
+		const textTop = requireValue(
+			host.querySelector('.align-text-top'),
+			'No text-top box',
+		).getBoundingClientRect()
+		expect(baseline.bottom).toBe(rest.bottom)
+		expect(top.top).toBe(line.top)
+		expect(top.top).toBe(tall.top)
+		expect(bottom.bottom).toBe(line.bottom)
+		expect(bottom.bottom).toBe(line.top + 120)
+		expect(textTop.top).toBe(text.top)
+		expect(textBottom.bottom).toBe(text.bottom)
+		// The middle sits half the parent's x-height above the baseline, so its center falls between
+		// the text's top and the baseline, and apart from every other position.
+		const center = (middle.top + middle.bottom) / 2
+		expect(center).toBeGreaterThan(text.top)
+		expect(center).toBeLessThan(rest.bottom)
+		expect(
+			new Set([baseline, top, middle, bottom, textBottom, textTop].map((box) => box.top)).size,
+		).toBe(ALIGN_VALUES.length)
+	})
+
+	it('reads no token or mode, so a dark island and a doubled density factor leave every value', () => {
+		const host = scene.mount(
+			'<div data-bs-theme="dark"><span class="align-text-top"></span><span class="align-middle"></span></div>',
+		)
+		const top = requireValue(host.querySelector('.align-text-top'), 'No text-top element')
+		const middle = requireValue(host.querySelector('.align-middle'), 'No middle element')
+		expect([readStyle(top, 'vertical-align'), readStyle(middle, 'vertical-align')]).toEqual([
+			'text-top',
+			'middle',
+		])
+		document.documentElement.style.setProperty(TOKEN_NAMES.factor.density, '2')
+		try {
+			expect([readStyle(top, 'vertical-align'), readStyle(middle, 'vertical-align')]).toEqual([
+				'text-top',
+				'middle',
+			])
+		} finally {
+			document.documentElement.style.removeProperty(TOKEN_NAMES.factor.density)
+		}
+	})
+
+	it('keeps its priority over a later unlayered consumer rule', () => {
+		const host = scene.mount('<span class="probe align-middle"></span><span class="probe"></span>')
+		scene.load('.probe { vertical-align: top }')
+		const utility = requireValue(host.querySelector('.align-middle'), 'No utility element')
+		const consumer = requireValue(host.lastElementChild, 'No consumer element')
+		expect(readStyle(consumer, 'vertical-align')).toBe('top')
+		expect(readStyle(utility, 'vertical-align')).toBe('middle')
+	})
+
+	it('yields to an important override inside the utilities layer and to no unlayered one', () => {
+		const host = scene.mount('<span class="align-middle"></span>')
+		const element = requireValue(host.querySelector('.align-middle'), 'No utility element')
+		scene.load('.align-middle { vertical-align: top !important }')
+		expect(readStyle(element, 'vertical-align')).toBe('middle')
+		scene.load('@layer utilities { .align-middle { vertical-align: bottom !important } }')
+		expect(readStyle(element, 'vertical-align')).toBe('bottom')
+	})
+})
