+	flex: Object.freeze({ declared: 'none', computed: '0 0 auto' }),
+})
+
+/**
+ * Lists each family the Flex section renders, with the context selector that locates its labeled
+ * element and the properties whose classes it demonstrates.
+ */
+export const FLEX_FAMILY_CASES = Object.freeze([
