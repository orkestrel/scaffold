@@ -0,0 +1,112 @@
+import type { SectionInterface } from '@app/browser'
+import { DISPLAY_COPY, DISPLAY_SPECIMENS, DisplaySection, SpecimenSection } from '@app/browser'
+import { requireValue } from '@orkestrel/test'
+import { build, mount, readStyle } from '@orkestrel/test/browser'
+import { beforeAll, describe, expect, it } from 'vitest'
+import { visitBreakpoint } from '../../../setupBrowser.js'
+import { ALIGN_VALUES, DISPLAY_VALUES } from '../../../setupStyles.js'
+
+// The breakpoint case reads the specimens as the published cascade lays them out, so the cascade has
+// to be in the document before a box is measured.
+beforeAll(async () => {
+	await import('../../../../src/styles/index.scss')
+	await import('../../../../app/browser/styles/index.scss')
+})
+
+describe('DisplaySection', () => {
+	it('renders every declared specimen through the shared section contract', () => {
+		const host = mount(build('div'))
+		const section: SectionInterface = new DisplaySection(host)
+		try {
+			expect(section).toBeInstanceOf(SpecimenSection)
+			expect(section.host).toBe(host)
+			const region = requireValue(host.querySelector('section'), 'No Display region')
+			expect(region.querySelector('[style]')).toBeNull()
+			expect(region.getAttribute('aria-label')).toBe('Display')
+			expect(region.querySelector('p')?.textContent).toBe(DISPLAY_COPY.paragraph)
+			const rendered = [...region.querySelectorAll('[data-specimen]')]
+			expect(rendered.map((element) => element.getAttribute('data-specimen'))).toEqual([
+				'Display values',
+				'Responsive display',
+				'Print display',
+				'Vertical alignment',
+			])
+			expect(rendered.map((element) => element.innerHTML)).toEqual(
+				DISPLAY_SPECIMENS.map((specimen) => specimen.markup),
+			)
+			for (const value of DISPLAY_VALUES)
+				expect(region.querySelector(`[data-specimen="Display values"] .d-${value}`)).not.toBeNull()
+			for (const value of ALIGN_VALUES)
+				expect(
+					region.querySelector(`[data-specimen="Vertical alignment"] .display-6 ~ .align-${value}`),
+				).not.toBeNull()
+			for (const selector of [
+				'[data-specimen="Responsive display"] p > .d-inline.d-md-none + .d-none.d-md-inline',
+				'[data-specimen="Responsive display"] .d-block.d-md-flex.gap-3 > div + div',
+				'[data-specimen="Print display"] p > .d-inline-block.d-print-none ~ .d-none.d-print-inline',
+			])
+				expect(region.querySelector(selector)).not.toBeNull()
+			// A hidden subject shares its paragraph with text that stays visible.
+			const hidden = requireValue(
+				region.querySelector('[data-specimen="Display values"] .d-none'),
+				'No hidden subject',
+			)
+			expect(hidden.parentElement?.textContent).toContain('A hidden element follows this sentence.')
+			expect(Object.isFrozen(DISPLAY_COPY)).toBe(true)
+			expect(Object.isFrozen(DISPLAY_SPECIMENS)).toBe(true)
+			expect(DISPLAY_SPECIMENS.every((specimen) => Object.isFrozen(specimen))).toBe(true)
+		} finally {
+			section.destroy()
+			host.remove()
+		}
+	})
+
+	it('swaps the responsive sentence and lays the pair out as a row at the md boundary', async () => {
+		const host = mount(build('div'))
+		const section: SectionInterface = new DisplaySection(host)
+		try {
+			const specimen = requireValue(
+				host.querySelector('[data-specimen="Responsive display"]'),
+				'No responsive specimen',
+			)
+			const narrow = requireValue(specimen.querySelector('.d-md-none'), 'No narrow sentence')
+			const wide = requireValue(specimen.querySelector('.d-md-inline'), 'No wide sentence')
+			const pair = requireValue(specimen.querySelector('.d-md-flex'), 'No responsive pair')
+			const narrowed = await visitBreakpoint(390, () => [
+				readStyle(narrow, 'display'),
+				readStyle(wide, 'display'),
+				readStyle(pair, 'display'),
+			])
+			const widened = await visitBreakpoint(1280, () => [
+				readStyle(narrow, 'display'),
+				readStyle(wide, 'display'),
+				readStyle(pair, 'display'),
+			])
+			expect([narrowed, widened]).toEqual([
+				['inline', 'none', 'block'],
+				['none', 'inline', 'flex'],
+			])
+		} finally {
+			section.destroy()
+			host.remove()
+		}
+	})
+
+	it('releases its region and preserves neighboring content through repeated destruction', () => {
+		const host = mount(build('div'))
+		const neighbor = build('p', { text: 'Existing content' })
+		host.append(neighbor)
+		const section: SectionInterface = new DisplaySection(host)
+		try {
+			const region = requireValue(host.querySelector('section'), 'No Display region')
+			expect(region.isConnected).toBe(true)
+			section.destroy()
+			expect(region.isConnected).toBe(false)
+			section.destroy()
+			expect([...host.children]).toEqual([neighbor])
+		} finally {
+			section.destroy()
+			host.remove()
+		}
+	})
+})
diff --git a/tests/app/browser/sections/FlexSection.test.ts b/tests/app/browser/sections/FlexSection.test.ts
