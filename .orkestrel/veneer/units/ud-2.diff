+++ b/tests/src/styles/utilities/display.test.ts
@@ -0,0 +1,147 @@
+import { TOKEN_NAMES } from '@src/core'
+import { requireValue } from '@orkestrel/test'
+import { readStyle, releaseMedia, stageMedia } from '@orkestrel/test/browser'
+import { afterEach, describe, expect, it } from 'vitest'
+import { scene, visitBreakpoint } from '../../../setupBrowser.js'
+import { DISPLAY_VALUES, GRID_BREAKPOINT_CASES } from '../../../setupStyles.js'
+
+// Every element rests on an inline `display: contents`, a value the utility never writes, so a
+// reading of any listed value, the element's own default included, can only come from the class.
+const RESTING_DISPLAY = 'contents'
+
+afterEach(async () => {
+	await releaseMedia()
+	scene.clear()
+})
+
+describe('display utilities', () => {
+	it.each(GRID_BREAKPOINT_CASES)(
+		'resolves every value around the $name boundary',
+		async ({ name, boundary, readings }) => {
+			const infix = boundary === 0 ? '' : `-${name}`
+			const host = scene.mount(
+				DISPLAY_VALUES.map(
+					(value) => `<div class="d${infix}-${value}" style="display: ${RESTING_DISPLAY}"></div>`,
+				).join(''),
+			)
+			for (const viewport of readings) {
+				await visitBreakpoint(viewport, () => {
+					expect(window.innerWidth).toBe(viewport)
+					for (const value of DISPLAY_VALUES) {
+						const element = requireValue(
+							host.querySelector(`.d${infix}-${value}`),
+							`No d${infix}-${value} element`,
+						)
+						expect(readStyle(element, 'display')).toBe(
+							viewport >= boundary ? value : RESTING_DISPLAY,
+						)
+					}
+				})
+			}
+		},
+	)
+
+	it('switches to the print values under the print medium, and back to the screen values after it', async () => {
+		const host = scene.mount(
+			[
+				'<div class="d-print-none"></div>',
+				'<div class="d-none d-print-block"></div>',
+				'<div class="d-xxl-none d-print-flex"></div>',
+				'<div class="values">',
+				...DISPLAY_VALUES.map(
+					(value) => `<div class="d-print-${value}" style="display: ${RESTING_DISPLAY}"></div>`,
+				),
+				'</div>',
+			].join(''),
+		)
+		const hidden = requireValue(host.firstElementChild, 'No print-hidden element')
+		const shown = requireValue(host.querySelector('.d-none'), 'No print-shown element')
+		const wide = requireValue(host.querySelector('.d-xxl-none'), 'No wide print element')
+		const subjects = [
+			hidden,
+			shown,
+			...DISPLAY_VALUES.map((value) =>
+				requireValue(
+					host.querySelector(`.values > .d-print-${value}`),
+					`No d-print-${value} element`,
+				),
+			),
+		]
+		const screen = ['block', 'none', ...DISPLAY_VALUES.map(() => RESTING_DISPLAY)]
+		expect(subjects.map((element) => readStyle(element, 'display'))).toEqual(screen)
+		await stageMedia({ print: true })
+		expect(subjects.map((element) => readStyle(element, 'display'))).toEqual([
+			'none',
+			'block',
+			...DISPLAY_VALUES,
+		])
+		// The print pass follows the whole breakpoint walk, so a print class beats every responsive
+		// class of the same key, the widest included, at a viewport the widest one applies at.
+		expect(await visitBreakpoint(1401, () => readStyle(wide, 'display'))).toBe('flex')
+		await releaseMedia()
+		expect(subjects.map((element) => readStyle(element, 'display'))).toEqual(screen)
+		expect(await visitBreakpoint(1401, () => readStyle(wide, 'display'))).toBe('none')
+	})
+
+	it('resolves a wider infix over a narrower one whatever order the classes are written in', async () => {
+		const host = scene.mount(
+			'<div class="d-none d-md-block"></div><div class="d-md-none d-sm-flex"></div>',
+		)
+		const revealed = requireValue(host.querySelector('.d-md-block'), 'No revealed element')
+		const collapsed = requireValue(host.querySelector('.d-md-none'), 'No collapsed element')
+		const below = await visitBreakpoint(767, () => [
+			readStyle(revealed, 'display'),
+			readStyle(collapsed, 'display'),
+		])
+		const at = await visitBreakpoint(768, () => [
+			readStyle(revealed, 'display'),
+			readStyle(collapsed, 'display'),
+		])
+		expect([below, at]).toEqual([
+			['none', 'flex'],
+			['block', 'none'],
+		])
+	})
+
+	it('reads no token or mode, so a dark island and a doubled density factor leave every value', () => {
+		const host = scene.mount(
+			'<div data-bs-theme="dark"><div class="d-inline-flex"></div><div class="d-table-cell"></div></div>',
+		)
+		const flex = requireValue(host.querySelector('.d-inline-flex'), 'No inline-flex element')
+		const cell = requireValue(host.querySelector('.d-table-cell'), 'No table-cell element')
+		expect([readStyle(flex, 'display'), readStyle(cell, 'display')]).toEqual([
+			'inline-flex',
+			'table-cell',
+		])
+		document.documentElement.style.setProperty(TOKEN_NAMES.factor.density, '2')
+		try {
+			expect([readStyle(flex, 'display'), readStyle(cell, 'display')]).toEqual([
+				'inline-flex',
+				'table-cell',
+			])
+		} finally {
+			document.documentElement.style.removeProperty(TOKEN_NAMES.factor.density)
+		}
+	})
+
+	it('keeps its priority over a later unlayered consumer rule', () => {
+		const host = scene.mount('<div class="probe d-flex"></div><div class="probe"></div>')
+		scene.load('.probe { display: grid }')
+		const utility = requireValue(host.querySelector('.d-flex'), 'No utility element')
+		const consumer = requireValue(host.lastElementChild, 'No consumer element')
+		expect(readStyle(consumer, 'display')).toBe('grid')
+		expect(readStyle(utility, 'display')).toBe('flex')
+	})
+
+	it('yields to an important override inside the utilities layer and to no unlayered one', () => {
+		const host = scene.mount('<div class="d-flex"></div>')
+		const element = requireValue(host.querySelector('.d-flex'), 'No utility element')
+		// An unlayered `!important` sorts after every layered one, so the shipped utility keeps its
+		// value; the same declaration re-opened inside the utilities layer arrives after the shipped
+		// rule in that layer and wins.
+		scene.load('.d-flex { display: grid !important }')
+		expect(readStyle(element, 'display')).toBe('flex')
+		scene.load('@layer utilities { .d-flex { display: inline-grid !important } }')
+		expect(readStyle(element, 'display')).toBe('inline-grid')
+	})
+})
diff --git a/tests/src/styles/utilities/flex.test.ts b/tests/src/styles/utilities/flex.test.ts
