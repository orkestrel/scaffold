+++ b/tests/src/styles/utilities/vertical-align.test.ts
@@ -0,0 +1,140 @@
+import { TOKEN_NAMES } from '@src/core'
+import { requireValue } from '@orkestrel/test'
+import { findRule, readStyle } from '@orkestrel/test/browser'
+import { afterEach, describe, expect, it } from 'vitest'
+import { scene, visitBreakpoint } from '../../../setupBrowser.js'
+import { ALIGN_VALUES } from '../../../setupStyles.js'
+
+afterEach(() => {
+	scene.clear()
+})
+
+describe('vertical alignment utilities', () => {
+	it('resolves every value at every viewport, and writes no responsive class', async () => {
+		// Each element rests on an inline `sub`, a value the utility never writes, so each reading
+		// can only come from the class.
+		const host = scene.mount(
+			[
+				...ALIGN_VALUES.map(
+					(value) => `<span class="align-${value}" style="vertical-align: sub"></span>`,
+				),
+				'<span class="align-md-top" style="vertical-align: sub"></span>',
+			].join(''),
+		)
+		for (const viewport of [375, 1401]) {
+			await visitBreakpoint(viewport, () => {
+				for (const value of ALIGN_VALUES) {
+					const element = requireValue(
+						host.querySelector(`.align-${value}`),
+						`No align-${value} element`,
+					)
+					expect(readStyle(element, 'vertical-align')).toBe(value)
+				}
+				// The release's entry is not responsive, so no infixed class exists to switch.
+				const infixed = requireValue(host.querySelector('.align-md-top'), 'No infixed element')
+				expect(readStyle(infixed, 'vertical-align')).toBe('sub')
+			})
+		}
+		expect(findRule('.align-md-top')).toBeUndefined()
+	})
+
+	it('places each box on its own line position in an inline context', () => {
+		// One line holds a tall box on the baseline that sets the line's top, a taller box hung from
+		// the line's top that sets its bottom below the text, a text run in the parent's font that
+		// marks the text edges, and a small box per value beside an unclassed one that marks the
+		// baseline.
+		const host = scene.mount(
+			[
+				'<div style="font-size: 20px; line-height: 1">',
+				'<span class="tall" style="display: inline-block; width: 8px; height: 80px"></span>',
+				'<span style="display: inline-block; vertical-align: top; width: 8px; height: 120px"></span>',
