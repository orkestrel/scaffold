@@ -0,0 +1,155 @@
+import type { SectionInterface } from '@app/browser'
+import { FLEX_COPY, FLEX_SPECIMENS, FlexSection, SpecimenSection } from '@app/browser'
+import { requireValue } from '@orkestrel/test'
+import { build, mount } from '@orkestrel/test/browser'
+import { beforeAll, describe, expect, it } from 'vitest'
+import { visitBreakpoint } from '../../../setupBrowser.js'
+import { FLEX_ENTRY_CASES } from '../../../setupStyles.js'
+
+// The layout case reads the specimens as the published cascade lays them out, so the cascade has
+// to be in the document before a box is measured.
+beforeAll(async () => {
+	await import('../../../../src/styles/index.scss')
+	await import('../../../../app/browser/styles/index.scss')
+})
+
+describe('FlexSection', () => {
+	it('renders every declared specimen through the shared section contract', () => {
+		const host = mount(build('div'))
+		const section: SectionInterface = new FlexSection(host)
+		try {
+			expect(section).toBeInstanceOf(SpecimenSection)
+			expect(section.host).toBe(host)
+			const region = requireValue(host.querySelector('section'), 'No Flex region')
+			expect(region.querySelector('[style]')).toBeNull()
+			expect(region.getAttribute('aria-label')).toBe('Flex')
+			expect(region.querySelector('p')?.textContent).toBe(FLEX_COPY.paragraph)
+			const rendered = [...region.querySelectorAll('[data-specimen]')]
+			expect(rendered.map((element) => element.getAttribute('data-specimen'))).toEqual([
+				'Flex direction',
+				'Flex wrap',
+				'Justified content',
+				'Aligned items',
+				'Aligned content',
+				'Aligned self',
+				'Fill, grow, and shrink',
+				'Flex order',
+				'Horizontal stack',
+				'Vertical stack',
+			])
+			expect(rendered.map((element) => element.innerHTML)).toEqual(
+				FLEX_SPECIMENS.map((specimen) => specimen.markup),
+			)
+			// Each specimen demonstrates the classes of its entries in the context its markup gives them,
+			// and labels every element carrying one with that class's full name: the element itself
+			// where the class sits on an item, and one of its items where the class sits on the
+			// container.
+			const families: ReadonlyArray<readonly [string, string, readonly string[]]> = [
+				['Flex direction', '.d-flex', ['flex-direction']],
+				['Flex wrap', '.d-flex', ['flex-wrap']],
+				['Justified content', '.d-flex', ['justify-content']],
+				['Aligned items', '.d-flex', ['align-items']],
+				['Aligned content', '.ratio > .d-flex.flex-wrap', ['align-content']],
+				['Aligned self', '.d-flex > .display-6 ~ ', ['align-self']],
+				['Fill, grow, and shrink', '.d-flex > ', ['flex', 'flex-grow', 'flex-shrink']],
+				['Flex order', '.d-flex > ', ['order']],
+			]
+			for (const [name, context, properties] of families)
+				for (const { prefix, values } of FLEX_ENTRY_CASES.filter(({ property }) =>
+					properties.includes(property),
+				))
+					for (const { key } of values) {
+						const label = `${prefix}-${key}`
+						const element = requireValue(
+							region.querySelector(`[data-specimen="${name}"] ${context}.${label}`),
+							`No ${label} element in ${name}`,
+						)
+						expect([element, ...element.children].map((node) => node.textContent)).toContain(label)
+					}
+			for (const selector of [
+				'[data-specimen="Horizontal stack"] .hstack.gap-3 > .display-6 + .vr',
+				'[data-specimen="Vertical stack"] .vstack.gap-2 > .card.card-body + .card.card-body',
+			])
+				expect(region.querySelector(selector)).not.toBeNull()
+			expect(Object.isFrozen(FLEX_COPY)).toBe(true)
+			expect(Object.isFrozen(FLEX_SPECIMENS)).toBe(true)
+			expect(FLEX_SPECIMENS.every((specimen) => Object.isFrozen(specimen))).toBe(true)
+		} finally {
+			section.destroy()
+			host.remove()
+		}
+	})
+
+	it('renders the order classes in their own sequence and centers the horizontal stack at both variants', async () => {
+		const host = mount(build('div'))
+		const section: SectionInterface = new FlexSection(host)
+		try {
+			const order = requireValue(
+				host.querySelector('[data-specimen="Flex order"] .d-flex'),
+				'No order container',
+			)
+			const stack = requireValue(
+				host.querySelector('[data-specimen="Horizontal stack"] .hstack'),
+				'No horizontal stack',
+			)
+			for (const width of [390, 1280]) {
+				const reading = await visitBreakpoint(width, () => ({
+					// Items sort by their rendered line first and their position on it second.
+					order: [...order.children]
+						.map((item) => [item.getBoundingClientRect(), item.textContent] as const)
+						.sort(
+							([left], [right]) =>
+								Math.round(left.top) - Math.round(right.top) || left.left - right.left,
+						)
+						.map(([, text]) => text),
+					offsets: [...stack.children].map((item) => {
+						const box = item.getBoundingClientRect()
+						const frame = stack.getBoundingClientRect()
+						return Math.round(box.top + box.height / 2 - (frame.top + frame.height / 2))
+					}),
+					shorter: [...stack.querySelectorAll(':scope > span')].map(
+						(item) => item.getBoundingClientRect().height < stack.getBoundingClientRect().height,
+					),
+				}))
+				expect(reading.order).toEqual([
+					'order-first',
+					'order-0',
+					'order-1',
+					'order-2',
+					'order-3',
+					'order-4',
+					'order-5',
+					'order-last',
+				])
+				// Every item of the stack is centered on the row the tallest item sets; each rule
+				// stretches to the row instead, which also puts its center on the row's center.
+				expect(reading.offsets).toEqual(reading.offsets.map(() => 0))
+				// A centered offset holds under a stretch too, so the heights tell the two apart: the
+				// tall item sets the row's height, and each text item beside it keeps its own shorter box
+				// rather than stretching to the row.
+				expect(reading.shorter).toEqual([false, true, true])
+			}
+		} finally {
+			section.destroy()
+			host.remove()
+		}
+	})
+
+	it('releases its region and preserves neighboring content through repeated destruction', () => {
+		const host = mount(build('div'))
+		const neighbor = build('p', { text: 'Existing content' })
+		host.append(neighbor)
+		const section: SectionInterface = new FlexSection(host)
+		try {
+			const region = requireValue(host.querySelector('section'), 'No Flex region')
+			expect(region.isConnected).toBe(true)
+			section.destroy()
+			expect(region.isConnected).toBe(false)
+			section.destroy()
+			expect([...host.children]).toEqual([neighbor])
+		} finally {
+			section.destroy()
+			host.remove()
+		}
+	})
+})
