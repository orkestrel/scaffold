+import { DISPLAY_COPY, DISPLAY_SPECIMENS } from '../constants.js'
+import { SpecimenSection } from './SpecimenSection.js'
+
+/**
+ * Renders the declared display and vertical-alignment specimens into a named Display region.
+ *
+ * @example
+ * ```ts
+ * const section = new DisplaySection(document.body)
+ * section.destroy()
+ * ```
+ */
+export class DisplaySection extends SpecimenSection {
+	/**
+	 * Mounts the Display region and its specimens in table order.
+	 * @param host - The element receiving the section.
+	 */
+	constructor(host: HTMLElement) {
+		super(host, DISPLAY_COPY, DISPLAY_SPECIMENS)
+	}
+}
