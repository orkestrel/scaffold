+
+/**
+ * Renders the declared flex, alignment, order, and stack specimens into a named Flex region.
+ *
+ * @example
+ * ```ts
+ * const section = new FlexSection(document.body)
+ * section.destroy()
+ * ```
+ */
+export class FlexSection extends SpecimenSection {
+	/**
+	 * Mounts the Flex region and its specimens in table order.
+	 * @param host - The element receiving the section.
+	 */
+	constructor(host: HTMLElement) {
+		super(host, FLEX_COPY, FLEX_SPECIMENS)
+	}
+}
