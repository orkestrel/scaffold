new file mode 100644
index 0000000..ead0cfd
--- /dev/null
+++ b/configs/src/vite.tailwind.config.ts
@@ -0,0 +1,60 @@
+import type { Plugin } from 'vite'
+import { mkdirSync, readFileSync, writeFileSync } from 'node:fs'
+import { dirname } from 'node:path'
+import tailwindcss from '@tailwindcss/postcss'
+import { defineConfig } from 'vitest/config'
+import { resolveWorkspacePath, srcBrowser } from '../../vite.config.ts'
+
+// Matches a class selector in the built cascade, including an escaped character, so a name the
+// stylesheet writes as `.col-1` is read back as `col-1`.
+const CASCADE_CLASS = /(?:^|[\s,{}>+~()])\.((?:\\.|[A-Za-z0-9_-])+)/gu
+
+const CASCADE = resolveWorkspacePath('dist/src/styles/index.css')
+const CANDIDATES = resolveWorkspacePath('tmp/tailwind/candidates.txt')
+
+// Tailwind ignores a stylesheet named as a scan source and scans a text file, so the compiler
+// reaches the shipped class names through a list derived from the built cascade rather than
+// through the cascade itself. The list is derived per run instead of committed, so a name a later
+// release ships is a candidate the proof sees without anyone remembering to refresh a fixture.
+// The hook runs while the configuration resolves, before any stylesheet is transformed, so the
+// list is on disk before Tailwind reads the `@source` rule that names it.
+const cascadeCandidates: Plugin = {
+	name: 'veneer-tailwind-candidates',
+	enforce: 'pre',
+	configResolved() {
+		const names = new Set<string>()
+		for (const match of readFileSync(CASCADE, 'utf8').matchAll(CASCADE_CLASS)) {
+			const [, name] = match
+			if (name !== undefined) names.add(name.replaceAll(/\\(.)/gu, '$1'))
+		}
+		if (names.size === 0)
+			throw new Error('[veneer-tailwind-candidates] The built cascade declares no class')
+		mkdirSync(dirname(CANDIDATES), { recursive: true })
+		writeFileSync(CANDIDATES, [...names].sort().join('\n') + '\n', 'utf8')
+	},
+}
+
+const browser = srcBrowser()
+const { build: _build, ...shared } = browser
+
+// The root supplies the alias table, the disabled public directory, and the resolved Playwright
+// provider once for the workspace, the way the styles wrapper takes them. The fields a Tailwind
+// run differs in are replaced by assignment rather than merged, for the reason that wrapper
+// records. The inherited build block is dropped rather than replaced: this project compiles
+// profiles through the PostCSS plugin and emits no artifact of its own.
+export default defineConfig({
+	...shared,
+	plugins: [cascadeCandidates],
+	css: { postcss: { plugins: [tailwindcss()] } },
+	test: {
+		...browser.test,
+		name: { label: 'src:tailwind', color: 'green' },
+		include: ['tests/tailwind/**/*.test.ts'],
+		setupFiles: [
+			'./tests/setup.ts',
+			'./tests/setupBrowser.ts',
+			'./tests/setupStyles.ts',
+			'./dist/src/styles/index.css',
+		],
+	},
+})
