diff --git a/src/styles/components/_button-group.scss b/src/styles/components/_button-group.scss
new file mode 100644
index 0000000..e17c35f
--- /dev/null
+++ b/src/styles/components/_button-group.scss
@@ -0,0 +1,97 @@
+@use '../tokens';
+@use '../mixins' as *;
+
+@layer components {
+	.btn-group,
+	.btn-group-vertical {
+		position: relative;
+		display: inline-flex;
+		vertical-align: middle;
+	}
+
+	.btn-group > .btn,
+	.btn-group-vertical > .btn {
+		position: relative;
+		flex: 1 1 auto;
+	}
+
+	// The overlapped edge belongs to whichever child is checked, hovered, focused, or active, so
+	// every one of those children lifts by the same step. The negative margins later in this
+	// partial are what put two borders on one line for the lift to resolve.
+	.btn-group > .btn-check:checked + .btn,
+	.btn-group > .btn-check:focus + .btn,
+	.btn-group > .btn:hover,
+	.btn-group > .btn:focus,
+	.btn-group > .btn:active,
+	.btn-group > .btn.active,
+	.btn-group-vertical > .btn-check:checked + .btn,
+	.btn-group-vertical > .btn-check:focus + .btn,
+	.btn-group-vertical > .btn:hover,
+	.btn-group-vertical > .btn:focus,
+	.btn-group-vertical > .btn:active,
+	.btn-group-vertical > .btn.active {
+		z-index: 1;
+	}
+
+	.btn-toolbar {
+		display: flex;
+		flex-wrap: wrap;
+		justify-content: flex-start;
+	}
+
+	.btn-group {
+		border-radius: var(--bs-border-radius);
+	}
+
+	.btn-group > :not(.btn-check:first-child) + .btn,
+	.btn-group > .btn-group:not(:first-child) {
+		margin-left: calc(-1 * var(--bs-border-width));
+	}
+
+	// The radius is reset on the physical side each child sits on, so a group keeps one rounded
+	// outline whatever the document's writing direction. `.dropdown-toggle` is excluded because a
+	// split toggle keeps its own trailing corners, and Disclosure ships the rules that shape it.
+	.btn-group > .btn:not(:last-child):not(.dropdown-toggle),
+	.btn-group > .btn-group:not(:last-child) > .btn {
+		border-top-right-radius: 0;
+		border-bottom-right-radius: 0;
+	}
+
+	// A child loses its leading corners when it is the third or later child, when it follows a
+	// sibling that is not a `.btn-check` label, or when it opens a group that is not the first.
+	.btn-group > .btn:nth-child(n + 3),
+	.btn-group > :not(.btn-check) + .btn,
+	.btn-group > .btn-group:not(:first-child) > .btn {
+		border-top-left-radius: 0;
+		border-bottom-left-radius: 0;
+	}
+
+	.btn-group-vertical {
+		flex-direction: column;
+		align-items: flex-start;
+		justify-content: center;
+	}
+
+	.btn-group-vertical > .btn,
+	.btn-group-vertical > .btn-group {
+		width: 100%;
+	}
+
+	.btn-group-vertical > .btn:not(:first-child),
+	.btn-group-vertical > .btn-group:not(:first-child) {
+		margin-top: calc(-1 * var(--bs-border-width));
+	}
+
+	.btn-group-vertical > .btn:not(:last-child):not(.dropdown-toggle),
+	.btn-group-vertical > .btn-group:not(:last-child) > .btn {
+		border-bottom-right-radius: 0;
+		border-bottom-left-radius: 0;
+	}
+
+	.btn-group-vertical > .btn:nth-child(n + 3),
+	.btn-group-vertical > :not(.btn-check) + .btn,
+	.btn-group-vertical > .btn-group:not(:first-child) > .btn {
+		border-top-left-radius: 0;
+		border-top-right-radius: 0;
+	}
+}
