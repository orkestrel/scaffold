+describe('button group tokens', () => {
+	it('reads its radius and its overlap from the compatibility variables the token module declares', () => {
+		const host = scene.mount(`<div class="btn-group">${BUTTON_GROUP_MARKUP}</div>`)
+		const group = requireValue(host.querySelector('.btn-group'), 'No group')
+		// The cascade is read beside the resolved value: a group whose radius happened to equal the
+		// token's own value by coincidence is separated from one that reads the token. The rule is
+		// selected by its whole selector text, because the substring reader answers with the shared
+		// `.btn-group, .btn-group-vertical` rule, which declares no radius.
+		const declared = readRules().flatMap((rule) =>
+			rule instanceof CSSStyleRule && rule.selectorText === '.btn-group'
+				? [rule.style.getPropertyValue('border-radius')]
+				: [],
+		)
+		expect(declared).toEqual(['var(--bs-border-radius)'])
+		const overlap = readRules().flatMap((rule) =>
+			rule instanceof CSSStyleRule &&
+			rule.selectorText
+				.replaceAll(' ', '')
+				.split(',')
+				.includes('.btn-group>.btn-group:not(:first-child)')
+				? [rule.style.getPropertyValue('margin-left')]
+				: [],
+		)
+		expect(overlap).toEqual(['calc(-1 * var(--bs-border-width))'])
+		expect(readPixels(group, 'border-top-left-radius')).toBe(6)
+		expect(
+			readPixels(requireValue(group.querySelector('.btn'), 'No child'), 'border-left-width'),
+		).toBe(1)
+	})
+
+	it('moves every reading a consumer retunes those compatibility variables to', () => {
+		const plain = scene.mount(`<div class="btn-group">${BUTTON_GROUP_MARKUP}</div>`)
+		const host = scene.mount(
