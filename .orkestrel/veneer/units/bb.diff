+import type { SectionInterface } from '@app/browser'
+import {
+	BUTTON_GROUP_ACTIONS,
+	BUTTON_GROUP_CHOICES,
+	BUTTON_GROUP_COPY,
+	BUTTON_GROUP_PAIR,
+	BUTTON_GROUP_SPECIMENS,
+	ButtonGroupSection,
+	SpecimenSection,
+} from '@app/browser'
+import { requireValue } from '@orkestrel/test'
+import { build, mount, readName } from '@orkestrel/test/browser'
+import { describe, expect, it } from 'vitest'
+
+describe('ButtonGroupSection', () => {
+	it('renders a specimen for every grouped variant through the shared section contract', () => {
+		const host = mount(build('div'))
+		const section: SectionInterface = new ButtonGroupSection(host)
+		try {
+			expect(section).toBeInstanceOf(SpecimenSection)
+			expect(section.host).toBe(host)
+			const region = requireValue(host.querySelector('section'), 'No Button group region')
+			// An inline style is refused on this surface, so the crowded toolbar carries more groups
+			// rather than a declared width.
+			expect(region.querySelector('[style]')).toBeNull()
+			expect(region.getAttribute('aria-label')).toBe('Button group')
+			expect(region.querySelector('p')?.textContent).toBe(BUTTON_GROUP_COPY.paragraph)
+			const rendered = [...region.querySelectorAll('[data-specimen]')]
+			expect(rendered.map((element) => element.getAttribute('data-specimen'))).toEqual([
+				'Horizontal group',
+				'Vertical group',
+				'Nested groups',
+				'Check group',
+				'Small group',
+				'Large group',
+				'Wide toolbar',
+				'Crowded toolbar',
+			])
+			// The declared markup is read back through the same parser the section renders it with,
+			// because a boolean attribute written bare comes back with an empty value and a
+			// comparison against the written text would report that serialization as drift.
+			const parsed = BUTTON_GROUP_SPECIMENS.map(({ markup }) => {
+				const container = build('div')
+				container.innerHTML = markup
+				return container.innerHTML
+			})
+			expect(rendered.map((element) => element.innerHTML)).toEqual(parsed)
+			expect(parsed.filter((markup) => !markup.includes('btn-group'))).toStrictEqual([])
+			expect(Object.isFrozen(BUTTON_GROUP_COPY)).toBe(true)
+			expect(Object.isFrozen(BUTTON_GROUP_SPECIMENS)).toBe(true)
+			expect(Object.isFrozen(BUTTON_GROUP_ACTIONS)).toBe(true)
+			expect(Object.isFrozen(BUTTON_GROUP_CHOICES)).toBe(true)
+			expect(Object.isFrozen(BUTTON_GROUP_PAIR)).toBe(true)
+			expect(BUTTON_GROUP_PAIR).toStrictEqual(BUTTON_GROUP_ACTIONS.slice(0, 2))
+			expect(BUTTON_GROUP_SPECIMENS.every((entry) => Object.isFrozen(entry))).toBe(true)
+		} finally {
+			section.destroy()
+			host.remove()
+		}
+	})
+
+	it('renders every grouped class the partial ships at least once', () => {
