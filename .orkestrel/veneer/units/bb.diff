+import { BUTTON_GROUP_COPY, BUTTON_GROUP_SPECIMENS } from '../constants.js'
+import { SpecimenSection } from './SpecimenSection.js'
+
+/**
+ * Renders the declared button group and toolbar specimens into a named region.
+ * @example
+ * ```ts
+ * const section = new ButtonGroupSection(document.body)
+ * section.destroy()
+ * ```
+ */
+export class ButtonGroupSection extends SpecimenSection {
+	/**
+	 * Mounts the Button group region and its specimens.
+	 * @param host - The element receiving the section.
+	 */
+	constructor(host: HTMLElement) {
+		super(host, BUTTON_GROUP_COPY, BUTTON_GROUP_SPECIMENS)
+	}
+}
