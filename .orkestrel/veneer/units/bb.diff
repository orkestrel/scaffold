+		// and loses every trailing corner; the trailing nested group is the mirror of that.
+		expect(readPixels(requireValue(lead[0], 'No child'), 'border-top-left-radius')).toBe(base)
+		expect(readPixels(requireValue(lead[0], 'No child'), 'border-top-right-radius')).toBe(0)
+		expect(readPixels(requireValue(lead.at(-1), 'No child'), 'border-top-right-radius')).toBe(0)
