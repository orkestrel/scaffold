+++ b/app/browser/sections/BadgeSection.ts
@@ -0,0 +1,20 @@
+import { BADGE_COPY, BADGE_SPECIMENS } from '../constants.js'
+import { SpecimenSection } from './SpecimenSection.js'
+
+/**
+ * Renders the declared badge specimens into a named region.
+ * @example
+ * ```ts
+ * const section = new BadgeSection(document.body)
+ * section.destroy()
+ * ```
+ */
+export class BadgeSection extends SpecimenSection {
+	/**
+	 * Mounts the Badge region and its specimens.
+	 * @param host - The element receiving the section.
+	 */
+	constructor(host: HTMLElement) {
+		super(host, BADGE_COPY, BADGE_SPECIMENS)
+	}
+}
