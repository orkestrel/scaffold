index 0000000..036c114
--- /dev/null
+++ b/src/styles/components/_close.scss
@@ -0,0 +1,56 @@
+@layer components {
+	// The close control ships Bootstrap's recorded surface. Its text color routes through the
+	// palette token that already holds black byte for byte, and its radius through the base radius
+	// token, so a consumer retuning either one moves this control with the rest of the cascade.
+	// The opacities, the focus shadow, and the `em` box stay literal: no published Veneer scale
+	// resolves to the recorded value, and a token that did not would change what the class paints.
+	//
+	// The mark is a background asset rather than a token expression, because a data URI cannot read
+	// a custom property. `--bs-btn-close-filter` is declared by the theme scopes in `_theme.scss`,
+	// which is what inverts the mark inside a dark island; this partial declares it on the opt-in
+	// class alone, the way the release does.
+	.btn-close {
+		--bs-btn-close-color: var(--vn-palette-black-base);
+		--bs-btn-close-bg: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 16' fill='%23000'%3e%3cpath d='M.293.293a1 1 0 0 1 1.414 0L8 6.586 14.293.293a1 1 0 1 1 1.414 1.414L9.414 8l6.293 6.293a1 1 0 0 1-1.414 1.414L8 9.414l-6.293 6.293a1 1 0 0 1-1.414-1.414L6.586 8 .293 1.707a1 1 0 0 1 0-1.414'/%3e%3c/svg%3e");
+		--bs-btn-close-opacity: 0.5;
+		--bs-btn-close-hover-opacity: 0.75;
+		--bs-btn-close-focus-shadow: 0 0 0 0.25rem rgba(13, 110, 253, 0.25);
+		--bs-btn-close-focus-opacity: 1;
+		--bs-btn-close-disabled-opacity: 0.25;
+		box-sizing: content-box;
+		width: 1em;
+		height: 1em;
+		padding: 0.25em 0.25em;
+		color: var(--bs-btn-close-color);
+		background: transparent var(--bs-btn-close-bg) center / 1em auto no-repeat;
+		filter: var(--bs-btn-close-filter);
+		border: 0;
+		border-radius: var(--vn-radius-base);
+		opacity: var(--bs-btn-close-opacity);
+	}
+
+	.btn-close:hover {
+		color: var(--bs-btn-close-color);
+		text-decoration: none;
+		opacity: var(--bs-btn-close-hover-opacity);
+	}
+
+	.btn-close:focus {
+		outline: 0;
+		box-shadow: var(--bs-btn-close-focus-shadow);
+		opacity: var(--bs-btn-close-focus-opacity);
+	}
+
+	.btn-close:disabled,
+	.btn-close.disabled {
+		pointer-events: none;
+		user-select: none;
+		opacity: var(--bs-btn-close-disabled-opacity);
+	}
+
+	// The opt-in inversion a consumer puts on a control sitting over a dark surface inside a light
+	// island, where the theme scope leaves the filter empty.
+	.btn-close-white {
+		--bs-btn-close-filter: invert(1) grayscale(100%) brightness(200%);
+	}
+}
