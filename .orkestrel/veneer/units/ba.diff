+import type { SectionInterface } from '@app/browser'
+import { CLOSE_COPY, CLOSE_SPECIMENS, CloseSection, SpecimenSection } from '@app/browser'
+import { requireValue } from '@orkestrel/test'
+import { build, mount, readName } from '@orkestrel/test/browser'
+import { describe, expect, it } from 'vitest'
+
+describe('CloseSection', () => {
+	it('renders each close specimen and its refusal through the shared section contract', () => {
+		const host = mount(build('div'))
+		const section: SectionInterface = new CloseSection(host)
+		try {
+			expect(section).toBeInstanceOf(SpecimenSection)
+			expect(section.host).toBe(host)
+			const region = requireValue(host.querySelector('section'), 'No Close region')
+			expect(region.querySelector('[style]')).toBeNull()
+			expect(region.getAttribute('aria-label')).toBe('Close')
+			expect(region.querySelector('p')?.textContent).toBe(CLOSE_COPY.paragraph)
+			const rendered = [...region.querySelectorAll('[data-specimen]')]
+			expect(rendered.map((element) => element.getAttribute('data-specimen'))).toEqual([
+				'Close control',
+				'Close refused by attribute',
+				'Close refused by class',
+				'Close inverted',
+			])
+			expect(rendered.map((element) => element.innerHTML)).toEqual(
+				CLOSE_SPECIMENS.map(({ markup }) => markup),
+			)
+			// The control paints a mark rather than a label, so each one announces its own name and
+			// a specimen that stopped doing so would render an unnamed button.
+			for (const element of rendered) {
+				const control = requireValue(element.querySelector('.btn-close'), 'No close control')
+				expect(control.tagName).toBe('BUTTON')
+				expect(readName(control).length).toBeGreaterThan(0)
+				expect(control.textContent).toBe('')
+			}
+			const attributed = requireValue(
+				region.querySelector('[data-specimen="Close refused by attribute"] .btn-close'),
+				'No attributed control',
+			)
+			const classed = requireValue(
+				region.querySelector('[data-specimen="Close refused by class"] .btn-close'),
+				'No classed control',
+			)
+			expect(attributed.matches(':disabled')).toBe(true)
+			expect(classed.matches(':disabled')).toBe(false)
+			expect(classed.matches('.disabled')).toBe(true)
+			// The two refusals resolve to one opacity in the cascade proof; this region mounts
+			// without the shipped stylesheet, so what it states is that both conditions render.
+			// The inverted control sits on the dark table surface its own class exists for, so the
+			// mark reads against the fill rather than disappearing into it.
+			const inverted = requireValue(
+				region.querySelector('[data-specimen="Close inverted"] .btn-close-white'),
+				'No inverted control',
+			)
+			expect(inverted.closest('table.table-dark')).not.toBeNull()
+			expect(Object.isFrozen(CLOSE_COPY)).toBe(true)
+			expect(Object.isFrozen(CLOSE_SPECIMENS)).toBe(true)
+			expect(CLOSE_SPECIMENS.every((entry) => Object.isFrozen(entry))).toBe(true)
+		} finally {
+			section.destroy()
+			host.remove()
+		}
+	})
+
+	it('releases the region and preserves adjacent content on repeated destruction', () => {
+		const host = mount(build('div'))
+		const neighbor = build('p', { text: 'Existing content' })
+		host.append(neighbor)
+		const section: SectionInterface = new CloseSection(host)
+		try {
+			const region = requireValue(host.querySelector('section'), 'No Close region')
+			expect(region.isConnected).toBe(true)
+			section.destroy()
+			expect(region.isConnected).toBe(false)
+			section.destroy()
+			expect([...host.children]).toEqual([neighbor])
+		} finally {
+			section.destroy()
+			host.remove()
+		}
+	})
+})
