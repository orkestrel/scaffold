+			oracle.components.badge.selectors.find(({ selector }) => selector === '.badge'),
+			'The inventory records no `.badge` rule',
+		)
+		const read = (property: string): string =>
+			requireValue(
+				badge.declarations.find((declaration) => declaration.property === property),
+				`The inventory records no ${property} on \`.badge\``,
+			).value
+		expect(read('--bs-badge-font-size')).toBe('0.75em')
+		expect(read('--bs-badge-padding-x')).toBe('0.65em')
+		expect(read('--bs-badge-padding-y')).toBe('0.35em')
+		for (const { host, size, insetX, insetY } of BADGE_GEOMETRY_CASES) {
+			expect(size).toBe(host * 0.75)
+			expect(insetX).toBeCloseTo(size * 0.65, 5)
+			expect(insetY).toBeCloseTo(size * 0.35, 5)
+		}
+		const trail = requireValue(
+			oracle.components.breadcrumb.selectors.find(({ selector }) => selector === '.breadcrumb'),
+			'The inventory records no `.breadcrumb` rule',
+		)
+		const inset = requireValue(
+			trail.declarations.find(
+				(declaration) => declaration.property === '--bs-breadcrumb-item-padding-x',
+			),
+			'The inventory records no item inset',
+		).value
+		for (const { inset: pixels, divided } of BREADCRUMB_ITEM_CASES) {
+			expect(pixels).toBe(divided ? Number.parseFloat(inset) * 16 : 0)
+		}
+		expect(BREADCRUMB_ITEM_CASES.filter(({ divided }) => divided).length).toBeGreaterThan(0)
+		expect(BREADCRUMB_MARKUP).toContain('breadcrumb-item active')
+	})
+	it('derives each close state opacity and the recorded mark from the official declarations', () => {
+		const declarations = requireValue(
+			oracle.components['btn-close'].selectors.find(({ selector }) => selector === '.btn-close'),
+			'The inventory records no `.btn-close` rule',
+		).declarations
+		for (const { property, opacity } of CLOSE_STATE_CASES) {
+			expect(declarations.find((declaration) => declaration.property === property)?.value).toBe(
+				opacity,
+			)
+		}
+		expect(
+			declarations.find((declaration) => declaration.property === '--bs-btn-close-bg')?.value,
+		).toBe(CLOSE_MARK)
+		expect(
+			oracle.components['btn-close'].selectors
+				.find(({ selector }) => selector === '.btn-close-white')
+				?.declarations.find((declaration) => declaration.property === '--bs-btn-close-filter')
+				?.value,
+		).toBe(CLOSE_INVERSION)
+	})
+	it('freezes every passive case table and each of its entries', () => {
+		for (const table of [
+			BREADCRUMB_SELECTORS,
+			BREADCRUMB_ITEM_CASES,
+			BADGE_SELECTORS,
+			BADGE_GEOMETRY_CASES,
+			CLOSE_SELECTORS,
+			CLOSE_DEFERRED,
+			CLOSE_STATE_CASES,
+		]) {
+			expect(Object.isFrozen(table)).toBe(true)
+		}
+		for (const table of [BREADCRUMB_ITEM_CASES, BADGE_GEOMETRY_CASES, CLOSE_STATE_CASES]) {
+			expect(table.every((entry) => Object.isFrozen(entry))).toBe(true)
+		}
+	})
+})
