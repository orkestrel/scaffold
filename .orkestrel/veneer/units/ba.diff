@@ -0,0 +1,73 @@
+import type { SectionInterface } from '@app/browser'
+import { BADGE_COPY, BADGE_SPECIMENS, BadgeSection, SpecimenSection } from '@app/browser'
+import { requireValue } from '@orkestrel/test'
+import { build, mount } from '@orkestrel/test/browser'
+import { describe, expect, it } from 'vitest'
+
+describe('BadgeSection', () => {
+	it('renders each badge specimen on a painted surface through the shared section contract', () => {
+		const host = mount(build('div'))
+		const section: SectionInterface = new BadgeSection(host)
+		try {
+			expect(section).toBeInstanceOf(SpecimenSection)
+			expect(section.host).toBe(host)
+			const region = requireValue(host.querySelector('section'), 'No Badge region')
+			expect(region.querySelector('[style]')).toBeNull()
+			expect(region.getAttribute('aria-label')).toBe('Badge')
+			expect(region.querySelector('p')?.textContent).toBe(BADGE_COPY.paragraph)
+			const rendered = [...region.querySelectorAll('[data-specimen]')]
+			expect(rendered.map((element) => element.getAttribute('data-specimen'))).toEqual([
+				'Badge counter',
+				'Badge word',
+				'Badge at heading scale',
+				'Badge collapsed',
+			])
+			expect(rendered.map((element) => element.innerHTML)).toEqual(
+				BADGE_SPECIMENS.map(({ markup }) => markup),
+			)
+			// The class declares no fill, so every specimen paints its label on the dark table
+			// surface it sits in. A specimen moved onto the page background renders white on white.
+			for (const element of rendered) {
+				expect(element.querySelector('table.table.table-dark')).not.toBeNull()
+				expect(element.querySelector('.badge')).not.toBeNull()
+			}
+			const collapsed = requireValue(
+				region.querySelector('[data-specimen="Badge collapsed"] .badge'),
+				'No collapsed badge',
+			)
+			// The specimen renders the badge with nothing inside it, which is the condition the
+			// recorded `:empty` rule selects. The collapse itself is read in the cascade proof,
+			// because this region mounts without the shipped stylesheet.
+			expect(collapsed.textContent).toBe('')
+			expect(collapsed.matches('.badge:empty')).toBe(true)
+			expect(region.querySelector('[data-specimen="Badge at heading scale"] .h3')).not.toBeNull()
+			// A button host in this region would join the Button section's own population, which is
+			// read off the shipped class, so the badge's button offset is proved in the cascade proof.
+			expect(region.querySelector('.btn')).toBeNull()
+			expect(Object.isFrozen(BADGE_COPY)).toBe(true)
+			expect(Object.isFrozen(BADGE_SPECIMENS)).toBe(true)
+			expect(BADGE_SPECIMENS.every((entry) => Object.isFrozen(entry))).toBe(true)
+		} finally {
+			section.destroy()
+			host.remove()
+		}
+	})
+
+	it('releases the region and preserves adjacent content on repeated destruction', () => {
+		const host = mount(build('div'))
+		const neighbor = build('p', { text: 'Existing content' })
+		host.append(neighbor)
+		const section: SectionInterface = new BadgeSection(host)
+		try {
+			const region = requireValue(host.querySelector('section'), 'No Badge region')
+			expect(region.isConnected).toBe(true)
+			section.destroy()
+			expect(region.isConnected).toBe(false)
+			section.destroy()
+			expect([...host.children]).toEqual([neighbor])
+		} finally {
+			section.destroy()
+			host.remove()
+		}
+	})
+})
