@@ -0,0 +1,146 @@
+import { TOKEN_NAMES } from '@src/core'
+import { requireValue } from '@orkestrel/test'
+import { findRule, matchesColor, readPixels, readStyle, readToken } from '@orkestrel/test/browser'
+import { afterEach, describe, expect, it } from 'vitest'
+import { scene } from '../../../setupBrowser.js'
+import {
+	BREADCRUMB_ITEM_CASES,
+	BREADCRUMB_MARKUP,
+	BREADCRUMB_SELECTORS,
+	TEXT_MODES,
+} from '../../../setupStyles.js'
+
+afterEach(() => {
+	scene.clear()
+})
+
+/**
+ * Mounts one trail and returns the list element carrying it.
+ * @param theme - The color mode to mount the trail inside, or undefined for the page's own.
+ * @returns The mounted trail.
+ */
+function mountTrail(theme?: string): HTMLElement {
+	const attribute = theme === undefined ? '' : ` data-bs-theme="${theme}"`
+	const host = scene.mount(
+		`<div${attribute}><ol class="breadcrumb">${BREADCRUMB_MARKUP}</ol></div>`,
+	)
+	const trail = requireValue(host.querySelector('.breadcrumb'), 'No trail')
+	if (!(trail instanceof HTMLElement)) throw new Error('The mounted trail is not an HTML element')
+	return trail
+}
+
+describe('breadcrumb layout', () => {
+	it.each(BREADCRUMB_ITEM_CASES)(
+		'insets and divides the $name as the recorded rules select it',
+		({ position, inset, divided }) => {
+			const trail = mountTrail()
+			const item = requireValue(
+				[...trail.querySelectorAll('.breadcrumb-item')][position],
+				'No item at that position',
+			)
+			// Both recorded rules select an item preceded by another one, so the leading item takes
+			// neither. A rule rewritten onto `.breadcrumb-item` alone insets and divides it and
+			// reddens the leading case alone.
+			expect(readPixels(item, 'padding-left')).toBeCloseTo(inset, 3)
+			expect(readStyle(item, 'content', '::before')).toBe(divided ? '"/"' : 'none')
+			expect(readPixels(item, 'padding-right', '::before')).toBeCloseTo(divided ? inset : 0, 3)
+			// The divider floats to the physical start, so it sits ahead of the item's own text
+			// whatever the document's writing direction. An item with no divider generates no box,
+			// and the float reads as the initial value there.
+			expect(readStyle(item, 'float', '::before')).toBe(divided ? 'left' : 'none')
+		},
+	)
+
+	it('lays the trail out as a wrapping flex row carrying no list marker', () => {
+		const trail = mountTrail()
+		expect(readStyle(trail, 'display')).toBe('flex')
+		expect(readStyle(trail, 'flex-wrap')).toBe('wrap')
+		expect(readStyle(trail, 'list-style-type')).toBe('none')
+		expect(readPixels(trail, 'padding-left')).toBe(0)
+		expect(readPixels(trail, 'padding-top')).toBe(0)
+		expect(readPixels(trail, 'margin-bottom')).toBeCloseTo(16, 3)
+	})
+
+	it('carries a rule for every recorded trail name in the loaded cascade', () => {
+		// The lookup reads the sheet the browser resolved rather than the source, so a name the
+		// partial stops writing reddens here. It is a containment lookup and proves no
+		// completeness; the conformance ledger is what holds the recorded set whole.
+		expect(BREADCRUMB_SELECTORS.filter((selector) => findRule(selector) === undefined)).toEqual([])
+	})
+
+	it('rescales the trail rhythm with the published density factor', () => {
+		const trail = mountTrail()
+		const middle = requireValue(
+			[...trail.querySelectorAll('.breadcrumb-item')][1],
+			'No middle item',
+		)
+		expect(readPixels(trail, 'margin-bottom')).toBeCloseTo(16, 3)
+		expect(readPixels(middle, 'padding-left')).toBeCloseTo(8, 3)
+		// The factor is set on the document element because a token's computed value carries its
+		// own references already substituted, so a factor set on an ancestor moves nothing.
+		document.documentElement.style.setProperty(TOKEN_NAMES.factor.density, '2')
+		try {
+			expect(readPixels(trail, 'margin-bottom')).toBeCloseTo(32, 3)
+			expect(readPixels(middle, 'padding-left')).toBeCloseTo(16, 3)
+		} finally {
+			document.documentElement.style.removeProperty(TOKEN_NAMES.factor.density)
+		}
+	})
+})
+
+describe('breadcrumb overrides', () => {
+	it('replaces the divider through the published variable and keeps the recorded fallback', () => {
+		const trail = mountTrail()
+		const middle = requireValue(
+			[...trail.querySelectorAll('.breadcrumb-item')][1],
+			'No middle item',
+		)
+		// The release declares the divider variable nowhere, so the recorded slash is the `var()`
+		// fallback the rule carries rather than a value the cascade sets.
+		expect(readToken(trail, '--bs-breadcrumb-divider').trim()).toBe('')
+		expect(readStyle(middle, 'content', '::before')).toBe('"/"')
+		trail.style.setProperty('--bs-breadcrumb-divider', '">"')
+		expect(readStyle(middle, 'content', '::before')).toBe('">"')
+	})
+
+	it('declares the fill and the radius with nothing after the colon and paints on demand', () => {
+		const trail = mountTrail()
+		// The declaration stands with no value, which leaves each property to resolve as unset and
+		// is what a consumer's own value replaces. A rule dropping the declaration entirely would
+		// read the same here, so the conformance ledger is what holds the declaration itself.
+		expect(readToken(trail, '--bs-breadcrumb-bg').trim()).toBe('')
+		expect(readToken(trail, '--bs-breadcrumb-border-radius').trim()).toBe('')
+		expect(readStyle(trail, 'background-color')).toBe('rgba(0, 0, 0, 0)')
+		expect(readPixels(trail, 'border-top-left-radius')).toBe(0)
+		trail.style.setProperty('--bs-breadcrumb-bg', 'rgb(10, 20, 30)')
+		trail.style.setProperty('--bs-breadcrumb-border-radius', '4px')
+		expect(readStyle(trail, 'background-color')).toBe('rgb(10, 20, 30)')
+		expect(readPixels(trail, 'border-top-left-radius')).toBeCloseTo(4, 3)
+	})
+
+	it('leaves the trail at the inherited text size because no size variable is declared', () => {
+		const trail = mountTrail()
+		const host = requireValue(trail.parentElement, 'No trail host')
+		host.style.setProperty('font-size', '22px')
+		// The rule reads a variable the release declares nowhere, so the declaration is invalid at
+		// computed-value time and the inherited size stands. A variable declared here would pin the
+		// trail to its own size and break that inheritance.
+		expect(readToken(trail, '--bs-breadcrumb-font-size').trim()).toBe('')
+		expect(readPixels(trail, 'font-size')).toBeCloseTo(22, 3)
+		trail.style.setProperty('--bs-breadcrumb-font-size', '10px')
+		expect(readPixels(trail, 'font-size')).toBeCloseTo(10, 3)
+	})
+
+	it.each(TEXT_MODES)('paints the divider and the active item from the mode in %s', (mode) => {
+		const trail = mountTrail(mode)
+		const items = [...trail.querySelectorAll('.breadcrumb-item')]
+		const middle = requireValue(items[1], 'No middle item')
+		const active = requireValue(items[2], 'No active item')
+		// Both recorded values read the secondary text color, which each mode declares for itself,
+		// so the divider and the active item follow the island rather than the page.
+		const secondary = readToken(trail, '--bs-secondary-color')
+		expect(matchesColor(readStyle(middle, 'color', '::before'), secondary)).toBe(true)
+		expect(matchesColor(readStyle(active, 'color'), secondary)).toBe(true)
+		expect(matchesColor(readStyle(middle, 'color'), secondary)).toBe(false)
+	})
+})
