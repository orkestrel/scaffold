@@ -0,0 +1,138 @@
+import { TOKEN_NAMES } from '@src/core'
+import { requireValue } from '@orkestrel/test'
+import {
+	findRule,
+	matchesColor,
+	readPixels,
+	readRootToken,
+	readStyle,
+	readToken,
+} from '@orkestrel/test/browser'
+import { afterEach, describe, expect, it } from 'vitest'
+import { scene } from '../../../setupBrowser.js'
+import { BADGE_GEOMETRY_CASES, BADGE_SELECTORS, TEXT_MODES } from '../../../setupStyles.js'
+
+afterEach(() => {
+	scene.clear()
+})
+
+/**
+ * Mounts one badge inside a host whose font size the case names.
+ * @param size - The host's font size in CSS pixels.
+ * @returns The mounted badge.
+ */
+function mountBadge(size: number): HTMLElement {
+	const host = scene.mount(
+		`<p style="font-size:${String(size)}px">Inbox <span class="badge">7</span></p>`,
+	)
+	const badge = requireValue(host.querySelector('.badge'), 'No badge')
+	if (!(badge instanceof HTMLElement)) throw new Error('The mounted badge is not an HTML element')
+	return badge
+}
+
+describe('badge geometry', () => {
+	it.each(BADGE_GEOMETRY_CASES)(
+		'resolves the relative box on a $name',
+		({ host, size, insetX, insetY }) => {
+			const badge = mountBadge(host)
+			// The recorded font size is relative to the host and the recorded padding is relative to
+			// the badge's own size, so the two multiply. Padding rewritten against the host resolves
+			// to the same numbers at a 16px host and reddens the 24px case alone.
+			expect(readPixels(badge, 'font-size')).toBeCloseTo(size, 3)
+			expect(readPixels(badge, 'padding-left')).toBeCloseTo(insetX, 3)
+			expect(readPixels(badge, 'padding-right')).toBeCloseTo(insetX, 3)
+			expect(readPixels(badge, 'padding-top')).toBeCloseTo(insetY, 3)
+			expect(readPixels(badge, 'padding-bottom')).toBeCloseTo(insetY, 3)
+			// The recorded line height is the unitless 1, so the line box is the badge's own font
+			// size rather than the body line height its host carries.
+			expect(readPixels(badge, 'line-height')).toBeCloseTo(size, 3)
+		},
+	)
+
+	it('lays the label out as a centered inline box that never wraps', () => {
+		const badge = mountBadge(16)
+		expect(readStyle(badge, 'display')).toBe('inline-block')
+		expect(readStyle(badge, 'text-align')).toBe('center')
+		expect(readStyle(badge, 'white-space')).toBe('nowrap')
+		// The recorded alignment is the baseline, which is what separates a badge from the middle
+		// alignment the button class carries.
+		expect(readStyle(badge, 'vertical-align')).toBe('baseline')
+	})
+
+	it('collapses a badge carrying no content and restores it when content arrives', () => {
+		const host = scene.mount('<span class="badge"></span>')
+		const badge = requireValue(host.querySelector('.badge'), 'No badge')
+		expect(readStyle(badge, 'display')).toBe('none')
+		badge.textContent = '3'
+		expect(readStyle(badge, 'display')).toBe('inline-block')
+	})
+
+	it('lifts a badge inside a button host and leaves a loose badge in flow', () => {
+		const host = scene.mount(
+			'<span><button class="btn" type="button">Inbox <span class="badge">7</span></button><span class="badge">7</span></span>',
+		)
+		const badges = [...host.querySelectorAll('.badge')]
+		const inside = requireValue(badges[0], 'No badge inside the button')
+		const loose = requireValue(badges[1], 'No loose badge')
+		expect(readStyle(inside, 'position')).toBe('relative')
+		expect(readPixels(inside, 'top')).toBe(-1)
+		// The loose badge is what separates the recorded combinator from a rule on the class
+		// itself: a treatment moved onto `.badge` would lift this one too.
+		expect(readStyle(loose, 'position')).toBe('static')
+	})
+
+	it('carries a rule for every recorded badge name in the loaded cascade', () => {
+		// The lookup reads the sheet the browser resolved rather than the source, so a name the
+		// partial stops writing reddens here. It is a containment lookup and proves no
+		// completeness; the conformance ledger is what holds the recorded set whole.
+		expect(BADGE_SELECTORS.filter((selector) => findRule(selector) === undefined)).toEqual([])
+	})
+})
+
+describe('badge paint', () => {
+	it('paints the recorded text color from the palette token', () => {
+		const badge = mountBadge(16)
+		expect(matchesColor(readStyle(badge, 'color'), readRootToken('--vn-palette-white-base'))).toBe(
+			true,
+		)
+		expect(matchesColor(readToken(badge, '--bs-badge-color'), '#fff')).toBe(true)
+	})
+
+	it('repaints the label from a consumer rule setting the published variable', () => {
+		const badge = mountBadge(16)
+		// The class declares the variable on the badge itself, so an ancestor cannot reach it and a
+		// consumer retunes it through a rule of their own, which arrives after the shipped cascade.
+		scene.load('.badge { --bs-badge-color: rgb(10, 20, 30); }')
+		expect(readStyle(badge, 'color')).toBe('rgb(10, 20, 30)')
+	})
+
+	it('rescales the badge corner with the published radius factor and takes a direct override', () => {
+		const badge = mountBadge(16)
+		// The recorded radius reads the compatibility variable, which this cascade declares over the
+		// radius token, so the factor reaches a badge whose own rule names no Veneer token. The
+		// factor is set on the document element because a token's computed value carries its own
+		// references already substituted.
+		expect(readPixels(badge, 'border-top-left-radius')).toBeCloseTo(6, 3)
+		document.documentElement.style.setProperty(TOKEN_NAMES.factor.radius, '2')
+		try {
+			expect(readPixels(badge, 'border-top-left-radius')).toBeCloseTo(12, 3)
+		} finally {
+			document.documentElement.style.removeProperty(TOKEN_NAMES.factor.radius)
+		}
+		scene.load('.badge { --bs-badge-border-radius: 3px; }')
+		expect(readPixels(badge, 'border-top-left-radius')).toBeCloseTo(3, 3)
+	})
+
+	it.each(TEXT_MODES)('keeps the recorded label color and empty fill in %s mode', (mode) => {
+		const host = scene.mount(`<div data-bs-theme="${mode}"><span class="badge">7</span></div>`)
+		const badge = requireValue(host.querySelector('.badge'), 'No badge')
+		// The release records one color for both modes, so a mode-dependent repaint here would be
+		// this package's own addition rather than the recorded treatment.
+		expect(matchesColor(readStyle(badge, 'color'), readRootToken('--vn-palette-white-base'))).toBe(
+			true,
+		)
+		// The class declares no fill at all, which is what leaves the surrounding surface showing
+		// through and what a contextual fill class would supply.
+		expect(readStyle(badge, 'background-color')).toBe('rgba(0, 0, 0, 0)')
+	})
+})
