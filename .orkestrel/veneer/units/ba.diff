+import type { SectionInterface } from '@app/browser'
+import {
+	BREADCRUMB_COPY,
+	BREADCRUMB_SPECIMENS,
+	BreadcrumbSection,
+	SpecimenSection,
+} from '@app/browser'
+import { requireValue } from '@orkestrel/test'
+import { build, mount } from '@orkestrel/test/browser'
+import { describe, expect, it } from 'vitest'
+
+describe('BreadcrumbSection', () => {
+	it('renders each trail specimen through the shared section contract', () => {
+		const host = mount(build('div'))
+		const section: SectionInterface = new BreadcrumbSection(host)
+		try {
+			expect(section).toBeInstanceOf(SpecimenSection)
+			expect(section.host).toBe(host)
+			const region = requireValue(host.querySelector('section'), 'No Breadcrumb region')
+			expect(region.querySelector('[style]')).toBeNull()
+			expect(region.getAttribute('aria-label')).toBe('Breadcrumb')
+			expect(region.querySelector('p')?.textContent).toBe(BREADCRUMB_COPY.paragraph)
+			const rendered = [...region.querySelectorAll('[data-specimen]')]
+			expect(rendered.map((element) => element.getAttribute('data-specimen'))).toEqual([
+				'Breadcrumb trail',
+				'Breadcrumb single step',
+			])
+			expect(rendered.map((element) => element.innerHTML)).toEqual(
+				BREADCRUMB_SPECIMENS.map(({ markup }) => markup),
+			)
+			// Each trail announces itself as a navigation landmark and marks its own current page,
+			// which is what a list of links alone would leave unstated.
+			for (const element of rendered) {
+				const trail = requireValue(element.querySelector('nav > ol.breadcrumb'), 'No trail')
+				expect(element.querySelector('nav')?.getAttribute('aria-label')).toBe(
+					element.getAttribute('data-specimen'),
+				)
+				expect(trail.querySelectorAll('.breadcrumb-item.active')).toHaveLength(1)
+				expect(trail.querySelector('.breadcrumb-item.active')?.getAttribute('aria-current')).toBe(
+					'page',
+				)
+			}
+			// The single-step trail is what separates the divider's recorded combinator from a rule
+			// on the item itself: its one item is preceded by nothing and carries no divider.
+			const single = requireValue(
+				region.querySelector('[data-specimen="Breadcrumb single step"] .breadcrumb'),
+				'No single-step trail',
+			)
+			expect(single.querySelectorAll('.breadcrumb-item')).toHaveLength(1)
+			expect(single.querySelector('.breadcrumb-item + .breadcrumb-item')).toBeNull()
+			// The divider's own paint is read in the cascade proof, because this region mounts
+			// without the shipped stylesheet.
+			const trail = requireValue(
+				region.querySelector('[data-specimen="Breadcrumb trail"] .breadcrumb'),
+				'No divided trail',
+			)
+			expect(trail.querySelector('.breadcrumb-item + .breadcrumb-item')).not.toBeNull()
+			expect(Object.isFrozen(BREADCRUMB_COPY)).toBe(true)
+			expect(Object.isFrozen(BREADCRUMB_SPECIMENS)).toBe(true)
+			expect(BREADCRUMB_SPECIMENS.every((entry) => Object.isFrozen(entry))).toBe(true)
+		} finally {
+			section.destroy()
+			host.remove()
+		}
+	})
+
+	it('releases the region and preserves adjacent content on repeated destruction', () => {
+		const host = mount(build('div'))
+		const neighbor = build('p', { text: 'Existing content' })
+		host.append(neighbor)
+		const section: SectionInterface = new BreadcrumbSection(host)
+		try {
+			const region = requireValue(host.querySelector('section'), 'No Breadcrumb region')
+			expect(region.isConnected).toBe(true)
+			section.destroy()
+			expect(region.isConnected).toBe(false)
+			section.destroy()
+			expect([...host.children]).toEqual([neighbor])
+		} finally {
+			section.destroy()
+			host.remove()
+		}
+	})
+})
