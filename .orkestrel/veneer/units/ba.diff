diff --git a/src/styles/components/_badge.scss b/src/styles/components/_badge.scss
new file mode 100644
index 0000000..cbc1db2
--- /dev/null
+++ b/src/styles/components/_badge.scss
@@ -0,0 +1,38 @@
+@layer components {
+	// The badge ships Bootstrap's recorded geometry and nothing more. Its padding, font size, and
+	// weight are written as the release writes them: each is relative to the badge's own inherited
+	// font size, so no published length scale resolves to the recorded value and a token here would
+	// change what the class measures. The text color is the one value a Veneer token already holds
+	// byte for byte, so it routes through the palette and a consumer retuning white moves the badge
+	// with everything else. The radius reads the compatibility variable the release reads.
+	//
+	// The release declares no fill on this class, and Veneer ships no contextual fill utility yet,
+	// so a badge paints its own text over whatever surface carries it.
+	.badge {
+		--bs-badge-padding-x: 0.65em;
+		--bs-badge-padding-y: 0.35em;
+		--bs-badge-font-size: 0.75em;
+		--bs-badge-font-weight: 700;
+		--bs-badge-color: var(--vn-palette-white-base);
+		--bs-badge-border-radius: var(--bs-border-radius);
+		display: inline-block;
+		padding: var(--bs-badge-padding-y) var(--bs-badge-padding-x);
+		font-size: var(--bs-badge-font-size);
+		font-weight: var(--bs-badge-font-weight);
+		line-height: 1;
+		color: var(--bs-badge-color);
+		text-align: center;
+		white-space: nowrap;
+		vertical-align: baseline;
+		border-radius: var(--bs-badge-border-radius);
+	}
+
+	.badge:empty {
+		display: none;
+	}
+
+	.btn .badge {
+		position: relative;
+		top: -1px;
+	}
+}
diff --git a/src/styles/components/_breadcrumb.scss b/src/styles/components/_breadcrumb.scss
new file mode 100644
index 0000000..01902af
--- /dev/null
+++ b/src/styles/components/_breadcrumb.scss
@@ -0,0 +1,46 @@
+@layer components {
+	// The trail ships Bootstrap's recorded surface. Its bottom margin and item inset are the two
+	// lengths a Veneer spacing token already resolves to, so each routes through that token and
+	// rescales with the density factor; the zero insets and the divider fallback stay literal.
+	//
+	// The fill and the radius are declared with nothing after the colon, which is what the release
+	// writes: the property stands so a consumer can set it, and the trail paints nothing until one
+	// does. `--bs-breadcrumb-font-size` is declared nowhere for the same reason the release declares
+	// it nowhere, so the `font-size` declaration reading it leaves the inherited size in place.
+	.breadcrumb {
+		--bs-breadcrumb-padding-x: 0;
+		--bs-breadcrumb-padding-y: 0;
+		--bs-breadcrumb-margin-bottom: var(--vn-space-8);
+		--bs-breadcrumb-bg: #{''};
+		--bs-breadcrumb-border-radius: #{''};
+		--bs-breadcrumb-divider-color: var(--bs-secondary-color);
+		--bs-breadcrumb-item-padding-x: var(--vn-space-4);
+		--bs-breadcrumb-item-active-color: var(--bs-secondary-color);
+		display: flex;
+		flex-wrap: wrap;
+		padding: var(--bs-breadcrumb-padding-y) var(--bs-breadcrumb-padding-x);
+		margin-bottom: var(--bs-breadcrumb-margin-bottom);
+		font-size: var(--bs-breadcrumb-font-size);
+		list-style: none;
+		background-color: var(--bs-breadcrumb-bg);
+		border-radius: var(--bs-breadcrumb-border-radius);
+	}
+
+	.breadcrumb-item + .breadcrumb-item {
+		padding-left: var(--bs-breadcrumb-item-padding-x);
+	}
+
+	// The divider is the item's own leading content, and a consumer replaces it by setting
+	// `--bs-breadcrumb-divider` on the trail. The float is physical, so the divider sits on the
+	// same side whatever the document's writing direction.
+	.breadcrumb-item + .breadcrumb-item::before {
+		float: left;
+		padding-right: var(--bs-breadcrumb-item-padding-x);
+		color: var(--bs-breadcrumb-divider-color);
+		content: var(--bs-breadcrumb-divider, '/');
+	}
+
+	.breadcrumb-item.active {
+		color: var(--bs-breadcrumb-item-active-color);
+	}
+}
