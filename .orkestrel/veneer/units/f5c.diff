+/** Carries one reference-map row: a token and the value the guide states for it in each mode. */
+export interface ReferenceRow {
+	/** Holds the custom-property name the row's first cell names. */
+	readonly token: string
+	/**
+	 * Holds the value the row states for the light scope, and nothing where the cell describes its
+	 * value in prose instead of stating it.
+	 */
+	readonly light: string | undefined
+	/** Holds the value the row states for the dark scope, read the way `light` is read. */
+	readonly dark: string | undefined
+	/** Holds the `Source` legend word the row carries, and nothing where its table has no such column. */
+	readonly source: string | undefined
+}
+
+/**
+ * Splits a guide table cell into the code spans it states.
+ *
+ * @param text - The cell text, as `extractCellText` returns it, with each code span in backticks.
+ * @param separator - The exact text the cell writes between one span and the next.
+ * @returns Each span's inner text in cell order, and nothing where the cell carries prose beside
+ *   its spans, because such a cell describes a value rather than stating one.
+ *
+ * @example
+ * ```ts
+ * splitCellSpans('`1px`, `solid`', ', ') // ['1px', 'solid']
+ * ```
+ */
+export function splitCellSpans(text: string, separator: string): readonly string[] {
+	const spans = [...text.matchAll(/`([^`]+)`/gu)].map((match) => match[1] ?? '')
+	return text === spans.map((span) => `\`${span}\``).join(separator) ? spans : []
+}
+
+/**
+ * Substitutes a tier template's placeholders for one semantic role.
+ *
+ * @param text - The template text, carrying `{role}` for the role's own name and `{fill}` for the
+ *   token that holds its fill.
+ * @param role - The role name to write in.
+ * @returns The text with every placeholder replaced.
+ *
+ * @example
+ * ```ts
+ * substituteRole('--vn-color-{role}-subtle', 'info') // '--vn-color-info-subtle'
+ * ```
+ */
+export function substituteRole(text: string, role: string): string {
+	return text.replaceAll('{fill}', `var(--vn-color-${role}-base)`).replaceAll('{role}', role)
+}
+
+/**
+ * Collects the tokens a reference-map row's first cell names.
+ *
+ * @param text - The first cell's text.
+ * @param names - The registry's names in registry order, which a range is sliced from.
+ * @returns Each token the cell names, in cell order, and nothing where the cell carries prose.
+ *
+ * @remarks
+ * A cell writes its tokens as a comma-separated list, or as a `through` range over two registry
+ * names. A list member beginning with one dash is a suffix over the member before it and replaces
+ * as many of that member's trailing segments as the suffix carries, so `--vn-text-body-base`,
+ * `-rgb` names `--vn-text-body-rgb` and `--vn-stack-drawer-backdrop`, `-drawer-base` names
+ * `--vn-stack-drawer-base`.
+ *
+ * @example
+ * ```ts
+ * collectRowTokens('`--vn-radius-small`, `-base`', []) // ['--vn-radius-small', '--vn-radius-base']
+ * ```
+ */
+export function collectRowTokens(text: string, names: readonly string[]): readonly string[] {
+	const range = splitCellSpans(text, ' through ')
+	if (range.length === 2) {
+		const start = names.indexOf(range[0] ?? '')
+		const end = names.indexOf(range[1] ?? '')
+		return start < 0 || end < start ? [] : names.slice(start, end + 1)
+	}
+	const tokens: string[] = []
+	for (const span of splitCellSpans(text, ', ')) {
+		const previous = tokens.at(-1)
+		const suffix = span.startsWith('-') && !span.startsWith('--')
+		if (!suffix || previous === undefined) {
+			tokens.push(span)
+			continue
+		}
+		tokens.push(
+			previous
+				.split('-')
+				.slice(0, -(span.split('-').length - 1))
+				.join('-') + span,
+		)
+	}
+	return tokens
+}
+
+/**
+ * Normalizes a declaration value to the form two writings of the same value share.
+ *
+ * @param value - The declaration text, from a guide cell or from the cascade.
+ * @returns The text with every whitespace run collapsed, the space beside a bracket or a comma
+ *   dropped, every number written in full, and every millisecond duration written in seconds, so
+ *   the Sass source's wrapped expression, the styles build's shortened rewriting, and the guide's
+ *   single line compare equal.
+ *
+ * @remarks
+ * The styles build shortens a number and a duration, so `0.75rem` ships as `.75rem` and `150ms`
+ * ships as `.15s`. Both are the same value written another way, and this puts each writing in one
+ * form. The build also rewrites a color channel into the engine's own serialization, which no
+ * text rule can undo: compare such a pair as the color each side paints.
+ *
