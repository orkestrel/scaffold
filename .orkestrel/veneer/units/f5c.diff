+export const PROBE_REFERENCE = `## Tokens
+
+### Reference map
+
+#### Roles
+
+| Role      | Fill                                               | Source              | Alias |
+| --------- | -------------------------------------------------- | ------------------- | ----- |
+| \`primary\` | \`oklch(0.5 0.1 200)\`, dark \`oklch(0.8 0.1 200)\` | \`elements\` — fill | none  |
+
+| Tier                         | Light expression                            | Dark expression     | Alias |
+| ---------------------------- | ------------------------------------------- | ------------------- | ----- |
+| \`--vn-probe-color-{role}-subtle\` | \`color-mix(in oklab, {fill} 12%, white)\` | the same expression | none  |
+
+#### Scale
+
+| Token                                     | Value                         | Source        | Alias |
+| ----------------------------------------- | ----------------------------- | ------------- | ----- |
+| \`--vn-probe-1\` through \`--vn-probe-3\` | \`1px\`, \`2px\`, \`3px\`     | \`bootstrap\` | none  |
+| \`--vn-probe-base\`, \`-rgb\`             | \`#000\`, \`0, 0, 0\`         | \`derived\`   | none  |
+| \`--vn-probe-prose\`                      | the scale expression at N = 1 | \`derived\`   | none  |
+
+### Outside the map
+
+| Token                 | Value   |
+| --------------------- | ------- |
+| \`--vn-probe-outside\` | \`9px\` |
+`
+
+/**
+ * Collects the token values the guide's Tokens section states under its reference map.
+ *
+ * @param source - The guide's Markdown text.
+ * @param names - The registry's names in registry order, for the ranges a row writes.
+ * @returns One row per token the reference map's tables name, in document order.
+ *
+ * @remarks
+ * A table keyed by `Token` names its tokens in the first cell and pairs them with the value cell's
+ * spans in the same order. A table keyed by `Role` names the role whose fill the row gives, so the
+ * row's token is that role's own `--vn-color-{role}-base`. A table keyed by `Tier` writes one
+ * templated row per tier, and each such row expands over every role the `Role` table named before
+ * it.
+ *
+ * A value cell states its values as one code span per token of the row, as `` `light`, dark
+ * `dark` `` where a single-value column gives both modes, or as `the same expression` where the
+ * dark scope repeats the light cell. A cell in any other form describes its value rather than
+ * stating it, and both of that row's modes read as `undefined`.
+ */
+export function collectReferenceRows(
+	source: string,
+	names: readonly string[],
+): readonly ReferenceRow[] {
+	const rows: ReferenceRow[] = []
+	const roles: string[] = []
+	let active = false
+	for (const block of selectSectionBlocks(createMarkdown(source).document, 'Tokens')) {
+		if (block.element === 'heading' && block.level === 3) {
+			if (active) break
+			active = flattenText(block).trim() === 'Reference map'
+			continue
+		}
+		if (!active || block.element !== 'table') continue
+		const role = findColumnIndex(block, 'Role')
+		const tier = findColumnIndex(block, 'Tier')
+		const keyed = role ?? tier ?? findColumnIndex(block, 'Token')
+		const valued =
+			findColumnIndex(block, 'Light') ??
+			findColumnIndex(block, 'Light expression') ??
+			findColumnIndex(block, 'Fill') ??
+			findColumnIndex(block, 'Value')
+		if (keyed === undefined || valued === undefined) continue
+		const shaded = findColumnIndex(block, 'Dark') ?? findColumnIndex(block, 'Dark expression')
+		const legend = findColumnIndex(block, 'Source')
+		for (const cells of block.rows) {
+			const keyText = extractCellText(cells[keyed] ?? []).trim()
+			const lightText = extractCellText(cells[valued] ?? []).trim()
+			const shadedText = shaded === undefined ? '' : extractCellText(cells[shaded] ?? []).trim()
+			const darkText = shadedText === 'the same expression' ? lightText : shadedText
+			const named =
+				legend === undefined
+					? undefined
+					: /^`([^`]+)`/u.exec(extractCellText(cells[legend] ?? []).trim())?.[1]
+			const light = splitCellSpans(lightText, ', ')
+			const dark = shaded === undefined ? light : splitCellSpans(darkText, ', ')
+			if (tier !== undefined) {
+				const template = splitCellSpans(keyText, ', ')
+				if (template.length !== 1) continue
+				for (const name of roles) {
+					rows.push({
+						token: substituteRole(template[0] ?? '', name),
+						light: light.length === 1 ? substituteRole(light[0] ?? '', name) : undefined,
+						dark: dark.length === 1 ? substituteRole(dark[0] ?? '', name) : undefined,
+						source: named,
+					})
+				}
+				continue
+			}
+			// A single-value column writes a mode-dependent value as the light reading followed by
+			// the dark one, which is the only place the two modes share one cell.
+			const modes = splitCellSpans(lightText, ', dark ')
+			const split = shaded === undefined && modes.length === 2
+			if (role !== undefined) {
+				const keys = splitCellSpans(keyText, ', ')
+				if (keys.length !== 1) continue
+				const name = keys[0] ?? ''
+				const fill = light.length === 1 ? light[0] : undefined
+				roles.push(name)
+				rows.push({
+					token: `--vn-color-${name}-base`,
+					light: split ? modes[0] : fill,
+					dark: split ? modes[1] : fill,
+					source: named,
+				})
+				continue
+			}
+			const tokens = collectRowTokens(keyText, names)
+			const paired = split && tokens.length === 1
+			for (const [index, token] of tokens.entries()) {
+				const stated = light.length === tokens.length ? light[index] : undefined
+				const retuned = dark.length === tokens.length ? dark[index] : undefined
+				rows.push({
+					token,
+					light: paired ? modes[0] : stated,
+					dark: paired ? modes[1] : retuned,
+					source: named,
+				})
+			}
+		}
+	}
+	return rows
+}
