+
+/**
+ * Reads one table row's named cells as flattened text.
+ *
+ * @param row - The row's cells, in column order.
+ * @param columns - The column indexes to read, as {@link selectTableColumns} returns them.
+ * @returns Each cell's text with its markup flattened and its padding trimmed, so a code span
+ *   reads as the token it wraps.
+ */
+export function readTableCells(
+	row: ReadonlyArray<readonly InlineNode[]>,
+	columns: readonly number[],
+): readonly string[] {
+	return columns.map((column) => (row[column] ?? []).map(flattenText).join('').trim())
