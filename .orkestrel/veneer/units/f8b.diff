+// mandates around it and text content where the tag takes it. Nothing here carries a class or a
+// style of its own, so what the proof reads is the tag's own treatment. The `html` row carries no
+// markup: a document has one root element, and the proof reads that one.
+const NEUTRAL_MARKUP: ReadonlyArray<readonly [tag: string, markup: string]> = Object.freeze([
+	Object.freeze(['a', '<a href="#place">Link</a>'] as const),
+	Object.freeze(['abbr', '<abbr title="Abbreviation">Abbr</abbr>'] as const),
+	Object.freeze(['b', '<b>Bold</b>'] as const),
+	Object.freeze(['button', '<button type="button">Button</button>'] as const),
+	Object.freeze(['code', '<code>code</code>'] as const),
+	Object.freeze(['h1', '<h1>Heading</h1>'] as const),
+	Object.freeze(['h2', '<h2>Heading</h2>'] as const),
+	Object.freeze(['h3', '<h3>Heading</h3>'] as const),
+	Object.freeze(['h4', '<h4>Heading</h4>'] as const),
+	Object.freeze(['h5', '<h5>Heading</h5>'] as const),
+	Object.freeze(['h6', '<h6>Heading</h6>'] as const),
+	Object.freeze(['hr', '<hr>'] as const),
+	Object.freeze(['html', ''] as const),
+	Object.freeze(['iframe', '<iframe title="Frame"></iframe>'] as const),
+	Object.freeze(['img', '<img alt="">'] as const),
+	Object.freeze(['input', '<input>'] as const),
+	Object.freeze(['kbd', '<kbd>Key</kbd>'] as const),
+	Object.freeze(['ol', '<ol><li>Item</li></ol>'] as const),
+	Object.freeze([
+		'optgroup',
+		'<select><optgroup label="Group"><option>Option</option></optgroup></select>',
+	] as const),
+	Object.freeze(['pre', '<pre>preformatted</pre>'] as const),
+	Object.freeze(['progress', '<progress></progress>'] as const),
+	Object.freeze(['samp', '<samp>sample</samp>'] as const),
+	Object.freeze(['select', '<select><option>Option</option></select>'] as const),
+	Object.freeze(['small', '<small>Small</small>'] as const),
+	Object.freeze(['strong', '<strong>Strong</strong>'] as const),
+	Object.freeze(['sub', '<sub>Sub</sub>'] as const),
+	Object.freeze(['summary', '<details><summary>Summary</summary></details>'] as const),
+	Object.freeze(['sup', '<sup>Sup</sup>'] as const),
+	Object.freeze(['svg', '<svg viewBox="0 0 8 8"></svg>'] as const),
+	Object.freeze([
+		'table',
+		'<table><caption>Caption</caption><tbody><tr><td>Cell</td></tr></tbody></table>',
+	] as const),
+	Object.freeze(['textarea', '<textarea></textarea>'] as const),
+	Object.freeze(['ul', '<ul><li>Item</li></ul>'] as const),
+])
+
+afterEach(() => {
+	scene.clear()
+})
+
+describe('the preflight pairing', () => {
+	it('derives the overlapping tags and the properties the reset declares', () => {
+		const sheet = loadSheet(preflightProfile)
+		const reset = collectLayerRules('base', [sheet])
+		// The tags the reset treats are the type selectors of its own style rules. Its universal
+		// rule and its pseudo-element rules name none, which is why the reading is the leading type
+		// selector rather than the selector text.
+		const treated = collectTypeSelectors(
+			reset.flatMap((rule) => (rule instanceof CSSStyleRule ? [rule.selectorText] : [])),
+		)
+		const styled = ELEMENT_TAGS.flatMap(([, tags]) => [...tags])
+		const overlap = treated.filter((tag) => styled.includes(tag))
+		for (const tag of FLOOR_TAGS) expect(overlap).toContain(tag)
+		// The property set is what the comparison walks, so the reset's universal rule contributes
+		// its properties to every element's reading rather than to the elements it names.
+		expect(collectDeclaredProperties(reset)).toContain('tab-size')
+		// The fixture table is held to the derived overlap rather than maintained beside it, so a
+		// tag the reset gains is a tag this proof has to render before it can read anything.
+		expect(overlap.filter((tag) => !NEUTRAL_MARKUP.some(([name]) => name === tag))).toEqual([])
+	})
+
+	it('keeps every property the elements layer declares, and records every property it moves', () => {
+		const cascade = requireValue(readCascadeSheet(), 'The document loaded no Veneer cascade')
+		const elements = collectLayerRules('elements', [cascade])
+		const sheet = loadSheet(preflightProfile)
+		const reset = collectLayerRules('base', [sheet])
+		const properties = collectDeclaredProperties(reset)
+		const overlap = collectTypeSelectors(
+			reset.flatMap((rule) => (rule instanceof CSSStyleRule ? [rule.selectorText] : [])),
+		).filter((tag) => ELEMENT_TAGS.flatMap(([, tags]) => [...tags]).includes(tag))
+		for (const tag of FLOOR_TAGS) expect(overlap).toContain(tag)
+		scene.clear()
+		const measured: string[] = []
+		const kept: string[] = []
+		for (const tag of overlap) {
+			const fixture = requireValue(
+				NEUTRAL_MARKUP.find(([name]) => name === tag),
+				`The fixture table renders no ${tag}`,
+			)
+			const host = scene.mount(fixture[1])
+			const subject =
+				tag === 'html'
+					? document.documentElement
+					: requireValue(host.querySelector(tag), `The fixture rendered no ${tag}`)
+			const standalone = readComputedSnapshot(subject, properties)
+			loadSheet(preflightProfile)
+			const paired = readComputedSnapshot(subject, properties)
+			// Veneer's `elements` layer sits after `base`, so every property Veneer's own reboot
+			// declares for the tag keeps the value the shipped cascade resolves for it. A rule
+			// naming the tag in any of its states counts, because the layer order decides the
+			// question for all of them at once.
+			const declared = elements.flatMap((rule) =>
+				rule instanceof CSSStyleRule && collectTypeSelectors([rule.selectorText]).includes(tag)
+					? Array.from(rule.style)
+					: [],
+			)
+			for (const property of properties) {
+				if (!declared.includes(property)) continue
+				kept.push(`${tag} | ${property}`)
+				expect(`${tag} | ${property} | ${String(paired.get(property))}`).toBe(
+					`${tag} | ${property} | ${String(standalone.get(property))}`,
+				)
+			}
+			for (const [property, value] of standalone) {
+				const resolved = paired.get(property)
+				if (resolved !== value)
+					measured.push(`${tag} | ${property} | ${value} | ${String(resolved)}`)
+			}
+			scene.clear()
+		}
+		// A run whose comparison read nothing at all would report no move and no kept property, and
+		// pass every reading taken over either list.
+		expect(kept).toContain('hr | border-top-style')
+		expect(measured).toContain('html | tab-size | 8 | 4')
+		// Every move is a row of the guide's table, and every row is a move. The comparison is the
+		// whole population both ways, so a move the guide does not record and a row the pairing no
+		// longer produces each redden.
+		const recorded = readPreflightDepartures(guideSource)
+			.map((row) => `${row.tag} | ${row.property} | ${row.standalone} | ${row.preflight}`)
+			.sort()
+		expect([...measured].sort()).toEqual(recorded)
+		// The comparison is only worth something if it can see either kind of drift, so both are
+		// planted here against the rows the guide actually states.
+		expect([...measured].sort()).not.toEqual(recorded.slice(1))
+		expect([...measured].sort()).not.toEqual([...recorded, 'a | tab-size | 8 | 2'].sort())
+	})
+})
