+	const tags: string[] = []
+	for (const selector of selectors) {
+		for (const complex of splitTopLevelList(selector)) {
+			const identifier = readIdentifier(walkSelector(complex), 0)
+			if (identifier !== undefined && !tags.includes(identifier.text)) tags.push(identifier.text)
+		}
+	}
