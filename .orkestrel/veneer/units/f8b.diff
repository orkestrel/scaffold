+					position,
+					new Map([
+						['Tag', tag ?? ''],
+						['Property', property ?? ''],
+						['Standalone', standalone ?? ''],
+						['Preflight', preflight ?? ''],
+					]),
+				),
+			)
+		}
+		rows.push({ tag, property, standalone, preflight })
+	}
+	return rows
+}
