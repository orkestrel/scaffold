+ * columns rather than by its position. Several such tables are refused rather than concatenated:
+ * a proof holding the recorded pairs equal to the measured ones cannot tell a second table from a
+ * first one that grew, and a split record is how a departure hides.
+ */
+export function readPreflightDepartures(source: string): readonly PreflightDeparture[] {
+	const headers = ['Tag', 'Property', 'Standalone', 'Preflight']
+	const subject = 'Preflight departure'
+	const tables = selectSubsectionTables(source, 'Styles', 'Tailwind', subject).filter((table) =>
+		headers.every((header) => findColumnIndex(table, header) !== undefined),
+	)
+	const [table] = tables
+	if (table === undefined) throw new Error(`${subject} row <header>: missing table`)
+	if (tables.length > 1)
+		throw new Error(`${subject} row <header>: several tables state the columns`)
+	if (table.rows.length === 0) throw new Error(`${subject} row <header>: the table states no row`)
