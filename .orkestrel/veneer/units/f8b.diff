+
+/**
+ * Locates each named column of one guide table.
+ *
+ * @param table - The table to read.
+ * @param headers - The required column headers, in the order the reader takes their cells.
+ * @param subject - The ledger name each refusal names.
+ * @returns Each header's column index, in the order the headers were named.
+ * @throws When the table carries no column of one of those headers.
+ */
+export function selectTableColumns(
+	table: TableNode,
+	headers: readonly string[],
+	subject: string,
+): readonly number[] {
+	return headers.map((header) => {
+		const index = findColumnIndex(table, header)
+		if (index === undefined) throw new Error(`${subject} row <header>: missing ${header} column`)
+		return index
+	})
