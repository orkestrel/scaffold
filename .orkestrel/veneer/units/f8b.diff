+ * @returns Each matching block's verbatim content in document order, without its fences.
+ *
+ * @remarks
+ * The blocks are read through the installed Markdown parser rather than by splitting the document
+ * on its fence marks, so a fence inside another block and an info string carrying more than the
+ * language are the parser's question rather than this reader's. A proof holding a recipe in the
+ * guide equal to the file that executes it compares the block this returns, so prose naming the
+ * same directive is outside the comparison.
+ */
+export function collectFencedBlocks(source: string, language: string): readonly string[] {
+	const blocks: string[] = []
+	for (const node of createMarkdown(source).walk()) {
+		if (node.element === 'codeBlock' && node.lang === language) blocks.push(node.code)
+	}
+	return blocks
