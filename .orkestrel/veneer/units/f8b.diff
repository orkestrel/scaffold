@@ -1547,6 +1547,89 @@ export function collectClassNames(
 	return names
 }
 
+/**
+ * Collects the class names two groups of stylesheets both declare rules for.
+ *
+ * @param sheets - The stylesheets whose order the reading is reported in, such as the compiled
+ *   Tailwind instrument's.
+ * @param others - The stylesheets the first group's names are held against, such as the shipped
+ *   cascade's.
+ * @returns Each name {@link collectClassNames} reads from both groups, in the first group's
+ *   declaration order.
+ *
+ * @remarks
+ * This is the shared-name population the Tailwind pairing rules are written about: a name Veneer
+ * declares that Tailwind also generates. It is derived from what each side actually declares
+ * rather than written down, so a name a release ships joins it without anyone refreshing a list,
+ * and a proof asserting a floor of known members is what keeps a derivation that found nothing
+ * from reading as a clean result.
+ *
+ * A name one side declares only inside a selector the other never writes is still shared, because
+ * the population is names rather than rules: the question a pairing asks is which declaration a
+ * page carrying that class resolves to.
+ */
+export function collectSharedNames(
+	sheets: Iterable<CSSStyleSheet>,
+	others: Iterable<CSSStyleSheet>,
+): readonly string[] {
+	const declared = collectClassNames(others)
+	return collectClassNames(sheets).filter((name) => declared.includes(name))
+}
+
+/**
+ * Collects the properties a rule list's style rules declare, apart from custom properties.
+ *
+ * @param rules - The rules to read, such as the ones {@link collectLayerRules} returns for a
+ *   layer block.
+ * @returns Each declared property name, in declaration order, reported once at its first
+ *   position.
+ *
+ * @remarks
+ * {@link collectCustomProperties} answers the neighbouring question about a whole document's
+ * custom properties. This takes a rule list and leaves the custom ones out, because the population
+ * a reset comparison walks is the properties a computed style resolves for an element: a custom
+ * property carries no computed longhand of its own to compare.
+ *
+ * A grouping rule contributes nothing itself, so a list that carries a media query alongside its
+ * children reports each child's properties once.
+ */
+export function collectDeclaredProperties(rules: Iterable<CSSRule>): readonly string[] {
+	const names: string[] = []
+	for (const rule of rules) {
+		if (!(rule instanceof CSSStyleRule)) continue
+		for (const property of rule.style) {
+			if (!property.startsWith('--') && !names.includes(property)) names.push(property)
+		}
+	}
+	return names
+}
+
+/**
+ * Reads one element's resolved values as a map a later reading is compared against.
+ *
+ * @param element - The element to read, mounted and laid out.
+ * @param properties - The property names to read. Every non-custom property the computed style
+ *   enumerates is the default, which is the widest reading a comparison can take.
+ * @returns Each named property's resolved value, keyed by the property.
+ *
+ * @remarks
+ * The map is taken rather than the live `CSSStyleDeclaration` object, because that object reports
+ * the element's current state on every read: a reading taken before a stylesheet loads and
+ * compared with one taken after would compare the same values with themselves. Copying the values
+ * out is what makes the before-and-after comparison a comparison.
+ *
+ * A custom property is left out of the default population, because a computed style enumerates
+ * only the ones the element resolves and the comparison is about the longhands a reset moves.
+ */
+export function readComputedSnapshot(
+	element: Element,
+	properties?: readonly string[],
+): ReadonlyMap<string, string> {
+	const computed = getComputedStyle(element)
+	const names = properties ?? Array.from(computed).filter((name) => !name.startsWith('--'))
+	return new Map(names.map((name) => [name, computed.getPropertyValue(name)]))
+}
