+export interface PreflightDeparture {
+	/** Holds the tag the row's first cell names. */
+	readonly tag: string
+	/** Holds the property whose computed value the row records. */
+	readonly property: string
+	/** Holds the value the standalone document resolves for that pair. */
+	readonly standalone: string
+	/** Holds the value the preflight profile resolves for it. */
+	readonly preflight: string
+}
+
+/**
+ * Reads the preflight departure table from the guide's Tailwind subsection.
+ *
+ * @param source - The Markdown document's text.
+ * @returns Each recorded pair in document order.
+ * @throws When the subsection carries no table of those columns, carries several, states no row,
+ *   or writes a row with a cell missing.
+ *
+ * @remarks
