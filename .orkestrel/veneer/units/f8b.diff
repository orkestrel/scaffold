+// The guide's table and fence projections, shared by the Node ledger readers in
+// `tests/setupServer.ts` and by the browser proofs that read the guide through a `?raw` import.
+// Each one takes text or a parsed node and names no path, so the file reading stays with the
+// caller that has a filesystem.
+
+/**
+ * Describes a ledger row that leaves a required cell empty.
+ *
+ * @param subject - The ledger the row belongs to, such as `Compatibility` or `Deferral`.
+ * @param index - The row's position in its own table, counted from zero.
+ * @param cells - Each required column's header and the text the row put under it, in column
+ *   order.
+ * @returns The refusal message, naming the row by its one-based position and by the first column
+ *   it did fill.
+ *
+ * @remarks
+ * The cell a row omits can be the one that identifies it, so a label built from that cell alone
+ * reads as a refusal of a row the table does not have. The position names the row whatever it
+ * omitted, and the first filled column says which cell the reader did get. Naming the column
+ * beside the cell is what keeps `btn` from reading as the missing obligation.
+ *
+ * @example
+ * ```ts
+ * describeIncompleteRow('Compatibility', 2, new Map([['Component', 'btn'], ['Obligation', '']]))
+ * // 'Compatibility row 3 (Component: btn): missing required cell'
+ * ```
+ */
+export function describeIncompleteRow(
+	subject: string,
+	index: number,
+	cells: ReadonlyMap<string, string>,
+): string {
+	const filled = [...cells].find(([, text]) => text !== '')
+	const named = filled === undefined ? '' : ` (${filled[0]}: ${filled[1]})`
+	return `${subject} row ${String(index + 1)}${named}: missing required cell`
+}
+
+/**
+ * Selects the tables written under one level-3 subsection of a guide section.
+ *
+ * @param source - The Markdown document's text.
+ * @param section - The level-2 section holding the subsection.
+ * @param subsection - The level-3 heading whose tables the caller reads.
+ * @param subject - The ledger name each refusal names, such as `Deferral` or `Departure`.
+ * @returns Every table between that heading and the next level-3 heading, in document order.
+ * @throws When the subsection is missing, or carries no table.
+ *
+ * @remarks
+ * The walk stops at the following level-3 heading, so a table under another subsection of the same
+ * section belongs to that subsection alone and a second table of the same title elsewhere in the
+ * guide is not read.
+ */
+export function selectSubsectionTables(
+	source: string,
+	section: string,
+	subsection: string,
+	subject: string,
+): readonly TableNode[] {
+	const tables: TableNode[] = []
+	let active = false
+	let found = false
+	for (const block of selectSectionBlocks(createMarkdown(source).document, section)) {
+		if (block.element === 'heading' && block.level === 3) {
+			if (active) break
+			active = flattenText(block).trim() === subsection
+			if (active) found = true
+			continue
+		}
+		if (active && block.element === 'table') tables.push(block)
+	}
+	if (!found)
+		throw new Error(`${subject} row <header>: missing ${section} / ${subsection} subsection`)
+	if (tables.length === 0) throw new Error(`${subject} row <header>: missing table`)
+	return tables
