--- /dev/null
+++ b/tests/tailwind/shared.test.ts
@@ -0,0 +1,250 @@
+import { requireValue } from '@orkestrel/test'
+import { afterEach, describe, expect, it } from 'vitest'
+import {
+	collectClassNames,
+	collectInlineSources,
+	collectLayerOrder,
+	collectLayerRules,
+	collectSharedNames,
+	collectSheetRules,
+	loadSheet,
+	readCascadeSheet,
+	readComputedSnapshot,
+	scene,
+} from '../setupBrowser.js'
+import { collectFencedBlocks } from '../setupStyles.js'
+import guideSource from '../../guides/veneer.md?raw'
+import consumerProfile from '../fixtures/tailwind/consumer.css?inline'
+import consumerSource from '../fixtures/tailwind/consumer.css?raw'
+import consumerMarkup from '../fixtures/tailwind/markup.html?raw'
+import unexcludedInstrument from '../fixtures/tailwind/unexcluded.css?inline'
+
+// The names the shared derivation has to reach before its silence means anything. A derivation
+// that read an empty stylesheet returns nothing, which satisfies every membership reading taken
+// over it, so these are asserted present before the set is used for anything else.
+const FLOOR_NAMES = ['container', 'table', 'col-1', 'caption-top', 'caption-bottom']
+
+// The line the executed profile changes, and the line the shipped recipe writes in its place. A
+// consumer names their own markup directory here; the fixture names the markup file beside it.
+const EXECUTED_SOURCE = "@source './markup.html';"
+const SHIPPED_SOURCE = "@source './src';"
+
+afterEach(() => {
+	scene.clear()
+})
+
+describe('the consumer pairing', () => {
+	it('executes the recipe the guide ships, apart from the markup line each one names', () => {
+		// The guide writes both recipes as `css` fences, and the composable imports are what tells
+		// them apart: the `preflight` recipe takes the bare import instead. Reading the fences
+		// through the Markdown parser rather than splitting the document on its fence marks is what
+		// keeps prose naming the same directive outside the comparison.
+		const recipes = collectFencedBlocks(guideSource, 'css').filter((block) =>
+			block.includes("@import 'tailwindcss/theme.css'"),
+		)
+		expect(recipes).toHaveLength(1)
+		const recipe = requireValue(recipes[0], 'The guide writes no tailwind recipe')
+		expect(recipe.split('\n').filter((line) => line.startsWith("@source '"))).toEqual([
+			SHIPPED_SOURCE,
+		])
+		expect(consumerSource.split('\n').filter((line) => line.startsWith("@source '"))).toEqual([
+			EXECUTED_SOURCE,
+		])
+		// Every other line is the shipped text, so a recipe edited in the guide and not in the file
+		// the project compiles reddens here rather than shipping an untried recipe.
+		expect(
+			consumerSource
+				.trimEnd()
+				.split('\n')
+				.filter((line) => line !== EXECUTED_SOURCE),
+		).toEqual(
+			recipe
+				.trimEnd()
+				.split('\n')
+				.filter((line) => line !== SHIPPED_SOURCE),
+		)
+	})
+
+	it('resolves the cascade import, and declares the order the cascade puts the document in', () => {
+		// The document carries the shipped cascade alone at this point, so its own layer order is
+		// the reading the compiled profile is held against.
+		const placed = collectLayerOrder()
+		const sheet = loadSheet(consumerProfile)
+		// Tailwind declares its generated properties layer ahead of the order line the entry wrote,
+		// and leaves the entry's own names in their declared order behind it.
+		expect(collectLayerOrder([sheet])).toEqual(['properties', ...placed])
+		// The import resolved through the manifest's stylesheet subpath: the compiled profile
+		// carries Veneer's own token namespace inside its `theme` block, which is the signature
+		// `readCascadeSheet` selects a Veneer cascade by, and the component rules behind it.
+		expect(readCascadeSheet([sheet])).toBe(sheet)
+		const components = collectLayerRules('components', [sheet]).flatMap((rule) =>
+			rule instanceof CSSStyleRule ? [rule.selectorText] : [],
+		)
+		expect(components).toContain('.btn')
+		// The markup the `@source` line names was scanned: the control utility the fixture's button
+		// carries is generated, and it is a name the cascade declares no rule for.
+		const utilities = collectLayerRules('utilities', [sheet]).flatMap((rule) =>
+			rule instanceof CSSStyleRule ? [rule.selectorText] : [],
+		)
+		expect(utilities).toContain('.px-8')
+	})
+
+	it('derives the shared class names, and mounts an element for every one of them', () => {
+		const cascade = requireValue(readCascadeSheet(), 'The document loaded no Veneer cascade')
+		// The instrument is the profile without its exclusion line, so what it emits is what
+		// Tailwind generates for the candidate names the built cascade declares. The shared set is
+		// what both sides declare, derived per run rather than written down.
+		const instrument = loadSheet(unexcludedInstrument)
+		const shared = collectSharedNames([instrument], [cascade])
+		for (const name of FLOOR_NAMES) expect(shared).toContain(name)
+		// The exclusion line names exactly the shared names Veneer declares normally. A name whose
+		// Veneer declaration is important wins by importance in any layer order and leaves the
+		// line; a name Veneer declares normally has to be on it.
+		const importantRules = collectSheetRules([cascade]).flatMap((rule) =>
+			rule instanceof CSSStyleRule &&
+			Array.from(rule.style).some(
+				(property) => rule.style.getPropertyPriority(property) === 'important',
+			)
+				? [rule.cssText]
+				: [],
+		)
+		const important = collectClassNames([loadSheet(importantRules.join('\n'))])
+		const [exclusion] = collectInlineSources(consumerSource).filter((source) => source.excluded)
+		const excluded = requireValue(
+			exclusion,
+			'The consumer profile declares no exclusion line',
+		).names
+		expect([...excluded].sort()).toEqual(shared.filter((name) => !important.includes(name)).sort())
+		// The fixture is held to the derived set rather than maintained beside it, so a name the
+		// set gains is a name the markup has to carry before this proof can read anything about it.
+		const host = scene.mount(consumerMarkup)
+		expect(
+			shared.filter((name) => host.querySelectorAll(`.${CSS.escape(name)}`).length === 0),
+		).toEqual([])
+	})
+
+	it('leaves every shared name resolving to the declaration the cascade ships', () => {
+		const cascade = requireValue(readCascadeSheet(), 'The document loaded no Veneer cascade')
+		const instrument = loadSheet(unexcludedInstrument)
+		const shared = collectSharedNames([instrument], [cascade])
+		for (const name of FLOOR_NAMES) expect(shared).toContain(name)
+		// The instrument goes back off the page before the reading, so the standalone snapshot is
+		// the shipped cascade alone resolving the fixture.
+		scene.clear()
+		const host = scene.mount(consumerMarkup)
+		const subjects = shared.flatMap((name) =>
+			Array.from(host.querySelectorAll(`.${CSS.escape(name)}`), (element) => ({
+				name,
+				element,
+			})),
+		)
+		expect(subjects).not.toEqual([])
+		const standalone = subjects.map((subject) => readComputedSnapshot(subject.element))
+		loadSheet(consumerProfile)
+		// Every longhand the computed style enumerates is compared, so a Tailwind rule reaching one
+		// of these elements reports whatever it declares rather than only the properties a reader
+		// thought to name.
+		expect(
+			subjects.flatMap((subject, index) => {
+				const after = readComputedSnapshot(subject.element)
+				return Array.from(requireValue(standalone[index], 'The snapshot was never taken')).flatMap(
+					([property, value]) =>
+						after.get(property) === value
+							? []
+							: [`${subject.name} ${property}: ${value} became ${String(after.get(property))}`],
+				)
+			}),
+		).toEqual([])
+	})
+
+	it('keeps an important shared declaration whatever the recipe withholds', () => {
+		const cascade = requireValue(readCascadeSheet(), 'The document loaded no Veneer cascade')
+		const instrument = loadSheet(unexcludedInstrument)
+		const shared = collectSharedNames([instrument], [cascade])
+		scene.clear()
+		const host = scene.mount(consumerMarkup)
+		// This is the other half of the shared-name rule: a name Veneer declares with `!important`
+		// wins by importance in any layer order, so the recipe need not withhold it. Every shared
+		// name the cascade ships today is a normal declaration, so the plant is what drives the
+		// branch — one important declaration for a shared name, which is what a release shipping
+		// such a name would land in a layer of its own.
+		const planted = loadSheet('@layer components { .col-1 { grid-column-start: 5 !important } }')
+		const importantRules = collectSheetRules([cascade, planted]).flatMap((rule) =>
+			rule instanceof CSSStyleRule &&
+			Array.from(rule.style).some(
+				(property) => rule.style.getPropertyPriority(property) === 'important',
+			)
+				? [rule.cssText]
+				: [],
+		)
+		const important = collectClassNames([loadSheet(importantRules.join('\n'))])
+		const branch = shared.filter((name) => important.includes(name))
+		expect(branch).toContain('col-1')
+		const subjects = branch.flatMap((name) =>
+			Array.from(host.querySelectorAll(`.${CSS.escape(name)}`)),
+		)
+		expect(subjects).not.toEqual([])
+		const standalone = subjects.map((element) => readComputedSnapshot(element))
+		// The instrument is the recipe with its exclusion line dropped, so Tailwind's own rule for
+		// each of these names is on the page and loses to the important declaration anyway.
+		loadSheet(unexcludedInstrument)
+		expect(
+			subjects.flatMap((element, index) => {
+				const after = readComputedSnapshot(element)
+				return Array.from(requireValue(standalone[index], 'The snapshot was never taken')).flatMap(
+					([property, value]) =>
+						after.get(property) === value
+							? []
+							: [`${property}: ${value} became ${String(after.get(property))}`],
+				)
+			}),
+		).toEqual([])
+	})
+
+	it('moves a shared name when the exclusion line is dropped', () => {
+		// The equality the preceding case reads is only worth something if the reading can see a
+		// Tailwind rule winning, and the instrument is the same profile without the one line that
+		// withholds the shared names. The floor is the pair it moves on the fixture's first column.
+		const host = scene.mount(consumerMarkup)
+		const column = requireValue(host.querySelector('.col-1'), 'The fixture mounts no col-1')
+		const standalone = readComputedSnapshot(column)
+		loadSheet(unexcludedInstrument)
+		const after = readComputedSnapshot(column)
+		expect(
+			Array.from(standalone).flatMap(([property, value]) =>
+				after.get(property) === value
+					? []
+					: [`${property}: ${value} became ${String(after.get(property))}`],
+			),
+		).toContain('grid-column-start: auto became 1')
+	})
+
+	it('overrides a component declaration with a utility Tailwind alone generates', () => {
+		const host = scene.mount(consumerMarkup)
+		const button = requireValue(host.querySelector('.btn'), 'The fixture mounts no button')
+		const standalone = readComputedSnapshot(button, ['padding-left', 'padding-right'])
+		const sheet = loadSheet(consumerProfile)
+		const [generated] = collectLayerRules('utilities', [sheet]).flatMap((rule) =>
+			rule instanceof CSSStyleRule && rule.selectorText === '.px-8' ? [rule] : [],
+		)
+		const declared = requireValue(generated, 'The consumer sheet generates no px-8 rule').style
+		// The value is read from the rule the compiler wrote and resolved in this document, rather
+		// than written here: `px-8` is eight steps of Tailwind's own spacing variable, and a theme
+		// that moves that variable moves this reading with it.
+		expect(declared.cssText).toContain('--spacing')
+		const probe = scene.mount('')
+		probe.style.cssText = declared.cssText
+		const resolved = requireValue(
+			readComputedSnapshot(probe, ['padding-left']).get('padding-left'),
+			'The probe resolved no padding',
+		)
+		const overridden = readComputedSnapshot(button, ['padding-left', 'padding-right'])
+		expect([overridden.get('padding-left'), overridden.get('padding-right')]).toEqual([
+			resolved,
+			resolved,
+		])
+		// The component's own padding is what the utility had to beat, and the order line is what
+		// lets it: `utilities` sits after `components`.
+		expect(standalone.get('padding-left')).not.toBe(resolved)
+	})
+})
