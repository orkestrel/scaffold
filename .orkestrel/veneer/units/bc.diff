diff --git a/app/browser/sections/CardSection.ts b/app/browser/sections/CardSection.ts
new file mode 100644
index 0000000..b8be7ea
--- /dev/null
+++ b/app/browser/sections/CardSection.ts
@@ -0,0 +1,20 @@
+import { CARD_COPY, CARD_SPECIMENS } from '../constants.js'
+import { SpecimenSection } from './SpecimenSection.js'
+
+/**
+ * Renders the declared card specimens into a named region.
+ * @example
+ * ```ts
+ * const section = new CardSection(document.body)
+ * section.destroy()
+ * ```
+ */
+export class CardSection extends SpecimenSection {
+	/**
+	 * Mounts the Card region and its specimens.
+	 * @param host - The element receiving the section.
+	 */
+	constructor(host: HTMLElement) {
+		super(host, CARD_COPY, CARD_SPECIMENS)
+	}
+}
