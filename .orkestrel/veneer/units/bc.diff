+import type { SectionInterface } from '@app/browser'
+import {
+	LIST_GROUP_COPY,
+	LIST_GROUP_SPECIMENS,
+	ListGroupSection,
+	SpecimenSection,
+} from '@app/browser'
+import { requireValue } from '@orkestrel/test'
+import { build, mount } from '@orkestrel/test/browser'
+import { describe, expect, it } from 'vitest'
+
+describe('ListGroupSection', () => {
+	it('renders the structural families, the horizontal ramp, and the contextual roles', () => {
+		const host = mount(build('div'))
+		const section: SectionInterface = new ListGroupSection(host)
+		try {
+			expect(section).toBeInstanceOf(SpecimenSection)
+			expect(section.host).toBe(host)
+			const region = requireValue(host.querySelector('section'), 'No List group region')
+			expect(region.querySelector('[style]')).toBeNull()
+			expect(region.getAttribute('aria-label')).toBe('List group')
+			expect(region.querySelector('p')?.textContent).toBe(LIST_GROUP_COPY.paragraph)
+			const rendered = [...region.querySelectorAll('[data-specimen]')]
+			expect(rendered.map((element) => element.getAttribute('data-specimen'))).toEqual([
+				'List group base',
+				'List group active',
+				'List group disabled',
+				'List group actions',
+				'List group numbered',
+				'List group flush',
+				'List group horizontal',
+				'List group horizontal sm',
+				'List group horizontal md',
+				'List group horizontal lg',
+				'List group horizontal xl',
+				'List group horizontal xxl',
+				'List group roles',
+			])
+			expect(rendered.map((element) => element.innerHTML)).toEqual(
+				LIST_GROUP_SPECIMENS.map(({ markup }) => markup),
+			)
+			for (const name of [
+				'list-group',
+				'list-group-item',
+				'list-group-item-action',
+				'list-group-numbered',
+				'list-group-flush',
+				'list-group-horizontal',
+				'list-group-horizontal-sm',
+				'list-group-horizontal-md',
+				'list-group-horizontal-lg',
+				'list-group-horizontal-xl',
+				'list-group-horizontal-xxl',
+			])
+				expect(region.querySelector(`.${name}`)).not.toBeNull()
+			for (const role of [
+				'primary',
+				'secondary',
+				'success',
+				'info',
+				'warning',
+				'danger',
+				'light',
+				'dark',
+			])
+				expect(region.querySelector(`.list-group-item-${role}`)).not.toBeNull()
+			// The three states the cascade paints each reach a rendered host, and the action
+			// specimen carries an anchor host and a button host so both hosts reach the rules.
+			expect(region.querySelector('.list-group-item.active')).not.toBeNull()
+			expect(region.querySelector('.list-group-item.disabled')).not.toBeNull()
+			expect(region.querySelector('.list-group-item:disabled')).not.toBeNull()
+			const actions = requireValue(
+				region.querySelector('[data-specimen="List group actions"]'),
+				'No action specimen',
+			)
+			expect(actions.querySelector('a.list-group-item-action')).not.toBeNull()
+			expect(actions.querySelector('button.list-group-item-action')).not.toBeNull()
+			// The invented role is absent, because Veneer's own `tertiary` names no released
+			// variant and the section renders the released set alone.
+			expect(region.querySelector('.list-group-item-tertiary')).toBeNull()
+			expect(Object.isFrozen(LIST_GROUP_COPY)).toBe(true)
+			expect(Object.isFrozen(LIST_GROUP_SPECIMENS)).toBe(true)
+			expect(LIST_GROUP_SPECIMENS.every((entry) => Object.isFrozen(entry))).toBe(true)
+		} finally {
+			section.destroy()
+			host.remove()
+		}
+	})
+	it('releases the region and preserves adjacent content on repeated destruction', () => {
+		const host = mount(build('div'))
+		const neighbor = build('p', { text: 'Existing content' })
+		host.append(neighbor)
+		const section: SectionInterface = new ListGroupSection(host)
+		try {
+			const region = requireValue(host.querySelector('section'), 'No List group region')
+			expect(region.isConnected).toBe(true)
+			section.destroy()
+			expect(region.isConnected).toBe(false)
+			section.destroy()
+			expect([...host.children]).toEqual([neighbor])
+		} finally {
+			section.destroy()
+			host.remove()
+		}
+	})
+})
