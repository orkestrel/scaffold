diff --git a/tests/app/browser/sections/CardSection.test.ts b/tests/app/browser/sections/CardSection.test.ts
new file mode 100644
index 0000000..654c508
--- /dev/null
+++ b/tests/app/browser/sections/CardSection.test.ts
@@ -0,0 +1,86 @@
+import type { SectionInterface } from '@app/browser'
+import { CARD_COPY, CARD_SPECIMENS, CardSection, SpecimenSection } from '@app/browser'
+import { requireValue } from '@orkestrel/test'
+import { build, mount } from '@orkestrel/test/browser'
+import { describe, expect, it } from 'vitest'
+
+describe('CardSection', () => {
+	it('renders one specimen per recorded card family through the shared section contract', () => {
+		const host = mount(build('div'))
+		const section: SectionInterface = new CardSection(host)
+		try {
+			expect(section).toBeInstanceOf(SpecimenSection)
+			expect(section.host).toBe(host)
+			const region = requireValue(host.querySelector('section'), 'No Card region')
+			expect(region.querySelector('[style]')).toBeNull()
+			expect(region.getAttribute('aria-label')).toBe('Card')
+			expect(region.querySelector('p')?.textContent).toBe(CARD_COPY.paragraph)
+			const rendered = [...region.querySelectorAll('[data-specimen]')]
+			expect(rendered.map((element) => element.getAttribute('data-specimen'))).toEqual([
+				'Card base',
+				'Card rule',
+				'Card images',
+				'Card overlay',
+				'Card list',
+				'Card tabs',
+				'Card pills',
+				'Card group',
+			])
+			expect(rendered.map((element) => element.innerHTML)).toEqual(
+				CARD_SPECIMENS.map(({ markup }) => markup),
+			)
+			// Every class the released card vocabulary names reaches the region, so a specimen table
+			// that stopped rendering a family reddens here rather than in the portfolio.
+			for (const name of [
+				'card',
+				'card-header',
+				'card-body',
+				'card-title',
+				'card-subtitle',
+				'card-text',
+				'card-link',
+				'card-footer',
+				'card-img-top',
+				'card-img-bottom',
+				'card-img',
+				'card-img-overlay',
+				'card-header-tabs',
+				'card-header-pills',
+				'card-group',
+			])
+				expect(region.querySelector(`.${name}`)).not.toBeNull()
+			expect(region.querySelector('.card > hr')).not.toBeNull()
+			expect(region.querySelector('.card > .list-group')).not.toBeNull()
+			expect(region.querySelector('.card-header-tabs .nav-link.active')).not.toBeNull()
+			// Each image carries an inline data source and an alternative text, so the portfolio
+			// photographs a painted box rather than a broken-image placeholder.
+			for (const image of region.querySelectorAll('img')) {
+				expect(image.getAttribute('src')).toContain('data:image/svg+xml,')
+				expect(image.getAttribute('alt')).not.toBe('')
+			}
+			expect(Object.isFrozen(CARD_COPY)).toBe(true)
+			expect(Object.isFrozen(CARD_SPECIMENS)).toBe(true)
+			expect(CARD_SPECIMENS.every((entry) => Object.isFrozen(entry))).toBe(true)
+		} finally {
+			section.destroy()
+			host.remove()
+		}
+	})
+	it('releases the region and preserves adjacent content on repeated destruction', () => {
+		const host = mount(build('div'))
+		const neighbor = build('p', { text: 'Existing content' })
+		host.append(neighbor)
+		const section: SectionInterface = new CardSection(host)
+		try {
+			const region = requireValue(host.querySelector('section'), 'No Card region')
+			expect(region.isConnected).toBe(true)
+			section.destroy()
+			expect(region.isConnected).toBe(false)
+			section.destroy()
+			expect([...host.children]).toEqual([neighbor])
+		} finally {
+			section.destroy()
+			host.remove()
+		}
+	})
+})
