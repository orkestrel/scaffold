@@ -0,0 +1,16 @@
+@use '../mixins' as *;
+
+@layer utilities {
+	// The release's entry carries no class, so each value's key is the whole class name.
+	@include breakpoint-each using ($infix, $_boundary) {
+		@include utility(
+			'',
+			visibility,
+			(
+				visible: visible,
+				invisible: hidden,
+			),
+			$infix
+		);
+	}
+}
diff --git a/home/user/veneer-upl/src/styles/utilities/_visually-hidden.scss b/home/user/veneer-upl/src/styles/utilities/_visually-hidden.scss
new file mode 100644
index 0000000..6f8dc0b
--- /dev/null
+++ b/home/user/veneer-upl/src/styles/utilities/_visually-hidden.scss
@@ -0,0 +1,29 @@
+@layer utilities {
+	// The release writes this helper with `!important` on every declaration, so it sits in the
+	// utilities layer ahead of every utility partial: an important declaration in an earlier layer
+	// beats one in a later layer, and in the components layer this rule would beat every utility the
+	// release lets win over it, such as `.w-100`. It is a helper rather than a utility entry, and each
+	// declaration carries its own value, so it is written here rather than through the `utility`
+	// mixin. The focusable form hides the element only while neither it nor a descendant holds focus.
+	.visually-hidden,
+	.visually-hidden-focusable:not(:focus):not(:focus-within) {
+		width: 1px !important;
+		height: 1px !important;
+		padding: 0 !important;
+		margin: -1px !important;
+		overflow: hidden !important;
+		clip: rect(0, 0, 0, 0) !important;
+		white-space: nowrap !important;
+		border: 0 !important;
+
+		// A positioned caption can become an anonymous table cell, so the caption keeps its position.
+		&:not(caption) {
+			position: absolute !important;
+		}
+
+		// A child overflowing the clipped box would stay focusable where it paints.
+		* {
+			overflow: hidden !important;
+		}
+	}
+}
diff --git a/home/user/veneer-upl/tests/app/browser/sections/PositionSection.test.ts b/home/user/veneer-upl/tests/app/browser/sections/PositionSection.test.ts
new file mode 100644
index 0000000..eaccce6
--- /dev/null
+++ b/home/user/veneer-upl/tests/app/browser/sections/PositionSection.test.ts
@@ -0,0 +1,242 @@
+import type { SectionInterface } from '@app/browser'
+import { POSITION_COPY, POSITION_SPECIMENS, PositionSection, SpecimenSection } from '@app/browser'
+import { requireValue } from '@orkestrel/test'
+import { build, mount, readPixels, readStyle } from '@orkestrel/test/browser'
+import { beforeAll, describe, expect, it } from 'vitest'
+import { visitBreakpoint } from '../../../setupBrowser.js'
+import { STACK_LEVEL_CASES, VIEWPORT_WIDTHS } from '../../../setupStyles.js'
+
+// The frame and geometry cases read the specimens as the published cascade and the shell lay them
+// out, so both stylesheets have to be in the document before a box is measured.
+beforeAll(async () => {
+	await import('../../../../src/styles/index.scss')
+	await import('../../../../app/browser/styles/index.scss')
+})
+
+describe('PositionSection', () => {
+	it('renders every declared specimen inside a frame through the shared section contract', () => {
+		const host = mount(build('div'))
+		const section: SectionInterface = new PositionSection(host)
+		try {
+			expect(section).toBeInstanceOf(SpecimenSection)
+			expect(section.host).toBe(host)
+			const region = requireValue(host.querySelector('section'), 'No Position region')
+			expect(region.getAttribute('aria-label')).toBe('Position')
+			expect(region.querySelector('p')?.textContent).toBe(POSITION_COPY.paragraph)
+			const rendered = [...region.querySelectorAll('[data-specimen]')]
+			expect(rendered.map((element) => element.getAttribute('data-specimen'))).toEqual([
+				'Position values',
+				'Edge offsets',
+				'Centered translation',
+				'Stacking levels',
+				'Fixed bars',
+				'Sticky bars',
+			])
+			expect(rendered.map((element) => element.innerHTML)).toEqual(
+				POSITION_SPECIMENS.map((specimen) => specimen.markup),
+			)
+			// A fixed or sticky element is placed against its containing block or its scroll
+			// container, so every specimen opens with the shell's frame, and the sticky bars scroll
+			// inside the shell's box within it rather than inside the frame, which clips.
+			for (const element of rendered)
+				expect(element.firstElementChild?.classList.contains('viewport')).toBe(true)
+			// Every selector names a composition the specimens render, so the list of misses is empty.
+			expect(
+				[
+					'[data-specimen="Position values"] .position-static',
+					'[data-specimen="Position values"] .position-relative.start-50',
+					'[data-specimen="Position values"] .position-sticky.top-0',
+					'[data-specimen="Position values"] .position-absolute.bottom-0.end-0',
+					'[data-specimen="Position values"] .position-fixed.top-0.end-0',
+					'[data-specimen="Edge offsets"] .translate-middle > .top-100.start-100 + .bottom-100.end-100',
+					'[data-specimen="Centered translation"] .top-50.start-50.translate-middle',
+					'[data-specimen="Centered translation"] .top-0.start-50.translate-middle-x',
+					'[data-specimen="Centered translation"] .top-50.start-0.translate-middle-y',
+					'[data-specimen="Fixed bars"] .viewport > .card.fixed-top + p + .card.fixed-bottom',
+					'[data-specimen="Sticky bars"] .viewport > .scroller > .card.sticky-top + .vh-100 + .card.sticky-bottom',
+				].filter((selector) => region.querySelector(selector) === null),
+			).toEqual([])
+			expect(
+				[...region.querySelectorAll('[data-specimen="Stacking levels"] .card')].map((card) =>
+					[...card.classList].find((name) => name.startsWith('z-')),
+				),
+			).toEqual(STACK_LEVEL_CASES.map(({ level }) => `z-${level}`))
+			expect(region.querySelector('[style]')).toBeNull()
+			expect(Object.isFrozen(POSITION_COPY)).toBe(true)
+			expect(Object.isFrozen(POSITION_SPECIMENS)).toBe(true)
+			expect(POSITION_SPECIMENS.every((specimen) => Object.isFrozen(specimen))).toBe(true)
+		} finally {
+			section.destroy()
+			host.remove()
+		}
+	})
+
+	it.each(VIEWPORT_WIDTHS)(
+		'contains a fixed descendant and a viewport-sized backdrop inside the frame at the %i variant',
+		async (width) => {
+			const host = mount(build('div'))
+			const section: SectionInterface = new PositionSection(host)
+			// The backdrop stands in for an overlay's: fixed, and sized to the viewport on each axis.
+			// The dialog stand-in is the release's default `.modal-dialog` footprint at the narrowest
+			// variant, a `0.5rem` margin around a content box 320px tall, inside a fixed wrapper that
+			// fills its containing block the way the release's `.modal` does. Both are fixtures of this
+			// case rather than specimens, so they carry inline sizes and never reach the showcase.
+			const backdrop = build('div', { classes: 'position-fixed top-0 start-0 vw-100 vh-100' })
+			const overlay = build('div', { classes: 'position-fixed top-0 start-0 w-100 h-100' })
+			const dialog = build('div', { attributes: { style: 'margin: 0.5rem; height: 320px' } })
+			overlay.append(dialog)
+			try {
+				const specimen = requireValue(
+					host.querySelector('[data-specimen="Fixed bars"]'),
+					'No Fixed bars specimen',
+				)
+				const frame = requireValue(specimen.querySelector('.viewport'), 'No frame')
+				const bar = requireValue(specimen.querySelector('.fixed-top'), 'No fixed top bar')
+				const bottom = requireValue(specimen.querySelector('.fixed-bottom'), 'No fixed bottom bar')
+				const reading = await visitBreakpoint(width, () => {
+					const page = document.documentElement.scrollHeight
+					frame.append(backdrop, overlay)
+					// A scroll the frame accepted would move its content, so the attempt is what
+					// reports whether the frame became a scroll container.
+					frame.scrollTop = 50
+					frame.scrollLeft = 50
+					const box = frame.getBoundingClientRect()
+					return {
+						viewport: [window.innerWidth, window.innerHeight],
+						page: [
+							document.documentElement.scrollWidth,
+							document.documentElement.scrollHeight - page,
+						],
+						scrolled: [frame.scrollTop, frame.scrollLeft],
+						gutter: [box.width - frame.clientWidth, box.height - frame.clientHeight],
+						width: { extent: frame.scrollWidth, room: frame.clientWidth },
+						height: { extent: frame.scrollHeight, room: frame.clientHeight },
+						origin: [
+							backdrop.getBoundingClientRect().left - box.left,
+							backdrop.getBoundingClientRect().top - box.top,
+						],
+						size: [readPixels(backdrop, 'width'), readPixels(backdrop, 'height')],
+						// Each fixed element's box, as its distance inside each frame edge, which is
+						// never negative for a box lying inside the frame.
+						inset: [bar, bottom, dialog].map((element) => {
+							const inner = element.getBoundingClientRect()
+							return [
+								inner.left - box.left,
+								inner.top - box.top,
+								box.right - inner.right,
+								box.bottom - inner.bottom,
+							].every((distance) => distance >= 0)
+						}),
+						edges: [
+							bar.getBoundingClientRect().top - box.top,
+							box.bottom - bottom.getBoundingClientRect().bottom,
+						],
+						footprint: dialog.getBoundingClientRect().height,
+					}
+				})
+				// Neither the frame nor the page gains a scrollbar for the backdrop's overflow. The
+				// frame clips rather than scrolls, so it accepts no scroll and reserves no gutter;
+				// Chromium still reports the clipped extent through `scrollHeight`, so the scroll the
+				// frame refuses is the reading rather than that extent. Paint containment keeps the
+				// overflow out of the page, whose width stays the viewport's and whose height does not
+				// grow.
+				expect(reading.viewport[0]).toBe(width)
+				expect(reading.scrolled).toEqual([0, 0])
+				expect(reading.gutter).toEqual([0, 0])
+				// The backdrop is placed against the frame and sized to the viewport, so it overflows
+				// the frame on the block axis.
+				expect(reading.origin).toEqual([0, 0])
+				expect(reading.size).toEqual(reading.viewport)
+				expect(reading.height.extent).toBeGreaterThan(reading.height.room)
+				expect(reading.width.extent).toBe(reading.width.room)
+				expect(reading.page).toEqual([width, 0])
+				// Each fixed bar holds to an edge of the frame rather than to an edge of the page, and a
+				// default dialog fits the frame whole, which is the room the bounded height keeps.
+				expect(reading.edges).toEqual([0, 0])
+				expect(reading.footprint).toBe(320)
+				expect(reading.inset).toEqual([true, true, true])
+			} finally {
+				backdrop.remove()
+				overlay.remove()
+				section.destroy()
+				host.remove()
+			}
+		},
+	)
+
+	it('paints nothing of its own on the frame', () => {
+		const host = mount(build('div'))
+		const section: SectionInterface = new PositionSection(host)
+		try {
+			for (const frame of host.querySelectorAll('.viewport')) {
+				expect(readStyle(frame, 'background-color')).toBe('rgba(0, 0, 0, 0)')
+				expect(readStyle(frame, 'background-image')).toBe('none')
+				expect(readStyle(frame, 'box-shadow')).toBe('none')
+				for (const side of ['top', 'right', 'bottom', 'left'])
+					expect(readPixels(frame, `border-${side}-width`)).toBe(0)
+			}
+		} finally {
+			section.destroy()
+			host.remove()
+		}
+	})
+
+	it('holds the sticky bars to the edges of the box they scroll in', () => {
+		const host = mount(build('div'))
+		const section: SectionInterface = new PositionSection(host)
+		try {
+			const specimen = requireValue(
+				host.querySelector('[data-specimen="Sticky bars"]'),
+				'No Sticky bars specimen',
+			)
+			const frame = requireValue(specimen.querySelector('.viewport'), 'No frame')
+			const box = requireValue(specimen.querySelector('.scroller'), 'No scrolling box')
+			const top = requireValue(specimen.querySelector('.sticky-top'), 'No sticky top bar')
+			const bottom = requireValue(specimen.querySelector('.sticky-bottom'), 'No sticky bottom bar')
+			// The box scrolls and the frame around it does not, which is what separates a sticky bar
+			// holding to the box from content that merely has not moved.
+			expect(box.scrollHeight).toBeGreaterThan(box.clientHeight)
+			expect(frame.scrollHeight).toBe(frame.clientHeight)
+			const limit = box.getBoundingClientRect()
+			// Each reading is taken at rest, halfway down the box, and at its end.
+			const offsets = [
+				0,
+				Math.floor((box.scrollHeight - box.clientHeight) / 2),
+				box.scrollHeight,
+			].map((scroll) => {
+				box.scrollTop = scroll
+				return [
+					box.scrollTop > 0 || scroll === 0,
+					top.getBoundingClientRect().top - limit.top,
+					limit.bottom - bottom.getBoundingClientRect().bottom,
+				]
+			})
+			expect(offsets).toEqual([
+				[true, 0, 0],
+				[true, 0, 0],
+				[true, 0, 0],
+			])
+		} finally {
+			section.destroy()
+			host.remove()
+		}
+	})
+
+	it('releases its region and preserves neighboring content through repeated destruction', () => {
+		const host = mount(build('div'))
+		const neighbor = build('p', { text: 'Existing content' })
+		host.append(neighbor)
+		const section: SectionInterface = new PositionSection(host)
+		try {
+			const region = requireValue(host.querySelector('section'), 'No Position region')
+			expect(region.isConnected).toBe(true)
+			section.destroy()
+			expect(region.isConnected).toBe(false)
+			section.destroy()
+			expect([...host.children]).toEqual([neighbor])
+		} finally {
+			section.destroy()
+			host.remove()
+		}
+	})
+})
