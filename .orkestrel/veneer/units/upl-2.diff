+import { TOKEN_NAMES } from '@src/core'
+import { requireValue } from '@orkestrel/test'
+import { readStyle } from '@orkestrel/test/browser'
+import { afterEach, describe, expect, it } from 'vitest'
+import { scene, visitBreakpoint } from '../../../setupBrowser.js'
+import { GRID_BREAKPOINT_CASES, STICKY_SCROLLER } from '../../../setupStyles.js'
+
+afterEach(() => {
+	scene.clear()
+	document.documentElement.style.removeProperty(TOKEN_NAMES.stack.fixed)
+	document.documentElement.style.removeProperty(TOKEN_NAMES.stack.sticky)
+})
+
+describe('position helpers', () => {
+	it('pins each fixed bar across the viewport at one edge', () => {
+		const host = scene.mount(
+			'<div class="fixed-top" style="height: 10px"></div><div class="fixed-bottom" style="height: 10px"></div>',
+		)
+		const across = document.documentElement.clientWidth
+		const top = requireValue(
+			host.querySelector('.fixed-top'),
+			'No .fixed-top',
+		).getBoundingClientRect()
+		const bottom = requireValue(
+			host.querySelector('.fixed-bottom'),
+			'No .fixed-bottom',
+		).getBoundingClientRect()
+		expect([top.left, top.top, top.width]).toEqual([0, 0, across])
+		expect([bottom.left, bottom.bottom, bottom.width]).toEqual([0, window.innerHeight, across])
+		for (const element of host.children) expect(readStyle(element, 'position')).toBe('fixed')
+	})
+
+	it('stacks the bars on the fixed and sticky levels and follows a retuned level', async () => {
+		const host = scene.mount(
+			'<div data-bs-theme="dark"><div class="fixed-top"></div><div class="fixed-bottom"></div><div class="sticky-top"></div><div class="sticky-lg-bottom"></div></div>',
+		)
+		const bars = ['.fixed-top', '.fixed-bottom', '.sticky-top', '.sticky-lg-bottom'].map(
+			(selector) => requireValue(host.querySelector(selector), `No ${selector}`),
+		)
+		const [resting, retuned] = await visitBreakpoint(992, () => {
+			const before = bars.map((bar) => readStyle(bar, 'z-index'))
+			document.documentElement.style.setProperty(TOKEN_NAMES.stack.fixed, '1234')
+			document.documentElement.style.setProperty(TOKEN_NAMES.stack.sticky, '1123')
+			return [before, bars.map((bar) => readStyle(bar, 'z-index'))]
+		})
+		expect(resting).toEqual(['1030', '1030', '1020', '1020'])
+		expect(retuned).toEqual(['1234', '1234', '1123', '1123'])
+	})
+
+	it.each(GRID_BREAKPOINT_CASES)(
+		'sticks each $name helper at each edge of a scroll container from its boundary up',
+		async ({ name, boundary, readings }) => {
+			const infix = boundary === 0 ? '' : `-${name}`
+			// The top helper rests 50px down the box and the box is scrolled past it; the bottom
+			// helper rests 500px down, below the box's lower edge, with the box unscrolled.
+			const host = scene.mount(
+				`<div class="box top" style="${STICKY_SCROLLER.style}"><div style="height: 50px"></div><div class="sticky${infix}-top" style="height: 10px"></div><div style="height: 500px"></div></div><div class="box bottom" style="${STICKY_SCROLLER.style}"><div style="height: 500px"></div><div class="sticky${infix}-bottom" style="height: 10px"></div><div style="height: 50px"></div></div>`,
+			)
+			const upper = requireValue(host.querySelector('.box.top'), 'No .box.top')
+			const lower = requireValue(host.querySelector('.box.bottom'), 'No .box.bottom')
+			const top = requireValue(upper.querySelector(`.sticky${infix}-top`), `No .sticky${infix}-top`)
+			const bottom = requireValue(
+				lower.querySelector(`.sticky${infix}-bottom`),
+				`No .sticky${infix}-bottom`,
+			)
+			const measured: unknown[] = []
+			for (const viewport of readings) {
+				measured.push(
+					await visitBreakpoint(viewport, () => {
+						upper.scrollTop = STICKY_SCROLLER.offset
+						lower.scrollTop = 0
+						return {
+							width: window.innerWidth,
+							scrolled: upper.scrollTop,
+							positions: [readStyle(top, 'position'), readStyle(bottom, 'position')],
+							offsets: [
+								top.getBoundingClientRect().top - upper.getBoundingClientRect().top,
+								lower.getBoundingClientRect().bottom - bottom.getBoundingClientRect().bottom,
+							],
+						}
+					}),
+				)
+			}
+			// From the boundary up each helper sticks at its edge of the box. Below it each helper
+			// stays in the flow, so the top one has scrolled out above the box and the bottom one
+			// waits below it.
+			expect(measured).toEqual(
+				readings.map((viewport) =>
+					viewport >= boundary
+						? {
+								width: viewport,
+								scrolled: STICKY_SCROLLER.offset,
+								positions: ['sticky', 'sticky'],
+								offsets: [0, 0],
+							}
+						: {
+								width: viewport,
+								scrolled: STICKY_SCROLLER.offset,
+								positions: ['static', 'static'],
+								offsets: [50 - STICKY_SCROLLER.offset, 100 - 510],
+							},
+				),
+			)
+		},
+	)
+
+	it('yields to a later unlayered consumer rule and to an important utility, as normal helpers', () => {
+		const host = scene.mount(
+			'<div class="fixed-top probe"></div><div class="fixed-bottom position-static"></div><div class="sticky-top z-1"></div>',
+		)
+		scene.load('.probe { z-index: 5; position: absolute }')
+		const probe = requireValue(host.querySelector('.probe'), 'No .probe')
+		expect([readStyle(probe, 'z-index'), readStyle(probe, 'position')]).toEqual(['5', 'absolute'])
+		expect(
+			readStyle(requireValue(host.querySelector('.fixed-bottom'), 'No .fixed-bottom'), 'position'),
+		).toBe('static')
+		expect(
+			readStyle(requireValue(host.querySelector('.sticky-top'), 'No .sticky-top'), 'z-index'),
+		).toBe('1')
+	})
+})
