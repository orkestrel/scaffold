@@ -0,0 +1,35 @@
+@use '../mixins' as *;
+
+@layer components {
+	// The bars read the stacking ladder the overlays read, so a retuned level moves them beside the
+	// dialogs and drawers they sit under.
+	.fixed-top {
+		position: fixed;
+		top: 0;
+		right: 0;
+		left: 0;
+		z-index: var(--vn-stack-fixed);
+	}
+
+	.fixed-bottom {
+		position: fixed;
+		right: 0;
+		bottom: 0;
+		left: 0;
+		z-index: var(--vn-stack-fixed);
+	}
+
+	@include breakpoint-each using ($infix, $_boundary) {
+		.sticky#{$infix}-top {
+			position: sticky;
+			top: 0;
+			z-index: var(--vn-stack-sticky);
+		}
+
+		.sticky#{$infix}-bottom {
+			position: sticky;
+			bottom: 0;
+			z-index: var(--vn-stack-sticky);
+		}
+	}
+}
