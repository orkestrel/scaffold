+import { TOKEN_NAMES } from '@src/core'
+import { requireValue } from '@orkestrel/test'
+import { findRule, readPixels, readStyle } from '@orkestrel/test/browser'
+import { afterEach, describe, expect, it } from 'vitest'
+import { scene, visitBreakpoint } from '../../../setupBrowser.js'
+import {
+	BREAKPOINT_INFIXES,
+	PLACEMENT_CONTAINER,
+	SIZE_STEP_CASES,
+	SIZING_ENTRY_CASES,
+	VIEWPORT_WIDTHS,
+} from '../../../setupStyles.js'
+
+afterEach(() => {
+	scene.clear()
+})
+
+describe('sizing utilities', () => {
+	it('resolves every width and height step against a container of definite size', () => {
+		const host = scene.mount(
+			`<div style="${PLACEMENT_CONTAINER}">${SIZE_STEP_CASES.map(({ step }) => `<div class="w-${step}"></div>`).join('')}</div><div style="${PLACEMENT_CONTAINER}; display: flex">${SIZE_STEP_CASES.map(({ step }) => `<div class="h-${step}"></div>`).join('')}</div>`,
+		)
+		for (const { step, share } of SIZE_STEP_CASES) {
+			expect(
+				readPixels(requireValue(host.querySelector(`.w-${step}`), `No .w-${step}`), 'width'),
+			).toBe(400 * share)
+			expect(
+				readPixels(requireValue(host.querySelector(`.h-${step}`), `No .h-${step}`), 'height'),
+			).toBe(200 * share)
+		}
+	})
+
+	it('sizes an auto step by its content over a width or height of its own', () => {
+		// The inline sizes stand in for a rule of the element's own; the step's importance is what
+		// sets them aside, and the content's box is what the element then takes.
+		const host = scene.mount(
+			'<div style="width: 400px; height: 200px; display: flex; align-items: flex-start"><div class="w-auto h-auto" style="width: 50px; height: 50px"><div style="width: 30px; height: 20px"></div></div></div>',
+		)
+		const box = requireValue(host.querySelector('.w-auto'), 'No .w-auto')
+		expect([readPixels(box, 'width'), readPixels(box, 'height')]).toEqual([30, 20])
+	})
+
+	it('caps an element at its container with the maximum sizes', () => {
+		const host = scene.mount(
+			`<div style="${PLACEMENT_CONTAINER}"><div class="mw-100" style="width: 1000px"></div><div class="mh-100" style="height: 1000px"></div></div>`,
+		)
+		expect(readPixels(requireValue(host.querySelector('.mw-100'), 'No .mw-100'), 'width')).toBe(400)
+		expect(readPixels(requireValue(host.querySelector('.mh-100'), 'No .mh-100'), 'height')).toBe(
+			200,
+		)
+	})
+
+	it.each(VIEWPORT_WIDTHS)(
+		'reads the viewport sizes against the %i viewport rather than against the container',
+		async (width) => {
+			const host = scene.mount(
+				`<div style="${PLACEMENT_CONTAINER}"><div class="vw-100 vh-100"></div><div class="min-vw-100 min-vh-100" style="width: 10px; height: 10px"></div></div>`,
+			)
+			const reading = await visitBreakpoint(width, () => {
+				const sized = requireValue(host.querySelector('.vw-100'), 'No .vw-100')
+				const floored = requireValue(host.querySelector('.min-vw-100'), 'No .min-vw-100')
+				return {
+					viewport: [window.innerWidth, window.innerHeight],
+					sized: [readPixels(sized, 'width'), readPixels(sized, 'height')],
+					floored: [readPixels(floored, 'width'), readPixels(floored, 'height')],
+				}
+			})
+			expect(reading.viewport[0]).toBe(width)
+			expect(reading.sized).toEqual(reading.viewport)
+			// The floors are the `min` key's entries, and each one holds its axis at the
+			// viewport over a smaller size of the element's own.
+			expect(reading.floored).toEqual(reading.viewport)
+		},
+	)
+
+	it('writes no breakpoint infix, so no sizing class answers to a boundary', () => {
+		expect(SIZING_ENTRY_CASES.filter(({ name }) => findRule(`.${name}`) === undefined)).toEqual([])
+		expect(
+			SIZING_ENTRY_CASES.flatMap(({ prefix }) =>
+				BREAKPOINT_INFIXES.flatMap((infix) =>
+					findRule(`.${prefix}-${infix}-`) === undefined ? [] : [`${prefix}-${infix}`],
+				),
+			),
+		).toEqual([])
+	})
+
+	it('keeps every step independent of the density factor and inside a dark island', () => {
+		const host = scene.mount(
+			`<div data-bs-theme="dark" style="${PLACEMENT_CONTAINER}"><div class="w-75 h-50"></div></div>`,
+		)
+		const box = requireValue(host.querySelector('.w-75'), 'No .w-75')
+		document.documentElement.style.setProperty(TOKEN_NAMES.factor.density, '2')
+		try {
+			expect([readPixels(box, 'width'), readPixels(box, 'height')]).toEqual([300, 100])
+		} finally {
+			document.documentElement.style.removeProperty(TOKEN_NAMES.factor.density)
+		}
+		expect([readPixels(box, 'width'), readPixels(box, 'height')]).toEqual([300, 100])
+	})
+
+	it('resolves a later entry over an earlier one on the property both set', async () => {
+		// The release writes the width entry before the viewport-width entry, and the height entry
+		// before the viewport-height entry, so the viewport size wins where an element carries both.
+		const host = scene.mount(
+			`<div style="${PLACEMENT_CONTAINER}"><div class="vw-100 w-25 vh-100 h-25"></div></div>`,
+		)
+		const box = requireValue(host.querySelector('.w-25'), 'No .w-25')
+		const [across, down, height] = await visitBreakpoint(390, () => [
+			readPixels(box, 'width'),
+			readPixels(box, 'height'),
+			window.innerHeight,
+		])
+		expect([across, down]).toEqual([390, height])
+	})
+
+	it('keeps every step over a later unlayered consumer rule', () => {
+		const host = scene.mount(
+			`<div style="${PLACEMENT_CONTAINER}"><div class="w-25 h-25 mw-100"></div></div>`,
+		)
+		scene.load('.w-25 { width: 7px; height: 7px; max-width: 5px }')
+		const box = requireValue(host.querySelector('.w-25'), 'No .w-25')
+		expect([
+			readPixels(box, 'width'),
+			readPixels(box, 'height'),
+			readStyle(box, 'max-width'),
+		]).toEqual([100, 50, '100%'])
+	})
+
+	it('yields to an important override inside the utilities layer and to no unlayered one', () => {
+		const host = scene.mount(`<div style="${PLACEMENT_CONTAINER}"><div class="w-25"></div></div>`)
+		const box = requireValue(host.querySelector('.w-25'), 'No .w-25')
+		// An unlayered `!important` sorts after every layered one, so the shipped utility keeps its
+		// step; the same declaration re-opened inside the utilities layer arrives after the shipped
+		// rule in that layer and wins.
+		scene.load('.w-25 { width: 9px !important }')
+		expect(readPixels(box, 'width')).toBe(100)
+		scene.load('@layer utilities { .w-25 { width: 9px !important } }')
+		expect(readPixels(box, 'width')).toBe(9)
+	})
+})
