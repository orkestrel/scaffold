+import type { SectionInterface } from '@app/browser'
+import { SIZING_COPY, SIZING_SPECIMENS, SizingSection, SpecimenSection } from '@app/browser'
+import { requireValue } from '@orkestrel/test'
+import { build, mount, readPixels } from '@orkestrel/test/browser'
+import { beforeAll, describe, expect, it } from 'vitest'
+import { visitBreakpoint } from '../../../setupBrowser.js'
+import { SIZE_STEP_CASES, VIEWPORT_SIZE_CASES, VIEWPORT_WIDTHS } from '../../../setupStyles.js'
+
+// The geometry case reads the specimens as the published cascade and the shell lay them out, so
+// both stylesheets have to be in the document before a box is measured.
+beforeAll(async () => {
+	await import('../../../../src/styles/index.scss')
+	await import('../../../../app/browser/styles/index.scss')
+})
+
+describe('SizingSection', () => {
+	it('renders every declared specimen through the shared section contract', () => {
+		const host = mount(build('div'))
+		const section: SectionInterface = new SizingSection(host)
+		try {
+			expect(section).toBeInstanceOf(SpecimenSection)
+			expect(section.host).toBe(host)
+			const region = requireValue(host.querySelector('section'), 'No Sizing region')
+			expect(region.getAttribute('aria-label')).toBe('Sizing')
+			expect(region.querySelector('p')?.textContent).toBe(SIZING_COPY.paragraph)
+			const rendered = [...region.querySelectorAll('[data-specimen]')]
+			expect(rendered.map((element) => element.getAttribute('data-specimen'))).toEqual([
+				'Width steps',
+				'Height steps',
+				'Maximum sizes',
+				'Viewport sizes',
+			])
+			expect(rendered.map((element) => element.innerHTML)).toEqual(
+				SIZING_SPECIMENS.map((specimen) => specimen.markup),
+			)
+			// Every selector names a composition the specimens render, so the list of misses is empty.
+			expect(
+				[
+					...[...SIZE_STEP_CASES.map(({ step }) => step), 'auto'].flatMap((step) => [
+						`[data-specimen="Width steps"] p > .placeholder.w-${step}`,
+						`[data-specimen="Height steps"] .viewport .row.h-100 > .col > .placeholder.w-100.h-${step}`,
+					]),
+					'[data-specimen="Maximum sizes"] .viewport > p > .placeholder.vw-100.mw-100',
+					'[data-specimen="Maximum sizes"] .viewport > .h-50 > .placeholder.vh-100.mh-100',
+					'[data-specimen="Viewport sizes"] .viewport .placeholder.vw-100',
+					'[data-specimen="Viewport sizes"] .viewport .placeholder.min-vw-100',
+					'[data-specimen="Viewport sizes"] .viewport > .placeholder.vh-100',
+					'[data-specimen="Viewport sizes"] .viewport > .placeholder.min-vh-100',
+				].filter((selector) => region.querySelector(selector) === null),
+			).toEqual([])
+			// A box as wide as the viewport renders inside the shell's frame, which clips what it
+			// overflows, so the list of boxes outside a frame is empty.
+			expect(
+				[...region.querySelectorAll('.vw-100')].filter(
+					(element) => element.closest('.viewport') === null,
+				),
+			).toEqual([])
+			// Every box is a placeholder drawn for its size alone, so none of them is announced.
+			expect(
+				[...region.querySelectorAll('.placeholder')].every(
+					(element) => element.getAttribute('aria-hidden') === 'true',
+				),
+			).toBe(true)
+			expect(region.querySelector('[style]')).toBeNull()
+			expect(Object.isFrozen(SIZING_COPY)).toBe(true)
+			expect(Object.isFrozen(SIZING_SPECIMENS)).toBe(true)
+			expect(SIZING_SPECIMENS.every((specimen) => Object.isFrozen(specimen))).toBe(true)
+		} finally {
+			section.destroy()
+			host.remove()
+		}
+	})
+
+	it.each(VIEWPORT_WIDTHS)(
+		'sizes the steps against their container and the viewport sizes against the viewport at the %i variant',
+		async (width) => {
+			const host = mount(build('div'))
+			const section: SectionInterface = new SizingSection(host)
+			try {
+				const reading = await visitBreakpoint(width, () => {
+					const line = requireValue(
+						host.querySelector('[data-specimen="Width steps"] p'),
+						'No width step line',
+					)
+					const column = requireValue(
+						host.querySelector('[data-specimen="Height steps"] .col'),
+						'No height step column',
+					)
+					const capped = requireValue(
+						host.querySelector('[data-specimen="Maximum sizes"] p'),
+						'No capped line',
+					)
+					const box = requireValue(
+						host.querySelector('[data-specimen="Maximum sizes"] .h-50'),
+						'No capped box',
+					)
+					return {
+						page: document.documentElement.scrollWidth,
+						widths: SIZE_STEP_CASES.map(
+							({ step }) =>
+								readPixels(
+									requireValue(
+										host.querySelector(`[data-specimen="Width steps"] .w-${step}`),
+										`No width step ${step}`,
+									),
+									'width',
+								) / line.clientWidth,
+						),
+						heights: SIZE_STEP_CASES.map(
+							({ step }) =>
+								readPixels(
+									requireValue(
+										host.querySelector(`[data-specimen="Height steps"] .h-${step}`),
+										`No height step ${step}`,
+									),
+									'height',
+								) / column.clientHeight,
+						),
+						caps: [
+							[
+								readPixels(requireValue(capped.querySelector('.mw-100'), 'No width cap'), 'width'),
+								capped.clientWidth,
+							],
+							[
+								readPixels(requireValue(box.querySelector('.mh-100'), 'No height cap'), 'height'),
+								box.clientHeight,
+							],
+						],
+						viewport: VIEWPORT_SIZE_CASES.map(({ name, property }) =>
+							readPixels(
+								requireValue(
+									host.querySelector(`[data-specimen="Viewport sizes"] .${name}`),
+									`No viewport size .${name}`,
+								),
+								property,
+							),
+						),
+						window: [window.innerWidth, window.innerHeight],
+					}
+				})
+				const [across, down] = reading.window
+				expect(reading.widths).toEqual(SIZE_STEP_CASES.map(({ share }) => share))
+				expect(reading.heights).toEqual(SIZE_STEP_CASES.map(({ share }) => share))
+				for (const [capped, limit] of reading.caps) expect(capped).toBe(limit)
+				expect(reading.viewport).toEqual(
+					VIEWPORT_SIZE_CASES.map(({ property }) => (property === 'width' ? across : down)),
+				)
+				// Every viewport-sized box renders inside a frame, which clips what it overflows, and the
+				// capped box is held to its line besides, so none of them widens the page.
+				expect(reading.page).toBe(width)
+			} finally {
+				section.destroy()
+				host.remove()
+			}
+		},
+	)
+
+	it('releases its region and preserves neighboring content through repeated destruction', () => {
+		const host = mount(build('div'))
+		const neighbor = build('p', { text: 'Existing content' })
+		host.append(neighbor)
+		const section: SectionInterface = new SizingSection(host)
+		try {
+			const region = requireValue(host.querySelector('section'), 'No Sizing region')
+			expect(region.isConnected).toBe(true)
+			section.destroy()
+			expect(region.isConnected).toBe(false)
+			section.destroy()
+			expect([...host.children]).toEqual([neighbor])
+		} finally {
+			section.destroy()
+			host.remove()
+		}
+	})
+})
