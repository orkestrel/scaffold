 		gap: var(--vn-space-4);
 		align-items: center;
 	}
+
+	// Layout alone: the frame a fixed, sticky, or viewport-sized specimen renders inside, and the one
+	// the overlay specimens render inside. Layout containment makes the frame the containing block of
+	// every fixed and absolute descendant, so a fixed bar or a full-viewport backdrop is placed
+	// against the frame rather than against the page. Paint containment and the clip keep whatever
+	// such a descendant overflows inside the frame without making the frame a scroll container, so a
+	// backdrop sized to the viewport raises no scrollbar on the frame or on the page. The height is
+	// bounded, because a fixed descendant sized to its containing block takes the frame's height, and
+	// it leaves room for a default dialog at the narrowest variant. The frame declares no fill and no
+	// border, so everything inside it is what the published cascade paints.
+	.viewport {
+		height: 24rem;
+		overflow: clip;
+		contain: layout paint;
+	}
+
+	// Layout alone: the box a sticky specimen scrolls, filling its frame, because the frame clips
+	// rather than scrolls and a sticky element sticks inside its nearest scroll container.
+	.scroller {
+		height: 100%;
+		overflow: auto;
+	}
 }
