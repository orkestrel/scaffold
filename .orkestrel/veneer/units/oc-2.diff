+							? `.offcanvas.offcanvas-${modifier ?? ''}`
+							: `.offcanvas-${step}.offcanvas-end`,
+					),
+				).toBe(true)
+				// The frame is the containing block of the fixed panel, so a shown panel lies inside the
+				// frame's box wherever the frame renders, and it paints rather than resting hidden.
+				const box = panel.getBoundingClientRect()
+				const bounds = frame.getBoundingClientRect()
+				expect(box.left).toBeGreaterThanOrEqual(bounds.left - 0.5)
+				expect(box.right).toBeLessThanOrEqual(bounds.right + 0.5)
+				expect(box.top).toBeGreaterThanOrEqual(bounds.top - 0.5)
+				expect(box.bottom).toBeLessThanOrEqual(bounds.bottom + 0.5)
+				expect(readStyle(panel, 'visibility')).toBe('visible')
+				expect(readStyle(panel, 'transform')).toBe('none')
+			}
+		} finally {
+			section.destroy()
+			host.remove()
+		}
+	})
