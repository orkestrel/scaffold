diff --git a/src/styles/components/_offcanvas.scss b/src/styles/components/_offcanvas.scss
new file mode 100644
index 0000000..1edc80b
--- /dev/null
+++ b/src/styles/components/_offcanvas.scss
@@ -0,0 +1,187 @@
+@use 'sass:list';
+@use '../mixins' as *;
+
+// Holds the declarations a fixed panel paints, and the nested rules it carries keyed by the
+// selector each one extends the panel with. A placement class pins the panel to its edge, spans the
+// axis along that edge, draws the inner border, and slides the panel out past that edge. The state
+// classes clear the slide and show the panel. The bare panel and each responsive panel below its
+// boundary emit these same maps, so neither can drift from the other.
+$panel: (
+	position: fixed,
+	bottom: 0,
+	z-index: var(--bs-offcanvas-zindex),
+	display: flex,
+	flex-direction: column,
+	max-width: 100%,
+	color: var(--bs-offcanvas-color),
+	visibility: hidden,
+	background-color: var(--bs-offcanvas-bg),
+	background-clip: padding-box,
+	outline: 0,
+);
+$nested: (
+	'&.offcanvas-start': (
+		top: 0,
+		left: 0,
+		width: var(--bs-offcanvas-width),
+		border-right: var(--bs-offcanvas-border-width) solid var(--bs-offcanvas-border-color),
+		transform: translateX(-100%),
+	),
+	'&.offcanvas-end': (
+		top: 0,
+		right: 0,
+		width: var(--bs-offcanvas-width),
+		border-left: var(--bs-offcanvas-border-width) solid var(--bs-offcanvas-border-color),
+		transform: translateX(100%),
+	),
+	'&.offcanvas-top': (
+		top: 0,
+		right: 0,
+		left: 0,
+		height: var(--bs-offcanvas-height),
+		max-height: 100%,
+		border-bottom: var(--bs-offcanvas-border-width) solid var(--bs-offcanvas-border-color),
+		transform: translateY(-100%),
+	),
+	'&.offcanvas-bottom': (
+		right: 0,
+		left: 0,
+		height: var(--bs-offcanvas-height),
+		max-height: 100%,
+		border-top: var(--bs-offcanvas-border-width) solid var(--bs-offcanvas-border-color),
+		transform: translateY(100%),
+	),
+	'&.showing, &.show:not(.hiding)': (
+		transform: none,
+	),
+	'&.showing, &.hiding, &.show': (
+		visibility: visible,
+	),
+);
+
+@layer components {
+	// Every value here is Bootstrap 5.3.8's own. Each panel class declares its stacking variable over
+	// the drawer rung of the stacking ladder, which the fixed panel's `z-index` property reads, and
+	// the backdrop's `z-index` property reads the rung beneath it, so a retuned rung moves each one.
+	// The inset variables read the density scale token that already resolves to the release's `1rem`
+	// inset, and the title's line-height variable reads the body line token. The width, the height,
+	// the backdrop's opacity, and the transition keep the release's literals, because no Veneer token
+	// resolves to them.
+	$panels: '.offcanvas';
+	@each $name, $boundary in breakpoints() {
+		@if $boundary != 0 {
+			$panels: list.append($panels, '.offcanvas-#{$name}', comma);
+		}
+	}
+
+	#{$panels} {
+		--bs-offcanvas-zindex: var(--vn-stack-drawer-base);
+		--bs-offcanvas-width: 400px;
+		--bs-offcanvas-height: 30vh;
+		--bs-offcanvas-padding-x: var(--vn-space-8);
+		--bs-offcanvas-padding-y: var(--vn-space-8);
+		--bs-offcanvas-color: var(--bs-body-color);
+		--bs-offcanvas-bg: var(--bs-body-bg);
+		--bs-offcanvas-border-width: var(--bs-border-width);
+		--bs-offcanvas-border-color: var(--bs-border-color-translucent);
+		--bs-offcanvas-box-shadow: var(--bs-box-shadow-sm);
+		--bs-offcanvas-transition: transform 0.3s ease-in-out;
+		--bs-offcanvas-title-line-height: var(--vn-line-body);
+	}
+
+	// Each responsive panel is fixed below its own boundary and sits in the flow at and above it,
+	// where it drops its fill and its edge, hides its header, and lays its body out as a row. The
+	// panel's and the body's transparent fills carry the release's `!important` flag, and in this
+	// layer that flag also holds the inline panel clear under an important background utility, where
+	// the release's later utility paints it. The height and border-width variables the class
+	// redeclares there are the release's; no rule reads them at that width, because the placement
+	// rules apply below the boundary alone.
+	@each $name, $boundary in breakpoints() {
+		@if $boundary != 0 {
+			.offcanvas-#{$name} {
+				@include breakpoint-down($name) {
+					@each $property, $value in $panel {
+						#{$property}: $value;
+					}
+					@include transition(var(--bs-offcanvas-transition));
+					@each $selector, $declarations in $nested {
+						#{$selector} {
+							@each $property, $value in $declarations {
+								#{$property}: $value;
+							}
+						}
+					}
+				}
+
+				@include breakpoint-up($name) {
+					--bs-offcanvas-height: auto;
+					--bs-offcanvas-border-width: 0;
+					background-color: transparent !important;
+
+					.offcanvas-header {
+						display: none;
+					}
+
+					.offcanvas-body {
+						display: flex;
+						flex-grow: 0;
+						padding: 0;
+						overflow-y: visible;
+						background-color: transparent !important;
+					}
+				}
+			}
+		}
+	}
+
+	// The bare panel is fixed at every width. The `breakpoint-down` mixin emits nothing at the zero
+	// boundary, so the walk cannot write these unconditioned rules, and they are written here from
+	// the same maps.
+	.offcanvas {
+		@each $property, $value in $panel {
+			#{$property}: $value;
+		}
+		@include transition(var(--bs-offcanvas-transition));
+		@each $selector, $declarations in $nested {
+			#{$selector} {
+				@each $property, $value in $declarations {
+					#{$property}: $value;
+				}
+			}
+		}
+	}
+
+	.offcanvas-backdrop {
+		@include overlay-backdrop(var(--vn-stack-drawer-backdrop), var(--vn-palette-black-base), 0.5);
+	}
+
+	.offcanvas-header {
+		display: flex;
+		align-items: center;
+		padding: var(--bs-offcanvas-padding-y) var(--bs-offcanvas-padding-x);
+	}
+
+	// The header fits the close control into its own inset: the control's padding is half the
+	// header's, and a negative margin of that half on the top, the right, and the bottom pulls the
+	// control into the header's padding, while the automatic left margin pushes it to the end of the
+	// row. The combinator selects the control through the header, so a close control elsewhere in
+	// the panel stays as the close partial draws it.
+	.offcanvas-header .btn-close {
+		padding: calc(var(--bs-offcanvas-padding-y) * 0.5) calc(var(--bs-offcanvas-padding-x) * 0.5);
+		margin-top: calc(-0.5 * var(--bs-offcanvas-padding-y));
+		margin-right: calc(-0.5 * var(--bs-offcanvas-padding-x));
+		margin-bottom: calc(-0.5 * var(--bs-offcanvas-padding-y));
+		margin-left: auto;
+	}
+
+	.offcanvas-title {
+		margin-bottom: 0;
+		line-height: var(--bs-offcanvas-title-line-height);
+	}
+
+	.offcanvas-body {
+		flex-grow: 1;
+		padding: var(--bs-offcanvas-padding-y) var(--bs-offcanvas-padding-x);
+		overflow-y: auto;
+	}
+}
diff --git a/app/browser/sections/OffcanvasSection.ts b/app/browser/sections/OffcanvasSection.ts
new file mode 100644
index 0000000..55c78cb
--- /dev/null
+++ b/app/browser/sections/OffcanvasSection.ts
@@ -0,0 +1,20 @@
+import { OFFCANVAS_COPY, OFFCANVAS_SPECIMENS } from '../constants.js'
+import { SpecimenSection } from './SpecimenSection.js'
+
+/**
+ * Renders the declared offcanvas specimens into a named region.
+ * @example
+ * ```ts
+ * const section = new OffcanvasSection(document.body)
+ * section.destroy()
+ * ```
+ */
+export class OffcanvasSection extends SpecimenSection {
+	/**
+	 * Mounts the Offcanvas region and its specimens.
+	 * @param host - The element receiving the section.
+	 */
+	constructor(host: HTMLElement) {
+		super(host, OFFCANVAS_COPY, OFFCANVAS_SPECIMENS)
+	}
+}
diff --git a/tests/src/styles/components/offcanvas.test.ts b/tests/src/styles/components/offcanvas.test.ts
new file mode 100644
index 0000000..e28e8e5
--- /dev/null
+++ b/tests/src/styles/components/offcanvas.test.ts
@@ -0,0 +1,540 @@
+import { TOKEN_NAMES } from '@src/core'
+import { requireValue } from '@orkestrel/test'
+import {
+	matchesColor,
+	readHit,
+	readPixels,
+	readRootToken,
+	readStyle,
+	readToken,
+	releaseMedia,
+	stageMedia,
+} from '@orkestrel/test/browser'
+import { afterEach, describe, expect, it } from 'vitest'
+import {
+	collectLayer,
+	collectMediaConditions,
+	scene,
+	visitBreakpoint,
+} from '../../../setupBrowser.js'
+import {
+	GRID_BREAKPOINT_CASES,
+	NAVBAR_SELECTORS,
+	normalizeComplexSelector,
+	OFFCANVAS_FRAME,
+	OFFCANVAS_GEOMETRY,
+	OFFCANVAS_MARKUP,
+	OFFCANVAS_PLACEMENTS,
+	OFFCANVAS_SELECTORS,
+	OFFCANVAS_STATE_CASES,
+	REDUCED_MOTION,
+	splitTopLevelList,
+	TEXT_MODES,
+	trimCSSWhitespace,
+} from '../../../setupStyles.js'
+
+afterEach(async () => {
+	await releaseMedia()
+	document.documentElement.style.removeProperty(TOKEN_NAMES.factor.density)
+	scene.clear()
+})
+
+describe('offcanvas classes', () => {
+	// The mutation this catches is a rule the partial stops writing, or one it writes beyond the
+	// release: the reading is every components-layer selector naming one of the key's own classes,
+	// the expanded navbar combinators the navbar partial writes included, so a missing rule and an
+	// extra rule on the same classes each report here.
+	it('writes the recorded offcanvas selectors and no other rule on their classes', () => {
+		const written = new Set(
+			collectLayer('components').flatMap((rule) =>
+				rule instanceof CSSStyleRule
+					? splitTopLevelList(rule.selectorText)
+							.map((part) => normalizeComplexSelector(trimCSSWhitespace(part)))
+							.filter((selector) => /\.offcanvas(?:-[\w-]+)?(?![\w-])/u.test(selector))
+					: [],
+			),
+		)
+		const combinators = NAVBAR_SELECTORS.filter((selector) => selector.includes('.offcanvas'))
+		expect(combinators).not.toStrictEqual([])
+		expect([...written].sort()).toEqual(
+			[...OFFCANVAS_SELECTORS, ...combinators]
+				.map((selector) => normalizeComplexSelector(selector))
+				.sort(),
+		)
+	})
+
+	// The mutations this catches are a stacking level written as the release's literal, and the two
+	// rungs swapped: the literal ignores a retuned rung, and a panel under its backdrop hands the hit
+	// at its center to the backdrop.
+	it('stacks the panel on the drawer rung over its backdrop on the rung beneath, and follows a retuned rung', () => {
+		const host = scene.mount(
+			`<div data-frame style="${OFFCANVAS_FRAME}"><div class="offcanvas offcanvas-start show">${OFFCANVAS_MARKUP}</div><div class="offcanvas-backdrop fade show"></div></div>`,
+		)
+		const frame = requireValue(host.querySelector<HTMLElement>('[data-frame]'), 'No frame')
+		const panel = requireValue(host.querySelector('.offcanvas'), 'No panel')
+		const backdrop = requireValue(host.querySelector('.offcanvas-backdrop'), 'No backdrop')
+		expect(readRootToken(TOKEN_NAMES.stack.drawer.base)).toBe(OFFCANVAS_GEOMETRY.panel)
+		expect(readRootToken(TOKEN_NAMES.stack.drawer.backdrop)).toBe(OFFCANVAS_GEOMETRY.backdrop)
+		expect(readStyle(panel, 'z-index')).toBe(OFFCANVAS_GEOMETRY.panel)
+		expect(readStyle(backdrop, 'z-index')).toBe(OFFCANVAS_GEOMETRY.backdrop)
+		expect(panel.contains(readHit(panel) ?? null)).toBe(true)
+		frame.style.setProperty(TOKEN_NAMES.stack.drawer.base, '7')
+		frame.style.setProperty(TOKEN_NAMES.stack.drawer.backdrop, '6')
+		expect(readStyle(panel, 'z-index')).toBe('7')
+		expect(readStyle(backdrop, 'z-index')).toBe('6')
+		// The panel reads its level through its own variable, so a consumer rule retuning that
+		// variable on the panel moves the level and leaves the backdrop on its rung.
+		scene.load('[data-frame] .offcanvas { --bs-offcanvas-zindex: 9; }')
+		expect(readStyle(panel, 'z-index')).toBe('9')
+		expect(readStyle(backdrop, 'z-index')).toBe('6')
+	})
+
+	// The mutation this catches is a backdrop written without the `overlay-backdrop` mixin and
+	// without its state rules: a backdrop missing the fade rule paints at full strength before the
+	// engine shows it, and one missing the show rule never reaches the release's opacity. The
+	// `repeats no partial's written declaration block` case in the `tests/setupStyles.test.ts` file
+	// catches a copy of the mixin's block written into the partial instead of the include.
+	it('covers the viewport from the frame corner, transparent with the fade class alone and at the release opacity with the show class', () => {
+		const host = scene.mount(
+			`<div data-frame style="${OFFCANVAS_FRAME}"><div class="offcanvas-backdrop fade" data-backdrop="fading"></div></div><div data-frame style="${OFFCANVAS_FRAME}"><div class="offcanvas-backdrop fade show" data-backdrop="shown"></div></div>`,
+		)
+		const fading = requireValue(
+			host.querySelector('[data-backdrop="fading"]'),
+			'No fading backdrop',
+		)
+		const shown = requireValue(host.querySelector('[data-backdrop="shown"]'), 'No shown backdrop')
+		expect(readStyle(fading, 'opacity')).toBe('0')
+		expect(readStyle(shown, 'opacity')).toBe(OFFCANVAS_GEOMETRY.opacity)
+		const frame = requireValue(shown.parentElement, 'No frame').getBoundingClientRect()
+		const box = shown.getBoundingClientRect()
+		expect(readStyle(shown, 'position')).toBe('fixed')
+		expect([box.left, box.top]).toEqual([frame.left, frame.top])
+		expect(readPixels(shown, 'width')).toBe(window.innerWidth)
+		expect(readPixels(shown, 'height')).toBe(window.innerHeight)
+		// The fill reads the black palette token, so a scope retuning that token moves it where the
+		// release's literal would stay.
+		expect(
+			matchesColor(
+				readStyle(shown, 'background-color'),
+				readRootToken(TOKEN_NAMES.palette.black.base),
+			),
+		).toBe(true)
+		requireValue(shown.parentElement, 'No frame').style.setProperty(
+			TOKEN_NAMES.palette.black.base,
+			'rgb(9, 8, 7)',
+		)
+		expect(readStyle(shown, 'background-color')).toBe('rgb(9, 8, 7)')
+	})
+})
+
+describe('offcanvas placements', () => {
+	// The mutations this catches are two placements' transforms swapped, an edge offset dropped, and
+	// a border drawn on the wrong side: every placement is read against its own row, and the slide is
+	// read as the translation it resolves to beside the panel's own size.
+	it.each(OFFCANVAS_PLACEMENTS)(
+		'pins the $placement panel to its edge, spans its axis, draws its inner border, and slides out along its axis until shown',
+		({ placement, edges, side, axis, sign }) => {
+			const host = scene.mount(
+				`<div data-frame style="${OFFCANVAS_FRAME}"><div class="offcanvas offcanvas-${placement} show">${OFFCANVAS_MARKUP}</div></div><div data-frame style="${OFFCANVAS_FRAME}"><div class="offcanvas offcanvas-${placement}" data-panel="hidden">${OFFCANVAS_MARKUP}</div></div>`,
+			)
+			const shown = requireValue(
+				host.querySelector<HTMLElement>('.offcanvas.show'),
+				'No shown panel',
+			)
+			const hidden = requireValue(
+				host.querySelector<HTMLElement>('[data-panel="hidden"]'),
+				'No hidden panel',
+			)
+			const frame = requireValue(shown.parentElement, 'No frame').getBoundingClientRect()
+			const box = shown.getBoundingClientRect()
+			expect(readStyle(shown, 'position')).toBe('fixed')
+			for (const edge of edges) expect({ edge, at: box[edge] }).toEqual({ edge, at: frame[edge] })
+			// A side panel takes the recorded width and the frame's whole height, and an edge panel the
+			// frame's whole width and the recorded share of the viewport's height.
+			const [width, height] =
+				axis === 'X'
+					? [OFFCANVAS_GEOMETRY.width, frame.height]
+					: [
+							frame.width,
+							Math.min((window.innerHeight * OFFCANVAS_GEOMETRY.height) / 100, frame.height),
+						]
