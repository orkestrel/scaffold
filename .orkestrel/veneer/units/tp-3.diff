@@ -0,0 +1,20 @@
+import { POPOVER_COPY, POPOVER_SPECIMENS } from '../constants.js'
+import { SpecimenSection } from './SpecimenSection.js'
+
+/**
+ * Renders the declared popover specimens into a named region.
+ * @example
+ * ```ts
+ * const section = new PopoverSection(document.body)
+ * section.destroy()
+ * ```
+ */
+export class PopoverSection extends SpecimenSection {
+	/**
+	 * Mounts the Popover region and its specimens.
+	 * @param host - The element receiving the section.
+	 */
+	constructor(host: HTMLElement) {
+		super(host, POPOVER_COPY, POPOVER_SPECIMENS)
+	}
+}
