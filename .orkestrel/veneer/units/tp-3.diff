+import { TOKEN_NAMES } from '@src/core'
+import { requireValue } from '@orkestrel/test'
+import {
+	findRule,
+	matchesColor,
+	readPixels,
+	readRootToken,
+	readStyle,
+	readToken,
+} from '@orkestrel/test/browser'
+import { afterEach, describe, expect, it } from 'vitest'
+import { collectLayer, scene } from '../../../setupBrowser.js'
+import {
+	TEXT_MODES,
+	TIP_ARROW_PROPERTIES,
+	TIP_PLACEMENTS,
+	TIP_RESET_CASES,
+	TOOLTIP_SELECTORS,
+	normalizeComplexSelector,
+	splitTopLevelList,
+	trimCSSWhitespace,
+} from '../../../setupStyles.js'
+
+afterEach(() => {
+	for (const token of [TOKEN_NAMES.factor.density, TOKEN_NAMES.factor.radius])
+		document.documentElement.style.removeProperty(token)
+	scene.clear()
+})
+
+describe('tooltip rules', () => {
+	// The mutation this catches is a rule the partial stops writing, or one it writes beyond the
+	// release: the reading is every components-layer selector naming one of the key's own classes,
+	// so a missing rule and an extra rule on the same classes each report here. The sheet writes an
+	// attribute value in quotes and the release records it bare, so the quotes are dropped before
+	// the two are compared.
+	it('writes the recorded tooltip selectors and no other rule on their classes', () => {
+		const written = new Set(
+			collectLayer('components').flatMap((rule) =>
+				rule instanceof CSSStyleRule
+					? splitTopLevelList(rule.selectorText)
+							.map((part) =>
+								normalizeComplexSelector(trimCSSWhitespace(part)).replaceAll(
+									/="(\w+)"\]/gu,
+									'=$1]',
+								),
+							)
+							.filter((selector) => /\.(?:tooltip|bs-tooltip)(?:-[\w-]+)?(?![\w-])/u.test(selector))
+					: [],
+			),
+		)
+		expect([...written].sort()).toEqual(
+			TOOLTIP_SELECTORS.map((selector) => normalizeComplexSelector(selector)).sort(),
+		)
+		expect(findRule('.tooltip-inner')).not.toBeUndefined()
+	})
+})
+
+describe('tooltip box', () => {
+	// The mutation this catches is a stacking level written as the release's literal: it resolves
+	// the same level at rest and follows no retuned rung.
+	it('stacks on the hint rung and follows a wrapper that retunes it', () => {
+		const host = scene.mount(
+			'<div class="tooltip show position-absolute" role="tooltip"><div class="tooltip-inner">Saved</div></div><div style="--vn-stack-hint: 1234"><div class="tooltip show position-absolute" role="tooltip"><div class="tooltip-inner">Retuned</div></div></div>',
+		)
+		const resting = requireValue(host.querySelector(':scope > .tooltip'), 'No resting tooltip')
+		const retuned = requireValue(host.querySelector('[style] > .tooltip'), 'No retuned tooltip')
+		expect(readRootToken(TOKEN_NAMES.stack.hint)).toBe('1080')
+		expect(readStyle(resting, 'z-index')).toBe('1080')
+		expect(readStyle(retuned, 'z-index')).toBe('1234')
+	})
+
+	// The mutation this catches is the `show` rule dropped: the shown tip then rests at the
+	// transparent opacity the bare class writes.
+	it('rests transparent without the show class and takes its own opacity slot with it', () => {
+		const host = scene.mount(
+			'<div class="tooltip" role="tooltip"><div class="tooltip-inner">Hidden</div></div><div class="tooltip show" role="tooltip"><div class="tooltip-inner">Shown</div></div>',
+		)
+		const hidden = requireValue(host.querySelector('.tooltip:not(.show)'), 'No hidden tooltip')
+		const tip = requireValue(host.querySelector<HTMLElement>('.tooltip.show'), 'No shown tooltip')
+		expect(readStyle(hidden, 'opacity')).toBe('0')
+		expect(readStyle(tip, 'opacity')).toBe('0.9')
+		expect(Number(readToken(tip, '--bs-tooltip-opacity'))).toBe(0.9)
+		// A shown tip reads its opacity through the slot, so a retune on the tip moves it; the
+		// release's literal would read the same at rest and follow no retune.
+		tip.style.setProperty('--bs-tooltip-opacity', '0.5')
+		expect(readStyle(tip, 'opacity')).toBe('0.5')
+	})
+
+	// The mutation this catches is the reset dropped from the tooltip rule: the tip then inherits the
+	// bold, uppercase, right-aligned, unwrapped treatment its parent stages, as the plain text beside
+	// it does.
+	it('resets the text around it to the body face at the body weight, aligned to the start, wrapping', () => {
+		const host = scene.mount(
+			`<div style="${TIP_RESET_CASES.map(({ property, staged }) => `${property}: ${staged}`).join('; ')}"><p data-reading="plain">Heading copy</p><p data-reading="declared" style="${TIP_RESET_CASES.map(({ property, reset }) => `${property}: ${reset}`).join('; ')}">Declared copy</p><div class="tooltip show" role="tooltip"><div class="tooltip-inner">Saved to the archive</div></div></div>`,
+		)
+		const plain = requireValue(host.querySelector('[data-reading="plain"]'), 'No plain text')
+		const declared = requireValue(
+			host.querySelector('[data-reading="declared"]'),
+			'No declared text',
+		)
+		const tip = requireValue(host.querySelector('.tooltip'), 'No tooltip')
+		// The plain paragraph is the control: the parent's treatment reaches it wherever the property
+		// inherits, so a tip that stopped resetting would read that treatment too. The paragraph
+		// declaring the recorded reset inline is what the tip is read against.
+		expect(
+			TIP_RESET_CASES.filter(
+				({ reading, inherited }) =>
+					inherited === (readStyle(plain, reading) === readStyle(declared, reading)),
+			).map(({ property }) => property),
+		).toEqual([])
+		expect(
+			TIP_RESET_CASES.filter(
+				({ reading }) => readStyle(tip, reading) !== readStyle(declared, reading),
+			).map(({ property }) => property),
+		).toEqual([])
+		expect(readStyle(tip, 'overflow-wrap')).toBe('break-word')
+		// The margin slot is declared empty, so the margin that reads it resolves to none at all.
+		expect(readPixels(tip, 'margin-top')).toBe(0)
+		expect(readPixels(tip, 'margin-left')).toBe(0)
+	})
+
+	it('caps, pads, rounds, and sizes the inner box from its own slots and the density and type scales', () => {
+		const host = scene.mount(
+			'<div style="width: 800px"><div class="tooltip show position-absolute" role="tooltip"><div class="tooltip-inner">Saves the draft to the archive and closes the editor so the next draft opens in its place</div></div></div>',
+		)
+		const tip = requireValue(host.querySelector('.tooltip'), 'No tooltip')
+		const inner = requireValue(host.querySelector('.tooltip-inner'), 'No inner box')
+		expect(readPixels(inner, 'width')).toBe(200)
+		expect(readStyle(inner, 'text-align')).toBe('center')
+		expect(readPixels(inner, 'padding-left')).toBe(8)
+		expect(readPixels(inner, 'padding-top')).toBe(4)
+		expect(readPixels(tip, 'font-size')).toBe(14)
+		expect(readPixels(inner, 'border-top-left-radius')).toBeCloseTo(6, 3)
+		expect(readToken(tip, '--bs-tooltip-padding-x')).toBe(readToken(tip, TOKEN_NAMES.space[4]))
+		expect(readToken(tip, '--bs-tooltip-padding-y')).toBe(readToken(tip, TOKEN_NAMES.space[2]))
+		// The factors are published at the document root, where every token the tip reads resolves
+		// its own value, so the retune is applied there rather than on the tip.
+		document.documentElement.style.setProperty(TOKEN_NAMES.factor.density, '2')
+		expect(readPixels(inner, 'padding-left')).toBe(16)
+		expect(readPixels(inner, 'padding-top')).toBe(8)
+		document.documentElement.style.setProperty(TOKEN_NAMES.factor.radius, '2')
+		expect(readPixels(inner, 'border-top-left-radius')).toBeCloseTo(12, 3)
+		// The text size reads the type scale's step rather than the release's literal, so a wrapper
+		// retuning that step moves it.
+		host.style.setProperty(TOKEN_NAMES.size[2], '20px')
+		expect(readPixels(tip, 'font-size')).toBe(20)
+	})
+})
+
+describe('tooltip arrow', () => {
+	// The mutation this catches is a placement's rules written for another side: that tip then hangs
+	// its arrow from the wrong edge and paints the wrong border of its triangle, which is what these
+	// readings pin.
+	it("hangs the arrow from the edge facing the host and paints the tip's fill on its border facing the tip, so it points at the host", () => {
+		const host = scene.mount(
+			`<div style="position: relative; height: 480px">${TIP_PLACEMENTS.map(
+				({ name, side }) =>
+					`<div class="tooltip bs-tooltip-${name} show position-absolute top-50 start-50 translate-middle" role="tooltip"><div class="tooltip-arrow position-absolute ${side === 'top' || side === 'bottom' ? 'start-50 translate-middle-x' : 'top-50 translate-middle-y'}"></div><div class="tooltip-inner">Tooltip on ${side}</div></div>`,
+			).join('')}</div>`,
+		)
+		for (const { name, side, edge } of TIP_PLACEMENTS) {
+			const tip = requireValue(host.querySelector(`.bs-tooltip-${name}`), `No ${name} tooltip`)
+			const arrow = requireValue(tip.querySelector('.tooltip-arrow'), `No ${name} arrow`)
+			const inner = requireValue(tip.querySelector('.tooltip-inner'), `No ${name} inner box`)
+			const box = tip.getBoundingClientRect()
+			const mark = arrow.getBoundingClientRect()
+			// The arrow lies wholly outside the tip, its own host-side edge on the tip's facing edge.
+			expect(mark[side]).toBeCloseTo(box[edge], 1)
+			const across = side === 'top' || side === 'bottom'
+			expect(readPixels(arrow, 'width')).toBeCloseTo(across ? 12.8 : 6.4, 1)
+			expect(readPixels(arrow, 'height')).toBeCloseTo(across ? 6.4 : 12.8, 1)
+			// The triangle paints only its border facing the tip, in the tip's own fill, and overlaps
+			// the tip by one pixel on that side.
+			expect(
+				matchesColor(
+					readStyle(arrow, `border-${side}-color`, '::before'),
+					readStyle(inner, 'background-color'),
+				),
+			).toBe(true)
+			// The engine snaps a border to whole device pixels, so the painted side reads the arrow's
+			// depth rounded down rather than its exact length.
+			expect(readPixels(arrow, `border-${side}-width`, '::before')).toBe(
+				Math.floor(readPixels(arrow, across ? 'height' : 'width')),
+			)
+			expect(readPixels(arrow, `border-${edge}-width`, '::before')).toBe(0)
+			expect(readStyle(arrow, side, '::before')).toBe('-1px')
+			for (const { side: other } of TIP_PLACEMENTS.filter((entry) => entry.side !== side))
+				expect(readStyle(arrow, `border-${other}-color`, '::before')).toBe('rgba(0, 0, 0, 0)')
+		}
+	})
+
+	// The mutation this catches is one automatic placement extending another side's class: its
+	// arrow then resolves that side's geometry rather than its own. Each explicit placement is first
+	// held apart from every other, so the equality is not one every placement satisfies.
+	it('resolves each automatic placement to the geometry of the explicit side its attribute names', () => {
+		const host = scene.mount(
+			`<div style="position: relative; height: 480px">${TIP_PLACEMENTS.map(
+				({ name, side }) =>
+					`<div class="tooltip bs-tooltip-${name} show position-absolute" data-explicit="${side}" role="tooltip"><div class="tooltip-arrow position-absolute"></div><div class="tooltip-inner">Placed</div></div><div class="tooltip bs-tooltip-auto show position-absolute" data-popper-placement="${side}" role="tooltip"><div class="tooltip-arrow position-absolute"></div><div class="tooltip-inner">Placed</div></div>`,
+			).join('')}</div>`,
+		)
+		const readings = TIP_PLACEMENTS.map(({ side }) => {
+			const [explicit, automatic] = [
+				`[data-explicit="${side}"] .tooltip-arrow`,
+				`[data-popper-placement="${side}"] .tooltip-arrow`,
+			].map((selector) => {
+				const arrow = requireValue(host.querySelector(selector), `No arrow at ${selector}`)
+				return [undefined, '::before'].flatMap((pseudo) =>
+					TIP_ARROW_PROPERTIES.map((property) => readStyle(arrow, property, pseudo)),
+				)
+			})
+			return { side, explicit, automatic }
+		})
+		expect(new Set(readings.map(({ explicit }) => JSON.stringify(explicit))).size).toBe(
+			TIP_PLACEMENTS.length,
+		)
+		for (const { explicit, automatic } of readings) expect(automatic).toEqual(explicit)
+	})
+})
+
+describe('tooltip colors', () => {
+	describe.each(TEXT_MODES)('in %s', (mode) => {
+		// The mutation this catches is a literal color: it paints the same at rest and follows no
+		// retuned alias, in either mode.
+		it('paints the emphasis alias as its fill and the body surface alias as its text', () => {
+			const host = scene.mount(
+				`<div data-bs-theme="${mode}"><div class="tooltip bs-tooltip-top show" role="tooltip"><div class="tooltip-arrow"></div><div class="tooltip-inner">Saved</div></div></div>`,
+			)
+			const island = requireValue(host.querySelector<HTMLElement>('[data-bs-theme]'), 'No island')
+			const inner = requireValue(host.querySelector('.tooltip-inner'), 'No inner box')
+			const arrow = requireValue(host.querySelector('.tooltip-arrow'), 'No arrow')
+			const fill = readToken(island, '--bs-emphasis-color')
+			const text = readToken(island, '--bs-body-bg')
+			// The island's own aliases are the mode's, so a dark island reads apart from the light root.
+			expect(matchesColor(fill, readRootToken('--bs-emphasis-color'))).toBe(mode === 'light')
+			expect(matchesColor(fill, text)).toBe(false)
+			expect(matchesColor(readStyle(inner, 'background-color'), fill)).toBe(true)
+			expect(matchesColor(readStyle(inner, 'color'), text)).toBe(true)
+			expect(matchesColor(readStyle(arrow, 'border-top-color', '::before'), fill)).toBe(true)
+			island.style.setProperty('--bs-emphasis-color', 'rgb(11, 22, 33)')
+			island.style.setProperty('--bs-body-bg', 'rgb(44, 55, 66)')
+			expect(readStyle(inner, 'background-color')).toBe('rgb(11, 22, 33)')
+			expect(readStyle(inner, 'color')).toBe('rgb(44, 55, 66)')
+			expect(readStyle(arrow, 'border-top-color', '::before')).toBe('rgb(11, 22, 33)')
