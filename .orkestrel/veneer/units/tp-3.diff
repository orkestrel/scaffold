@@ -0,0 +1,338 @@
+import { TOKEN_NAMES } from '@src/core'
+import { requireValue } from '@orkestrel/test'
+import {
+	findRule,
+	matchesColor,
+	readPixels,
+	readRootToken,
+	readStyle,
+	readToken,
+} from '@orkestrel/test/browser'
+import { afterEach, describe, expect, it } from 'vitest'
+import { collectLayer, scene } from '../../../setupBrowser.js'
+import {
+	POPOVER_SELECTORS,
+	TEXT_MODES,
+	TIP_ARROW_PROPERTIES,
+	TIP_PLACEMENTS,
+	TIP_RESET_CASES,
+	normalizeComplexSelector,
+	splitTopLevelList,
+	trimCSSWhitespace,
+} from '../../../setupStyles.js'
+
+afterEach(() => {
+	for (const token of [TOKEN_NAMES.factor.density, TOKEN_NAMES.factor.radius])
+		document.documentElement.style.removeProperty(token)
+	scene.clear()
+})
+
+describe('popover rules', () => {
+	// The mutation this catches is a rule the partial stops writing, or one it writes beyond the
+	// release: the reading is every components-layer selector naming one of the key's own classes,
+	// so a missing rule and an extra rule on the same classes each report here. The sheet writes an
+	// attribute value in quotes and the release records it bare, so the quotes are dropped before
+	// the two are compared.
+	it('writes the recorded popover selectors and no other rule on their classes', () => {
+		const written = new Set(
+			collectLayer('components').flatMap((rule) =>
+				rule instanceof CSSStyleRule
+					? splitTopLevelList(rule.selectorText)
+							.map((part) =>
+								normalizeComplexSelector(trimCSSWhitespace(part)).replaceAll(
+									/="(\w+)"\]/gu,
+									'=$1]',
+								),
+							)
+							.filter((selector) => /\.(?:popover|bs-popover)(?:-[\w-]+)?(?![\w-])/u.test(selector))
+					: [],
+			),
+		)
+		expect([...written].sort()).toEqual(
+			POPOVER_SELECTORS.map((selector) => normalizeComplexSelector(selector)).sort(),
+		)
+		expect(findRule('.popover-body')).not.toBeUndefined()
+	})
+})
+
+describe('popover box', () => {
+	// The mutation this catches is a stacking level written as the release's literal: it resolves
+	// the same level at rest and follows no retuned rung. A tooltip beside the popover is the
+	// control that the popover rung sits below the hint rung.
+	it('stacks on the popover rung below a tooltip and follows a wrapper that retunes it', () => {
+		const host = scene.mount(
+			'<div class="popover position-absolute" role="tooltip"><div class="popover-body">Resting</div></div><div style="--vn-stack-popover: 1234"><div class="popover position-absolute" role="tooltip"><div class="popover-body">Retuned</div></div></div><div class="tooltip show position-absolute" role="tooltip"><div class="tooltip-inner">Hint</div></div>',
+		)
+		const resting = requireValue(host.querySelector(':scope > .popover'), 'No resting popover')
+		const retuned = requireValue(host.querySelector('[style] > .popover'), 'No retuned popover')
+		const tip = requireValue(host.querySelector('.tooltip'), 'No tooltip')
+		expect(readRootToken(TOKEN_NAMES.stack.popover)).toBe('1070')
+		expect(readStyle(resting, 'z-index')).toBe('1070')
+		expect(Number(readStyle(resting, 'z-index'))).toBeLessThan(Number(readStyle(tip, 'z-index')))
+		expect(readStyle(retuned, 'z-index')).toBe('1234')
+	})
+
+	// The mutation this catches is the reset dropped from the popover rule: the popover then inherits
+	// the bold, uppercase, right-aligned, unwrapped treatment its parent stages, as the plain text
+	// beside it does.
+	it('resets the text around it to the body face at the body weight, aligned to the start, wrapping', () => {
+		const host = scene.mount(
+			`<div style="${TIP_RESET_CASES.map(({ property, staged }) => `${property}: ${staged}`).join('; ')}"><p data-reading="plain">Heading copy</p><p data-reading="declared" style="${TIP_RESET_CASES.map(({ property, reset }) => `${property}: ${reset}`).join('; ')}">Declared copy</p><div class="popover" role="tooltip"><div class="popover-body">Archived drafts stay for 30 days</div></div></div>`,
+		)
+		const plain = requireValue(host.querySelector('[data-reading="plain"]'), 'No plain text')
+		const declared = requireValue(
+			host.querySelector('[data-reading="declared"]'),
+			'No declared text',
+		)
+		const popover = requireValue(host.querySelector('.popover'), 'No popover')
+		// The plain paragraph is the control: the parent's treatment reaches it wherever the property
+		// inherits, so a popover that stopped resetting would read that treatment too. The paragraph
+		// declaring the recorded reset inline is what the popover is read against.
+		expect(
+			TIP_RESET_CASES.filter(
+				({ reading, inherited }) =>
+					inherited === (readStyle(plain, reading) === readStyle(declared, reading)),
+			).map(({ property }) => property),
+		).toEqual([])
+		expect(
+			TIP_RESET_CASES.filter(
+				({ reading }) => readStyle(popover, reading) !== readStyle(declared, reading),
+			).map(({ property }) => property),
+		).toEqual([])
+		expect(readStyle(popover, 'overflow-wrap')).toBe('break-word')
+	})
+
+	it('paints the same with and without the classes its engine sets', () => {
+		const host = scene.mount(
+			'<div class="popover" role="tooltip"><div class="popover-body">Resting</div></div><div class="popover fade show" role="tooltip"><div class="popover-body">Shown</div></div>',
+		)
+		const [resting, shown] = [
+			requireValue(host.querySelector('.popover:not(.show)'), 'No resting popover'),
+			requireValue(host.querySelector('.popover.show'), 'No shown popover'),
+		]
+		// No popover rule reads the `fade` class or the `show` class, so the popover an engine has
+		// shown paints what the resting one paints.
+		expect(readStyle(resting, 'opacity')).toBe('1')
+		expect(readStyle(shown, 'opacity')).toBe('1')
+		expect(readStyle(shown, 'display')).toBe(readStyle(resting, 'display'))
+	})
+
+	it('caps, borders, rounds, pads, and sizes the box from its own slots and the density and type scales', () => {
+		const host = scene.mount(
+			'<div style="width: 800px"><div class="popover position-absolute" role="tooltip"><h2 class="popover-header">Archive the draft</h2><div class="popover-body">The draft leaves the queue and moves to the archive, where it stays for 30 days before it is removed for good.</div></div></div>',
+		)
+		const popover = requireValue(host.querySelector('.popover'), 'No popover')
+		const header = requireValue(host.querySelector('.popover-header'), 'No header')
+		const body = requireValue(host.querySelector('.popover-body'), 'No body')
+		expect(readPixels(popover, 'width')).toBe(276)
+		expect(readPixels(popover, 'font-size')).toBe(14)
+		expect(readPixels(header, 'font-size')).toBe(16)
+		expect(readStyle(popover, 'background-clip')).toBe('padding-box')
+		for (const { side } of TIP_PLACEMENTS) {
+			expect(readPixels(popover, `border-${side}-width`)).toBe(1)
+			expect(readStyle(popover, `border-${side}-style`)).toBe('solid')
+		}
+		expect(readPixels(popover, 'border-top-left-radius')).toBeCloseTo(8, 3)
+		// The header rounds its top corners one edge width inside the box's own radius, and leaves
+		// its bottom corners square above the body.
+		expect(readPixels(header, 'border-top-left-radius')).toBeCloseTo(7, 3)
+		expect(readPixels(header, 'border-top-right-radius')).toBeCloseTo(7, 3)
+		expect(readPixels(header, 'border-bottom-left-radius')).toBe(0)
+		expect(readPixels(header, 'margin-bottom')).toBe(0)
+		expect(readPixels(header, 'border-bottom-width')).toBe(1)
+		expect([readPixels(header, 'padding-left'), readPixels(header, 'padding-top')]).toEqual([16, 8])
+		expect([readPixels(body, 'padding-left'), readPixels(body, 'padding-top')]).toEqual([16, 16])
+		// The factors are published at the document root, where every token the popover reads
+		// resolves its own value, so the retune is applied there rather than on the popover.
+		document.documentElement.style.setProperty(TOKEN_NAMES.factor.density, '2')
+		expect([readPixels(header, 'padding-left'), readPixels(header, 'padding-top')]).toEqual([
+			32, 16,
+		])
+		expect([readPixels(body, 'padding-left'), readPixels(body, 'padding-top')]).toEqual([32, 32])
+		document.documentElement.style.setProperty(TOKEN_NAMES.factor.radius, '2')
+		expect(readPixels(popover, 'border-top-left-radius')).toBeCloseTo(16, 3)
+		// The text sizes read the type scale's steps rather than the release's literals, so a wrapper
+		// retuning those steps moves them.
+		host.style.setProperty(TOKEN_NAMES.size[2], '20px')
+		host.style.setProperty(TOKEN_NAMES.size[3], '24px')
+		expect(readPixels(popover, 'font-size')).toBe(20)
+		expect(readPixels(header, 'font-size')).toBe(24)
+	})
+
+	// The mutation this catches is the empty-header rule dropped: an empty header then keeps its
+	// padding and its edge above the body.
+	it('removes an empty header from the flow and keeps a filled one', () => {
+		const host = scene.mount(
+			'<div class="popover" role="tooltip"><h2 class="popover-header"></h2><div class="popover-body">Body alone</div></div><div class="popover" role="tooltip"><h2 class="popover-header">Titled</h2><div class="popover-body">Body under a title</div></div>',
+		)
+		const [empty, filled] = [...host.querySelectorAll('.popover-header')]
+		expect(readStyle(requireValue(empty, 'No empty header'), 'display')).toBe('none')
+		expect(readStyle(requireValue(filled, 'No filled header'), 'display')).toBe('block')
+	})
+})
+
+describe('popover arrow', () => {
+	// The mutation this catches is a placement's rules written for another side: that popover then
+	// hangs its arrow from the wrong edge and paints the wrong border of its triangles, which is what
+	// these readings pin. The arrow's `::before` triangle paints the popover's edge color and the
+	// `::after` triangle, one edge width further in, paints its fill, so the arrow carries the border
+	// around its fill.
+	it('hangs the arrow past the edge facing the host and paints the edge color under the fill on its borders facing the popover, so it points at the host', () => {
+		const host = scene.mount(
+			`<div style="position: relative; height: 640px">${TIP_PLACEMENTS.map(
+				({ name, side }) =>
+					`<div class="popover bs-popover-${name} position-absolute top-50 start-50 translate-middle" role="tooltip"><div class="popover-arrow position-absolute ${side === 'top' || side === 'bottom' ? 'start-50 translate-middle-x' : 'top-50 translate-middle-y'}"></div><h2 class="popover-header">Popover on ${side}</h2><div class="popover-body">Placed</div></div>`,
+			).join('')}</div>`,
+		)
+		for (const { name, side, edge } of TIP_PLACEMENTS) {
+			const popover = requireValue(host.querySelector(`.bs-popover-${name}`), `No ${name} popover`)
+			const arrow = requireValue(popover.querySelector('.popover-arrow'), `No ${name} arrow`)
+			const box = popover.getBoundingClientRect()
+			const mark = arrow.getBoundingClientRect()
+			// The arrow lies wholly outside the popover's border box, its own host-side edge on the
+			// popover's facing outer edge.
+			expect(mark[side]).toBeCloseTo(box[edge], 1)
+			const across = side === 'top' || side === 'bottom'
+			expect(readPixels(arrow, 'width')).toBeCloseTo(across ? 16 : 8, 3)
+			expect(readPixels(arrow, 'height')).toBeCloseTo(across ? 8 : 16, 3)
+			const edgeColor = readStyle(popover, `border-${edge}-color`)
+			const fill = readStyle(popover, 'background-color')
+			expect(matchesColor(edgeColor, fill)).toBe(false)
+			expect(matchesColor(readStyle(arrow, `border-${side}-color`, '::before'), edgeColor)).toBe(
+				true,
+			)
+			expect(matchesColor(readStyle(arrow, `border-${side}-color`, '::after'), fill)).toBe(true)
+			expect(readStyle(arrow, edge, '::before')).toBe('0px')
+			expect(readStyle(arrow, edge, '::after')).toBe('1px')
+			expect(readPixels(arrow, `border-${side}-width`, '::before')).toBe(8)
+			expect(readPixels(arrow, `border-${side}-width`, '::after')).toBe(8)
+			expect(readPixels(arrow, `border-${edge}-width`, '::before')).toBe(0)
+			expect(readPixels(arrow, `border-${edge}-width`, '::after')).toBe(0)
+		}
+	})
+
+	// The mutation this catches is one automatic placement extending another side's class: its
+	// arrow then resolves that side's geometry rather than its own. Each explicit placement is first
+	// held apart from every other, so the equality is not one every placement satisfies.
+	it('resolves each automatic placement to the geometry of the explicit side its attribute names', () => {
+		const host = scene.mount(
+			`<div style="position: relative; height: 640px">${TIP_PLACEMENTS.map(
+				({ name, side }) =>
+					`<div class="popover bs-popover-${name} position-absolute" data-explicit="${side}" role="tooltip"><div class="popover-arrow position-absolute"></div><h2 class="popover-header">Placed</h2><div class="popover-body">Placed</div></div><div class="popover bs-popover-auto position-absolute" data-popper-placement="${side}" role="tooltip"><div class="popover-arrow position-absolute"></div><h2 class="popover-header">Placed</h2><div class="popover-body">Placed</div></div>`,
+			).join('')}</div>`,
+		)
+		const readings = TIP_PLACEMENTS.map(({ side }) => {
+			const [explicit, automatic] = [
+				`[data-explicit="${side}"]`,
+				`[data-popper-placement="${side}"]`,
+			].map((selector) => {
+				const arrow = requireValue(
+					host.querySelector(`${selector} > .popover-arrow`),
+					`No arrow at ${selector}`,
+				)
+				const header = requireValue(
+					host.querySelector(`${selector} > .popover-header`),
+					`No header at ${selector}`,
+				)
+				return [
+					...[undefined, '::before', '::after'].flatMap((pseudo) =>
+						TIP_ARROW_PROPERTIES.map((property) => readStyle(arrow, property, pseudo)),
+					),
+					readStyle(header, 'content', '::before'),
+				]
+			})
+			return { side, explicit, automatic }
+		})
+		expect(new Set(readings.map(({ explicit }) => JSON.stringify(explicit))).size).toBe(
+			TIP_PLACEMENTS.length,
+		)
+		for (const { explicit, automatic } of readings) expect(automatic).toEqual(explicit)
+	})
+
+	// The mutation this catches is the strip rule dropped: the header of a popover below its host
+	// then draws nothing where the arrow's fill meets the header's top edge.
+	it('lays a strip of the header fill under the arrow of a popover below its host alone', () => {
+		const host = scene.mount(
+			'<div class="popover bs-popover-bottom position-absolute" role="tooltip"><div class="popover-arrow"></div><h2 class="popover-header">Below</h2><div class="popover-body">Placed</div></div><div class="popover bs-popover-top position-absolute" role="tooltip"><div class="popover-arrow"></div><h2 class="popover-header">Above</h2><div class="popover-body">Placed</div></div>',
+		)
+		const below = requireValue(host.querySelector('.bs-popover-bottom'), 'No popover below')
+		const header = requireValue(below.querySelector('.popover-header'), 'No header below')
+		const above = requireValue(
+			host.querySelector('.bs-popover-top .popover-header'),
+			'No header above',
+		)
+		expect(readStyle(header, 'content', '::before')).toBe('""')
+		expect(readStyle(header, 'display', '::before')).toBe('block')
+		expect(readStyle(header, 'position', '::before')).toBe('absolute')
+		expect(readPixels(header, 'top', '::before')).toBe(0)
+		// The strip is as wide as the arrow and centered on the popover, where the arrow sits.
+		expect(readPixels(header, 'width', '::before')).toBe(16)
+		expect(readPixels(header, 'margin-left', '::before')).toBe(-8)
+		expect(readPixels(header, 'left', '::before')).toBeCloseTo(
+			(below.getBoundingClientRect().width - 2) / 2,
+			1,
+		)
+		expect(readPixels(header, 'border-bottom-width', '::before')).toBe(1)
+		expect(
+			matchesColor(
+				readStyle(header, 'border-bottom-color', '::before'),
+				readStyle(header, 'background-color'),
+			),
+		).toBe(true)
+		expect(readStyle(above, 'content', '::before')).toBe('none')
+	})
+})
+
+describe('popover colors', () => {
+	describe.each(TEXT_MODES)('in %s', (mode) => {
+		// The mutation this catches is a literal color: it paints the same at rest and follows no
+		// retuned alias, in either mode.
+		it('paints the body surface, the translucent edge, and the secondary header surface from their aliases', () => {
+			const host = scene.mount(
+				`<div data-bs-theme="${mode}"><div class="popover bs-popover-top" role="tooltip"><div class="popover-arrow"></div><h2 class="popover-header">Archive</h2><div class="popover-body">Moves the draft</div></div></div>`,
+			)
+			const island = requireValue(host.querySelector<HTMLElement>('[data-bs-theme]'), 'No island')
+			const popover = requireValue(host.querySelector('.popover'), 'No popover')
+			const header = requireValue(host.querySelector('.popover-header'), 'No header')
+			const body = requireValue(host.querySelector('.popover-body'), 'No body')
+			const arrow = requireValue(host.querySelector('.popover-arrow'), 'No arrow')
+			const aliases = [
+				'--bs-body-bg',
+				'--bs-border-color-translucent',
+				'--bs-secondary-bg',
+				'--bs-body-color',
+			] as const
+			const [surface, edge, secondary, text] = aliases
+			const resolved = aliases.map((name) => readToken(island, name))
+			// The island's own aliases are the mode's, so a dark island reads apart from the light root.
+			expect(matchesColor(readToken(island, surface), readRootToken(surface))).toBe(
+				mode === 'light',
+			)
+			expect(new Set(resolved).size).toBe(aliases.length)
+			expect(matchesColor(readStyle(popover, 'background-color'), readToken(island, surface))).toBe(
+				true,
+			)
+			expect(matchesColor(readStyle(popover, 'border-top-color'), readToken(island, edge))).toBe(
+				true,
+			)
+			expect(
+				matchesColor(readStyle(header, 'background-color'), readToken(island, secondary)),
+			).toBe(true)
+			expect(matchesColor(readStyle(body, 'color'), readToken(island, text))).toBe(true)
+			island.style.setProperty(surface, 'rgb(11, 22, 33)')
+			island.style.setProperty(edge, 'rgb(44, 55, 66)')
+			island.style.setProperty(secondary, 'rgb(77, 88, 99)')
+			island.style.setProperty(text, 'rgb(1, 2, 3)')
+			expect(readStyle(popover, 'background-color')).toBe('rgb(11, 22, 33)')
+			expect(readStyle(popover, 'border-top-color')).toBe('rgb(44, 55, 66)')
+			expect(readStyle(header, 'background-color')).toBe('rgb(77, 88, 99)')
+			expect(readStyle(body, 'color')).toBe('rgb(1, 2, 3)')
+			expect(readStyle(arrow, 'border-top-color', '::before')).toBe('rgb(44, 55, 66)')
+			expect(readStyle(arrow, 'border-top-color', '::after')).toBe('rgb(11, 22, 33)')
+			// The header's text slot inherits, so the header follows whatever text color the popover
+			// itself carries rather than a color of its own.
+			popover.setAttribute('style', 'color: rgb(5, 6, 7)')
+			expect(readStyle(header, 'color')).toBe('rgb(5, 6, 7)')
+		})
+	})
+})
