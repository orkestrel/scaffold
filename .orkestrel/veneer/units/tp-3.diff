+++ b/tests/app/browser/sections/TooltipSection.test.ts
@@ -0,0 +1,144 @@
+import type { SectionInterface } from '@app/browser'
+import { SpecimenSection, TOOLTIP_COPY, TOOLTIP_SPECIMENS, TooltipSection } from '@app/browser'
+import { requireValue } from '@orkestrel/test'
+import { build, mount, readClipEdge } from '@orkestrel/test/browser'
+import { beforeAll, describe, expect, it } from 'vitest'
+import { visitBreakpoint } from '../../../setupBrowser.js'
+import { TIP_PLACEMENTS, VIEWPORT_WIDTHS } from '../../../setupStyles.js'
+
+// The frame case reads the specimens as the published cascade and the shell lay them out, so both
+// stylesheets have to be in the document before a box is measured.
+beforeAll(async () => {
+	await import('../../../../src/styles/index.scss')
+	await import('../../../../app/browser/styles/index.scss')
+})
+
+describe('TooltipSection', () => {
+	it('renders one shown tip per explicit placement alone in a frame through the shared section contract', () => {
+		const host = mount(build('div'))
+		const section: SectionInterface = new TooltipSection(host)
+		try {
+			expect(section).toBeInstanceOf(SpecimenSection)
+			expect(section.host).toBe(host)
+			const region = requireValue(host.querySelector('section'), 'No Tooltip region')
+			expect(region.querySelector('[style]')).toBeNull()
+			expect(region.getAttribute('aria-label')).toBe('Tooltip')
+			expect(region.querySelector('p')?.textContent).toBe(TOOLTIP_COPY.paragraph)
+			const rendered = [...region.querySelectorAll('[data-specimen]')]
+			// Each specimen is named for the physical side of its host its tooltip sits on, in the
+			// placement order the table pins.
+			expect(rendered.map((element) => element.getAttribute('data-specimen'))).toEqual(
+				TIP_PLACEMENTS.map(({ side }) => `${side.charAt(0).toUpperCase()}${side.slice(1)} tooltip`),
+			)
+			expect(rendered.map((element) => element.innerHTML)).toEqual(
+				TOOLTIP_SPECIMENS.map(({ markup }) => markup),
+			)
+			// Each specimen is the shell's frame holding one tip and nothing else, in the placement
+			// order the table pins, and each tip stands in for the placement the engine would write
+			// with the shipped position utilities on the tip and on its arrow.
+			expect(rendered).toHaveLength(TIP_PLACEMENTS.length)
+			for (const [index, { name, side }] of TIP_PLACEMENTS.entries()) {
+				const specimen = requireValue(rendered[index], `No ${name} specimen`)
+				expect(specimen.children).toHaveLength(1)
+				const frame = requireValue(specimen.firstElementChild, `No ${name} frame`)
+				expect(frame.classList.contains('viewport')).toBe(true)
+				expect(frame.children).toHaveLength(1)
+				const tip = requireValue(frame.firstElementChild, `No ${name} tip`)
+				expect([...tip.classList]).toEqual([
+					'tooltip',
+					`bs-tooltip-${name}`,
+					'show',
+					'position-absolute',
+					'top-50',
+					'start-50',
+					'translate-middle',
+				])
+				expect(tip.getAttribute('role')).toBe('tooltip')
+				expect(tip.id).toBe(`${side}-tooltip`)
+				const arrow = requireValue(tip.querySelector(':scope > .tooltip-arrow'), `No ${name} arrow`)
+				expect([...arrow.classList]).toEqual(
+					side === 'top' || side === 'bottom'
+						? ['tooltip-arrow', 'position-absolute', 'start-50', 'translate-middle-x']
+						: ['tooltip-arrow', 'position-absolute', 'top-50', 'translate-middle-y'],
+				)
+				expect(tip.querySelector(':scope > .tooltip-inner')?.textContent).toBe(`Tooltip on ${side}`)
+			}
+			// Every tip's identity is its own, so a trigger naming one names that tip alone.
+			const ids = [...region.querySelectorAll('.tooltip')].map((tip) => tip.id)
+			expect(new Set(ids).size).toBe(TIP_PLACEMENTS.length)
+			// No specimen renders a trigger, claims the wiring a trigger would carry, or writes the
+			// automatic placement the engine writes, and no tip rests without the class that shows it.
+			expect(
+				region.querySelector('button, a, input, select, textarea, [tabindex], [data-bs-toggle]'),
+			).toBeNull()
+			expect(region.querySelector('[aria-describedby]')).toBeNull()
+			expect(region.querySelector('[data-popper-placement]')).toBeNull()
+			expect(region.querySelector('.bs-tooltip-auto')).toBeNull()
+			expect(region.querySelector('.tooltip:not(.show)')).toBeNull()
+			expect(Object.isFrozen(TOOLTIP_COPY)).toBe(true)
+			expect(Object.isFrozen(TOOLTIP_SPECIMENS)).toBe(true)
+			expect(TOOLTIP_SPECIMENS.every((entry) => Object.isFrozen(entry))).toBe(true)
+		} finally {
+			section.destroy()
+			host.remove()
+		}
+	})
+
+	it.each(VIEWPORT_WIDTHS)(
+		'keeps every tip and its arrow inside its frame at the %i variant',
+		async (width) => {
+			const host = mount(build('div'))
+			const section: SectionInterface = new TooltipSection(host)
+			try {
+				const readings = await visitBreakpoint(width, () =>
+					[...host.querySelectorAll('.viewport')].map((frame) => {
+						const tip = requireValue(frame.querySelector('.tooltip'), 'No tip in a frame')
+						const arrow = requireValue(frame.querySelector('.tooltip-arrow'), 'No arrow in a frame')
+						const box = frame.getBoundingClientRect()
+						const parts = [tip, arrow].map((element) => element.getBoundingClientRect())
+						// The clip edge is in document coordinates, so each bottom is read in them too; a
+						// part below the edge would be cut off at it, and a key hanging past its frame is
+						// the journey's validation-tooltip case rather than this one.
+						return {
+							edge: readClipEdge(frame),
+							bottom: Math.max(...parts.map((part) => part.bottom)) + window.scrollY,
+							inside: parts.every(
+								(part) =>
+									part.top >= box.top &&
+									part.left >= box.left &&
+									part.right <= box.right &&
+									part.bottom <= box.bottom,
+							),
+						}
+					}),
+				)
+				expect(readings).toHaveLength(TIP_PLACEMENTS.length)
+				for (const { edge, bottom, inside } of readings) {
+					expect(inside).toBe(true)
+					expect(bottom).toBeLessThanOrEqual(requireValue(edge, 'The frame clips nothing'))
+				}
+			} finally {
+				section.destroy()
+				host.remove()
+			}
+		},
+	)
+
+	it('releases the region and preserves adjacent content on repeated destruction', () => {
+		const host = mount(build('div'))
+		const neighbor = build('p', { text: 'Existing content' })
+		host.append(neighbor)
+		const section: SectionInterface = new TooltipSection(host)
+		try {
+			const region = requireValue(host.querySelector('section'), 'No Tooltip region')
+			expect(region.isConnected).toBe(true)
+			section.destroy()
+			expect(region.isConnected).toBe(false)
+			section.destroy()
+			expect([...host.children]).toEqual([neighbor])
+		} finally {
+			section.destroy()
+			host.remove()
+		}
+	})
+})
diff --git a/tests/src/styles/components/popover.test.ts b/tests/src/styles/components/popover.test.ts
