diff --git a/src/styles/components/_popover.scss b/src/styles/components/_popover.scss
new file mode 100644
index 0000000..eac6a1c
--- /dev/null
+++ b/src/styles/components/_popover.scss
@@ -0,0 +1,165 @@
+@use 'sass:map';
+@use '../mixins' as *;
+
+// Keys each explicit placement class by the physical side of its host the popover sits on, the
+// popover edge its arrow hangs from, and the widths of the arrow triangles' borders, so each side's
+// rules come from one entry. The placements are physical, as the release writes them: a popover
+// carrying the `bs-popover-end` class sits on the right of its host, and a popover carrying the
+// `bs-popover-start` class sits on its left.
+$sides: (
+	top: (
+		side: top,
+		edge: bottom,
+		borders: var(--bs-popover-arrow-height) calc(var(--bs-popover-arrow-width) * 0.5) 0,
+	),
+	end: (
+		side: right,
+		edge: left,
+		borders:
+			calc(var(--bs-popover-arrow-width) * 0.5) var(--bs-popover-arrow-height)
+				calc(var(--bs-popover-arrow-width) * 0.5) 0,
+	),
+	bottom: (
+		side: bottom,
+		edge: top,
+		borders: 0 calc(var(--bs-popover-arrow-width) * 0.5) var(--bs-popover-arrow-height),
+	),
+	start: (
+		side: left,
+		edge: right,
+		borders:
+			calc(var(--bs-popover-arrow-width) * 0.5) 0 calc(var(--bs-popover-arrow-width) * 0.5)
+				var(--bs-popover-arrow-height),
+	),
+);
+
+@layer components {
+	// The popover ships Bootstrap's recorded box. It stacks on the popover rung of the stacking
+	// ladder, below the hint rung a tooltip takes, and its insets and text sizes read the density
+	// and type scales. It paints the body surface and a translucent edge in either color mode, and
+	// its header paints the secondary surface. The release positions a popover through its
+	// placement engine, which writes the position and the offset on the element, so no rule here
+	// positions the box, and no rule reads the `fade` class or the `show` class the engine sets.
+	.popover {
+		--bs-popover-zindex: var(--vn-stack-popover);
+		--bs-popover-max-width: 276px;
+		--bs-popover-font-size: var(--vn-size-2);
+		--bs-popover-bg: var(--bs-body-bg);
+		--bs-popover-border-width: var(--bs-border-width);
+		--bs-popover-border-color: var(--bs-border-color-translucent);
+		--bs-popover-border-radius: var(--bs-border-radius-lg);
+		--bs-popover-inner-border-radius: calc(var(--bs-border-radius-lg) - var(--bs-border-width));
+		--bs-popover-box-shadow: var(--bs-box-shadow);
+		--bs-popover-header-padding-x: var(--vn-space-8);
+		--bs-popover-header-padding-y: var(--vn-space-4);
+		--bs-popover-header-font-size: var(--vn-size-3);
+		--bs-popover-header-color: inherit;
+		--bs-popover-header-bg: var(--bs-secondary-bg);
+		--bs-popover-body-padding-x: var(--vn-space-8);
+		--bs-popover-body-padding-y: var(--vn-space-8);
+		--bs-popover-body-color: var(--bs-body-color);
+		--bs-popover-arrow-width: 1rem;
+		--bs-popover-arrow-height: 0.5rem;
+		--bs-popover-arrow-border: var(--bs-popover-border-color);
+		z-index: var(--bs-popover-zindex);
+		display: block;
+		max-width: var(--bs-popover-max-width);
+		@include reset-text;
+		font-size: var(--bs-popover-font-size);
+		word-wrap: break-word;
+		background-color: var(--bs-popover-bg);
+		background-clip: padding-box;
+		border: var(--bs-popover-border-width) solid var(--bs-popover-border-color);
+		border-radius: var(--bs-popover-border-radius);
+	}
+
+	.popover .popover-arrow {
+		display: block;
+		width: var(--bs-popover-arrow-width);
+		height: var(--bs-popover-arrow-height);
+	}
+
+	// The arrow is two triangles stacked in one box: the `::before` triangle paints the popover's
+	// edge color, and the `::after` triangle, drawn over it, paints the popover's fill one edge width
+	// further in, so the arrow carries the popover's border around its fill.
+	.popover .popover-arrow::before,
+	.popover .popover-arrow::after {
+		position: absolute;
+		display: block;
+		content: '';
+		border-color: transparent;
+		border-style: solid;
+		border-width: 0;
+	}
+
+	// Each placement hangs the arrow outside the popover's edge that faces the host, past the
+	// popover's own border, and each triangle paints on its border on the popover's side, so the
+	// arrow points at the host. A side popover turns the arrow's box a quarter. Each automatic
+	// placement class the placement engine writes extends the explicit class of the side its
+	// attribute names, so the two resolve the same geometry, the bottom header strip included.
+	@each $class, $entry in $sides {
+		$side: map.get($entry, side);
+		$edge: map.get($entry, edge);
+
+		.bs-popover-#{$class} > .popover-arrow {
+			#{$edge}: calc(-1 * (var(--bs-popover-arrow-height)) - var(--bs-popover-border-width));
+			@if $side == right or $side == left {
+				width: var(--bs-popover-arrow-height);
+				height: var(--bs-popover-arrow-width);
+			}
+		}
+
+		.bs-popover-#{$class} > .popover-arrow::before,
+		.bs-popover-#{$class} > .popover-arrow::after {
+			border-width: map.get($entry, borders);
+		}
+
+		.bs-popover-#{$class} > .popover-arrow::before {
+			#{$edge}: 0;
+			border-#{$side}-color: var(--bs-popover-arrow-border);
+		}
+
+		.bs-popover-#{$class} > .popover-arrow::after {
+			#{$edge}: var(--bs-popover-border-width);
+			border-#{$side}-color: var(--bs-popover-bg);
+		}
+
+		.bs-popover-auto[data-popper-placement^='#{$side}'] {
+			@extend .bs-popover-#{$class};
+		}
+	}
+
+	// A popover below its host points its arrow up into the header, so a strip of the header's own
+	// fill, as wide as the arrow, covers the header's top edge where the arrow's fill meets it.
+	.bs-popover-bottom .popover-header::before {
+		position: absolute;
+		top: 0;
+		left: 50%;
+		display: block;
+		width: var(--bs-popover-arrow-width);
+		margin-left: calc(-0.5 * var(--bs-popover-arrow-width));
+		content: '';
+		border-bottom: var(--bs-popover-border-width) solid var(--bs-popover-header-bg);
+	}
+
+	.popover-header {
+		padding: var(--bs-popover-header-padding-y) var(--bs-popover-header-padding-x);
+		margin-bottom: 0;
+		font-size: var(--bs-popover-header-font-size);
+		color: var(--bs-popover-header-color);
+		background-color: var(--bs-popover-header-bg);
+		border-bottom: var(--bs-popover-border-width) solid var(--bs-popover-border-color);
+		border-top-left-radius: var(--bs-popover-inner-border-radius);
+		border-top-right-radius: var(--bs-popover-inner-border-radius);
+	}
+
+	// An empty header is removed from the flow, so a popover given no title shows its body alone.
+	.popover-header:empty {
+		display: none;
+	}
+
+	.popover-body {
+		padding: var(--bs-popover-body-padding-y) var(--bs-popover-body-padding-x);
+		color: var(--bs-popover-body-color);
+	}
+}
diff --git a/src/styles/components/_tooltip.scss b/src/styles/components/_tooltip.scss
new file mode 100644
index 0000000..f26ae42
--- /dev/null
+++ b/src/styles/components/_tooltip.scss
@@ -0,0 +1,120 @@
+@use 'sass:map';
+@use '../mixins' as *;
+
+// Keys each explicit placement class by the physical side of its host the tip sits on, the tip
+// edge its arrow hangs from, and the widths of the arrow triangle's borders, so each side's rules
+// come from one entry. The placements are physical, as the release writes them: a tip carrying the
+// `bs-tooltip-end` class sits on the right of its host, and a tip carrying the `bs-tooltip-start`
+// class sits on its left.
+$sides: (
+	top: (
+		side: top,
+		edge: bottom,
+		borders: var(--bs-tooltip-arrow-height) calc(var(--bs-tooltip-arrow-width) * 0.5) 0,
+	),
+	end: (
+		side: right,
+		edge: left,
+		borders:
+			calc(var(--bs-tooltip-arrow-width) * 0.5) var(--bs-tooltip-arrow-height)
+				calc(var(--bs-tooltip-arrow-width) * 0.5) 0,
+	),
+	bottom: (
+		side: bottom,
+		edge: top,
+		borders: 0 calc(var(--bs-tooltip-arrow-width) * 0.5) var(--bs-tooltip-arrow-height),
+	),
+	start: (
+		side: left,
+		edge: right,
+		borders:
+			calc(var(--bs-tooltip-arrow-width) * 0.5) 0 calc(var(--bs-tooltip-arrow-width) * 0.5)
+				var(--bs-tooltip-arrow-height),
+	),
+);
+
+@layer components {
+	// The tooltip ships Bootstrap's recorded tip. It stacks on the hint rung of the stacking ladder,
+	// its inset and its text size read the density and type scales, and it paints the emphasis
+	// color as its fill and the body surface as its text, so it inverts the page around it in either
+	// color mode. The release positions a tip through its placement engine, which writes the
+	// position and the offset on the element, so no rule here positions the tip. A tip rests
+	// transparent until it carries the `show` class.
+	.tooltip {
+		--bs-tooltip-zindex: var(--vn-stack-hint);
+		--bs-tooltip-max-width: 200px;
+		--bs-tooltip-padding-x: var(--vn-space-4);
+		--bs-tooltip-padding-y: var(--vn-space-2);
+		// The release declares the margin slot with no value, so the margin that reads it resolves to
+		// nothing. The interpolation compiles to that same empty declaration.
+		--bs-tooltip-margin: #{''};
+		--bs-tooltip-font-size: var(--vn-size-2);
+		--bs-tooltip-color: var(--bs-body-bg);
+		--bs-tooltip-bg: var(--bs-emphasis-color);
+		--bs-tooltip-border-radius: var(--bs-border-radius);
+		--bs-tooltip-opacity: 0.9;
+		--bs-tooltip-arrow-width: 0.8rem;
+		--bs-tooltip-arrow-height: 0.4rem;
+		z-index: var(--bs-tooltip-zindex);
+		display: block;
+		margin: var(--bs-tooltip-margin);
+		@include reset-text;
+		font-size: var(--bs-tooltip-font-size);
+		word-wrap: break-word;
+		opacity: 0;
+	}
+
+	.tooltip.show {
+		opacity: var(--bs-tooltip-opacity);
+	}
+
+	.tooltip .tooltip-arrow {
+		display: block;
+		width: var(--bs-tooltip-arrow-width);
+		height: var(--bs-tooltip-arrow-height);
+	}
+
+	.tooltip .tooltip-arrow::before {
+		position: absolute;
+		content: '';
+		border-color: transparent;
+		border-style: solid;
+	}
+
+	// Each placement hangs the arrow outside the tip's edge that faces the host, and the arrow's
+	// triangle paints the tip's fill on its border on the tip's side, so the triangle points at the
+	// host. A side tip turns the arrow's box a quarter. Each automatic placement class the placement
+	// engine writes extends the explicit class of the side its attribute names, so the two resolve
+	// the same geometry.
+	@each $class, $entry in $sides {
+		$side: map.get($entry, side);
+		$edge: map.get($entry, edge);
+
+		.bs-tooltip-#{$class} .tooltip-arrow {
+			#{$edge}: calc(-1 * var(--bs-tooltip-arrow-height));
+			@if $side == right or $side == left {
+				width: var(--bs-tooltip-arrow-height);
+				height: var(--bs-tooltip-arrow-width);
+			}
+		}
+
+		.bs-tooltip-#{$class} .tooltip-arrow::before {
+			#{$side}: -1px;
+			border-width: map.get($entry, borders);
+			border-#{$side}-color: var(--bs-tooltip-bg);
+		}
+
+		.bs-tooltip-auto[data-popper-placement^='#{$side}'] {
+			@extend .bs-tooltip-#{$class};
+		}
+	}
+
+	.tooltip-inner {
+		max-width: var(--bs-tooltip-max-width);
+		padding: var(--bs-tooltip-padding-y) var(--bs-tooltip-padding-x);
+		color: var(--bs-tooltip-color);
+		text-align: center;
+		background-color: var(--bs-tooltip-bg);
+		border-radius: var(--bs-tooltip-border-radius);
+	}
+}
diff --git a/tests/app/browser/sections/PopoverSection.test.ts b/tests/app/browser/sections/PopoverSection.test.ts
new file mode 100644
index 0000000..ea2a30a
--- /dev/null
+++ b/tests/app/browser/sections/PopoverSection.test.ts
@@ -0,0 +1,196 @@
+import type { SectionInterface } from '@app/browser'
+import { POPOVER_COPY, POPOVER_SPECIMENS, PopoverSection, SpecimenSection } from '@app/browser'
+import { requireValue } from '@orkestrel/test'
+import { build, mount, readClipEdge } from '@orkestrel/test/browser'
+import { beforeAll, describe, expect, it } from 'vitest'
+import { visitBreakpoint } from '../../../setupBrowser.js'
+import { TIP_PLACEMENTS, VIEWPORT_WIDTHS } from '../../../setupStyles.js'
+
+// The frame case reads the specimens as the published cascade and the shell lay them out, so both
+// stylesheets have to be in the document before a box is measured.
+beforeAll(async () => {
+	await import('../../../../src/styles/index.scss')
+	await import('../../../../app/browser/styles/index.scss')
+})
+
+describe('PopoverSection', () => {
+	it('renders one popover per explicit placement and an untitled popover alone in a frame through the shared section contract', () => {
+		const host = mount(build('div'))
+		const section: SectionInterface = new PopoverSection(host)
+		try {
+			expect(section).toBeInstanceOf(SpecimenSection)
+			expect(section.host).toBe(host)
+			const region = requireValue(host.querySelector('section'), 'No Popover region')
+			expect(region.querySelector('[style]')).toBeNull()
+			expect(region.getAttribute('aria-label')).toBe('Popover')
+			expect(region.querySelector('p')?.textContent).toBe(POPOVER_COPY.paragraph)
+			const rendered = [...region.querySelectorAll('[data-specimen]')]
+			// Each placement specimen is named for the physical side of its host its popover sits on,
+			// in the placement order the table pins, and the untitled popover follows them.
+			expect(rendered.map((element) => element.getAttribute('data-specimen'))).toEqual([
+				...TIP_PLACEMENTS.map(
+					({ side }) => `${side.charAt(0).toUpperCase()}${side.slice(1)} popover`,
+				),
+				'Untitled popover',
+			])
+			expect(rendered.map((element) => element.innerHTML)).toEqual(
+				POPOVER_SPECIMENS.map(({ markup }) => markup),
+			)
+			// Each specimen is the shell's frame holding one popover and nothing else, in the placement
+			// order the table pins, and each popover stands in for the placement the engine would write
+			// with the shipped position utilities on the popover and on its arrow. Each carries the
+			// release's template order: the arrow, the `h3` header, and the body.
+			for (const [index, { name, side }] of TIP_PLACEMENTS.entries()) {
+				const specimen = requireValue(rendered[index], `No ${name} specimen`)
+				expect(specimen.children).toHaveLength(1)
+				const frame = requireValue(specimen.firstElementChild, `No ${name} frame`)
+				expect(frame.classList.contains('viewport')).toBe(true)
+				expect(frame.children).toHaveLength(1)
+				const tip = requireValue(frame.firstElementChild, `No ${name} tip`)
+				expect([...tip.classList]).toEqual([
+					'popover',
+					`bs-popover-${name}`,
+					'position-absolute',
+					'top-50',
+					'start-50',
+					'translate-middle',
+				])
+				expect(tip.getAttribute('role')).toBe('tooltip')
+				expect(tip.id).toBe(`${side}-popover`)
+				expect(
+					[...tip.children].map((child) => `${child.tagName} ${child.classList[0] ?? ''}`),
+				).toEqual(['DIV popover-arrow', 'H3 popover-header', 'DIV popover-body'])
+				const arrow = requireValue(tip.querySelector(':scope > .popover-arrow'), `No ${name} arrow`)
+				expect([...arrow.classList]).toEqual(
+					side === 'top' || side === 'bottom'
+						? ['popover-arrow', 'position-absolute', 'start-50', 'translate-middle-x']
+						: ['popover-arrow', 'position-absolute', 'top-50', 'translate-middle-y'],
+				)
+				expect(tip.querySelector(':scope > .popover-header')?.textContent).toBe(
+					`Popover on ${side}`,
+				)
+				expect(tip.querySelector(':scope > .popover-body')?.textContent).not.toBe('')
+			}
+			// The untitled popover sits below its host in its own frame, with the release's template
+			// order, an empty header, and a populated body, so the rule hiding an empty header renders.
+			const untitled = requireValue(
+				rendered[TIP_PLACEMENTS.length]?.querySelector(':scope > .viewport > .popover'),
+				'No untitled popover',
+			)
+			expect([...untitled.classList]).toEqual([
+				'popover',
+				'bs-popover-bottom',
+				'position-absolute',
+				'top-50',
+				'start-50',
+				'translate-middle',
+			])
+			expect(untitled.id).toBe('untitled-popover')
+			expect(
+				[...untitled.children].map((child) => `${child.tagName} ${child.classList[0] ?? ''}`),
+			).toEqual(['DIV popover-arrow', 'H3 popover-header', 'DIV popover-body'])
+			expect(untitled.querySelector(':scope > .popover-header')?.childNodes).toHaveLength(0)
+			expect(untitled.querySelector(':scope > .popover-body')?.textContent).not.toBe('')
+			// Every popover's identity is its own, so a trigger naming one names that popover alone.
+			const ids = [...region.querySelectorAll('.popover')].map((tip) => tip.id)
+			expect(new Set(ids).size).toBe(rendered.length)
+			// No specimen renders a trigger, claims the wiring a trigger would carry, writes the
+			// automatic placement the engine writes, or carries the engine's `fade` and `show` classes,
+			// which no popover rule reads.
+			expect(
+				region.querySelector('button, a, input, select, textarea, [tabindex], [data-bs-toggle]'),
+			).toBeNull()
+			expect(region.querySelector('[aria-describedby]')).toBeNull()
+			expect(region.querySelector('[data-popper-placement]')).toBeNull()
+			expect(region.querySelector('.bs-popover-auto')).toBeNull()
+			expect(region.querySelector('.fade, .show')).toBeNull()
+			expect(Object.isFrozen(POPOVER_COPY)).toBe(true)
+			expect(Object.isFrozen(POPOVER_SPECIMENS)).toBe(true)
+			expect(POPOVER_SPECIMENS.every((entry) => Object.isFrozen(entry))).toBe(true)
+		} finally {
+			section.destroy()
+			host.remove()
+		}
+	})
+
+	it.each(VIEWPORT_WIDTHS)(
+		'keeps every popover and its arrow inside its frame at the %i variant',
+		async (width) => {
+			const host = mount(build('div'))
+			const section: SectionInterface = new PopoverSection(host)
+			try {
+				const readings = await visitBreakpoint(width, () =>
+					[...host.querySelectorAll('.viewport')].map((frame) => {
+						const tip = requireValue(frame.querySelector('.popover'), 'No popover in a frame')
+						const arrow = requireValue(frame.querySelector('.popover-arrow'), 'No arrow in a frame')
+						const box = frame.getBoundingClientRect()
+						const parts = [tip, arrow].map((element) => element.getBoundingClientRect())
+						// The clip edge is in document coordinates, so each bottom is read in them too; a
+						// part below the edge would be cut off at it, and a key hanging past its frame is
+						// the journey's validation-tooltip case rather than this one.
+						return {
+							edge: readClipEdge(frame),
+							bottom: Math.max(...parts.map((part) => part.bottom)) + window.scrollY,
+							inside: parts.every(
+								(part) =>
+									part.top >= box.top &&
+									part.left >= box.left &&
+									part.right <= box.right &&
+									part.bottom <= box.bottom,
+							),
+						}
+					}),
+				)
+				expect(readings).toHaveLength(POPOVER_SPECIMENS.length)
+				for (const { edge, bottom, inside } of readings) {
+					expect(inside).toBe(true)
+					expect(bottom).toBeLessThanOrEqual(requireValue(edge, 'The frame clips nothing'))
+				}
+			} finally {
+				section.destroy()
+				host.remove()
+			}
+		},
+	)
+
+	// The mutation this catches is a stand-in that leaves a popover its whole frame to lay out in, or
+	// a cap the box stops reading: the `left: 50%` offset the `start-50` utility writes leaves an
+	// absolutely positioned popover half its frame, so at the 390 variant each popover wraps narrower
+	// than its `276px` cap, and at the 1280 variant each one reaches the cap.
+	it('wraps each popover narrower than its cap at the 390 variant and holds it at the cap at 1280', async () => {
+		const host = mount(build('div'))
+		const section: SectionInterface = new PopoverSection(host)
+		try {
+			const narrow = await visitBreakpoint(390, () =>
+				[...host.querySelectorAll('.popover')].map((tip) => tip.getBoundingClientRect().width),
+			)
+			const wide = await visitBreakpoint(1280, () =>
+				[...host.querySelectorAll('.popover')].map((tip) => tip.getBoundingClientRect().width),
+			)
+			expect(narrow).toHaveLength(POPOVER_SPECIMENS.length)
+			expect(narrow.filter((width) => width >= 276)).toEqual([])
+			expect(wide).toEqual(POPOVER_SPECIMENS.map(() => 276))
+		} finally {
+			section.destroy()
+			host.remove()
+		}
+	})
+
+	it('releases the region and preserves adjacent content on repeated destruction', () => {
+		const host = mount(build('div'))
+		const neighbor = build('p', { text: 'Existing content' })
+		host.append(neighbor)
+		const section: SectionInterface = new PopoverSection(host)
+		try {
+			const region = requireValue(host.querySelector('section'), 'No Popover region')
+			expect(region.isConnected).toBe(true)
+			section.destroy()
+			expect(region.isConnected).toBe(false)
+			section.destroy()
+			expect([...host.children]).toEqual([neighbor])
+		} finally {
+			section.destroy()
+			host.remove()
+		}
+	})
+})
diff --git a/tests/app/browser/sections/TooltipSection.test.ts b/tests/app/browser/sections/TooltipSection.test.ts
