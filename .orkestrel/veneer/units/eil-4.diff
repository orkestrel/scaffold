+describe('figure around an attributed quotation', () => {
+	// Bootstrap's footer pulls its start margin up by the quotation's end margin, so the footer
+	// starts where the quotation ends, and the footer class replaces the caption's start margin.
+	it.each(FIGURE_QUOTATION_CASES)(
+		'starts the footer at the quotation edge inside $holder',
+		({ attribute }) => {
+			const host = scene.mount(
+				`<figure${attribute}><blockquote class="blockquote"><p>Quoted words.</p></blockquote><figcaption class="blockquote-footer">Source</figcaption></figure>`,
+			)
+			const quotation = requireValue(host.querySelector('.blockquote'), 'No quotation')
+			const footer = requireValue(host.querySelector('.blockquote-footer'), 'No footer')
+			expect(footer.getBoundingClientRect().top).toBeCloseTo(
+				quotation.getBoundingClientRect().bottom,
+				1,
+			)
+		},
+	)
+
+	// The quotation text and the footer carry fixed heights, 30px and 20px, so the readings hold
+	// whatever type either cascade sets. In block flow the footer's 16px end margin leaves the
+	// figure and collapses into the space before the next block: the figure box ends at the
+	// footer's edge, 50px down, and the paragraph starts 16px later, where the release's own
+	// figure margin puts it. A figure that kept the margin inside its box would read 66px tall.
+	it.each(FIGURE_QUOTATION_CASES)(
+		'ends the figure at the footer edge and starts the next block 16px later inside $holder',
+		({ attribute }) => {
+			const host = scene.mount(
+				`<div><figure${attribute}><blockquote class="blockquote"><p style="height: 30px">Quoted words.</p></blockquote><figcaption class="blockquote-footer" style="height: 20px">Source</figcaption></figure><p>Following words.</p></div>`,
+			)
+			const figure = requireValue(host.querySelector('figure'), 'No figure').getBoundingClientRect()
+			const next = requireValue(
+				host.querySelector('figure + p'),
+				'No following paragraph',
+			).getBoundingClientRect()
+			expect(figure.height).toBeCloseTo(50, 1)
+			expect(next.top - figure.top).toBeCloseTo(66, 1)
+		},
+	)
+})
+
+describe('figure around a captioned image', () => {
+	// The caption carries its own start margin, so the space under the image holds whether the
+	// tag's flow or a display utility decides the figure's layout.
+	it.each(FIGURE_IMAGE_CASES)(
+		'spaces the caption 8px under its image inside $holder',
+		async ({ attribute }) => {
+			const host = scene.mount(
+				`<figure${attribute}><img alt="Captioned specimen" width="120" height="80" src="${IMAGE_SOURCE}"><figcaption>Caption</figcaption></figure>`,
+			)
+			const image = requireValue(host.querySelector('img'), 'No image')
+			await image.decode()
+			const caption = requireValue(host.querySelector('figcaption'), 'No caption')
+			expect(
+				caption.getBoundingClientRect().top - image.getBoundingClientRect().bottom,
+			).toBeCloseTo(8, 1)
+		},
+	)
+})
