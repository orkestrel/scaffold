+/**
+ * Reads the cascade-layer order the given stylesheets put a document in.
+ *
+ * @param sheets - The stylesheets to walk, in the order the document loaded them. The document's
+ *   own sheets are the default, which is the effective order every rule on the page resolves
+ *   against; a caller reading one sheet's own order passes that sheet alone.
+ * @returns Each layer name at the position it was first declared, whether a `@layer` statement or
+ *   a `@layer` block declared it, with a name declared again reported once at its first position.
+ *
+ * @remarks
+ * Layer order is settled by first declaration, so the reading has to be a first-appearance walk
+ * rather than a list of blocks: the shipped cascade names `base` in a statement and fills no block
+ * for it, and a stylesheet that pairs Tailwind with the cascade re-declares names the cascade
+ * already placed. Both readings are what a profile proof compares, and neither is a rule count.
+ *
+ * A sheet whose rules the document cannot read is skipped rather than ending the walk.
+ */
+export function collectLayerOrder(
+	sheets: Iterable<CSSStyleSheet> = document.styleSheets,
+): readonly string[] {
+	const order: string[] = []
+	for (const sheet of sheets) {
+		let rules: readonly CSSRule[]
+		try {
+			rules = collectNestedRules(sheet.cssRules)
+		} catch {
+			continue
+		}
+		for (const rule of rules) {
+			const names =
+				rule instanceof CSSLayerStatementRule
+					? Array.from(rule.nameList)
+					: rule instanceof CSSLayerBlockRule
+						? [rule.name]
+						: []
+			for (const name of names) {
+				if (!order.includes(name)) order.push(name)
+			}
+		}
+	}
+	return order
+}
