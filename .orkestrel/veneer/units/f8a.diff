+ * A sheet whose rules the document cannot read is skipped rather than ending the walk.
+ */
+export function collectCustomProperties(
+	sheets: Iterable<CSSStyleSheet> = document.styleSheets,
+): readonly string[] {
+	const declared: string[] = []
+	for (const sheet of sheets) {
+		let rules: readonly CSSRule[]
+		try {
+			rules = collectNestedRules(sheet.cssRules)
+		} catch {
+			continue
+		}
+		for (const rule of rules) {
+			if (!(rule instanceof CSSStyleRule)) continue
+			for (const property of rule.style) {
+				if (property.startsWith('--') && !declared.includes(property)) declared.push(property)
+			}
+		}
+	}
+	return declared
+}
