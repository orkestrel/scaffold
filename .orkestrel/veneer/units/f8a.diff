@@ -0,0 +1,146 @@
+import { requireValue } from '@orkestrel/test'
+import { afterEach, describe, expect, it } from 'vitest'
+import {
+	collectCustomProperties,
+	collectLayerOrder,
+	collectNestedRules,
+	readCascadeSheet,
+	scene,
+} from '../setupBrowser.js'
+import tailwindProfile from '../setup.css?inline'
+import tailwindSource from '../setup.css?raw'
+import preflightProfile from '../fixtures/tailwind/preflight.css?inline'
+import unexcludedInstrument from '../fixtures/tailwind/unexcluded.css?inline'
+
+// The order Veneer's own `_tokens.scss` partial declares, which every profile repeats unchanged.
+const ORDER = ['theme', 'reset', 'base', 'elements', 'components', 'utilities']
+
+// The floor the exclusion list has to clear. A scan that reached the compiler with nothing in it
+// emits no rule at all, which would satisfy every other reading in this file, so the instrument
+// has to be shown emitting these before its silence under the exclusion line means anything.
+const REACHED = ['.container', '.table', '.col-1', '.caption-top', '.caption-bottom']
+
+/**
+ * Reads the layer-order statement one profile's compiled stylesheet opens with.
+ *
+ * @param sheet - The loaded profile's stylesheet.
+ * @returns The layer names the opening statement lists, in declared order.
+ * @throws An `Error` when the sheet opens with anything other than a layer statement.
+ */
+function readOrderLine(sheet: CSSStyleSheet): readonly string[] {
+	const [first] = Array.from(sheet.cssRules)
+	if (!(first instanceof CSSLayerStatementRule)) {
+		throw new Error(`The profile opens with ${first?.cssText ?? 'no rule'}`)
+	}
+	return Array.from(first.nameList)
+}
+
+/**
+ * Reads the layer blocks one profile's compiled stylesheet fills.
+ *
+ * @param sheet - The loaded profile's stylesheet.
+ * @returns Each filled layer's name, in the order the stylesheet opens the blocks.
+ */
+function readFilledLayers(sheet: CSSStyleSheet): readonly string[] {
+	return collectNestedRules(sheet.cssRules).flatMap((rule) =>
+		rule instanceof CSSLayerBlockRule ? [rule.name] : [],
+	)
+}
+
+/**
+ * Reads the selectors one profile's compiled stylesheet declares rules for.
+ *
+ * @param sheet - The loaded profile's stylesheet.
+ * @returns Each style rule's selector text, in declaration order.
+ */
+function readSelectors(sheet: CSSStyleSheet): readonly string[] {
+	return collectNestedRules(sheet.cssRules).flatMap((rule) =>
+		rule instanceof CSSStyleRule ? [rule.selectorText] : [],
+	)
+}
+
+/**
+ * Loads one compiled profile after the shipped cascade, the way a consumer's own sheet arrives.
+ *
+ * @param compiled - The profile's compiled stylesheet text.
+ * @returns The stylesheet the document parsed it into.
+ * @throws An `Error` when the document parses the profile into no stylesheet.
+ */
+function loadProfile(compiled: string): CSSStyleSheet {
+	return requireValue(scene.load(compiled).sheet, 'The profile parsed to no stylesheet')
+}
+
+/**
+ * Reads the excluded class names from the one place the workspace writes them.
+ *
+ * @returns Each name the `tailwind` profile's exclusion line withholds from Tailwind.
+ * @throws An `Error` when `tests/setup.css` carries no exclusion line.
+ *
+ * @remarks
+ * The names are read from the profile's own bytes rather than repeated here, so the exclusion line
+ * stays the single home of the list. The source arrives through a raw import, so the reading is of
+ * what the file says rather than of what the compiler did with it.
+ */
+function readExcluded(): readonly string[] {
+	const match = /@source not inline\("([^"]*)"\)/u.exec(tailwindSource)
+	const [, list] = match ?? []
+	if (list === undefined) throw new Error('The tailwind profile declares no exclusion line')
+	return list.split(/\s+/u).filter((name) => name !== '')
+}
+
+afterEach(() => {
+	scene.clear()
+})
+
+describe('stylesheet profiles', () => {
+	it('opens every profile with the one order line, and leaves the document order unmoved', () => {
+		// The cascade is loaded as a setup file, so its own order statement is already the
+		// document's. A profile arriving after it re-declares names that are already placed, which
+		// is what makes the pairing safe: a layer's position is settled by its first declaration.
+		expect(collectLayerOrder()).toEqual(ORDER)
+		for (const compiled of [tailwindProfile, preflightProfile, unexcludedInstrument]) {
+			const sheet = loadProfile(compiled)
+			expect(readOrderLine(sheet)).toEqual(ORDER)
+			expect(collectLayerOrder()).toEqual(ORDER)
+		}
+	})
+	it('fills Tailwind reset only under the preflight profile', () => {
+		// This is the difference the two profile names stand for. The `tailwind` profile composes
+		// the theme and utilities imports and reaches no reset; the `preflight` profile takes the
+		// bare import, which fills the `base` layer with Tailwind's reset and declares Tailwind's
+		// own theme tokens beside it.
+		const tailwind = loadProfile(tailwindProfile)
+		expect(readFilledLayers(tailwind)).toEqual([])
+		expect(collectCustomProperties([tailwind])).toEqual([])
+		scene.clear()
+		const preflight = loadProfile(preflightProfile)
+		expect(readFilledLayers(preflight)).toEqual(['theme', 'base'])
+		expect(collectCustomProperties([preflight])).toContain('--font-sans')
+		expect(readSelectors(preflight)).not.toEqual([])
+	})
+	it('withholds every shared class name the exclusion line names, and emits them without it', () => {
+		const excluded = readExcluded()
+		for (const selector of REACHED) expect(excluded).toContain(selector.slice(1))
+		// The instrument is the `tailwind` profile without its exclusion line, so what it emits and
+		// the profile does not is exactly what the line withheld. Reading the instrument first
+		// proves the candidates list reached the compiler at all.
+		const instrument = loadProfile(unexcludedInstrument)
+		const emitted = readSelectors(instrument)
+		for (const selector of REACHED) expect(emitted).toContain(selector)
+		// Every name the compiler generated is named on the line, so the line is complete for the
+		// class names this release ships rather than merely covering the ones listed here.
+		expect(emitted.filter((selector) => !excluded.includes(selector.slice(1)))).toEqual([])
+		scene.clear()
+		expect(readSelectors(loadProfile(tailwindProfile))).toEqual([])
+	})
+	it('answers with Veneer stylesheet while a Tailwind stylesheet is loaded', () => {
+		const cascade = requireValue(readCascadeSheet(), 'The document loaded no Veneer cascade')
+		const preflight = loadProfile(preflightProfile)
+		// The preflight profile fills a `theme` layer block, which is what the reader used to
+		// select a sheet by, so this is the sheet a signature of that shape would answer with.
+		expect(readFilledLayers(preflight)).toContain('theme')
+		expect(readCascadeSheet([preflight])).toBeUndefined()
+		expect(readCascadeSheet([preflight, cascade])).toBe(cascade)
+		expect(readCascadeSheet()).toBe(cascade)
+	})
+})
