+/**
+ * Describes where the shown menus of a region's specimens lie against the specimens holding them.
+ *
+ * @remarks
+ * A capture frame is shot on a specimen's own box. A shown menu positioned out of flow adds
+ * nothing to that box and can reach past any edge of it, where the frame that claims to show the
+ * menu crops it. A shown menu in flow grows the box that holds it. The helper measures both kinds
+ * the same way, against the specimen's box as laid out. Each entry is the label of the specimen
+ * holding the menu, one entry per menu.
+ */
+export interface MenuContainment {
+	/** Lists the label of the specimen holding each shown menu, in document order. */
+	readonly measured: readonly string[]
+	/** Lists the specimen label of each shown menu that reaches past its box or paints no box. */
+	readonly escaped: readonly string[]
+}
+
+/**
+ * Reads, at one viewport width, whether each shown menu in a root lies inside its specimen.
+ *
+ * @param root - The root whose labelled specimens are read, such as a mounted section's region.
+ * @param width - The viewport width in CSS pixels the reading is taken at.
+ * @returns Every shown menu's specimen label, and the labels of the menus that reach past any
+ *   edge of their specimen's box or are not rendered.
+ * @throws When the viewport does not reach the width, or when resizing fails; the starting size is
+ *   restored either way, as {@link visitBreakpoint} restores it.
+ *
+ * @remarks
+ * A shown menu is an element carrying the `dropdown-menu` and `show` classes inside an element
+ * carrying the {@link SPECIMEN_ATTRIBUTE} attribute. The grid and the bar reflow between the
+ * widths a journey renders, so a caller reads each width it photographs. A menu the cascade leaves
+ * unrendered has no box to hold, so it is reported as escaped rather than as held.
+ *
+ * @example
+ * ```ts
+ * const { measured, escaped } = await readMenuContainment(region, 390)
+ * ```
+ */
+export async function readMenuContainment(
+	root: ParentNode,
+	width: number,
+): Promise<MenuContainment> {
+	return visitBreakpoint(width, () => {
+		if (window.innerWidth !== width) {
+			throw new Error(
+				`The viewport renders ${String(window.innerWidth)} wide, not ${String(width)}`,
+			)
+		}
+		const measured: string[] = []
+		const escaped: string[] = []
+		for (const specimen of root.querySelectorAll(`[${SPECIMEN_ATTRIBUTE}]`)) {
+			const name = String(specimen.getAttribute(SPECIMEN_ATTRIBUTE))
+			const frame = specimen.getBoundingClientRect()
+			for (const menu of specimen.querySelectorAll('.dropdown-menu.show')) {
+				measured.push(name)
+				const box = menu.getBoundingClientRect()
+				if (
+					menu.getClientRects().length === 0 ||
+					box.top < frame.top ||
+					box.bottom > frame.bottom ||
+					box.left < frame.left ||
+					box.right > frame.right
+				)
+					escaped.push(name)
+			}
+		}
+		return { measured, escaped }
+	})
+}
