+/**
+ * Renders the key that names a rule by its selector and the condition it sits under.
+ *
+ * @param rule - The rule's selector and condition, as a cascade block or a recorded rule carries
+ *   them.
+ * @returns The selector for a rule under no condition, and the selector, a space, and the
+ *   condition otherwise.
+ *
+ * @remarks
+ * This key is the lookup contract of the {@link collectDeclarationReads} helper: each entry that
+ * helper returns is found by the key this function renders for the recorded rule or the case row
+ * naming it. An empty condition is still a condition, so only `undefined` renders the selector
+ * alone.
+ *
+ * @example
+ * ```ts
+ * renderRuleKey({ selector: '.form-range', condition: '@media (prefers-reduced-motion: reduce)' })
+ * // '.form-range @media (prefers-reduced-motion: reduce)'
+ * ```
+ */
+export function renderRuleKey(rule: Pick<CascadeBlock, 'selector' | 'condition'>): string {
+	return rule.condition === undefined ? rule.selector : `${rule.selector} ${rule.condition}`
+}
+
+/**
+ * Collects the custom properties each declaration of a compiled cascade reads, keyed by selector
+ * and condition.
+ *
+ * @param blocks - The cascade's blocks, as the {@link readCascadeBlocks} helper reads them.
+ * @returns One entry per selector and condition, in the order each key is first written, keyed by
+ *   the selector for a block under no condition and by the selector, a space, and the condition
+ *   otherwise. Each entry maps every property whose declaration reads a custom property to the
+ *   names that declaration reads, in written order.
+ *
+ * @remarks
+ * Every key is the one the {@link renderRuleKey} helper renders for the block. A reduced-motion
+ * twin carries its resting rule's selector, so the condition in the key is what keeps the twin's
+ * declarations out of the resting entry. Blocks sharing a key merge into one entry, and a later
+ * declaration of a property replaces what the earlier one read. A property whose declaration reads
+ * no custom property is absent from the entry, so a rule writing no `var()` at all reads as an
+ * empty entry rather than as no entry.
+ */
+export function collectDeclarationReads(
+	blocks: readonly CascadeBlock[],
+): ReadonlyMap<string, Readonly<Record<string, readonly string[]>>> {
+	const declared = new Map<string, Map<string, readonly string[]>>()
+	for (const block of blocks) {
+		const key = renderRuleKey(block)
+		const properties = declared.get(key) ?? new Map<string, readonly string[]>()
+		for (const [property, value] of block.declarations)
+			properties.set(property, collectValueNames(value))
+		declared.set(key, properties)
+	}
+	return new Map(
+		[...declared].map(([key, properties]) => [
+			key,
+			Object.fromEntries([...properties].filter(([, names]) => names.length > 0)),
+		]),
+	)
+}
+
+/**
+ * Filters a compiled cascade's blocks down to those a component's recorded rules are compared
+ * against.
+ *
+ * @param blocks - The cascade's blocks, as the {@link readCascadeBlocks} helper reads them.
+ * @param prefix - The selector text every compared block opens with.
+ * @param rules - The component's recorded rules, whose conditions bound the population.
+ * @returns Each block whose selector opens with `prefix` and whose condition, normalized by the
+ *   {@link normalizeMediaCondition} helper, is one a recorded rule sits under, in written order.
+ *
+ * @remarks
+ * A block under a condition no recorded rule sits under is this package's own addition rather than
+ * a recorded rule, so the additions ledger holds it and the comparison leaves it out. A block under
+ * a recorded condition stays in whether or not a rule records its selector, so a written rule no
+ * row names still reddens the comparison.
+ */
+export function filterComparableBlocks(
+	blocks: readonly CascadeBlock[],
+	prefix: string,
+	rules: ReadonlyArray<Pick<CascadeBlock, 'condition'>>,
+): readonly CascadeBlock[] {
+	const conditions = new Set(rules.map((rule) => normalizeMediaCondition(rule.condition)))
+	return blocks.filter(
+		(block) =>
+			block.selector.startsWith(prefix) && conditions.has(normalizeMediaCondition(block.condition)),
+	)
+}
