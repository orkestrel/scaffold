+/** Holds the Pagination section's visible copy and accessible name. */
+export const PAGINATION_COPY = Object.freeze({
+	region: 'Pagination',
+	paragraph:
+		'Walk a page strip at each size, and read its current page, its unavailable pages, and the chrome its pointer and keyboard states paint.',
+})
+
+/**
+ * Lists every pagination specimen the section renders, in render order.
+ *
+ * @remarks
+ * Each page carries its own accessible name, because the journey reaches a link by that name and a
+ * label repeated across specimens would resolve to whichever came first. The current page is marked
+ * on the item in the resting strip and on the link in the strip beside it, and the unavailable
+ * pages are marked each of those ways as well, so every spelling the cascade writes a rule for is
+ * rendered somewhere on the page.
+ */
+export const PAGINATION_SPECIMENS: readonly MarkupSpecimen[] = Object.freeze(
+	[
+		{
+			name: 'Page strip',
+			size: '',
+			pages: [
+				{ text: 'Previous page', item: '', link: '', current: false, blocked: false },
+				{ text: 'Page 1', item: '', link: '', current: false, blocked: false },
+				{ text: 'Page 2', item: ' active', link: '', current: true, blocked: false },
+				{ text: 'Page 3', item: '', link: '', current: false, blocked: false },
+				{ text: 'Next page', item: '', link: '', current: false, blocked: false },
+			],
+		},
+		{
+			name: 'Active page',
+			size: '',
+			pages: [
+				{ text: 'Step 1', item: '', link: '', current: false, blocked: false },
+				{ text: 'Step 2', item: '', link: ' active', current: true, blocked: false },
+			],
+		},
+		{
+			name: 'Disabled page',
+			size: '',
+			pages: [
+				{ text: 'Archive start', item: ' disabled', link: '', current: false, blocked: true },
+				{ text: 'Archive end', item: '', link: ' disabled', current: false, blocked: true },
+			],
+		},
+		{
+			name: 'Small pagination',
+			size: ' pagination-sm',
+			pages: [
+				{ text: 'Compact 1', item: '', link: '', current: false, blocked: false },
+				{ text: 'Compact 2', item: '', link: '', current: false, blocked: false },
+			],
+		},
+		{
+			name: 'Large pagination',
+			size: ' pagination-lg',
+			pages: [
+				{ text: 'Roomy 1', item: '', link: '', current: false, blocked: false },
+				{ text: 'Roomy 2', item: '', link: '', current: false, blocked: false },
+			],
