diff --git a/src/styles/components/_pagination.scss b/src/styles/components/_pagination.scss
new file mode 100644
index 0000000..43891c0
--- /dev/null
+++ b/src/styles/components/_pagination.scss
@@ -0,0 +1,122 @@
+@use '../mixins' as *;
+
+@layer components {
+	// Every value here is Bootstrap 5.3.8's own. A length reads the Veneer scale token that already
+	// resolves to it, so the density and radius factors reach the family; a color reads the
+	// compatibility variable Bootstrap itself names, or the palette token that carries Bootstrap's
+	// literal, because a partial declares no literal color of its own.
+	.pagination {
+		--bs-pagination-padding-x: var(--vn-space-6);
+		--bs-pagination-padding-y: var(--vn-space-3);
+		--bs-pagination-font-size: var(--vn-size-3);
+		--bs-pagination-color: var(--bs-link-color);
+		--bs-pagination-bg: var(--bs-body-bg);
+		--bs-pagination-border-width: var(--bs-border-width);
+		--bs-pagination-border-color: var(--bs-border-color);
+		--bs-pagination-border-radius: var(--bs-border-radius);
+		--bs-pagination-hover-color: var(--bs-link-hover-color);
+		--bs-pagination-hover-bg: var(--bs-tertiary-bg);
+		--bs-pagination-hover-border-color: var(--bs-border-color);
+		--bs-pagination-focus-color: var(--bs-link-hover-color);
+		--bs-pagination-focus-bg: var(--bs-secondary-bg);
+		--bs-pagination-focus-box-shadow: 0 0 0 0.25rem
+			color-mix(in srgb, var(--vn-palette-blue) 25%, transparent);
+		--bs-pagination-active-color: var(--vn-palette-white-base);
+		--bs-pagination-active-bg: var(--vn-palette-blue);
+		--bs-pagination-active-border-color: var(--vn-palette-blue);
+		--bs-pagination-disabled-color: var(--bs-secondary-color);
+		--bs-pagination-disabled-bg: var(--bs-secondary-bg);
+		--bs-pagination-disabled-border-color: var(--bs-border-color);
+		display: flex;
+		padding-left: 0;
+		list-style: none;
+	}
+
+	.page-link {
+		position: relative;
+		display: block;
+		padding: var(--bs-pagination-padding-y) var(--bs-pagination-padding-x);
+		font-size: var(--bs-pagination-font-size);
+		color: var(--bs-pagination-color);
+		text-decoration: none;
+		background-color: var(--bs-pagination-bg);
+		border: var(--bs-pagination-border-width) solid var(--bs-pagination-border-color);
+		// The timing is Bootstrap's own rather than the motion tokens `.btn` reads: this family
+		// ships the release's recorded surface, and `--vn-ease-standard` resolves to `ease` where
+		// the release records `ease-in-out`. The mixin emits the reduced-motion twin the release
+		// records beside it.
+		@include transition(
+			(
+				color 0.15s ease-in-out,
+				background-color 0.15s ease-in-out,
+				border-color 0.15s ease-in-out,
+				box-shadow 0.15s ease-in-out
+			)
+		);
+	}
+
+	// Hover lifts one link over its neighbour's shared border; focus and the active page lift over a
+	// hovered one, so the focus ring and the active fill are never cut by the link beside them.
+	.page-link:hover {
+		z-index: 2;
+		color: var(--bs-pagination-hover-color);
+		background-color: var(--bs-pagination-hover-bg);
+		border-color: var(--bs-pagination-hover-border-color);
+	}
+
+	.page-link:focus {
+		z-index: 3;
+		color: var(--bs-pagination-focus-color);
+		background-color: var(--bs-pagination-focus-bg);
+		outline: 0;
+		box-shadow: var(--bs-pagination-focus-box-shadow);
+	}
+
+	// The state reads the same on the link itself and on its item, which is what lets the markup
+	// carry the class wherever the page's own template puts it.
+	.page-link.active,
+	.active > .page-link {
+		z-index: 3;
+		color: var(--bs-pagination-active-color);
+		background-color: var(--bs-pagination-active-bg);
+		border-color: var(--bs-pagination-active-border-color);
+	}
+
+	.page-link.disabled,
+	.disabled > .page-link {
+		color: var(--bs-pagination-disabled-color);
+		pointer-events: none;
+		background-color: var(--bs-pagination-disabled-bg);
+		border-color: var(--bs-pagination-disabled-border-color);
+	}
+
+	// A negative inline start margin the width of one border collapses each pair of adjacent
+	// borders into one, and the end items round the strip the collapse leaves.
+	.page-item:not(:first-child) .page-link {
+		margin-left: calc(-1 * var(--bs-border-width));
+	}
+
+	.page-item:first-child .page-link {
+		border-top-left-radius: var(--bs-pagination-border-radius);
+		border-bottom-left-radius: var(--bs-pagination-border-radius);
+	}
+
+	.page-item:last-child .page-link {
+		border-top-right-radius: var(--bs-pagination-border-radius);
+		border-bottom-right-radius: var(--bs-pagination-border-radius);
+	}
+
+	.pagination-lg {
+		--bs-pagination-padding-x: var(--vn-space-12);
+		--bs-pagination-padding-y: var(--vn-space-6);
+		--bs-pagination-font-size: var(--vn-size-5);
+		--bs-pagination-border-radius: var(--bs-border-radius-lg);
+	}
+
+	.pagination-sm {
+		--bs-pagination-padding-x: var(--vn-space-4);
+		--bs-pagination-padding-y: var(--vn-space-2);
+		--bs-pagination-font-size: var(--vn-size-2);
+		--bs-pagination-border-radius: var(--bs-border-radius-sm);
+	}
+}
