@@ -0,0 +1,93 @@
+import type { SectionInterface } from '@app/browser'
+import {
+	PAGINATION_COPY,
+	PAGINATION_SPECIMENS,
+	PaginationSection,
+	SpecimenSection,
+} from '@app/browser'
+import { requireValue } from '@orkestrel/test'
+import { build, mount, readName } from '@orkestrel/test/browser'
+import { describe, expect, it } from 'vitest'
+
+describe('PaginationSection', () => {
+	it('renders a page strip for every shipped size and state through the shared section contract', () => {
+		const host = mount(build('div'))
+		const section: SectionInterface = new PaginationSection(host)
+		try {
+			expect(section).toBeInstanceOf(SpecimenSection)
+			expect(section.host).toBe(host)
+			const region = requireValue(host.querySelector('section'), 'No Pagination region')
+			expect(region.querySelector('[style]')).toBeNull()
+			expect(region.getAttribute('aria-label')).toBe('Pagination')
+			expect(region.querySelector('p')?.textContent).toBe(PAGINATION_COPY.paragraph)
+			const rendered = [...region.querySelectorAll('[data-specimen]')]
+			expect(rendered.map((element) => element.getAttribute('data-specimen'))).toEqual([
+				'Page strip',
+				'Active page',
+				'Disabled page',
+				'Small pagination',
+				'Large pagination',
+			])
+			expect(rendered.map((element) => element.innerHTML)).toEqual(
+				PAGINATION_SPECIMENS.map(({ markup }) => markup),
+			)
+			// Every class the cascade writes a rule for is rendered somewhere in the region, each
+			// spelling of each state included: a region rendering one spelling alone would leave the
+			// other rule photographed by nothing.
+			for (const selector of [
+				'.pagination',
+				'.pagination-sm',
+				'.pagination-lg',
+				'.page-item:first-child .page-link',
+				'.page-item:last-child .page-link',
+				'.page-item:not(:first-child) .page-link',
+				'.page-link.active',
+				'.active > .page-link',
+				'.page-link.disabled',
+				'.disabled > .page-link',
+			])
+				expect({ selector, rendered: region.querySelector(selector) !== null }).toEqual({
+					selector,
+					rendered: true,
+				})
+			// The journey reaches a page by its accessible name, so a repeated label would resolve to
+			// whichever strip came first and photograph the wrong specimen.
+			const links = [...region.querySelectorAll('.page-link')]
+			const names = links.map((element) => readName(element))
+			expect(new Set(names).size).toBe(names.length)
+			expect(links.filter((element) => !element.hasAttribute('href'))).toEqual([])
+			// The current page announces itself, and every unavailable page is announced and taken
+			// out of the tab order rather than being dimmed alone.
+			expect(region.querySelectorAll('[aria-current="page"]')).toHaveLength(2)
+			for (const element of region.querySelectorAll(
+				'.page-link.disabled, .disabled > .page-link',
+			)) {
+				expect(element.getAttribute('aria-disabled')).toBe('true')
+				expect(element.getAttribute('tabindex')).toBe('-1')
+			}
+			expect(Object.isFrozen(PAGINATION_COPY)).toBe(true)
+			expect(Object.isFrozen(PAGINATION_SPECIMENS)).toBe(true)
+			expect(PAGINATION_SPECIMENS.every((entry) => Object.isFrozen(entry))).toBe(true)
+		} finally {
+			section.destroy()
+			host.remove()
+		}
+	})
+	it('releases the region and preserves adjacent content on repeated destruction', () => {
+		const host = mount(build('div'))
+		const neighbor = build('p', { text: 'Existing content' })
+		host.append(neighbor)
+		const section: SectionInterface = new PaginationSection(host)
+		try {
+			const region = requireValue(host.querySelector('section'), 'No Pagination region')
+			expect(region.isConnected).toBe(true)
+			section.destroy()
+			expect(region.isConnected).toBe(false)
+			section.destroy()
+			expect([...host.children]).toEqual([neighbor])
+		} finally {
+			section.destroy()
+			host.remove()
+		}
+	})
+})
