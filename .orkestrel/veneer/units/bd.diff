diff --git a/app/browser/sections/PaginationSection.ts b/app/browser/sections/PaginationSection.ts
new file mode 100644
index 0000000..c4f0ba0
--- /dev/null
+++ b/app/browser/sections/PaginationSection.ts
@@ -0,0 +1,20 @@
+import { PAGINATION_COPY, PAGINATION_SPECIMENS } from '../constants.js'
+import { SpecimenSection } from './SpecimenSection.js'
+
+/**
+ * Renders the declared pagination specimens into a named region.
+ * @example
+ * ```ts
+ * const section = new PaginationSection(document.body)
+ * section.destroy()
+ * ```
+ */
+export class PaginationSection extends SpecimenSection {
+	/**
+	 * Mounts the Pagination region and its specimens.
+	 * @param host - The element receiving the section.
+	 */
+	constructor(host: HTMLElement) {
+		super(host, PAGINATION_COPY, PAGINATION_SPECIMENS)
+	}
+}
