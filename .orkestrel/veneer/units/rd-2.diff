+
+	it('walks the ramp down, emitting the zero entry unwrapped and each named entry below its own boundary', async () => {
+		const container = scene.mount(
+			[
+				...names.map(
+					(name) =>
+						`<div id="boundary-${name}" style="padding: var(--vn-breakpoint-${name})"></div>`,
+				),
+				'<div id="ramp-bare" class="vn-fixture-ramp"></div>',
+			].join(''),
+		)
+		const rules = readRules()
+		const readings = names.map((name) => {
+			const width = readPixels(
+				requireValue(container.querySelector(`#boundary-${name}`), `No specimen for ${name}`),
+				'padding-top',
+			)
+			const selector = width === 0 ? '.vn-fixture-ramp' : `.vn-fixture-ramp-${name}`
+			return {
+				name,
+				width,
+				emitted: rules.flatMap((rule) =>
+					rule instanceof CSSStyleRule && rule.selectorText === selector
+						? [
+								{
+									condition:
+										rule.parentRule instanceof CSSMediaRule
+											? parseMediaWidth(rule.parentRule.conditionText)
+											: undefined,
+									boundary: Number.parseFloat(rule.style.getPropertyValue('padding-bottom')),
+								},
+							]
+						: [],
+				),
+			}
+		})
+		// The zero entry takes no infix and no condition, where the `breakpoint-down` mixin emits
+		// nothing, and each named entry takes its own infix under the condition its token's width
+		// carries. Each rule's `padding-bottom` declaration reads back the boundary the entry yielded.
+		expect(readings.map(({ name, emitted }) => [name, emitted])).toEqual(
+			readings.map(({ name, width }) => [
+				name,
+				[{ condition: width === 0 ? undefined : width, boundary: width }],
+			]),
+		)
+		expect(readings.filter(({ width }) => width === 0).map(({ name }) => name)).toEqual(['xs'])
+		// The emitted width carries no direction, so the named specimens are read below, at, and above
+		// each boundary the suite's own case table drives: a named entry applies below its boundary
+		// alone, and the unsuffixed specimen applies at every reading.
+		const driven = readings.flatMap(({ name, width }) =>
+			width === 0
+				? []
+				: [
+						{
+							name,
+							width,
+							entry: requireValue(
+								BREAKPOINT_CASES.find((candidate) => candidate.boundary === width),
+								`No boundary case drives ${name} at ${String(width)}`,
+							),
+						},
+					],
+		)
+		expect(driven.map(({ name }) => name)).toEqual(names.filter((name) => name !== 'xs'))
+		const ramp = scene.mount(
+			driven
+				.map(({ name }) => `<div id="ramp-${name}" class="vn-fixture-ramp-${name}"></div>`)
+				.join(''),
+		)
+		const bare = requireValue(container.querySelector('#ramp-bare'), 'No unsuffixed ramp specimen')
+		const drift: unknown[] = []
+		for (const { name, width, entry } of driven) {
+			const specimen = requireValue(
+				ramp.querySelector(`#ramp-${name}`),
+				`No ramp specimen for ${name}`,
+			)
+			for (const reading of entry.readings) {
+				const applied = await visitBreakpoint(reading, () => ({
+					named: readPixels(specimen, 'padding-top'),
+					bare: readPixels(bare, 'padding-top'),
+				}))
+				const expected = { named: reading < width ? 1 : 0, bare: 1 }
+				if (applied.named !== expected.named || applied.bare !== expected.bare) {
+					drift.push([name, reading, applied, expected])
+				}
+			}
+		}
+		expect(driven.flatMap(({ entry }) => entry.readings).length).toBeGreaterThan(0)
+		expect(drift).toEqual([])
+	})
