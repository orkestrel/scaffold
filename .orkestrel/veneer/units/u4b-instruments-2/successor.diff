+/**
+ * Scans a saved fixture for a difference from the live recording.
+ * @param recording - The live official recording.
+ * @param fixture - The parsed saved fixture.
+ * @returns The first differing step or metadata finding, or undefined when they agree.
+ */
+export function scanOracleFixture(recording: OracleFixture, fixture: unknown): string | undefined {
+	if (!isRecord(fixture) || !Array.isArray(fixture.steps) || !Array.isArray(fixture.excluded))
+		return 'Invalid Button oracle fixture'
+	const excluded = new Set<string>()
+	for (const exclusion of fixture.excluded) {
+		if (
+			!isRecord(exclusion) ||
+			typeof exclusion.step !== 'string' ||
+			typeof exclusion.reason !== 'string' ||
+			exclusion.reason.trim() === ''
+		)
+			return 'Invalid oracle exclusion'
+		const name = exclusion.step
+		if (
+			!recording.steps.some((step) => step.name === name) ||
+			!fixture.steps.some((step: unknown) => isRecord(step) && step.name === name)
+		)
+			return `Oracle exclusion names no recorded step: ${name}`
+		excluded.add(name)
+	}
+	for (const [index, step] of recording.steps.entries()) {
+		if (excluded.has(step.name)) continue
+		if (!isDeepStrictEqual(parseJSON(JSON.stringify(step)), fixture.steps[index]))
+			return `Oracle differs at step ${step.name}`
+	}
+	const steps = fixture.steps.map((step: unknown) =>
+		isRecord(step) && typeof step.name === 'string' && excluded.has(step.name)
+			? { name: step.name }
+			: step,
+	)
+	const compared = {
+		...recording,
+		excluded: fixture.excluded,
+		steps: recording.steps.map((step) => (excluded.has(step.name) ? { name: step.name } : step)),
+	}
+	return isDeepStrictEqual(parseJSON(JSON.stringify(compared)), { ...fixture, steps })
+		? undefined
+		: 'Oracle fixture metadata or step membership differs'
 }
 
