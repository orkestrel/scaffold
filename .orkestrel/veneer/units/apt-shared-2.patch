+/**
+ * Computes the size the release's responsive font size rule resolves for a size at a viewport width.
+ *
+ * @param size - The size the rule scales, in CSS pixels.
+ * @param width - The viewport width, in CSS pixels.
+ * @param root - The root font size, in CSS pixels, which fixes the rule's 1.25rem floor.
+ * @returns The size itself at and above the 1200px boundary. Below it, the size less its excess over
+ *   the floor, at nine tenths, scaled by how far the viewport sits below the boundary. A size at or
+ *   under the floor has no excess, so it is returned unchanged at every width.
+ *
+ * @remarks
+ * The function is the proofs' independent statement of the rule the `fluid-size` function in the
+ * `_mixins.scss` partial emits, so a size proof compares a rendered reading with this arithmetic
+ * rather than with a value the cascade supplied.
+ *
+ * @example
+ * ```ts
+ * computeFluidSize(36, 390) // 26.28
+ * ```
+ */
+export function computeFluidSize(size: number, width: number, root = 16): number {
+	if (width >= 1200) return size
+	return size - Math.max(size * 0.9 - 1.125 * root, 0) * (1 - width / 1200)
+}
