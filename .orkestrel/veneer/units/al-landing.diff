new file mode 100644
index 0000000..dd65f1f
--- /dev/null
+++ b/tests/app/browser/sections/AlertSection.test.ts
@@ -0,0 +1,92 @@
+import type { SectionInterface } from '@app/browser'
+import { ALERT_COPY, ALERT_SPECIMENS, AlertSection, SpecimenSection } from '@app/browser'
+import { requireValue } from '@orkestrel/test'
+import { build, mount, readName } from '@orkestrel/test/browser'
+import { describe, expect, it } from 'vitest'
+
+describe('AlertSection', () => {
+	it('renders the role ramp, the linked alert, and the dismissible alert through the shared section contract', () => {
+		const host = mount(build('div'))
+		const section: SectionInterface = new AlertSection(host)
+		try {
+			expect(section).toBeInstanceOf(SpecimenSection)
+			expect(section.host).toBe(host)
+			const region = requireValue(host.querySelector('section'), 'No Alert region')
+			expect(region.querySelector('[style]')).toBeNull()
+			expect(region.getAttribute('aria-label')).toBe('Alert')
+			expect(region.querySelector('p')?.textContent).toBe(ALERT_COPY.paragraph)
+			const rendered = [...region.querySelectorAll('[data-specimen]')]
+			expect(rendered.map((element) => element.getAttribute('data-specimen'))).toEqual([
+				'Role alerts',
+				'Linked alert',
+				'Dismissible alert',
+			])
+			expect(rendered.map((element) => element.innerHTML)).toEqual(
+				ALERT_SPECIMENS.map(({ markup }) => markup),
+			)
+			// The ramp renders the release's roles in the release's order, one alert each, and no
+			// alert for Veneer's own `tertiary` role, which emits no variant.
+			const ramp = requireValue(
+				region.querySelector('[data-specimen="Role alerts"]'),
+				'No role ramp specimen',
+			)
+			expect([...ramp.querySelectorAll('.alert')].map((alert) => alert.className)).toEqual(
+				['primary', 'secondary', 'success', 'info', 'warning', 'danger', 'light', 'dark'].map(
+					(role) => `alert alert-${role}`,
+				),
+			)
+			expect(region.querySelector('.alert-tertiary')).toBeNull()
+			// Every alert announces itself through the role the release's markup gives it.
+			expect(
+				[...region.querySelectorAll('.alert')].filter(
+					(alert) => alert.getAttribute('role') !== 'alert',
+				),
+			).toStrictEqual([])
+			const linked = requireValue(
+				region.querySelector('[data-specimen="Linked alert"] .alert'),
+				'No linked alert',
+			)
+			expect(linked.querySelector('.alert-heading')).not.toBeNull()
+			const link = requireValue(linked.querySelector('a.alert-link'), 'No alert link')
+			expect(link.getAttribute('href')).toBe('#main')
+			const dismissible = requireValue(
+				region.querySelector('[data-specimen="Dismissible alert"] .alert.alert-dismissible'),
+				'No dismissible alert',
+			)
+			// The close control paints a mark rather than a label, so it is named through its own
+			// `aria-label` attribute.
+			const control = requireValue(dismissible.querySelector('.btn-close'), 'No close control')
+			expect(control.tagName).toBe('BUTTON')
+			expect(control.getAttribute('aria-label')).toBe('Close')
+			expect(readName(control)).toBe('Close')
+			expect(control.textContent).toBe('')
+			// The release's fade classes are the engine's to set, and every alert rule paints the
+			// same without them, so no specimen carries one.
+			expect(region.querySelector('.fade, .show')).toBeNull()
+			expect(Object.isFrozen(ALERT_COPY)).toBe(true)
+			expect(Object.isFrozen(ALERT_SPECIMENS)).toBe(true)
+			expect(ALERT_SPECIMENS.every((entry) => Object.isFrozen(entry))).toBe(true)
+		} finally {
+			section.destroy()
+			host.remove()
+		}
+	})
+
+	it('releases the region and preserves adjacent content on repeated destruction', () => {
+		const host = mount(build('div'))
+		const neighbor = build('p', { text: 'Existing content' })
+		host.append(neighbor)
+		const section: SectionInterface = new AlertSection(host)
+		try {
+			const region = requireValue(host.querySelector('section'), 'No Alert region')
+			expect(region.isConnected).toBe(true)
+			section.destroy()
+			expect(region.isConnected).toBe(false)
+			section.destroy()
+			expect([...host.children]).toEqual([neighbor])
+		} finally {
+			section.destroy()
+			host.remove()
+		}
+	})
+})
