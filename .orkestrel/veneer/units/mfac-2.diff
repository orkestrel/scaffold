+			fixed.style.opacity = '0'
+			return {
+				factor: style.getPropertyValue(TOKEN_NAMES.factor.motion),
+				mounted: hosts.map((mounted) => mounted.isConnected),
+				fixture: sampleTransition(scaled, 'opacity')?.duration,
+				control: sampleTransition(fixed, 'opacity')?.duration,
+			}
+		})
+		expect(readings.map((reading) => [reading.factor, reading.mounted])).toEqual([
+			['1', [true]],
+			['2', [false, true]],
+			['0', [false, false, true]],
+		])
+		const [resting, doubled, zeroed] = readings.map((reading) => reading.fixture)
+		const base = requireValue(resting, 'No fixture transition at the resting factor')
+		expect(base).toBeGreaterThan(0)
+		expect([doubled, zeroed]).toEqual([base * 2, undefined])
+		expect(readings.map((reading) => reading.control)).toEqual([150, 150, 150])
+		expect(style.getPropertyValue(TOKEN_NAMES.factor.motion)).toBe('')
+		expect(hosts.map((host) => host.isConnected)).toEqual([false, false, false])
