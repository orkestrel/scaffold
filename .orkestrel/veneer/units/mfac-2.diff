+/**
+ * Runs one drive at the resting, the doubled, and the zero motion factor, set on the document
+ * element, and returns what the drive read at each.
+ *
+ * @param drive - The reading to take at each factor: it mounts its own nodes through {@link scene},
+ *   starts the change, and returns what it read, such as the {@link sampleTransition} result. It
+ *   runs synchronously.
+ * @returns Each factor's reading, in the order of the factors `1`, `2`, and `0`.
+ * @throws Thrown when the drive throws, with the drive's own error, after the factor and the scene
+ *   are restored.
+ *
+ * @remarks
+ * The factor is set on the document element because Veneer declares the motion tokens on the `:root`
+ * selector, so a token substitutes the factor there once and every subtree inherits the result. A
+ * transition that reads a motion token therefore doubles at `2` and starts nothing at `0`, while a
+ * literal duration reads the same at each factor.
+ *
+ * After each drive, including one that throws, the document element's own factor returns to the
+ * value and priority it held before the call, or is removed when it held none, and {@link scene} is
+ * cleared, so the next factor's drive starts on an empty scene. Clearing removes every node the scene
+ * recorded, so mount nothing a later reading needs before the call.
+ *
+ * @example
+ * ```ts
+ * const [resting, doubled, zeroed] = sweepMotionFactor(() => {
+ * 	const host = scene.mount(PROGRESS_MARKUP)
+ * 	const bar = requireValue(host.querySelector<HTMLElement>('.progress-bar'), 'No bar')
+ * 	readStyle(bar, 'width')
+ * 	bar.style.width = '75%'
+ * 	return sampleTransition(bar, 'width')
+ * })
+ * ```
+ */
+export function sweepMotionFactor<T>(drive: () => T): readonly T[] {
+	const style = document.documentElement.style
+	const name = TOKEN_NAMES.factor.motion
+	const value = style.getPropertyValue(name)
+	const priority = style.getPropertyPriority(name)
+	return ['1', '2', '0'].map((factor) => {
+		style.setProperty(name, factor)
+		try {
+			return drive()
+		} finally {
+			if (value === '') style.removeProperty(name)
+			else style.setProperty(name, value, priority)
+			scene.clear()
+		}
+	})
+}
+
