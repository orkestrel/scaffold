+++ b/app/browser/sections/NavSection.ts
@@ -0,0 +1,20 @@
+import { NAV_COPY, NAV_SPECIMENS } from '../constants.js'
+import { SpecimenSection } from './SpecimenSection.js'
+
+/**
+ * Renders the declared nav specimens into a named region.
+ * @example
+ * ```ts
+ * const section = new NavSection(document.body)
+ * section.destroy()
+ * ```
+ */
+export class NavSection extends SpecimenSection {
+	/**
+	 * Mounts the Nav region and its specimens.
+	 * @param host - The element receiving the section.
+	 */
+	constructor(host: HTMLElement) {
+		super(host, NAV_COPY, NAV_SPECIMENS)
+	}
+}
