@@ -0,0 +1,497 @@
+import { TOKEN_NAMES } from '@src/core'
+import { requireValue } from '@orkestrel/test'
+import {
+	holdAccessible,
+	hoverAccessible,
+	matchesColor,
+	pressKeys,
+	readPixels,
+	readStyle,
+	readToken,
+	releaseMedia,
+	releasePointer,
+	stageMedia,
+	waitForAnimations,
+} from '@orkestrel/test/browser'
+import { afterEach, describe, expect, it } from 'vitest'
+import { collectLayer, collectMediaConditions, scene } from '../../../setupBrowser.js'
+import {
+	extractShadowLayers,
+	NAV_COLOR_CASES,
+	NAV_LENGTH_CASES,
+	NAV_MARKUP,
+	NAV_ROW_CASES,
+	NAV_SELECTORS,
+	REDUCED_MOTION,
+	splitTopLevelList,
+	TEXT_MODES,
+} from '../../../setupStyles.js'
+
+afterEach(async () => {
+	await releasePointer()
+	await releaseMedia()
+	scene.clear()
+})
+
+describe('nav classes', () => {
+	it('lays each nav out as an unstyled wrapping row and every shipped selector reaches the components layer', () => {
+		const host = scene.mount(NAV_MARKUP)
+		for (const list of host.querySelectorAll('.nav')) {
+			expect(readStyle(list, 'display')).toBe('flex')
+			expect(readStyle(list, 'flex-wrap')).toBe('wrap')
+			expect(readPixels(list, 'padding-left')).toBe(0)
+			expect(readPixels(list, 'margin-bottom')).toBe(0)
+			expect(readStyle(list, 'list-style-type')).toBe('none')
+		}
+		const link = requireValue(host.querySelector('nav.nav > .nav-link'), 'No plain link')
+		expect(readStyle(link, 'display')).toBe('block')
+		expect(readStyle(link, 'text-decoration-line')).toBe('none')
+		expect(readStyle(link, 'background-color')).toBe('rgba(0, 0, 0, 0)')
+		expect(readStyle(link, 'background-image')).toBe('none')
+		expect(readPixels(link, 'border-top-width')).toBe(0)
+		// The disabled button is a native button, so the reset reaches the chrome a button element
+		// brings with it: it paints no surface and no border of its own beside the anchors.
+		const button = requireValue(host.querySelector('button.nav-link'), 'No button link')
+		expect(readStyle(button, 'background-color')).toBe('rgba(0, 0, 0, 0)')
+		expect(readPixels(button, 'border-left-width')).toBe(0)
+		// The layer reading answers for the names no resolved style reaches on its own: a state rule
+		// the partial stopped writing resolves to the resting treatment and reads normal, so the
+		// selectors are held against the rules the shipped cascade carries.
+		const selected = new Set(
+			collectLayer('components').flatMap((rule) =>
+				rule instanceof CSSStyleRule ? splitTopLevelList(rule.selectorText) : [],
+			),
+		)
+		expect(NAV_SELECTORS.filter((selector) => !selected.has(selector))).toEqual([])
+	})
+
+	it("takes the parent's type size and weight until a consumer sets the published slots", () => {
+		const host = scene.mount(`<div style="font-size: 20px; font-weight: 600">${NAV_MARKUP}</div>`)
+		const wrapper = requireValue(host.querySelector<HTMLElement>('div'), 'No wrapper')
+		const list = requireValue(host.querySelector<HTMLElement>('nav.nav'), 'No plain nav')
+		const link = requireValue(list.querySelector('.nav-link'), 'No plain link')
+		// The release reads the size slot and declares it nowhere, and it declares the weight slot
+		// empty, so each resolves to nothing and the link inherits its parent's own reading.
+		expect(readPixels(link, 'font-size')).toBe(20)
+		expect(readStyle(link, 'font-weight')).toBe('600')
+		// The size slot has no declaring scope, so a wrapper reaches it. The weight slot is declared
+		// on the nav itself, so a wrapper is outranked there and the nav is where a consumer sets it.
+		wrapper.style.setProperty('--bs-nav-link-font-size', '13px')
+		wrapper.style.setProperty('--bs-nav-link-font-weight', '300')
+		expect(readPixels(link, 'font-size')).toBe(13)
+		expect(readStyle(link, 'font-weight')).toBe('600')
+		list.style.setProperty('--bs-nav-link-font-weight', '300')
+		expect(readStyle(link, 'font-weight')).toBe('300')
+	})
+
+	it.each(NAV_LENGTH_CASES)(
+		'reads $reads from $property and moves it only from the declaring $scope',
+		({ property, scope, target, reads, pixels }) => {
+			const host = scene.mount(`<div>${NAV_MARKUP}</div>`)
+			const wrapper = requireValue(host.querySelector<HTMLElement>('div'), 'No wrapper')
+			const element = requireValue(host.querySelector(target), `No ${target}`)
+			const declaring = requireValue(element.closest<HTMLElement>(scope), `No ${scope}`)
+			expect(readPixels(element, reads)).toBe(pixels)
+			// The class declares the property itself, so a declaration on an ancestor is outranked and
+			// the declaring element is where a consumer retunes it. Reading the shadowed wrapper first
+			// is what makes the declaring element's own override the thing under test.
+			wrapper.style.setProperty(property, '19px')
+			expect(readPixels(element, reads)).toBe(pixels)
+			declaring.style.setProperty(property, '19px')
+			expect(readPixels(element, reads)).toBe(19)
+		},
+	)
+
+	it.each(NAV_COLOR_CASES)(
+		'paints $reads from $property, the value $source gives it, and moves it only from the declaring $scope',
+		async ({ property, scope, target, reads, source }) => {
+			const host = scene.mount(`<div>${NAV_MARKUP}</div>`)
+			const wrapper = requireValue(host.querySelector<HTMLElement>('div'), 'No wrapper')
+			const element = requireValue(host.querySelector(target), `No ${target}`)
+			const declaring = requireValue(element.closest<HTMLElement>(scope), `No ${scope}`)
+			// The link transitions its paint, so the preference is staged first and every reading here
+			// is the settled value the declaration resolves to.
+			await stageMedia({ motion: false })
+			expect(matchesColor(readStyle(element, reads), readToken(element, source))).toBe(true)
+			expect(matchesColor(readStyle(element, reads), 'rebeccapurple')).toBe(false)
+			wrapper.style.setProperty(property, 'rebeccapurple')
