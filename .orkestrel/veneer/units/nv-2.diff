index 0000000..93abb90
--- /dev/null
+++ b/src/styles/components/_nav.scss
@@ -0,0 +1,179 @@
+@use '../mixins' as *;
+
+@layer components {
+	// Every value here is Bootstrap 5.3.8's own, apart from the forced-colors focus outline. A length
+	// reads the Veneer scale token that already resolves to it, so the density factor reaches the link
+	// padding and the underline gap; a color reads the compatibility variable Bootstrap itself names,
+	// or the palette token that carries Bootstrap's literal, because a partial declares no literal
+	// color of its own. The link rule reads the font size slot and no rule declares it, as the release
+	// leaves it, so a link takes its parent's size until a consumer sets the property.
+	.nav {
+		--bs-nav-link-padding-x: var(--vn-space-8);
+		--bs-nav-link-padding-y: var(--vn-space-4);
+		// The release declares the weight slot with no value. The interpolation compiles to that same
+		// empty declaration, and it states that the emptiness is the release's own.
+		--bs-nav-link-font-weight: #{''};
+		--bs-nav-link-color: var(--bs-link-color);
+		--bs-nav-link-hover-color: var(--bs-link-hover-color);
+		--bs-nav-link-disabled-color: var(--bs-secondary-color);
+		display: flex;
+		flex-wrap: wrap;
+		padding-left: 0;
+		margin-bottom: 0;
+		list-style: none;
+	}
+
+	.nav-link {
+		display: block;
+		padding: var(--bs-nav-link-padding-y) var(--bs-nav-link-padding-x);
+		font-size: var(--bs-nav-link-font-size);
+		font-weight: var(--bs-nav-link-font-weight);
+		color: var(--bs-nav-link-color);
+		text-decoration: none;
+		background: none;
+		border: 0;
+		// The timing is Bootstrap's own rather than the motion tokens the `.btn` class reads, because
+		// this key ships the release's recorded surface. The mixin emits the reduced-motion twin the
+		// release records beside it.
+		@include transition(
+			(color 0.15s ease-in-out, background-color 0.15s ease-in-out, border-color 0.15s ease-in-out)
+		);
+	}
+
+	.nav-link:hover,
+	.nav-link:focus {
+		color: var(--bs-nav-link-hover-color);
+	}
+
+	// The ring answers to keyboard focus alone, so a link a pointer presses takes the hover color and
+	// no ring. Forced colors paint no shadow, so the link takes the system-highlight outline there.
+	.nav-link:focus-visible {
+		outline: 0;
+		box-shadow: 0 0 0 0.25rem color-mix(in srgb, var(--vn-palette-blue) 25%, transparent);
+		@include forced-ring;
+	}
+
+	.nav-link.disabled,
+	.nav-link:disabled {
+		color: var(--bs-nav-link-disabled-color);
+		pointer-events: none;
+		cursor: default;
+	}
+
+	.nav-tabs {
+		--bs-nav-tabs-border-width: var(--bs-border-width);
+		--bs-nav-tabs-border-color: var(--bs-border-color);
+		--bs-nav-tabs-border-radius: var(--bs-border-radius);
+		--bs-nav-tabs-link-hover-border-color: var(--bs-secondary-bg) var(--bs-secondary-bg)
+			var(--bs-border-color);
+		--bs-nav-tabs-link-active-color: var(--bs-emphasis-color);
+		--bs-nav-tabs-link-active-bg: var(--bs-body-bg);
+		--bs-nav-tabs-link-active-border-color: var(--bs-border-color) var(--bs-border-color)
+			var(--bs-body-bg);
+		border-bottom: var(--bs-nav-tabs-border-width) solid var(--bs-nav-tabs-border-color);
+	}
+
+	// Each tab overlaps the strip's bottom border by one border width, so the active tab's bottom
+	// border covers the strip line where the two meet.
+	.nav-tabs .nav-link {
+		margin-bottom: calc(-1 * var(--bs-nav-tabs-border-width));
+		border: var(--bs-nav-tabs-border-width) solid transparent;
+		border-top-left-radius: var(--bs-nav-tabs-border-radius);
+		border-top-right-radius: var(--bs-nav-tabs-border-radius);
+	}
+
+	// Isolation keeps an active neighbour from painting over the ring of the tab beside it.
+	.nav-tabs .nav-link:hover,
+	.nav-tabs .nav-link:focus {
+		isolation: isolate;
+		border-color: var(--bs-nav-tabs-link-hover-border-color);
+	}
+
+	// A link whose item carries the `show` class paints as the active one.
+	.nav-tabs .nav-link.active,
+	.nav-tabs .nav-item.show .nav-link {
+		color: var(--bs-nav-tabs-link-active-color);
+		background-color: var(--bs-nav-tabs-link-active-bg);
+		border-color: var(--bs-nav-tabs-link-active-border-color);
+	}
+
+	// A menu hanging from a tab overlaps the strip's border by its width and squares the top corners
+	// that meet that hard edge.
+	.nav-tabs .dropdown-menu {
+		margin-top: calc(-1 * var(--bs-nav-tabs-border-width));
+		border-top-left-radius: 0;
+		border-top-right-radius: 0;
+	}
+
+	.nav-pills {
+		--bs-nav-pills-border-radius: var(--bs-border-radius);
+		--bs-nav-pills-link-active-color: var(--vn-palette-white-base);
+		--bs-nav-pills-link-active-bg: var(--vn-palette-blue);
+	}
+
+	.nav-pills .nav-link {
+		border-radius: var(--bs-nav-pills-border-radius);
+	}
+
+	.nav-pills .nav-link.active,
+	.nav-pills .show > .nav-link {
+		color: var(--bs-nav-pills-link-active-color);
+		background-color: var(--bs-nav-pills-link-active-bg);
+	}
+
+	// The underline width stays the release's literal: the scale token that resolves to it is a space
+	// token, and a stroke read through it would thicken and thin with the density factor.
+	.nav-underline {
+		--bs-nav-underline-gap: var(--vn-space-8);
+		--bs-nav-underline-border-width: 0.125rem;
+		--bs-nav-underline-link-active-color: var(--bs-emphasis-color);
+		gap: var(--bs-nav-underline-gap);
+	}
+
+	.nav-underline .nav-link {
+		padding-right: 0;
+		padding-left: 0;
+		border-bottom: var(--bs-nav-underline-border-width) solid transparent;
+	}
+
+	.nav-underline .nav-link:hover,
+	.nav-underline .nav-link:focus {
+		border-bottom-color: currentcolor;
+	}
+
+	.nav-underline .nav-link.active,
+	.nav-underline .show > .nav-link {
+		font-weight: 700;
+		color: var(--bs-nav-underline-link-active-color);
+		border-bottom-color: currentcolor;
+	}
+
+	// Fill grows each item from its own content, so items keep their differing widths; justified
+	// grows every item from a zero basis, so the items share the row equally.
+	.nav-fill > .nav-link,
+	.nav-fill .nav-item {
+		flex: 1 1 auto;
+		text-align: center;
+	}
+
+	.nav-justified > .nav-link,
+	.nav-justified .nav-item {
+		flex-grow: 1;
+		flex-basis: 0;
+		text-align: center;
+	}
+
+	.nav-fill .nav-item .nav-link,
+	.nav-justified .nav-item .nav-link {
+		width: 100%;
+	}
+
+	// The classes are set in markup: a pane stays hidden until it carries the `active` class.
+	.tab-content > .tab-pane {
+		display: none;
+	}
+
+	.tab-content > .active {
+		display: block;
+	}
+}
diff --git a/tests/app/browser/sections/NavSection.test.ts b/tests/app/browser/sections/NavSection.test.ts
new file mode 100644
index 0000000..5fce942
--- /dev/null
+++ b/tests/app/browser/sections/NavSection.test.ts
@@ -0,0 +1,131 @@
+import type { SectionInterface } from '@app/browser'
+import { NAV_COPY, NAV_SPECIMENS, NavSection, SpecimenSection } from '@app/browser'
+import { requireValue } from '@orkestrel/test'
+import { build, mount, readName } from '@orkestrel/test/browser'
+import { describe, expect, it } from 'vitest'
+
+describe('NavSection', () => {
+	it('renders every nav family and every state class in markup through the shared section contract', () => {
+		const host = mount(build('div'))
+		const section: SectionInterface = new NavSection(host)
+		try {
+			expect(section).toBeInstanceOf(SpecimenSection)
+			expect(section.host).toBe(host)
+			const region = requireValue(host.querySelector('section'), 'No Nav region')
+			expect(region.querySelector('[style]')).toBeNull()
+			expect(region.getAttribute('aria-label')).toBe('Nav')
+			expect(region.querySelector('p')?.textContent).toBe(NAV_COPY.paragraph)
+			const rendered = [...region.querySelectorAll('[data-specimen]')]
+			expect(rendered.map((element) => element.getAttribute('data-specimen'))).toEqual([
+				'Nav base',
+				'Nav tabs',
+				'Nav pills',
+				'Nav underline',
+				'Nav fill',
+				'Nav justified',
+				'Tab panes',
+			])
+			expect(rendered.map((element) => element.innerHTML)).toEqual(
+				NAV_SPECIMENS.map(({ markup }) => markup),
+			)
+			// Every rule the key ships without the pointer or the keyboard has a subject in the region,
+			// each spelling of each state included, because no script sets a state class here: a region
+			// rendering one spelling alone leaves the other rule photographed by nothing.
+			for (const selector of [
+				'.nav',
+				'.nav-link',
+				'.nav-link.disabled',
+				'.nav-link:disabled',
+				'.nav-tabs .nav-link',
+				'.nav-tabs .nav-link.active',
+				'.nav-tabs .nav-item.show .nav-link',
+				'.nav-tabs .dropdown-menu',
+				'.nav-pills .nav-link',
+				'.nav-pills .nav-link.active',
+				'.nav-pills .show > .nav-link',
+				'.nav-underline .nav-link',
+				'.nav-underline .nav-link.active',
+				'.nav-underline .show > .nav-link',
+				'.nav-fill > .nav-link',
+				'.nav-fill .nav-item',
+				'.nav-fill .nav-item .nav-link',
+				'.nav-justified > .nav-link',
+				'.nav-justified .nav-item',
+				'.nav-justified .nav-item .nav-link',
+				'.tab-content > .tab-pane',
+				'.tab-content > .active',
+				'.tab-content > .tab-pane:not(.active)',
+			])
+				expect({ selector, rendered: region.querySelector(selector) !== null }).toEqual({
+					selector,
+					rendered: true,
+				})
+			// The journey reaches a link by its accessible name, so a repeated label would resolve to
+			// whichever specimen came first and photograph the wrong one.
+			const links = [...region.querySelectorAll('a')]
+			const names = links.map((element) => readName(element))
+			expect(new Set(names).size).toBe(names.length)
+			expect(links.filter((element) => element.getAttribute('href') !== '#main')).toEqual([])
+			// The open menu carries the markup the dropdown script leaves: the toggle and the menu carry
+			// `show`, the toggle announces the menu as expanded, and the item holding them carries only
+			// its `nav-item` and `dropdown` classes. The item `show` class the tabs rule reads sits on a
+			// plain tab instead, so the rule and the menu each have a subject and neither stands in for
+			// the other.
+			const opened = requireValue(
+				region.querySelector('.nav-tabs > .nav-item.dropdown'),
+				'No tab holding a menu',
+			)
+			expect([...opened.classList]).toEqual(['nav-item', 'dropdown'])
+			const toggle = requireValue(opened.querySelector(':scope > .nav-link'), 'No menu toggle')
+			expect([...toggle.classList]).toEqual(['nav-link', 'dropdown-toggle', 'show'])
+			expect(toggle.getAttribute('role')).toBe('button')
+			expect(toggle.getAttribute('aria-expanded')).toBe('true')
+			const menu = requireValue(opened.querySelector(':scope > .dropdown-menu'), 'No open menu')
+			expect([...menu.classList]).toEqual(['dropdown-menu', 'show'])
+			expect(menu.getAttribute('data-bs-popper')).toBe('static')
+			const shown = [...region.querySelectorAll('.nav-tabs > .nav-item.show')]
+			expect(shown).not.toStrictEqual([])
+			for (const item of shown) {
+				expect([...item.classList]).toEqual(['nav-item', 'show'])
+				expect([...item.children].map((child) => child.className)).toEqual(['nav-link'])
+			}
+			expect(region.querySelector('.nav-item.show .dropdown-menu')).toBeNull()
+			// The link marked current announces itself through `aria-current`, and every disabled link
+			// is announced and taken out of the tab order rather than being dimmed alone.
+			for (const element of region.querySelectorAll('.nav-link.active'))
+				expect(element.getAttribute('aria-current')).toBe('page')
+			for (const element of region.querySelectorAll('a.nav-link.disabled')) {
+				expect(element.getAttribute('aria-disabled')).toBe('true')
+				expect(element.getAttribute('tabindex')).toBe('-1')
+			}
+			expect(region.querySelector('button.nav-link[disabled]')).not.toBeNull()
+			// Each tab strip opens onto a pane, and the room its open menu hangs over is that pane, so
+			// the menu lies over content inside the specimen rather than over the specimen after it.
+			for (const strip of region.querySelectorAll('.nav-tabs'))
+				expect(strip.nextElementSibling?.matches('.tab-content')).toBe(true)
+			expect(Object.isFrozen(NAV_COPY)).toBe(true)
+			expect(Object.isFrozen(NAV_SPECIMENS)).toBe(true)
+			expect(NAV_SPECIMENS.every((entry) => Object.isFrozen(entry))).toBe(true)
+		} finally {
+			section.destroy()
+			host.remove()
+		}
+	})
+	it('releases the region and preserves adjacent content on repeated destruction', () => {
+		const host = mount(build('div'))
+		const neighbor = build('p', { text: 'Existing content' })
+		host.append(neighbor)
+		const section: SectionInterface = new NavSection(host)
+		try {
+			const region = requireValue(host.querySelector('section'), 'No Nav region')
+			expect(region.isConnected).toBe(true)
+			section.destroy()
+			expect(region.isConnected).toBe(false)
+			section.destroy()
+			expect([...host.children]).toEqual([neighbor])
+		} finally {
+			section.destroy()
+			host.remove()
+		}
+	})
+})
diff --git a/tests/src/styles/components/nav.test.ts b/tests/src/styles/components/nav.test.ts
