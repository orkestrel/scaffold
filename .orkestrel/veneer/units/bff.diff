+/** Holds the Form floating section's visible copy and accessible name. */
+export const FORM_FLOATING_COPY = Object.freeze({
+	region: 'Form floating',
+	paragraph:
+		'Compare each floating label at rest and floated: over an empty field, a filled one, a textarea, a select, a disabled field, and a read-only value.',
+})
+
+/**
+ * Lists the floating-label specimens the section renders, in render order.
+ *
+ * @remarks
+ * Each control carries a placeholder, because a control reports itself empty only when it has one,
+ * and the label is what names it, so the journey reaches the empty field by that name through
+ * keyboard traversal. The filled field, the textarea, and the plaintext value carry their text in
+ * the markup, so each renders its label floated with no drive; the disabled field is a filled
+ * textarea, which shows the disabled label and the disabled backdrop in one frame.
+ */
+export const FORM_FLOATING_SPECIMENS: readonly MarkupSpecimen[] = Object.freeze([
+	Object.freeze({
+		name: 'Form floating empty',
+		markup:
+			'<div class="form-floating"><input type="email" class="form-control" id="floating-email" placeholder="dispatch@example.com"><label for="floating-email">Email address</label></div>',
+	}),
+	Object.freeze({
+		name: 'Form floating filled',
+		markup:
+			'<div class="form-floating"><input type="text" class="form-control" id="floating-city" placeholder="City" value="Lisbon"><label for="floating-city">Delivery city</label></div>',
+	}),
+	Object.freeze({
+		name: 'Form floating textarea',
+		markup:
+			'<div class="form-floating"><textarea class="form-control" id="floating-notes" placeholder="Notes">Leave the parcel at the side door.</textarea><label for="floating-notes">Delivery notes</label></div>',
+	}),
+	Object.freeze({
+		name: 'Form floating select',
+		markup:
+			'<div class="form-floating"><select class="form-select" id="floating-carrier"><option selected="">Northworks Freight</option><option>Harbor Line</option></select><label for="floating-carrier">Carrier</label></div>',
+	}),
+	Object.freeze({
+		name: 'Form floating disabled',
+		markup:
+			'<div class="form-floating"><textarea class="form-control" id="floating-archive" placeholder="Notes" disabled="">Archived at the depot.</textarea><label for="floating-archive">Archived notes</label></div>',
+	}),
+	Object.freeze({
+		name: 'Form floating plaintext',
+		markup:
+			'<div class="form-floating"><input type="email" class="form-control-plaintext" id="floating-account" placeholder="dispatch@example.com" value="dispatch@example.com" readonly=""><label for="floating-account">Account email</label></div>',
+	}),
+])
