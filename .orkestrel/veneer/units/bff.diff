+import type { SectionInterface } from '@app/browser'
+import {
+	FORM_FLOATING_COPY,
+	FORM_FLOATING_SPECIMENS,
+	FormFloatingSection,
+	SpecimenSection,
+} from '@app/browser'
+import { requireValue } from '@orkestrel/test'
+import { build, mount, readName, readStates } from '@orkestrel/test/browser'
+import { describe, expect, it } from 'vitest'
+
+describe('FormFloatingSection', () => {
+	it('renders every floating control through the shared section contract, each named by its label', () => {
+		const host = mount(build('div'))
+		const section: SectionInterface = new FormFloatingSection(host)
+		try {
+			expect(section).toBeInstanceOf(SpecimenSection)
+			expect(section.host).toBe(host)
+			const region = requireValue(host.querySelector('section'), 'No Form floating region')
+			expect(region.querySelector('[style]')).toBeNull()
+			expect(region.getAttribute('aria-label')).toBe('Form floating')
+			expect(region.querySelector('p')?.textContent).toBe(FORM_FLOATING_COPY.paragraph)
+			const rendered = [...region.querySelectorAll('[data-specimen]')]
+			expect(rendered.map((element) => element.getAttribute('data-specimen'))).toEqual([
+				'Form floating empty',
+				'Form floating filled',
+				'Form floating textarea',
