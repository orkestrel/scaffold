+describe('form floating tokens', () => {
+	it('rescales every tokenized inset with the density factor and leaves the literal ones', () => {
+		const host = scene.mount(`<div>${FORM_FLOATING_MARKUP}</div>`)
+		const empty = requireValue(host.querySelector('#floating-empty'), 'No empty control')
+		const label = requireValue(host.querySelector('label[for="floating-empty"]'), 'No label')
+		const filled = requireValue(host.querySelector('#floating-filled'), 'No filled control')
+		const select = requireValue(host.querySelector('#floating-carrier'), 'No select')
+		const notes = requireValue(host.querySelector('label[for="floating-notes"]'), 'No notes')
+		expect(readToken(label, TOKEN_NAMES.space[8])).toBe('calc(1rem * 1)')
+		// The factor is set on the document element because that is where the token computes: a
+		// factor set on the control itself would leave the already-computed length untouched.
+		document.documentElement.style.setProperty(TOKEN_NAMES.factor.density, '2')
+		try {
+			expect(readPixels(label, 'padding-top')).toBe(32)
+			expect(readPixels(label, 'padding-left')).toBe(24)
+			expect(readPixels(empty, 'padding-top')).toBe(32)
+			expect(readPixels(empty, 'padding-left')).toBe(24)
+			expect(readPixels(filled, 'padding-bottom')).toBe(20)
+			expect(readPixels(select, 'padding-left')).toBe(24)
+			expect(readPixels(notes, 'top', '::after')).toBe(32)
+			expect(readPixels(notes, 'left', '::after')).toBe(12)
+			// The floated top inset, the height, and the backdrop's `em` height are the release's
+			// literals, which no factor moves.
+			expect(readPixels(filled, 'padding-top')).toBe(26)
+			expect(readPixels(filled, 'height')).toBe(58)
+			// That split is the limit the guide records: the resting insets grow while the declared
+			// height holds, so at this factor they outgrow it and the empty control grows past the
+			// height the filled one keeps.
+			expect(
+				readPixels(empty, 'padding-top') + readPixels(empty, 'padding-bottom'),
+			).toBeGreaterThan(58)
+			expect(readPixels(empty, 'height')).toBeGreaterThan(58)
+		} finally {
+			document.documentElement.style.removeProperty(TOKEN_NAMES.factor.density)
+		}
+		expect(readPixels(label, 'padding-top')).toBe(16)
+		expect(readPixels(filled, 'padding-bottom')).toBe(10)
+	})
+
+	it('reads the border width, the body color, and the backdrop surface and radius from the Bootstrap globals', () => {
+		const host = scene.mount(`<div>${FORM_FLOATING_MARKUP}</div>`)
+		const scope = requireValue(host.querySelector(':scope > div'), 'No fixture wrapper')
+		if (!(scope instanceof HTMLElement)) throw new Error('The fixture wrapper is no element')
+		const control = requireValue(host.querySelector('#floating-empty'), 'No empty control')
+		const label = requireValue(host.querySelector('label[for="floating-empty"]'), 'No label')
+		const notes = requireValue(host.querySelector('label[for="floating-notes"]'), 'No notes')
+		const plaintext = requireValue(host.querySelector('label[for="floating-account"]'), 'No label')
+		const globals = Object.freeze([
+			Object.freeze({ name: '--bs-border-width', value: '3px' }),
+			Object.freeze({ name: '--bs-body-color-rgb', value: '10, 20, 30' }),
+			Object.freeze({ name: '--bs-body-bg', value: 'rgb(40, 50, 60)' }),
+			Object.freeze({ name: '--bs-border-radius', value: '9px' }),
+		])
+		// Each global is set on an ancestor, which is where a consumer retunes a Bootstrap variable,
+		// and each declaration reading it follows: a rule writing the release's compiled value
+		// instead would stay where it was.
+		for (const { name, value } of globals) scope.style.setProperty(name, value)
+		try {
+			expect(readPixels(control, 'height')).toBe(62)
+			expect(readPixels(label, 'border-top-width')).toBe(3)
+			expect(readPixels(plaintext, 'border-top-width')).toBe(3)
+			expect(readPixels(plaintext, 'border-left-width')).toBe(0)
+			expect(readStyle(label, 'color')).toBe('rgba(10, 20, 30, 0.65)')
+			expect(readStyle(notes, 'background-color', '::after')).toBe('rgb(40, 50, 60)')
+			expect(readPixels(notes, 'border-top-left-radius', '::after')).toBe(9)
+		} finally {
+			for (const { name } of globals) scope.style.removeProperty(name)
+		}
+		expect(readPixels(control, 'height')).toBe(58)
+		// The radius reaches the backdrop through `--bs-border-radius`, which the cascade declares
+		// over the base radius token, so the published radius factor moves it too.
+		expect(readPixels(notes, 'border-top-left-radius', '::after')).toBe(6)
+		document.documentElement.style.setProperty(TOKEN_NAMES.factor.radius, '2')
+		try {
+			expect(readPixels(notes, 'border-top-left-radius', '::after')).toBe(12)
+		} finally {
+			document.documentElement.style.removeProperty(TOKEN_NAMES.factor.radius)
+		}
+	})
+
+	it('retunes the label fade and the backdrop with the color mode and holds the disabled gray', () => {
+		const host = scene.mount(
+			`<div><div>${FORM_FLOATING_MARKUP}</div><div data-bs-theme="dark">${FORM_FLOATING_MARKUP}</div></div>`,
+		)
+		const [lightFade, darkFade] = host.querySelectorAll('label[for="floating-empty"]')
+		const [lightBackdrop, darkBackdrop] = host.querySelectorAll('label[for="floating-notes"]')
+		const [lightGray, darkGray] = host.querySelectorAll('label[for="floating-code"]')
+		expect(readStyle(requireValue(lightFade, 'No light label'), 'color')).not.toBe(
+			readStyle(requireValue(darkFade, 'No dark label'), 'color'),
+		)
+		expect(
+			readStyle(requireValue(lightBackdrop, 'No light notes'), 'background-color', '::after'),
+		).not.toBe(
+			readStyle(requireValue(darkBackdrop, 'No dark notes'), 'background-color', '::after'),
+		)
+		expect(readStyle(requireValue(lightGray, 'No light code'), 'color')).toBe(
+			readStyle(requireValue(darkGray, 'No dark code'), 'color'),
+		)
+	})
+})
+
+describe('form floating cascade', () => {
+	it('authors every case selector in the components layer with the custom properties it reads', () => {
+		const rules = collectLayer('components').filter((rule) => rule instanceof CSSStyleRule)
+		const missing: string[] = []
+		for (const entry of FORM_FLOATING_CASES) {
+			const declared = rules
+				.filter((rule) =>
+					rule.selectorText
+						.split(',')
+						.map((part) => normalizeSelectorText(part))
+						.includes(entry.selector),
+				)
+				.map((rule) => rule.style.cssText)
+				.join(' ')
+			if (declared.length === 0) missing.push(entry.selector)
+			expect([...entry.reads].filter((name) => !declared.includes(`var(${name})`))).toEqual([])
+		}
+		expect(missing).toEqual([])
+	})
+
+	it('keeps the undrivable autofill rules as the release writes them, each in a rule of its own', () => {
+		// No script can put a control into the autofilled state, so these rules have no resolved
+		// reading on this host; the declarations the cascade authors are what this reads, which is
+		// compiled-contract evidence rather than a rendered proof.
+		const rules = collectLayer('components').filter((rule) => rule instanceof CSSStyleRule)
+		const autofill = FORM_FLOATING_CASES.filter((entry) => entry.selector.includes('autofill'))
+		expect(autofill).toHaveLength(3)
+		// The floated transform the autofill rule declares is held to the one the focus rule declares,
+		// whose resolved matrix the state cases read. The build spells the release's trailing
+		// `translateX()` as the equivalent `translate()`, so the comparison is between two rules of
+		// one build rather than against the source text.
+		const floated = requireValue(
+			rules.find((rule) =>
+				rule.selectorText
+					.split(',')
+					.map((part) => normalizeSelectorText(part))
+					.includes('.form-floating > .form-control:focus ~ label'),
+			),
+			'No focused label rule',
+		).style.getPropertyValue('transform')
+		expect(floated).toMatch(/^scale\(0\.85\) translateY\(-0\.5rem\) translate(?:X)?\(0\.15rem\)$/u)
+		// Each autofill selector heads exactly one rule, which is what keeps the build from folding it
+		// into a list an engine that does not know the pseudo-class would drop whole.
+		expect(
+			autofill.map(
+				(entry) =>
+					rules.filter((rule) => normalizeSelectorText(rule.selectorText) === entry.selector)
+						.length,
+			),
+		).toEqual(autofill.map(() => 1))
+		const declarations = autofill.map(
+			(entry) =>
+				requireValue(
+					rules.find((rule) => normalizeSelectorText(rule.selectorText) === entry.selector),
+					`No ${entry.selector} rule`,
+				).style,
+		)
+		expect(
+			declarations.map((style) => [
+				style.getPropertyValue('padding-top'),
+				style.getPropertyValue('padding-bottom'),
+				style.getPropertyValue('transform'),
+			]),
+		).toEqual(
+			autofill.map((entry) =>
+				entry.selector.endsWith('~ label')
+					? ['', '', floated]
+					: ['1.625rem', `var(${TOKEN_NAMES.space[5]})`, ''],
+			),
+		)
+	})
+})
