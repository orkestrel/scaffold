+		const host = scene.mount(`<div>${FORM_FLOATING_MARKUP}</div>`)
+		const containers = [...host.querySelectorAll('.form-floating')]
+		expect(containers.map((element) => readStyle(element, 'position'))).toEqual(
+			containers.map(() => 'relative'),
+		)
+		// The height is the release's 3.5rem plus the two border widths the control carries, so a
+		// 16px root and a 1px border resolve it to 58px. The line height is unitless, so it resolves
+		// against the control's own text, which inherits the body size.
+		for (const id of ['floating-empty', 'floating-notes', 'floating-carrier', 'floating-account']) {
+			const control = requireValue(host.querySelector(`#${id}`), `No ${id} control`)
+			expect(readPixels(control, 'height')).toBe(58)
+			expect(readPixels(control, 'min-height')).toBe(58)
+		}
+		for (const id of ['floating-empty', 'floating-notes', 'floating-account']) {
+			const control = requireValue(host.querySelector(`#${id}`), `No ${id} control`)
+			expect(readPixels(control, 'line-height')).toBeCloseTo(
+				readPixels(control, 'font-size') * 1.25,
