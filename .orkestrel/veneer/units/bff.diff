diff --git a/src/styles/components/_form-floating.scss b/src/styles/components/_form-floating.scss
new file mode 100644
index 0000000..0edceff
--- /dev/null
+++ b/src/styles/components/_form-floating.scss
@@ -0,0 +1,132 @@
+@use '../mixins' as *;
+
+@layer components {
+	// The floating label ships Bootstrap's recorded surface. A space value routes through the
+	// density token that already resolves to it, so the resting inset, the label inset, the select's
+	// start inset, the floated bottom inset, and the textarea backdrop's inset read `--vn-space-*`.
+	// The control's height, its line height, the floated top inset, the backdrop's `em` height, the
+	// stacking, and the label's transform stay literal: no published Veneer scale resolves to the
+	// recorded value, and the transform and its origin are the release's own bytes. Every value the
+	// release writes as a `--bs-*` variable reads that variable, so a consumer retuning the border
+	// width, the body color, the body surface, or the base radius moves this family with the rest of
+	// the cascade.
+	//
+	// The control's own border and paint are `.form-control` and `.form-select` rules; this partial
+	// writes only the geometry the floating container changes about them. The validation and
+	// input-group rules the release records against this container belong to those families.
+	.form-floating {
+		position: relative;
+	}
+
+	.form-floating > .form-control,
+	.form-floating > .form-control-plaintext,
+	.form-floating > .form-select {
+		height: calc(3.5rem + calc(var(--bs-border-width) * 2));
+		min-height: calc(3.5rem + calc(var(--bs-border-width) * 2));
+		line-height: 1.25;
+	}
+
+	// The label sits over the control's own padding box and fills it, so its text lines up with the
+	// control's text at rest. Its border is transparent and exists for the box model: it matches the
+	// control's border width, which is what keeps the two texts on one line.
+	.form-floating > label {
+		position: absolute;
+		top: 0;
+		left: 0;
+		z-index: 2;
+		max-width: 100%;
+		height: 100%;
+		padding: var(--vn-space-8) var(--vn-space-6);
+		overflow: hidden;
+		color: rgba(var(--bs-body-color-rgb), 0.65);
+		text-align: start;
+		text-overflow: ellipsis;
+		white-space: nowrap;
+		pointer-events: none;
+		border: var(--bs-border-width) solid transparent;
+		transform-origin: 0 0;
+		@include transition((opacity 0.1s ease-in-out, transform 0.1s ease-in-out));
+	}
+
+	.form-floating > .form-control,
+	.form-floating > .form-control-plaintext {
+		padding: var(--vn-space-8) var(--vn-space-6);
+	}
+
+	// A control reports itself empty through `:placeholder-shown` only when it carries a
+	// placeholder, so the placeholder text is hidden and the label alone names the control at rest.
+	.form-floating > .form-control::placeholder,
+	.form-floating > .form-control-plaintext::placeholder {
+		color: transparent;
+	}
+
+	.form-floating > .form-control:focus,
+	.form-floating > .form-control:not(:placeholder-shown),
+	.form-floating > .form-control-plaintext:focus,
+	.form-floating > .form-control-plaintext:not(:placeholder-shown) {
+		padding-top: 1.625rem;
+		padding-bottom: var(--vn-space-5);
+	}
+
+	// An engine that does not know `:-webkit-autofill` drops a whole selector list naming it, so the
+	// autofilled control takes rules of its own rather than joining the group before it. Each
+	// selector is its own rule because the build rewrites a list naming the pseudo-class into one
+	// `:is()` selector, which is a selector the release does not write.
+	.form-floating > .form-control:-webkit-autofill {
+		padding-top: 1.625rem;
+		padding-bottom: var(--vn-space-5);
+	}
+
+	.form-floating > .form-control-plaintext:-webkit-autofill {
+		padding-top: 1.625rem;
+		padding-bottom: var(--vn-space-5);
+	}
+
+	.form-floating > .form-select {
+		padding-top: 1.625rem;
+		padding-bottom: var(--vn-space-5);
+		padding-left: var(--vn-space-6);
+	}
+
+	.form-floating > .form-control:focus ~ label,
+	.form-floating > .form-control:not(:placeholder-shown) ~ label,
+	.form-floating > .form-control-plaintext ~ label,
+	.form-floating > .form-select ~ label {
+		transform: scale(0.85) translateY(-0.5rem) translateX(0.15rem);
+	}
+
+	.form-floating > .form-control:-webkit-autofill ~ label {
+		transform: scale(0.85) translateY(-0.5rem) translateX(0.15rem);
+	}
+
+	// A textarea's text scrolls under its floated label, so the label paints a backdrop behind its
+	// own text in the control's surface. The backdrop sits inside the label's inset and behind the
+	// label's text.
+	.form-floating > textarea:focus ~ label::after,
+	.form-floating > textarea:not(:placeholder-shown) ~ label::after {
+		position: absolute;
+		inset: var(--vn-space-8) var(--vn-space-3);
+		z-index: -1;
+		height: 1.5em;
+		content: '';
+		background-color: var(--bs-body-bg);
+		border-radius: var(--bs-border-radius);
+	}
+
+	.form-floating > textarea:disabled ~ label::after {
+		background-color: var(--bs-secondary-bg);
+	}
+
+	// The plaintext control draws its border on the block axis alone, so its label does too.
+	.form-floating > .form-control-plaintext ~ label {
+		border-width: var(--bs-border-width) 0;
+	}
+
+	// The release writes the class-qualified twin beside the bare disabled rule, and both ship. The
+	// gray entry is the one that resolves to the release's own disabled label color, and it holds one
+	// value in both color modes, as the release's literal does.
+	.form-floating > :disabled ~ label,
+	.form-floating > .form-control:disabled ~ label {
+		color: var(--vn-gray-600);
+	}
+}
