+		const control = requireValue(host.querySelector('#floating-empty'), 'No empty control')
+		const label = requireValue(host.querySelector('label[for="floating-empty"]'), 'No empty label')
+		const container = requireValue(control.parentElement, 'No container')
+		expect(readStyle(label, 'position')).toBe('absolute')
