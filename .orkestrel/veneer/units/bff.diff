new file mode 100644
index 0000000..dc0fc5b
--- /dev/null
+++ b/app/browser/sections/FormFloatingSection.ts
@@ -0,0 +1,20 @@
+import { FORM_FLOATING_COPY, FORM_FLOATING_SPECIMENS } from '../constants.js'
+import { SpecimenSection } from './SpecimenSection.js'
+
+/**
+ * Renders the declared floating-label specimens into a named region.
+ * @example
+ * ```ts
+ * const section = new FormFloatingSection(document.body)
+ * section.destroy()
+ * ```
+ */
+export class FormFloatingSection extends SpecimenSection {
+	/**
+	 * Mounts the Form floating region and its specimens.
+	 * @param host - The element receiving the section.
+	 */
+	constructor(host: HTMLElement) {
+		super(host, FORM_FLOATING_COPY, FORM_FLOATING_SPECIMENS)
+	}
+}
