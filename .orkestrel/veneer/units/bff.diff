+			)
+		}
+		// Chromium resets the line height of a select that keeps its native appearance to `normal`,
+		// whatever an author rule declares; the `.form-select` rule that removes that appearance
+		// belongs to the select family, which this tree does not ship yet. Until it does, the
+		// declaration the select shares with the text controls is read where the cascade authors it.
+		const select = requireValue(host.querySelector('#floating-carrier'), 'No select')
+		expect(readStyle(select, 'line-height')).toBe('normal')
+		const sized = requireValue(
+			collectLayer('components').find(
+				(rule) =>
+					rule instanceof CSSStyleRule &&
+					rule.selectorText
+						.split(',')
+						.map((part) => normalizeSelectorText(part))
+						.includes('.form-floating > .form-select') &&
+					rule.style.getPropertyValue('line-height') !== '',
+			),
+			'No sized select rule',
+		)
+		expect(sized instanceof CSSStyleRule && sized.style.getPropertyValue('line-height')).toBe(
+			'1.25',
