+		// label in flow: a partial that stopped scoping these rules to the container would report the
+		// floated geometry here.
+		const bare = requireValue(host.querySelector('#bare-entry'), 'No bare control')
+		const label = requireValue(host.querySelector('label[for="bare-entry"]'), 'No bare label')
+		expect(readStyle(requireValue(bare.parentElement, 'No bare wrapper'), 'position')).toBe(
+			'static',
+		)
+		expect(readPixels(bare, 'height')).not.toBe(58)
+		expect(readStyle(label, 'position')).toBe('static')
+		expect(readStyle(label, 'transform')).toBe('none')
+	})
