+describe('form floating motion', () => {
+	it('transitions the label opacity and transform and collapses both under reduced motion', async () => {
+		const host = scene.mount(`<div>${FORM_FLOATING_MARKUP}</div>`)
+		const label = requireValue(host.querySelector('label[for="floating-empty"]'), 'No label')
