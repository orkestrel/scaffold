+describe('form floating disabled labels', () => {
+	it('grays the label of a disabled control in both modes, the select included', () => {
+		const host = scene.mount(
+			`<div><div>${FORM_FLOATING_MARKUP}</div><div data-bs-theme="dark">${FORM_FLOATING_MARKUP}</div></div>`,
+		)
+		const gray = readToken(host, TOKEN_NAMES.gray[600])
+		expect(matchesColor(gray, '#6c757d')).toBe(true)
+		// The select carries no `.form-control`, so its label answers to the bare disabled rule
+		// alone: a partial that dropped that rule leaves this label at the resting fade.
+		for (const id of ['floating-code', 'floating-archive', 'floating-depot']) {
+			const labels = [...host.querySelectorAll(`label[for="${id}"]`)]
+			expect(labels).toHaveLength(2)
+			for (const label of labels) expect(matchesColor(readStyle(label, 'color'), gray)).toBe(true)
+		}
+		for (const label of host.querySelectorAll('label[for="floating-empty"]'))
+			expect(matchesColor(readStyle(label, 'color'), gray)).toBe(false)
+		// The class-qualified twin paints what the bare rule already paints, so no resolved reading
+		// separates it; its declaration is read where the cascade authors it.
+		const twin = collectLayer('components').filter(
+			(rule) =>
+				rule instanceof CSSStyleRule &&
+				rule.selectorText
+					.split(',')
+					.map((part) => normalizeSelectorText(part))
+					.includes('.form-floating > .form-control:disabled ~ label'),
+		)
+		expect(twin).toHaveLength(1)
+		expect(
+			twin.filter(
+				(rule) =>
+					!(rule instanceof CSSStyleRule) ||
+					rule.style.getPropertyValue('color') !== `var(${TOKEN_NAMES.gray[600]})`,
+			),
+		).toEqual([])
+	})
+})
