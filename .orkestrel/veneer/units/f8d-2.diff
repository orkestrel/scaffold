+export interface LonghandRule {
+	/** Holds the selector of the rule, as Chromium serializes it for an expanded rule. */
+	readonly selector: string
+	/** Holds each longhand property name the rule declares, in Chromium order for an expanded rule. */
+	readonly properties: readonly string[]
