+import { COLOR_MODE_COPY, COLOR_MODE_SPECIMENS } from '../constants.js'
+import { SpecimenSection } from './SpecimenSection.js'
+
+/**
+ * Renders the declared color mode specimens into a named region.
+ * @example
+ * ```ts
+ * const section = new ColorModeSection(document.body)
+ * section.destroy()
+ * ```
+ */
+export class ColorModeSection extends SpecimenSection {
+	/**
+	 * Mounts the Color modes region and its specimens.
+	 * @param host - The element receiving the section.
+	 */
+	constructor(host: HTMLElement) {
+		super(host, COLOR_MODE_COPY, COLOR_MODE_SPECIMENS)
+	}
+}
