+import type { SectionInterface } from '@app/browser'
+import {
+	COLOR_MODE_COPY,
+	COLOR_MODE_SPECIMENS,
+	ColorModeSection,
+	SpecimenSection,
+} from '@app/browser'
+import { requireValue } from '@orkestrel/test'
+import { build, mount, readStyle } from '@orkestrel/test/browser'
+import { beforeAll, describe, expect, it } from 'vitest'
+import { readSpecimen } from '../../../setupBrowser.js'
+
+// Each surface claims a mode the published cascade resolves from its attribute, so the cascade has
+// to be in the document before a reading of that mode means anything.
+beforeAll(async () => {
+	await import('../../../../src/styles/index.scss')
+	await import('../../../../app/browser/styles/index.scss')
+})
+
+describe('ColorModeSection', () => {
+	it('renders the declared color mode specimens through the shared section contract', () => {
+		const host = mount(build('div'))
+		const section: SectionInterface = new ColorModeSection(host)
+		try {
+			expect(section).toBeInstanceOf(SpecimenSection)
+			expect(section.host).toBe(host)
+			const region = requireValue(host.querySelector('section'), 'No Color modes region')
+			expect(region.getAttribute('aria-label')).toBe('Color modes')
+			expect(region.querySelector('p')?.textContent).toBe(COLOR_MODE_COPY.paragraph)
+			expect(COLOR_MODE_SPECIMENS).not.toStrictEqual([])
+			const rendered = [...region.querySelectorAll('[data-specimen]')]
+			expect(rendered.map((element) => element.getAttribute('data-specimen'))).toEqual(
+				COLOR_MODE_SPECIMENS.map(({ name }) => name),
+			)
+			expect(rendered.map((element) => element.innerHTML)).toEqual(
+				COLOR_MODE_SPECIMENS.map(({ markup }) => markup),
+			)
+			// Each mode is an attribute written in markup, and no specimen writes an inline style or
+			// carries an identifier a lifted copy of it would repeat.
+			expect(region.querySelector('[style]')).toBeNull()
+			expect(region.querySelector('[id]')).toBeNull()
+			expect(Object.isFrozen(COLOR_MODE_COPY)).toBe(true)
+			expect(Object.isFrozen(COLOR_MODE_SPECIMENS)).toBe(true)
+			expect(COLOR_MODE_SPECIMENS.every((entry) => Object.isFrozen(entry))).toBe(true)
+		} finally {
+			section.destroy()
+			host.remove()
+		}
+	})
+
+	// The mutations this catches are a surface that stops declaring its mode, a surface moved out of
+	// the one it nests in, and a surface that drops one of the controls whose dark image the release
+	// retunes: each surface is read for the controls it carries itself, not the ones a surface nested
+	// in it carries.
+	it('nests a dark island in a light surface and a light island in the dark one, each carrying the same controls', () => {
+		const host = mount(build('div'))
+		const section: SectionInterface = new ColorModeSection(host)
+		try {
+			const region = requireValue(host.querySelector('section'), 'No Color modes region')
+			const specimen = readSpecimen(region, 'Nested islands')
+			const surfaces = [...specimen.querySelectorAll('[data-bs-theme]')]
+			expect(surfaces.map((surface) => surface.getAttribute('data-bs-theme'))).toEqual([
+				'light',
+				'dark',
+				'light',
+			])
+			expect(surfaces.map((surface) => surface.parentElement?.closest('[data-bs-theme]'))).toEqual([
+				null,
+				surfaces[0],
+				surfaces[1],
+			])
+			const controls = [
+				'p',
+				'.btn',
+				'select.form-select',
+				'.form-switch > input.form-check-input[role="switch"]',
+				'.navbar > .navbar-toggler > .navbar-toggler-icon',
+				'.accordion-header > .accordion-button',
+			]
+			expect(
+				surfaces.map((surface) =>
+					controls.map(
+						(selector) =>
+							[...surface.querySelectorAll(selector)].filter(
+								(element) => element.closest('[data-bs-theme]') === surface,
+							).length,
+					),
+				),
+			).toEqual(surfaces.map(() => controls.map(() => 1)))
+		} finally {
+			section.destroy()
+			host.remove()
+		}
+	})
+
+	// The dark island resolves the dark closure and the nested island returns to the light one for
+	// the body text, the fill, and the scheme. The dark images do not return: the release writes each
+	// one on a component rule under any dark ancestor, so the nested island's caret is the dark
+	// island's, which is the release's own behavior.
+	it('resolves each surface to its own mode, and keeps the dark caret in the nested light island', () => {
+		const host = mount(build('div'))
+		const section: SectionInterface = new ColorModeSection(host)
+		try {
+			const region = requireValue(host.querySelector('section'), 'No Color modes region')
+			const surfaces = [
+				...readSpecimen(region, 'Nested islands').querySelectorAll('[data-bs-theme]'),
+			]
+			const readings = surfaces.map((surface) => {
+				const select = requireValue(
+					[...surface.querySelectorAll('.form-select')].find(
+						(element) => element.closest('[data-bs-theme]') === surface,
+					),
+					'No select on the surface',
+				)
+				return {
+					scheme: readStyle(surface, 'color-scheme'),
+					text: readStyle(surface, 'color'),
+					fill: readStyle(surface, 'background-color'),
+					caret: readStyle(select, 'background-image'),
+				}
+			})
+			const [outer, island, inner] = readings
+			expect(readings.map(({ scheme }) => scheme)).toEqual(['light', 'dark', 'light'])
+			expect(island?.text).not.toBe(outer?.text)
+			expect(island?.fill).not.toBe(outer?.fill)
+			expect(inner?.text).toBe(outer?.text)
+			expect(inner?.fill).toBe(outer?.fill)
+			expect(island?.caret).not.toBe(outer?.caret)
+			expect(inner?.caret).toBe(island?.caret)
+		} finally {
+			section.destroy()
+			host.remove()
+		}
+	})
+
+	it('releases the region and preserves adjacent content on repeated destruction', () => {
+		const host = mount(build('div'))
+		const neighbor = build('p', { text: 'Existing content' })
+		host.append(neighbor)
+		const section: SectionInterface = new ColorModeSection(host)
+		try {
+			const region = requireValue(host.querySelector('section'), 'No Color modes region')
+			expect(region.isConnected).toBe(true)
+			section.destroy()
+			expect(region.isConnected).toBe(false)
+			section.destroy()
+			expect([...host.children]).toEqual([neighbor])
+		} finally {
+			section.destroy()
+			host.remove()
+		}
+	})
+})
