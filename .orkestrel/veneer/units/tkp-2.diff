+		const host = scene.mount(
+			`<div style="${TOKEN_NAMES.link.base}: rgb(200, 30, 40)">` +
+				'<a id="inside-link" href="#inside-link">Inside link</a>' +
+				'<button id="inside-button" type="button" class="btn btn-link">Inside button</button>' +
+				'</div>' +
+				'<a id="twin-link" href="#twin-link">Twin link</a>' +
+				'<button id="twin-button" type="button" class="btn btn-link">Twin button</button>',
+		)
+		const insideLink = requireValue(host.querySelector('#inside-link'), 'No inside link')
+		const insideButton = requireValue(host.querySelector('#inside-button'), 'No inside button')
+		const twinLink = requireValue(host.querySelector('#twin-link'), 'No twin link')
+		const twinButton = requireValue(host.querySelector('#twin-button'), 'No twin button')
+		expect(
+			matchesColor(readStyle(twinLink, 'color'), 'color(srgb 0.0510206 0.212902 0.672726)'),
