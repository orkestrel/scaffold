+import { TOKEN_NAMES } from '@src/core'
+import { requireValue } from '@orkestrel/test'
+import { matchesColor, readPixels, readStyle, readToken } from '@orkestrel/test/browser'
+import { afterEach, describe, expect, it } from 'vitest'
+import { collectLayer, scene } from '../../../setupBrowser.js'
+import { normalizeSelectorText } from '../../../setup.js'
+import {
+	FORM_LABEL_CASES,
+	FORM_LABEL_MARKUP,
+	splitTopLevelList,
+	TEXT_MODES,
+} from '../../../setupStyles.js'
+
+afterEach(() => {
+	document.documentElement.style.removeProperty(TOKEN_NAMES.factor.density)
+	scene.clear()
+})
+
+describe('form label spacing and help text', () => {
+	it('spaces a label above its control and help text under it from the space scale', () => {
+		const host = scene.mount(`<div>${FORM_LABEL_MARKUP}</div>`)
+		const label = requireValue(host.querySelector('.form-label'), 'No stacked label')
+		const help = requireValue(host.querySelector('.form-text'), 'No help text')
+		// The release's `0.5rem` and `0.25rem` at a 16px root. A literal length reads the same here and
+		// is what the doubled factor separates.
+		expect(readPixels(label, 'margin-bottom')).toBe(8)
+		expect(readPixels(help, 'margin-top')).toBe(4)
+		// The factor is set on the document element because that is where the space tokens compute.
+		document.documentElement.style.setProperty(TOKEN_NAMES.factor.density, '2')
+		expect(readPixels(label, 'margin-bottom')).toBe(16)
+		expect(readPixels(help, 'margin-top')).toBe(8)
+	})
+
+	it('sets help text at 0.875 of the type around it rather than of the root', () => {
+		const host = scene.mount(`<div>${FORM_LABEL_MARKUP}</div>`)
+		const help = requireValue(host.querySelector('.form-text'), 'No help text')
+		// The parent sets 20px, so the element-relative size reads 17.5px where a root-relative
+		// `0.875rem` or the `--vn-size-2` token would read 14px.
+		expect(readPixels(requireValue(help.parentElement, 'No parent'), 'font-size')).toBe(20)
+		expect(readPixels(help, 'font-size')).toBeCloseTo(17.5, 3)
+	})
+
+	it.each(TEXT_MODES)(
+		'paints help text in the secondary text color the %s mode resolves',
+		(mode) => {
+			const host = scene.mount(`<div data-bs-theme="${mode}">${FORM_LABEL_MARKUP}</div>`)
+			const help = requireValue(host.querySelector('.form-text'), 'No help text')
+			const secondary = readToken(help, '--bs-secondary-color')
+			expect(matchesColor(readStyle(help, 'color'), secondary)).toBe(true)
+			// The body text beside it is a different color, so the reading is not the inherited one.
+			expect(matchesColor(readStyle(help, 'color'), readToken(help, '--bs-body-color'))).toBe(false)
+		},
+	)
+
+	it('repaints help text when a wrapper retunes the secondary text color, and follows each mode', () => {
+		const host = scene.mount(
+			`<div><div data-bs-theme="light">${FORM_LABEL_MARKUP}</div><div data-bs-theme="dark">${FORM_LABEL_MARKUP}</div><div data-bs-theme="light" style="--bs-secondary-color: rgb(12, 90, 60)">${FORM_LABEL_MARKUP}</div></div>`,
+		)
+		const [light, dark, retuned] = [...host.querySelectorAll('.form-text')]
+		const lightColor = readStyle(requireValue(light, 'No light help text'), 'color')
+		expect(
+			matchesColor(lightColor, readStyle(requireValue(dark, 'No dark help text'), 'color')),
+		).toBe(false)
+		// A declaration that read the Veneer text token directly would keep the light mode's color
+		// under the wrapper's retune.
+		expect(readStyle(requireValue(retuned, 'No retuned help text'), 'color')).toBe(
+			'rgb(12, 90, 60)',
+		)
+	})
+})
+
+describe('form label horizontal alignment', () => {
+	it("levels a horizontal label's content box with its control's at each size, at a doubled density, and under a border-width and a line-height retune", () => {
+		const host = scene.mount(`<div>${FORM_LABEL_MARKUP}</div>`)
+		const rows = ['label-row', 'label-row-lg', 'label-row-sm'].map((id) =>
+			requireValue(host.querySelector<HTMLElement>(`#${id}`), `No ${id} row`),
+		)
+		// Each retune is applied on top of the ones before it, so the reading after every retune holds
+		// the label under all of them at once.
+		const retunes: ReadonlyArray<
+			readonly [targets: readonly HTMLElement[], property: string, value: string]
+		> = [
+			[[document.documentElement], TOKEN_NAMES.factor.density, '2'],
+			[rows, '--bs-border-width', '4px'],
+			[rows, TOKEN_NAMES.line.body, '2'],
+		]
+		const levels: string[] = []
+		for (const [step, retune] of [undefined, ...retunes].entries()) {
+			if (retune !== undefined)
+				for (const target of retune[0]) target.style.setProperty(retune[1], retune[2])
+			for (const row of rows) {
+				const label = requireValue(row.querySelector('.col-form-label'), `No ${row.id} label`)
+				const control = requireValue(row.querySelector('.form-control'), `No ${row.id} control`)
+				// A content box opens under the element's top border and top padding. The label draws no
+				// border, so its inset alone must equal the control's border and padding together.
+				const text =
+					label.getBoundingClientRect().top +
+					readPixels(label, 'border-top-width') +
+					readPixels(label, 'padding-top')
+				const field =
+					control.getBoundingClientRect().top +
+					readPixels(control, 'border-top-width') +
+					readPixels(control, 'padding-top')
+				if (Math.abs(text - field) > 0.5) levels.push(`${row.id} step ${step}: ${text} ${field}`)
+				// Every label takes its control's type step, and the label and the control read one line
+				// height token, so the label's line box is as tall as the control's.
+				expect(readPixels(label, 'font-size')).toBeCloseTo(readPixels(control, 'font-size'), 3)
+				expect(readPixels(label, 'line-height') / readPixels(label, 'font-size')).toBeCloseTo(
+					readPixels(control, 'line-height') / readPixels(control, 'font-size'),
+					3,
+				)
+			}
+		}
+		expect(levels).toEqual([])
+		// Each retune reached the rows: the base control reads the doubled padding, the retuned
+		// border, and the retuned line height.
+		const control = requireValue(rows[0]?.querySelector('.form-control'), 'No base control')
+		expect(readPixels(control, 'padding-top')).toBe(12)
+		expect(readPixels(control, 'border-top-width')).toBe(4)
+		expect(readPixels(control, 'line-height')).toBe(readPixels(control, 'font-size') * 2)
+	})
+
+	it('reads the large and small type steps on the sized labels', () => {
+		const host = scene.mount(`<div>${FORM_LABEL_MARKUP}</div>`)
+		const large = requireValue(host.querySelector('.col-form-label-lg'), 'No large label')
+		const small = requireValue(host.querySelector('.col-form-label-sm'), 'No small label')
+		// The release's `1.25rem` and `0.875rem` at a 16px root, with their block insets of `0.5rem`
+		// and `0.25rem` over the 1px border.
+		expect(readPixels(large, 'font-size')).toBe(20)
+		expect(readPixels(small, 'font-size')).toBe(14)
+		expect(readPixels(large, 'padding-top')).toBe(9)
+		expect(readPixels(large, 'padding-bottom')).toBe(9)
+		expect(readPixels(small, 'padding-top')).toBe(5)
+		expect(readPixels(small, 'padding-bottom')).toBe(5)
+	})
+
+	it("clears a legend's own margin and sets it in its control's type when it labels a horizontal group", () => {
+		const host = scene.mount(`<div>${FORM_LABEL_MARKUP}</div>`)
+		const group = requireValue(host.querySelector('#label-group'), 'No labelled group')
+		const legend = requireValue(group.querySelector('legend'), 'No group legend')
+		const control = requireValue(group.querySelector('.form-control'), 'No group control')
+		const bare = requireValue(host.querySelector('#label-bare legend'), 'No bare legend')
+		// The bare legend keeps the elements layer's trailing margin and larger type, which is what the
+		// class clears.
+		expect(readPixels(bare, 'margin-bottom')).toBe(8)
+		expect(readPixels(bare, 'font-size')).toBeGreaterThan(readPixels(control, 'font-size'))
+		expect(readPixels(legend, 'margin-bottom')).toBe(0)
+		expect(readPixels(legend, 'font-size')).toBe(readPixels(control, 'font-size'))
+		expect(readPixels(legend, 'padding-top')).toBe(7)
+	})
+})
+
+describe('form label cascade', () => {
+	it('authors every label case selector in the components layer', () => {
+		const rules = collectLayer('components').filter((rule) => rule instanceof CSSStyleRule)
+		expect(
+			FORM_LABEL_CASES.filter(
+				(entry) =>
+					!rules.some((rule) =>
+						splitTopLevelList(rule.selectorText)
+							.map((part) => normalizeSelectorText(part))
+							.includes(entry.selector),
+					),
+			).map((entry) => entry.selector),
+		).toEqual([])
+	})
+})
