--- /dev/null
+++ b/src/styles/components/_form-label.scss
@@ -0,0 +1,41 @@
+// Names each horizontal label size with the block inset and the type step the control of the same
+// size reads. The release writes the large size before the small one, and the list keeps that
+// order.
+$sizes: (('lg', var(--vn-space-4), var(--vn-size-5)), ('sm', var(--vn-space-2), var(--vn-size-2)));
+
+@layer components {
+	// The label and the help text space themselves from their control with the space scale, so a
+	// density retune moves them with it. The help text keeps the release's `0.875em`, which no
+	// published scale expresses because it is relative to the element's own type, and reads the
+	// secondary text color the release names.
+	.form-label {
+		margin-bottom: var(--vn-space-4);
+	}
+
+	.form-text {
+		margin-top: var(--vn-space-2);
+		font-size: 0.875em;
+		color: var(--bs-secondary-color);
+	}
+
+	// The horizontal label reads the tokens the control's own inset and type read: its block inset is
+	// the control's padding plus the control's border width, and its type step and line height are
+	// the control's, so its line box opens level with the control's at each size, under a density
+	// retune, and under a border-width retune. On a `legend` element it also clears the element's own
+	// trailing margin and type size.
+	.col-form-label {
+		padding-top: calc(var(--vn-space-3) + var(--bs-border-width));
+		padding-bottom: calc(var(--vn-space-3) + var(--bs-border-width));
+		margin-bottom: 0;
+		font-size: var(--vn-size-3);
+		line-height: var(--vn-line-body);
+	}
+
+	@each $size, $space, $font in $sizes {
+		.col-form-label-#{$size} {
+			padding-top: calc(#{$space} + var(--bs-border-width));
+			padding-bottom: calc(#{$space} + var(--bs-border-width));
+			font-size: $font;
+		}
+	}
+}
