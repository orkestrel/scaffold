+/**
+ * Computes the content extent a computed reading resolves along one dimension.
+ *
+ * @param reading - The computed values keyed by property, such as one map the stage's `read`
+ *   method returns.
+ * @param dimension - The dimension and the edges its border-box reading spans, such as a row of the
+ *   `PREFLIGHT_DIMENSIONS` table.
+ * @returns The dimension's pixel length less the pixel length of each edge where the reading's
+ *   `box-sizing` value is `border-box`, and the dimension's own length otherwise; `undefined` where
+ *   the dimension or an edge that subtraction needs is absent or is not a pixel length.
+ *
+ * @example
+ * ```ts
+ * computeContentExtent(
+ *   new Map([['box-sizing', 'border-box'], ['height', '20px'], ['border-top-width', '1px']]),
+ *   ['height', ['border-top-width']],
+ * ) // 19
+ * ```
+ */
+export function computeContentExtent(
+	reading: ReadonlyMap<string, string>,
+	dimension: readonly [dimension: string, edges: readonly string[]],
+): number | undefined {
+	const [name, edges] = dimension
+	let extent: number | undefined
+	for (const property of [name, ...(reading.get('box-sizing') === 'border-box' ? edges : [])]) {
+		const length = /^(-?\d+(?:\.\d+)?)px$/u.exec(reading.get(property) ?? '')?.[1]
+		if (length === undefined) return undefined
+		extent = extent === undefined ? Number(length) : extent - Number(length)
+	}
+	return extent
+}
