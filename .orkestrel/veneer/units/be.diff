diff --git a/src/styles/components/_placeholder.scss b/src/styles/components/_placeholder.scss
new file mode 100644
index 0000000..42e0a7f
--- /dev/null
+++ b/src/styles/components/_placeholder.scss
@@ -0,0 +1,65 @@
+@layer components {
+	// A placeholder stands in for content that has not arrived, so it paints the current text color
+	// at half strength and takes the wait cursor. Its height floor is written in `em`, which is what
+	// makes a placeholder inside a heading as tall as that heading's own line.
+	.placeholder {
+		display: inline-block;
+		min-height: 1em;
+		vertical-align: middle;
+		cursor: wait;
+		background-color: currentcolor;
+		opacity: 0.5;
+	}
+
+	// A button-shaped placeholder carries no text, so this empty inline box is what gives the
+	// button its own line box and keeps the control at its resting height.
+	.placeholder.btn::before {
+		display: inline-block;
+		content: '';
+	}
+
+	.placeholder-xs {
+		min-height: 0.6em;
+	}
+
+	.placeholder-sm {
+		min-height: 0.8em;
+	}
+
+	.placeholder-lg {
+		min-height: 1.2em;
+	}
+
+	// The glow dims every placeholder inside the wrapper rather than the wrapper itself, so a
+	// paragraph of placeholders pulses as one block.
+	.placeholder-glow .placeholder {
+		animation: placeholder-glow 2s ease-in-out infinite;
+	}
+
+	@keyframes placeholder-glow {
+		50% {
+			opacity: 0.2;
+		}
+	}
+
+	// The wave is a mask that travels across the element, so it dims whatever the element paints
+	// instead of laying a second color over it. Only the standard mask properties are written: the
+	// build's targets resolve them, which leaves the prefixed aliases the release carries
+	// redundant, and the ledger records their absence.
+	.placeholder-wave {
+		mask-image: linear-gradient(
+			130deg,
+			var(--vn-palette-black-base) 55%,
+			rgba(var(--vn-palette-black-rgb), 0.8) 75%,
+			var(--vn-palette-black-base) 95%
+		);
+		mask-size: 200% 100%;
+		animation: placeholder-wave 2s linear infinite;
+	}
+
+	@keyframes placeholder-wave {
+		100% {
+			mask-position: -200% 0%;
+		}
+	}
+}
diff --git a/src/styles/components/_progress.scss b/src/styles/components/_progress.scss
new file mode 100644
index 0000000..7b368b9
--- /dev/null
+++ b/src/styles/components/_progress.scss
@@ -0,0 +1,79 @@
+@use '../mixins' as *;
+
+@layer components {
+	// The stripe displacement reads the track height, so a retuned height moves the stripes with
+	// it and the keyframe carries no second copy of that measurement.
+	@keyframes progress-bar-stripes {
+		0% {
+			background-position-x: var(--bs-progress-height);
+		}
+	}
+
+	// The track and the stacked track declare one closure, which is what lets a stacked bar read
+	// the same variables its children do. The fill color and the bar color are Bootstrap's own
+	// palette values, reached through the palette tokens that carry those bytes, so a consumer
+	// retuning the palette moves the bar.
+	.progress,
+	.progress-stacked {
+		--bs-progress-height: 1rem;
+		--bs-progress-font-size: 0.75rem;
+		--bs-progress-bg: var(--bs-secondary-bg);
+		--bs-progress-border-radius: var(--bs-border-radius);
+		--bs-progress-box-shadow: var(--bs-box-shadow-inset);
+		--bs-progress-bar-color: var(--vn-palette-white-base);
+		--bs-progress-bar-bg: var(--vn-palette-blue);
+		--bs-progress-bar-transition: width 0.6s ease;
+		display: flex;
+		height: var(--bs-progress-height);
+		overflow: hidden;
+		font-size: var(--bs-progress-font-size);
+		background-color: var(--bs-progress-bg);
+		border-radius: var(--bs-progress-border-radius);
+	}
+
+	.progress-bar {
+		display: flex;
+		flex-direction: column;
+		justify-content: center;
+		overflow: hidden;
+		color: var(--bs-progress-bar-color);
+		text-align: center;
+		white-space: nowrap;
+		background-color: var(--bs-progress-bar-bg);
+		@include transition(var(--bs-progress-bar-transition));
+	}
+
+	// The stripe is a gradient over the bar's own fill rather than a second color, so it tints
+	// whatever the bar paints. Its tile is square at the track's height, which is what makes the
+	// diagonal repeat at the angle the gradient names.
+	.progress-bar-striped {
+		background-image: linear-gradient(
+			45deg,
+			rgba(var(--vn-palette-white-rgb), 0.15) 25%,
+			transparent 25%,
+			transparent 50%,
+			rgba(var(--vn-palette-white-rgb), 0.15) 50%,
+			rgba(var(--vn-palette-white-rgb), 0.15) 75%,
+			transparent 75%,
+			transparent
+		);
+		background-size: var(--bs-progress-height) var(--bs-progress-height);
+	}
+
+	// A stacked segment is a track of its own whose overflow is released, so its bar fills the
+	// width the segment was given and the rounding stays on the outer track.
+	.progress-stacked > .progress {
+		overflow: visible;
+	}
+
+	.progress-stacked > .progress > .progress-bar {
+		width: 100%;
+	}
+
+	.progress-bar-animated {
+		animation: 1s linear infinite progress-bar-stripes;
+		@include reduced-motion {
+			animation: none;
+		}
+	}
+}
diff --git a/src/styles/components/_spinner.scss b/src/styles/components/_spinner.scss
new file mode 100644
index 0000000..8b37974
--- /dev/null
+++ b/src/styles/components/_spinner.scss
@@ -0,0 +1,81 @@
+@use '../mixins' as *;
+
+@layer components {
+	// Both spinners are one box that runs one animation, and the variables below are what separate
+	// them: each name declares the speed and the animation it runs, so a consumer retuning the
+	// speed retunes either spinner through the same property.
+	.spinner-grow,
+	.spinner-border {
+		display: inline-block;
+		flex-shrink: 0;
+		width: var(--bs-spinner-width);
+		height: var(--bs-spinner-height);
+		vertical-align: var(--bs-spinner-vertical-align);
+		border-radius: 50%;
+		animation: var(--bs-spinner-animation-speed) linear infinite var(--bs-spinner-animation-name);
+	}
+
+	// The rotation is physical: the ring turns the same way whatever the document's writing
+	// direction, so no direction-flipping annotation ships with it.
+	@keyframes spinner-border {
+		to {
+			transform: rotate(360deg);
+		}
+	}
+
+	.spinner-border {
+		--bs-spinner-width: 2rem;
+		--bs-spinner-height: 2rem;
+		--bs-spinner-vertical-align: -0.125em;
+		--bs-spinner-border-width: 0.25em;
+		--bs-spinner-animation-speed: 0.75s;
+		--bs-spinner-animation-name: spinner-border;
+
+		border: var(--bs-spinner-border-width) solid currentcolor;
+		border-right-color: transparent;
+	}
+
+	.spinner-border-sm {
+		--bs-spinner-width: 1rem;
+		--bs-spinner-height: 1rem;
+		--bs-spinner-border-width: 0.2em;
+	}
+
+	@keyframes spinner-grow {
+		0% {
+			transform: scale(0);
+		}
+
+		50% {
+			opacity: 1;
+			transform: none;
+		}
+	}
+
+	.spinner-grow {
+		--bs-spinner-width: 2rem;
+		--bs-spinner-height: 2rem;
+		--bs-spinner-vertical-align: -0.125em;
+		--bs-spinner-animation-speed: 0.75s;
+		--bs-spinner-animation-name: spinner-grow;
+
+		background-color: currentcolor;
+		opacity: 0;
+	}
+
+	.spinner-grow-sm {
+		--bs-spinner-width: 1rem;
+		--bs-spinner-height: 1rem;
+	}
+
+	// A spinner reports that work is still running, so the reduced-motion preference slows it to
+	// half speed rather than stopping it: a still ring would report the opposite of what the
+	// component exists to say. The speed is a variable, so the preference retunes the same name a
+	// consumer does and the animation itself is declared once.
+	@include reduced-motion {
+		.spinner-border,
+		.spinner-grow {
+			--bs-spinner-animation-speed: 1.5s;
+		}
+	}
+}
