+			expect(region.getAttribute('aria-label')).toBe('Progress')
+			expect(region.querySelector('p')?.textContent).toBe(PROGRESS_COPY.paragraph)
+			const rendered = [...region.querySelectorAll('[data-specimen]')]
+			expect(rendered.map((element) => element.getAttribute('data-specimen'))).toEqual([
+				'Progress base',
+				'Striped progress',
+				'Animated progress',
+				'Stacked progress',
+			])
+			expect(rendered.map((element) => element.innerHTML)).toEqual(
+				PROGRESS_SPECIMENS.map(({ markup }) => markup),
+			)
+			// Every class this key ships reaches the region, which is what makes the specimens the
+			// rendered half of the vocabulary rather than a sample of it.
+			for (const name of [
+				'progress',
+				'progress-bar',
+				'progress-bar-striped',
+				'progress-bar-animated',
+				'progress-stacked',
+			])
+				expect(region.querySelector(`.${name}`)).not.toBeNull()
+			// Every bar announces the share of work it reports, so the region reads as progress
+			// rather than as a row of boxes.
+			for (const element of rendered) {
+				expect(element.querySelector('[role="progressbar"]')).not.toBeNull()
+				expect(element.querySelector('[aria-valuenow]')).not.toBeNull()
+			}
+			// The release leaves the width to the markup, so each bar carries a column class and no
+			// specimen writes an inline style.
+			expect(region.querySelector('[style]')).toBeNull()
+			expect(region.querySelectorAll('.progress-bar[class*="col-"]').length).toBeGreaterThan(0)
+			expect(Object.isFrozen(PROGRESS_COPY)).toBe(true)
+			expect(Object.isFrozen(PROGRESS_SPECIMENS)).toBe(true)
+			expect(PROGRESS_SPECIMENS.every((entry) => Object.isFrozen(entry))).toBe(true)
+		} finally {
