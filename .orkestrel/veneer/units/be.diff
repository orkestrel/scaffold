+		},
+	)
+
+	// The mutation this catches is a radius written outside the token chain: a literal would hold
+	// its pixels while the factor moved.
+	it('rescales the track corners with the radius factor', () => {
+		const host = scene.mount(`<div>${PROGRESS_MARKUP}</div>`)
+		const track = requireValue(host.querySelector('.progress'), 'No track')
