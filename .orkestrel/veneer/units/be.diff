+			expect(readStyle(spinner, 'animation-name')).toBe(animation)
+			await stageMedia({ motion: false })
+			expect(spinner.getAnimations()).toHaveLength(1)
+			const slowed = requireValue(spinner.getAnimations().at(0), 'No slowed animation')
+			expect(slowed.playState).toBe('running')
+			expect(slowed.effect?.getTiming().duration).toBe(1500)
+			expect(readStyle(spinner, 'animation-name')).toBe(animation)
+			await releaseMedia()
+			expect(
+				requireValue(spinner.getAnimations().at(0), 'No released animation').effect?.getTiming()
+					.duration,
+			).toBe(750)
+		},
+	)
+
+	// The mutation this catches is a keyframe rewritten to a flipped or partial turn: the steps are
+	// read from the cascade's own keyframes rather than from a resolved transform, which Chrome
+	// serializes as a matrix that reports the same string for several rotations.
+	it('turns the ring a whole circle and grows the disc from nothing', () => {
+		const ring = requireValue(findKeyframes('spinner-border'), 'No ring keyframes')
+		expect(
+			[...ring.cssRules].flatMap((rule) =>
+				rule instanceof CSSKeyframeRule ? [[rule.keyText, rule.style.transform]] : [],
+			),
+		).toEqual([['100%', 'rotate(360deg)']])
+		const grow = requireValue(findKeyframes('spinner-grow'), 'No grow keyframes')
+		expect(
+			[...grow.cssRules].flatMap((rule) =>
+				rule instanceof CSSKeyframeRule
+					? [[rule.keyText, rule.style.transform, rule.style.opacity]]
+					: [],
+			),
+		).toEqual([
+			['0%', 'scale(0)', ''],
+			['50%', 'none', '1'],
+		])
+	})
+
+	// The mutation this catches is a spinner painted from a mode token: the ring reads the text
+	// around it, so the two modes differ only where the text they inherit differs.
+	it('takes its paint from the text of whichever mode it renders in', () => {
+		const paints = TEXT_MODES.map((mode) => {
+			// The spinner paints the current color, and a nested mode scope retunes the tokens
+			// rather than the inherited color, so the host reads the body text token the mode
+			// moves. That is the path a consumer's own text takes to the ring.
+			const host = scene.mount(
+				`<div data-bs-theme="${mode}" style="color:var(--vn-text-body-base)"><div class="spinner-border" role="status" aria-label="Loading"></div><div class="spinner-grow" role="status" aria-label="Loading"></div></div>`,
+			)
