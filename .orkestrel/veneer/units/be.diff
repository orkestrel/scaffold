+	it('renders a track, a striped bar, a running bar, and a stacked track through the shared section contract', () => {
+		const host = mount(build('div'))
+		const section: SectionInterface = new ProgressSection(host)
+		try {
+			expect(section).toBeInstanceOf(SpecimenSection)
+			expect(section.host).toBe(host)
