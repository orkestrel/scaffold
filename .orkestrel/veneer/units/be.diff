+	})
+
+	// The mutation this catches is a transition written outside the mixin: the resting reading and
+	// the staged reading are taken on one element, so a declaration that kept its duration under the
+	// preference reports here.
+	it('transitions the bar width and collapses that transition under the reduced-motion preference', async () => {
+		const host = scene.mount(`<div>${PROGRESS_MARKUP}</div>`)
