+		const rules = collectLayer('components').flatMap((entry) =>
+			entry instanceof CSSStyleRule && entry.selectorText === '.spinner-grow' ? [entry] : [],
+		)
+		expect(requireValue(rules.at(0), 'No grow rule').style.getPropertyValue('opacity')).toBe('0')
+	})
+
