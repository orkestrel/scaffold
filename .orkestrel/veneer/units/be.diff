+		const host = scene.mount(
+			'<div><div class="spinner-grow" role="status" aria-label="Loading"></div></div>',
+		)
+		const spinner = requireValue(host.querySelector('.spinner-grow'), 'No spinner')
+		expect(readPixels(spinner, 'border-top-width')).toBe(0)
+		host.style.setProperty('color', 'rgb(10, 20, 30)')
