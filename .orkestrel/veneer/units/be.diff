new file mode 100644
index 0000000..7085825
--- /dev/null
+++ b/app/browser/sections/PlaceholderSection.ts
@@ -0,0 +1,20 @@
+import { PLACEHOLDER_COPY, PLACEHOLDER_SPECIMENS } from '../constants.js'
+import { SpecimenSection } from './SpecimenSection.js'
+
+/**
+ * Renders the declared placeholder specimens into a named region.
+ * @example
+ * ```ts
+ * const section = new PlaceholderSection(document.body)
+ * section.destroy()
+ * ```
+ */
+export class PlaceholderSection extends SpecimenSection {
+	/**
+	 * Mounts the Placeholder region and its specimens.
+	 * @param host - The element receiving the section.
+	 */
+	constructor(host: HTMLElement) {
+		super(host, PLACEHOLDER_COPY, PLACEHOLDER_SPECIMENS)
+	}
+}
