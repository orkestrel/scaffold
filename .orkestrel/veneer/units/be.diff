@@ -0,0 +1,83 @@
+import type { SectionInterface } from '@app/browser'
+import {
+	PLACEHOLDER_COPY,
+	PLACEHOLDER_SPECIMENS,
+	PlaceholderSection,
+	SpecimenSection,
+} from '@app/browser'
+import { requireValue } from '@orkestrel/test'
+import { build, mount } from '@orkestrel/test/browser'
+import { describe, expect, it } from 'vitest'
+
+describe('PlaceholderSection', () => {
+	it('renders the height ramp, the glow, the wave, and a button placeholder through the shared section contract', () => {
+		const host = mount(build('div'))
+		const section: SectionInterface = new PlaceholderSection(host)
+		try {
+			expect(section).toBeInstanceOf(SpecimenSection)
+			expect(section.host).toBe(host)
+			const region = requireValue(host.querySelector('section'), 'No Placeholder region')
+			expect(region.getAttribute('aria-label')).toBe('Placeholder')
+			expect(region.querySelector('p')?.textContent).toBe(PLACEHOLDER_COPY.paragraph)
+			const rendered = [...region.querySelectorAll('[data-specimen]')]
+			expect(rendered.map((element) => element.getAttribute('data-specimen'))).toEqual([
+				'Placeholder ramp',
+				'Glowing placeholder',
+				'Waving placeholder',
+				'Button placeholder',
+			])
+			expect(rendered.map((element) => element.innerHTML)).toEqual(
+				PLACEHOLDER_SPECIMENS.map(({ markup }) => markup),
+			)
+			// Every class this key ships reaches the region, which is what makes the specimens the
+			// rendered half of the vocabulary rather than a sample of it.
+			for (const name of [
+				'placeholder',
+				'placeholder-xs',
+				'placeholder-sm',
+				'placeholder-lg',
+				'placeholder-glow',
+				'placeholder-wave',
+			])
+				expect(region.querySelector(`.${name}`)).not.toBeNull()
+			// The button specimen is what the empty box rule selects, and it announces itself as a
+			// disabled control rather than as an unlabelled link.
+			const control = requireValue(
+				region.querySelector('a.btn.placeholder'),
+				'No button placeholder',
+			)
+			expect(control.classList.contains('disabled')).toBe(true)
+			// The specimen carries no label, so it is hidden from assistive technology and kept out
+			// of the tab order: an unnamed control announced to a reader would be the defect.
+			expect(control.getAttribute('aria-hidden')).toBe('true')
+			expect(control.getAttribute('tabindex')).toBe('-1')
+			expect(control.hasAttribute('href')).toBe(false)
+			// Each placeholder takes its width from the grid, so no specimen writes an inline style.
+			expect(region.querySelector('[style]')).toBeNull()
+			expect(region.querySelectorAll('.placeholder[class*="col-"]').length).toBeGreaterThan(0)
+			expect(Object.isFrozen(PLACEHOLDER_COPY)).toBe(true)
+			expect(Object.isFrozen(PLACEHOLDER_SPECIMENS)).toBe(true)
+			expect(PLACEHOLDER_SPECIMENS.every((entry) => Object.isFrozen(entry))).toBe(true)
+		} finally {
+			section.destroy()
+			host.remove()
+		}
+	})
+	it('releases the region and preserves adjacent content on repeated destruction', () => {
+		const host = mount(build('div'))
+		const neighbor = build('p', { text: 'Existing content' })
+		host.append(neighbor)
+		const section: SectionInterface = new PlaceholderSection(host)
+		try {
+			const region = requireValue(host.querySelector('section'), 'No Placeholder region')
+			expect(region.isConnected).toBe(true)
+			section.destroy()
+			expect(region.isConnected).toBe(false)
+			section.destroy()
+			expect([...host.children]).toEqual([neighbor])
+		} finally {
+			section.destroy()
+			host.remove()
+		}
+	})
+})
