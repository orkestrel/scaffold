+	it.each(SPINNER_SIZE_CASES)(
+		'keeps $name turning under the reduced-motion preference and halves its speed',
+		async ({ classes, animation }) => {
+			const host = scene.mount(
+				`<div><div class="${classes}" role="status" aria-label="Loading"></div></div>`,
+			)
