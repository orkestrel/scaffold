+				rule instanceof CSSStyleRule
+					? splitTopLevelList(rule.selectorText).map((part) =>
+							normalizeComplexSelector(trimCSSWhitespace(part)),
+						)
+					: [],
+			),
+		)
+		expect(PLACEHOLDER_SELECTORS.filter((selector) => !written.has(selector))).toEqual([])
+		expect(written.has('.placeholder-xl')).toBe(false)
+	})
+
+	// The mutation each row catches is a height floor written outside its own `em` factor: the host
+	// carries a 40-pixel font, so each recorded factor lands on a whole pixel and a floor written as
+	// a length reports the wrong box here.
+	it.each(PLACEHOLDER_SIZE_CASES)(
+		'floors $name at its own share of the font',
+		({ classes, floor }) => {
+			const host = scene.mount(`<p style="font-size:40px"><span class="${classes}"></span></p>`)
+			const element = requireValue(host.querySelector('.placeholder'), 'No placeholder')
+			expect(readPixels(element, 'font-size')).toBe(40)
+			expect(readPixels(element, 'min-height')).toBe(floor * 40)
+			expect(readStyle(element, 'display')).toBe('inline-block')
+			expect(readStyle(element, 'vertical-align')).toBe('middle')
+			expect(readStyle(element, 'cursor')).toBe('wait')
+			expect(readStyle(element, 'opacity')).toBe('0.5')
+			// The fill is the current color, which is what makes a placeholder stand in for the text it
+			// replaces rather than paint a color of its own.
+			expect(
+				matchesColor(readStyle(element, 'background-color'), readStyle(element, 'color')),
+			).toBe(true)
+			host.style.setProperty('color', 'rgb(10, 20, 30)')
+			expect(readStyle(element, 'background-color')).toBe('rgb(10, 20, 30)')
+		},
+	)
