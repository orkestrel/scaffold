+import type { SectionInterface } from '@app/browser'
+import { SPINNER_COPY, SPINNER_SPECIMENS, SpinnerSection, SpecimenSection } from '@app/browser'
+import { requireValue } from '@orkestrel/test'
+import { build, mount, readName } from '@orkestrel/test/browser'
+import { describe, expect, it } from 'vitest'
+
+describe('SpinnerSection', () => {
+	it('renders each spinner and its small twin through the shared section contract', () => {
+		const host = mount(build('div'))
+		const section: SectionInterface = new SpinnerSection(host)
+		try {
+			expect(section).toBeInstanceOf(SpecimenSection)
+			expect(section.host).toBe(host)
+			const region = requireValue(host.querySelector('section'), 'No Spinner region')
+			expect(region.getAttribute('aria-label')).toBe('Spinner')
+			expect(region.querySelector('p')?.textContent).toBe(SPINNER_COPY.paragraph)
+			const rendered = [...region.querySelectorAll('[data-specimen]')]
+			expect(rendered.map((element) => element.getAttribute('data-specimen'))).toEqual([
+				'Border spinner',
+				'Small border spinner',
+				'Grow spinner',
+				'Small grow spinner',
+			])
+			expect(rendered.map((element) => element.innerHTML)).toEqual(
+				SPINNER_SPECIMENS.map(({ markup }) => markup),
+			)
+			// Every class this key ships reaches the region, which is what makes the specimens the
+			// rendered half of the vocabulary rather than a sample of it.
+			for (const name of ['spinner-border', 'spinner-border-sm', 'spinner-grow', 'spinner-grow-sm'])
+				expect(region.querySelector(`.${name}`)).not.toBeNull()
+			// A spinner carries no text, so each one announces its own status: a specimen with no
+			// accessible name would render as an unlabelled box.
+			for (const element of rendered) {
+				const spinner = requireValue(element.firstElementChild, 'No spinner in the specimen')
+				expect(spinner.getAttribute('role')).toBe('status')
+				expect(readName(spinner)).not.toBe('')
+			}
+			expect(region.querySelector('[style]')).toBeNull()
+			expect(Object.isFrozen(SPINNER_COPY)).toBe(true)
+			expect(Object.isFrozen(SPINNER_SPECIMENS)).toBe(true)
+			expect(SPINNER_SPECIMENS.every((entry) => Object.isFrozen(entry))).toBe(true)
+		} finally {
+			section.destroy()
+			host.remove()
+		}
+	})
+	it('releases the region and preserves adjacent content on repeated destruction', () => {
+		const host = mount(build('div'))
+		const neighbor = build('p', { text: 'Existing content' })
+		host.append(neighbor)
+		const section: SectionInterface = new SpinnerSection(host)
+		try {
+			const region = requireValue(host.querySelector('section'), 'No Spinner region')
+			expect(region.isConnected).toBe(true)
+			section.destroy()
+			expect(region.isConnected).toBe(false)
+			section.destroy()
+			expect([...host.children]).toEqual([neighbor])
+		} finally {
+			section.destroy()
+			host.remove()
+		}
+	})
+})
