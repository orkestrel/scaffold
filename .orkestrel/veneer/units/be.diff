+	it('releases the overflow inside each stacked segment and fills its bar', () => {
+		const host = scene.mount(`<div>${PROGRESS_MARKUP}</div>`)
+		const stacked = requireValue(host.querySelector('.progress-stacked'), 'No stacked track')
