+	// answers no as well as yes.
+	it('writes every recorded selector into the components layer and no name beyond them', () => {
+		const written = new Set(
+			collectLayer('components').flatMap((rule) =>
+				rule instanceof CSSStyleRule
+					? splitTopLevelList(rule.selectorText).map((part) =>
+							normalizeComplexSelector(trimCSSWhitespace(part)),
+						)
+					: [],
+			),
+		)
+		expect(SPINNER_SELECTORS.filter((selector) => !written.has(selector))).toEqual([])
+		expect(written.has('.spinner-ring')).toBe(false)
+	})
+
+	// The mutation each row catches is a box or an edge written outside its own variable: the box is
+	// read in pixels against the release's own `rem` value, and the edge against the spinner's own
+	// font, so a size written as a literal that happens to match still moves when the row's variable
+	// is retuned in the row that follows.
+	it.each(SPINNER_SIZE_CASES)(
+		'sizes $name to its own box, edge, and animation',
+		({ classes, box, edge, animation }) => {
+			// The host carries a 40-pixel font, so every `em` the release writes lands on a whole
+			// pixel: a browser rounds a border width to a device pixel, and a fractional product
+			// would pin the rounding rather than the declaration.
+			const host = scene.mount(
+				`<div style="font-size:40px"><div class="${classes}" role="status" aria-label="Loading"></div></div>`,
+			)
+			const spinner = requireValue(
+				host.querySelector(`.${classes.split(' ').at(-1) ?? ''}`),
