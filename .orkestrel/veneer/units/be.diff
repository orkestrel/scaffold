+			expect(readStyle(spinner, 'display')).toBe('inline-block')
+			expect(readStyle(spinner, 'flex-shrink')).toBe('0')
+			expect(readPixels(spinner, 'width')).toBe(box)
+			expect(readPixels(spinner, 'height')).toBe(box)
+			// The corner is a percentage of the box rather than a length, which is what keeps a
+			// resized spinner round.
+			expect(readStyle(spinner, 'border-top-left-radius')).toBe('50%')
+			expect(readPixels(spinner, 'border-top-width')).toBe(edge * 40)
+			expect(readStyle(spinner, 'animation-name')).toBe(animation)
+			expect(readStyle(spinner, 'animation-iteration-count')).toBe('infinite')
+			expect(readStyle(spinner, 'animation-timing-function')).toBe('linear')
