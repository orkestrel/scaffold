+			// beside a word from shifting that word's line.
+			expect(readPixels(spinner, 'vertical-align')).toBe(-5)
+		},
+	)
+
+	// The mutation each row catches is a property that stopped reading its variable: the override is
+	// a value no rule of this cascade writes, so a property reading something else reports the
+	// resting value instead.
+	it.each(SPINNER_VARIABLE_CASES)(
+		'reads $name on the border spinner and moves what that variable drives',
+		({ name, drives, override, resolved }) => {
+			const host = scene.mount(
+				'<div><div class="spinner-border" role="status" aria-label="Loading"></div></div>',
+			)
+			const spinner = requireValue(host.querySelector('.spinner-border'), 'No spinner')
+			if (!(spinner instanceof HTMLElement)) throw new Error('The spinner is not an element')
+			expect(readToken(spinner, name)).not.toBe('')
+			expect(readStyle(spinner, drives)).not.toBe(resolved)
+			// An ancestor override is shadowed by the spinner's own declaration, which is what makes
+			// the spinner the element a consumer retunes.
