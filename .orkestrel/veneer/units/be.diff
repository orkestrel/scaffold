+		const first = requireValue(paints.at(0), 'No light reading')
+		const second = requireValue(paints.at(1), 'No dark reading')
+		expect(matchesColor(first.ring, first.text)).toBe(true)
+		expect(matchesColor(second.ring, second.text)).toBe(true)
+		expect(matchesColor(second.disc, second.text)).toBe(true)
+		expect(matchesColor(first.text, second.text)).toBe(false)
+		expect(matchesColor(first.ring, second.ring)).toBe(false)
+	})
+
+	// The reduced-motion rules are the only conditions this family writes, so a query the partial
+	// gained reports here whatever selector carries it.
+	it('gates nothing on a width boundary', () => {
+		// The release writes the two spinners as one selector list under the query, so the reading
