+	// The mutation each row catches is a property that stopped reading its variable: the override is
+	// a value no rule of this cascade writes, so a property reading something else reports the
+	// resting value instead.
+	it.each(PROGRESS_VARIABLE_CASES)(
+		'reads $name on $selector and moves what that variable drives',
