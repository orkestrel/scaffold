+	// transparent through both readings.
+	it('paints the ring from the text around it and leaves its right edge open', () => {
+		const host = scene.mount(
+			'<div style="font-size:40px"><div class="spinner-border" role="status" aria-label="Loading"></div></div>',
+		)
+		const spinner = requireValue(host.querySelector('.spinner-border'), 'No spinner')
+		const resting = readStyle(spinner, 'color')
