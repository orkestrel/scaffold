+			expect(readPixels(spinner, `border-${side}-width`)).toBe(10)
+		for (const side of ['top', 'bottom', 'left'])
+			expect(matchesColor(readStyle(spinner, `border-${side}-color`), resting)).toBe(true)
+		expect(matchesColor(readStyle(spinner, 'border-right-color'), 'rgba(0, 0, 0, 0)')).toBe(true)
+		host.style.setProperty('color', 'rgb(10, 20, 30)')
+		expect(readStyle(spinner, 'border-top-color')).toBe('rgb(10, 20, 30)')
+		expect(matchesColor(readStyle(spinner, 'border-right-color'), 'rgba(0, 0, 0, 0)')).toBe(true)
+	})
+
