+/**
+ * Mounts a focused control the keyboard traversal starts from, ahead of every node mounted after it.
+ *
+ * @returns The mounted `Start` button, holding focus, inside a container {@link scene} removes for you.
+ *
+ * @remarks
+ * The installed `traverseAccessible` export sends Tab from the element holding focus, and from a
+ * page where nothing holds focus its first Tab reaches no element. A case that walks to a fixture's
+ * first focusable element mounts this control before the fixture, so that first Tab lands on the
+ * fixture.
+ *
+ * @example
+ * ```ts
+ * mountTraversalStart()
+ * await traverseAccessible('Skip to main content')
+ * ```
+ */
+export function mountTraversalStart(): HTMLButtonElement {
+	const host = scene.mount('<button type="button">Start</button>')
+	const control = requireValue(
+		host.querySelector<HTMLButtonElement>('button'),
+		'The mounted host renders no start control',
+	)
+	control.focus()
+	return control
+}
