+++ b/app/browser/sections/FormLabelSection.ts
@@ -0,0 +1,20 @@
+import { FORM_LABEL_COPY, FORM_LABEL_SPECIMENS } from '../constants.js'
+import { SpecimenSection } from './SpecimenSection.js'
+
+/**
+ * Renders the declared label and help-text specimens into a named region.
+ * @example
+ * ```ts
+ * const section = new FormLabelSection(document.body)
+ * section.destroy()
+ * ```
+ */
+export class FormLabelSection extends SpecimenSection {
+	/**
+	 * Mounts the Form label region and its specimens.
+	 * @param host - The element receiving the section.
+	 */
+	constructor(host: HTMLElement) {
+		super(host, FORM_LABEL_COPY, FORM_LABEL_SPECIMENS)
+	}
+}
