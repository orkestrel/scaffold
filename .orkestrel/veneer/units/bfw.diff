+/** Holds the Form label section's visible copy and accessible name. */
+export const FORM_LABEL_COPY = Object.freeze({
+	region: 'Form label',
+	paragraph:
+		'Compare a label and its help text around a control, and a horizontal label level with the control beside it at each size and over a group.',
+})
+
+/**
+ * Lists the label specimens the section renders, in render order.
+ *
+ * @remarks
+ * Each label names its control through `for`, so every control announces the label's text as its
+ * name, and each `id` is unique to the showcase so a label names one control. The stacked control
+ * names its help text through `aria-describedby`, which is the pairing the help text exists to
+ * hold.
+ *
+ * The horizontal rows use breakpoint-free columns, so the label sits beside its control at every
+ * width the portfolio shoots, and the split gives the label five columns so the large label reads on
+ * one line at the 390-wide variants. Each row sits in a fluid container, which absorbs the row's
+ * negative gutter so the row stays inside the page. The large and small rows are one ramp, so their
+ * markup is derived from the size list rather than written twice.
+ *
+ * A legend names the group it leads rather than the control inside it, so the date control in the
+ * legend row carries a name of its own. The date control carries a fixed value, so its frame shows
+ * the same filled date fields on every run.
+ */
+export const FORM_LABEL_SPECIMENS: readonly MarkupSpecimen[] = Object.freeze([
+	Object.freeze({
+		name: 'Form label stacked',
+		markup:
+			'<label class="form-label" for="form-label-email">Dispatch email</label><input class="form-control" type="email" id="form-label-email" value="notices@example.com" aria-describedby="form-label-email-help"><div class="form-text" id="form-label-email-help">Northworks sends every shipping notice to this address.</div>',
+	}),
+	Object.freeze({
+		name: 'Form label horizontal',
+		markup:
+			'<div class="container-fluid"><div class="row"><label class="col-5 col-form-label" for="form-label-depot">Depot</label><div class="col-7"><input class="form-control" type="text" id="form-label-depot" value="Harbor Street"></div></div></div>',
+	}),
+	...[
+		{ name: 'Form label horizontal large', size: 'lg', label: 'Large' },
+		{ name: 'Form label horizontal small', size: 'sm', label: 'Small' },
+	].map(({ name, size, label }) =>
+		Object.freeze({
+			name,
+			markup: `<div class="container-fluid"><div class="row"><label class="col-5 col-form-label col-form-label-${size}" for="form-label-depot-${size}">${label} depot</label><div class="col-7"><input class="form-control form-control-${size}" type="text" id="form-label-depot-${size}" value="Harbor Street"></div></div></div>`,
+		}),
+	),
+	Object.freeze({
+		name: 'Form label legend',
+		markup:
+			'<div class="container-fluid"><fieldset class="row"><legend class="col-5 col-form-label">Pickup</legend><div class="col-7"><input class="form-control" type="date" aria-label="Pickup date" value="2026-09-23"></div></fieldset></div>',
+	}),
+])
