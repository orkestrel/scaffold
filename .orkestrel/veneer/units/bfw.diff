diff --git a/tests/app/browser/sections/FormLabelSection.test.ts b/tests/app/browser/sections/FormLabelSection.test.ts
new file mode 100644
index 0000000..95c195e
--- /dev/null
+++ b/tests/app/browser/sections/FormLabelSection.test.ts
@@ -0,0 +1,157 @@
+import type { SectionInterface } from '@app/browser'
+import {
+	FORM_LABEL_COPY,
+	FORM_LABEL_SPECIMENS,
+	FormLabelSection,
+	SpecimenSection,
+} from '@app/browser'
+import { requireValue } from '@orkestrel/test'
+import { build, mount, readName, readStates } from '@orkestrel/test/browser'
+import { describe, expect, it } from 'vitest'
+
+describe('FormLabelSection', () => {
+	it('renders every label beside or above the control it names, and the help text the stacked control announces', () => {
+		const host = mount(build('div'))
+		const section: SectionInterface = new FormLabelSection(host)
+		try {
+			expect(section).toBeInstanceOf(SpecimenSection)
+			expect(section.host).toBe(host)
+			const region = requireValue(host.querySelector('section'), 'No Form label region')
+			expect(region.querySelector('[style]')).toBeNull()
+			expect(region.getAttribute('aria-label')).toBe('Form label')
+			expect(region.querySelector('p')?.textContent).toBe(FORM_LABEL_COPY.paragraph)
+			const rendered = [...region.querySelectorAll('[data-specimen]')]
+			expect(rendered.map((element) => element.getAttribute('data-specimen'))).toEqual([
+				'Form label stacked',
+				'Form label horizontal',
+				'Form label horizontal large',
+				'Form label horizontal small',
+				'Form label legend',
+			])
+			expect(rendered.map((element) => element.innerHTML)).toEqual(
+				FORM_LABEL_SPECIMENS.map(({ markup }) => markup),
+			)
+			const controls = rendered.map((element) =>
+				requireValue(element.querySelector('input'), 'No labelled control'),
+			)
+			// Each label is tied to its control by `for`, so the control announces the label's own
+			// text, and no two controls share a name the journey could resolve to either of.
+			const labels = rendered
+				.slice(0, 4)
+				.map((element) => requireValue(element.querySelector('label'), 'No label'))
+			expect(controls.slice(0, 4).map((control) => readName(control))).toEqual(
+				labels.map((label) => label.textContent),
+			)
+			expect(labels.map((label) => label.control)).toEqual(controls.slice(0, 4))
+			expect(controls.map((control) => readName(control))).toEqual([
+				'Dispatch email',
+				'Depot',
+				'Large depot',
+				'Small depot',
+				'Pickup date',
+			])
+			// Every id carries the section's prefix, which no other specimen uses; the legend row's
+			// control is named by its own attribute and carries none.
+			expect(controls.map((control) => control.id)).toEqual([
+				'form-label-email',
+				'form-label-depot',
+				'form-label-depot-lg',
+				'form-label-depot-sm',
+				'',
+			])
+			// The stacked label sits above its control and the help text after it, and the control
+			// names that help text as its description.
+			const stacked = requireValue(rendered[0], 'No stacked specimen')
+			const email = requireValue(controls[0], 'No stacked control')
+			expect([...stacked.children].map((child) => child.className)).toEqual([
+				'form-label',
+				'form-control',
+				'form-text',
+			])
+			const help = requireValue(stacked.querySelector('.form-text'), 'No help text')
+			const described = requireValue(
+				email.getAttribute('aria-describedby'),
+				'The stacked control names no description',
+			)
+			expect(region.querySelector(`#${CSS.escape(described)}`)).toBe(help)
+			expect(help.textContent).toBe('Northworks sends every shipping notice to this address.')
+			expect(controls.map((control) => readStates(control))).toEqual([
+				['described'],
+				[],
+				[],
+				[],
+				[],
+			])
+			// Each horizontal row holds the label in one column and the control in the next, and every
+			// column is breakpoint-free so the pair sits side by side at every variant width.
+			const rows = rendered
+				.slice(1)
+				.map((element) => requireValue(element.querySelector('.row'), 'No horizontal row'))
+			expect(rows.map((row) => row.tagName.toLowerCase())).toEqual([
+				'div',
+				'div',
+				'div',
+				'fieldset',
+			])
+			expect(
+				rows.map((row) => [...row.children].map((child) => child.tagName.toLowerCase())),
+			).toEqual([
+				['label', 'div'],
+				['label', 'div'],
+				['label', 'div'],
+				['legend', 'div'],
+			])
+			expect(rows.flatMap((row) => [...row.children].map((child) => child.className))).toEqual([
+				'col-5 col-form-label',
+				'col-7',
+				'col-5 col-form-label col-form-label-lg',
+				'col-7',
+				'col-5 col-form-label col-form-label-sm',
+				'col-7',
+				'col-5 col-form-label',
+				'col-7',
+			])
+			expect(controls.slice(1).map((control) => control.className)).toEqual([
+				'form-control',
+				'form-control form-control-lg',
+				'form-control form-control-sm',
+				'form-control',
+			])
+			expect(rows.map((row) => row.querySelector('input'))).toEqual(controls.slice(1))
+			// The legend names the group rather than the control inside it: a fieldset takes its name
+			// from the legend that is its first child, and that legend is no control's label, so the
+			// date control carries a name of its own.
+			const group = requireValue(rows[3], 'No legend row')
+			const date = requireValue(controls[4], 'No legend control')
+			expect(group.firstElementChild?.tagName.toLowerCase()).toBe('legend')
+			expect(group.firstElementChild?.textContent).toBe('Pickup')
+			expect(date.labels).toHaveLength(0)
+			expect(date.type).toBe('date')
+			expect(date.getAttribute('aria-label')).toBe('Pickup date')
+			expect(Object.isFrozen(FORM_LABEL_COPY)).toBe(true)
+			expect(Object.isFrozen(FORM_LABEL_SPECIMENS)).toBe(true)
+			expect(FORM_LABEL_SPECIMENS.every((entry) => Object.isFrozen(entry))).toBe(true)
+		} finally {
+			section.destroy()
+			host.remove()
+		}
+	})
+
+	it('releases the region and preserves adjacent content on repeated destruction', () => {
+		const host = mount(build('div'))
+		const neighbor = build('p', { text: 'Existing content' })
+		host.append(neighbor)
+		const section: SectionInterface = new FormLabelSection(host)
+		try {
+			const region = requireValue(host.querySelector('section'), 'No Form label region')
+			expect(region.isConnected).toBe(true)
+			section.destroy()
+			expect(region.isConnected).toBe(false)
+			section.destroy()
+			expect([...host.children]).toEqual([neighbor])
+		} finally {
+			section.destroy()
+			host.remove()
+		}
+	})
+})
