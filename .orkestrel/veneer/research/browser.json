{
  "measurements": {
    "spacing": {
      "initial": {
        "property": "1rem",
        "padding": "16px",
        "rectangle": {
          "x": 8,
          "y": 8,
          "width": 1264,
          "height": 52
        },
        "rules": [
          ":root { --sample-space: 1rem; }",
          "html { font-size: 16px; }",
          ".sample { box-sizing: border-box; padding: var(--sample-space); border: 1px solid black; }",
          "#cover { background: transparent; display: none; inset: 0px; position: fixed; }",
          "#cover[data-open=\"true\"] { display: block; }"
        ]
      },
      "valid": {
        "property": "2rem",
        "padding": "32px",
        "rectangle": {
          "x": 8,
          "y": 8,
          "width": 1264,
          "height": 84
        },
        "rules": [
          ":root { --sample-space: 1rem; }",
          "html { font-size: 16px; }",
          ".sample { box-sizing: border-box; padding: var(--sample-space); border: 1px solid black; }",
          "#cover { background: transparent; display: none; inset: 0px; position: fixed; }",
          "#cover[data-open=\"true\"] { display: block; }"
        ]
      },
      "invalid": {
        "property": "not-a-length",
        "padding": "0px",
        "rectangle": {
          "x": 8,
          "y": 8,
          "width": 1264,
          "height": 20
        },
        "rules": [
          ":root { --sample-space: 1rem; }",
          "html { font-size: 16px; }",
          ".sample { box-sizing: border-box; padding: var(--sample-space); border: 1px solid black; }",
          "#cover { background: transparent; display: none; inset: 0px; position: fixed; }",
          "#cover[data-open=\"true\"] { display: block; }"
        ]
      }
    },
    "activation": {
      "before": {
        "display": "inline-block",
        "visibility": "visible",
        "opacity": "1",
        "rectangle": {
          "x": 255.5,
          "y": 28,
          "width": 110.09375,
          "height": 21
        },
        "hit": {
          "id": "activate",
          "tag": "BUTTON"
        }
      },
      "status": {
        "before": "Ready",
        "covered": "Ready",
        "after": "Activated"
      },
      "covered": {
        "display": "inline-block",
        "visibility": "visible",
        "opacity": "1",
        "rectangle": {
          "x": 255.5,
          "y": 28,
          "width": 110.09375,
          "height": 21
        },
        "hit": {
          "id": "cover",
          "tag": "DIV"
        }
      },
      "refused": true,
      "uncovered": {
        "display": "inline-block",
        "visibility": "visible",
        "opacity": "1",
        "rectangle": {
          "x": 255.5,
          "y": 28,
          "width": 110.09375,
          "height": 21
        },
        "hit": {
          "id": "activate",
          "tag": "BUTTON"
        }
      }
    }
  },
  "assertions": [
    {
      "name": "valid padding begins at 16px",
      "actual": "16px",
      "expected": "16px",
      "passed": true
    },
    {
      "name": "valid padding changes to 32px",
      "actual": "32px",
      "expected": "32px",
      "passed": true
    },
    {
      "name": "stylesheet rule text stays unchanged after valid click",
      "actual": [
        ":root { --sample-space: 1rem; }",
        "html { font-size: 16px; }",
        ".sample { box-sizing: border-box; padding: var(--sample-space); border: 1px solid black; }",
        "#cover { background: transparent; display: none; inset: 0px; position: fixed; }",
        "#cover[data-open=\"true\"] { display: block; }"
      ],
      "expected": [
        ":root { --sample-space: 1rem; }",
        "html { font-size: 16px; }",
        ".sample { box-sizing: border-box; padding: var(--sample-space); border: 1px solid black; }",
        "#cover { background: transparent; display: none; inset: 0px; position: fixed; }",
        "#cover[data-open=\"true\"] { display: block; }"
      ],
      "passed": true
    },
    {
      "name": "invalid custom property remains nonempty",
      "actual": "not-a-length",
      "expected": "a nonempty string",
      "passed": true
    },
    {
      "name": "invalid consumer resolves to padding initial value",
      "actual": "0px",
      "expected": "0px",
      "passed": true
    },
    {
      "name": "invalid consumer no longer matches valid spacing",
      "actual": "0px",
      "expected": "32px",
      "passed": true
    },
    {
      "name": "covered role click refuses with timeout",
      "actual": true,
      "expected": true,
      "passed": true
    },
    {
      "name": "covered action leaves status ready",
      "actual": "Ready",
      "expected": "Ready",
      "passed": true
    },
    {
      "name": "cover intercepts the action hit target",
      "actual": "cover",
      "expected": "cover",
      "passed": true
    },
    {
      "name": "uncovered role click activates the sample",
      "actual": "Activated",
      "expected": "Activated",
      "passed": true
    }
  ]
}
