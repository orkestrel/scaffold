+import { createRecorder } from '@orkestrel/test'
+import { DRAG_EVENTS, Drag, createDrag, createDragPlugin, Registry } from '@src/browser'
+import { expect, it } from 'vitest'
+
+it('settles one configured lifetime and removes only its owned output on destruction', () => {
+	const host = document.createElement('div')
+	host.innerHTML = '<div draggable="true" tabindex="0">First</div><output>Authored</output>'
+	const automatic = createDragPlugin().create(host, new Registry(document))
+	const first = createRecorder<readonly [Event]>()
+	const second = createRecorder<readonly [Event]>()
+	const configured = createDrag(host, { on: { start: first.handler } })
+	try {
+		expect(automatic.destroyed).toBe(true)
+		expect(configured).toBeInstanceOf(Drag)
+		expect(createDrag(host)).toBe(configured)
+		expect(createDrag(host, { on: { start: second.handler } })).toBe(configured)
+		expect(host.querySelectorAll('output')).toHaveLength(2)
+		host.dispatchEvent(new Event(DRAG_EVENTS.start))
+		expect(first.count).toBe(1)
+		expect(second.count).toBe(0)
+	} finally {
+		configured.destroy()
+	}
+	configured.destroy()
+	expect(host.querySelectorAll('output')).toHaveLength(1)
+	expect(host.querySelector('[draggable]')?.getAttribute('draggable')).toBe('true')
+	expect(new Registry(document).component(createDragPlugin(), host)).toBeUndefined()
+	const replacement = createDrag(host)
+	expect(replacement).not.toBe(configured)
+	replacement.destroy()
+})
