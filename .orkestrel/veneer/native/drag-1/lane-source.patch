+++ b/src/browser/drags/Drag.ts
@@ -0,0 +1,286 @@
+import type { ComponentContext } from '../types.js'
+import type { DragInterface, DragOptions } from './types.js'
+import { bindEventMap, emitEvent } from '../helpers.js'
+import { DRAG_DEFAULTS, DRAG_EVENTS } from './constants.js'
+
+/** Owns a list's native drag session, cancelable moves, and position announcement. */
+export class Drag implements DragInterface {
+	#element: HTMLElement
+	#context: ComponentContext<Drag>
+	#lifetime = new AbortController()
+	#unbind: () => void
+	#output: HTMLOutputElement
+	#item: HTMLElement | undefined
+	#indicator: HTMLElement | undefined
+	#pressed: Element | undefined
+	#receiving = false
+
+	/**
+	 * Registers a list and appends its owned polite position output.
+	 * @param element - List whose direct children are sortable items.
+	 * @param context - Registry ownership for this component kind.
+	 * @param options - Initial lifecycle hooks.
+	 */
+	constructor(
+		element: HTMLElement,
+		context: ComponentContext<Drag>,
+		options: DragOptions = DRAG_DEFAULTS,
+	) {
+		this.#element = element
+		this.#context = context
+		context.own(this)
+		this.#unbind = bindEventMap(element, DRAG_EVENTS, options.on)
+		this.#output = element.ownerDocument.createElement('output')
+		this.#output.setAttribute('aria-live', 'polite')
+		this.#output.setAttribute('aria-atomic', 'true')
+		this.#output.setAttribute('aria-label', 'Sort status')
+		element.append(this.#output)
+	}
+
+	/** Returns the sortable-list host. */
+	get element(): HTMLElement {
+		return this.#element
+	}
+
+	/** Reports whether teardown ran. */
+	get destroyed(): boolean {
+		return this.#lifetime.signal.aborted
+	}
+
+	/**
+	 * Routes native input for a direct child of the list.
+	 * @param event - Pointer, drag, or keyboard input.
+	 * @param item - Direct child the router matched.
+	 */
+	receive(event: Event, item: HTMLElement): void {
+		if (
+			this.destroyed ||
+			this.#receiving ||
+			item.parentElement !== this.#element ||
+			item === this.#output
+		)
+			return
+		this.#receiving = true
+		try {
+			const realm = this.#element.ownerDocument.defaultView ?? window
+			if (event instanceof realm.PointerEvent && event.type === 'pointerdown') {
+				this.#pressed = event.target instanceof realm.Element ? event.target : undefined
+			} else if (event instanceof realm.KeyboardEvent) {
+				this.#keyboard(event, item)
+			} else if (event instanceof realm.DragEvent) {
+				if (event.type === 'dragstart') this.#start(event, item)
+				else if (event.type === 'dragend') this.end()
+				else if (this.#item?.parentElement === this.#element) {
+					if (event.type === 'dragleave') {
+						if (
+							!(event.relatedTarget instanceof realm.Node) ||
+							!this.#element.contains(event.relatedTarget)
+						)
+							this.#clearIndicator()
+					} else if (event.type === 'drop') {
+						event.preventDefault()
+						this.#finish(this.#move(item, event))
+					} else if (event.type === 'dragenter' || event.type === 'dragover') {
+						event.preventDefault()
+						if (event.dataTransfer) event.dataTransfer.dropEffect = 'move'
+						this.#indicate(item, event)
+					}
+				}
+			}
+		} finally {
+			this.#receiving = false
+		}
+	}
+
+	/** Ends an outstanding drag without moving its item. */
+	end(): void {
+		this.#pressed = undefined
+		this.#finish(false)
+	}
+
+	/** Releases hooks, the live output, drag state, and registry ownership. */
+	destroy(): void {
+		if (this.destroyed) return
+		this.#lifetime.abort()
+		this.end()
+		this.#output.remove()
+		this.#unbind()
+		this.#context.release(this)
+	}
+
+	#children(): readonly HTMLElement[] {
+		const realm = this.#element.ownerDocument.defaultView ?? window
+		return Array.from(this.#element.children).filter(
+			(child): child is HTMLElement => child instanceof realm.HTMLElement && child !== this.#output,
+		)
+	}
+
+	#axis(): { readonly horizontal: boolean; readonly reversed: boolean } {
+		const style = (this.#element.ownerDocument.defaultView ?? window).getComputedStyle(
+			this.#element,
+		)
+		const flex = style.display === 'flex' || style.display === 'inline-flex'
+		const row = flex && style.flexDirection.startsWith('row')
+		const vertical =
+			style.writingMode.startsWith('vertical') || style.writingMode.startsWith('sideways')
+		return {
+			horizontal: row !== vertical,
+			reversed:
+				(flex && style.flexDirection.endsWith('reverse')) !==
+				(row ? style.direction === 'rtl' : vertical && style.writingMode.endsWith('-rl')),
+		}
+	}
+
+	#start(event: DragEvent, item: HTMLElement): void {
+		this.#finish(false)
+		const realm = this.#element.ownerDocument.defaultView ?? window
+		const target =
+			this.#pressed ?? (event.target instanceof realm.Element ? event.target : undefined)
+		this.#pressed = undefined
+		const handle = target?.closest('[draggable="true"]')
+		const control = target?.closest(
+			'input, textarea, select, button, a[href], [contenteditable]:not([contenteditable="false"])',
+		)
+		if (
+			!handle ||
+			(handle !== item && !item.contains(handle)) ||
+			(handle === item && item.querySelector('[draggable="true"]')) ||
+			(control && control !== item && control !== handle)
+		) {
+			event.preventDefault()
+			return
+		}
+		if (
+			emitEvent(this.#element, DRAG_EVENTS.start, { item }).defaultPrevented ||
+			this.destroyed ||
+			item.parentElement !== this.#element
+		) {
+			event.preventDefault()
+			return
+		}
+		this.#item = item
+		if (event.dataTransfer) {
+			event.dataTransfer.effectAllowed = 'move'
+			event.dataTransfer.dropEffect = 'move'
+			const box = item.getBoundingClientRect()
+			event.dataTransfer.setDragImage(item, event.clientX - box.left, event.clientY - box.top)
+		}
+		item.setAttribute('data-vn-dragging', '')
+	}
+
+	#side(item: HTMLElement, event: DragEvent): 'before' | 'after' {
+		const { horizontal, reversed } = this.#axis()
+		const box = item.getBoundingClientRect()
+		const before = horizontal
+			? event.clientX < box.left + box.width / 2
+			: event.clientY < box.top + box.height / 2
+		return before !== reversed ? 'before' : 'after'
+	}
+
+	#indicate(item: HTMLElement, event: DragEvent): void {
+		if (item === this.#item) {
+			this.#clearIndicator()
+			return
+		}
+		const side = this.#side(item, event)
+		if (this.#indicator === item && item.getAttribute('data-vn-insert') === side) return
+		this.#clearIndicator()
+		this.#indicator = item
+		item.setAttribute('data-vn-insert', side)
+	}
+
+	#move(target: HTMLElement, event: DragEvent): boolean {
+		const item = this.#item
+		if (!item || item === target) return false
+		const remaining = this.#children().filter((child) => child !== item)
+		const index = remaining.indexOf(target)
+		return (
+			index !== -1 &&
+			this.#relocate(item, index + (this.#side(target, event) === 'after' ? 1 : 0), 'pointer')
+		)
+	}
+
+	#keyboard(event: KeyboardEvent, item: HTMLElement): void {
+		if (event.key === 'Escape') {
+			this.end()
+			return
+		}
+		if (
+			!event.altKey ||
+			event.ctrlKey ||
+			event.metaKey ||
+			event.shiftKey ||
+			event.isComposing ||
+			this.#item
+		)
+			return
+		const target = event.target
+		const realm = this.#element.ownerDocument.defaultView ?? window
+		if (
+			!(target instanceof realm.HTMLElement) ||
+			(target !== item && target.getAttribute('draggable') !== 'true')
+		)
+			return
+		if (item.getAttribute('draggable') !== 'true' && !item.querySelector('[draggable="true"]'))
+			return
+		const { horizontal, reversed } = this.#axis()
+		const previous = horizontal ? 'ArrowLeft' : 'ArrowUp'
+		const next = horizontal ? 'ArrowRight' : 'ArrowDown'
+		if (event.key !== previous && event.key !== next) return
+		event.preventDefault()
+		const children = this.#children()
+		const to = children.indexOf(item) + ((event.key === next) !== reversed ? 1 : -1)
+		if (to < 0 || to >= children.length) return
+		if (
+			emitEvent(this.#element, DRAG_EVENTS.start, { item }).defaultPrevented ||
+			this.destroyed ||
+			item.parentElement !== this.#element
+		)
+			return
+		this.#item = item
+		this.#finish(this.#relocate(item, to, 'keyboard'))
+	}
+
+	#relocate(item: HTMLElement, to: number, by: 'pointer' | 'keyboard'): boolean {
+		const children = this.#children()
+		const from = children.indexOf(item)
+		if (from < 0 || from === to) return false
+		if (
+			emitEvent(this.#element, DRAG_EVENTS.move, { item, from, to, by }).defaultPrevented ||
+			this.destroyed ||
+			this.#item !== item
+		)
+			return false
+		// An observer that renders synchronously owns the changed order.
+		const current = this.#children()
+		if (
+			current.length !== children.length ||
+			current.some((child, index) => child !== children[index])
+		)
+			return false
+		const reference = children.filter((child) => child !== item)[to] ?? this.#output
+		const focus = this.#element.ownerDocument.activeElement
+		if (typeof this.#element.moveBefore === 'function') this.#element.moveBefore(item, reference)
+		else {
+			this.#element.insertBefore(item, reference)
+			const realm = this.#element.ownerDocument.defaultView ?? window
+			if (focus instanceof realm.HTMLElement && item.contains(focus))
+				focus.focus({ preventScroll: true })
+		}
+		this.#output.value = `Moved to position ${to + 1} of ${children.length}`
+		return true
+	}
+
+	#clearIndicator(): void {
+		this.#indicator?.removeAttribute('data-vn-insert')
+		this.#indicator = undefined
+	}
+
+	#finish(moved: boolean): void {
+		const item = this.#item
+		this.#item = undefined
+		this.#clearIndicator()
+		item?.removeAttribute('data-vn-dragging')
+		if (item && !this.destroyed) emitEvent(this.#element, DRAG_EVENTS.end, { item, moved })
+	}
+}
