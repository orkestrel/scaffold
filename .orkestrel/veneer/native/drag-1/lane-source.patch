+		expect(new Registry(document).component(createDragPlugin(), host)).toBeUndefined()
+		blank.destroy()
+		const composed = createVeneer(root, { plugins: [createDragPlugin()] })
+		try {
+			const active = await session.send('DOMDebugger.getEventListeners', { objectId })
+			expect(countCDPListeners(active, 'dragstart')).toBe(
+				countCDPListeners(before, 'dragstart') + 1,
