+import type { DragInterface, DragOptions } from './types.js'
+import { Registry } from '../Registry.js'
+import { Drag } from './Drag.js'
+import { DRAG_DEFAULTS } from './constants.js'
+import { createDragPlugin } from './plugins.js'
+
+/**
+ * Creates or returns the registered sortable-list controller for a host.
+ * @param element - List whose direct children are sortable items.
+ * @param options - Initial hooks, applied when configuring the lifetime.
+ * @returns The host's live sortable-list controller.
+ * @example
+ * const drag = createDrag(document.createElement('div'))
+ * drag.end()
+ */
+export function createDrag(
+	element: HTMLElement,
+	options: DragOptions = DRAG_DEFAULTS,
+): DragInterface {
+	const registry = new Registry(element.ownerDocument)
+	return registry.settle(
+		createDragPlugin(),
+		element,
+		options,
+		(context) => new Drag(element, context, options),
+	)
+}
