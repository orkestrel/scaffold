+import type { PluginInterface } from '../types.js'
+import { isInstance } from '@orkestrel/contract'
+import { buildPlugin } from '../helpers.js'
+import { Drag } from './Drag.js'
+
+/**
+ * Creates the sortable-list plugin without registering components or listeners.
+ * @returns The frozen sortable-list plugin.
+ * @example
+ * createDragPlugin()
+ */
+export function createDragPlugin(): PluginInterface<Drag> {
+	return buildPlugin<Drag>({
+		name: 'drag',
+		is: (value): value is Drag => isInstance(value, Drag),
+		create: (element, context) => new Drag(element, context),
+		boot: { selector: '[data-vn-drag]' },
+		routes: [
+			'pointerdown',
+			'dragstart',
+			'dragenter',
+			'dragover',
+			'dragleave',
+			'drop',
+			'dragend',
+			'keydown',
+		].map((event) => ({
+			event,
+			selector: '[data-vn-drag] > *',
+			hosts: (trigger) => (trigger.parentElement ? [trigger.parentElement] : []),
+			execute: (component, interaction) => {
+				if (interaction.event) component.receive(interaction.event, interaction.trigger)
+			},
+		})),
+		clear: {
+			events: ['drop', 'dragend', 'keydown'],
+			execute: (event, context) => {
+				if (
+					event.type === 'keydown' &&
+					(!(event instanceof KeyboardEvent) || event.key !== 'Escape')
+				)
+					return
+				const target = event.target
+				const document =
+					target instanceof Node
+						? (target.ownerDocument ?? (target instanceof Document ? target : undefined))
+						: undefined
+				for (const host of document?.querySelectorAll<HTMLElement>('[data-vn-drag]') ?? [])
+					context.component(host)?.end()
+			},
+		},
+	})
+}
