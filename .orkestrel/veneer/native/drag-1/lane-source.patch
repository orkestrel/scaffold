+import type { DragEventMap } from '@src/browser'
+import { createRecorder, requireValue } from '@orkestrel/test'
+import { createDragEvent, render } from '@orkestrel/test/browser'
+import { DRAG_EVENTS, createDrag, createDragPlugin, createVeneer } from '@src/browser'
+import { userEvent } from 'vitest/browser'
+import { expect, it } from 'vitest'
+
+it('moves one place by a real pointer drag and by Alt+ArrowDown with matching indexes and retained focus', async () => {
+	const root = render(
+		'<div data-vn-drag><div draggable="true" tabindex="0" style="padding:20px">First</div><div draggable="true" tabindex="0" style="padding:20px">Second</div><div draggable="true" tabindex="0" style="padding:20px">Third</div></div>',
+	)
+	document.body.append(root)
+	const host = requireValue(root.querySelector<HTMLElement>('[data-vn-drag]'))
+	const first = requireValue(host.querySelector<HTMLElement>('[draggable]'))
+	const second = requireValue(first.nextElementSibling)
+	const order = createRecorder<readonly [string]>()
+	const moves = createRecorder<readonly [DragEventMap['move']]>()
+	const ends = createRecorder<readonly [DragEventMap['end']]>()
+	const scope = createVeneer(root, { plugins: [createDragPlugin()] })
+	const drag = createDrag(host, {
+		on: {
+			start: () => order.handler('start'),
+			move: (event) => {
+				order.handler('move')
+				moves.handler(event)
+			},
+			end: (event) => {
+				order.handler('end')
+				ends.handler(event)
+			},
+		},
+	})
+	try {
+		await userEvent.dragAndDrop(first, second, {
+			targetPosition: { x: 10, y: second.getBoundingClientRect().height * 0.75 },
+		})
+		expect(
+			Array.from(host.children)
+				.slice(0, 3)
+				.map((child) => child.textContent),
+		).toEqual(['Second', 'First', 'Third'])
+		expect(order.calls).toEqual([['start'], ['move'], ['end']])
+		expect(moves.calls[0]?.[0].detail).toEqual({ item: first, from: 0, to: 1, by: 'pointer' })
+		expect(ends.calls[0]?.[0].detail).toEqual({ item: first, moved: true })
+		expect(host.querySelector('output')?.value).toBe('Moved to position 2 of 3')
+		await userEvent.click(first)
+		await userEvent.keyboard('{Alt>}{ArrowUp}{/Alt}')
+		moves.clear()
+		order.clear()
+		await userEvent.keyboard('{Alt>}{ArrowDown}{/Alt}')
+		expect(moves.calls[0]?.[0].detail).toEqual({ item: first, from: 0, to: 1, by: 'keyboard' })
+		expect(order.calls).toEqual([['start'], ['move'], ['end']])
+		expect(document.activeElement).toBe(first)
+		expect(host.querySelector('output')?.value).toBe('Moved to position 2 of 3')
+		expect(first.hasAttribute('data-vn-dragging')).toBe(false)
+	} finally {
+		drag.destroy()
+		scope.destroy()
+		root.remove()
+	}
+})
+
+it('leaves order unchanged when a pointer or keyboard move is prevented', async () => {
+	const root = render(
+		'<div data-vn-drag><div draggable="true" tabindex="0" style="padding:20px">First</div><div draggable="true" style="padding:20px">Second</div></div>',
+	)
+	document.body.append(root)
+	const host = requireValue(root.querySelector<HTMLElement>('[data-vn-drag]'))
+	const first = requireValue(host.querySelector<HTMLElement>('[draggable]'))
+	const second = requireValue(first.nextElementSibling)
+	const ends = createRecorder<readonly [DragEventMap['end']]>()
+	const moves = createRecorder<readonly [DragEventMap['move']]>()
+	const scope = createVeneer(root, { plugins: [createDragPlugin()] })
+	const drag = createDrag(host, {
+		on: {
+			move: (event) => {
+				event.preventDefault()
+				moves.handler(event)
+			},
+			end: ends.handler,
+		},
+	})
+	try {
+		await userEvent.dragAndDrop(first, second, {
+			targetPosition: { x: 10, y: second.getBoundingClientRect().height * 0.75 },
+		})
+		await userEvent.click(first)
+		await userEvent.keyboard('{Alt>}{ArrowDown}{/Alt}')
+		expect(moves.calls.map(([event]) => event.detail.by)).toEqual(['pointer', 'keyboard'])
+		expect(host.firstElementChild).toBe(first)
+		expect(ends.calls.map(([event]) => event.detail.moved)).toEqual([false, false])
+		expect(host.querySelector('output')?.value).toBe('')
+	} finally {
+		drag.destroy()
+		scope.destroy()
+		root.remove()
+	}
+})
+
+it('refuses grabs outside a handle, input descendants, and prevented starts', async () => {
+	const root = render(
+		'<div data-vn-drag><div draggable="true" style="padding:20px"><button draggable="true">Grip</button><span style="display:inline-block;padding:20px">Outside grip</span></div><div draggable="true" style="padding:20px"><input draggable="false" value="Input text"></div><div style="padding:20px">Target</div></div>',
+	)
+	document.body.append(root)
+	const host = requireValue(root.querySelector<HTMLElement>('[data-vn-drag]'))
+	const handle = requireValue(host.querySelector('button'))
+	const outside = requireValue(host.querySelector('span'))
+	const input = requireValue(host.querySelector('input'))
+	const target = requireValue(host.lastElementChild)
+	const starts = createRecorder<readonly [DragEventMap['start']]>()
+	const ends = createRecorder<readonly [DragEventMap['end']]>()
+	const scope = createVeneer(root, { plugins: [createDragPlugin()] })
+	const drag = createDrag(host, { on: { start: starts.handler, end: ends.handler } })
+	try {
+		await userEvent.dragAndDrop(outside, target)
+		await userEvent.dragAndDrop(input, target)
+		expect(starts.count).toBe(0)
+		const inputStart = createDragEvent('dragstart')
+		input.dispatchEvent(inputStart)
+		expect(inputStart.defaultPrevented).toBe(true)
+		expect(starts.count).toBe(0)
+		host.addEventListener(DRAG_EVENTS.start, (event) => event.preventDefault(), { once: true })
+		await userEvent.dragAndDrop(handle, target)
+		expect(starts.count).toBe(1)
+		expect(ends.count).toBe(0)
+		expect(host.firstElementChild).toBe(handle.parentElement)
+		expect(handle.getAttribute('draggable')).toBe('true')
+	} finally {
+		drag.destroy()
+		scope.destroy()
+		root.remove()
+	}
+})
+
+it('ends a real drop outside its host without moving or exporting a text payload', async () => {
+	const root = render(
+		'<div data-vn-drag><div draggable="true" style="padding:20px">First</div><div style="padding:20px">Second</div></div><textarea aria-label="Outside"></textarea>',
+	)
+	document.body.append(root)
+	const host = requireValue(root.querySelector<HTMLElement>('[data-vn-drag]'))
+	const first = requireValue(host.firstElementChild)
+	const outside = requireValue(root.querySelector('textarea'))
+	const ends = createRecorder<readonly [DragEventMap['end']]>()
+	const types: string[][] = []
+	root.addEventListener('dragstart', (event) => {
+		types.push(Array.from(event.dataTransfer?.types ?? []))
+	})
+	const scope = createVeneer(root, { plugins: [createDragPlugin()] })
+	const drag = createDrag(host, { on: { end: ends.handler } })
+	try {
+		await userEvent.dragAndDrop(first, outside)
+		expect(types).toEqual([[]])
+		expect(outside.value).toBe('')
+		expect(host.firstElementChild).toBe(first)
+		expect(ends.calls[0]?.[0].detail).toEqual({ item: first, moved: false })
+		expect(ends.count).toBe(1)
+	} finally {
+		drag.destroy()
+		scope.destroy()
+		root.remove()
+	}
+})
+
+it('keeps an input value and focus through moveBefore and refuses unrelated keyboard input', async () => {
+	const root = render(
+		'<div data-vn-drag><div><input draggable="true" value="Original"></div><div>Second</div></div>',
+	)
+	document.body.append(root)
+	const host = requireValue(root.querySelector<HTMLElement>('[data-vn-drag]'))
+	const input = requireValue(host.querySelector('input'))
+	const first = requireValue(input.parentElement)
+	const scope = createVeneer(root, { plugins: [createDragPlugin()] })
+	try {
+		expect(typeof host.moveBefore).toBe('function')
+		await userEvent.fill(input, 'Retained edit')
+		await userEvent.keyboard('{ArrowDown}')
+		expect(host.firstElementChild).toBe(first)
+		await userEvent.keyboard('{Alt>}{ArrowDown}{/Alt}')
+		expect(host.children[1]).toBe(first)
+		expect(document.activeElement).toBe(input)
+		expect(input.value).toBe('Retained edit')
+		await userEvent.keyboard('{Alt>}{ArrowDown}{/Alt}')
+		expect(host.children[1]).toBe(first)
+		expect(host.querySelector('output')?.value).toBe('Moved to position 2 of 2')
+	} finally {
+		scope.destroy()
+		root.remove()
+	}
+})
+
+it('uses row-axis keys and stops at either end without wrapping', async () => {
+	const root = render(
+		'<div data-vn-drag style="display:flex;flex-direction:row"><div draggable="true" tabindex="0">First</div><div>Second</div></div>',
+	)
+	document.body.append(root)
+	const host = requireValue(root.querySelector<HTMLElement>('[data-vn-drag]'))
+	const first = requireValue(host.querySelector<HTMLElement>('[draggable]'))
+	const scope = createVeneer(root, { plugins: [createDragPlugin()] })
+	try {
+		await userEvent.click(first)
+		await userEvent.keyboard('{Alt>}{ArrowLeft}{ArrowDown}{/Alt}')
+		expect(host.firstElementChild).toBe(first)
+		await userEvent.keyboard('{Alt>}{ArrowRight}{ArrowRight}{/Alt}')
+		expect(host.children[1]).toBe(first)
+		expect(document.activeElement).toBe(first)
+	} finally {
+		scope.destroy()
+		root.remove()
+	}
+})
