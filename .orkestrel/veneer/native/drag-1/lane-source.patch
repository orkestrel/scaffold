+import { createRecorder, requireValue, waitForCondition, waitForDelay } from '@orkestrel/test'
+import { createDragEvent, render } from '@orkestrel/test/browser'
+import { createDragPlugin, createVeneer, DRAG_EVENTS, Registry } from '@src/browser'
+import { cdp, userEvent } from 'vitest/browser'
+import { expect, it } from 'vitest'
+import { countCDPListeners, isCDPSender, readCDPField } from '../../../setupBrowser.js'
+
+it('adds no native listeners or output without composition and releases composed listeners', async () => {
+	const root = render(
+		'<div data-vn-drag><div draggable="true" tabindex="0">First</div><div>Second</div></div>',
+	)
+	document.body.append(root)
+	const host = requireValue(root.querySelector<HTMLElement>('[data-vn-drag]'))
+	const marker = crypto.randomUUID()
+	host.id = marker
+	const session: unknown = cdp()
+	if (!isCDPSender(session)) throw new Error('Missing CDP sender')
+	await session.send('DOM.getDocument', { depth: -1, pierce: true })
+	const search = await session.send('DOM.performSearch', {
+		query: `[id="${marker}"]`,
+		includeUserAgentShadowDOM: true,
+	})
+	const searchId = readCDPField(search, ['searchId'])
+	if (typeof searchId !== 'string') throw new Error('Missing search id')
+	const nodes = await session.send('DOM.getSearchResults', { searchId, fromIndex: 0, toIndex: 1 })
+	const ids = readCDPField(nodes, ['nodeIds'])
+	const nodeId: unknown = Array.isArray(ids) ? ids[0] : undefined
+	if (typeof nodeId !== 'number') throw new Error('Missing node id')
+	const resolved = await session.send('DOM.resolveNode', { nodeId })
+	const hostId = readCDPField(resolved, ['object', 'objectId'])
+	if (typeof hostId !== 'string') throw new Error('Missing host object')
+	const owner = await session.send('Runtime.callFunctionOn', {
+		objectId: hostId,
+		functionDeclaration: 'function () { return this.ownerDocument }',
+	})
+	const objectId = readCDPField(owner, ['result', 'objectId'])
+	if (typeof objectId !== 'string') throw new Error('Missing document object')
+	const before = await session.send('DOMDebugger.getEventListeners', { objectId })
+	const blank = createVeneer(root)
+	try {
