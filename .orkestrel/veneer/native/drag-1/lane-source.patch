@@ -0,0 +1,30 @@
+import type { ComponentEvent, ComponentHooks, ComponentInterface } from '../types.js'
+
+/** Describes a list controller that receives native pointer and keyboard input. */
+export interface DragInterface extends ComponentInterface {
+	/** Routes native input for a direct child of the list. */
+	receive(event: Event, item: HTMLElement): void
+	/** Ends an outstanding drag without moving its item. */
+	end(): void
+}
+
+/** Maps sortable-list notifications to their payloads. */
+export interface DragEventMap {
+	/** Carries the item before a grab; prevention refuses the grab. */
+	readonly start: ComponentEvent<{ readonly item: HTMLElement }>
+	/** Carries zero-based indexes before and after a move; prevention leaves the DOM unchanged. */
+	readonly move: ComponentEvent<{
+		readonly item: HTMLElement
+		readonly from: number
+		readonly to: number
+		readonly by: 'pointer' | 'keyboard'
+	}>
+	/** Carries the item and whether the controller moved it. */
+	readonly end: ComponentEvent<{ readonly item: HTMLElement; readonly moved: boolean }>
+}
+
+/** Configures the initial sortable-list hooks. */
+export interface DragOptions {
+	/** Supplies hooks for this component lifetime. Default: none. */
