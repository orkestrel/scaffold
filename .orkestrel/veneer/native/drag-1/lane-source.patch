+it('keeps the indicator across a real nested-child crossing and reads swallowed Escape before native cancellation', async () => {
+	const root = render(
+		'<div data-vn-drag style="position:fixed;left:20px;top:20px;width:300px"><div draggable="true" tabindex="0" style="height:60px">First</div><div style="height:100px"><span style="display:block;height:40px">Nested target</span><span style="display:block;height:60px">Other child</span></div></div>',
+	)
+	document.body.append(root)
+	const host = requireValue(root.querySelector<HTMLElement>('[data-vn-drag]'))
+	const first = requireValue(host.querySelector<HTMLElement>('[draggable]'))
+	const second = requireValue(first.nextElementSibling)
+	const nested = requireValue(second.firstElementChild)
+	const keys = createRecorder<readonly [KeyboardEvent]>()
+	const ends = createRecorder<readonly [Event]>()
+	const leaves: Array<{ readonly retained: string | null; readonly related: EventTarget | null }> =
+		[]
+	const lifetime = new AbortController()
+	const trace: unknown[] = []
+	for (const name of [
+		'pointerdown',
+		'dragstart',
+		'dragenter',
+		'dragover',
+		'dragleave',
+		'drop',
+		'dragend',
+	]) {
+		host.addEventListener(
+			name,
+			(event) => {
+				trace.push({
+					name,
+					target: event.target instanceof Element ? event.target.textContent : null,
+					prevented: event.defaultPrevented,
+					source: first.hasAttribute('data-vn-dragging'),
+					insert: second.getAttribute('data-vn-insert'),
+					point: event instanceof MouseEvent ? [event.clientX, event.clientY] : [],
+				})
+			},
+			{ signal: lifetime.signal },
+		)
+	}
+	document.addEventListener('keydown', keys.handler, { signal: lifetime.signal })
+	host.addEventListener(DRAG_EVENTS.end, ends.handler)
+	host.addEventListener('dragleave', (event) => {
+		leaves.push({ retained: second.getAttribute('data-vn-insert'), related: event.relatedTarget })
+	})
+	const scope = createVeneer(root, { plugins: [createDragPlugin()] })
+	const session: unknown = cdp()
+	if (!isCDPSender(session)) throw new Error('Missing CDP sender')
+	const browser = await session.send('Browser.getVersion')
+	let escapeEnds = 0
+	try {
+		await userEvent.click(first)
+		await userEvent.keyboard('{Escape}')
+		expect(keys.calls.filter(([event]) => event.key === 'Escape')).toHaveLength(1)
+		keys.clear()
+		const points = [first, second, nested].map((element) => {
+			const box = element.getBoundingClientRect()
+			let x = box.x + 10
+			let y = box.y + (element === second ? 45 : 10)
+			for (
+				let frame = element.ownerDocument.defaultView?.frameElement;
+				frame;
+				frame = frame.ownerDocument.defaultView?.frameElement
+			) {
+				const bounds = frame.getBoundingClientRect()
+				x = bounds.x + (x * bounds.width) / frame.clientWidth
+				y = bounds.y + (y * bounds.height) / frame.clientHeight
+			}
+			return { x, y }
+		})
+		const origin = requireValue(points[0])
+		await session.send('Input.dispatchMouseEvent', { type: 'mouseMoved', ...origin })
+		await session.send('Input.dispatchMouseEvent', {
+			type: 'mousePressed',
+			...origin,
+			button: 'left',
+			buttons: 1,
+			clickCount: 1,
+		})
+		await session.send('Input.dispatchMouseEvent', {
+			type: 'mouseMoved',
+			x: origin.x + 10,
+			y: origin.y + 10,
+			button: 'left',
+			buttons: 1,
+		})
+		await session.send('Input.dispatchMouseEvent', {
+			type: 'mouseMoved',
+			...requireValue(points[1]),
+			button: 'left',
+			buttons: 1,
+		})
+		await session.send('Input.dispatchMouseEvent', {
+			type: 'mouseMoved',
+			...requireValue(points[1]),
+			button: 'left',
+			buttons: 1,
+		})
+		await waitForCondition('native drag reaches target', () =>
+			second.hasAttribute('data-vn-insert'),
+		)
+		leaves.length = 0
+		await session.send('Input.dispatchMouseEvent', {
+			type: 'mouseMoved',
+			...requireValue(points[2]),
+			button: 'left',
+			buttons: 1,
+		})
+		await waitForCondition('native drag crosses nested child', () =>
+			leaves.some((entry) => entry.related === nested),
+		)
+		expect(
+			leaves.filter((entry) => entry.related === nested).map((entry) => entry.retained),
+		).toEqual(['before'])
+		expect(second.getAttribute('data-vn-insert')).toBe('before')
+		await session.send('Input.dispatchKeyEvent', {
+			type: 'rawKeyDown',
+			key: 'Escape',
+			code: 'Escape',
+			windowsVirtualKeyCode: 27,
+		})
+		await session.send('Input.dispatchKeyEvent', {
+			type: 'keyUp',
+			key: 'Escape',
+			code: 'Escape',
+			windowsVirtualKeyCode: 27,
+		})
+		await waitForDelay(100)
+		escapeEnds = ends.count
+		expect(keys.calls.filter(([event]) => event.key === 'Escape')).toHaveLength(0)
+		expect(escapeEnds).toBe(0)
+		await session.send('Input.dispatchDragEvent', {
+			type: 'dragCancel',
+			...requireValue(points[2]),
+			data: { items: [], dragOperationsMask: 65535 },
+		})
+		await waitForCondition('native cancellation ends the drag', () => ends.count === 1)
+		expect(host.firstElementChild).toBe(first)
+		expect(ends.calls[0]?.[0]).toMatchObject({ detail: { item: first, moved: false } })
+		expect(second.hasAttribute('data-vn-insert')).toBe(false)
+	} finally {
+		await session.send('Input.dispatchMouseEvent', {
+			type: 'mouseReleased',
+			x: -1,
+			y: -1,
+			button: 'left',
+			buttons: 0,
+			clickCount: 1,
+		})
+		await session.send('Input.dispatchMouseEvent', { type: 'mouseMoved', x: -1, y: -1 })
+		console.info(
+			'Native drag Escape reading',
+			JSON.stringify({
+				browser: readCDPField(browser, ['product']),
+				trace,
+				escapeKeys: keys.calls.filter(([event]) => event.key === 'Escape').length,
+				escapeEnds,
+				ends: ends.count,
+			}),
+		)
+		lifetime.abort()
+		scope.destroy()
+		root.remove()
+	}
+})
