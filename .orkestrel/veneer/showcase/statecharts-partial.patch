+ */
+export async function buildComponent(
+	context: ComponentContext,
+	name: string,
+	face: Face,
+): Promise<ComponentContext> {
+	if (
+		built !== undefined &&
+		built.context === context &&
+		built.name === name &&
+		built.face === face &&
+		built.showcase === mounted &&
+		context.controls.every((control) => holdsControl(context, control))
+	) {
+		return context
+	}
+	destroyShowcase()
+	const showcase = await buildShowcase()
+	await applyTheme(name)
+	await applyFace(face)
+	engine = createEngine(document)
+	built = Object.freeze({ context, name, face, showcase })
+	return context
+}
+
+// Reads whether a region holds a control of any interactive role under an exact name, hidden or not.
+function holdsControl(context: ComponentContext, name: string): boolean {
+	const region = page.getByRole('region', { name: context.region, exact: true })
+	return ACCESSIBLE_ROLES.some(
+		(role) =>
+			region.getByRole(role, { name, exact: true, includeHidden: true }).elements().length > 0,
+	)
+}
+
+// Reads one control a region renders by role and exact name, whether or not the Tab order reaches it.
+function readControl(context: ComponentContext, role: string, name: string): Element {
+	return page
+		.getByRole('region', { name: context.region, exact: true })
+		.getByRole(role, { name, exact: true })
+		.element()
