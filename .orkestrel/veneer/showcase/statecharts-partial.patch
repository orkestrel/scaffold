+// Waits for a reading to equal the state, lets the paint settle, and reads once more, so a
+// transition that starts after the first matching frame still fails the row.
+async function settleComponent<TState extends string>(
+	read: (context: ComponentContext) => TState,
+	context: ComponentContext,
+	state: TState,
+): Promise<void> {
+	await retryUntil(
+		`${context.region} reads ${state}`,
+		() => read(context),
+		(reading) => reading === state,
+		{ budget: SETTLE_BUDGET },
