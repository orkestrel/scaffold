+/**
+ * Describes the live engine specimen one component statechart drives, by the names a person reads.
+ *
+ * @remarks
+ * `region` names the section the specimen sits in, and every control a row resolves sits inside
+ * it. `controls` lists the controls the rows press: the trigger first and then the control a row
+ * moves focus or the pointer to, or every tab, indicator, or header of a set in page order.
+ * `subject` names what the shown component renders: a dialog, a status, a tip, a menu item, or a
+ * sentence; a set of tabs, indicators, or headers leaves it out.
+ */
+export interface ComponentContext {
+	readonly region: string
+	readonly controls: readonly string[]
+	readonly subject?: string
+}
+
+/**
+ * Describes one component statechart: the specimen it drives, its rows, and its state reader.
+ *
+ * @remarks
+ * `family` names the engine family, `context` the specimen, `scenarios` the rows in the order a run
+ * drives them, and `state` the reader the harness renders the specimen's state with.
+ */
+export interface ComponentTable<TState extends string = string> {
+	readonly family: string
+	readonly context: ComponentContext
+	readonly scenarios: ReadonlyArray<StateScenario<TState, string, ComponentContext>>
+	readonly state: (context: ComponentContext) => TState
+}
+
+// One row of a component table and the act that drives its event through the interface.
+interface ComponentRow<TState extends string> extends StateTransition<TState, string> {
+	readonly act: (context: ComponentContext, event: string) => Promise<void>
+}
+
+// The page one component build mounted, and the context, color mode, and stylesheet set it served.
+interface ComponentBuild {
+	readonly context: ComponentContext
+	readonly name: string
+	readonly face: Face
+	readonly showcase: Showcase
+}
+
+// A row's settle polls under this budget, which clears the slowest engine transition, a modal's
+// dialog and backdrop fades, on a contended host.
+const SETTLE_BUDGET = 5000
+
+/**
+ * Mounts a showcase under a color mode and a stylesheet set and boots the engine over it, or reuses
+ * the page the previous call mounted for the same specimen.
+ *
+ * @param context - The specimen the row drives, returned as the row's context.
+ * @param name - A theme, or a journey variant name such as `dark-390` that opens with one.
+ * @param face - The stylesheet set to select.
+ * @returns The context, after the engine serves the page's data API.
+ * @throws Thrown when the name selects no theme, or a header button is unreachable or never pressed.
+ *
+ * @remarks
+ * The previous call's page is reused when it was built for the same context object, color mode, and
+ * stylesheet set, it is still the mounted showcase, and every control the context names is still in
+ * the document, hidden or not, so each row's arrange restores its state through the interface.
+ * Otherwise the engine scope and the page are destroyed, a fresh page is mounted, the color mode
+ * and the stylesheet set are selected through the header buttons, and the engine boots. A
+ * dismissed alert leaves the document, so every alert row mounts a fresh page. `destroyShowcase`
+ * destroys the last page and scope.
+ *
+ * @example
+ * ```ts
+ * const [table] = COMPONENT_TABLES
+ * await executeScenarios(table.scenarios, () => buildComponent(table.context, 'dark-390', 'bootstrap'))
