+// Reads the trigger's expansion and whether the region's rendered text carries the panel sentence.
+async function assertCollapse(context: ComponentContext, state: VisibilityPhase): Promise<void> {
+	await settleComponent(readExpansion, context, state)
+	const painted = readPerception(context.region).includes(requireValue(context.subject))
+	if (painted !== (state === 'shown')) {
+		throw new Error(`${context.region} ${painted ? 'paints' : 'hides'} its panel while ${state}`)
+	}
+}
+
+// Presses the header the state names into expansion, or the first header out of it for `none`,
+// leaving focus on the pressed header.
+async function arrangePanels(context: ComponentContext, state: string): Promise<void> {
+	await toggleComponent(context, state === 'none' ? readTrigger(context) : state, readPanels, state)
+}
+
+// Reads which headers announce their panels expanded, so a second expanded panel fails the row.
+async function assertPanels(context: ComponentContext, state: string): Promise<void> {
+	await settleComponent(readPanels, context, state)
+}
+
+// Clicks the tab the state names, which selects it and leaves focus on it.
+async function arrangeTabs(context: ComponentContext, state: string): Promise<void> {
+	await clickTab(context, state)
+	await settleComponent(readTabs, context, state)
+}
+
+// Reads the selected tab and that the role engine presents its panel alone.
+async function assertTabs(context: ComponentContext, state: string): Promise<void> {
+	await settleComponent(readTabs, context, state)
+	const shown = context.controls.filter(
+		(name) =>
+			page
+				.getByRole('region', { name: context.region, exact: true })
+				.getByRole('tabpanel', { name, exact: true })
+				.elements().length === 1,
+	)
+	if (shown.join(' and ') !== state) {
+		throw new Error(
+			`${context.region} shows the ${shown.join(' and ')} panel with ${state} selected`,
+		)
+	}
+}
+
+// Shows the toast through its trigger, which leaves focus there, or dismisses a shown toast through
+// its close button.
+async function arrangeToast(context: ComponentContext, state: VisibilityPhase): Promise<void> {
+	if (state === 'shown') await clickButton(context, readTrigger(context))
+	else if (readStatus(context) === 'shown') {
+		await clickButton(context, requireValue(context.controls[1]))
+	}
+	await settleComponent(readStatus, context, state)
+}
+
+// Reads whether the role engine presents the toast.
+async function assertToast(context: ComponentContext, state: VisibilityPhase): Promise<void> {
+	await settleComponent(readStatus, context, state)
+}
+
+// Clicks the neighbouring button, which takes focus and the pointer off the trigger, and for the
+// shown state moves the pointer back onto the trigger.
+async function arrangeTooltip(context: ComponentContext, state: VisibilityPhase): Promise<void> {
+	await clickAccessibleWithin(context.region, 'button', requireValue(context.controls[1]))
+	await settleComponent(readTip, context, 'hidden')
+	if (state === 'hidden') return
+	await hoverButton(context, readTrigger(context))
+	await settleComponent(readTip, context, 'shown')
+}
+
+// Presses the trigger into the arranged state, leaving focus on it.
+async function arrangePopover(context: ComponentContext, state: VisibilityPhase): Promise<void> {
+	await toggleComponent(context, readTrigger(context), readTip, state)
+}
+
+// Reads the trigger's description and the rendered tip.
+async function assertTip(context: ComponentContext, state: VisibilityPhase): Promise<void> {
+	await settleComponent(readTip, context, state)
+}
+
+// Clicks the indicator the state names, which shows its slide and leaves focus on it.
+async function arrangeSlides(context: ComponentContext, state: string): Promise<void> {
+	await clickAccessibleWithin(context.region, 'button', state)
+	await settleComponent(readSlides, context, state)
+}
+
+// Reads which indicator announces the current slide, so a second current indicator fails the row.
+async function assertSlides(context: ComponentContext, state: string): Promise<void> {
+	await settleComponent(readSlides, context, state)
+}
+
+// Clicks the link before the alert and tabs forward onto its close button; a removed alert cannot
+// be arranged, so every row starts shown.
+async function arrangeAlert(context: ComponentContext, state: VisibilityPhase): Promise<void> {
+	await clickAccessibleWithin(context.region, 'link', requireValue(context.controls[1]))
+	await traverseAccessibleWithin(context.region, 'button', readTrigger(context))
+	await settleComponent(readAlert, context, state)
+}
+
+// Reads whether the region's rendered text carries the alert sentence.
+async function assertAlert(context: ComponentContext, state: VisibilityPhase): Promise<void> {
+	await settleComponent(readAlert, context, state)
+}
+
+// Presses the toggle button into the arranged state, leaving focus on it.
+async function arrangeToggle(context: ComponentContext, state: string): Promise<void> {
+	await toggleComponent(context, readTrigger(context), readToggle, state)
+}
+
+// Reads the pressed state the button announces, and that its pressed sibling stays pressed.
+async function assertToggle(context: ComponentContext, state: string): Promise<void> {
+	await settleComponent(readToggle, context, state)
+	const sibling = requireValue(context.controls[1])
+	if (!readStates(readControl(context, 'button', sibling)).includes('pressed=true')) {
+		throw new Error(`${sibling} lost its pressed state`)
+	}
+}
+
+// Assembles a frozen component table from its rows and the phases every row shares.
+function buildTable<TState extends string>(
+	family: string,
+	context: ComponentContext,
+	state: (context: ComponentContext) => TState,
+	arrange: (context: ComponentContext, state: TState) => Promise<void>,
+	assert: (context: ComponentContext, state: TState) => Promise<void>,
+	rows: ReadonlyArray<ComponentRow<TState>>,
+): ComponentTable<TState> {
+	return Object.freeze({
+		family,
+		context: Object.freeze({ ...context, controls: Object.freeze([...context.controls]) }),
+		scenarios: Object.freeze(
+			rows.map(({ act, ...transition }) =>
+				Object.freeze({ transition: Object.freeze(transition), arrange, act, assert }),
+			),
+		),
+		state,
+	})
+}
