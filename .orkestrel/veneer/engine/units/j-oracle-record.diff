+/**
+ * Reads the installed Bootstrap bundle and stylesheet as a plugin runtime.
+ * @returns The pinned `bootstrap.bundle.js` script and `bootstrap.css` stylesheet.
+ * @throws The filesystem error when either artifact is missing.
+ */
+export function readBootstrapRuntime(): PluginRuntime {
+	return {
+		engine: 'bootstrap',
+		script: readFileSync(
+			resolve(dirname(BOOTSTRAP_MANIFEST_PATH), 'dist/js/bootstrap.bundle.js'),
+			'utf8',
+		),
+		stylesheet: readBootstrapCascade(),
+	}
+}
+
+/**
+ * Compiles Veneer's browser entry and styles from source, in memory, as a plugin runtime.
+ * @param plugins - Vite plugins added to the browser compile, such as a transform that plants a
+ * mutation. Default: none.
+ * @returns The browser entry as one classic script defining the `veneer` global, and the compiled
+ * cascade.
+ * @throws When either compile fails or produces no script or no stylesheet.
+ * @remarks
+ * The browser compile is the workspace's `srcBrowser` configuration with its output bundled whole
+ * as an immediately invoked script, so the page loads it the way it loads Bootstrap's bundle, and
+ * the styles compile is the workspace's styles configuration. Neither writes a file, so a stale
+ * `dist` directory can never stand in for the source.
+ */
+export async function compileVeneerRuntime(
+	plugins: readonly Plugin[] = [],
+): Promise<PluginRuntime> {
+	const browser = srcBrowser()
+	const {
+		external: _external,
+		output: _output,
+		...rolldownOptions
+	} = browser.build?.rolldownOptions ?? {}
+	const script = await build({
+		...browser,
+		configFile: false,
+		logLevel: 'silent',
+		plugins: [...(browser.plugins ?? []), ...plugins],
+		build: {
+			...browser.build,
+			write: false,
+			emptyOutDir: false,
+			sourcemap: false,
+			lib: {
+				entry: resolve(WORKSPACE_ROOT, 'src/browser/index.ts'),
+				formats: ['iife'],
+				name: 'veneer',
+				fileName: () => 'veneer.js',
+			},
+			rolldownOptions,
+		},
+	})
+	const stylesheet = await build({
+		...stylesConfig,
+		configFile: false,
+		logLevel: 'silent',
+		build: { ...stylesConfig.build, write: false, emptyOutDir: false },
+	})
+	return {
+		engine: 'veneer',
+		script: readBuildOutput(script, '.js'),
+		stylesheet: readBuildOutput(stylesheet, '.css'),
+	}
+}
+
+/**
+ * Reads the text of one file an in-memory Vite build produced.
+ * @param result - What Vite's `build` function resolved to.
+ * @param extension - The file extension to find, such as `.js` or `.css`.
+ * @returns The text of the first chunk or asset whose file name ends with `extension`.
+ * @throws When the build is a watcher or produced no such file.
+ */
+export function readBuildOutput(
+	result: Awaited<ReturnType<typeof build>>,
+	extension: string,
+): string {
+	const outputs = Array.isArray(result) ? result : [result]
+	for (const output of outputs) {
+		if (!('output' in output)) throw new Error('The compile returned a watcher, not an output')
+		for (const file of output.output) {
+			if (!file.fileName.endsWith(extension)) continue
+			if (file.type === 'chunk') return file.code
+			return typeof file.source === 'string' ? file.source : new TextDecoder().decode(file.source)
+		}
+	}
+	throw new Error(`The compile produced no ${extension} file`)
+}
+
+/**
+ * Reads a plugin page's state and labels it: each element's classes, its attributes but the
+ * omitted ones, its visibility, and the focus and scroll-lock state.
+ * @param page - The page the scenario's markup is loaded in, under either engine.
+ * @param scenario - The scenario whose `spawned` selectors label the inserted elements.
+ * @param authored - The ids the scenario's markup carries.
+ * @returns The labelled state the {@link inferPluginState} helper derives from the page's report.
+ * @remarks
+ * The page reports the root, the body, and every element in the body. An element is visible when
+ * its `checkVisibility` method, reading opacity and the `visibility` property, returns `true`.
+ * The lock reads the root's computed `overflow-y`, or the body's where the root's is `visible`,
+ * because the platform then propagates the body's to the viewport.
+ */
+export async function readPluginState(
+	page: Page,
+	scenario: PluginScenario,
+	authored: readonly string[],
+): Promise<PluginState> {
+	const reading = await page.evaluate((spawned) => {
+		const root = getComputedStyle(document.documentElement).overflowY
+		const used = root === 'visible' ? getComputedStyle(document.body).overflowY : root
+		return {
+			nodes: [document.documentElement, document.body, ...document.body.querySelectorAll('*')].map(
+				(element) => ({
+					tag: element.localName,
+					id: element.getAttribute('id') ?? undefined,
+					key: spawned.find((selector) => element.matches(selector)) ?? element.localName,
+					classes: [...element.classList],
+					attributes: Object.fromEntries(
+						[...element.attributes].map((attribute) => [attribute.name, attribute.value]),
+					),
+					visible: element.checkVisibility({ opacityProperty: true, visibilityProperty: true }),
+					focused: element === document.activeElement,
+				}),
+			),
+			locked: used === 'hidden' || used === 'clip',
+		}
+	}, scenario.spawned)
+	return inferPluginState(reading, authored)
+}
+
+/**
+ * Derives a plugin page's labelled state from the page's report.
+ * @param reading - The elements the page reported, in document order, and its lock reading.
+ * @param authored - The ids the scenario's markup carries.
+ * @returns Each element keyed by its label, with sorted classes and attributes, the omitted
+ * attributes left out, and every id reference written as the label it names.
+ * @throws When two elements share a label, which a markup id carried twice produces.
+ * @remarks
+ * The `html` and `body` elements take their tag as their label and an element whose id the markup
+ * carries takes that id. Every other element is one an engine inserted, labelled `+`, its key, and
+ * its position among the inserted elements with that key. An id the page no element carries is
+ * written `?`.
+ */
+export function inferPluginState(reading: PluginReading, authored: readonly string[]): PluginState {
+	const ids = new Set(authored)
+	const positions = new Map<string, number>()
+	const labels = reading.nodes.map((node) => {
+		if (node.tag === 'html' || node.tag === 'body') return node.tag
+		if (node.id !== undefined && ids.has(node.id)) return node.id
+		const position = positions.get(node.key) ?? 0
+		positions.set(node.key, position + 1)
+		return `+${node.key}[${position}]`
+	})
+	const references = new Map<string, string>()
+	for (const [index, node] of reading.nodes.entries()) {
+		const label = labels[index]
+		if (node.id !== undefined && label !== undefined && !references.has(node.id))
+			references.set(node.id, label)
+	}
+	const elements: Record<string, PluginElement> = {}
+	let focus = 'body'
+	for (const [index, node] of reading.nodes.entries()) {
+		const label = labels[index]
+		if (label === undefined) continue
+		if (Object.hasOwn(elements, label))
+			throw new Error(`Plugin reading labels two elements ${label}`)
+		const attributes = Object.keys(node.attributes)
+			.filter((name) => !ORACLE_OMITTED_ATTRIBUTES.includes(name))
+			.sort()
+			.map((name): [string, string] => {
+				const value = node.attributes[name] ?? ''
+				return [
+					name,
+					ORACLE_REFERENCE_ATTRIBUTES.includes(name)
+						? value
+								.split(/\s+/u)
+								.filter((token) => token !== '')
+								.map((token) => references.get(token) ?? '?')
+								.join(' ')
+						: value,
+				]
+			})
+		elements[label] = {
+			classes: [...node.classes].sort(),
+			attributes: Object.fromEntries(attributes),
+			visible: node.visible,
+		}
+		if (node.focused) focus = label
+	}
+	return { elements, focus, locked: reading.locked }
+}
+
+/**
+ * Waits for a plugin page to settle, and reads the state it settled in.
+ * @param page - The page the scenario's markup is loaded in.
+ * @param scenario - The scenario being recorded.
+ * @param authored - The ids the scenario's markup carries.
+ * @returns The state the readings, taken {@link PLUGIN_SETTLE_INTERVAL} milliseconds apart, agree
+ * on for longer than the page's longest declared transition plus that interval, with no finite
+ * animation running and no scroll position moving.
+ * @throws When the page does not settle within the {@link PLUGIN_SETTLE_BUDGET} constant's
+ * milliseconds.
+ * @remarks No engine's own completion event is read, so the wait is the same for both engines and
+ * names no event.
+ */
+export async function settlePluginState(
+	page: Page,
+	scenario: PluginScenario,
+	authored: readonly string[],
+): Promise<PluginState> {
+	let previous: string | undefined
+	let since = performance.now()
+	let settled: PluginState = { elements: {}, focus: 'body', locked: false }
+	await waitForCondition(
+		`the ${scenario.plugin} page to settle`,
+		async () => {
+			const motion = await page.evaluate(() => {
+				const elements = [...document.querySelectorAll('*')]
+				return {
+					animating: document
+						.getAnimations()
+						.some(
+							(animation) =>
+								animation.playState === 'running' &&
+								animation.effect?.getComputedTiming().endTime !== Infinity,
+						),
+					scroll: [
+						window.scrollX,
+						window.scrollY,
+						...elements.map((element) => `${element.scrollTop}:${element.scrollLeft}`),
+					].join(),
+					span: Math.max(
+						0,
+						...elements.map((element) => {
+							const style = getComputedStyle(element)
+							return [style.transitionDuration, style.transitionDelay]
+								.map((times) =>
+									Math.max(
+										...times
+											.split(',')
+											.map((time) =>
+												time.trim().endsWith('ms')
+													? Number.parseFloat(time)
+													: Number.parseFloat(time) * 1000,
+											),
+									),
+								)
+								.reduce((total, time) => total + time, 0)
+						}),
+					),
+				}
+			})
+			const state = await readPluginState(page, scenario, authored)
+			const text = `${motion.scroll}|${JSON.stringify(state)}`
+			const now = performance.now()
+			settled = state
+			if (motion.animating || text !== previous) {
+				previous = motion.animating ? undefined : text
+				since = now
+				return false
+			}
+			return now - since >= motion.span + PLUGIN_SETTLE_INTERVAL
+		},
+		{ budget: PLUGIN_SETTLE_BUDGET, interval: PLUGIN_SETTLE_INTERVAL },
+	)
+	return settled
+}
+
+/**
+ * Sends one scenario action to a plugin page as trusted input, or runs its call for one engine.
+ * @param page - The page the scenario's markup is loaded in.
+ * @param action - The action to send.
+ * @param engine - The engine being recorded, which selects a `call` action's script.
+ * @throws When the action names no target, key, delta, point, or call its gesture needs, or when
+ * the browser refuses the input within its timeout.
+ */
+export async function drivePluginAction(
+	page: Page,
+	action: PluginAction,
+	engine: PluginEngine,
+): Promise<void> {
+	const target = action.target === undefined ? undefined : page.locator(`#${action.target}`)
+	if (action.gesture === 'press' && action.key !== undefined) {
+		if (target === undefined) await page.keyboard.press(action.key)
+		else await target.press(action.key)
+	} else if (action.gesture === 'point' && action.point !== undefined) {
+		await page.mouse.click(action.point.x, action.point.y)
+	} else if (action.gesture === 'call' && action.call !== undefined) {
+		await page.addScriptTag({ content: action.call[engine] })
+	} else if (target === undefined) {
+		throw new Error(`Plugin action ${action.name} names no input for its ${action.gesture} gesture`)
+	} else if (action.gesture === 'click') await target.click()
+	else if (action.gesture === 'hover') await target.hover()
+	else if (action.gesture === 'focus') await target.focus()
+	else if (action.gesture === 'wheel' && action.delta !== undefined) {
+		await target.hover()
+		await page.mouse.wheel(0, action.delta)
+	} else
+		throw new Error(`Plugin action ${action.name} names no input for its ${action.gesture} gesture`)
+}
+
+/**
+ * Records one plugin scenario under one engine, reading the settled state each action leaves.
+ * @param scenario - The markup, setups, and actions to record.
+ * @param runtime - The engine's script and stylesheet: Bootstrap's pinned bundle, or Veneer
+ * compiled from source.
+ * @returns The ordered recording, under no motion preference and then under reduced motion,
+ * without writing or accepting a fixture.
+ * @throws When the markup carries an element without an id, when an action or a settle fails, or
+ * when the page reports an error.
+ * @remarks
+ * Both engines load the same page, with the runtime's stylesheet and script in its head, and
+ * receive the same trusted input, so the only difference between the two recordings is the engine.
+ * Each motion preference loads the page afresh, runs the engine's setup, reads the settled
+ * initial state, and then reads the state each action settles in.
+ */
+export async function recordPluginOracle(
+	scenario: PluginScenario,
+	runtime: PluginRuntime,
+): Promise<PluginFixture> {
+	return driveOracleBrowser(async (browser, scratch) => {
+		scratch.write('runtime.css', runtime.stylesheet)
+		scratch.write('runtime.js', runtime.script)
+		const path = scratch.write(
+			'plugin.html',
+			`<!doctype html><html lang="en"><head><meta charset="utf-8"><title>${scenario.plugin} oracle</title><link rel="stylesheet" href="runtime.css"><script defer src="runtime.js"></script></head><body>${scenario.markup}</body></html>`,
+		)
+		const page = await browser.newPage({ viewport: { width: 1280, height: 720 } })
+		page.setDefaultTimeout(PLUGIN_SETTLE_BUDGET)
+		const errors: string[] = []
+		page.on('pageerror', (error) => {
+			errors.push(error.message)
+		})
+		const steps: PluginStep[] = []
+		for (const reduced of [false, true]) {
+			await page.emulateMedia({ reducedMotion: reduced ? 'reduce' : 'no-preference' })
+			await page.mouse.move(0, 0)
+			await page.goto(pathToFileURL(path).href)
+			const authored = await page.evaluate((markup) => {
+				const template = document.createElement('template')
+				template.innerHTML = markup
+				const unlabelled = template.content.querySelector(':not([id])')
+				if (unlabelled !== null)
+					throw new Error(`Plugin markup carries a ${unlabelled.localName} element without an id`)
+				return [...template.content.querySelectorAll('[id]')].map((element) => element.id)
+			}, scenario.markup)
+			const setup = scenario.setup[runtime.engine]
+			if (setup !== '') await page.addScriptTag({ content: setup })
+			const prefix = `${scenario.plugin}.${reduced ? 'reduced.' : ''}`
+			steps.push({
+				name: `${prefix}initial`,
+				state: await settlePluginState(page, scenario, authored),
+			})
+			for (const action of scenario.actions) {
+				await drivePluginAction(page, action, runtime.engine)
+				steps.push({
+					name: `${prefix}${action.name}`,
+					state: await settlePluginState(page, scenario, authored),
+				})
+			}
+		}
+		if (errors.length > 0)
+			throw new Error(`The ${runtime.engine} ${scenario.plugin} page reported ${errors.join('; ')}`)
+		return {
+			version: BOOTSTRAP_VERSION,
+			plugin: scenario.plugin,
+			browser: browser.version(),
+			steps,
+		}
+	})
+}
+
+/**
+ * Scans a plugin recording against its scenario: the step names it must carry, and a change of
+ * state at every step Bootstrap does not refuse.
+ * @param scenario - The scenario the recording drove.
+ * @param recording - The recording to scan.
+ * @returns The first finding, or undefined when every step is present and each non-refused step
+ * changed the recorded state.
+ */
+export function scanPluginSteps(
+	scenario: PluginScenario,
+	recording: PluginFixture,
+): string | undefined {
+	const expected = ['', 'reduced.'].flatMap((prefix) => [
+		`${scenario.plugin}.${prefix}initial`,
+		...scenario.actions.map((action) => `${scenario.plugin}.${prefix}${action.name}`),
+	])
+	if (
+		!isDeepStrictEqual(
+			recording.steps.map((step) => step.name),
+			expected,
+		)
+	)
+		return `Plugin recording ${recording.plugin} step membership differs from its scenario`
+	for (const [index, step] of recording.steps.entries()) {
+		const action = scenario.actions[(index % (scenario.actions.length + 1)) - 1]
+		const before = recording.steps[index - 1]
+		if (action === undefined || action.refused === true || before === undefined) continue
+		if (isDeepStrictEqual(before.state, step.state))
+			return `Plugin step ${step.name} leaves the recorded state unchanged`
+	}
+	return undefined
+}
+
+/**
+ * Scans a saved plugin fixture for a difference from the live recording, in the JSON form the
+ * fixture file carries.
+ * @param recording - The live Bootstrap recording.
+ * @param fixture - The saved fixture.
+ * @returns The first differing step, a metadata or membership finding, or undefined when they
+ * agree. Returns `Invalid plugin oracle fixture` when the fixture is not an object carrying a
+ * browser and a step list.
+ * @remarks The browser build is required provenance and is excluded from the comparison.
+ */
+export function scanPluginFixture(recording: PluginFixture, fixture: unknown): string | undefined {
+	if (!isRecord(fixture) || typeof fixture.browser !== 'string' || !Array.isArray(fixture.steps))
+		return 'Invalid plugin oracle fixture'
+	const saved = fixture.steps
+	for (const [index, step] of recording.steps.entries()) {
+		if (!isDeepStrictEqual(parseJSON(JSON.stringify(step)), saved[index]))
+			return `Plugin oracle differs at step ${step.name}`
+	}
+	const { browser: _recordedBrowser, ...recorded } = recording
+	const { browser: _savedBrowser, ...metadata } = fixture
+	return isDeepStrictEqual(parseJSON(JSON.stringify(recorded)), metadata)
+		? undefined
+		: 'Plugin oracle fixture metadata or step membership differs'
+}
+
+/**
+ * Checks whether a value is a plugin state: labelled elements with string classes, string
+ * attributes, and a visibility, beside a focus label and a lock reading.
+ * @param value - The value to check.
+ * @returns True if the value has that shape; false otherwise.
+ */
+export function isPluginState(value: unknown): value is PluginState {
+	return (
+		isRecord(value) &&
+		typeof value.focus === 'string' &&
+		typeof value.locked === 'boolean' &&
+		isRecord(value.elements) &&
+		Object.values(value.elements).every(
+			(element) =>
+				isRecord(element) &&
+				Array.isArray(element.classes) &&
+				element.classes.every((token) => typeof token === 'string') &&
+				isRecord(element.attributes) &&
+				Object.values(element.attributes).every((attribute) => typeof attribute === 'string') &&
+				typeof element.visible === 'boolean',
+		)
+	)
+}
+
+/**
+ * Reads a saved plugin fixture.
+ * @param plugin - The plugin whose fixture to read.
+ * @param path - The fixture file. Default: `tests/fixtures/oracle/<plugin>.json` under
+ * {@link WORKSPACE_ROOT}.
+ * @returns The fixture's release, plugin, browser, and steps.
+ * @throws When the file is missing, is not JSON, names another plugin, or carries a step that is
+ * not a name and a plugin state.
+ */
+export function readPluginFixture(
+	plugin: string,
+	path: string = resolve(WORKSPACE_ROOT, `tests/fixtures/oracle/${plugin}.json`),
+): PluginFixture {
+	const fixture = parseJSON(readFileSync(path, 'utf8'))
+	if (
+		!isRecord(fixture) ||
+		typeof fixture.version !== 'string' ||
+		fixture.plugin !== plugin ||
+		typeof fixture.browser !== 'string' ||
+		!Array.isArray(fixture.steps)
+	)
+		throw new Error(`Invalid plugin oracle fixture ${plugin}`)
+	const steps = fixture.steps.map((step: unknown) => {
+		if (!isRecord(step) || typeof step.name !== 'string' || !isPluginState(step.state))
+			throw new Error(`Invalid plugin oracle fixture step ${plugin}`)
+		return { name: step.name, state: step.state }
+	})
+	return { version: fixture.version, plugin, browser: fixture.browser, steps }
+}
+
+/**
+ * Collects every difference between Bootstrap's recording of a plugin and Veneer's.
+ * @param bootstrap - Bootstrap's recording, such as a saved fixture.
+ * @param veneer - Veneer's recording of the same scenario.
+ * @returns One departure per step for each element one side lacks, each class token one side
+ * carries alone, each attribute whose value differs, each visibility that differs, and a differing
+ * focus or lock, in step order.
+ * @throws When the two recordings carry different step names.
+ * @remarks An element one side lacks reports that alone, not its classes or attributes.
+ */
+export function collectEngineDepartures(
+	bootstrap: PluginFixture,
+	veneer: PluginFixture,
+): readonly EngineDeparture[] {
+	if (
+		!isDeepStrictEqual(
+			bootstrap.steps.map((step) => step.name),
+			veneer.steps.map((step) => step.name),
+		)
+	)
+		throw new Error(`Plugin recordings of ${bootstrap.plugin} differ in step membership`)
+	const departures: EngineDeparture[] = []
+	for (const [index, expected] of bootstrap.steps.entries()) {
+		const actual = veneer.steps[index]
+		if (actual === undefined) continue
+		const row = { plugin: bootstrap.plugin, step: expected.name }
+		const labels = [
+			...Object.keys(expected.state.elements),
+			...Object.keys(actual.state.elements).filter(
+				(label) => !Object.hasOwn(expected.state.elements, label),
+			),
+		]
+		for (const label of labels) {
+			const official = expected.state.elements[label]
+			const own = actual.state.elements[label]
+			if (official === undefined || own === undefined) {
+				departures.push({
+					...row,
+					subject: label,
+					facet: 'element',
+					name: undefined,
+					bootstrap: official !== undefined,
+					veneer: own !== undefined,
+				})
+				continue
+			}
+			for (const token of [...new Set([...official.classes, ...own.classes])].sort()) {
+				if (official.classes.includes(token) !== own.classes.includes(token))
+					departures.push({
+						...row,
+						subject: label,
+						facet: 'class',
+						name: token,
+						bootstrap: official.classes.includes(token),
+						veneer: own.classes.includes(token),
+					})
+			}
+			for (const name of [
+				...new Set([...Object.keys(official.attributes), ...Object.keys(own.attributes)]),
+			].sort()) {
+				if (official.attributes[name] !== own.attributes[name])
+					departures.push({
+						...row,
+						subject: label,
+						facet: 'attribute',
+						name,
+						bootstrap: official.attributes[name],
+						veneer: own.attributes[name],
+					})
+			}
+			if (official.visible !== own.visible)
+				departures.push({
+					...row,
+					subject: label,
+					facet: 'visible',
+					name: undefined,
+					bootstrap: official.visible,
+					veneer: own.visible,
+				})
+		}
+		if (expected.state.focus !== actual.state.focus)
+			departures.push({
+				...row,
+				subject: 'document',
+				facet: 'focus',
+				name: undefined,
+				bootstrap: expected.state.focus,
+				veneer: actual.state.focus,
+			})
+		if (expected.state.locked !== actual.state.locked)
+			departures.push({
+				...row,
+				subject: 'document',
+				facet: 'lock',
+				name: undefined,
+				bootstrap: expected.state.locked,
+				veneer: actual.state.locked,
+			})
+	}
+	return departures
+}
+
+/**
+ * Records one live control and returns the departures its seam adds at its step.
+ * @param control - The control to record.
+ * @param runtime - Veneer's runtime, compiled from source.
+ * @param fixture - Bootstrap's recording of the control's scenario. Default: the saved fixture the
+ * {@link readPluginFixture} helper reads.
+ * @returns The departures from Bootstrap's recording that the control's setup reports at its step
+ * and Veneer's default setup does not.
+ * @throws When no scenario records the control's plugin or no action of it names the control's
+ * step, or when a recording fails.
+ * @remarks
+ * Both Veneer recordings drive the scenario's actions up to and including the control's step, so
+ * a seam that leaves the page unable to take a later action still records, and Bootstrap's
+ * recording is read at the same steps.
+ */
+export async function recordPluginControl(
+	control: PluginControl,
+	runtime: PluginRuntime,
+	fixture: PluginFixture = readPluginFixture(control.plugin),
+): Promise<readonly EngineDeparture[]> {
+	const scenario = PLUGIN_SCENARIOS.find((candidate) => candidate.plugin === control.plugin)
+	if (scenario === undefined) throw new Error(`No plugin scenario records ${control.plugin}`)
+	const index = scenario.actions.findIndex(
+		(action) => `${scenario.plugin}.${action.name}` === control.step,
+	)
+	if (index === -1) throw new Error(`No ${control.plugin} action names the step ${control.step}`)
+	const trimmed = { ...scenario, actions: scenario.actions.slice(0, index + 1) }
+	const baseline = await recordPluginOracle(trimmed, runtime)
+	const seam = await recordPluginOracle(
+		{ ...trimmed, setup: { ...trimmed.setup, veneer: control.setup } },
+		runtime,
+	)
+	const names = new Set(baseline.steps.map((step) => step.name))
+	const official = { ...fixture, steps: fixture.steps.filter((step) => names.has(step.name)) }
+	return filterAddedDepartures(
+		collectEngineDepartures(official, seam),
+		collectEngineDepartures(official, baseline),
+	).filter((departure) => departure.step === control.step)
+}
+
+/**
+ * Filters the departures a baseline does not carry.
+ * @param departures - The departures a control's recording reports.
+ * @param baseline - The departures the default setup's recording reports.
+ * @returns The members of `departures` no member of `baseline` equals, in order.
+ */
+export function filterAddedDepartures(
+	departures: readonly EngineDeparture[],
+	baseline: readonly EngineDeparture[],
+): readonly EngineDeparture[] {
+	return departures.filter(
+		(departure) => !baseline.some((candidate) => isDeepStrictEqual(candidate, departure)),
+	)
+}
