+import type { PopoverInterface, PopoverOptions, TooltipProfile } from './types.js'
+import {
+	POPOVER_ATTRIBUTES,
+	POPOVER_CLASSES,
+	POPOVER_DEFAULTS,
+	POPOVER_EVENTS,
+	POPOVER_SELECTORS,
+} from './constants.js'
+import { Tooltip } from './Tooltip.js'
+import { isPopoverEvent } from './validators.js'
+
+/**
+ * Shows a header-and-body tip built from a template beside its trigger, anchored in the top layer, on a click or a call.
+ *
+ * @remarks
+ * The popover is the tooltip engine under the popover profile, as Bootstrap's `Popover` class
+ * extends its `Tooltip` class: every sequence, door read, and restoration the `Tooltip` class
+ * describes applies, under the `.vn.popover` event names, the `POPOVER_HOST_OWNED` and
+ * `POPOVER_OPTION_INVALID` codes, and `vn-popover-` tip ids. The profile differs from the tooltip's
+ * in its defaults, which the `POPOVER_DEFAULTS` constant holds: a click toggles the tip and hover and
+ * focus do not, the tip is built from the `POPOVER_TEMPLATE` constant, and it sits `right` of its
+ * trigger at offset `[0, 8]`. The `title` option fills the header slot and the `content` option the
+ * body slot, and the attribute the `attributes.content` key names feeds the `content` option; the
+ * popover has content when either slot has, and an empty slot is removed from the tip. The tip is
+ * promoted with the `manual` popover value, so the platform closes it on no Escape key press, outside
+ * click, or other tip opening; the interactions the `trigger` group selects, the calls, and the modal
+ * hide event hide it. The popover keeps its own registry, so a trigger can carry a tooltip and a
+ * popover at once, and `Popover.find` returns the popover. A popover whose `descendants` option is
+ * set constructs a popover for each matching descendant.
+ *
+ * @example
+ * ```ts
+ * const trigger = document.createElement('button')
+ * trigger.type = 'button'
+ * trigger.textContent = 'Details'
+ * trigger.title = 'Draft'
+ * document.body.append(trigger)
+ * const popover = new Popover(trigger, { content: 'Saved at noon' })
+ * await popover.show()
+ * popover.destroy()
+ * ```
+ */
+export class Popover extends Tooltip<PopoverOptions> implements PopoverInterface {
+	/**
+	 * Supplies the popover's name, events and their guard, default vocabulary and options, and `manual` popover value to the tooltip engine.
+	 *
+	 * @example
+	 * ```ts
+	 * const name = Popover.profile.name
+	 * ```
+	 */
+	static override readonly profile: TooltipProfile = Object.freeze({
+		name: 'popover',
+		events: POPOVER_EVENTS,
+		guard: isPopoverEvent,
+		classes: POPOVER_CLASSES,
+		attributes: POPOVER_ATTRIBUTES,
+		selectors: POPOVER_SELECTORS,
+		defaults: POPOVER_DEFAULTS,
+		popover: 'manual',
+	})
+}
