+
+	// A consumer takes the `shown` token off a shown modal's backdrop, so the next hide finds it hidden
+	// and fades nothing, yet removes it from the page. A custom element the backdrop holds adds the
+	// modal's token back inside that removal, so the host takes the hide over. The hide removed the
+	// backdrop's connection and never its token, so its returning step puts the backdrop back in the
+	// page without the token.
+	it('puts back a backdrop the hide removed, adding no token it never removed, when the host takes that hide over', async () => {
+		const name = 'vn-modal-connection-returned'
+		const reactions = new WeakMap<HTMLElement, () => void>()
+		customElements.define(
+			name,
+			class extends HTMLElement {
+				disconnectedCallback() {
+					reactions.get(this)?.()
+				}
+			},
+		)
+		const root = scene.mount('<div class="modal"><div class="modal-dialog"></div></div>')
+		const host = requireValue(root.querySelector<HTMLElement>('.modal'), 'No modal')
+		const modal = new Modal(host, { focus: false })
+		onTestFinished(() => modal.destroy())
+		expect(await modal.show()).toBe(true)
+		const backdrop = requireValue(
+			document.querySelector<HTMLElement>('body > .modal-backdrop'),
+			'No backdrop',
+		)
+		backdrop.classList.remove('show')
+		const child = document.createElement(name)
+		backdrop.append(child)
+		reactions.set(child, () => {
+			reactions.delete(child)
+			host.classList.add('show')
+		})
+		expect(await modal.hide()).toBe(false)
+		expect({
+			shown: modal.shown,
+			display: host.style.display,
+			modal: host.getAttribute('aria-modal'),
+			parent: backdrop.parentElement === document.body,
+			tokens: Array.from(backdrop.classList),
+		}).toEqual({
+			shown: true,
+			display: 'block',
+			modal: 'true',
+			parent: true,
+			tokens: ['modal-backdrop'],
+		})
+	})
+
+	// A consumer takes the `shown` tokens off a shown modal and its backdrop and leaves the backdrop in
+	// the page, so the next show adds the backdrop's token without inserting it. A listener to the show
+	// event adds the modal's token back, and a microtask it queues removes it while the show waits on
+	// the backdrop, so the host takes the show over. The show wrote the backdrop's token and not its
+	// connection, so its returning step removes the token and leaves the backdrop in the page.
+	it('removes only the backdrop token the show added when the host takes that show over', async () => {
+		const root = scene.mount('<div class="modal"><div class="modal-dialog"></div></div>')
+		const host = requireValue(root.querySelector<HTMLElement>('.modal'), 'No modal')
+		const modal = new Modal(host, { focus: false })
+		onTestFinished(() => modal.destroy())
+		expect(await modal.show()).toBe(true)
+		const backdrop = requireValue(
+			document.querySelector<HTMLElement>('body > .modal-backdrop'),
+			'No backdrop',
+		)
+		host.classList.remove('show')
+		backdrop.classList.remove('show')
