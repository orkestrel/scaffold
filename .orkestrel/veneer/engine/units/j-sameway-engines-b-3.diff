+					event.preventDefault()
+				},
+				hidden: (event) => events.handler(event.type),
+			},
+		})
+		onTestFinished(() => popover.destroy())
+		expect(await popover.show()).toBe(true)
+		const tip = requireValue(
+			document.getElementById(host.getAttribute('aria-describedby') ?? ''),
+			'No tip',
+		)
+		tip.addEventListener('beforetoggle', (event) => {
+			if (event.newState === 'open') event.preventDefault()
+		})
+		const closed = waitForEvent<readonly [Event]>(
+			(listener) => tip.addEventListener('toggle', listener, { once: true }),
+			'the platform closes the tip',
