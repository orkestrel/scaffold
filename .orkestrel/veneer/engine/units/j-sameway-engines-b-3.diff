+			open: tip.matches(':popover-open'),
+			connected: tip.isConnected,
+			linked: host.hasAttribute('aria-describedby'),
+		}).toEqual({
+			events: ['hide.vn.popover', 'hide.vn.popover', 'hidden.vn.popover'],
+			shown: false,
+			open: false,
+			connected: false,
+			linked: false,
+		})
+	})
 })
