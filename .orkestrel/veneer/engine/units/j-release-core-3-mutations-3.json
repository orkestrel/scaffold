	{
		"id": "join-ledger-3",
		"line": "Lifetime.join holds the resource in the owning lifetime (successor of join-ledger)",
		"edits": [
			{
				"file": "src/browser/Lifetime.ts",
				"find": "\t\tif (owner !== undefined) {\n\t\t\tif (!owner.hold(resource, (held) => held.destroy())) return\n\t\t\t// The resource's own lifetime ends the owner's holding in its drain, so an owner that builds\n\t\t\t// and ends a child on every change keeps a bounded ledger, and a release error propagates\n\t\t\t// through the drain. Held first, the ending runs last, after every other holding is given\n\t\t\t// back, so an owner destruction nested before it still reaches the resource. A lifetime that\n\t\t\t// has ended runs the ending at once, and the owner keeps nothing.\n\t\t\tlifetime.hold({ owner, resource }, (held) => held.owner.#end(held.resource))\n\t\t} else if (signal.aborted) resource.destroy()",
				"replace": "\t\tif (owner !== undefined && signal.aborted) resource.destroy()\n\t\telse if (signal.aborted) resource.destroy()"
			}
		],
		"tests": [
			"tests/src/browser/Lifetime.test.ts"
		]
	},
