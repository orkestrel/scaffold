index 0000000..7f07e19
--- /dev/null
+++ b/src/browser/Lifetime.ts
@@ -0,0 +1,119 @@
+import type { LifetimeHolding, LifetimeInterface } from './types.js'
+
+/**
+ * Holds what an owner took, each record with the release that gives it back, and gives every holding back on every destruction.
+ *
+ * @remarks
+ * An owner holds a take before the take can run consumer code, and destroys the lifetime where it
+ * ends. The drain gives holdings back newest first, so the record an owner holds first, such as the
+ * snapshot of its host, is given back last. Every call to `destroy` drains, a call a release starts
+ * included, so it returns only after every holding is given back. A class whose options take a
+ * `signal` joins through the static `join` method: a lifetime's signal makes the class one of that
+ * lifetime's holdings, with its `destroy` method as the release, and any other signal destroys the
+ * class when it aborts.
+ *
+ * @example
+ * ```ts
+ * const lifetime = new Lifetime()
+ * const snapshot = new HostSnapshot()
+ * lifetime.hold(snapshot, (held) => held.restore())
+ * snapshot.write({ category: 'attribute', element: host, name: 'aria-expanded' }, 'true')
+ * lifetime.destroy()
+ * ```
+ */
+export class Lifetime implements LifetimeInterface {
+	// The lifetime whose destruction aborts each signal, so a class constructed with that signal can
+	// join the lifetime rather than listen for the abort.
+	static readonly #lifetimes = new WeakMap<AbortSignal, Lifetime>()
+	readonly #controller = new AbortController()
+	// The pending holdings, oldest first. Each entry is its own object, so a release that returns ends
+	// only the entry it ran for, never one a nested call enrolled for the same record since.
+	#holdings: readonly LifetimeHolding[] = []
+
+	constructor() {
+		Lifetime.#lifetimes.set(this.#controller.signal, this)
+	}
+
+	/**
+	 * Joins a class to the lifetime that owns a signal, or to the signal itself when no lifetime owns it.
+	 *
+	 * @param signal - The signal the class's options carry; undefined joins nothing.
+	 * @param resource - The class, whose `destroy` method is the release.
+	 * @param lifetime - The class's own lifetime, whose destruction removes the listener a signal no lifetime owns carries.
+	 * @remarks
+	 * A lifetime's signal makes the class a holding of that lifetime, so every destruction of it, a
+	 * nested one included, destroys the class; when that destruction has begun, the class is destroyed
+	 * inside this call. Any other signal destroys the class when it aborts, and at once when it has
+	 * aborted already. A class destroyed on its own stays held until its owner releases it or is
+	 * destroyed, and that release finds nothing left to give back.
+	 * @example
+	 * ```ts
+	 * const owner = new Lifetime()
+	 * const lifetime = new Lifetime()
+	 * Lifetime.join(owner.signal, lifetime, lifetime)
+	 * owner.destroy() // destroys lifetime as one of its holdings
+	 * ```
+	 */
+	static join(
+		signal: AbortSignal | undefined,
+		resource: Pick<LifetimeInterface, 'destroy'>,
+		lifetime: LifetimeInterface,
+	): void {
+		if (signal === undefined) return
+		const owner = Lifetime.#lifetimes.get(signal)
+		if (owner !== undefined) owner.hold(resource, (held) => held.destroy())
+		else if (signal.aborted) resource.destroy()
+		else {
+			signal.addEventListener('abort', () => resource.destroy(), {
+				once: true,
+				signal: lifetime.signal,
+			})
+		}
+	}
+
+	get signal(): AbortSignal {
+		return this.#controller.signal
+	}
+
+	hold<TRecord extends object>(record: TRecord, release: (record: TRecord) => void): boolean {
+		if (this.#holdings.some((holding) => holding.record === record)) return true
+		const holding = { record, release: release.bind(undefined, record) }
+		this.#holdings = [...this.#holdings, holding]
+		if (!this.#controller.signal.aborted) return true
+		this.#give(holding)
+		return false
+	}
+
+	release(record: object): boolean {
+		const holding = this.#holdings.find((pending) => pending.record === record)
+		if (holding === undefined) return false
+		this.#give(holding)
+		return true
+	}
+
+	destroy(): void {
+		if (!this.#controller.signal.aborted) this.#controller.abort()
+		let failure: { readonly error: unknown } | undefined
+		for (const holding of [...this.#holdings].reverse()) {
+			// A release this drain ran can start a nested destruction that gives later holdings back, so
+			// each one is read again and skipped once it has ended.
+			if (!this.#holdings.includes(holding)) continue
+			try {
+				this.#give(holding)
+			} catch (error) {
+				failure ??= { error }
+			}
+		}
+		if (failure !== undefined) throw failure.error
+	}
+
+	// Runs one holding's release and then ends that entry, whether the release returned or threw. The
+	// entry stays pending while the release runs, so a nested destruction runs it again.
+	#give(holding: LifetimeHolding): void {
+		try {
+			holding.release()
+		} finally {
+			this.#holdings = this.#holdings.filter((pending) => pending !== holding)
+		}
+	}
+}
