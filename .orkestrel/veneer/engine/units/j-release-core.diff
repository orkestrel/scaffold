+		const destroyed = createRecorder<readonly []>()
+		Lifetime.join(owner.signal, { destroy: destroyed.handler }, lifetime)
+		expect(destroyed.count).toBe(0)
+		owner.destroy()
+		expect(destroyed.count).toBe(1)
+		owner.destroy()
+		expect(destroyed.count).toBe(1)
+	})
+
+	it('destroys a resource at once when the lifetime that owns the signal has begun its destruction', () => {
+		const owner = new Lifetime()
+		owner.destroy()
+		const destroyed = createRecorder<readonly []>()
+		Lifetime.join(owner.signal, { destroy: destroyed.handler }, new Lifetime())
+		expect(destroyed.count).toBe(1)
+	})
+
+	it('destroys a joined resource in the drain, in its place among the holdings, never at the abort', () => {
+		const owner = new Lifetime()
+		const steps = createRecorder<readonly [string]>()
+		owner.hold({}, () => steps.handler('oldest'))
+		Lifetime.join(owner.signal, { destroy: () => steps.handler('joined') }, new Lifetime())
+		owner.hold({}, () => steps.handler('newest'))
+		owner.signal.addEventListener('abort', () => steps.handler('aborted'))
+		owner.destroy()
+		expect(steps.calls).toEqual([['aborted'], ['newest'], ['joined'], ['oldest']])
+	})
+
+	it('reaches a joined resource from a destroy nested in a newer release of the owner', () => {
+		const owner = new Lifetime()
+		const steps = createRecorder<readonly [string]>()
+		Lifetime.join(owner.signal, { destroy: () => steps.handler('joined') }, new Lifetime())
+		let nested = false
+		owner.hold({}, () => {
+			if (nested) return
+			nested = true
+			owner.destroy()
+			steps.handler('nested returned')
+		})
+		owner.destroy()
+		expect(steps.calls).toEqual([['joined'], ['nested returned']])
+	})
+
+	it('destroys a resource when a signal no lifetime owns aborts, and at once when it has aborted', () => {
+		const controller = new AbortController()
+		const destroyed = createRecorder<readonly []>()
+		Lifetime.join(controller.signal, { destroy: destroyed.handler }, new Lifetime())
+		expect(destroyed.count).toBe(0)
+		controller.abort()
+		expect(destroyed.count).toBe(1)
+		const aborted = createRecorder<readonly []>()
+		Lifetime.join(AbortSignal.abort(), { destroy: aborted.handler }, new Lifetime())
+		expect(aborted.count).toBe(1)
+	})
+
+	it('removes its listener from a signal no lifetime owns when the resource lifetime is destroyed first', () => {
+		const controller = new AbortController()
+		const lifetime = new Lifetime()
+		const destroyed = createRecorder<readonly []>()
+		Lifetime.join(controller.signal, { destroy: destroyed.handler }, lifetime)
+		lifetime.destroy()
+		controller.abort()
+		expect(destroyed.count).toBe(0)
+	})
+
+	it('joins nothing for an absent signal', () => {
+		const destroyed = createRecorder<readonly []>()
+		Lifetime.join(undefined, { destroy: destroyed.handler }, new Lifetime())
+		expect(destroyed.count).toBe(0)
+	})
+})
