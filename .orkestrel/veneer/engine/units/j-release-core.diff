+import { Lifetime } from '@src/browser'
+import { createRecorder } from '@orkestrel/test'
+import { describe, expect, it } from 'vitest'
+
+describe('Lifetime', () => {
+	it('aborts its signal once, before the first release, and gives every holding back newest first', () => {
+		const lifetime = new Lifetime()
+		const releases = createRecorder<readonly [string, boolean]>()
+		const aborts = createRecorder<readonly []>()
+		lifetime.signal.addEventListener('abort', () => aborts.handler())
+		expect(lifetime.hold({}, () => releases.handler('first', lifetime.signal.aborted))).toBe(true)
+		expect(lifetime.hold({}, () => releases.handler('second', lifetime.signal.aborted))).toBe(true)
+		expect(lifetime.hold({}, () => releases.handler('third', lifetime.signal.aborted))).toBe(true)
+		expect(lifetime.signal.aborted).toBe(false)
+		lifetime.destroy()
+		expect(releases.calls).toEqual([
+			['third', true],
+			['second', true],
+			['first', true],
+		])
+		lifetime.destroy()
+		expect(releases.count).toBe(3)
+		expect(aborts.count).toBe(1)
+	})
+
+	it('passes each release the record it holds', () => {
+		const lifetime = new Lifetime()
+		const record = { id: 'tip' }
+		const releases = createRecorder<readonly [object]>()
+		lifetime.hold(record, releases.handler)
+		lifetime.destroy()
+		expect(releases.calls).toEqual([[record]])
+		expect(releases.calls[0]?.[0]).toBe(record)
+	})
+
+	it('drains on a destroy a release calls, running the running release again, and returns with every holding given back', () => {
+		const lifetime = new Lifetime()
+		const steps = createRecorder<readonly [string]>()
+		let nested = false
+		lifetime.hold({}, () => steps.handler('first'))
+		lifetime.hold({}, () => {
+			steps.handler('second')
+			if (nested) return
+			nested = true
+			lifetime.destroy()
+			steps.handler('nested returned')
+		})
+		lifetime.destroy()
+		expect(steps.calls).toEqual([['second'], ['second'], ['first'], ['nested returned']])
+		lifetime.destroy()
+		expect(steps.count).toBe(4)
+	})
+
+	it('drains on a destroy an abort listener calls before the first release runs', () => {
+		const lifetime = new Lifetime()
+		const steps = createRecorder<readonly [string]>()
+		lifetime.hold({}, () => steps.handler('released'))
+		lifetime.signal.addEventListener('abort', () => {
+			lifetime.destroy()
+			steps.handler('listener returned')
+		})
+		lifetime.destroy()
+		expect(steps.calls).toEqual([['released'], ['listener returned']])
+	})
+
+	it('ends a holding only while the lifetime still holds that same entry', () => {
+		const lifetime = new Lifetime()
+		const record = {}
+		const second = createRecorder<readonly [object]>()
+		const first = createRecorder<readonly [object]>()
+		const nested = createRecorder<readonly [boolean, boolean]>()
+		lifetime.hold(record, () => {
+			first.handler(record)
+			if (first.count > 1) return
+			// The nested release runs this release again and ends the entry, so the record held next is a
+			// new entry the outer release, returning, must leave in place.
+			nested.handler(lifetime.release(record), lifetime.hold(record, second.handler))
+		})
+		expect(lifetime.release(record)).toBe(true)
+		expect(nested.calls).toEqual([[true, true]])
+		expect(first.count).toBe(2)
+		expect(second.count).toBe(0)
+		lifetime.destroy()
+		expect(second.calls).toEqual([[record]])
+	})
+
+	it('runs the release at once and returns false for a record held after destruction began', () => {
+		const lifetime = new Lifetime()
+		lifetime.destroy()
+		const record = {}
+		const releases = createRecorder<readonly [object]>()
+		expect(lifetime.hold(record, releases.handler)).toBe(false)
+		expect(releases.calls).toEqual([[record]])
