+			readTarget(build('button', { attributes: { 'data-bs-target': '#vn-probe-vector' } })),
+		).toBeUndefined()
+	})
+})
+
+describe('readTargets', () => {
+	it('returns every HTML element a selector list names, in document order', () => {
+		const first = mount(build('div', { attributes: { id: 'vn-probe-first' } }))
+		const second = mount(build('div', { attributes: { id: 'vn-probe-second' } }))
+		const svg = mount(document.createElementNS('http://www.w3.org/2000/svg', 'svg'))
+		svg.classList.add('vn-probe-many')
+		first.classList.add('vn-probe-many')
+		second.classList.add('vn-probe-many')
+		onTestFinished(() => first.remove())
+		onTestFinished(() => second.remove())
+		onTestFinished(() => svg.remove())
+		const trigger = build('button', {
+			attributes: { 'data-bs-target': '#vn-probe-second, #vn-probe-first' },
+		})
+		expect(readTargets(trigger)).toEqual([first, second])
+		expect(
+			readTargets(build('button', { attributes: { 'data-bs-target': '.vn-probe-many' } })),
+		).toEqual([first, second])
+		expect(readTargets(build('button'))).toEqual([])
+	})
+})
+
+describe('generateId', () => {
+	it('appends a random suffix to the prefix and returns a different id on each call', () => {
+		const ids = Array.from({ length: 64 }, () => generateId('tooltip'))
+		expect(new Set(ids).size).toBe(64)
+		expect(ids.filter((id) => !/^tooltip-[0-9a-z]{14}$/.test(id))).toEqual([])
+	})
+})
+
+describe('resolveOptions', () => {
+	it('merges the defaults, the config attribute, the declared attributes, and the constructor object in that order', () => {
+		const host = build('div', {
+			attributes: {
+				'data-bs-config': '{"toggle":false,"delay":5,"label":"config","parent":"config"}',
+				'data-bs-delay': '0',
+				'data-bs-label': 'attribute',
+				'data-bs-parent': 'attribute',
+			},
+		})
+		expect(
+			resolveOptions(
+				host,
+				'PROBE_OPTION_INVALID',
+				{ toggle: true, delay: 300, label: 'default', title: 'default' },
+				{ toggle: parseBoolean, delay: parseNumber, label: parseString, title: parseString },
+				{ label: 'constructor' },
+			),
+		).toStrictEqual({ toggle: false, delay: 0, label: 'constructor', title: 'default' })
+	})
+
+	it('ignores a config attribute that is not a JSON record', () => {
+		expect(
+			resolveOptions(
+				build('div', { attributes: { 'data-bs-config': '{toggle' } }),
+				'PROBE_OPTION_INVALID',
+				{ toggle: true },
+				{ toggle: parseBoolean },
+				undefined,
+			),
+		).toStrictEqual({ toggle: true })
+		expect(
+			resolveOptions(
+				build('div', { attributes: { 'data-bs-config': '[false]' } }),
+				'PROBE_OPTION_INVALID',
+				{ toggle: true },
+				{ toggle: parseBoolean },
+				undefined,
+			),
+		).toStrictEqual({ toggle: true })
+	})
+
+	it('throws the entity code for a declared attribute or config key that fails coercion', () => {
+		const attribute = attempt(() =>
+			resolveOptions(
+				build('div', { attributes: { 'data-bs-delay': 'soon' } }),
+				'PROBE_OPTION_INVALID',
+				{ delay: 300 },
+				{ delay: parseNumber },
+				undefined,
+			),
+		)
+		expect(attribute).toEqual({ success: false, error: expect.toSatisfy(isAppError) })
+		expect(attribute).toMatchObject({
+			error: { code: 'PROBE_OPTION_INVALID', context: { attribute: 'data-bs-delay', tag: 'DIV' } },
+		})
+		const config = attempt(() =>
+			resolveOptions(
+				build('div', { attributes: { 'data-bs-config': '{"delay":"soon"}' } }),
+				'PROBE_OPTION_INVALID',
+				{ delay: 300 },
+				{ delay: parseNumber },
+				undefined,
+			),
+		)
+		expect(config).toEqual({ success: false, error: expect.toSatisfy(isAppError) })
+		expect(config).toMatchObject({
+			error: { code: 'PROBE_OPTION_INVALID', context: { attribute: 'data-bs-config', tag: 'DIV' } },
+		})
+	})
+})
