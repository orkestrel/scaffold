+import { Snapshot } from '@src/browser'
+import { build } from '@orkestrel/test/browser'
+import { describe, expect, it } from 'vitest'
+
+describe('Snapshot', () => {
+	it('writes back a present attribute and removes an absent one', () => {
+		const host = build('button', { attributes: { 'aria-expanded': 'false' } })
+		const snapshot = new Snapshot()
+		snapshot.save({ category: 'attribute', element: host, name: 'aria-expanded' })
+		snapshot.save({ category: 'attribute', element: host, name: 'aria-controls' })
+		host.setAttribute('aria-expanded', 'true')
+		host.setAttribute('aria-controls', 'panel')
+		snapshot.restore()
+		expect(host.getAttribute('aria-expanded')).toBe('false')
+		expect(host.hasAttribute('aria-controls')).toBe(false)
+	})
+
+	it('restores an empty attribute distinctly from an absent one', () => {
+		const host = build('div', { attributes: { hidden: '' } })
+		const snapshot = new Snapshot()
+		snapshot.save({ category: 'attribute', element: host, name: 'hidden' })
+		host.removeAttribute('hidden')
+		snapshot.restore()
+		expect(host.getAttribute('hidden')).toBe('')
+	})
+
+	it('restores class token membership and keeps every token the snapshot never recorded', () => {
+		const host = build('div', { classes: 'collapse show' })
+		const snapshot = new Snapshot()
+		snapshot.save({ category: 'token', element: host, name: 'show' })
+		snapshot.save({ category: 'token', element: host, name: 'collapsing' })
+		host.classList.remove('show')
+		host.classList.add('collapsing', 'consumer')
+		snapshot.restore()
+		expect(Array.from(host.classList)).toEqual(['collapse', 'consumer', 'show'])
+	})
+
+	it('removes the class attribute it found absent when restoring leaves the list empty', () => {
+		const bare = build('div')
+		const edited = build('div')
+		const empty = build('div', { attributes: { class: '' } })
+		const snapshot = new Snapshot()
+		for (const element of [bare, edited, empty]) {
+			snapshot.save({ category: 'token', element, name: 'show' })
+			element.classList.add('show')
+		}
+		edited.classList.add('consumer')
+		snapshot.restore()
+		expect(bare.hasAttribute('class')).toBe(false)
+		expect(edited.getAttribute('class')).toBe('consumer')
+		expect(empty.getAttribute('class')).toBe('')
+	})
+
+	it('restores an inline property with its priority and removes one it found absent', () => {
+		const host = build('div')
+		host.style.setProperty('height', '10px', 'important')
+		const snapshot = new Snapshot()
+		snapshot.save({ category: 'property', element: host, name: 'height' })
+		snapshot.save({ category: 'property', element: host, name: 'anchor-name' })
+		host.style.setProperty('height', '40px')
+		host.style.setProperty('anchor-name', '--vn-probe')
+		host.style.setProperty('width', '20px')
+		snapshot.restore()
+		expect(host.style.getPropertyValue('height')).toBe('10px')
+		expect(host.style.getPropertyPriority('height')).toBe('important')
+		expect(host.style.getPropertyValue('anchor-name')).toBe('')
+		expect(host.style.getPropertyValue('width')).toBe('20px')
+	})
+
+	it('keeps the first recording of a target saved twice', () => {
+		const host = build('button', { attributes: { 'aria-pressed': 'mixed' } })
+		const snapshot = new Snapshot()
+		snapshot.save({ category: 'attribute', element: host, name: 'aria-pressed' })
+		host.setAttribute('aria-pressed', 'true')
+		snapshot.save({ category: 'attribute', element: host, name: 'aria-pressed' })
+		host.setAttribute('aria-pressed', 'false')
+		snapshot.restore()
+		expect(host.getAttribute('aria-pressed')).toBe('mixed')
+	})
+
+	it('forgets its records on restore, so a later restore keeps every edit', () => {
+		const host = build('button', { attributes: { 'aria-pressed': 'mixed' } })
+		const snapshot = new Snapshot()
+		snapshot.save({ category: 'attribute', element: host, name: 'aria-pressed' })
+		snapshot.restore()
+		host.setAttribute('aria-pressed', 'true')
+		snapshot.restore()
+		expect(host.getAttribute('aria-pressed')).toBe('true')
+	})
+})
