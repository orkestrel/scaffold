diff --git a/src/browser/Registry.ts b/src/browser/Registry.ts
new file mode 100644
index 0000000..39af400
--- /dev/null
+++ b/src/browser/Registry.ts
@@ -0,0 +1,47 @@
+import type { RegistryInterface, RegistryOptions } from './types.js'
+import { AppError } from '@src/core'
+
+/**
+ * Records which engine owns each host, keyed weakly so a discarded host leaves no record behind.
+ *
+ * @typeParam TEngine - The engine the record holds.
+ * @remarks
+ * Each engine class keeps one registry, so one host can carry one engine of each class. The class
+ * claims the host after validating it and before binding any hook, and releases it on destruction.
+ *
+ * @example
+ * ```ts
+ * const registry = new Registry<object>({ code: 'COLLAPSE_HOST_OWNED' })
+ * const engine = {}
+ * registry.claim(host, engine)
+ * registry.release(host, engine)
+ * ```
+ */
+export class Registry<TEngine extends object> implements RegistryInterface<TEngine> {
+	readonly #code: string
+	readonly #owners = new WeakMap<HTMLElement, TEngine>()
+
+	/**
+	 * Keeps the error code a second claim throws.
+	 *
+	 * @param options - The code a claim on an owned host throws.
+	 */
+	constructor(options: RegistryOptions) {
+		this.#code = options.code
+	}
+
+	claim(host: HTMLElement, engine: TEngine): void {
+		if (this.#owners.has(host)) {
+			throw new AppError('Host already has a live owner', this.#code, { tag: host.tagName })
+		}
+		this.#owners.set(host, engine)
+	}
+
+	find(host: HTMLElement): TEngine | undefined {
+		return this.#owners.get(host)
+	}
+
+	release(host: HTMLElement, engine: TEngine): boolean {
+		return this.#owners.get(host) === engine && this.#owners.delete(host)
+	}
+}
