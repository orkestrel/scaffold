+import type { SnapshotInterface, SnapshotTarget } from './types.js'
+
+/**
+ * Records host state before an engine first writes it, and writes that state back on restore.
+ *
+ * @remarks
+ * A recording holds an attribute's value, whether a class token is present, or an inline property's
+ * value and priority, and treats absence as a value of its own. The first token recorded on an
+ * element also records whether the element carried a `class` attribute, so restoring removes an
+ * attribute the engine's writes created when no token remains in it.
+ *
+ * @example
+ * ```ts
+ * const snapshot = new Snapshot()
+ * snapshot.save({ category: 'attribute', element: host, name: 'aria-expanded' })
+ * host.setAttribute('aria-expanded', 'true')
+ * snapshot.restore()
+ * ```
+ */
+export class Snapshot implements SnapshotInterface {
+	#records: ReadonlyArray<{
+		readonly target: SnapshotTarget
+		readonly value: string | undefined
+		readonly priority: string
+	}> = []
+	#classes: ReadonlyMap<HTMLElement, boolean> = new Map()
+
+	save(target: SnapshotTarget): void {
+		const { category, element, name } = target
+		const recorded = this.#records.some(
+			(record) =>
+				record.target.category === category &&
+				record.target.element === element &&
+				record.target.name === name,
+		)
+		if (recorded) return
+		let value: string | undefined
+		let priority = ''
+		switch (category) {
+			case 'attribute':
+				value = element.getAttribute(name) ?? undefined
+				break
+			case 'token':
+				value = element.classList.contains(name) ? name : undefined
+				if (!this.#classes.has(element)) {
