--- /dev/null
+++ b/tests/src/browser/Registry.test.ts
@@ -0,0 +1,62 @@
+import { Registry } from '@src/browser'
+import { isAppError } from '@src/core'
+import { attempt } from '@orkestrel/contract'
+import { build } from '@orkestrel/test/browser'
+import { describe, expect, it } from 'vitest'
+
+describe('Registry', () => {
+	it('records the claiming engine and finds it by host', () => {
+		const registry = new Registry<object>({ code: 'PROBE_HOST_OWNED' })
+		const host = build('div')
+		const other = build('div')
+		const engine = {}
+		expect(registry.find(host)).toBeUndefined()
+		registry.claim(host, engine)
+		expect(registry.find(host)).toBe(engine)
+		expect(registry.find(other)).toBeUndefined()
+	})
+
+	it('refuses a second claim with the configured code and keeps the first owner', () => {
+		const registry = new Registry<object>({ code: 'PROBE_HOST_OWNED' })
+		const host = build('section')
+		const owner = {}
+		registry.claim(host, owner)
+		const refused = attempt(() => registry.claim(host, {}))
+		expect(refused).toEqual({ success: false, error: expect.toSatisfy(isAppError) })
+		expect(refused).toMatchObject({
+			error: { code: 'PROBE_HOST_OWNED', context: { tag: 'SECTION' } },
+		})
+		expect(attempt(() => registry.claim(host, owner))).toMatchObject({
+			success: false,
+			error: { code: 'PROBE_HOST_OWNED' },
+		})
+		expect(registry.find(host)).toBe(owner)
+	})
+
+	it('releases only for the engine that holds the claim, then admits a new claim', () => {
+		const registry = new Registry<object>({ code: 'PROBE_HOST_OWNED' })
+		const host = build('div')
+		const owner = {}
+		const stranger = {}
+		expect(registry.release(host, owner)).toBe(false)
+		registry.claim(host, owner)
+		expect(registry.release(host, stranger)).toBe(false)
+		expect(registry.find(host)).toBe(owner)
+		expect(registry.release(host, owner)).toBe(true)
+		expect(registry.release(host, owner)).toBe(false)
+		expect(registry.find(host)).toBeUndefined()
+		registry.claim(host, stranger)
+		expect(registry.find(host)).toBe(stranger)
+	})
+
+	it('keeps one record per registry, so separate registries claim one host independently', () => {
+		const first = new Registry<object>({ code: 'FIRST_HOST_OWNED' })
+		const second = new Registry<object>({ code: 'SECOND_HOST_OWNED' })
+		const host = build('div')
+		const engine = {}
+		first.claim(host, engine)
+		second.claim(host, engine)
+		expect(first.release(host, engine)).toBe(true)
+		expect(second.find(host)).toBe(engine)
+	})
+})
