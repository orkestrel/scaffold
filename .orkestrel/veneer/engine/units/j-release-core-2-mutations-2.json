	{
		"id": "join-ledger",
		"line": "Lifetime.join holds the resource in the owning lifetime",
		"edits": [
			{
				"file": "src/browser/Lifetime.ts",
				"find": "\t\tif (owner !== undefined) {\n\t\t\tif (!owner.hold(resource, (held) => held.destroy())) return\n\t\t\t// The resource's own destruction ends the owner's holding, so an owner that builds and ends\n\t\t\t// a child on every change keeps a bounded ledger. The release runs the resource's `destroy`\n\t\t\t// again, nested in that destruction, and it returns with the holding ended.\n\t\t\tlifetime.signal.addEventListener('abort', () => owner.release(resource), { once: true })\n\t\t} else if (signal.aborted) resource.destroy()",
				"replace": "\t\tif (owner !== undefined && signal.aborted) resource.destroy()\n\t\telse if (signal.aborted) resource.destroy()"
			}
		],
		"tests": ["tests/src/browser/Lifetime.test.ts"]
	},
