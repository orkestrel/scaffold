+
+/**
+ * Checks whether a DOM event is a toast event, which carries no payload.
+ *
+ * @param value - The value to inspect.
+ * @returns True if the value is a CustomEvent whose detail is null; false otherwise.
+ * @remarks
+ * A toast dispatches each event with no detail, and the platform reads an absent `detail` as
+ * `null`, which is the `CustomEvent<null>` type every key of the toast event map carries, so a
+ * consumer's own event under a toast wire name that carries a payload is refused. The class half
+ * reads through the `isInstance` function `@orkestrel/contract` publishes, which contains a hostile
+ * prototype's throw, and the containment here covers a `detail` accessor that throws.
+ * @example
+ * ```ts
+ * isToastEvent(new CustomEvent('hidden.vn.toast')) // true
+ * isToastEvent(new CustomEvent('hidden.vn.toast', { detail: { shown: false } })) // false
+ * ```
+ */
+export function isToastEvent(value: unknown): value is ToastEventMap['show'] {
+	try {
+		return isInstance(value, CustomEvent) && value.detail === null
+	} catch {
+		return false
+	}
+}
