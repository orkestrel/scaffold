+		if (lifetime?.aborted) this.destroy()
+		else lifetime?.addEventListener('abort', () => this.destroy(), { once: true, signal })
+	}
+
+	/**
+	 * Returns the live toast that owns a host, mirroring Bootstrap's `getInstance`.
+	 *
+	 * @param host - The toast to look up.
+	 * @returns The owning toast, or undefined when no live toast owns the host.
+	 * @example
+	 * ```ts
+	 * await Toast.find(host)?.hide()
+	 * ```
+	 */
+	static find(host: HTMLElement): ToastInterface | undefined {
+		return Toast.#registry.find(host)
+	}
+
+	get host(): HTMLElement {
+		return this.#host
+	}
+
+	get shown(): boolean {
+		return this.#host.classList.contains(this.#classes.shown)
+	}
+
+	async show(): Promise<boolean> {
+		if (this.#refused()) return false
+		// The identity is taken before the dispatch, so a call a listener makes inside it, still
+		// waiting or already completed, takes the change over.
+		const change = {}
+		this.#change = change
+		if (!emitEvent(this.#host, TOAST_EVENTS.show, null, true)) return false
+		// A listener runs inside the dispatch and can destroy this toast or start another call, so the
+		// refusal and the identity are read again before any write.
+		if (this.#refused() || this.#change !== change) return false
+		this.#disarm()
+		const host = this.#host
+		const { shown, transition, fade } = this.#classes
+		this.#save()
+		// Each write door reads the host for its phase: no transition token and the shown token as the
+		// call found it before the transition token is written, the shown and transition tokens while
+		// the transition runs, and the shown token without the transition token at completion.
+		const before = host.classList.contains(shown) ? [shown] : []
+		const absent = before.length > 0 ? [transition] : [shown, transition]
+		if (this.#animated && !this.#apply(change, before, absent, () => host.classList.add(fade))) {
+			return false
+		}
+		reflow(host)
+		if (
+			!this.#apply(change, [shown, transition], [], () => host.classList.add(shown, transition))
+		) {
+			return false
+		}
+		if (this.#animated) {
+			await settleAnimations(host, this.#controller.signal)
+			if (!this.#holds(change, [shown, transition], [])) return false
+		}
+		if (!this.#apply(change, [shown], [transition], () => host.classList.remove(transition))) {
+			return false
+		}
+		this.#change = undefined
+		emitEvent(host, TOAST_EVENTS.shown, null, false)
+		if (!host.matches(':hover') && !host.matches(':focus-within')) this.#arm()
+		return !this.#controller.signal.aborted
+	}
+
+	async hide(): Promise<boolean> {
+		if (this.#refused() || !this.shown) return false
+		const change = {}
+		this.#change = change
+		if (!emitEvent(this.#host, TOAST_EVENTS.hide, null, true)) return false
+		if (this.#refused() || !this.shown || this.#change !== change) return false
+		this.#disarm()
+		const host = this.#host
+		const { shown, transition } = this.#classes
+		this.#save()
+		// Each write door reads the host for its phase: the shown and transition tokens while the
+		// transition runs, and neither at completion. The layout read lets a toast inserted shown in
+		// this task fade out.
+		reflow(host)
+		if (!this.#apply(change, [shown, transition], [], () => host.classList.add(transition))) {
+			return false
+		}
+		if (this.#animated) {
+			await settleAnimations(host, this.#controller.signal)
+			if (!this.#holds(change, [shown, transition], [])) return false
+		}
+		if (
+			!this.#apply(change, [], [shown, transition], () => host.classList.remove(transition, shown))
+		) {
+			return false
+		}
+		this.#change = undefined
+		emitEvent(host, TOAST_EVENTS.hidden, null, false)
+		return !this.#controller.signal.aborted
+	}
+
+	destroy(): void {
+		if (this.#controller.signal.aborted) return
+		this.#controller.abort()
+		this.#disarm()
+		// The claim goes before the host is restored, so an engine constructed while restoration runs
+		// can claim the host, and its snapshot takes the values this one has still to write back.
+		Toast.#registry.release(this.#host, this)
+		this.#snapshot.restore()
+	}
+
+	// Reports whether a call cannot start: the toast is destroyed or the host transitions.
+	#refused(): boolean {
+		return (
+			this.#controller.signal.aborted || this.#host.classList.contains(this.#classes.transition)
+		)
+	}
+
+	// Reports whether the call still holds its change: the toast is live, no later call started a
+	// change, and the host carries every token in `present` and none in `absent`.
+	#holds(change: object, present: readonly string[], absent: readonly string[]): boolean {
+		const tokens = this.#host.classList
+		return (
+			!this.#controller.signal.aborted &&
+			this.#change === change &&
+			present.every((token) => tokens.contains(token)) &&
+			!absent.some((token) => tokens.contains(token))
+		)
+	}
+
+	// Runs one write a reaction can run inside, then reads whether the call still holds its change.
+	#apply(
+		change: object,
+		present: readonly string[],
+		absent: readonly string[],
+		write: () => void,
+	): boolean {
+		write()
+		return this.#holds(change, present, absent)
+	}
+
+	// Records the host's shown, transition, and fade tokens before the first write, so destruction
+	// restores them.
+	#save(): void {
+		const { shown, transition, fade } = this.#classes
+		for (const name of [shown, transition, fade]) {
+			this.#snapshot.save({ category: 'token', element: this.#host, name })
+		}
+	}
+
+	// Starts the delay in full for a live, shown, settled toast with `autohide`, replacing a pending one.
+	#arm(): void {
+		this.#disarm()
+		if (!this.#autohide || this.#controller.signal.aborted) return
+		const tokens = this.#host.classList
+		if (!tokens.contains(this.#classes.shown) || tokens.contains(this.#classes.transition)) return
+		this.#timer = setTimeout(() => {
+			this.#timer = undefined
+			void this.hide()
+		}, this.#delay)
+	}
+
+	// Clears the pending delay.
+	#disarm(): void {
+		clearTimeout(this.#timer)
+		this.#timer = undefined
+	}
+
+	// Starts the delay when the pointer or focus leaves the host for an element outside it, unless the
+	// other input still holds it, which the `held` pseudo-class reads.
+	#leave(related: EventTarget | null, held: string): void {
+		if (isInstance(related, Node) && this.#host.contains(related)) return
+		if (this.#host.matches(held)) return
+		this.#arm()
+	}
+}
