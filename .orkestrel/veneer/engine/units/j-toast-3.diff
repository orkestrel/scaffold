+import type { ToastClassMap, ToastInterface, ToastOptions } from './types.js'
+import { AppError } from '@src/core'
+import { isInstance, parseBoolean, parseNumber } from '@orkestrel/contract'
+import {
+	TOAST_ATTRIBUTES,
+	TOAST_CLASSES,
+	TOAST_DEFAULTS,
+	TOAST_EVENTS,
+	TOAST_SELECTORS,
+} from './constants.js'
+import {
+	bindEventMap,
+	emitEvent,
+	readTag,
+	reflow,
+	resolveOptions,
+	resolveVocabulary,
+	settleAnimations,
+} from './helpers.js'
+import { HostSnapshot } from './HostSnapshot.js'
+import { Registry } from './Registry.js'
+import { isAttributeName, isClassToken, isSelector, isToastEvent } from './validators.js'
+
+/**
+ * Shows and hides a toast in its container's flow, and hides it after a delay unless the pointer or focus holds it.
+ *
+ * @remarks
+ * The host must be an HTMLElement in the current realm and have no live toast owner. Construction
+ * writes nothing: it validates and copies the `classes`, `attributes`, and `selectors` groups,
+ * resolves the `animated`, `autohide`, and `delay` options from the defaults, the attributes the
+ * `attributes` group names, and the constructor, claims the host, binds the hooks, and listens for
+ * the pointer and focus entering and leaving the host. Showing writes the `fade` token when
+ * `animated` is `true`, then the `shown` and `transition` tokens, waits for the host's transitions
+ * to settle when `animated` is `true`, removes the `transition` token, and dispatches the `shown`
+ * event; hiding writes the `transition` token, waits the same way, and removes the `transition` and
+ * `shown` tokens. Showing a shown toast runs the sequence again and restarts the delay. With
+ * `autohide`, a shown toast hides itself through a native timer `delay` milliseconds after it
+ * shows; the timer is cleared while the pointer or focus is inside the host and started again in
+ * full when both have left. A call takes its identity before it dispatches its pre-change event,
+ * so a call a listener makes inside that dispatch takes the change over, whether it is still
+ * waiting or has completed. After each write, dispatch, and await, a call reads its lifetime and
+ * the host again: the `fade` write must leave the `shown` token as the call found it, from the
+ * write of the `transition` token until its removal the host must carry that token and the
+ * `shown` token, and at completion the host must carry the state the call completes to. A call
+ * that finds the toast destroyed, a later call started, or the host otherwise stops, writing and
+ * dispatching nothing more, and resolves `false`. Destruction clears the timer and restores the
+ * host. An aborted `signal` destroys the toast.
+ *
+ * @example
+ * ```ts
+ * const host = document.createElement('div')
+ * host.className = 'toast'
+ * const toast = new Toast(host, { delay: 3000 })
+ * await toast.show()
+ * toast.destroy()
+ * ```
+ */
+export class Toast implements ToastInterface {
+	static readonly #registry = new Registry<Toast>({ code: 'TOAST_HOST_OWNED' })
+	readonly #host: HTMLElement
+	readonly #classes: ToastClassMap
+	readonly #animated: boolean
+	readonly #autohide: boolean
+	readonly #delay: number
+	readonly #snapshot = new HostSnapshot()
+	readonly #controller = new AbortController()
+	// The identity of the latest call that started a change. A call holds its change only while this
+	// is its identity, so a call resuming after a later one started sees that it no longer holds it.
+	#change: object | undefined
+	#timer: ReturnType<typeof setTimeout> | undefined
+
+	/**
+	 * Claims the host, resolves its vocabulary and options, and binds initial hooks and the pointer and focus listeners.
+	 *
+	 * @param host - The HTML element to own, the toast.
+	 * @param options - The fade, automatic hiding, delay, markup vocabulary, initial event subscriptions, and lifetime.
+	 * @throws Thrown when the host is not an HTMLElement, when a group value is not a class token, an attribute name, or a selector, when a declared attribute the constructor leaves undefined fails coercion, or when the host already has a live owner.
+	 */
+	constructor(host: HTMLElement, options?: ToastOptions) {
+		if (!isInstance(host, HTMLElement)) {
+			throw new AppError('Toast requires an HTMLElement host', 'TOAST_HOST_INVALID', {
+				tag: readTag(host),
+			})
+		}
+		this.#classes = resolveVocabulary(
+			'TOAST_OPTION_INVALID',
+			TOAST_CLASSES,
+			isClassToken,
+			options?.classes,
+		)
+		const attributes = resolveVocabulary(
+			'TOAST_OPTION_INVALID',
+			TOAST_ATTRIBUTES,
+			isAttributeName,
+			options?.attributes,
+		)
+		// The delegate routes by the selector and the toast itself matches with none, so the resolved
+		// group is not kept; resolving it still refuses an invalid value at construction.
+		resolveVocabulary('TOAST_OPTION_INVALID', TOAST_SELECTORS, isSelector, options?.selectors)
+		const resolved = resolveOptions<typeof TOAST_DEFAULTS, 'animated' | 'autohide' | 'delay'>(
+			host,
+			attributes,
+			'TOAST_OPTION_INVALID',
+			TOAST_DEFAULTS,
+			{ animated: parseBoolean, autohide: parseBoolean, delay: parseNumber },
+			options,
+		)
+		this.#animated = resolved.animated
+		this.#autohide = resolved.autohide
+		this.#delay = resolved.delay
+		Toast.#registry.claim(host, this)
+		this.#host = host
+		const signal = this.#controller.signal
+		bindEventMap(host, TOAST_EVENTS, isToastEvent, options?.on, signal)
+		host.addEventListener('mouseover', () => this.#disarm(), { signal })
+		host.addEventListener('focusin', () => this.#disarm(), { signal })
+		host.addEventListener(
+			'mouseout',
+			(event) => this.#leave(event.relatedTarget, ':focus-within'),
+			{ signal },
+		)
+		host.addEventListener('focusout', (event) => this.#leave(event.relatedTarget, ':hover'), {
+			signal,
+		})
