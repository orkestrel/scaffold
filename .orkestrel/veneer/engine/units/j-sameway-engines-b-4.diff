diff --git a/tests/src/browser/Tooltip.test.ts b/tests/src/browser/Tooltip.test.ts
index 1e629f4..15d37e5 100644
--- a/tests/src/browser/Tooltip.test.ts
+++ b/tests/src/browser/Tooltip.test.ts
@@ -3319,4 +3319,96 @@ describe('Tooltip', () => {
 		expect(host.getAttribute('aria-describedby')).toBe('help')
 		expect(Tooltip.find(host)).toBeUndefined()
 	})
+
+	// The trigger's `aria-describedby` list already names the id the tooltip's next tip takes, which a
+	// throwaway tip read first, and no element carries that id. The show links that id, which changes no
+	// membership, and an observer takes the tip's `shown` token during the fade in, which takes the show
+	// over. The call never added the token, so the returning step leaves it in the list.
+	it('keeps an aria-describedby token the stopped show found there when its tip takes that id', async () => {
+		scene.load(tokensCascade)
+		scene.load(fadeCascade)
+		scene.load(tooltipCascade)
+		const root = scene.mount(
+			'<button type="button" id="probe" title="Probe">Probe</button><button type="button" id="trigger" title="Saves">Save</button>',
+		)
+		const probe = requireValue(root.querySelector<HTMLElement>('#probe'), 'No probe')
+		const host = requireValue(root.querySelector<HTMLElement>('#trigger'), 'No trigger')
+		const reader = new Tooltip(probe, {
+			animated: false,
+			trigger: { hover: false, focus: false, click: false },
+		})
+		onTestFinished(() => reader.destroy())
+		expect(await reader.show()).toBe(true)
+		const read = Number((probe.getAttribute('aria-describedby') ?? '').replace('vn-tooltip-', ''))
+		reader.destroy()
+		const next = `vn-tooltip-${read + 1}`
+		host.setAttribute('aria-describedby', next)
+		const observer = new MutationObserver((records) => {
+			const tip = records[0]?.target
+			if (!(tip instanceof HTMLElement)) return
+			observer.disconnect()
+			tip.classList.remove('show')
+		})
+		onTestFinished(() => observer.disconnect())
+		const tips = createRecorder<readonly [string]>()
+		const tooltip = new Tooltip(host, {
+			trigger: { hover: false, focus: false, click: false },
+			on: {
+				inserted: () => {
+					const tip = requireValue(document.getElementById(next), 'No inserted tip')
+					tips.handler(tip.id)
+					observer.observe(tip, { attributeFilter: ['class'] })
+				},
+			},
+		})
+		onTestFinished(() => tooltip.destroy())
+		expect(await tooltip.show()).toBe(false)
+		expect({
+			tips: tips.calls.flat(),
+			described: host.getAttribute('aria-describedby'),
+			removed: document.getElementById(next) === null,
+		}).toEqual({ tips: [next], described: next, removed: true })
+		// A placement built and destroyed in the frame the next case places a tip in makes Chromium report
+		// a ResizeObserver loop, so the case ends a frame later.
+		await waitForFrame()
+	})
+
+	// An observer takes the tip's `shown` token during the fade in, which takes the show over, and
+	// changes the tip's `id` first. The call records the id it linked, so the returning step takes that
+	// id out and removes the attribute the call added, whatever id the tip carries by then.
+	it('takes out the id it linked when the tip id changes before the host takes the show over', async () => {
+		scene.load(tokensCascade)
+		scene.load(fadeCascade)
+		scene.load(tooltipCascade)
+		const root = scene.mount('<button type="button" id="trigger" title="Saves">Save</button>')
+		const host = requireValue(root.querySelector<HTMLElement>('#trigger'), 'No trigger')
+		const linked = createRecorder<readonly [string]>()
+		const observer = new MutationObserver((records) => {
+			const tip = records[0]?.target
+			if (!(tip instanceof HTMLElement)) return
+			observer.disconnect()
+			tip.id = 'replacement'
+			tip.classList.remove('show')
+		})
+		onTestFinished(() => observer.disconnect())
+		const tooltip = new Tooltip(host, {
+			trigger: { hover: false, focus: false, click: false },
+			on: {
+				inserted: () => {
+					const id = host.getAttribute('aria-describedby') ?? ''
+					linked.handler(id)
+					observer.observe(requireValue(document.getElementById(id), 'No inserted tip'), {
+						attributeFilter: ['class'],
+					})
+				},
+			},
+		})
+		onTestFinished(() => tooltip.destroy())
+		expect(await tooltip.show()).toBe(false)
+		expect({
+			linked: linked.count,
+			described: host.getAttribute('aria-describedby'),
+			removed: document.getElementById('replacement') === null,
+		}).toEqual({ linked: 1, described: null, removed: true })
+	})
 })
