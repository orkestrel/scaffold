@@ -0,0 +1,32 @@
+import { instanceOf } from '@orkestrel/contract'
+
+/**
+ * Parses a selector, or an element, to the HTML element it names in the document.
+ *
+ * @param value - The value to parse: a selector string, or an HTML element returned unchanged.
+ * @returns The first HTML element, in document order, among the elements the selector matches in
+ *   the global document, or the element itself; undefined when the value is neither a string nor an
+ *   HTML element, when the selector is not valid CSS, or when it matches no HTML element.
+ * @remarks
+ * This is the coercion Bootstrap's `getElement` performs for the `parent` option, which a collapse
+ * reads from its `data-bs-parent` attribute. The selector is resolved in the global `document`, as
+ * Bootstrap resolves it. Unlike `getElement`, this reader passes over a match that is not an HTML
+ * element, such as an SVG element, for the next match rather than returning it. It uses the
+ * selector as written, where `getElement` escapes an id selector through Bootstrap's
+ * `parseSelector` function first, so an id carrying a character such as `.` must be escaped by the
+ * caller. Where the selector as written is invalid, this reader returns undefined; `getElement`
+ * returns null for an empty string and throws for any other selector its escaping leaves invalid.
+ * @example
+ * ```ts
+ * const accordion = parseElement('#accordion')
+ * ```
+ */
+export function parseElement(value: unknown): HTMLElement | undefined {
+	if (instanceOf(HTMLElement)(value)) return value
+	if (typeof value !== 'string') return undefined
+	try {
+		return Array.from(document.querySelectorAll(value)).find(instanceOf(HTMLElement))
+	} catch {
+		return undefined
+	}
+}
