+
+describe('isCollapseEvent', () => {
+	it('requires a custom event whose detail the platform reads as absent', () => {
+		expect(isCollapseEvent(new CustomEvent('shown.vn.collapse'))).toBe(true)
+		expect(isCollapseEvent(new CustomEvent('show.vn.collapse', { detail: undefined }))).toBe(true)
+		expect(isCollapseEvent(new CustomEvent('hide.vn.collapse', { detail: null }))).toBe(true)
+		expect(isCollapseEvent(new CustomEvent('shown.vn.collapse', { detail: { shown: true } }))).toBe(
+			false,
+		)
+		expect(isCollapseEvent(new CustomEvent('shown.vn.collapse', { detail: 0 }))).toBe(false)
+		expect(isCollapseEvent(new Event('shown.vn.collapse'))).toBe(false)
+		expect(isCollapseEvent(undefined)).toBe(false)
+		expect(isCollapseEvent(null)).toBe(false)
+	})
+
+	it('returns false when a prototype or detail accessor throws', () => {
+		expect(
+			isCollapseEvent(
+				new Proxy(
+					{},
+					{
+						getPrototypeOf() {
+							throw new Error('Unreadable')
+						},
+					},
+				),
+			),
+		).toBe(false)
+		const event = new CustomEvent('shown.vn.collapse')
+		Object.defineProperty(event, 'detail', {
+			get() {
+				throw new Error('Unreadable')
+			},
+		})
+		expect(isCollapseEvent(event)).toBe(false)
+	})
+})
