+import type {
+	CollapseAttributeMap,
+	CollapseClassMap,
+	CollapseInterface,
+	CollapseOptions,
+	CollapseSelectorMap,
+} from './types.js'
+import { AppError } from '@src/core'
+import { instanceOf } from '@orkestrel/contract'
+import {
+	COLLAPSE_ATTRIBUTES,
+	COLLAPSE_CLASSES,
+	COLLAPSE_EVENTS,
+	COLLAPSE_SELECTORS,
+} from './constants.js'
+import {
+	bindEventMap,
+	emitEvent,
+	readTag,
+	readTargets,
+	reflow,
+	resolveOptions,
+	resolveVocabulary,
+	settleAnimations,
+} from './helpers.js'
+import { HostSnapshot } from './HostSnapshot.js'
+import { parseElement } from './parsers.js'
+import { Registry } from './Registry.js'
+import { isAttributeName, isClassToken, isCollapseEvent, isSelector } from './validators.js'
+
+/**
+ * Shows and hides a panel through its size transition, keeping its triggers' expanded state in step.
+ *
+ * @remarks
+ * The host must be an HTMLElement in the current realm and have no live collapse owner.
+ * Construction writes nothing: it validates and copies the `classes`, `attributes`, and
+ * `selectors` groups, resolves the `parent` option from the constructor or from the attribute
+ * `attributes.parent` names, claims the host, and binds the hooks. A trigger is any element the
+ * `trigger` selector matches in the host's document whose target attribute or `href` fragment names
+ * the host, read at each change. Showing writes the `transition` token and an inline size, sets
+ * every trigger's `aria-expanded` to `true` without its `collapsed` token, waits for the transition
+ * to settle, and then writes the `host` and `shown` tokens and clears the size; hiding runs the
+ * reverse and collapses each trigger none of whose panels is shown. A panel carrying the
+ * `horizontal` token sizes its width instead of its height. With a `parent`, showing first hides
+ * every open first-level sibling inside it through that sibling's own collapse, constructing one
+ * with the same groups and parent where the sibling has none; the collapse owns each one it
+ * constructs, destroys one whose panel left the document at its next show or hide call, and
+ * destroys the rest on its own destruction. After each write, dispatch, and await, a call reads its
+ * lifetime and the panel again: from the write of the `transition` token until its removal the
+ * panel must carry that token, a hide's panel must lack the `shown` token from the moment the hide
+ * removes it, and at completion the panel must carry the state the call completes to. A call that
+ * finds the collapse destroyed, a later call started, or the panel otherwise stops, writing and
+ * dispatching nothing more, and resolves `false`. An aborted `signal` destroys the collapse.
+ *
+ * @example
+ * ```ts
+ * const panel = document.createElement('div')
+ * panel.className = 'collapse'
+ * const collapse = new Collapse(panel)
+ * await collapse.toggle()
+ * collapse.destroy()
+ * ```
+ */
+export class Collapse implements CollapseInterface {
+	static readonly #registry = new Registry<Collapse>({ code: 'COLLAPSE_HOST_OWNED' })
+	readonly #host: HTMLElement
+	readonly #parent: HTMLElement | undefined
+	readonly #classes: CollapseClassMap
+	readonly #attributes: CollapseAttributeMap
+	readonly #selectors: CollapseSelectorMap
+	readonly #snapshot = new HostSnapshot()
+	readonly #controller = new AbortController()
+	readonly #owned = new Set<CollapseInterface>()
+	// The identity of the latest call that started a change. A call holds its change only while this
+	// is its identity, so a call resuming after a later one started sees that it no longer holds it.
+	#change: object | undefined
+
+	/**
+	 * Claims the host, resolves its vocabulary and parent, and binds initial hooks.
+	 *
+	 * @param host - The HTML element to own, the panel.
+	 * @param options - The accordion parent, markup vocabulary, initial event subscriptions, and lifetime.
+	 * @throws Thrown when the host is not an HTMLElement, when a group value is not a class token, an attribute name, or a selector, when the parent attribute names no HTML element and the constructor supplies no parent, or when the host already has a live owner.
+	 */
+	constructor(host: HTMLElement, options?: CollapseOptions) {
+		if (!instanceOf(HTMLElement)(host)) {
+			throw new AppError('Collapse requires an HTMLElement host', 'COLLAPSE_HOST_INVALID', {
+				tag: readTag(host),
+			})
+		}
+		this.#classes = resolveVocabulary(
+			'COLLAPSE_OPTION_INVALID',
+			COLLAPSE_CLASSES,
+			isClassToken,
+			options?.classes,
+		)
+		this.#attributes = resolveVocabulary(
+			'COLLAPSE_OPTION_INVALID',
+			COLLAPSE_ATTRIBUTES,
+			isAttributeName,
+			options?.attributes,
+		)
+		this.#selectors = resolveVocabulary(
+			'COLLAPSE_OPTION_INVALID',
+			COLLAPSE_SELECTORS,
+			isSelector,
+			options?.selectors,
+		)
+		this.#parent = resolveOptions<Pick<CollapseOptions, 'parent'>, 'parent'>(
+			host,
+			this.#attributes,
+			'COLLAPSE_OPTION_INVALID',
+			{},
+			{ parent: parseElement },
+			options,
+		).parent
+		Collapse.#registry.claim(host, this)
+		this.#host = host
+		bindEventMap(host, COLLAPSE_EVENTS, isCollapseEvent, options?.on, this.#controller.signal)
+		const signal = options?.signal
+		if (signal?.aborted) this.destroy()
+		else {
+			signal?.addEventListener('abort', () => this.destroy(), {
+				once: true,
+				signal: this.#controller.signal,
+			})
+		}
+	}
+
+	/**
+	 * Returns the live collapse that owns a panel, mirroring Bootstrap's `getInstance`.
+	 *
+	 * @param host - The panel to look up.
+	 * @returns The owning collapse, or undefined when no live collapse owns the panel.
+	 * @example
+	 * ```ts
+	 * await Collapse.find(panel)?.toggle()
+	 * ```
+	 */
+	static find(host: HTMLElement): CollapseInterface | undefined {
+		return Collapse.#registry.find(host)
+	}
+
+	get host(): HTMLElement {
+		return this.#host
+	}
+
+	get shown(): boolean {
+		return this.#host.classList.contains(this.#classes.shown)
+	}
+
+	async show(): Promise<boolean> {
+		this.#prune()
+		if (this.#refused(true) || this.#transitioning(this.#siblings())) return false
+		if (!emitEvent(this.#host, COLLAPSE_EVENTS.show, null, true)) return false
+		// A listener runs inside the dispatch and can destroy this collapse, show or hide the panel
+		// itself, or start a sibling's transition, so every refusal is read again before any write.
+		const siblings = this.#siblings()
+		if (this.#refused(true) || this.#transitioning(siblings)) return false
+		const change = {}
+		this.#change = change
+		if (!this.#hideSiblings(change, siblings)) return false
+		const host = this.#host
+		const { transition, shown } = this.#classes
+		// Each write door reads the panel for its phase: the transition token while the transition
+		// runs, and the completed tokens without it at completion.
+		const during = [transition]
+		const completed = [this.#classes.host, shown]
+		const dimension = this.#dimension()
+		const triggers = this.#triggers()
+		this.#save(dimension, triggers)
+		if (!this.#apply(change, during, [], () => host.classList.add(transition))) return false
+		if (!this.#apply(change, during, [], () => host.classList.remove(this.#classes.host))) {
+			return false
+		}
+		if (!this.#apply(change, during, [], () => host.style.setProperty(dimension, '0px'))) {
+			return false
+		}
+		if (!this.#writeTriggers(change, during, [], triggers, true)) return false
+		// Reading the scroll size lays the panel out at zero, so the size written next transitions.
+		const size = dimension === 'width' ? host.scrollWidth : host.scrollHeight
+		if (!this.#apply(change, during, [], () => host.style.setProperty(dimension, `${size}px`))) {
+			return false
+		}
+		await settleAnimations(host, this.#controller.signal)
+		if (!this.#holds(change, during, [])) return false
+		if (
+			!this.#apply(change, [...completed, transition], [], () =>
+				host.classList.add(this.#classes.host, shown),
+			)
+		) {
+			return false
+		}
+		if (!this.#apply(change, completed, [transition], () => host.classList.remove(transition))) {
+			return false
+		}
+		if (!this.#apply(change, completed, [transition], () => host.style.removeProperty(dimension))) {
+			return false
+		}
+		this.#change = undefined
+		emitEvent(host, COLLAPSE_EVENTS.shown, null, false)
+		return !this.#controller.signal.aborted
+	}
+
+	async hide(): Promise<boolean> {
+		this.#prune()
+		if (this.#refused(false)) return false
+		if (!emitEvent(this.#host, COLLAPSE_EVENTS.hide, null, true)) return false
+		if (this.#refused(false)) return false
+		const change = {}
+		this.#change = change
+		const host = this.#host
+		const { transition, shown } = this.#classes
+		// Each write door reads the panel for its phase: the shown token before the transition token
+		// is written, the transition token while the transition runs, without the shown token from
+		// its removal on, and the completed token without the shown or transition token at completion.
+		const during = [transition]
+		const completed = [this.#classes.host]
+		const dimension = this.#dimension()
+		const triggers = this.#triggers()
+		this.#save(dimension, triggers)
+		const size = host.getBoundingClientRect()[dimension]
+		if (
+			!this.#apply(change, [shown], during, () => host.style.setProperty(dimension, `${size}px`))
+		) {
+			return false
+		}
+		reflow(host)
+		if (!this.#apply(change, during, [], () => host.classList.add(transition))) return false
+		if (
+			!this.#apply(change, during, [shown], () => host.classList.remove(this.#classes.host, shown))
+		) {
+			return false
+		}
+		const collapsed = triggers.filter(
+			(trigger) =>
+				!readTargets(trigger, this.#attributes).some((panel) => panel.classList.contains(shown)),
+		)
+		if (!this.#writeTriggers(change, during, [shown], collapsed, false)) return false
+		if (!this.#apply(change, during, [shown], () => host.style.removeProperty(dimension))) {
+			return false
+		}
+		await settleAnimations(host, this.#controller.signal)
+		if (!this.#holds(change, during, [shown])) return false
+		if (
+			!this.#apply(change, [...completed, transition], [shown], () =>
+				host.classList.add(this.#classes.host),
+			)
+		) {
+			return false
+		}
+		if (
+			!this.#apply(change, completed, [transition, shown], () => host.classList.remove(transition))
+		) {
+			return false
+		}
+		this.#change = undefined
+		emitEvent(host, COLLAPSE_EVENTS.hidden, null, false)
+		return !this.#controller.signal.aborted
+	}
+
+	toggle(): Promise<boolean> {
+		return this.shown ? this.hide() : this.show()
+	}
+
+	destroy(): void {
+		if (this.#controller.signal.aborted) return
+		this.#controller.abort()
+		// The claim goes before the panel is restored, so an engine constructed while restoration runs
+		// can claim the panel, and its snapshot takes the values this one has still to write back.
+		Collapse.#registry.release(this.#host, this)
+		this.#snapshot.restore()
