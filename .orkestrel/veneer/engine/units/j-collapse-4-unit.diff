@@ -0,0 +1,45 @@
+import { parseElement } from '@src/browser'
+import { build, mount } from '@orkestrel/test/browser'
+import { describe, expect, it, onTestFinished } from 'vitest'
+
+describe('parseElement', () => {
+	it('returns the first HTML element a selector matches in the document, and an HTML element unchanged', () => {
+		const first = mount(
+			build('div', { classes: 'vn-parse-group', attributes: { id: 'vn-parse-accordion' } }),
+		)
+		const second = mount(build('div', { classes: 'vn-parse-group' }))
+		onTestFinished(() => first.remove())
+		onTestFinished(() => second.remove())
+		const detached = build('section')
+		expect(parseElement('#vn-parse-accordion')).toBe(first)
+		expect(parseElement('.vn-parse-group')).toBe(first)
+		expect(parseElement(' #vn-parse-accordion ')).toBe(first)
+		expect(parseElement(second)).toBe(second)
+		expect(parseElement(detached)).toBe(detached)
+	})
+
+	it('returns the first HTML element among the matches when a non-HTML element matches first', () => {
+		const vector = mount(document.createElementNS('http://www.w3.org/2000/svg', 'svg'))
+		vector.setAttribute('class', 'vn-parse-mixed')
+		const html = mount(build('div', { classes: 'vn-parse-mixed' }))
+		onTestFinished(() => vector.remove())
+		onTestFinished(() => html.remove())
+		expect(document.querySelector('.vn-parse-mixed')).toBe(vector)
+		expect(parseElement('.vn-parse-mixed')).toBe(html)
+	})
+
+	it('returns undefined for a selector matching no HTML element, an invalid selector, and a value that is neither', () => {
+		const svg = mount(document.createElementNS('http://www.w3.org/2000/svg', 'svg'))
+		svg.setAttribute('class', 'vn-parse-vector')
+		onTestFinished(() => svg.remove())
+		expect(parseElement('.vn-parse-vector')).toBeUndefined()
+		expect(parseElement('#vn-parse-missing')).toBeUndefined()
+		expect(parseElement('[data-bs-parent=')).toBeUndefined()
+		expect(parseElement('')).toBeUndefined()
+		expect(parseElement(svg)).toBeUndefined()
+		expect(parseElement(1)).toBeUndefined()
+		expect(parseElement(null)).toBeUndefined()
+		expect(parseElement(undefined)).toBeUndefined()
+		expect(parseElement({ toString: () => '#vn-parse-accordion' })).toBeUndefined()
+	})
+})
