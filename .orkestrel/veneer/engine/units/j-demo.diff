+
+// Each case mounts the section and then a delegate over the same host, in the order the page's entry
+// constructs the showcase and then its delegate over the document, so the delegate's construction
+// scan finds the scrollspy host the section rendered.
+describe('EngineSection', () => {
+	let host: HTMLElement
+	let section: SectionInterface
+	let delegate: Delegate
+
+	beforeEach(() => {
+		host = mount(build('div'))
