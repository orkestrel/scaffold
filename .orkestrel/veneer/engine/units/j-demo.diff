index 0000000..5b58f96
--- /dev/null
+++ b/app/browser/sections/EngineSection.ts
@@ -0,0 +1,68 @@
+import type { ToastInterface, TooltipInterface } from '@src/browser'
+import { TOAST_CLASSES, Toast, Tooltip } from '@src/browser'
+import { AppError } from '@src/core'
+import { ENGINE_COPY, ENGINE_SPECIMENS, ENGINE_TOOLTIP_TRIGGER } from '../constants.js'
+import { SpecimenSection } from './SpecimenSection.js'
+
+/**
+ * Renders the live engine specimens into a named region and constructs the engines the data API
+ * does not start.
+ *
+ * @remarks
+ * The page's own `Delegate` instance drives every specimen that carries Bootstrap's trigger
+ * attributes, and it constructs the scrollspy when the page constructs it after the showcase. The
+ * section constructs what no data attribute starts: one tooltip over the region whose descendants
+ * matching the `ENGINE_TOOLTIP_TRIGGER` selector take tooltips of their own, and one toast for each
+ * element carrying the toast's `host` token, which every button whose `aria-controls` attribute
+ * names that toast shows. The delegate's dismiss route hides the toast through the same engine.
+ * Destruction releases the button listeners, destroys the engines in construction order, and then
+ * removes the region.
+ *
+ * @example
+ * ```ts
+ * const section = new EngineSection(document.body)
+ * section.destroy()
+ * ```
+ */
+export class EngineSection extends SpecimenSection {
+	readonly #engines: Array<TooltipInterface | ToastInterface> = []
+	readonly #controller = new AbortController()
+
+	/**
+	 * Mounts the Engine region and its specimens, then constructs the tooltip and the toasts.
+	 *
+	 * @param host - The element receiving the section.
+	 * @throws Thrown when the region is not the host's last element after mounting, as an `AppError`
+	 *   carrying the `ENGINE_REGION_MISSING` code.
+	 */
+	constructor(host: HTMLElement) {
+		super(host, ENGINE_COPY, ENGINE_SPECIMENS)
+		// The specimen section appends its region as its last act, so the region is the host's last
+		// element here, and every engine is scoped to it rather than to whatever else the host holds.
+		const region = host.lastElementChild
+		if (!(region instanceof HTMLElement)) {
+			throw new AppError('The Engine region is not mounted', 'ENGINE_REGION_MISSING')
+		}
+		this.#engines.push(new Tooltip(region, { descendants: ENGINE_TOOLTIP_TRIGGER }))
+		for (const element of region.querySelectorAll(`.${CSS.escape(TOAST_CLASSES.host)}`)) {
+			if (!(element instanceof HTMLElement)) continue
+			const toast = new Toast(element)
+			this.#engines.push(toast)
+			if (element.id === '') continue
+			for (const trigger of region.querySelectorAll(
+				`[aria-controls="${CSS.escape(element.id)}"]`,
+			)) {
+				trigger.addEventListener('click', () => void toast.show(), {
+					signal: this.#controller.signal,
+				})
+			}
+		}
+	}
+
+	override destroy(): void {
+		this.#controller.abort()
+		for (const engine of this.#engines) engine.destroy()
+		this.#engines.length = 0
+		super.destroy()
+	}
+}
