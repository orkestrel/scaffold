+		delegate = new Delegate({ root: host })
+	})
+
+	afterEach(() => {
+		delegate.destroy()
+		section.destroy()
+		host.remove()
+	})
+
+	it('renders every engine specimen, in table order, through the shared section contract', () => {
+		expect(section).toBeInstanceOf(SpecimenSection)
+		expect(section.host).toBe(host)
+		const region = requireValue(host.querySelector('section'), 'No Engine region')
+		expect(region.getAttribute('aria-label')).toBe(ENGINE_COPY.region)
+		expect(region.querySelector('p')?.textContent).toBe(ENGINE_COPY.paragraph)
+		const rendered = [...region.querySelectorAll('[data-specimen]')]
+		expect(rendered.map((element) => element.getAttribute('data-specimen'))).toEqual(
+			ENGINE_SPECIMENS.map(({ name }) => name),
+		)
+		expect(rendered.map((element) => element.innerHTML)).toEqual(
+			ENGINE_SPECIMENS.map(({ markup }) => markup),
+		)
+		// A trigger naming an id another region renders would drive that region's element, so every
+		// id the region carries is its own.
+		const ids = [...region.querySelectorAll('[id]')].map((element) => element.id)
+		expect(ids.length).toBeGreaterThan(0)
+		expect(ids.filter((id) => !id.startsWith('engine-'))).toStrictEqual([])
+		expect(region.querySelector('[style]')).toBeNull()
+		expect(Object.isFrozen(ENGINE_COPY)).toBe(true)
+		expect(Object.isFrozen(ENGINE_SPECIMENS)).toBe(true)
+		expect(ENGINE_SPECIMENS.every((entry) => Object.isFrozen(entry))).toBe(true)
+	})
+
+	// The mutation this catches is a specimen carrying a class no loaded rule declares, which renders
+	// as nothing and fails silently. The carousel's `slide` class is such a class: the engine reads it
+	// to decide whether a move animates, and no rule of the cascade declares it.
+	it('carries only class tokens the loaded cascade declares', () => {
+		const region = requireValue(host.querySelector('section'), 'No Engine region')
+		const classes = [...readClasses(region)]
