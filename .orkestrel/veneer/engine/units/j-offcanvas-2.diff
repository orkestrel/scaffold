+/**
+ * Checks whether a DOM event is an offcanvas event, whose detail may name the trigger that asked for the panel.
+ *
+ * @param value - The value to inspect.
+ * @returns True if the value is a CustomEvent whose detail is an object carrying no `relatedTarget` member, or one that is undefined or an HTMLElement; false otherwise.
+ * @remarks
+ * An offcanvas panel dispatches each event with a detail object whose `relatedTarget` member
+ * carries the trigger passed to `show`, or undefined, so a consumer's own event under an offcanvas
+ * wire name that carries no object, or names something other than an element there, is refused.
+ * The class half reads `isInstance` from `@orkestrel/contract`, and the containment covers a
+ * `detail` or `relatedTarget` accessor that throws, as the modal event guard does.
+ * @example
+ * ```ts
+ * isOffcanvasEvent(new CustomEvent('shown.vn.offcanvas', { detail: { relatedTarget: undefined } })) // true
+ * isOffcanvasEvent(new CustomEvent('shown.vn.offcanvas')) // false
+ * ```
+ */
+export function isOffcanvasEvent(value: unknown): value is OffcanvasEventMap['show'] {
+	try {
+		if (!isInstance(value, CustomEvent)) return false
+		const detail: unknown = value.detail
+		if (typeof detail !== 'object' || detail === null) return false
+		if (!('relatedTarget' in detail)) return true
+		return detail.relatedTarget === undefined || isInstance(detail.relatedTarget, HTMLElement)
+	} catch {
+		return false
+	}
+}
