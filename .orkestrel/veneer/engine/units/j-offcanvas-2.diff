+	}
+
+	/**
+	 * Returns the live offcanvas panel that owns a host, mirroring Bootstrap's `getInstance`.
+	 *
+	 * @param host - The panel to look up.
+	 * @returns The owning offcanvas panel, or undefined when no live panel owns the host.
+	 * @example
+	 * ```ts
+	 * await Offcanvas.find(host)?.hide()
+	 * ```
+	 */
+	static find(host: HTMLElement): OffcanvasInterface | undefined {
+		return Offcanvas.#registry.find(host)
+	}
