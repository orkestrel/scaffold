+		expect(offcanvas.shown).toBe(true)
+	})
+
+	// Each of the following cases drives a custom element beside the panel whose `inert` reaction runs
+	// inside the isolation's construction, before the panel has stored the isolation.
+	it('stops the isolation whose inert write a reaction answers by destroying the panel, releasing its claims and writing nothing more', async () => {
+		const name = 'vn-offcanvas-inert-destroyer'
+		const reactions = new WeakMap<HTMLElement, () => void>()
+		customElements.define(
+			name,
+			class extends HTMLElement {
+				static observedAttributes = ['inert']
+				attributeChangedCallback() {
+					reactions.get(this)?.()
+				}
+			},
+		)
+		const root = scene.mount('<div></div>')
+		const reactor = document.createElement(name)
+		const other = document.createElement('button')
+		const host = document.createElement('div')
+		host.className = 'offcanvas'
+		host.tabIndex = -1
+		root.append(reactor, other, host)
+		const offcanvas = new Offcanvas(host, { backdrop: false, scroll: false })
+		onTestFinished(() => offcanvas.destroy())
+		const writes = createRecorder<readonly [readonly MutationRecord[]]>()
+		const observer = new MutationObserver((records) => writes.handler(records))
+		onTestFinished(() => observer.disconnect())
+		reactions.set(reactor, () => {
+			reactions.delete(reactor)
+			offcanvas.destroy()
+			observer.observe(document.body, {
+				attributes: true,
+				attributeFilter: ['inert'],
+				subtree: true,
+			})
+		})
+		expect(await offcanvas.show()).toBe(false)
+		expect(
+			[...writes.calls.flat(2), ...observer.takeRecords()].filter(
+				(record) => record.target !== reactor,
+			),
+		).toEqual([])
+		expect(document.querySelectorAll('[inert]')).toHaveLength(0)
+		const late = root.appendChild(document.createElement('button'))
+		await Promise.resolve()
+		expect(late.hasAttribute('inert')).toBe(false)
+		expect(Offcanvas.find(host)).toBeUndefined()
+		expect(document.body.style.overflow).not.toBe('hidden')
+	})
+
+	it('destroys the isolation it constructed when a reaction inside the construction takes the show over', async () => {
+		const name = 'vn-offcanvas-inert-takeover'
+		const reactions = new WeakMap<HTMLElement, () => void>()
+		customElements.define(
+			name,
+			class extends HTMLElement {
+				static observedAttributes = ['inert']
+				attributeChangedCallback() {
+					reactions.get(this)?.()
+				}
+			},
+		)
+		const root = scene.mount('<div></div>')
+		const reactor = document.createElement(name)
+		const other = document.createElement('button')
+		const host = document.createElement('div')
+		host.className = 'offcanvas'
+		host.tabIndex = -1
+		root.append(reactor, other, host)
+		const offcanvas = new Offcanvas(host, { backdrop: false, scroll: false })
+		onTestFinished(() => offcanvas.destroy())
+		reactions.set(reactor, () => {
+			reactions.delete(reactor)
+			host.classList.remove('show')
+		})
+		expect(await offcanvas.show()).toBe(false)
+		expect(offcanvas.shown).toBe(false)
+		expect(document.querySelectorAll('[inert]')).toHaveLength(0)
+		const late = root.appendChild(document.createElement('button'))
+		await Promise.resolve()
+		expect(late.hasAttribute('inert')).toBe(false)
+	})
+
+	// This case drives a full-width custom element the lock's `fixed` selector names, whose reaction to
+	// its `style` attribute runs inside the lock's construction, before the panel has stored the lock.
+	it('releases the scroll lock it constructed when a reaction inside the construction takes the show over', async () => {
+		const name = 'vn-offcanvas-lock-takeover'
+		const reactions = new WeakMap<HTMLElement, () => void>()
+		customElements.define(
+			name,
+			class extends HTMLElement {
+				static observedAttributes = ['style']
+				attributeChangedCallback() {
+					reactions.get(this)?.()
+				}
+			},
+		)
+		const root = scene.mount('<div></div>')
+		const reactor = document.createElement(name)
+		reactor.className = 'fixed-top'
+		reactor.setAttribute('style', 'display: block; position: fixed; left: 0; right: 0')
+		root.append(reactor)
+		const host = document.createElement('div')
+		host.className = 'offcanvas'
+		root.append(host)
+		const body = document.body
+		const styled = body.getAttribute('style')
+		const offcanvas = new Offcanvas(host, { backdrop: false })
+		onTestFinished(() => offcanvas.destroy())
+		reactions.set(reactor, () => {
+			reactions.delete(reactor)
+			host.classList.add('show')
+		})
+		expect(await offcanvas.show()).toBe(false)
+		expect(body.getAttribute('style')).toBe(styled)
+		expect(reactor.style.paddingRight).toBe('')
+		expect(Offcanvas.find(host)).toBe(offcanvas)
+	})
+
+	it('resolves a show true when a hook of its shown event hides the panel, the hide starting a new change', async () => {
+		const root = scene.mount(markup)
+		const host = requireValue(root.querySelector<HTMLElement>('#panel'), 'No panel')
+		const hidden = createRecorder<readonly [boolean]>()
+		const offcanvas: OffcanvasInterface = new Offcanvas(host, {
+			backdrop: false,
+			scroll: true,
+			on: {
+				shown: () => void offcanvas.hide().then((closed) => hidden.handler(closed)),
+			},
+		})
+		onTestFinished(() => offcanvas.destroy())
+		expect(await offcanvas.show()).toBe(true)
+		await waitForCondition('the hide resolves', () => hidden.count === 1)
+		expect(hidden.calls).toEqual([[true]])
+		expect(offcanvas.shown).toBe(false)
+	})
+})
