+				attributeChangedCallback(_name: string, _previous: string | null, value: string | null) {
+					reactions.get(this)?.(value)
+				}
+			},
+		)
+		scene.load(offcanvasCascade)
+		const root = scene.mount('<div></div>')
+		const host = document.createElement(name)
+		host.className = 'offcanvas offcanvas-start'
+		root.append(host)
+		const events = createRecorder<readonly [string]>()
+		const offcanvas = new Offcanvas(host, { on: { hidden: (event) => events.handler(event.type) } })
+		onTestFinished(() => offcanvas.destroy())
+		expect(await offcanvas.show()).toBe(true)
+		const writes = createRecorder<readonly [readonly MutationRecord[]]>()
+		const observer = new MutationObserver((records) => writes.handler(records))
+		onTestFinished(() => observer.disconnect())
+		reactions.set(host, (value) => {
+			if ((value ?? '').split(' ').includes('show')) return
+			reactions.delete(host)
+			host.classList.add('show')
+			observer.observe(host, { attributes: true })
+		})
+		expect(await offcanvas.hide()).toBe(false)
+		// The call stopped at the write, so the slide out the `hiding` write started is still running.
+		expect(host.getAnimations()).toHaveLength(1)
+		expect([...writes.calls.flat(2), ...observer.takeRecords()]).toEqual([])
