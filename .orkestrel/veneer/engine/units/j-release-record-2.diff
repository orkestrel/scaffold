+		const incoming = document.createElement(name)
+		incoming.className = 'carousel-item'
+		host.append(incoming)
+		const carousel = new Carousel(host)
+		onTestFinished(() => carousel.destroy())
+		const writes = createRecorder<readonly [readonly MutationRecord[]]>()
+		const observer = new MutationObserver((records) => writes.handler(records))
+		onTestFinished(() => observer.disconnect())
+		const seen = createRecorder<readonly [string | null]>()
+		reactions.set(incoming, (value) => {
+			seen.handler(value)
+			// The first reaction is the order token's addition, the second the direction token's, and the
+			// third the direction token's removal.
+			if (seen.count < 3) return
+			reactions.delete(incoming)
+			carousel.destroy()
+			incoming.classList.add('carousel-item-next')
+			observer.observe(root, { attributes: true, subtree: true })
+		})
+		expect(await carousel.next()).toBe(false)
+		expect(seen.calls).toEqual([
