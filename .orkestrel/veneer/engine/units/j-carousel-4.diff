+	readonly #reference: HTMLElement
+	readonly #dismiss: DropdownDefaults['dismiss']
+	readonly #offset: readonly [number, number]
+	readonly #static: boolean
+	readonly #classes: DropdownClassMap
+	readonly #attributes: DropdownAttributeMap
+	readonly #selectors: DropdownSelectorMap
+	readonly #snapshot = new HostSnapshot()
+	readonly #controller = new AbortController()
+	// The placement of the open menu, from the show that placed it until the hide or destruction
+	// that restores it.
+	#placement: PlacementInterface | undefined
+	// The identity of the call whose change is in flight. A call holds its change only while this is
+	// its identity, and every other call is refused while a change is in flight.
+	#change: object | undefined
+
+	/**
+	 * Claims the toggle, resolves its vocabulary, menu, and options, and binds initial hooks.
+	 *
+	 * @param host - The HTML element to own, the toggle.
+	 * @param options - The dismissal, placement, reference, markup vocabulary, initial event subscriptions, and lifetime.
+	 * @throws Thrown when the host is not an HTMLElement, when a group value is not a class token, an attribute name, or a selector, when no menu sits beside the toggle or inside its parent, when a declared attribute the constructor does not override fails coercion, or when the host already has a live owner.
+	 */
+	constructor(host: HTMLElement, options?: DropdownOptions) {
+		if (!isInstance(host, HTMLElement)) {
+			throw new AppError('Dropdown requires an HTMLElement host', 'DROPDOWN_HOST_INVALID', {
+				tag: readTag(host),
+			})
+		}
+		const { center, ...classes } = DROPDOWN_CLASSES
+		this.#classes = Object.freeze({
+			...resolveVocabulary('DROPDOWN_OPTION_INVALID', classes, isClassToken, options?.classes),
+			center: resolveVocabulary(
+				'DROPDOWN_OPTION_INVALID',
+				center,
+				isClassToken,
+				options?.classes?.center,
+			),
+		})
+		this.#attributes = resolveVocabulary(
+			'DROPDOWN_OPTION_INVALID',
+			DROPDOWN_ATTRIBUTES,
+			isAttributeName,
+			options?.attributes,
+		)
+		this.#selectors = resolveVocabulary(
+			'DROPDOWN_OPTION_INVALID',
+			DROPDOWN_SELECTORS,
+			isSelector,
+			options?.selectors,
+		)
+		const menu = this.#locate(host)
+		if (menu === undefined) {
+			throw new AppError('Dropdown requires a menu beside its toggle', 'DROPDOWN_MENU_MISSING', {
+				tag: host.tagName,
+			})
+		}
+		const { dismiss } = resolveOptions<Pick<DropdownOptions, 'dismiss'>, 'dismiss'>(
+			host,
+			this.#attributes,
+			'DROPDOWN_OPTION_INVALID',
+			{ dismiss: DROPDOWN_DEFAULTS.dismiss },
+			{ dismiss: parseDismiss },
+			options,
+		)
+		this.#dismiss = {
+			inside: dismiss?.inside ?? DROPDOWN_DEFAULTS.dismiss.inside,
+			outside: dismiss?.outside ?? DROPDOWN_DEFAULTS.dismiss.outside,
+		}
+		const placement = resolveOptions<DropdownDefaults['placement'], 'offset' | 'static'>(
+			host,
+			this.#attributes,
+			'DROPDOWN_OPTION_INVALID',
+			DROPDOWN_DEFAULTS.placement,
+			{ offset: parseOffset, static: parseStatic },
+			options?.placement,
+		)
+		this.#offset = placement.offset
+		this.#static = placement.static
+		this.#reference = options?.reference ?? this.#resolveReference(host)
