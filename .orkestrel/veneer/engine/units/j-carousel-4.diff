+		if (signal?.aborted) this.destroy()
+		else {
+			signal?.addEventListener('abort', () => this.destroy(), {
+				once: true,
+				signal: this.#controller.signal,
+			})
+		}
+	}
+
+	/**
+	 * Returns the live dropdown that owns a toggle, mirroring Bootstrap's `getInstance`.
+	 *
+	 * @param host - The toggle to look up.
+	 * @returns The owning dropdown, or undefined when no live dropdown owns the toggle.
+	 * @example
+	 * ```ts
+	 * await Dropdown.find(toggle)?.toggle()
+	 * ```
+	 */
+	static find(host: HTMLElement): DropdownInterface | undefined {
+		return Dropdown.#registry.find(host)
+	}
+
+	get host(): HTMLElement {
+		return this.#host
+	}
+
+	get menu(): HTMLElement {
+		return this.#menu
+	}
+
+	get shown(): boolean {
+		return this.#menu.classList.contains(this.#classes.shown)
+	}
+
+	async show(): Promise<boolean> {
+		if (this.#refused(true)) return false
+		if (!emitEvent(this.#host, DROPDOWN_EVENTS.show, { click: undefined }, true)) return false
+		// A listener runs inside the dispatch and can destroy this dropdown, show or hide it itself, or
+		// disable the toggle, so every refusal is read again before any write.
+		if (this.#refused(true)) return false
+		const change = {}
+		this.#change = change
+		try {
+			const host = this.#host
+			const menu = this.#menu
+			const { shown } = this.#classes
+			this.#save()
+			// Restoring a placement a taken-over show left runs a reaction inside each of its writes and
+			// dispatches the menu's `beforetoggle` event, so the call reads its door before placing anew.
+			this.#placement?.destroy()
+			this.#placement = undefined
+			if (!this.#holds(change, false)) return false
+			// The placement reads this dropdown's signal inside its construction and restores itself when
+			// it aborts, so the door after it reads a destroyed dropdown with nothing left to restore.
+			const placement = this.#place()
+			if (placement === undefined) return false
+			this.#placement = placement
+			if (!this.#holds(change, false)) return false
+			if (!this.#apply(change, false, () => host.focus())) return false
+			if (!this.#apply(change, false, () => host.setAttribute('aria-expanded', 'true'))) {
+				return false
+			}
