+		owner.addEventListener('click', (event) => this.#lightDismiss(event), {
+			signal: this.#controller.signal,
+		})
+		owner.addEventListener('keyup', (event) => this.#lightDismiss(event), {
+			signal: this.#controller.signal,
+		})
