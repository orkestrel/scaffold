@@ -0,0 +1,390 @@
+import type {
+	ScrollSpyClassMap,
+	ScrollSpyInterface,
+	ScrollSpyOptions,
+	ScrollSpySelectorMap,
+} from './types.js'
+import { AppError } from '@src/core'
+import { instanceOf, isInstance, parseBoolean } from '@orkestrel/contract'
+import {
+	SCROLL_SPY_ATTRIBUTES,
+	SCROLL_SPY_CLASSES,
+	SCROLL_SPY_DEFAULTS,
+	SCROLL_SPY_EVENTS,
+	SCROLL_SPY_SELECTORS,
+} from './constants.js'
+import { bindEventMap, emitEvent, readTag, resolveOptions, resolveVocabulary } from './helpers.js'
+import { HostSnapshot } from './HostSnapshot.js'
+import { parseElement, parseRootMargin, parseThreshold } from './parsers.js'
+import { Registry } from './Registry.js'
+import { isAttributeName, isClassToken, isScrollSpyEvent, isSelector } from './validators.js'
+
+/**
+ * Activates the navigation link whose section is in view as its host scrolls, and the links that lead to it.
+ *
+ * @remarks
+ * The host is the scrolling element; it must be an HTMLElement in the current realm and have no
+ * live scrollspy owner. Construction validates and copies the `classes`, `attributes`, and
+ * `selectors` groups, resolves the `target`, `smooth`, and `intersection` options from the
+ * constructor and the host's attributes, claims the host, binds the hooks, and refreshes. A refresh
+ * reads every `[href]` link inside the target whose fragment names a visible element inside the
+ * host, skipping a link carrying the `disabled` token or a `disabled` attribute whose value is not
+ * `false`, and replaces its
+ * `IntersectionObserver` with one observing each named section, whose root is the host when its
+ * `overflow-y` value is not `visible`, and the viewport otherwise. At each delivery a section that
+ * leaves clears its link's `active` token; scrolling down, each entering section not higher than
+ * the last one activated activates its link, and scrolling up, each entering section higher than it
+ * does. An activation clears the `active` token from the target and every `[href]` link inside it,
+ * gives it to the link and to the links that lead to it, and dispatches `activate.vn.scrollspy` on
+ * the host. After each write and the dispatch the delivery reads its lifetime again; after each
+ * removal the removed token must be absent, and after the link's own write and after the dispatch
+ * the link must carry its token. A delivery that finds the scrollspy destroyed, a later refresh
+ * made, a removed token back, or the link without its token stops, writing and dispatching nothing
+ * more, and reads no further entry.
+ * With `smooth`, a click on a link inside the target whose section is observed scrolls the root
+ * smoothly to that section and prevents the click's navigation. Destruction disconnects the
+ * observer and restores every `active` token the scrollspy wrote or removed. An aborted `signal`
+ * destroys the scrollspy.
+ *
+ * @example
+ * ```ts
+ * const container = document.createElement('div')
+ * container.style.cssText = 'height: 100px; overflow-y: auto'
+ * const spy = new ScrollSpy(container, { target: document.createElement('nav') })
+ * spy.refresh()
+ * spy.destroy()
+ * ```
+ */
+export class ScrollSpy implements ScrollSpyInterface {
+	static readonly #registry = new Registry<ScrollSpy>({ code: 'SCROLL_SPY_HOST_OWNED' })
+	readonly #host: HTMLElement
+	readonly #target: HTMLElement
+	readonly #margin: string
+	readonly #threshold: readonly number[]
+	readonly #classes: ScrollSpyClassMap
+	readonly #selectors: ScrollSpySelectorMap
+	readonly #snapshot = new HostSnapshot()
+	readonly #controller = new AbortController()
+	// The observer the last refresh created. A delivery holds its change only while its observer is
+	// this one, so a delivery that resumes after a refresh or a destruction reads that it no longer
+	// holds it.
+	#observer: IntersectionObserver | undefined
+	// Each observed section mapped to the link naming it, and each link to its section, as the last
+	// refresh read them.
+	#links = new Map<Element, HTMLElement>()
+	#sections = new Map<HTMLElement, HTMLElement>()
+	// The link the last activation selected, which the `link` getter reports while it carries its
+	// token.
+	#link: HTMLElement | undefined
+	// The offset of the section the last activation selected and the root's scroll position at the
+	// last delivery, which together decide the scroll direction's candidate.
+	#top = 0
+	#scroll = 0
+
+	/**
+	 * Claims the host, resolves its vocabulary and options, binds initial hooks, and observes the target's sections.
+	 *
+	 * @param host - The HTML element to own, the scrolling element.
+	 * @param options - The navigation, smooth scrolling, observer settings, markup vocabulary, initial event subscriptions, and lifetime.
+	 * @throws Thrown when the host is not an HTMLElement, when a group value is not a class token, an attribute name, or a selector, when a declared attribute fails coercion, when the resolved margin or threshold is one the observer refuses, or when the host already has a live owner.
+	 */
+	constructor(host: HTMLElement, options?: ScrollSpyOptions) {
+		if (!isInstance(host, HTMLElement)) {
+			throw new AppError('ScrollSpy requires an HTMLElement host', 'SCROLL_SPY_HOST_INVALID', {
+				tag: readTag(host),
+			})
+		}
+		this.#classes = resolveVocabulary(
+			'SCROLL_SPY_OPTION_INVALID',
+			SCROLL_SPY_CLASSES,
+			isClassToken,
+			options?.classes,
+		)
+		const attributes = resolveVocabulary(
+			'SCROLL_SPY_OPTION_INVALID',
+			SCROLL_SPY_ATTRIBUTES,
+			isAttributeName,
+			options?.attributes,
+		)
+		this.#selectors = resolveVocabulary(
+			'SCROLL_SPY_OPTION_INVALID',
+			SCROLL_SPY_SELECTORS,
+			isSelector,
+			options?.selectors,
+		)
+		const resolved = resolveOptions<
+			Pick<ScrollSpyOptions, 'target' | 'smooth'>,
+			'target' | 'smooth'
+		>(
+			host,
+			attributes,
+			'SCROLL_SPY_OPTION_INVALID',
+			{ smooth: SCROLL_SPY_DEFAULTS.smooth },
+			{ target: parseElement, smooth: parseBoolean },
+			options,
+		)
+		// The group's keys have no top-level option key of their own, so the group is resolved as its
+		// own layer: its defaults, then the attributes its keys name, then the constructor's group, key
+		// by key.
+		const intersection = resolveOptions<
+			Required<NonNullable<ScrollSpyOptions['intersection']>>,
+			'margin' | 'threshold'
+		>(
+			host,
+			attributes,
+			'SCROLL_SPY_OPTION_INVALID',
+			SCROLL_SPY_DEFAULTS.intersection,
+			{ margin: parseRootMargin, threshold: parseThreshold },
+			options?.intersection,
+		)
+		const margin = parseRootMargin(intersection.margin)
+		const threshold = parseThreshold(intersection.threshold)
+		if (margin === undefined || threshold === undefined) {
+			throw new AppError('Option value fails validation', 'SCROLL_SPY_OPTION_INVALID', {
+				key: margin === undefined ? 'margin' : 'threshold',
+			})
+		}
+		this.#margin = margin
+		// A copy, so a later change to the caller's array leaves the ratios read here.
+		this.#threshold = Object.freeze([...threshold])
+		ScrollSpy.#registry.claim(host, this)
+		this.#host = host
+		this.#target = resolved.target ?? host.ownerDocument.body
+		bindEventMap(host, SCROLL_SPY_EVENTS, isScrollSpyEvent, options?.on, this.#controller.signal)
+		if (resolved.smooth === true) {
+			this.#target.addEventListener('click', (event) => this.#scrollTo(event), {
+				signal: this.#controller.signal,
+			})
+		}
+		const signal = options?.signal
+		if (signal?.aborted) this.destroy()
+		else {
+			signal?.addEventListener('abort', () => this.destroy(), {
+				once: true,
+				signal: this.#controller.signal,
+			})
+			this.refresh()
+		}
+	}
+
+	/**
+	 * Returns the live scrollspy that owns a scrolling element, mirroring Bootstrap's `getInstance`.
+	 *
+	 * @param host - The scrolling element to look up.
+	 * @returns The owning scrollspy, or undefined when no live scrollspy owns the element.
+	 * @example
+	 * ```ts
+	 * ScrollSpy.find(container)?.refresh()
+	 * ```
+	 */
+	static find(host: HTMLElement): ScrollSpyInterface | undefined {
+		return ScrollSpy.#registry.find(host)
+	}
+
+	get host(): HTMLElement {
+		return this.#host
+	}
+
+	get target(): HTMLElement {
+		return this.#target
+	}
+
+	get link(): HTMLElement | undefined {
+		const link = this.#link
+		return link?.classList.contains(this.#classes.active) ? link : undefined
+	}
+
+	refresh(): void {
+		if (this.#controller.signal.aborted) return
+		this.#observer?.disconnect()
+		const links = new Map<Element, HTMLElement>()
+		const sections = new Map<HTMLElement, HTMLElement>()
+		for (const link of Array.from(this.#target.querySelectorAll('[href]')).filter(
+			instanceOf(HTMLElement),
+		)) {
+			const section = this.#section(link)
+			if (section === undefined) continue
+			links.set(section, link)
+			sections.set(link, section)
+		}
+		this.#links = links
+		this.#sections = sections
+		if (this.#link !== undefined && !sections.has(this.#link)) this.#link = undefined
+		const observer = new IntersectionObserver(
+			(entries, current) => this.#deliver(current, entries),
+			{
+				root: getComputedStyle(this.#host).overflowY === 'visible' ? null : this.#host,
+				rootMargin: this.#margin,
+				threshold: [...this.#threshold],
+			},
+		)
+		this.#observer = observer
+		for (const section of links.keys()) observer.observe(section)
+	}
+
+	destroy(): void {
+		if (this.#controller.signal.aborted) return
+		this.#controller.abort()
+		this.#observer?.disconnect()
+		this.#observer = undefined
+		this.#link = undefined
+		// The claim goes before the links are restored, so an engine constructed while restoration runs
+		// can claim the host, and its snapshot takes the values this one has still to write back.
+		ScrollSpy.#registry.release(this.#host, this)
+		this.#snapshot.restore()
+	}
+
+	// Returns the visible HTML element inside the host a link's fragment names, or undefined for a link
+	// with no fragment, a disabled link, or a fragment naming no visible HTML element there.
+	#section(link: HTMLElement): HTMLElement | undefined {
+		const hash =
+			isInstance(link, HTMLAnchorElement) || isInstance(link, HTMLAreaElement) ? link.hash : ''
+		const disabled = link.getAttribute('disabled')
+		if (
+			hash === '' ||
+			link.classList.contains(this.#classes.disabled) ||
+			(disabled !== null && disabled !== 'false')
+		) {
+			return undefined
+		}
+		let id = ''
+		try {
+			id = decodeURI(hash.slice(1))
+		} catch {
+			return undefined
+		}
+		const section = this.#host.querySelector(`#${CSS.escape(id)}`)
+		return isInstance(section, HTMLElement) && section.checkVisibility({ visibilityProperty: true })
+			? section
+			: undefined
+	}
+
+	// Follows Bootstrap's selection rule over one delivery: a leaving section clears its link, and an
+	// entering section activates its link when it is lower than the last one activated while the root
+	// scrolls down, or higher while it scrolls up. Scrolling down while the root's scroll position is
+	// zero, the first activation ends the delivery.
+	#deliver(observer: IntersectionObserver, entries: readonly IntersectionObserverEntry[]): void {
+		if (!this.#holds(observer, [], [])) return
+		const root = observer.root
+		const scroll = (isInstance(root, Element) ? root : this.#host.ownerDocument.documentElement)
+			.scrollTop
+		const down = scroll >= this.#scroll
+		this.#scroll = scroll
+		for (const entry of entries) {
+			const section = entry.target
+			const link = this.#links.get(section)
+			if (link === undefined || !isInstance(section, HTMLElement)) continue
+			if (!entry.isIntersecting) {
+				if (this.#link === link) this.#link = undefined
+				if (!this.#apply(observer, [], [link], link, false)) return
+				continue
+			}
+			const top = section.offsetTop
+			if (down !== top >= this.#top) continue
+			this.#top = top
+			if (!this.#activate(observer, link)) return
+			if (down && scroll === 0) return
+		}
+	}
+
+	// Clears the active token inside the target, gives it to the link and to the links that lead to it,
+	// and dispatches the activate event, reading after each write and the dispatch whether the
+	// delivery still holds its change. A link already active is left as it is.
+	#activate(observer: IntersectionObserver, link: HTMLElement): boolean {
+		const { active } = this.#classes
+		if (this.#link === link && link.classList.contains(active)) return true
+		this.#link = link
+		const cleared = Array.from(this.#target.querySelectorAll(`[href].${CSS.escape(active)}`))
+		for (const element of [this.#target, ...cleared.filter(instanceOf(HTMLElement))]) {
+			if (!this.#apply(observer, [], [element], element, false)) return false
+		}
+		if (!this.#apply(observer, [link], [], link, true)) return false
+		for (const parent of this.#parents(link)) {
+			if (!this.#apply(observer, [link], [], parent, true)) return false
+		}
+		emitEvent(this.#host, SCROLL_SPY_EVENTS.activate, { relatedTarget: link }, false)
+		return this.#holds(observer, [link], [])
+	}
+
+	// Lists the elements inside the target that turn active with a link: the toggle of the dropdown
+	// holding a menu link, or else the nearest preceding parent link of each list that holds the link.
+	#parents(link: HTMLElement): readonly HTMLElement[] {
+		const { list, parent, dropdown, toggle } = this.#selectors
+		const target = this.#target
+		if (link.classList.contains(this.#classes.entry)) {
+			const menu = link.closest(dropdown)
+			const found = menu !== null && target.contains(menu) ? menu.querySelector(toggle) : null
+			return isInstance(found, HTMLElement) ? [found] : []
+		}
+		const parents: HTMLElement[] = []
+		let holder = link.parentElement?.closest(list)
+		while (
+			holder !== null &&
+			holder !== undefined &&
+			holder !== target &&
+			target.contains(holder)
+		) {
+			let previous = holder.previousElementSibling
+			while (previous !== null && !previous.matches(parent)) {
+				previous = previous.previousElementSibling
+			}
+			if (isInstance(previous, HTMLElement)) parents.push(previous)
+			holder = holder.parentElement?.closest(list)
+		}
+		return parents
+	}
+
+	// Reports whether a delivery still holds its change: the scrollspy is live, no refresh replaced its
+	// observer, each element in `present` carries the active token, and none in `absent` does.
+	#holds(
+		observer: IntersectionObserver,
+		present: readonly HTMLElement[],
+		absent: readonly HTMLElement[],
+	): boolean {
+		const { active } = this.#classes
+		return (
+			!this.#controller.signal.aborted &&
+			this.#observer === observer &&
+			present.every((element) => element.classList.contains(active)) &&
+			!absent.some((element) => element.classList.contains(active))
+		)
+	}
+
+	// Records an element's active token and writes the state when the element does not carry it, a
+	// write a reaction can run inside, then reads whether the delivery still holds its change.
+	#apply(
+		observer: IntersectionObserver,
+		present: readonly HTMLElement[],
+		absent: readonly HTMLElement[],
+		element: HTMLElement,
+		active: boolean,
+	): boolean {
+		const token = this.#classes.active
+		if (element.classList.contains(token) !== active) {
+			this.#snapshot.save({ category: 'token', element, name: token })
+			element.classList.toggle(token, active)
+		}
+		return this.#holds(observer, present, absent)
+	}
+
+	// Scrolls the observer's root smoothly to the section the clicked link names, and prevents the
+	// click's navigation; a click on any other link inside the target is left alone.
+	#scrollTo(event: Event): void {
+		const origin = event.target
+		const link = isInstance(origin, Element) ? origin.closest('[href]') : null
+		const section = isInstance(link, HTMLElement) ? this.#sections.get(link) : undefined
+		if (section === undefined) return
+		event.preventDefault()
+		const root = this.#observer?.root
+		const top = section.getBoundingClientRect().top
+		if (isInstance(root, HTMLElement)) {
+			root.scrollTo({
+				top: top - root.getBoundingClientRect().top - root.clientTop + root.scrollTop,
+				behavior: 'smooth',
+			})
+			return
+		}
+		const view = this.#host.ownerDocument.defaultView
+		view?.scrollTo({ top: top + view.scrollY, behavior: 'smooth' })
+	}
+}
