+			if (!this.#apply(change, true, () => host.classList.add(shown))) return false
+			if (!this.#apply(change, true, () => placement.update())) return false
+			this.#change = undefined
+			emitEvent(host, DROPDOWN_EVENTS.shown, { click: undefined }, false)
+			return !this.#controller.signal.aborted
+		} finally {
+			if (this.#change === change) this.#change = undefined
+		}
+	}
+
+	async hide(): Promise<boolean> {
+		return this.#conceal(undefined)
+	}
+
+	toggle(): Promise<boolean> {
+		return this.shown ? this.hide() : this.show()
+	}
+
+	update(): void {
+		this.#placement?.update()
+	}
+
+	destroy(): void {
+		if (!this.#controller.signal.aborted) {
+			// The claim goes before anything is restored, so an engine constructed while restoration runs
+			// can claim the toggle, and its snapshot takes the values this one has still to write back.
+			// The abort destroys the placement, which holds this dropdown's signal.
+			Dropdown.#registry.release(this.#host, this)
+			this.#controller.abort()
+		}
+		// A listener to the menu's closing `beforetoggle` event, which the placement's restoration
+		// dispatches, can call destroy again. That call completes the placement's restoration and this
+		// dropdown's before it returns, and the call it interrupted, resuming, finds nothing to write.
+		this.#placement?.destroy()
+		this.#placement = undefined
+		this.#snapshot.restore()
+	}
+
+	// Reports whether a call that would leave the menu shown or hidden cannot start: the dropdown is
+	// destroyed, a change is in flight, the menu already carries the state, or the toggle carries the
+	// `disabled` token or is disabled.
+	#refused(shown: boolean): boolean {
+		return (
+			this.#controller.signal.aborted ||
+			this.#change !== undefined ||
+			this.shown === shown ||
+			this.#host.matches(`.${CSS.escape(this.#classes.disabled)}, :disabled`)
+		)
+	}
+
+	// Reports whether the call still holds its change: the dropdown is live, no later call started a
+	// change, and the menu carries its `shown` token exactly when `shown` is true.
+	#holds(change: object, shown: boolean): boolean {
+		return (
+			!this.#controller.signal.aborted &&
+			this.#change === change &&
+			this.#menu.classList.contains(this.#classes.shown) === shown
+		)
+	}
+
+	// Runs one write a reaction can run inside, then reads whether the call still holds its change.
+	#apply(change: object, shown: boolean, write: () => void): boolean {
+		write()
+		return this.#holds(change, shown)
+	}
+
+	// Places the menu against its reference, or returns undefined when the platform refused the
+	// promotion, which the placement reports after restoring what it wrote.
+	#place(): PlacementInterface | undefined {
+		try {
+			return new Placement(
+				{ reference: this.#reference, element: this.#menu },
+				{
+					attributes: { popper: this.#attributes.popper, side: this.#attributes.side },
+					position: this.#position(),
+					offset: this.#offset,
+					static: this.#static || this.#host.closest(this.#selectors.navbar) !== null,
+					signal: this.#controller.signal,
+				},
+			)
+		} catch (error) {
+			if (isAppError(error) && error.code === 'PLACEMENT_PROMOTION_REFUSED') return undefined
+			throw error
+		}
+	}
+
+	// Dispatches the hide event carrying the click that closes the menu, then restores the placement
+	// and writes the hidden state, reading the menu at each door.
+	#conceal(click: MouseEvent | undefined): boolean {
+		if (this.#refused(false)) return false
+		if (!emitEvent(this.#host, DROPDOWN_EVENTS.hide, { click }, true)) return false
+		if (this.#refused(false)) return false
+		const change = {}
+		this.#change = change
+		try {
+			const host = this.#host
+			const menu = this.#menu
+			const { shown } = this.#classes
+			this.#save()
+			// The dropdown keeps the placement until its restoration returns, so a destroy called from a
+			// listener inside that restoration completes it.
+			this.#placement?.destroy()
+			this.#placement = undefined
+			if (!this.#holds(change, true)) return false
+			if (!this.#apply(change, false, () => menu.classList.remove(shown))) return false
+			if (!this.#apply(change, false, () => host.classList.remove(shown))) return false
+			if (!this.#apply(change, false, () => host.setAttribute('aria-expanded', 'false'))) {
+				return false
+			}
+			this.#change = undefined
+			emitEvent(host, DROPDOWN_EVENTS.hidden, { click }, false)
+			return !this.#controller.signal.aborted
+		} finally {
+			if (this.#change === change) this.#change = undefined
+		}
+	}
+
+	// Hides the open menu for a click or a Tab key release its dismissal allows: a click on the toggle
+	// never counts, a secondary button never counts, a click inside the menu counts when `dismiss.inside`
+	// is true unless it lands on a form control, and a click or Tab release outside it counts when
+	// `dismiss.outside` is true. A click travels into the events as their `click` detail.
+	#lightDismiss(event: Event): void {
+		if (!this.shown) return
+		const click = isInstance(event, MouseEvent) && event.type === 'click' ? event : undefined
+		if (click === undefined && !(isInstance(event, KeyboardEvent) && event.key === 'Tab')) return
+		if (click?.button === 2) return
+		const path = event.composedPath()
+		if (path.includes(this.#host)) return
+		const inside = path.includes(this.#menu)
+		if (!(inside ? this.#dismiss.inside : this.#dismiss.outside)) return
+		const target = event.target
+		if (
+			inside &&
+			(click === undefined ||
+				(isInstance(target, Element) && /input|select|option|textarea|form/i.test(target.tagName)))
+		) {
+			return
+		}
+		this.#conceal(click)
+	}
+
+	// Returns the first HTML element the `menu` selector matches after the toggle among its siblings,
+	// then before it, then inside its parent.
+	#locate(host: HTMLElement): HTMLElement | undefined {
+		const selector = this.#selectors.menu
+		for (let sibling = host.nextElementSibling; sibling; sibling = sibling.nextElementSibling) {
+			if (sibling.matches(selector) && isInstance(sibling, HTMLElement)) return sibling
+		}
+		for (
+			let sibling = host.previousElementSibling;
+			sibling;
+			sibling = sibling.previousElementSibling
+		) {
+			if (sibling.matches(selector) && isInstance(sibling, HTMLElement)) return sibling
+		}
+		return Array.from(host.parentElement?.querySelectorAll(selector) ?? []).find(
+			instanceOf(HTMLElement),
+		)
+	}
+
+	// Resolves the reference the attribute `attributes.reference` names: `toggle` for the toggle and
+	// `parent` for its parent element, the toggle when the attribute is absent.
+	#resolveReference(host: HTMLElement): HTMLElement {
+		const name = this.#attributes.reference
+		const value = host.getAttribute(name)
+		if (value === null) return host
+		const reference = parseEnum(value, ['toggle', 'parent'])
+		const parent = host.parentElement
+		if (reference === 'toggle') return host
+		if (reference === 'parent' && isInstance(parent, HTMLElement)) return parent
+		throw new AppError('Option value fails coercion', 'DROPDOWN_OPTION_INVALID', {
+			attribute: name,
+			tag: host.tagName,
+		})
+	}
+
+	// Reads the position the menu opens at from the direction tokens on the toggle's parent and the
+	// menu's `--bs-position` property, as Bootstrap's placement does.
+	#position(): PlacementPosition {
+		const tokens = this.#host.parentElement?.classList
+		const { up, end, start, center } = this.#classes
+		if (tokens?.contains(end)) return 'right-start'
+		if (tokens?.contains(start)) return 'left-start'
+		if (tokens?.contains(center.up)) return 'top'
+		if (tokens?.contains(center.down)) return 'bottom'
+		const aligned = getComputedStyle(this.#menu).getPropertyValue('--bs-position').trim() === 'end'
+		if (tokens?.contains(up)) return aligned ? 'top-end' : 'top-start'
+		return aligned ? 'bottom-end' : 'bottom-start'
+	}
+
+	// Records the `shown` tokens and the toggle's `aria-expanded` value before the first write, so
+	// destruction restores them.
+	#save(): void {
+		const { shown } = this.#classes
+		this.#snapshot.save({ category: 'token', element: this.#host, name: shown })
+		this.#snapshot.save({ category: 'token', element: this.#menu, name: shown })
+		this.#snapshot.save({ category: 'attribute', element: this.#host, name: 'aria-expanded' })
+	}
+}
