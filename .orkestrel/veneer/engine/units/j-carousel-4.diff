+ * A tab dispatches each event with the other control of the swap as the detail's `relatedTarget`,
+ * or undefined when no control was active, so a consumer's own event under a tab wire name that
+ * carries no detail, or another value there, is refused. The containment covers a `relatedTarget`
+ * accessor that throws, as the button event guard does.
+ * @example
+ * ```ts
+ * isTabEvent(new CustomEvent('shown.vn.tab', { detail: { relatedTarget: undefined } })) // true
+ * isTabEvent(new CustomEvent('shown.vn.tab')) // false
+ * ```
+ */
+export function isTabEvent(value: unknown): value is TabEventMap['show'] {
+	try {
+		if (!isInstance(value, CustomEvent)) return false
+		const detail: unknown = value.detail
+		if (typeof detail !== 'object' || detail === null) return false
+		const related = 'relatedTarget' in detail ? detail.relatedTarget : undefined
+		return related === undefined || isInstance(related, HTMLElement)
+	} catch {
+		return false
+	}
