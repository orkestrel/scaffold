+/**
+ * Reads the value a piece of host state holds, as a `HostSnapshot` instance records it.
+ *
+ * @param target - The attribute, class token, or inline property to read.
+ * @returns The attribute's value, the token's name when the element carries it, or the property's value; undefined when the target is absent.
+ * @remarks
+ * An empty inline property value reads as absent, as the platform reports an unset property.
+ * @example
+ * ```ts
+ * const prior = readHostValue({ category: 'token', element: panel, name: 'show' }) // 'show' or undefined
+ * ```
+ */
+export function readHostValue(target: HostSnapshotTarget): string | undefined {
+	const { category, element, name } = target
+	if (category === 'attribute') return element.getAttribute(name) ?? undefined
+	if (category === 'token') return element.classList.contains(name) ? name : undefined
+	return element.style.getPropertyValue(name) || undefined
+}
+
+/**
+ * Reads the priority an inline property carries, as a `HostSnapshot` instance records it.
+ *
+ * @param target - The attribute, class token, or inline property to read.
+ * @returns The inline property's priority, such as `important`; the empty string for a property without one, an absent property, an attribute, or a class token.
+ * @example
+ * ```ts
+ * const priority = readHostPriority({ category: 'property', element: panel, name: 'height' }) // 'important' or ''
+ * ```
+ */
+export function readHostPriority(target: HostSnapshotTarget): string {
+	const { category, element, name } = target
+	return category === 'property' ? element.style.getPropertyPriority(name) : ''
+}
+
+/**
+ * Writes a value to a piece of host state, in the form the `readHostValue` function reads it.
+ *
+ * @param target - The attribute, class token, or inline property to write.
+ * @param value - The attribute's or property's value, or any string for a token the element carries; undefined removes the target.
+ * @param priority - The inline property's priority, in the form the `readHostPriority` function reads it; an attribute or a token write ignores it. Default: the empty string, which sets the property without a priority.
+ * @remarks
+ * A token write toggles the token with an explicit force, so a token already in that state takes no
+ * write. An attribute or property write always writes.
+ * @example
+ * ```ts
+ * writeHostValue({ category: 'attribute', element: trigger, name: 'aria-expanded' }, 'true')
+ * ```
+ */
+export function writeHostValue(
+	target: HostSnapshotTarget,
+	value: string | undefined,
+	priority = '',
+): void {
+	const { category, element, name } = target
+	if (category === 'token') element.classList.toggle(name, value !== undefined)
+	else if (category === 'attribute') {
+		if (value === undefined) element.removeAttribute(name)
+		else element.setAttribute(name, value)
+	} else if (value === undefined) element.style.removeProperty(name)
+	else element.style.setProperty(name, value, priority)
+}
+
+/**
+ * Records a target a write is about to change, returning a change's records with the target and the value and priority it reads appended.
+ *
+ * @param changes - The records the change holds so far, in the order of its first writes.
+ * @param target - The attribute, class token, or inline property the write gives a value.
+ * @param next - The value the write gives the target, in the form the `readHostValue` function reads it.
+ * @returns The records unchanged when the change recorded the target already or the write leaves the target as it reads; otherwise a copy with the target and its value and priority appended.
+ * @remarks
+ * A target is recorded once, at the first write that changes it, so a later write to the same target
+ * keeps the value and priority it held before the change began writing it. The write gives no
+ * priority, so it changes an inline property that carries one even when it writes the value the
+ * property holds. The records passed in are not changed.
+ * @example
+ * ```ts
+ * changes = recordHostChange(changes, { category: 'token', element: panel, name: 'collapsing' }, 'collapsing')
+ * ```
+ */
+export function recordHostChange(
+	changes: readonly HostChange[],
+	target: HostSnapshotTarget,
+	next: string | undefined,
+): readonly HostChange[] {
+	const { category, element, name } = target
+	const recorded = changes.some(
+		(change) =>
+			change.target.category === category &&
+			change.target.element === element &&
+			change.target.name === name,
+	)
+	if (recorded) return changes
+	const prior = readHostValue(target)
+	const priority = readHostPriority(target)
+	return prior === next && priority === '' ? changes : [...changes, { target, prior, priority }]
+}
+
+/**
+ * Writes each recorded target back to the value and priority it held before the change's first write to it, in reverse order of those first writes.
+ *
+ * @param changes - The records a change holds, in the order of its first writes.
+ * @param owns - Reports whether the change still owns its host; read before each write.
+ * @remarks
+ * A target that already reads its recorded value and priority takes no write. The first read of
+ * `owns` that returns `false` ends the step, so a destruction or a later change a reaction starts
+ * inside one write stops the writes after it.
+ * @example
+ * ```ts
+ * rewindHostChanges(changes, () => !signal.aborted)
+ * ```
+ */
+export function rewindHostChanges(changes: readonly HostChange[], owns: () => boolean): void {
+	for (const { target, prior, priority } of [...changes].reverse()) {
+		if (!owns()) return
+		if (readHostValue(target) !== prior || readHostPriority(target) !== priority) {
+			writeHostValue(target, prior, priority)
+		}
+	}
+}
