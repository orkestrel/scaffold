+/**
+ * Checks whether an attribute value is a URL the platform's URL parser reads as a `javascript:` URL.
+ *
+ * @param value - The attribute's value, as the element holds it.
+ * @returns True if the value parses as an absolute URL whose scheme is `javascript`; false otherwise,
+ *   including for a relative URL and for a value the parser refuses.
+ * @remarks
+ * The platform's parser, not a pattern, reads the scheme: it strips leading and trailing spaces and
+ * control characters, removes every tab and newline, and lowercases the scheme, so `JAVASCRIPT:`,
+ * ` javascript:`, and `java\tscript:` all match, while `%6Aavascript:` is a relative path and does
+ * not. A relative URL resolves against a base whose scheme it keeps, so no base can turn one into a
+ * `javascript:` URL, and none is read.
+ * @example
+ * ```ts
+ * matchesScriptURL('java\tscript:alert(1)') // true
+ * matchesScriptURL('/help') // false
+ * ```
+ */
+export function matchesScriptURL(value: string): boolean {
+	return URL.parse(value)?.protocol === 'javascript:'
+}
