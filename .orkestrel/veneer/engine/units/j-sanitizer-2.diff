+import type { ConfigSanitizerOptions, SanitizerConfig, SanitizerInterface } from '../types.js'
+import { AppError } from '@src/core'
+import { isInstance } from '@orkestrel/contract'
+import { SANITIZER_ALLOWLIST } from '../constants.js'
+import {
+	matchesBaselineAttribute,
+	matchesBaselineElement,
+	matchesKeptAttribute,
+	matchesKeptElement,
+	readTag,
+} from '../helpers.js'
+import { isSanitizerConfig, isSanitizeTarget } from '../validators.js'
+
+/**
+ * Writes markup into an element through one sanitizer configuration, by the element's `setHTML` method where it has one and by a walk of the parsed markup otherwise.
+ *
+ * @remarks
+ * The sanitizer holds one `SanitizerConfig` dictionary, a frozen copy of the `config` option or, by
+ * default, the `SANITIZER_ALLOWLIST` constant built from Bootstrap's allowlist. Each write reads
+ * whether the element carries a `setHTML` method, through the `isSanitizeTarget` guard, and passes
+ * the dictionary as that method's `sanitizer` option when it does. Where it does not, as on
+ * Chromium 141, the markup is parsed through the `innerHTML` property of an element with the target's
+ * namespace and local name, created in an inert document from the target document's
+ * `implementation`, so the parse runs in the target's context as the `setHTML` method's does, and
+ * the parsed tree is walked: an element the configuration does not keep is removed with its content,
+ * an attribute it does not keep is removed, a comment is removed, text and processing instructions
+ * stay, and a kept `template` element's content is walked as well. The `SANITIZER_BASELINE` floor
+ * applies whatever the configuration lists, and it removes more than the platform in the places the
+ * `SanitizerBaseline` type names. The survivors move into the element, or into its content when it is
+ * a `template` element, with nothing serialized again. No engine file constructs or names the
+ * platform's `Sanitizer` class: the dictionary is the configuration.
+ *
+ * The walk reads nodes through this window's constructors, so a node from another window's document
+ * is removed. The `innerHTML` property attaches no declarative shadow root, so a `template` element
+ * carrying a `shadowrootmode` attribute stays a `template` element on the walk, with its content
+ * walked, where the `setHTML` method attaches the shadow root; inserting the walked `template`
+ * element attaches none either. Assigning markup to the `innerHTML` property is a Trusted Types
+ * sink, so on a page that requires Trusted Types for scripts the walk throws the platform's
+ * `TypeError`, where the `setHTML` method would not. A failure the walk or `setHTML` throws, such as
+ * that refusal, reaches the caller unchanged and leaves the element's children as they were.
+ *
+ * @example
+ * ```ts
+ * const sanitizer = new ConfigSanitizer()
+ * sanitizer.write(slot, '<b>Saved</b>')
+ * ```
+ */
+export class ConfigSanitizer implements SanitizerInterface {
+	readonly #config: SanitizerConfig
+
+	/**
+	 * Validates the configuration and holds a frozen copy of it.
+	 *
+	 * @param options - The sanitizer configuration; an absent `config` selects `SANITIZER_ALLOWLIST`.
+	 * @throws Thrown when the `config` option is not a configuration the `isSanitizerConfig` guard admits, such as a `dataAttributes` field without an `attributes` list, as an `AppError` carrying the `SANITIZER_OPTION_INVALID` code.
+	 */
+	constructor(options?: ConfigSanitizerOptions) {
+		const config = options?.config
+		if (config === undefined) {
+			this.#config = SANITIZER_ALLOWLIST
+			return
+		}
+		// A structured clone reads the caller's object once, so the copy validated is the copy held, and
+		// a value the clone cannot copy, such as a function or a proxy, fails validation.
+		let copy: unknown
+		try {
+			copy = structuredClone(config)
+		} catch {
+			copy = undefined
+		}
+		if (!isSanitizerConfig(copy)) {
+			throw new AppError('The sanitizer configuration is invalid', 'SANITIZER_OPTION_INVALID', {
+				key: 'config',
+			})
+		}
+		for (const entry of copy.elements ?? []) {
+			if (typeof entry === 'string') continue
+			Object.freeze(entry.attributes)
+			Object.freeze(entry)
+		}
+		Object.freeze(copy.elements)
+		Object.freeze(copy.attributes)
+		this.#config = Object.freeze(copy)
+	}
+
+	/**
+	 * Replaces the element's children with the markup the configuration and the safety floor keep.
+	 *
+	 * @param element - The element whose children are replaced.
+	 * @param html - The markup to sanitize and write.
+	 * @throws Thrown when the `SANITIZER_BASELINE` floor removes the element itself, such as a `script` or `iframe` element, as an `AppError` carrying the `SANITIZER_TARGET_INVALID` code, before any write.
+	 */
+	write(element: Element, html: string): void {
+		if (matchesBaselineElement(element)) {
+			throw new AppError(
+				'The sanitizer refuses to write into this element',
+				'SANITIZER_TARGET_INVALID',
+				{
+					tag: readTag(element),
+				},
+			)
+		}
+		if (isSanitizeTarget(element)) {
+			element.setHTML(html, { sanitizer: this.#config })
+			return
+		}
+		// The inert document has no browsing context, so the parse runs no script and loads nothing, and
+		// its context element parses the markup as the target itself would.
+		const inert = element.ownerDocument.implementation.createHTMLDocument('')
+		const context = inert.createElementNS(element.namespaceURI, element.localName)
+		context.innerHTML = html
+		const parsed = isInstance(context, HTMLTemplateElement) ? context.content : context
+		this.#clean(parsed)
+		const destination = isInstance(element, HTMLTemplateElement) ? element.content : element
+		destination.replaceChildren(...Array.from(parsed.childNodes))
+	}
+
+	// Walks a snapshot of the parent's children, so a removal never skips a sibling, and recurses into
+	// every kept element and into a kept template's content.
+	#clean(parent: Node): void {
+		for (const node of Array.from(parent.childNodes)) {
+			if (!isInstance(node, Element)) {
+				if (
+					node.nodeType !== Node.TEXT_NODE &&
+					node.nodeType !== Node.PROCESSING_INSTRUCTION_NODE
+				) {
+					node.remove()
+				}
+				continue
+			}
+			if (matchesBaselineElement(node) || !matchesKeptElement(node, this.#config)) {
+				node.remove()
+				continue
+			}
+			for (const attribute of Array.from(node.attributes)) {
+				if (
+					matchesBaselineAttribute(node, attribute) ||
+					!matchesKeptAttribute(node, attribute, this.#config)
+				) {
+					node.removeAttributeNode(attribute)
+				}
+			}
