+			'bottom',
+			'bottom-start',
+			'bottom-end',
+			'left',
+			'left-start',
+			'left-end',
+		]) {
+			expect(parsePosition(position)).toBe(position)
+		}
+		expect(parsePosition('start')).toBeUndefined()
+		expect(parsePosition(' top')).toBeUndefined()
+		expect(parsePosition('Top')).toBeUndefined()
+		expect(parsePosition('')).toBeUndefined()
+		expect(parsePosition(1)).toBeUndefined()
+	})
+})
+
+describe('parseFallbacks', () => {
+	it('reads a comma-separated list, a JSON array, and an array of placement strings in order', () => {
+		expect(parseFallbacks('top, bottom')).toEqual(['top', 'bottom'])
+		expect(parseFallbacks('left')).toEqual(['left'])
+		expect(parseFallbacks('["right", "top-start"]')).toEqual(['right', 'top-start'])
+		expect(parseFallbacks(['bottom', 'left'])).toEqual(['bottom', 'left'])
+	})
+
+	it('refuses an unknown member, an empty list, an empty member, and a value of another type', () => {
+		expect(parseFallbacks('top,middle')).toBeUndefined()
+		expect(parseFallbacks('')).toBeUndefined()
+		expect(parseFallbacks('top,')).toBeUndefined()
+		expect(parseFallbacks('[]')).toBeUndefined()
+		expect(parseFallbacks('["top", 1]')).toBeUndefined()
+		expect(parseFallbacks([])).toBeUndefined()
+		expect(parseFallbacks(7)).toBeUndefined()
+		const hostile = ['top']
+		Object.defineProperty(hostile, Symbol.iterator, {
+			value: () => {
+				throw new Error('Unreadable')
+			},
+		})
+		expect(parseFallbacks(hostile)).toBeUndefined()
+	})
+})
