+		const original = MutationObserver.prototype.disconnect
+		const recording = recordCalls(MutationObserver.prototype, 'disconnect')
+		const target = build('div')
+		const observer = new MutationObserver(() => {})
+		try {
+			observer.observe(target, { attributes: true })
+			observer.disconnect()
+			target.setAttribute('data-probe', '')
+			expect(observer.takeRecords()).toEqual([])
+			expect(recording.recorder.calls).toEqual([[observer]])
+		} finally {
+			recording.restore()
+		}
+		recording.restore()
+		expect(MutationObserver.prototype.disconnect).toBe(original)
+		observer.disconnect()
+		expect(recording.recorder.count).toBe(1)
+	})
