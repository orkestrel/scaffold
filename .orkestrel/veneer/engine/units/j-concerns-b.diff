@@ -312,6 +312,79 @@ describe('Dropdown', () => {
 		expect(properties.map((name) => style.getPropertyValue(name))).toEqual(unpromoted)
 	})
 
+	// Bootstrap's dropdown dispatches `shown.bs.dropdown` and `hidden.bs.dropdown` without waiting on a
+	// transition, so a menu animation is cascade feedback the events do not wait for. The planted rule
+	// stands for any entry and exit motion a cascade gives the menu: it fades the menu in from its
+	// starting style and keeps it displayed while it fades out.
+	it('dispatches shown and hidden inside the call while a transition the cascade gives the menu still runs', async () => {
+		scene.load(dropdownCascade)
+		scene.load(`
+			.dropdown-menu { transition: opacity 100ms linear, display 100ms allow-discrete }
+			.dropdown-menu:not(.show) { opacity: 0 }
+			@starting-style { .dropdown-menu.show { opacity: 0 } }`)
+		const root = scene.mount(`
+			<div class="dropdown">
+				<button type="button" id="toggle" data-bs-toggle="dropdown">Menu</button>
+				<ul class="dropdown-menu"><li><button type="button" class="dropdown-item">One</button></li></ul>
+			</div>`)
+		const toggle = requireValue(root.querySelector<HTMLElement>('#toggle'), 'No toggle')
+		const menu = requireValue(root.querySelector<HTMLElement>('.dropdown-menu'), 'No menu')
+		// Each event records the menu's animations as it arrives, and records once more when all of them
+		// have finished, so the order shows whether the event came before the motion ended.
+		const order = createRecorder<readonly [string]>()
+		const motions = createRecorder<readonly [string, ReadonlyArray<readonly [string, number]>]>()
+		const controller = new AbortController()
+		onTestFinished(() => controller.abort())
+		for (const name of [DROPDOWN_EVENTS.shown, DROPDOWN_EVENTS.hidden]) {
+			toggle.addEventListener(
+				name,
+				(event) => {
+					order.handler(event.type)
+					const running = menu.getAnimations()
+					void Promise.all(running.map((animation) => animation.finished)).then(() =>
+						order.handler('ended'),
+					)
+					motions.handler(
+						event.type,
+						running.map((animation): readonly [string, number] => {
+							const duration = animation.effect?.getComputedTiming().duration
+							return [animation.playState, typeof duration === 'number' ? duration : 0]
+						}),
+					)
+				},
+				{ signal: controller.signal },
+			)
+		}
+		const dropdown = new Dropdown(toggle)
+		onTestFinished(() => dropdown.destroy())
+		const showing = dropdown.show()
+		expect(order.calls).toEqual([['shown.vn.dropdown']])
+		expect(await showing).toBe(true)
+		await waitForCondition('the entry transition ends', () => order.count === 2)
+		const hiding = dropdown.hide()
+		expect(order.calls).toEqual([['shown.vn.dropdown'], ['ended'], ['hidden.vn.dropdown']])
+		expect(await hiding).toBe(true)
+		await waitForCondition('the exit transition ends', () => order.count === 4)
+		expect(order.calls).toEqual([
+			['shown.vn.dropdown'],
+			['ended'],
+			['hidden.vn.dropdown'],
+			['ended'],
+		])
+		// Each event arrived while at least one animation ran on the menu, and each of them was a real
+		// motion with a positive duration.
+		expect(
+			motions.calls.map(([name, running]) => [
+				name,
+				running.length > 0 &&
+					running.every(([state, duration]) => state === 'running' && duration > 0),
+			]),
+		).toEqual([
+			['shown.vn.dropdown', true],
+			['hidden.vn.dropdown', true],
+		])
+	})
+
