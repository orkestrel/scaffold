+		)
+		const host = requireValue(root.querySelector<HTMLElement>('#trigger'), 'No trigger')
+		const events = createRecorder<readonly [string]>()
+		const listeners = new AbortController()
+		onTestFinished(() => listeners.abort())
+		for (const name of Object.values(POPOVER_EVENTS)) {
+			host.addEventListener(name, (event) => events.handler(event.type), {
+				signal: listeners.signal,
+			})
+		}
+		const popover = new Popover(host)
+		onTestFinished(() => popover.destroy())
+		const trigger = host.outerHTML
+		const children = Array.from(document.body.children)
+		const prevention = new AbortController()
