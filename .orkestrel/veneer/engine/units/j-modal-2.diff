@@ -0,0 +1,106 @@
+import type { ScrollLockInterface, ScrollLockOptions } from './types.js'
+import { instanceOf } from '@orkestrel/contract'
+import { SCROLL_LOCK_SELECTORS } from './constants.js'
+import { resolveVocabulary } from './helpers.js'
+import { HostSnapshot } from './HostSnapshot.js'
+import { isSelector } from './validators.js'
+
+/**
+ * Holds one reference to a document's scroll lock, which hides the body's overflow and compensates for the scrollbar it hides.
+ *
+ * @remarks
+ * The locks of one document share one reference count. The first lock measures the scrollbar's
+ * width as the window's inner width less the root element's client width, writes `overflow: hidden`
+ * on the body, and adds that width to the computed `padding-right` of the body and of every element
+ * the `:is({fixed}, {sticky})` selector matches in it, and subtracts it from the computed
+ * `margin-right` of every element the `sticky` selector matches, each as an inline pixel value. An
+ * element other than the body is compensated only when it spans the window's width, as Bootstrap's
+ * `ScrollBarHelper` compensates it. Later locks of the same document write nothing, and the selectors
+ * of the lock that wrote are the ones compensated. A document with no window has no scrollbar to
+ * measure, so its first lock writes `overflow: hidden` alone. One snapshot records every value
+ * before it is written, and the release that returns the count to zero restores them.
+ *
+ * @example
+ * ```ts
+ * const lock = new ScrollLock()
+ * lock.destroy()
+ * ```
+ */
+export class ScrollLock implements ScrollLockInterface {
+	static readonly #locks = new WeakMap<
+		Document,
+		{ readonly holders: Set<ScrollLock>; readonly snapshot: HostSnapshot }
+	>()
+	readonly #document: Document
+
+	/**
+	 * Takes one reference to the document's scroll lock, locking the document when it holds no other.
+	 *
+	 * @param options - The document to lock and the selectors to compensate.
+	 * @throws Thrown when a `selectors` value is not a selector, as an `AppError` carrying the `SCROLL_LOCK_OPTION_INVALID` code.
+	 */
+	constructor(options?: ScrollLockOptions) {
+		const selectors = resolveVocabulary(
+			'SCROLL_LOCK_OPTION_INVALID',
+			SCROLL_LOCK_SELECTORS,
+			isSelector,
+			options?.selectors,
+		)
+		this.#document = options?.document ?? document
+		const held = ScrollLock.#locks.get(this.#document)
+		if (held !== undefined) {
+			held.holders.add(this)
+			return
+		}
+		const snapshot = new HostSnapshot()
+		ScrollLock.#locks.set(this.#document, { holders: new Set([this]), snapshot })
+		const { body, documentElement, defaultView } = this.#document
+		const width =
+			defaultView === null ? 0 : Math.abs(defaultView.innerWidth - documentElement.clientWidth)
+		snapshot.save({ category: 'property', element: body, name: 'overflow' })
+		body.style.setProperty('overflow', 'hidden')
+		if (defaultView === null) return
+		const { fixed, sticky } = selectors
+		// Bootstrap reads each element's width after the overflow is hidden, against the width the
+		// hidden scrollbar leaves, so an element narrower than the window keeps its own spacing.
+		const remaining = Math.abs(defaultView.innerWidth - documentElement.clientWidth)
+		const padded = [
+			body,
+			...Array.from(body.querySelectorAll(`:is(${fixed}, ${sticky})`)).filter(
+				instanceOf(HTMLElement),
+			),
+		].filter(
+			(element) => element === body || defaultView.innerWidth <= element.clientWidth + remaining,
+		)
+		for (const element of padded) {
+			const computed = Number.parseFloat(
+				defaultView.getComputedStyle(element).getPropertyValue('padding-right'),
+			)
+			snapshot.save({ category: 'property', element, name: 'padding-right' })
+			element.style.setProperty('padding-right', `${computed + width}px`)
+		}
+		for (const element of padded.filter(
+			(candidate) => candidate !== body && candidate.matches(sticky),
+		)) {
+			const computed = Number.parseFloat(
+				defaultView.getComputedStyle(element).getPropertyValue('margin-right'),
+			)
+			snapshot.save({ category: 'property', element, name: 'margin-right' })
+			element.style.setProperty('margin-right', `${computed - width}px`)
+		}
+	}
+
+	get document(): Document {
+		return this.#document
+	}
+
+	destroy(): void {
+		const held = ScrollLock.#locks.get(this.#document)
+		if (held === undefined || !held.holders.delete(this)) return
+		if (held.holders.size > 0) return
+		// The count leaves the record before the restoration, so a lock taken in reaction to a
+		// restoring write starts a fresh count, and its snapshot takes the values still to write back.
+		ScrollLock.#locks.delete(this.#document)
+		held.snapshot.restore()
+	}
+}
