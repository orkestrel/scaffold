+	// Each of the following cases drives a custom element beside the modal whose `inert` reaction runs
+	// inside the isolation's construction, before the modal has stored the isolation.
+	it('stops the isolation whose inert write a reaction answers by destroying the modal, releasing its claims and writing nothing more', async () => {
+		const name = 'vn-modal-inert-destroyer'
