diff --git a/tests/src/browser/ScrollLock.test.ts b/tests/src/browser/ScrollLock.test.ts
new file mode 100644
index 0000000..3bb5c37
--- /dev/null
+++ b/tests/src/browser/ScrollLock.test.ts
@@ -0,0 +1,119 @@
+import { SCROLL_LOCK_SELECTORS, ScrollLock } from '@src/browser'
+import { attempt } from '@orkestrel/contract'
+import { requireValue } from '@orkestrel/test'
+import { afterEach, describe, expect, it, onTestFinished } from 'vitest'
+import { scene } from '../../setupBrowser.js'
+
+afterEach(() => scene.clear())
+
+describe('ScrollLock', () => {
+	const cascade = `
+		.fixed-top, .fixed-bottom, .is-fixed, .sticky-top { padding-right: 4px }
+		.fixed-top, .fixed-bottom, .is-fixed { position: fixed; left: 0; right: 0 }
+		.sticky-top { position: sticky; top: 0; width: 100vw; margin-right: 3px }
+		.narrow { right: auto; width: 40px }`
+	const markup = `
+		<div class="fixed-top" id="top"></div>
+		<div class="fixed-bottom narrow" id="narrow"></div>
+		<div class="sticky-top" id="sticky"></div>
+		<div class="is-fixed" id="fixed"></div>`
+
+	it('publishes a frozen default table naming Bootstrap fixed and sticky selectors', () => {
+		expect(SCROLL_LOCK_SELECTORS).toStrictEqual({
+			fixed: '.fixed-top, .fixed-bottom, .is-fixed',
+			sticky: '.sticky-top',
+		})
+		expect(Object.isFrozen(SCROLL_LOCK_SELECTORS)).toBe(true)
+	})
+
+	it('hides the body overflow and pads the body and the full-width fixed and sticky elements by the scrollbar width, restoring them on release', () => {
+		scene.load(cascade)
+		const root = scene.mount(markup)
+		const top = requireValue(root.querySelector<HTMLElement>('#top'), 'No fixed top')
+		const narrow = requireValue(root.querySelector<HTMLElement>('#narrow'), 'No narrow element')
+		const sticky = requireValue(root.querySelector<HTMLElement>('#sticky'), 'No sticky element')
+		const fixed = requireValue(root.querySelector<HTMLElement>('#fixed'), 'No fixed element')
+		const body = document.body
+		const styled = body.getAttribute('style')
+		// This host launches Chromium with hidden scrollbars, so the width reads zero here; the
+		// compensation is asserted against the reading the host gives, as the lock measures it.
+		const width = window.innerWidth - document.documentElement.clientWidth
+		const padding = Number.parseFloat(getComputedStyle(body).paddingRight)
+		const lock = new ScrollLock()
+		onTestFinished(() => lock.destroy())
+		expect(lock.document).toBe(document)
+		expect(body.style.overflow).toBe('hidden')
+		expect(body.style.paddingRight).toBe(`${padding + width}px`)
+		expect(top.style.paddingRight).toBe(`${4 + width}px`)
+		expect(fixed.style.paddingRight).toBe(`${4 + width}px`)
+		expect(sticky.style.paddingRight).toBe(`${4 + width}px`)
+		expect(sticky.style.marginRight).toBe(`${3 - width}px`)
+		expect(top.style.marginRight).toBe('')
+		expect(narrow.hasAttribute('style')).toBe(false)
+		lock.destroy()
+		expect(body.getAttribute('style')).toBe(styled)
+		for (const element of [top, narrow, sticky, fixed]) {
+			expect(element.hasAttribute('style')).toBe(false)
+		}
+	})
+
+	it('shares one lock among the references of one document, restoring the originals at the last release', () => {
+		const body = document.body
+		const styled = body.getAttribute('style')
+		onTestFinished(() => {
+			if (styled === null) body.removeAttribute('style')
+			else body.setAttribute('style', styled)
+		})
+		body.style.setProperty('overflow', 'scroll')
+		const first = new ScrollLock()
+		const second = new ScrollLock({ document })
+		onTestFinished(() => first.destroy())
+		onTestFinished(() => second.destroy())
+		expect(body.style.overflow).toBe('hidden')
+		first.destroy()
+		first.destroy()
+		expect(body.style.overflow).toBe('hidden')
+		second.destroy()
+		expect(body.style.overflow).toBe('scroll')
+		const third = new ScrollLock()
+		onTestFinished(() => third.destroy())
+		expect(body.style.overflow).toBe('hidden')
+		third.destroy()
+		expect(body.style.overflow).toBe('scroll')
+	})
+
+	it('compensates the elements the selectors of the lock that wrote match, and refuses a selector that fails to parse', () => {
+		const root = scene.mount(`
+			<div class="banner" id="banner" style="position: fixed; left: 0; right: 0"></div>
+			<div class="fixed-top" id="top" style="position: fixed; left: 0; right: 0"></div>`)
+		const banner = requireValue(root.querySelector<HTMLElement>('#banner'), 'No banner')
+		const top = requireValue(root.querySelector<HTMLElement>('#top'), 'No fixed top')
+		const lock = new ScrollLock({ selectors: { fixed: '.banner' } })
+		const later = new ScrollLock()
+		onTestFinished(() => lock.destroy())
+		onTestFinished(() => later.destroy())
+		expect(banner.style.paddingRight).not.toBe('')
+		expect(top.style.paddingRight).toBe('')
+		expect(attempt(() => new ScrollLock({ selectors: { sticky: '.sticky[' } }))).toMatchObject({
+			success: false,
+			error: { code: 'SCROLL_LOCK_OPTION_INVALID', context: { key: 'sticky' } },
+		})
+	})
+
+	it('writes the overflow alone on a document with no window, and restores it', () => {
+		const detached = document.implementation.createHTMLDocument('detached')
+		detached.body.innerHTML =
+			'<div class="fixed-top" style="position: fixed; left: 0; right: 0"></div>'
+		const lock = new ScrollLock({ document: detached })
+		onTestFinished(() => lock.destroy())
+		expect(detached.defaultView).toBeNull()
+		expect(lock.document).toBe(detached)
+		expect(detached.body.getAttribute('style')).toBe('overflow: hidden;')
+		expect(detached.querySelector('.fixed-top')?.getAttribute('style')).toBe(
+			'position: fixed; left: 0; right: 0',
+		)
+		expect(document.body.style.overflow).not.toBe('hidden')
+		lock.destroy()
+		expect(detached.body.hasAttribute('style')).toBe(false)
+	})
+})
