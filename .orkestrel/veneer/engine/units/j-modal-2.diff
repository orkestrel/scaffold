+import type { ModalInterface } from '@src/browser'
+import {
+	Modal,
+	MODAL_ATTRIBUTES,
+	MODAL_CLASSES,
+	MODAL_DEFAULTS,
+	MODAL_EVENTS,
+	MODAL_SELECTORS,
+} from '@src/browser'
+import { isAppError } from '@src/core'
+import { attempt } from '@orkestrel/contract'
+import { createRecorder, requireValue, waitForCondition } from '@orkestrel/test'
+import { isReachable, pressKeys, releaseMedia, stageMedia } from '@orkestrel/test/browser'
+import { userEvent } from 'vitest/browser'
+import { afterEach, describe, expect, it, onTestFinished } from 'vitest'
+import { recordListeners, scene, visitBreakpoint } from '../../setupBrowser.js'
+
+afterEach(() => scene.clear())
+
+describe('Modal', () => {
+	// No modal key ships under src/styles/components at this commit, so the motion proofs read
+	// Bootstrap's own modal declarations from this test-local sheet: its transitions, its `z-index`
+	// rungs, and the dialog's `pointer-events` pair, which is what lets a press land on the host
+	// beside the dialog.
+	const cascade = `
+		.modal { position: fixed; inset: 0; z-index: 1055; display: none; overflow: hidden auto }
+		.modal-dialog { position: relative; max-width: 500px; margin: 28px auto; pointer-events: none }
+		.modal-content { pointer-events: auto; background: white }
+		.modal.fade .modal-dialog { transition: transform 0.3s ease-out; transform: translateY(-50px) }
+		.modal.show .modal-dialog { transform: none }
+		.modal.modal-static .modal-dialog { transform: scale(1.02) }
+		.modal-backdrop { position: fixed; inset: 0; z-index: 1050 }
+		.modal-backdrop.fade { opacity: 0 }
+		.modal-backdrop.show { opacity: 0.5 }
+		.fade { transition: opacity 0.15s linear }
+		.fade:not(.show) { opacity: 0 }`
+	const markup = `
+		<button type="button" id="opener">Open</button>
+		<div id="dialog" class="modal fade" tabindex="-1" aria-hidden="true">
+			<div class="modal-dialog">
+				<div class="modal-content"><div class="modal-body"><button type="button">Inside</button></div></div>
+			</div>
+		</div>`
+
+	it('publishes frozen default tables that name the cascade tokens, Bootstrap attributes and selectors, the defaults, and wire events', () => {
+		expect(MODAL_CLASSES).toStrictEqual({
+			host: 'modal',
+			shown: 'show',
+			fade: 'fade',
+			static: 'modal-static',
+			open: 'modal-open',
+			backdrop: 'modal-backdrop',
+			disabled: 'disabled',
+		})
+		expect(MODAL_ATTRIBUTES).toStrictEqual({
+			target: 'data-bs-target',
+			backdrop: 'data-bs-backdrop',
+			escape: 'data-bs-keyboard',
+			focus: 'data-bs-focus',
+		})
+		expect(MODAL_SELECTORS).toStrictEqual({
+			trigger: '[data-bs-toggle="modal"]',
+			dismiss: '[data-bs-dismiss="modal"]',
+			dialog: '.modal-dialog',
