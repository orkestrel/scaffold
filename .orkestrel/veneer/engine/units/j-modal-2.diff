+	}
+
+	// Reports whether a call that would leave the modal shown or hidden cannot start: the modal is
+	// destroyed, a change is in flight, or the host already carries the state.
+	#refused(shown: boolean): boolean {
+		return this.#controller.signal.aborted || this.#changing || this.shown === shown
+	}
+
+	// Reports whether the call in flight still holds its change: the modal is live and the host carries
+	// the `shown` token exactly when `shown` is true. A call the host alone took over ends the change in
+	// flight, so a later call can start.
+	#holds(shown: boolean): boolean {
+		const held = !this.#controller.signal.aborted && this.shown === shown
+		if (!held) this.#changing = false
+		return held
+	}
+
+	// Runs one write a reaction or a listener can run inside, then reads whether the call in flight
+	// still holds its change.
+	#apply(shown: boolean, write: () => void): boolean {
+		write()
+		return this.#holds(shown)
+	}
+
+	// Reports whether a bounce may write: the modal is live and shown, and no change is in flight.
+	#idle(): boolean {
+		return !this.#controller.signal.aborted && this.shown && !this.#changing
+	}
+
+	// Records the host's tokens, inline properties, and attributes before the first write, so
+	// destruction restores them.
+	#save(): void {
+		const host = this.#host
+		for (const name of [this.#classes.shown, this.#classes.static]) {
+			this.#snapshot.save({ category: 'token', element: host, name })
+		}
+		for (const name of ['display', 'padding-left', 'padding-right']) {
+			this.#snapshot.save({ category: 'property', element: host, name })
+		}
+		for (const name of ['aria-hidden', 'aria-modal', 'role']) {
+			this.#snapshot.save({ category: 'attribute', element: host, name })
+		}
+	}
+
+	// Pads the host by the scrollbar's width, as Bootstrap's `_adjustDialog` does: on the right when
+	// the document shows a scrollbar and the host does not overflow the viewport, and on the left when
+	// the document shows none and the host overflows it.
+	#adjust(): void {
+		const host = this.#host
+		const { documentElement, defaultView } = host.ownerDocument
+		const width =
+			defaultView === null ? 0 : Math.abs(defaultView.innerWidth - documentElement.clientWidth)
+		const overflowing = host.scrollHeight > documentElement.clientHeight
+		if (width > 0 && !overflowing) host.style.setProperty('padding-right', `${width}px`)
+		if (width === 0 && overflowing) host.style.setProperty('padding-left', `${width}px`)
+	}
+
+	// Holds the `open` token on the document's body, writing it when this modal is its first holder.
+	#holdOpen(document: Document): void {
+		const token = this.#classes.open
+		const tokens = Modal.#opened.get(document) ?? new Map()
+		Modal.#opened.set(document, tokens)
+		const held = tokens.get(token)
+		if (held !== undefined) {
+			held.holders.add(this)
+			return
+		}
+		const snapshot = new HostSnapshot()
+		tokens.set(token, { holders: new Set([this]), snapshot })
+		snapshot.save({ category: 'token', element: document.body, name: token })
+		document.body.classList.add(token)
+	}
+
+	// Releases the `open` token this modal holds on the document's body, restoring the body when this
+	// modal was its last holder.
+	#releaseOpen(document: Document): void {
+		const tokens = Modal.#opened.get(document)
+		const held = tokens?.get(this.#classes.open)
+		if (tokens === undefined || held === undefined || !held.holders.delete(this)) return
+		if (held.holders.size > 0) return
+		tokens.delete(this.#classes.open)
+		held.snapshot.restore()
+	}
+
+	// Hides the modal on Escape, or refuses the hide through the `prevent` event when Escape does
+	// not dismiss it.
+	#escape(event: KeyboardEvent): void {
+		if (event.key !== 'Escape') return
