+/**
+ * Checks whether a DOM event is a modal event, whose detail may name the trigger that asked for the modal.
+ *
+ * @param value - The value to inspect.
+ * @returns True if the value is a CustomEvent whose detail is an object carrying no `relatedTarget` member, or one that is undefined or an HTMLElement; false otherwise.
+ * @remarks
+ * A modal dispatches each event with a detail object whose `relatedTarget` member carries the
+ * trigger passed to `show`, or undefined, so a consumer's own event under a modal wire name that
+ * carries no object, or names something other than an element there, is refused. The class half
+ * reads `isInstance` from `@orkestrel/contract`, which narrows the event to `CustomEvent<unknown>`
+ * and leaves the detail for the object check. The containment covers a `detail` or `relatedTarget`
+ * accessor that throws, as the button event guard does.
+ * @example
+ * ```ts
+ * isModalEvent(new CustomEvent('shown.vn.modal', { detail: { relatedTarget: undefined } })) // true
+ * isModalEvent(new CustomEvent('shown.vn.modal')) // false
+ * ```
+ */
+export function isModalEvent(value: unknown): value is ModalEventMap['show'] {
+	try {
+		if (!isInstance(value, CustomEvent)) return false
+		const detail: unknown = value.detail
+		if (typeof detail !== 'object' || detail === null) return false
+		if (!('relatedTarget' in detail)) return true
+		return detail.relatedTarget === undefined || isInstance(detail.relatedTarget, HTMLElement)
+	} catch {
+		return false
+	}
+}
