+import type { BackdropClassMap, BackdropInterface, BackdropOptions } from './types.js'
+import { BACKDROP_CLASSES } from './constants.js'
+import { reflow, resolveVocabulary, settleAnimations } from './helpers.js'
+import { isClassToken } from './validators.js'
+
+/**
+ * Shows and hides the cascade's own backdrop element behind a modal or an offcanvas panel, in the page's flow.
+ *
+ * @remarks
+ * Construction validates and copies the `classes` group and creates a `div` element carrying the
+ * `host` token, and the `fade` token when `animated` is `true`, in the parent's document. Showing
+ * appends the element to the parent, forces a layout read when animated, adds the `shown` token,
+ * and waits for the fade to settle when animated; hiding removes the `shown` token, waits for the
+ * fade to settle when animated, and removes the element. The element takes no `popover` attribute
+ * and no top-layer promotion, so the cascade's `z-index` rungs order it against the page. A call that
+ * finds the backdrop destroyed or a later call started when it resumes stops and resolves `false`.
+ *
+ * @example
+ * ```ts
+ * const backdrop = new Backdrop({ animated: true })
+ * await backdrop.show()
+ * await backdrop.hide()
+ * backdrop.destroy()
+ * ```
+ */
+export class Backdrop implements BackdropInterface {
+	readonly #element: HTMLElement
+	readonly #parent: HTMLElement
+	readonly #classes: BackdropClassMap
+	readonly #animated: boolean
+	readonly #controller = new AbortController()
+	// The identity of the latest call that started a change, so a call resuming after a later one
+	// started sees that it no longer holds it.
+	#change: object | undefined
+
+	/**
+	 * Creates the backdrop element with its markup vocabulary.
+	 *
+	 * @param options - The parent, whether the backdrop fades, and the markup vocabulary.
+	 * @throws Thrown when a `classes` value is not a class token, as an `AppError` carrying the `BACKDROP_OPTION_INVALID` code.
+	 */
+	constructor(options?: BackdropOptions) {
+		this.#classes = resolveVocabulary(
+			'BACKDROP_OPTION_INVALID',
+			BACKDROP_CLASSES,
+			isClassToken,
+			options?.classes,
+		)
+		this.#parent = options?.parent ?? document.body
+		this.#animated = options?.animated ?? false
+		this.#element = this.#parent.ownerDocument.createElement('div')
+		this.#element.classList.add(this.#classes.host)
+		if (this.#animated) this.#element.classList.add(this.#classes.fade)
+	}
+
+	get element(): HTMLElement {
+		return this.#element
+	}
+
+	async show(): Promise<boolean> {
+		const element = this.#element
+		const { shown } = this.#classes
+		if (this.#controller.signal.aborted || element.classList.contains(shown)) return false
+		const change = {}
+		this.#change = change
+		this.#parent.append(element)
+		if (this.#animated) reflow(element)
+		element.classList.add(shown)
+		if (this.#animated) await settleAnimations(element, this.#controller.signal)
+		return !this.#controller.signal.aborted && this.#change === change
+	}
+
+	async hide(): Promise<boolean> {
+		const element = this.#element
+		const { shown } = this.#classes
+		if (this.#controller.signal.aborted || !element.classList.contains(shown)) return false
+		const change = {}
+		this.#change = change
+		element.classList.remove(shown)
+		if (this.#animated) await settleAnimations(element, this.#controller.signal)
+		if (this.#controller.signal.aborted || this.#change !== change) return false
+		element.remove()
+		return true
+	}
+
+	destroy(): void {
+		if (this.#controller.signal.aborted) return
+		this.#controller.abort()
+		this.#element.remove()
+	}
+}
