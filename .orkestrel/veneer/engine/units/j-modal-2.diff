+		if (!this.#apply(false, () => host.style.removeProperty('padding-right'))) return false
+		this.#lock = undefined
+		if (!this.#apply(false, () => lock?.destroy())) return false
+		this.#changing = false
+		emitEvent(host, MODAL_EVENTS.hidden, { relatedTarget: undefined }, false)
