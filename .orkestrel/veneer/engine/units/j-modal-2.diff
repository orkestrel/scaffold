+	destroy(): void {
+		if (this.#controller.signal.aborted) return
+		this.#controller.abort()
+		this.#changing = false
+		// The claim goes before the host is restored, so an engine constructed while restoration runs
+		// can claim the host, and its snapshot takes the values this one has still to write back.
+		Modal.#registry.release(this.#host, this)
+		// The abort has already destroyed the isolation, which takes the modal's lifetime as its signal.
+		this.#backdrop?.destroy()
+		this.#backdrop = undefined
