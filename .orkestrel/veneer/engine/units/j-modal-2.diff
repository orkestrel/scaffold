+		const host = requireValue(root.querySelector<HTMLElement>('#dialog'), 'No modal')
+		const inside = requireValue(host.querySelector('button'), 'No inside button')
+		const modal = new Modal(host, { backdrop: false, dismiss: { escape: false }, focus: false })
+		onTestFinished(() => modal.destroy())
+		expect(await modal.show()).toBe(true)
+		const writes = createRecorder<readonly [readonly MutationRecord[]]>()
+		const observer = new MutationObserver((records) => writes.handler(records))
+		onTestFinished(() => observer.disconnect())
+		observer.observe(host, { attributeFilter: ['class'], attributeOldValue: true })
+		inside.focus()
+		await pressKeys('{Escape}')
