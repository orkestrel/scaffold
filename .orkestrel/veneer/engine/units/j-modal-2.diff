+		expect(top.style.paddingRight).toBe('')
+		expect(await modal.hide()).toBe(true)
+		expect(banner.style.paddingRight).toBe('')
+	})
+
+	it('releases what a show the host took over held at a later show and its hide', async () => {
+		const name = 'vn-modal-show-token-retaken'
+		const reactions = new WeakMap<HTMLElement, (value: string | null) => void>()
+		customElements.define(
+			name,
+			class extends HTMLElement {
+				static observedAttributes = ['class']
+				attributeChangedCallback(_name: string, _previous: string | null, value: string | null) {
+					reactions.get(this)?.(value)
+				}
+			},
+		)
+		const root = scene.mount('<div></div>')
+		const host = document.createElement(name)
+		host.className = 'modal'
