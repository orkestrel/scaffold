+
+	it('pads the elements its replacing fixed selector names through the scroll lock it takes, and not the default ones', async () => {
+		const root = scene.mount(`
+			<div class="banner" id="banner" style="position: fixed; left: 0; right: 0"></div>
+			<div class="fixed-top" id="top" style="position: fixed; left: 0; right: 0"></div>
+			<div id="dialog" class="modal"><div class="modal-dialog"></div></div>`)
+		const banner = requireValue(root.querySelector<HTMLElement>('#banner'), 'No banner')
+		const top = requireValue(root.querySelector<HTMLElement>('#top'), 'No fixed top')
+		const host = requireValue(root.querySelector<HTMLElement>('#dialog'), 'No modal')
+		const modal = new Modal(host, { focus: false, selectors: { fixed: '.banner' } })
+		onTestFinished(() => modal.destroy())
+		expect(await modal.show()).toBe(true)
