@@ -0,0 +1,146 @@
+import type { IsolationInterface, IsolationOptions } from './types.js'
+import { AppError } from '@src/core'
+import { isInstance } from '@orkestrel/contract'
+import { readTag } from './helpers.js'
+import { HostSnapshot } from './HostSnapshot.js'
+
+/**
+ * Makes every element outside a host inert while the isolation lives, and returns focus when it ends.
+ *
+ * @remarks
+ * Construction reads the element holding focus, then walks the host's ancestor chain up to the
+ * document's body. It claims every HTML element of the chain, the host included, as not inert, so an
+ * isolation constructed inside another one keeps its own host reachable, and each HTML element
+ * beside the chain at each level as inert. It observes each level's children, and an HTML element
+ * inserted at a level beside the chain is claimed as inert at the next observer delivery. The live
+ * isolations share their claims on each element: the newest claim decides whether the element
+ * carries `inert`, a release hands the element to the newest claim left, and the last release
+ * restores the value one snapshot recorded before the first claim, so isolations may end in any
+ * order. Destruction stops the observation, releases every claim, and moves focus to the trigger,
+ * the one the options name or else the HTML element that held focus at construction; the platform
+ * moves no focus to a trigger that is disconnected or not rendered. An aborted `signal` destroys the
+ * isolation: one that aborts inside a claim's write during construction, such as from a custom
+ * element's attribute reaction, stops the construction there, so nothing more is claimed or observed.
+ *
+ * @example
+ * ```ts
+ * const isolation = new Isolation(dialog, { trigger: button })
+ * isolation.destroy()
+ * ```
+ */
+export class Isolation implements IsolationInterface {
+	// The live claims on each element's `inert` attribute, oldest first, with the snapshot that
+	// recorded the attribute before the first claim wrote it.
+	static readonly #claims = new WeakMap<
+		HTMLElement,
+		{
+			readonly snapshot: HostSnapshot
+			readonly claims: ReadonlyArray<{ readonly isolation: Isolation; readonly inert: boolean }>
+		}
+	>()
+	readonly #host: HTMLElement
+	readonly #trigger: HTMLElement | undefined
+	readonly #chain: ReadonlySet<Element>
+	readonly #claimed = new Set<HTMLElement>()
+	readonly #controller = new AbortController()
+	readonly #observer = new MutationObserver((records) => {
+		for (const record of records) {
+			for (const node of record.addedNodes) {
+				if (isInstance(node, HTMLElement) && !this.#chain.has(node)) this.#claim(node, true)
+			}
+		}
+	})
+
+	/**
+	 * Claims every element beside the host's ancestor chain as inert and observes each level of it.
+	 *
+	 * @param host - The HTML element that keeps focus.
+	 * @param options - The element focus returns to when the isolation ends, and its lifetime.
+	 * @throws Thrown when the host is not an HTMLElement, as an `AppError` carrying the `ISOLATION_HOST_INVALID` code.
+	 */
+	constructor(host: HTMLElement, options?: IsolationOptions) {
+		if (!isInstance(host, HTMLElement)) {
+			throw new AppError('Isolation requires an HTMLElement host', 'ISOLATION_HOST_INVALID', {
+				tag: readTag(host),
+			})
+		}
+		this.#host = host
+		const focused = host.ownerDocument.activeElement
+		this.#trigger = options?.trigger ?? (isInstance(focused, HTMLElement) ? focused : undefined)
+		const chain = new Set<Element>([host])
+		const body = host.ownerDocument.body
+		let node: Element = host
+		while (node !== body && node.parentElement !== null) {
+			node = node.parentElement
+			chain.add(node)
+		}
+		this.#chain = chain
+		const signal = options?.signal
+		if (signal?.aborted) {
+			this.destroy()
+			return
+		}
+		signal?.addEventListener('abort', () => this.destroy(), {
+			once: true,
+			signal: this.#controller.signal,
+		})
+		// A reaction to each claim's write can abort the signal, which destroys this isolation, so the
+		// construction reads its own lifetime after every claim and stops there.
+		for (const element of chain) {
+			if (!isInstance(element, HTMLElement)) continue
+			this.#claim(element, false)
+			if (this.#controller.signal.aborted) return
+		}
+		for (const level of chain) {
+			if (level === host) continue
+			for (const child of level.children) {
+				if (!isInstance(child, HTMLElement) || chain.has(child)) continue
+				this.#claim(child, true)
+				if (this.#controller.signal.aborted) return
+			}
+			this.#observer.observe(level, { childList: true })
+		}
+	}
+
+	get host(): HTMLElement {
+		return this.#host
+	}
+
+	destroy(): void {
+		if (this.#controller.signal.aborted) return
+		this.#controller.abort()
+		this.#observer.disconnect()
+		for (const element of this.#claimed) this.#release(element)
+		this.#claimed.clear()
+		this.#trigger?.focus()
+	}
+
+	// Adds this isolation's claim on an element as the newest, recording the element's `inert` value
+	// first when no live claim holds it, and writes the attribute the claim asks for.
+	#claim(element: HTMLElement, inert: boolean): void {
+		if (this.#controller.signal.aborted) return
+		const entry = Isolation.#claims.get(element)
+		const snapshot = entry?.snapshot ?? new HostSnapshot()
+		if (entry === undefined) snapshot.save({ category: 'attribute', element, name: 'inert' })
+		const claims = (entry?.claims ?? []).filter((claim) => claim.isolation !== this)
+		Isolation.#claims.set(element, { snapshot, claims: [...claims, { isolation: this, inert }] })
+		this.#claimed.add(element)
+		element.toggleAttribute('inert', inert)
+	}
+
+	// Withdraws this isolation's claim on an element, writing the attribute the newest remaining
+	// claim asks for, or restoring the recorded value when no claim remains.
+	#release(element: HTMLElement): void {
+		const entry = Isolation.#claims.get(element)
+		if (entry === undefined) return
+		const claims = entry.claims.filter((claim) => claim.isolation !== this)
+		const newest = claims.at(-1)
+		if (newest === undefined) {
+			Isolation.#claims.delete(element)
+			entry.snapshot.restore()
+			return
+		}
+		Isolation.#claims.set(element, { snapshot: entry.snapshot, claims })
+		element.toggleAttribute('inert', newest.inert)
+	}
+}
