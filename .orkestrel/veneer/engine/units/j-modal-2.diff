+			(press) => {
+				host.addEventListener('click', (click) => this.#press(press, click), {
+					once: true,
+					signal,
+				})
+			},
+			{ signal },
+		)
+		host.ownerDocument.defaultView?.addEventListener(
+			'resize',
+			() => {
+				if (!this.#changing) this.update()
+			},
+			{ signal },
+		)
