+		else void this.#bounce()
+	}
+
+	// Treats a press whose `mousedown` and `click` both land on the host itself, beside the dialog, as
+	// a click on the backdrop.
+	#press(press: MouseEvent, click: MouseEvent): void {
+		if (press.target !== this.#host || click.target !== this.#host) return
+		if (!this.#options.backdrop) return
+		if (this.#options.dismiss.backdrop) void this.hide()
+		else void this.#bounce()
+	}
+
+	// Dispatches the `prevent` event for a refused dismissal, then, while the modal stays shown with no
+	// change in flight and no bounce under way, moves focus to the host under the `focus` option and
+	// adds the `static` token until the dialog's transition settles.
+	async #bounce(): Promise<void> {
+		const host = this.#host
+		const token = this.#classes.static
+		if (this.#controller.signal.aborted || !this.shown) return
+		emitEvent(host, MODAL_EVENTS.prevent, { relatedTarget: undefined }, false)
+		// A listener inside the dispatch can hide, show, or destroy the modal.
+		if (!this.#idle() || host.classList.contains(token)) return
+		if (this.#options.focus) {
+			host.focus()
+			// A focus listener runs inside the call and can hide or destroy the modal as well.
+			if (!this.#idle()) return
+		}
+		this.#save()
+		host.classList.add(token)
+		if (this.#controller.signal.aborted) return
+		await settleAnimations(this.#dialog ?? host, this.#controller.signal)
+		if (this.#controller.signal.aborted) return
+		host.classList.remove(token)
+	}
+}
