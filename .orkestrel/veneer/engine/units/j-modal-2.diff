+import { Backdrop, BACKDROP_CLASSES } from '@src/browser'
+import { attempt } from '@orkestrel/contract'
+import { createRecorder } from '@orkestrel/test'
+import { afterEach, describe, expect, it, onTestFinished } from 'vitest'
+import { scene } from '../../setupBrowser.js'
+
+afterEach(() => scene.clear())
+
+describe('Backdrop', () => {
+	// The fade rules replace every default token, so the motion proofs also read the replacing
+	// vocabulary; the defaults are proved through the modal's own backdrop.
+	const cascade = `
+		.shade { position: fixed; inset: 0 }
+		.shade.is-fading { opacity: 0; transition: opacity 0.1s linear }
+		.shade.is-fading.is-on { opacity: 0.5 }`
+
+	it('publishes a frozen default table naming the modal backdrop tokens the cascade selects on', () => {
+		expect(BACKDROP_CLASSES).toStrictEqual({ host: 'modal-backdrop', shown: 'show', fade: 'fade' })
+		expect(Object.isFrozen(BACKDROP_CLASSES)).toBe(true)
+	})
+
+	it('appends an element carrying the host and fade tokens, fades it in from a layout read, and removes it after it fades out', async () => {
+		scene.load(cascade)
+		const readings = createRecorder<readonly [string, boolean]>()
+		const backdrop = new Backdrop({
+			classes: { host: 'shade', shown: 'is-on', fade: 'is-fading' },
+			animated: true,
+		})
+		onTestFinished(() => backdrop.destroy())
+		const element = backdrop.element
+		expect(element.isConnected).toBe(false)
+		expect(Array.from(element.classList)).toEqual(['shade', 'is-fading'])
+		const showing = backdrop.show()
+		expect(element.parentElement).toBe(document.body)
+		expect(Array.from(element.classList)).toEqual(['shade', 'is-fading', 'is-on'])
+		const [fade] = element.getAnimations()
+		expect(fade).toBeInstanceOf(CSSTransition)
+		void fade?.finished.then(() => readings.handler('shown', element.isConnected))
+		expect(await showing).toBe(true)
+		readings.handler('resolved', element.isConnected)
+		expect(element.hasAttribute('popover')).toBe(false)
+		expect(element.matches(':popover-open, :modal')).toBe(false)
+		const hiding = backdrop.hide()
+		expect(Array.from(element.classList)).toEqual(['shade', 'is-fading'])
+		const [out] = element.getAnimations()
+		void out?.finished.then(() => readings.handler('hidden', element.isConnected))
+		expect(await hiding).toBe(true)
+		expect(element.isConnected).toBe(false)
+		expect(readings.calls).toEqual([
+			['shown', true],
+			['resolved', true],
+			['hidden', true],
+		])
+	})
+
+	it('appends to the parent it names and adds no fade token when not animated, settling with no animation', async () => {
+		const parent = scene.mount('<section></section>')
+		const backdrop = new Backdrop({ parent })
+		onTestFinished(() => backdrop.destroy())
+		expect(await backdrop.show()).toBe(true)
+		expect(backdrop.element.parentElement).toBe(parent)
+		expect(Array.from(backdrop.element.classList)).toEqual(['modal-backdrop', 'show'])
+		expect(backdrop.element.getAnimations()).toEqual([])
+		expect(await backdrop.hide()).toBe(true)
+		expect(backdrop.element.isConnected).toBe(false)
+	})
+
+	it('resolves false for a show while shown, a hide while hidden, and every call after destruction', async () => {
+		const backdrop = new Backdrop()
+		onTestFinished(() => backdrop.destroy())
+		expect(await backdrop.hide()).toBe(false)
+		expect(await backdrop.show()).toBe(true)
+		expect(await backdrop.show()).toBe(false)
+		expect(document.querySelectorAll('body > .modal-backdrop')).toHaveLength(1)
+		backdrop.destroy()
+		expect(backdrop.element.isConnected).toBe(false)
+		expect(await backdrop.show()).toBe(false)
+		expect(await backdrop.hide()).toBe(false)
+		expect(backdrop.element.isConnected).toBe(false)
+		backdrop.destroy()
+	})
+
+	it('keeps the element for a show that takes over a hide in flight, which resolves false', async () => {
+		scene.load(cascade)
+		const backdrop = new Backdrop({
+			classes: { host: 'shade', shown: 'is-on', fade: 'is-fading' },
+			animated: true,
+		})
+		onTestFinished(() => backdrop.destroy())
+		expect(await backdrop.show()).toBe(true)
+		const hiding = backdrop.hide()
+		const showing = backdrop.show()
+		expect(await hiding).toBe(false)
+		expect(await showing).toBe(true)
+		expect(backdrop.element.isConnected).toBe(true)
+		expect(backdrop.element.classList.contains('is-on')).toBe(true)
+	})
+
+	it('removes the element at once on destruction and resolves the show in flight false', async () => {
+		scene.load(cascade)
+		const backdrop = new Backdrop({
+			classes: { host: 'shade', shown: 'is-on', fade: 'is-fading' },
+			animated: true,
+		})
+		const showing = backdrop.show()
+		expect(backdrop.element.getAnimations()).toHaveLength(1)
+		backdrop.destroy()
+		expect(backdrop.element.isConnected).toBe(false)
+		expect(await showing).toBe(false)
+	})
+
+	it('refuses a class value that is not a class token at construction', () => {
+		expect(attempt(() => new Backdrop({ classes: { shown: 'is on' } }))).toMatchObject({
+			success: false,
+			error: { code: 'BACKDROP_OPTION_INVALID', context: { key: 'shown' } },
+		})
+	})
+})
