+				// so the isolation it leaves behind is destroyed here rather than kept.
+				if (!this.#holds(true)) {
+					isolation.destroy()
+					return false
+				}
+				this.#isolation = isolation
+			}
+			if (!this.#apply(true, () => host.focus())) return false
+		}
