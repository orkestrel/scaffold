+	it('writes no static token when a listener to the prevent event hides the modal', async () => {
+		const root = scene.mount(`
+			<div id="dialog" class="modal" tabindex="-1"><div class="modal-dialog"></div></div>`)
+		const host = requireValue(root.querySelector<HTMLElement>('#dialog'), 'No modal')
+		const hidden = createRecorder<readonly [string]>()
+		// Without focus the bounce moves no focus, so the read after the dispatch is its only guard here.
+		const modal: ModalInterface = new Modal(host, {
