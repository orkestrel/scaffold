+import { Isolation } from '@src/browser'
+import { isAppError } from '@src/core'
+import { attempt } from '@orkestrel/contract'
+import { requireValue } from '@orkestrel/test'
+import { afterEach, describe, expect, it, onTestFinished } from 'vitest'
+import { scene } from '../../setupBrowser.js'
+
+afterEach(() => scene.clear())
+
+describe('Isolation', () => {
+	const markup = `
+		<button type="button" id="before">Before</button>
+		<section id="outer">
+			<button type="button" id="beside" inert>Beside</button>
+			<div id="inner">
+				<button type="button" id="sibling">Sibling</button>
+				<div id="host" tabindex="-1"><button type="button" id="inside">Inside</button></div>
+			</div>
+		</section>`
+
+	it('makes every element beside the host chain inert at each level up to the body and restores each value on destruction', () => {
+		const root = scene.mount(markup)
+		const before = requireValue(root.querySelector<HTMLElement>('#before'), 'No before button')
+		const outer = requireValue(root.querySelector<HTMLElement>('#outer'), 'No outer level')
+		const beside = requireValue(root.querySelector<HTMLElement>('#beside'), 'No inert sibling')
+		const inner = requireValue(root.querySelector<HTMLElement>('#inner'), 'No inner level')
+		const sibling = requireValue(root.querySelector<HTMLElement>('#sibling'), 'No sibling')
+		const host = requireValue(root.querySelector<HTMLElement>('#host'), 'No host')
+		const inside = requireValue(root.querySelector<HTMLElement>('#inside'), 'No inside button')
+		const others = scene.mount('<button type="button">Other</button>')
+		const other = requireValue(others.querySelector('button'), 'No other button')
+		const isolation = new Isolation(host)
+		onTestFinished(() => isolation.destroy())
+		expect(isolation.host).toBe(host)
+		expect(sibling.inert).toBe(true)
+		expect(beside.inert).toBe(true)
+		expect(before.inert).toBe(true)
+		expect(others.inert).toBe(true)
+		expect(host.inert).toBe(false)
+		expect(inner.inert).toBe(false)
+		expect(outer.inert).toBe(false)
+		expect(root.inert).toBe(false)
+		expect(inside.inert).toBe(false)
+		other.focus()
+		expect(document.activeElement).not.toBe(other)
+		inside.focus()
+		expect(document.activeElement).toBe(inside)
+		isolation.destroy()
+		expect(beside.getAttribute('inert')).toBe('')
+		expect(root.querySelectorAll('[inert]')).toHaveLength(1)
+		expect(others.hasAttribute('inert')).toBe(false)
+		other.focus()
+		expect(document.activeElement).toBe(other)
+	})
+
+	it('makes an element inserted beside the chain inert at the next observer delivery, and none after destruction', async () => {
+		const root = scene.mount(markup)
+		const host = requireValue(root.querySelector<HTMLElement>('#host'), 'No host')
+		const inner = requireValue(root.querySelector<HTMLElement>('#inner'), 'No inner level')
+		const isolation = new Isolation(host)
+		onTestFinished(() => isolation.destroy())
+		const late = inner.appendChild(document.createElement('button'))
+		const nested = host.appendChild(document.createElement('button'))
+		expect(late.inert).toBe(false)
+		await Promise.resolve()
+		expect(late.inert).toBe(true)
+		expect(nested.inert).toBe(false)
+		isolation.destroy()
+		expect(late.hasAttribute('inert')).toBe(false)
+		const after = inner.appendChild(document.createElement('button'))
+		await Promise.resolve()
+		expect(after.hasAttribute('inert')).toBe(false)
+	})
+
+	it('returns focus to the trigger it names, or to the element focused at construction, only while that element is connected and visible', () => {
+		const root = scene.mount(markup)
+		const host = requireValue(root.querySelector<HTMLElement>('#host'), 'No host')
+		const before = requireValue(root.querySelector<HTMLElement>('#before'), 'No before button')
+		const sibling = requireValue(root.querySelector<HTMLElement>('#sibling'), 'No sibling')
+		before.focus()
+		const focused = new Isolation(host)
+		onTestFinished(() => focused.destroy())
+		host.focus()
+		focused.destroy()
+		expect(document.activeElement).toBe(before)
+		const named = new Isolation(host, { trigger: sibling })
+		onTestFinished(() => named.destroy())
+		host.focus()
+		named.destroy()
+		expect(document.activeElement).toBe(sibling)
+		const hidden = new Isolation(host, { trigger: before })
+		onTestFinished(() => hidden.destroy())
+		host.focus()
+		before.style.setProperty('display', 'none')
+		hidden.destroy()
+		expect(document.activeElement).toBe(host)
+		const detached = new Isolation(host, { trigger: document.createElement('button') })
+		onTestFinished(() => detached.destroy())
+		detached.destroy()
+		expect(document.activeElement).toBe(host)
+	})
+
+	it('hands each element to the newest live claim, so isolations nested either way end in any order and restore the originals', () => {
+		const root = scene.mount(`
+			<button type="button" id="page">Page</button>
+			<div id="first" tabindex="-1"></div>
+			<div id="second" tabindex="-1"></div>`)
+		const page = requireValue(root.querySelector<HTMLElement>('#page'), 'No page control')
+		const first = requireValue(root.querySelector<HTMLElement>('#first'), 'No first host')
+		const second = requireValue(root.querySelector<HTMLElement>('#second'), 'No second host')
+		const outer = new Isolation(first)
+		onTestFinished(() => outer.destroy())
+		expect(second.inert).toBe(true)
+		const inner = new Isolation(second)
+		onTestFinished(() => inner.destroy())
+		expect(second.inert).toBe(false)
+		expect(first.inert).toBe(true)
+		expect(page.inert).toBe(true)
+		outer.destroy()
+		expect(second.inert).toBe(false)
+		expect(first.inert).toBe(true)
+		expect(page.inert).toBe(true)
+		inner.destroy()
+		expect(root.querySelectorAll('[inert]')).toHaveLength(0)
+		const again = new Isolation(first)
+		onTestFinished(() => again.destroy())
+		const nested = new Isolation(second)
+		onTestFinished(() => nested.destroy())
+		nested.destroy()
+		expect(second.inert).toBe(true)
+		expect(first.inert).toBe(false)
+		expect(page.inert).toBe(true)
+		again.destroy()
+		expect(root.querySelectorAll('[inert]')).toHaveLength(0)
+	})
+
+	it('keeps an inert ancestor clear while any isolation inside it lives, and restores it at the last release', () => {
+		const root = scene.mount(`
+			<section id="section" inert>
+				<div id="first" tabindex="-1"></div>
+				<div id="second" tabindex="-1"></div>
+			</section>`)
+		const section = requireValue(root.querySelector<HTMLElement>('#section'), 'No section')
+		const first = requireValue(root.querySelector<HTMLElement>('#first'), 'No first host')
+		const second = requireValue(root.querySelector<HTMLElement>('#second'), 'No second host')
+		const outer = new Isolation(first)
+		onTestFinished(() => outer.destroy())
+		expect(section.inert).toBe(false)
+		const inner = new Isolation(second)
+		onTestFinished(() => inner.destroy())
+		outer.destroy()
+		expect(section.inert).toBe(false)
+		expect(second.inert).toBe(false)
+		inner.destroy()
+		expect(section.getAttribute('inert')).toBe('')
+		expect(second.hasAttribute('inert')).toBe(false)
+	})
+
+	it('claims nothing under an aborted signal and releases every claim when its signal aborts', async () => {
+		const root = scene.mount(markup)
+		const host = requireValue(root.querySelector<HTMLElement>('#host'), 'No host')
+		const inner = requireValue(root.querySelector<HTMLElement>('#inner'), 'No inner level')
+		const aborted = new Isolation(host, { signal: AbortSignal.abort() })
+		onTestFinished(() => aborted.destroy())
+		expect(root.querySelectorAll('[inert]')).toHaveLength(1)
+		const controller = new AbortController()
+		const isolation = new Isolation(host, { signal: controller.signal })
+		onTestFinished(() => isolation.destroy())
+		expect(root.querySelectorAll('[inert]').length).toBeGreaterThan(1)
+		controller.abort()
+		expect(root.querySelectorAll('[inert]')).toHaveLength(1)
+		const late = inner.appendChild(document.createElement('button'))
+		await Promise.resolve()
+		expect(late.hasAttribute('inert')).toBe(false)
+	})
+
+	it('refuses a host that is not an HTMLElement', () => {
+		const refused = attempt(() => Reflect.construct(Isolation, [null]))
+		expect(refused).toEqual({ success: false, error: expect.toSatisfy(isAppError) })
+		expect(refused).toMatchObject({
+			error: { code: 'ISOLATION_HOST_INVALID', context: { tag: undefined } },
+		})
+	})
+})
