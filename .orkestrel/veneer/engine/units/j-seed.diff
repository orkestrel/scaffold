diff --git a/tests/src/browser/ColorMode.test.ts b/tests/src/browser/ColorMode.test.ts
index a3b8bb2..eb2b6dc 100644
--- a/tests/src/browser/ColorMode.test.ts
+++ b/tests/src/browser/ColorMode.test.ts
@@ -153,4 +153,45 @@ describe('ColorMode', () => {
 		controller.destroy()
 		expect(root.getAttribute('data-bs-theme')).toBe('dark')
 	})
+
+	it('writes nothing after destruction of a root that carried an attribute, and toggles to the live mode', () => {
+		const root = build('div')
+		root.setAttribute('data-bs-theme', 'light')
+		const controller = new ColorMode({ root, storage: sessionStorage })
+		controller.apply('light')
+		controller.destroy()
+		expect(root.getAttribute('data-bs-theme')).toBe('light')
+		expect(sessionStorage.getItem('color-mode')).toBe('light')
+		controller.apply('dark')
+		expect(root.getAttribute('data-bs-theme')).toBe('light')
+		expect(sessionStorage.getItem('color-mode')).toBe('light')
+		expect(controller.toggle()).toBe('light')
+		expect(root.getAttribute('data-bs-theme')).toBe('light')
+		expect(sessionStorage.getItem('color-mode')).toBe('light')
+		// A write another owner makes after destruction is the live mode `toggle` reports, and neither
+		// `toggle` nor a second `destroy` replaces it.
+		root.setAttribute('data-bs-theme', 'dark')
+		expect(controller.toggle()).toBe('dark')
+		controller.destroy()
+		expect(root.getAttribute('data-bs-theme')).toBe('dark')
+		expect(sessionStorage.getItem('color-mode')).toBe('light')
+	})
+
+	it('writes nothing after destruction of a root that carried no attribute, and toggles to the live mode', () => {
+		const root = build('div')
+		const controller = new ColorMode({ root, storage: sessionStorage })
+		controller.apply('light')
+		controller.destroy()
+		expect(root.hasAttribute('data-bs-theme')).toBe(false)
+		expect(sessionStorage.getItem('color-mode')).toBe('light')
+		controller.apply('dark')
+		expect(root.hasAttribute('data-bs-theme')).toBe(false)
+		expect(sessionStorage.getItem('color-mode')).toBe('light')
+		expect(controller.toggle()).toBe('light')
+		expect(root.hasAttribute('data-bs-theme')).toBe(false)
+		expect(sessionStorage.getItem('color-mode')).toBe('light')
+		controller.destroy()
+		expect(root.hasAttribute('data-bs-theme')).toBe(false)
+		expect(sessionStorage.getItem('color-mode')).toBe('light')
+	})
