+	it('parses markup written into an annotation-xml element whose encoding names HTML in any ASCII case as the body of an HTML element, through the host route and the walk', () => {
+		const math = 'http://www.w3.org/1998/Math/MathML'
+		for (const encoding of [
+			'text/html',
+			'TEXT/HTML',
+			'application/xhtml+xml',
+			'Application/XHTML+XML',
+		]) {
+			const targets = [
+				document.createElementNS(math, 'annotation-xml'),
+				shadowSetHTML(document.createElementNS(math, 'annotation-xml')),
+			]
+			for (const target of targets) {
+				target.setAttribute('encoding', encoding)
+				new ConfigSanitizer().write(target, '<tr><td>cell</td></tr><a>kept</a>')
+				expect(target.innerHTML).toBe('cell<a>kept</a>')
+				expect(target.firstElementChild?.namespaceURI).toBe(SANITIZER_NAMESPACE)
+			}
+		}
+	})
+
