+describe('isScrollSpyEvent', () => {
+	it('requires a custom event whose detail carries an HTML element as its related target', () => {
+		const link = build('a', { attributes: { href: '#intro' } })
+		expect(
+			isScrollSpyEvent(
+				new CustomEvent('activate.vn.scrollspy', { detail: { relatedTarget: link } }),
+			),
+		).toBe(true)
+		expect(isScrollSpyEvent(new Event('activate.vn.scrollspy'))).toBe(false)
+		expect(isScrollSpyEvent(new CustomEvent('activate.vn.scrollspy'))).toBe(false)
+		expect(isScrollSpyEvent(new CustomEvent('activate.vn.scrollspy', { detail: {} }))).toBe(false)
+		expect(
+			isScrollSpyEvent(
+				new CustomEvent('activate.vn.scrollspy', { detail: { relatedTarget: '#intro' } }),
+			),
+		).toBe(false)
+		expect(
+			isScrollSpyEvent(
+				new CustomEvent('activate.vn.scrollspy', {
+					detail: {
+						relatedTarget: document.createElementNS('http://www.w3.org/2000/svg', 'a'),
+					},
+				}),
+			),
+		).toBe(false)
+		expect(isScrollSpyEvent(new CustomEvent('activate.vn.scrollspy', { detail: link }))).toBe(false)
+		expect(isScrollSpyEvent(undefined)).toBe(false)
+		expect(isScrollSpyEvent(null)).toBe(false)
+	})
+
+	it('returns false when a prototype or related-target accessor throws', () => {
+		expect(
+			isScrollSpyEvent(
+				new Proxy(
+					{},
+					{
+						getPrototypeOf() {
+							throw new Error('Unreadable')
+						},
+					},
+				),
+			),
+		).toBe(false)
+		const event = new CustomEvent('activate.vn.scrollspy', {
+			detail: {
+				get relatedTarget() {
+					throw new Error('Unreadable')
+				},
+			},
+		})
+		expect(isScrollSpyEvent(event)).toBe(false)
+	})
+})
