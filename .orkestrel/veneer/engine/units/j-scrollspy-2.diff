@@ -0,0 +1,390 @@
+import type {
+	ScrollSpyClassMap,
+	ScrollSpyInterface,
+	ScrollSpyOptions,
+	ScrollSpySelectorMap,
+} from './types.js'
+import { AppError } from '@src/core'
+import { instanceOf, isInstance, parseBoolean } from '@orkestrel/contract'
+import {
+	SCROLL_SPY_ATTRIBUTES,
+	SCROLL_SPY_CLASSES,
+	SCROLL_SPY_DEFAULTS,
+	SCROLL_SPY_EVENTS,
+	SCROLL_SPY_SELECTORS,
+} from './constants.js'
+import { bindEventMap, emitEvent, readTag, resolveOptions, resolveVocabulary } from './helpers.js'
+import { HostSnapshot } from './HostSnapshot.js'
+import { parseElement, parseRootMargin, parseThreshold } from './parsers.js'
+import { Registry } from './Registry.js'
+import { isAttributeName, isClassToken, isScrollSpyEvent, isSelector } from './validators.js'
+
+/**
+ * Activates the navigation link whose section is in view as its host scrolls, and the links that lead to it.
+ *
+ * @remarks
+ * The host is the scrolling element; it must be an HTMLElement in the current realm and have no
+ * live scrollspy owner. Construction validates and copies the `classes`, `attributes`, and
+ * `selectors` groups, resolves the `target`, `smooth`, and `intersection` options from the
+ * constructor and the host's attributes, claims the host, binds the hooks, and refreshes. A refresh
+ * reads every `[href]` link inside the target whose fragment names a visible element inside the
+ * host, skipping a link carrying the `disabled` token or a `disabled` attribute whose value is not
+ * `false`, and replaces its
+ * `IntersectionObserver` with one observing each named section, whose root is the host when its
+ * `overflow-y` value is not `visible`, and the viewport otherwise. At each delivery a section that
+ * leaves clears its link's `active` token; scrolling down, each entering section not higher than
+ * the last one activated activates its link, and scrolling up, each entering section higher than it
+ * does. An activation clears the `active` token from the target and every `[href]` link inside it,
+ * gives it to the link and to the links that lead to it, and dispatches `activate.vn.scrollspy` on
+ * the host. After each write and the dispatch the delivery reads its lifetime again; after each
+ * removal the removed token must be absent, and after the link's own write and after the dispatch
+ * the link must carry its token. A delivery that finds the scrollspy destroyed, a later refresh
+ * made, a removed token back, or the link without its token stops, writing and dispatching nothing
+ * more, and reads no further entry.
+ * With `smooth`, a click on a link inside the target whose section is observed scrolls the root
+ * smoothly to that section and prevents the click's navigation. Destruction disconnects the
+ * observer and restores every `active` token the scrollspy wrote or removed. An aborted `signal`
+ * destroys the scrollspy.
+ *
+ * @example
+ * ```ts
+ * const container = document.createElement('div')
+ * container.style.cssText = 'height: 100px; overflow-y: auto'
+ * const spy = new ScrollSpy(container, { target: document.createElement('nav') })
+ * spy.refresh()
+ * spy.destroy()
+ * ```
+ */
+export class ScrollSpy implements ScrollSpyInterface {
+	static readonly #registry = new Registry<ScrollSpy>({ code: 'SCROLL_SPY_HOST_OWNED' })
+	readonly #host: HTMLElement
+	readonly #target: HTMLElement
+	readonly #margin: string
+	readonly #threshold: readonly number[]
+	readonly #classes: ScrollSpyClassMap
+	readonly #selectors: ScrollSpySelectorMap
+	readonly #snapshot = new HostSnapshot()
+	readonly #controller = new AbortController()
