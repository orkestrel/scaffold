+		expect(parseRootMargin('1px 2px 3px 4px')).toBe('1px 2px 3px 4px')
+		expect(parseRootMargin('0px')).toBe('0px')
+	})
+
+	it('returns undefined for a margin the intersection observer refuses, a blank string, and a non-string', () => {
+		expect(parseRootMargin('10em')).toBeUndefined()
+		expect(parseRootMargin('ten pixels')).toBeUndefined()
+		expect(parseRootMargin('1px 2px 3px 4px 5px')).toBeUndefined()
+		expect(parseRootMargin('')).toBeUndefined()
+		expect(parseRootMargin('   ')).toBeUndefined()
+		expect(parseRootMargin(10)).toBeUndefined()
+		expect(parseRootMargin(null)).toBeUndefined()
+		expect(parseRootMargin(undefined)).toBeUndefined()
+		expect(parseRootMargin({ toString: () => '10px' })).toBeUndefined()
+	})
+})
+
+describe('parseThreshold', () => {
+	it('reads a comma-separated list and a JSON array of ratios, and returns a ratio array unchanged', () => {
+		expect(parseThreshold('0.1,0.5,1')).toEqual([0.1, 0.5, 1])
+		expect(parseThreshold(' 0 , 1 ')).toEqual([0, 1])
+		expect(parseThreshold('0.5')).toEqual([0.5])
+		expect(parseThreshold('[0.25, 0.75]')).toEqual([0.25, 0.75])
+		expect(parseThreshold('-0')).toEqual([-0])
+		const ratios = [0, 1]
+		expect(parseThreshold(ratios)).toBe(ratios)
+	})
+
+	it('returns undefined for an empty list, a blank or non-numeric member, a ratio outside zero to one, and any other value', () => {
+		expect(parseThreshold('')).toBeUndefined()
+		expect(parseThreshold('  ')).toBeUndefined()
+		expect(parseThreshold('0.1,,1')).toBeUndefined()
+		expect(parseThreshold('0.5abc')).toBeUndefined()
+		expect(parseThreshold('NaN')).toBeUndefined()
+		expect(parseThreshold('1.5')).toBeUndefined()
+		expect(parseThreshold('-0.1')).toBeUndefined()
+		expect(parseThreshold('[]')).toBeUndefined()
+		expect(parseThreshold('[2]')).toBeUndefined()
+		expect(parseThreshold('["0.5"]')).toBeUndefined()
+		expect(parseThreshold('[1e999]')).toBeUndefined()
+		expect(parseThreshold('[0.5')).toBeUndefined()
+		expect(parseThreshold([])).toBeUndefined()
+		expect(parseThreshold([0.5, Number.NaN])).toBeUndefined()
+		expect(parseThreshold(0.5)).toBeUndefined()
+		expect(parseThreshold(null)).toBeUndefined()
+		expect(parseThreshold(undefined)).toBeUndefined()
+	})
+})
