diff --git a/tests/src/browser/sanitizers/NativeSanitizer.test.ts b/tests/src/browser/sanitizers/NativeSanitizer.test.ts
new file mode 100644
index 0000000..a380551
--- /dev/null
+++ b/tests/src/browser/sanitizers/NativeSanitizer.test.ts
@@ -0,0 +1,99 @@
+import { NativeSanitizer, SANITIZER_ALLOWLIST } from '@src/browser'
+import { attempt } from '@orkestrel/contract'
+import { build } from '@orkestrel/test/browser'
+import { describe, expect, it } from 'vitest'
+
+describe('NativeSanitizer', () => {
+	it('publishes a frozen allowlist naming Bootstrap elements, their own attributes, the global names, and no data attributes', () => {
+		const elements = SANITIZER_ALLOWLIST.elements ?? []
+		expect(elements.map((entry) => (typeof entry === 'string' ? entry : entry.name))).toEqual([
+			'a',
+			'area',
+			'b',
+			'br',
+			'col',
+			'code',
+			'dd',
+			'div',
+			'dl',
+			'dt',
+			'em',
+			'hr',
+			'h1',
+			'h2',
+			'h3',
+			'h4',
+			'h5',
+			'h6',
+			'i',
+			'img',
+			'li',
+			'ol',
+			'p',
+			'pre',
+			's',
+			'small',
+			'span',
+			'sub',
+			'sup',
+			'strong',
+			'u',
+			'ul',
+		])
+		expect(elements.filter((entry) => typeof entry !== 'string')).toEqual([
+			{ name: 'a', attributes: ['target', 'href', 'title', 'rel'] },
+			{ name: 'img', attributes: ['src', 'srcset', 'alt', 'title', 'width', 'height'] },
+		])
+		const attributes = SANITIZER_ALLOWLIST.attributes ?? []
+		expect(attributes.slice(0, 5)).toEqual(['class', 'dir', 'id', 'lang', 'role'])
+		expect(attributes.slice(5).every((name) => /^aria-[a-z]+$/.test(name))).toBe(true)
+		expect(attributes).toContain('aria-label')
+		expect(attributes).toContain('aria-describedby')
+		expect(SANITIZER_ALLOWLIST.dataAttributes).toBe(false)
+		for (const value of [SANITIZER_ALLOWLIST, elements, attributes, elements[0]]) {
+			expect(Object.isFrozen(value)).toBe(true)
+		}
+	})
+
+	it('keeps the allowlist markup and drops scripts, handlers, data attributes, unlisted elements with their content, and a script URL', () => {
+		const slot = build('div')
+		slot.setHTMLUnsafe('<i>Old</i>')
+		new NativeSanitizer().write(
+			slot,
+			'<p class="lead" id="p" dir="rtl" lang="fr" role="note" aria-label="Note" aria-describedby="p" data-x="1" onclick="alert(1)" style="color: red">' +
+				'<a href="https://example.com" target="_blank" rel="noopener" title="Site">Site</a>' +
+				'<a href="javascript:alert(2)">Bad</a>' +
+				'<img src="data:image/png;base64,AA==" alt="Dot" width="1" height="1" onerror="alert(3)">' +
+				'<mark>gone</mark><script>alert(4)</script><span aria-vendor="x">kept</span></p>',
+		)
+		expect(slot.innerHTML).toBe(
+			'<p class="lead" id="p" dir="rtl" lang="fr" role="note" aria-label="Note" aria-describedby="p">' +
+				'<a href="https://example.com" target="_blank" rel="noopener" title="Site">Site</a>' +
+				'<a>Bad</a>' +
+				'<img src="data:image/png;base64,AA==" alt="Dot" width="1" height="1">' +
+				'<span>kept</span></p>',
+		)
+	})
+
+	it('writes through the configuration its options carry in place of the allowlist', () => {
+		const slot = build('div')
+		new NativeSanitizer({ config: { elements: ['mark'], attributes: ['title'] } }).write(
+			slot,
+			'<mark title="t" class="c">kept</mark><b>gone</b>',
+		)
+		expect(slot.innerHTML).toBe('<mark title="t">kept</mark>')
+	})
+
+	it('refuses an element without setHTML and propagates the platform refusal of a configuration', () => {
+		const shadowed = build('div')
+		Object.defineProperty(shadowed, 'setHTML', { value: undefined })
+		expect(attempt(() => new NativeSanitizer().write(shadowed, '<b>x</b>'))).toMatchObject({
+			error: { code: 'SANITIZER_UNSUPPORTED', context: { tag: 'DIV' } },
+		})
+		const refused = attempt(() =>
+			new NativeSanitizer({ config: { dataAttributes: true } }).write(build('div'), '<b>x</b>'),
+		)
+		expect(refused.success).toBe(false)
+		expect(refused.success ? undefined : refused.error).toBeInstanceOf(TypeError)
+	})
+})
