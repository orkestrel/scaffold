+} from './parsers.js'
+import { Placement } from './Placement.js'
+import { Registry } from './Registry.js'
+import { NativeSanitizer } from './sanitizers/NativeSanitizer.js'
+import { isAttributeName, isClassToken, isSelector, isTooltipEvent } from './validators.js'
+
+/**
+ * Shows a tip built from a template beside its trigger, anchored in the top layer, on hover, focus, click, or call.
+ *
+ * @remarks
+ * The host is the trigger. It must be an HTMLElement in the current realm and have no live tooltip
+ * owner. Construction validates and copies the `classes`, `attributes`, and `selectors` groups,
+ * resolves the options from the defaults, the attributes the `attributes` group names, and the
+ * constructor, claims the trigger, binds the hooks, listens for the interactions the `trigger` group
+ * selects, and listens for the hide event of the closest element carrying the `modal` token. Unless
+ * `descendants` is set, a trigger carrying a non-empty `title` attribute then loses that attribute
+ * for the tooltip's life: its value becomes the default content of the title slot, and it becomes
+ * the trigger's `aria-label` attribute when the trigger has neither a non-empty `aria-label`
+ * attribute nor text. Showing builds a tip from the template through the sanitizer, fills its slots,
+ * names it in the trigger's `aria-describedby` attribute, inserts it into its container, places it
+ * through a `Placement` instance promoted with the `hint` popover value, adds the `shown` token, and
+ * waits for the tip's transitions when `animated` is `true`. Hiding removes the `shown` token, waits
+ * the same way, restores the placement, removes the tip, and takes its id out of `aria-describedby`.
+ * The platform closes a `hint` popover on an Escape key press, on a click outside it, and when
+ * another `hint` popover opens; the tooltip then hides through the same sequence, and when a
+ * listener prevents that hide it promotes the tip again. Interactions arm one native timer at a time
+ * for the `delay` group, and a leave hides the tip only when no other interaction still holds it.
+ * With `descendants` set, each descendant matching the selector receives its own tooltip on its first
+ * interaction, driven by this one's listeners and destroyed with it. After each write, dispatch, and
+ * await a call reads its lifetime and the tip again, and a call that finds the tooltip destroyed, a
+ * later call started, or the tip otherwise stops, writing and dispatching nothing more, and resolves
+ * `false`. Destruction clears the timer, removes the tip without an event, and restores the trigger.
+ * An aborted `signal` destroys the tooltip.
+ *
+ * @example
+ * ```ts
+ * const trigger = document.createElement('button')
+ * trigger.title = 'Saves the draft'
+ * document.body.append(trigger)
+ * const tooltip = new Tooltip(trigger)
+ * await tooltip.show()
+ * tooltip.destroy()
+ * ```
+ */
+export class Tooltip implements TooltipInterface {
+	static readonly #registry = new Registry<Tooltip>({ code: 'TOOLTIP_HOST_OWNED' })
+	static #count = 0
+	readonly #host: HTMLElement
+	readonly #classes: TooltipClassMap
+	readonly #attributes: TooltipAttributeMap
+	readonly #options: TooltipOptions | undefined
+	readonly #animated: boolean
+	readonly #delay: Required<NonNullable<TooltipOptions['delay']>>
+	readonly #html: boolean
+	readonly #template: string
+	readonly #tokens: readonly string[]
+	readonly #container: HTMLElement | undefined
+	readonly #position: PlacementPosition
+	readonly #offset: readonly [number, number]
+	readonly #fallbacks: readonly PlacementPosition[]
+	readonly #descendants: string | undefined
+	readonly #sanitizer: SanitizerInterface
+	readonly #snapshot = new HostSnapshot()
+	readonly #controller = new AbortController()
+	// The interactions holding the tip open, as Bootstrap's `_activeTrigger` records them.
+	readonly #active = { hover: false, focus: false, click: false }
+	#content: Readonly<Record<string, TipContent | undefined>>
+	#enabled = true
+	// The tip, and the container it went into, from the show that builds it until it is removed.
+	#tip: HTMLElement | undefined
+	#parent: HTMLElement | undefined
+	#placement: PlacementInterface | undefined
+	// The identity of the call whose change is in flight. A show is refused while any change is in
+	// flight; a hide takes over a show in flight, which then reads that it no longer holds its change.
+	#change: object | undefined
+	#timer: ReturnType<typeof setTimeout> | undefined
+	// Bootstrap's `_isHovered`: true after an interaction asked for the tip, false after the last one
+	// let it go, and undefined after a hide. A pending timer reads it when it fires, and a hide that
+	// completes after an interaction asked for the tip again shows it.
+	#entered: boolean | undefined
+
+	/**
+	 * Claims the trigger, resolves its vocabulary and options, binds initial hooks and the interaction listeners, and moves its `title` attribute into the tip's content.
+	 *
+	 * @param host - The HTML element to own, the trigger.
+	 * @param options - The content, interactions, delays, tip, container, placement, sanitizer, delegation, markup vocabulary, initial event subscriptions, and lifetime.
+	 * @throws Thrown when the host is not an HTMLElement, when a group value is not a class token, an attribute name, or a selector, when `descendants` is not a selector, when a declared attribute the constructor leaves undefined fails coercion, or when the host already has a live owner.
+	 */
+	constructor(host: HTMLElement, options?: TooltipOptions) {
+		if (!isInstance(host, HTMLElement)) {
+			throw new AppError('Tooltip requires an HTMLElement host', 'TOOLTIP_HOST_INVALID', {
+				tag: readTag(host),
+			})
+		}
+		const code = 'TOOLTIP_OPTION_INVALID'
+		this.#classes = resolveVocabulary(code, TOOLTIP_CLASSES, isClassToken, options?.classes)
+		this.#attributes = resolveVocabulary(
+			code,
+			TOOLTIP_ATTRIBUTES,
+			isAttributeName,
+			options?.attributes,
+		)
+		const selectors = resolveVocabulary(code, TOOLTIP_SELECTORS, isSelector, options?.selectors)
+		const resolved = resolveOptions<
+			Pick<
+				TooltipOptions,
+				'animated' | 'delay' | 'trigger' | 'title' | 'html' | 'container' | 'descendants'
+			>,
+			'animated' | 'delay' | 'trigger' | 'title' | 'html' | 'container' | 'descendants'
+		>(
+			host,
+			this.#attributes,
+			code,
+			{
+				animated: TOOLTIP_DEFAULTS.animated,
+				delay: TOOLTIP_DEFAULTS.delay,
+				trigger: TOOLTIP_DEFAULTS.trigger,
+				html: TOOLTIP_DEFAULTS.html,
+			},
+			{
+				animated: parseBoolean,
+				delay: parseDelay,
+				trigger: parseTrigger,
+				title: parseString,
+				html: parseBoolean,
+				container: parseElement,
+				descendants: parseString,
+			},
+			options,
+		)
+		const descendants = resolved.descendants
+		if (descendants !== undefined && !isSelector(descendants)) {
+			throw new AppError('Option value fails validation', code, { key: 'descendants' })
+		}
+		const tip = resolveOptions<NonNullable<TooltipOptions['tip']>, 'template' | 'class'>(
+			host,
+			this.#attributes,
+			code,
+			TOOLTIP_DEFAULTS.tip,
+			{ template: parseString, class: parseString },
+			options?.tip,
+		)
+		const placement = resolveOptions<
+			NonNullable<TooltipOptions['placement']>,
+			'position' | 'offset' | 'fallbacks'
+		>(
+			host,
+			this.#attributes,
+			code,
+			TOOLTIP_DEFAULTS.placement,
+			{ position: parsePosition, offset: parseOffset, fallbacks: parseFallbacks },
+			options?.placement,
+		)
+		const { delay, trigger } = TOOLTIP_DEFAULTS
+		this.#animated = resolved.animated ?? TOOLTIP_DEFAULTS.animated
+		this.#delay = {
+			show: resolved.delay?.show ?? delay.show,
+			hide: resolved.delay?.hide ?? delay.hide,
+		}
+		const hover = resolved.trigger?.hover ?? trigger.hover
+		const focus = resolved.trigger?.focus ?? trigger.focus
+		const click = resolved.trigger?.click ?? trigger.click
+		this.#html = resolved.html ?? TOOLTIP_DEFAULTS.html
+		this.#template = tip.template ?? TOOLTIP_DEFAULTS.tip.template
+		this.#tokens = (tip.class ?? '').split(/\s+/).filter((token) => token !== '')
+		this.#container = resolved.container
+		this.#position = placement.position ?? TOOLTIP_DEFAULTS.placement.position
+		this.#offset = placement.offset ?? TOOLTIP_DEFAULTS.placement.offset
+		this.#fallbacks = placement.fallbacks ?? TOOLTIP_DEFAULTS.placement.fallbacks
+		this.#descendants = descendants
+		this.#sanitizer = options?.sanitizer ?? new NativeSanitizer()
+		this.#options = options
+		// A delegating tooltip keeps its trigger's `title` attribute, as Bootstrap's does.
+		const title = descendants === undefined ? host.getAttribute('title') : null
+		const fallback = title === null || title === '' ? undefined : title
+		this.#content = Object.freeze({ [selectors.title]: resolved.title ?? fallback })
+		Tooltip.#registry.claim(host, this)
+		this.#host = host
+		const signal = this.#controller.signal
+		bindEventMap(host, TOOLTIP_EVENTS, isTooltipEvent, options?.on, signal)
+		if (hover) {
+			host.addEventListener('mouseover', (event) => this.#over(event), { signal })
+			host.addEventListener('mouseout', (event) => this.#out(event), { signal })
+		}
+		if (focus) {
+			host.addEventListener('focusin', (event) => this.#focus(event), { signal })
+			host.addEventListener('focusout', (event) => this.#blur(event), { signal })
+		}
+		if (click) host.addEventListener('click', (event) => this.#click(event), { signal })
