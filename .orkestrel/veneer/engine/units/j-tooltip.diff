 ```
 
+Construct a tooltip over a button whose `title` attribute carries the tip's text, show the tip
+below the button, hide it, and restore the button.
+
+```ts
+import { Tooltip } from '@orkestrel/veneer/browser'
+
+const trigger = document.createElement('button')
+trigger.type = 'button'
+trigger.textContent = 'Save'
+trigger.title = 'Saves the draft'
+document.body.append(trigger)
+const tooltip = new Tooltip(trigger, { placement: { position: 'bottom' } })
+const shown = await tooltip.show()
+const hidden = await tooltip.hide()
+tooltip.destroy()
+```
