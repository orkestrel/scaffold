+							throw new Error('Unreadable')
+						},
+					},
+				),
+			),
+		).toBe(false)
+		const event = new CustomEvent('shown.vn.tooltip')
+		Object.defineProperty(event, 'detail', {
+			get() {
+				throw new Error('Unreadable')
+			},
+		})
