@@ -0,0 +1,45 @@
+import type { NativeSanitizerOptions, SanitizerConfig, SanitizerInterface } from '../types.js'
+import { AppError } from '@src/core'
+import { SANITIZER_ALLOWLIST } from '../constants.js'
+import { readTag } from '../helpers.js'
+import { isSanitizeTarget } from '../validators.js'
+
+/**
+ * Writes markup into an element through the platform's `setHTML` method and a sanitizer configuration.
+ *
+ * @remarks
+ * The adapter holds one `SanitizerConfig` dictionary, the `config` option or, by default, the
+ * `SANITIZER_ALLOWLIST` constant built from Bootstrap's allowlist, and passes it as the `sanitizer`
+ * option of each `setHTML` call. It keeps no reference to an element or to markup after a call
+ * returns. No engine file constructs or names the platform's `Sanitizer` class: the dictionary is the
+ * configuration. A write into an element that carries no `setHTML` method throws an `AppError`
+ * carrying the `SANITIZER_UNSUPPORTED` code, and a failure `setHTML` throws, such as the platform's
+ * refusal of the configuration, reaches the caller unchanged.
+ *
+ * @example
+ * ```ts
+ * const sanitizer = new NativeSanitizer()
+ * sanitizer.write(slot, '<b>Saved</b>')
+ * ```
+ */
+export class NativeSanitizer implements SanitizerInterface {
+	readonly #config: SanitizerConfig
+
+	/**
+	 * Holds the configuration each write passes to the platform.
+	 *
+	 * @param options - The sanitizer configuration; an absent `config` selects `SANITIZER_ALLOWLIST`.
+	 */
+	constructor(options?: NativeSanitizerOptions) {
+		this.#config = options?.config ?? SANITIZER_ALLOWLIST
+	}
+
+	write(element: Element, html: string): void {
+		if (!isSanitizeTarget(element)) {
+			throw new AppError('The element has no setHTML method', 'SANITIZER_UNSUPPORTED', {
+				tag: readTag(element),
+			})
+		}
+		element.setHTML(html, { sanitizer: this.#config })
+	}
+}
