+ * the `placement.fallbacks` option. A string starting with `[` is read as JSON, as Bootstrap's
+ * `normalizeData` function reads one; any other string is split at each comma, and each member,
+ * trimmed, is read by the `parsePosition` function.
+ * @example
+ * ```ts
+ * parseFallbacks('top, bottom') // ['top', 'bottom']
+ * parseFallbacks('top,middle') // undefined
+ * ```
+ */
+export function parseFallbacks(value: unknown): readonly PlacementPosition[] | undefined {
+	const text = typeof value === 'string' ? value.trim() : undefined
+	const list =
+		text === undefined
+			? value
+			: text.startsWith('[')
+				? parseJSON(text)
+				: text.split(',').map((part) => part.trim())
+	const members = parseArray(list)
+	if (members === undefined || members.length === 0) return undefined
+	const positions: PlacementPosition[] = []
+	for (const member of members) {
+		const position = parsePosition(member)
+		if (position === undefined) return undefined
+		positions.push(position)
+	}
+	return positions
+}
