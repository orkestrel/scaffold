+import type {
+	PlacementInterface,
+	PlacementPosition,
+	SanitizerInterface,
+	TipContent,
+	TooltipAttributeMap,
+	TooltipClassMap,
+	TooltipInterface,
+	TooltipOptions,
+} from './types.js'
+import { AppError, isAppError } from '@src/core'
+import { isInstance, parseBoolean, parseString } from '@orkestrel/contract'
+import {
+	MODAL_EVENTS,
+	TOOLTIP_ATTRIBUTES,
+	TOOLTIP_CLASSES,
+	TOOLTIP_DEFAULTS,
+	TOOLTIP_EVENTS,
