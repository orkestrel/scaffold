+			false,
+		)
+		expect(isTooltipEvent(new CustomEvent('shown.vn.tooltip', { detail: '' }))).toBe(false)
+		expect(isTooltipEvent(new Event('shown.vn.tooltip'))).toBe(false)
+		expect(isTooltipEvent(undefined)).toBe(false)
+		expect(isTooltipEvent(null)).toBe(false)
