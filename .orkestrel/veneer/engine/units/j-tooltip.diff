+		const lifetime = options?.signal
+		if (lifetime?.aborted) this.destroy()
+		else lifetime?.addEventListener('abort', () => this.destroy(), { once: true, signal })
+	}
+
+	/**
+	 * Returns the live tooltip that owns a trigger, mirroring Bootstrap's `getInstance`.
+	 *
+	 * @param host - The trigger to look up.
+	 * @returns The owning tooltip, or undefined when no live tooltip owns the trigger.
+	 * @example
+	 * ```ts
+	 * await Tooltip.find(trigger)?.hide()
+	 * ```
+	 */
+	static find(host: HTMLElement): TooltipInterface | undefined {
+		return Tooltip.#registry.find(host)
+	}
+
+	get host(): HTMLElement {
+		return this.#host
+	}
+
+	get shown(): boolean {
+		const tip = this.#tip
+		return (
+			tip !== undefined &&
+			this.#parent !== undefined &&
+			tip.parentElement === this.#parent &&
+			tip.classList.contains(this.#classes.shown)
+		)
+	}
+
+	get enabled(): boolean {
+		return this.#enabled
+	}
+
+	async show(): Promise<boolean> {
+		if (this.#refused()) return false
+		// A content function runs inside this read and can destroy this tooltip or call it again, so the
+		// refusals are read once more after it.
+		if (!this.#filled() || this.#refused()) return false
+		// The identity is taken before the dispatch, so a show a listener starts inside it is refused as
+		// in flight, and a hide it starts takes this change over.
+		const change = {}
+		this.#change = change
+		try {
+			if (!emitEvent(this.#host, TOOLTIP_EVENTS.show, null, true)) return false
+			if (!this.#holds(change, undefined) || this.#blocked()) return false
+			// Restoring a settled shown tip's placement dispatches its `beforetoggle` event, and building a
+			// tip runs the content functions, so the call reads its door after each.
+			this.#discard()
+			if (!this.#holds(change, undefined)) return false
+			const tip = this.#build()
+			if (!this.#holds(change, undefined)) return false
+			const container = this.#resolveContainer()
+			this.#tip = tip
+			this.#parent = container
+			this.#describe(tip.id, true)
+			if (!this.#holds(change, tip)) return false
+			container.append(tip)
+			if (!this.#holds(change, tip) || tip.parentElement !== container) return false
+			emitEvent(this.#host, TOOLTIP_EVENTS.inserted, null, false)
+			if (!this.#holds(change, tip) || tip.parentElement !== container) return false
+			const placement = this.#place(tip)
+			if (placement === undefined) {
+				if (this.#holds(change, tip)) this.#discard()
+				return false
+			}
+			this.#placement = placement
+			if (!this.#holds(change, tip)) return false
+			reflow(tip)
+			tip.classList.add(this.#classes.shown)
+			if (!this.#holds(change, tip) || !this.shown) return false
+			if (this.#animated) {
+				await settleAnimations(tip, this.#controller.signal)
+				if (!this.#holds(change, tip) || !this.shown) return false
+			}
+			this.#change = undefined
+			emitEvent(this.#host, TOOLTIP_EVENTS.shown, null, false)
+			return !this.#controller.signal.aborted
+		} finally {
+			if (this.#change === change) this.#change = undefined
+		}
+	}
+
+	async hide(): Promise<boolean> {
+		if (this.#controller.signal.aborted || !this.shown) return false
+		const change = {}
+		this.#change = change
+		try {
+			if (!emitEvent(this.#host, TOOLTIP_EVENTS.hide, null, true)) return false
+			const tip = this.#tip
+			if (tip === undefined || !this.#holds(change, tip) || !this.shown) return false
+			this.#active.hover = false
+			this.#active.focus = false
+			this.#active.click = false
+			this.#entered = undefined
+			tip.classList.remove(this.#classes.shown)
+			if (!this.#holds(change, tip) || tip.classList.contains(this.#classes.shown)) return false
+			if (this.#animated) {
+				await settleAnimations(tip, this.#controller.signal)
+				if (!this.#holds(change, tip) || tip.classList.contains(this.#classes.shown)) {
+					return false
+				}
+			}
+			this.#discard()
+			if (!this.#holds(change, undefined)) return false
+			this.#change = undefined
+			emitEvent(this.#host, TOOLTIP_EVENTS.hidden, null, false)
+			// An interaction that asked for the tip while it was hiding, whose delay has run out, shows it.
+			if (this.#entered === true && this.#timer === undefined) void this.show()
+			return !this.#controller.signal.aborted
+		} finally {
+			if (this.#change === change) this.#change = undefined
+		}
+	}
+
+	async toggle(): Promise<boolean> {
+		if (!this.#enabled) return false
+		return this.shown ? this.hide() : this.show()
+	}
+
+	enable(): void {
+		if (!this.#controller.signal.aborted) this.#enabled = true
+	}
+
+	disable(): void {
+		if (!this.#controller.signal.aborted) this.#enabled = false
+	}
+
+	async fill(content: Readonly<Record<string, TipContent | undefined>>): Promise<boolean> {
+		if (this.#controller.signal.aborted) return false
+		this.#content = Object.freeze({ ...this.#content, ...content })
+		return this.shown ? this.show() : true
+	}
+
+	update(): void {
+		this.#placement?.update()
+	}
+
+	destroy(): void {
+		if (!this.#controller.signal.aborted) {
+			// The claim goes before anything is restored, so an engine constructed while restoration runs
+			// can claim the trigger. The abort destroys the placement and every descendant's tooltip,
+			// which hold this tooltip's signal.
+			Tooltip.#registry.release(this.#host, this)
+			this.#controller.abort()
+		}
+		this.#disarm()
+		this.#discard()
+		this.#snapshot.restore()
+	}
+
+	// Reports whether a show cannot start: the tooltip is destroyed, a change is in flight, or the
+	// tooltip is disabled or its trigger is disconnected or hidden inline.
+	#refused(): boolean {
+		return this.#controller.signal.aborted || this.#change !== undefined || this.#blocked()
+	}
+
+	// Reports whether the tooltip is disabled, its trigger is out of its document, or the trigger's
+	// inline `display` is `none`.
+	#blocked(): boolean {
+		return !this.#enabled || !this.#host.isConnected || this.#host.style.display === 'none'
+	}
+
+	// Reports whether any slot's content, a content function called with the trigger, is non-empty.
+	#filled(): boolean {
+		return Object.values(this.#content).some((content) => {
+			const value = typeof content === 'function' ? content(this.#host) : content
+			return value !== undefined && value !== ''
+		})
+	}
+
+	// Reports whether the call still holds its change: the tooltip is live, no later call started a
+	// change, and the tooltip holds the tip the call built, when the call has built one.
+	#holds(change: object, tip: HTMLElement | undefined): boolean {
+		return (
+			!this.#controller.signal.aborted &&
+			this.#change === change &&
+			(tip === undefined || this.#tip === tip)
+		)
+	}
+
+	// Builds a tip from the template through the sanitizer, marks it, and fills its slots.
+	#build(): HTMLElement {
+		const tip = buildTip(this.#template, this.#sanitizer)
+		const { shown, fade, auto } = this.#classes
+		tip.classList.remove(fade, shown)
+		tip.classList.add(auto, ...this.#tokens)
+		if (this.#animated) tip.classList.add(fade)
+		tip.id = this.#identify()
+		for (const [selector, content] of Object.entries(this.#content)) {
+			fillSlot(tip, selector, content, this.#html, this.#sanitizer, this.#host)
+		}
+		tip.addEventListener('toggle', (event) => this.#dismiss(tip, event), {
+			signal: this.#controller.signal,
+		})
+		return tip
+	}
+
+	// Returns an id no element of the trigger's document carries.
+	#identify(): string {
+		const owner = this.#host.ownerDocument
+		let id = `vn-tooltip-${Tooltip.#count++}`
+		while (owner.getElementById(id) !== null) id = `vn-tooltip-${Tooltip.#count++}`
+		return id
+	}
+
+	// Returns the element the tip goes into: the `container` option, else the closest ancestor
+	// carrying `aria-modal="true"`, else the body.
+	#resolveContainer(): HTMLElement {
+		if (this.#container !== undefined) return this.#container
+		const modal = this.#host.closest('[aria-modal="true"]')
+		return isInstance(modal, HTMLElement) ? modal : this.#host.ownerDocument.body
+	}
+
+	// Places the tip against the trigger, or returns undefined when the platform refused the promotion,
+	// which the placement reports after restoring what it wrote.
+	#place(tip: HTMLElement): PlacementInterface | undefined {
+		try {
+			return new Placement(
+				{ reference: this.#host, element: tip, popover: 'hint' },
+				{
+					attributes: { side: this.#attributes.side },
+					position: this.#position,
+					offset: this.#offset,
+					fallbacks: this.#fallbacks,
+					signal: this.#controller.signal,
+				},
+			)
+		} catch (error) {
+			if (isAppError(error) && error.code === 'PLACEMENT_PROMOTION_REFUSED') return undefined
+			throw error
+		}
+	}
+
+	// Restores the placement, removes the tip, and takes its id out of the trigger's
+	// `aria-describedby` attribute. The fields are cleared first, so a destroy a reaction runs inside
+	// the restoration finds nothing left, and a destroyed tooltip leaves the attribute to its snapshot.
+	#discard(): void {
+		const placement = this.#placement
+		const tip = this.#tip
+		this.#placement = undefined
+		this.#tip = undefined
+		this.#parent = undefined
+		placement?.destroy()
+		tip?.remove()
+		if (tip !== undefined && !this.#controller.signal.aborted) this.#describe(tip.id, false)
+	}
+
+	// Adds an id to the trigger's `aria-describedby` list, or takes it out and removes an emptied
+	// attribute, recording the attribute before its first write so destruction restores it.
+	#describe(id: string, present: boolean): void {
+		const name = 'aria-describedby'
+		const host = this.#host
+		const value = host.getAttribute(name)
+		if (!present && value === null) return
