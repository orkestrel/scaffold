+		expect(isSanitizeTarget(document.createElement('div'))).toBe(true)
+		expect(isSanitizeTarget({ setHTML: () => undefined })).toBe(true)
+		expect(isSanitizeTarget({ setHTML: 'markup' })).toBe(false)
+		expect(isSanitizeTarget({})).toBe(false)
+		expect(isSanitizeTarget(null)).toBe(false)
+		expect(isSanitizeTarget('setHTML')).toBe(false)
+		const shadowed = document.createElement('div')
+		Object.defineProperty(shadowed, 'setHTML', { value: undefined })
+		expect(isSanitizeTarget(shadowed)).toBe(false)
+	})
+
+	it('returns false when a trap or an accessor throws', () => {
+		expect(
+			isSanitizeTarget(
+				new Proxy(
+					{},
+					{
+						has() {
+							throw new Error('Unreadable')
+						},
+					},
+				),
+			),
+		).toBe(false)
+		const hostile = {}
+		Object.defineProperty(hostile, 'setHTML', {
+			get() {
+				throw new Error('Unreadable')
+			},
+		})
+		expect(isSanitizeTarget(hostile)).toBe(false)
+	})
+})
