+/**
+ * Checks whether a DOM event is a tooltip event, which carries no payload.
+ *
+ * @param value - The value to inspect.
+ * @returns True if the value is a CustomEvent whose detail is null; false otherwise.
+ * @remarks
+ * A tooltip dispatches each event with no detail, and the platform reads an absent `detail` as
+ * `null`, which is the `CustomEvent<null>` type every key of the tooltip event map carries, so a
+ * consumer's own event under a tooltip wire name that carries a payload is refused. The class half
+ * reads through the `isInstance` function `@orkestrel/contract` publishes, which contains a hostile
+ * prototype's throw, and the containment here covers a `detail` accessor that throws.
+ * @example
+ * ```ts
+ * isTooltipEvent(new CustomEvent('shown.vn.tooltip')) // true
+ * isTooltipEvent(new CustomEvent('shown.vn.tooltip', { detail: { shown: true } })) // false
+ * ```
+ */
+export function isTooltipEvent(value: unknown): value is TooltipEventMap['show'] {
+	try {
+		return isInstance(value, CustomEvent) && value.detail === null
+	} catch {
+		return false
+	}
+}
+
+/**
+ * Checks whether a value carries the platform's `setHTML` method, which parses markup through a sanitizer.
+ *
+ * @param value - The value to inspect.
+ * @returns True if the value is an object whose `setHTML` member is a function; false otherwise.
+ * @remarks
+ * TypeScript's DOM library omits `setHTML`, so the native sanitizer narrows an element through this
+ * guard before it writes markup. A value whose `setHTML` accessor or prototype trap throws reads as
+ * false.
+ * @example
+ * ```ts
+ * isSanitizeTarget(document.createElement('div')) // true on Chromium
+ * isSanitizeTarget({}) // false
+ * ```
+ */
+export function isSanitizeTarget(value: unknown): value is SanitizeTargetInterface {
+	try {
+		return (
+			typeof value === 'object' &&
+			value !== null &&
+			'setHTML' in value &&
+			typeof value.setHTML === 'function'
+		)
+	} catch {
+		return false
+	}
+}
