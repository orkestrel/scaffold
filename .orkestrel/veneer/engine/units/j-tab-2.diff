+describe('isTabEvent', () => {
+	it('requires a custom event whose detail carries an HTML element or nothing as its related target', () => {
+		const control = build('button')
+		expect(isTabEvent(new CustomEvent('show.vn.tab', { detail: { relatedTarget: control } }))).toBe(
