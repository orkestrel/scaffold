+							throw new Error('Unreadable')
+						},
+					},
+				),
+			),
+		).toBe(false)
+		const event = new CustomEvent('show.vn.tab', {
+			detail: {
+				get relatedTarget() {
+					throw new Error('Unreadable')
+				},
+			},
+		})
+		expect(isTabEvent(event)).toBe(false)
+		expect(attempt(() => isTabEvent(event))).toEqual({ success: true, value: false })
+	})
