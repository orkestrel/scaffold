+		)
+		expect(
+			isTabEvent(new CustomEvent('shown.vn.tab', { detail: { relatedTarget: undefined } })),
+		).toBe(true)
+		expect(isTabEvent(new CustomEvent('hidden.vn.tab', { detail: {} }))).toBe(true)
+		expect(isTabEvent(new CustomEvent('show.vn.tab'))).toBe(false)
+		expect(isTabEvent(new CustomEvent('show.vn.tab', { detail: { relatedTarget: null } }))).toBe(
+			false,
+		)
+		expect(
+			isTabEvent(new CustomEvent('show.vn.tab', { detail: { relatedTarget: '#profile' } })),
+		).toBe(false)
+		expect(
+			isTabEvent(
+				new CustomEvent('show.vn.tab', {
+					detail: {
+						relatedTarget: document.createElementNS('http://www.w3.org/2000/svg', 'svg'),
+					},
+				}),
+			),
+		).toBe(false)
+		expect(isTabEvent(new CustomEvent('show.vn.tab', { detail: 'profile' }))).toBe(false)
+		expect(isTabEvent(new Event('show.vn.tab'))).toBe(false)
+		expect(isTabEvent(undefined)).toBe(false)
+		expect(isTabEvent(null)).toBe(false)
+	})
