+	it('returns an end member for a current value outside the list, and undefined for an empty list', () => {
+		const controls = ['home', 'profile', 'contact']
+		expect(computeNeighbor(controls, 'settings', true, true)).toBe('home')
+		expect(computeNeighbor(controls, 'settings', false, true)).toBe('contact')
+		expect(computeNeighbor(controls, 'settings', false, false)).toBe('home')
+		expect(computeNeighbor(controls, 'settings', true, false)).toBe('home')
