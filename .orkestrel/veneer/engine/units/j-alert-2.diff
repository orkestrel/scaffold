index 0000000..81b943b
--- /dev/null
+++ b/src/browser/Alert.ts
@@ -0,0 +1,176 @@
+import type { AlertClassMap, AlertInterface, AlertOptions } from './types.js'
+import { AppError } from '@src/core'
+import { isInstance } from '@orkestrel/contract'
+import { ALERT_ATTRIBUTES, ALERT_CLASSES, ALERT_EVENTS, ALERT_SELECTORS } from './constants.js'
+import {
+	bindEventMap,
+	emitEvent,
+	readTag,
+	reflow,
+	resolveVocabulary,
+	settleAnimations,
+} from './helpers.js'
+import { HostSnapshot } from './HostSnapshot.js'
+import { Registry } from './Registry.js'
+import { isAlertEvent, isAttributeName, isClassToken, isSelector } from './validators.js'
+
+/**
+ * Closes an alert by removing its shown token, waiting out its fade, and removing it from the document.
+ *
+ * @remarks
+ * The host must be an HTMLElement in the current realm and have no live alert owner. Construction
+ * writes nothing: it validates and copies the `classes`, `attributes`, and `selectors` groups,
+ * claims the host, and binds the hooks. The alert keeps the `classes` group; the delegate routes
+ * dismiss clicks by the `attributes` and `selectors` groups, so the alert keeps neither, and
+ * resolving them still refuses an invalid value at construction. Closing dispatches the cancelable
+ * `close` event, removes the `shown` token, and, when the host carries the `fade` token, waits for
+ * its running animations to settle; it then removes the host from the document, dispatches `closed`
+ * on the removed host, and releases its hooks and its claim as Bootstrap's `dispose` after `closed`
+ * does, keeping the host as the close left it. A close is in flight from its dispatch of `close`,
+ * so a close a listener or a reaction starts inside that dispatch resolves `false` and dispatches
+ * nothing. After each write, dispatch, and await, a close reads its lifetime and the host again:
+ * from the removal of the `shown` token on, the host must lack it, and after the removal of the
+ * host, the host must be out of the document. A close that finds the alert destroyed or the host
+ * otherwise stops, writing and dispatching nothing more, and resolves `false`. Destruction restores the `shown` token without removing the host, and an aborted
+ * `signal` destroys the alert.
+ *
+ * @example
+ * ```ts
+ * const host = document.createElement('div')
+ * host.className = 'alert fade show'
+ * document.body.append(host)
+ * const alert = new Alert(host)
+ * await alert.close()
+ * ```
+ */
+export class Alert implements AlertInterface {
+	static readonly #registry = new Registry<Alert>({ code: 'ALERT_HOST_OWNED' })
+	readonly #host: HTMLElement
+	readonly #classes: AlertClassMap
+	readonly #snapshot = new HostSnapshot()
+	readonly #controller = new AbortController()
+	// Whether a close is in flight, from its dispatch of the close event until it returns. A close
+	// that starts while it is set is refused, so one close runs at a time and needs no identity of its
+	// own.
+	#closing = false
+
+	/**
+	 * Claims the host, resolves its vocabulary, and binds initial hooks.
+	 *
+	 * @param host - The HTML element to own, the alert.
+	 * @param options - The markup vocabulary, initial event subscriptions, and lifetime.
+	 * @throws Thrown when the host is not an HTMLElement, when a group value is not a class token, an attribute name, or a selector, or when the host already has a live owner.
+	 */
+	constructor(host: HTMLElement, options?: AlertOptions) {
+		if (!isInstance(host, HTMLElement)) {
+			throw new AppError('Alert requires an HTMLElement host', 'ALERT_HOST_INVALID', {
+				tag: readTag(host),
+			})
+		}
+		this.#classes = resolveVocabulary(
+			'ALERT_OPTION_INVALID',
+			ALERT_CLASSES,
+			isClassToken,
+			options?.classes,
+		)
+		resolveVocabulary(
+			'ALERT_OPTION_INVALID',
+			ALERT_ATTRIBUTES,
+			isAttributeName,
+			options?.attributes,
+		)
+		resolveVocabulary('ALERT_OPTION_INVALID', ALERT_SELECTORS, isSelector, options?.selectors)
+		Alert.#registry.claim(host, this)
+		this.#host = host
+		bindEventMap(host, ALERT_EVENTS, isAlertEvent, options?.on, this.#controller.signal)
+		const signal = options?.signal
+		if (signal?.aborted) this.destroy()
+		else {
+			signal?.addEventListener('abort', () => this.destroy(), {
+				once: true,
+				signal: this.#controller.signal,
+			})
+		}
+	}
+
+	/**
+	 * Returns the live alert that owns a host, mirroring Bootstrap's `getInstance`.
+	 *
+	 * @param host - The alert element to look up.
+	 * @returns The owning alert, or undefined when no live alert owns the host.
+	 * @example
+	 * ```ts
+	 * await Alert.find(host)?.close()
+	 * ```
+	 */
+	static find(host: HTMLElement): AlertInterface | undefined {
+		return Alert.#registry.find(host)
+	}
+
+	get host(): HTMLElement {
+		return this.#host
+	}
+
+	async close(): Promise<boolean> {
+		if (this.#refused()) return false
+		// The close is in flight from its dispatch, so a call a listener or a reaction makes inside the
+		// dispatch is refused and dispatches nothing.
+		this.#closing = true
+		try {
+			if (!emitEvent(this.#host, ALERT_EVENTS.close, null, true)) return false
+			// A listener runs inside the dispatch and can destroy this alert, so the lifetime is read
+			// again before any write.
+			if (this.#controller.signal.aborted) return false
+			const host = this.#host
+			const { shown, fade } = this.#classes
+			this.#snapshot.save({ category: 'token', element: host, name: shown })
+			// The layout read gives a freshly inserted alert a computed style, so removing the shown
+			// token starts its fade in this task.
+			reflow(host)
+			if (!this.#apply(() => host.classList.remove(shown))) return false
+			if (host.classList.contains(fade)) {
+				await settleAnimations(host, this.#controller.signal)
+				if (!this.#holds()) return false
+			}
+			// A disconnection reaction runs inside the removal and can insert the host again.
+			if (!this.#apply(() => host.remove()) || host.isConnected) return false
+			emitEvent(host, ALERT_EVENTS.closed, null, false)
+			if (this.#controller.signal.aborted) return false
+			this.#release()
+			return true
+		} finally {
+			this.#closing = false
+		}
+	}
+
+	destroy(): void {
+		if (this.#controller.signal.aborted) return
+		// The claim goes before the host is restored, so an engine constructed while restoration runs
+		// can claim the host, and its snapshot takes the values this one has still to write back.
+		this.#release()
+		this.#snapshot.restore()
+	}
+
+	// Reports whether a close cannot start: the alert is destroyed or a close is in flight.
+	#refused(): boolean {
+		return this.#controller.signal.aborted || this.#closing
+	}
+
+	// Reports whether the close in flight still holds: the alert is live and the host lacks the
+	// `shown` token.
+	#holds(): boolean {
+		return !this.#controller.signal.aborted && !this.#host.classList.contains(this.#classes.shown)
+	}
+
+	// Runs one write a reaction can run inside, then reads whether the close still holds.
+	#apply(write: () => void): boolean {
+		write()
+		return this.#holds()
+	}
+
+	// Releases the hooks and the claim, which ends the alert's lifetime.
+	#release(): void {
+		this.#controller.abort()
+		Alert.#registry.release(this.#host, this)
+	}
+}
