@@ -0,0 +1,585 @@
+import type { AlertInterface } from '@src/browser'
+import { Alert, ALERT_ATTRIBUTES, ALERT_CLASSES, ALERT_EVENTS, ALERT_SELECTORS } from '@src/browser'
+import { isAppError } from '@src/core'
+import { attempt } from '@orkestrel/contract'
+import { createRecorder, requireValue, waitForDelay } from '@orkestrel/test'
+import { afterEach, describe, expect, it, onTestFinished } from 'vitest'
+import alertCascade from '../../../src/styles/components/_alert.scss?inline'
+import { recordListeners, scene } from '../../setupBrowser.js'
+
+afterEach(() => scene.clear())
+
+describe('Alert', () => {
+	// The shipped alert cascade declares no fade, so a case proving the fade wait loads Bootstrap's
+	// own `.fade` declarations beside it; each case states which sheets it loads.
+	const fade = '.fade { transition: opacity 0.15s linear } .fade:not(.show) { opacity: 0 }'
+
+	it('publishes frozen default tables that name the cascade tokens, the Bootstrap attribute and selector, and the wire events', () => {
+		expect(ALERT_CLASSES).toStrictEqual({
+			host: 'alert',
+			shown: 'show',
+			fade: 'fade',
+			disabled: 'disabled',
+		})
+		expect(ALERT_ATTRIBUTES).toStrictEqual({ target: 'data-bs-target' })
+		expect(ALERT_SELECTORS).toStrictEqual({ dismiss: '[data-bs-dismiss="alert"]' })
+		expect(ALERT_EVENTS).toStrictEqual({ close: 'close.vn.alert', closed: 'closed.vn.alert' })
+		for (const table of [ALERT_CLASSES, ALERT_ATTRIBUTES, ALERT_SELECTORS, ALERT_EVENTS]) {
+			expect(Object.isFrozen(table)).toBe(true)
+		}
+	})
+
+	it('reads the shipped alert declarations, which keep the alert in flow and run no transition', () => {
+		const sheet = requireValue(scene.load(alertCascade).sheet, 'The cascade sheet did not load')
+		const root = scene.mount('<div class="alert fade show">Saved</div>')
+		const host = requireValue(root.querySelector('div'), 'No alert')
+		expect(sheet.cssRules.length).toBeGreaterThan(0)
+		expect(getComputedStyle(host).position).toBe('relative')
+		expect(getComputedStyle(host).transitionDuration).toBe('0s')
+		host.classList.remove('show')
+		expect(getComputedStyle(host).opacity).toBe('1')
+		expect(host.getAnimations()).toEqual([])
+	})
+
+	it('closes an alert without the fade token inside the call, dispatching closed on the removed host, and releases itself', async () => {
+		scene.load(alertCascade)
+		const root = scene.mount('<div class="alert alert-warning show">Saved</div>')
+		const host = requireValue(root.querySelector<HTMLElement>('.alert'), 'No alert')
+		const events = createRecorder<readonly [string, boolean, boolean]>()
+		const alert = new Alert(host, {
+			on: {
+				close: (event) =>
+					events.handler(event.type, host.isConnected, host.classList.contains('show')),
+				closed: (event) =>
+					events.handler(event.type, host.isConnected, host.classList.contains('show')),
+			},
+		})
+		onTestFinished(() => alert.destroy())
+		expect(alert.host).toBe(host)
+		expect(Alert.find(host)).toBe(alert)
+		const closing = alert.close()
+		expect(host.isConnected).toBe(false)
+		expect(events.calls).toEqual([
+			['close.vn.alert', true, true],
+			['closed.vn.alert', false, false],
+		])
+		expect(await closing).toBe(true)
+		expect(Array.from(host.classList)).toEqual(['alert', 'alert-warning'])
+		expect(Array.from(host.attributes, (attribute) => attribute.name)).toEqual(['class'])
+		expect(Alert.find(host)).toBeUndefined()
+		const writes = createRecorder<readonly [readonly MutationRecord[]]>()
+		const observer = new MutationObserver((records) => writes.handler(records))
+		onTestFinished(() => observer.disconnect())
+		observer.observe(host, { attributes: true, childList: true, subtree: true })
+		alert.destroy()
+		expect(await alert.close()).toBe(false)
+		expect([...writes.calls.flat(2), ...observer.takeRecords()]).toEqual([])
+		expect(events.count).toBe(2)
+		const replacement = new Alert(host)
+		onTestFinished(() => replacement.destroy())
+		expect(Alert.find(host)).toBe(replacement)
+	})
+
+	it('fades an alert carrying the fade token out through its opacity transition before it removes the host', async () => {
+		scene.load(alertCascade)
+		scene.load(fade)
+		const root = scene.mount('<div class="alert alert-info fade show">Saved</div>')
+		const host = requireValue(root.querySelector<HTMLElement>('.alert'), 'No alert')
+		const order = createRecorder<readonly [string]>()
+		const alert = new Alert(host, { on: { closed: (event) => order.handler(event.type) } })
+		onTestFinished(() => alert.destroy())
+		const closing = alert.close()
+		expect(Array.from(host.classList)).toEqual(['alert', 'alert-info', 'fade'])
+		expect(host.isConnected).toBe(true)
+		const animations = host.getAnimations()
+		expect(
+			animations.map((animation) =>
+				animation instanceof CSSTransition ? animation.transitionProperty : animation.id,
+			),
+		).toEqual(['opacity'])
+		expect(getComputedStyle(host).transitionDuration).toBe('0.15s')
+		void animations[0]?.finished.then(() => order.handler('finished'))
+		expect(await closing).toBe(true)
+		expect(order.calls).toEqual([['finished'], ['closed.vn.alert']])
+		expect(host.isConnected).toBe(false)
