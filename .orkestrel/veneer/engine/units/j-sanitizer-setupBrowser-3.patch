+/**
+ * Lists sanitizer configurations the platform's `setHTML` method accepts and refuses, read on Chromium 153.
+ *
+ * @remarks
+ * Every entry is a well-formed dictionary, so each refusal is one of the platform's validity rules
+ * rather than a type conversion: a `dataAttributes` field without an `attributes` list, a
+ * duplicate name, an element's own attribute that the global list repeats, and a `data-*` name
+ * listed beside `dataAttributes: true`.
+ */
+export const SANITIZER_CONFIGS: readonly SanitizerConfig[] = Object.freeze([
+	{},
+	{ elements: [] },
+	{ attributes: [] },
+	{ elements: ['b'], attributes: ['title'] },
+	{ elements: [{ name: 'b', attributes: ['title'] }] },
+	{ elements: [{ name: 'b', attributes: [] }], attributes: ['title'] },
+	{ attributes: ['title'], dataAttributes: true },
+	{ attributes: ['title'], dataAttributes: false },
+	{ attributes: ['data-x'], dataAttributes: false },
+	{ elements: ['script'], attributes: ['onclick'] },
+	{ dataAttributes: true },
+	{ dataAttributes: false },
+	{ elements: [{ name: 'b' }], dataAttributes: true },
+	{ attributes: ['data-x'], dataAttributes: true },
+	{ elements: [{ name: 'b', attributes: ['data-x'] }], attributes: [], dataAttributes: true },
+	{ elements: ['b', 'b'] },
+	{ elements: ['b', { name: 'b' }] },
+	{ attributes: ['title', 'title'] },
+	{ elements: [{ name: 'b', attributes: ['title', 'title'] }] },
+	{ elements: [{ name: 'b', attributes: ['title'] }], attributes: ['title'] },
+	SANITIZER_ALLOWLIST,
+])
+
+/**
+ * Builds a detached element whose own `setHTML` member is undefined, so a sanitizer writing into it walks the markup.
+ *
+ * @param tag - The element's tag name, such as `div`.
+ * @returns The built element, not yet in any document.
+ *
+ * @remarks
+ * The own property shadows the prototype's method on this element alone, so the element reads to the
+ * `isSanitizeTarget` guard as every element does on a Chromium that carries no `setHTML` method, such
+ * as Chromium 141, while every other element of the page keeps the method.
+ *
+ * @example
+ * ```ts
+ * new ConfigSanitizer().write(buildWalkTarget('div'), '<b>Saved</b>')
+ * ```
+ */
+export function buildWalkTarget<K extends keyof HTMLElementTagNameMap>(
+	tag: K,
+): HTMLElementTagNameMap[K] {
+	return shadowSetHTML(build(tag))
+}
+
+/**
+ * Shadows an element's `setHTML` method with an own member that is undefined, so a sanitizer writing into it walks the markup.
+ *
+ * @param element - The element to shadow the method on, from this window's document or another's.
+ * @returns The same element.
+ *
+ * @remarks
+ * The `buildWalkTarget` function builds a detached HTML element this way. Call this function for an
+ * element that function cannot build, such as a MathML element or an element of another window's
+ * document.
+ *
+ * @example
+ * ```ts
+ * shadowSetHTML(document.createElementNS('http://www.w3.org/1998/Math/MathML', 'annotation-xml'))
+ * ```
+ */
+export function shadowSetHTML<T extends Element>(element: T): T {
+	Object.defineProperty(element, 'setHTML', { value: undefined })
+	return element
+}
+
+/**
+ * Mounts an empty iframe element and returns its document, a document of another window.
+ *
+ * @returns The iframe element's document, inside a container {@link scene} removes for you.
+ *
+ * @remarks
+ * A node the returned document creates belongs to the iframe element's window, so this window's
+ * constructors do not recognise it. A case that proves a mechanism works without this window's
+ * constructors writes into such a node.
+ *
+ * @example
+ * ```ts
+ * const target = shadowSetHTML(mountFrameDocument().createElement('template'))
+ * ```
+ */
+export function mountFrameDocument(): Document {
+	const host = scene.mount('<iframe></iframe>')
+	const frame = requireValue(host.querySelector('iframe'), 'The mounted host renders no iframe')
+	return requireValue(frame.contentDocument, 'The mounted iframe has no document')
+}
