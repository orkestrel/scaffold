+/**
+ * Pairs one sanitizer configuration and one markup string with the markup a sanitizer keeps.
+ *
+ * @remarks
+ * The `expected` markup is what the platform's `setHTML` method keeps, read on Chromium 153, and
+ * the walk keeps the same wherever the `walked` markup is absent. A case carrying `walked` is one
+ * where the walk's safety floor removes more than the platform does, and `walked` is what it keeps.
+ */
+export interface SanitizerCase {
+	readonly name: string
+	readonly config?: SanitizerConfig
+	readonly markup: string
+	readonly expected: string
+	readonly walked?: string
+}
+
