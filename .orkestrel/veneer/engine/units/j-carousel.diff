+			this.#host.ownerDocument.visibilityState === 'visible' &&
+			this.#host.checkVisibility({ visibilityProperty: true })
+		) {
+			void this.#step(true, false)
+		}
+	}
+
+	// Stops the timer without changing whether cycling is wanted.
+	#suspend(): void {
+		clearTimeout(this.#timer)
+		this.#timer = undefined
+	}
+
+	// Rearms the timer when cycling is wanted.
+	#resume(): void {
+		if (this.#started) this.#arm()
+	}
+
+	// Reads the active item's interval attribute, falling back to the `interval` option.
+	#period(): number {
