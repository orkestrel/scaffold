+	// no touch or pen pointer is down.
+	#pointer: number | undefined
+	#origin = 0
+
+	/**
+	 * Writes the host's `pointer` token and listens for its pointer events.
+	 *
+	 * @param host - The HTML element whose pointer events are read.
+	 * @param options - The handler each swipe calls, the threshold, and the markup vocabulary.
+	 * @throws Thrown when the host is not an HTMLElement, as an `AppError` carrying the `SWIPE_HOST_INVALID` code, or when a `classes` value is not a class token or the threshold is not a finite number at or above zero, as an `AppError` carrying the `SWIPE_OPTION_INVALID` code.
+	 */
+	constructor(host: HTMLElement, options: SwipeOptions) {
+		if (!isInstance(host, HTMLElement)) {
+			throw new AppError('Swipe requires an HTMLElement host', 'SWIPE_HOST_INVALID', {
+				tag: readTag(host),
+			})
+		}
+		const classes: SwipeClassMap = resolveVocabulary(
+			'SWIPE_OPTION_INVALID',
+			SWIPE_CLASSES,
+			isClassToken,
+			options.classes,
+		)
