index 0000000..ee529fa
--- /dev/null
+++ b/tests/src/browser/Swipe.test.ts
@@ -0,0 +1,170 @@
+import type { SwipeDirection } from '@src/browser'
+import { Swipe, SWIPE_CLASSES, SWIPE_DEFAULTS } from '@src/browser'
+import { attempt } from '@orkestrel/contract'
+import { createRecorder, requireValue } from '@orkestrel/test'
+import { createPointerEvent } from '@orkestrel/test/browser'
+import { afterEach, describe, expect, it, onTestFinished } from 'vitest'
+import { scene } from '../../setupBrowser.js'
+
+afterEach(() => scene.clear())
+
+describe('Swipe', () => {
+	it('publishes frozen default tables that name the cascade token and the threshold', () => {
+		expect(SWIPE_CLASSES).toStrictEqual({ pointer: 'pointer-event' })
+		expect(SWIPE_DEFAULTS).toStrictEqual({ threshold: 40 })
+		expect(Object.isFrozen(SWIPE_CLASSES)).toBe(true)
+		expect(Object.isFrozen(SWIPE_DEFAULTS)).toBe(true)
+	})
+
+	it('reports a leftward and a rightward touch swipe past the threshold, and none at the threshold', () => {
+		const root = scene.mount('<div id="track" class="carousel"></div>')
+		const host = requireValue(root.querySelector<HTMLElement>('#track'), 'No host')
+		const directions = createRecorder<readonly [SwipeDirection]>()
+		const swipe = new Swipe(host, { handler: directions.handler })
+		onTestFinished(() => swipe.destroy())
+		expect(swipe.host).toBe(host)
+		const touch = { pointerType: 'touch', pointerId: 7 }
+		host.dispatchEvent(createPointerEvent('pointerdown', { ...touch, clientX: 200 }))
+		host.dispatchEvent(createPointerEvent('pointerup', { ...touch, clientX: 159 }))
+		host.dispatchEvent(createPointerEvent('pointerdown', { ...touch, clientX: 200 }))
+		host.dispatchEvent(createPointerEvent('pointerup', { ...touch, clientX: 241 }))
+		host.dispatchEvent(createPointerEvent('pointerdown', { ...touch, clientX: 200 }))
+		host.dispatchEvent(createPointerEvent('pointerup', { ...touch, clientX: 160 }))
+		host.dispatchEvent(createPointerEvent('pointerdown', { ...touch, clientX: 200 }))
+		host.dispatchEvent(createPointerEvent('pointerup', { ...touch, clientX: 240 }))
+		expect(directions.calls).toEqual([['left'], ['right']])
+	})
+
+	it('reads pen pointers and ignores mouse pointers', () => {
+		const root = scene.mount('<div id="track"><span id="inner">Inner</span></div>')
+		const host = requireValue(root.querySelector<HTMLElement>('#track'), 'No host')
+		const inner = requireValue(root.querySelector<HTMLElement>('#inner'), 'No inner node')
+		const directions = createRecorder<readonly [SwipeDirection]>()
+		const swipe = new Swipe(host, { handler: directions.handler })
+		onTestFinished(() => swipe.destroy())
+		inner.dispatchEvent(createPointerEvent('pointerdown', { pointerType: 'mouse', clientX: 200 }))
+		inner.dispatchEvent(createPointerEvent('pointerup', { pointerType: 'mouse', clientX: 20 }))
+		expect(directions.count).toBe(0)
+		const pen = { pointerType: 'pen', pointerId: 3 }
+		inner.dispatchEvent(createPointerEvent('pointerdown', { ...pen, clientX: 20 }))
+		inner.dispatchEvent(createPointerEvent('pointerup', { ...pen, clientX: 200 }))
+		expect(directions.calls).toEqual([['right']])
+	})
+
+	it('pairs a release with the pointer that went down last, and discards a pointer the platform cancels', () => {
+		const root = scene.mount('<div id="track"></div>')
+		const host = requireValue(root.querySelector<HTMLElement>('#track'), 'No host')
+		const directions = createRecorder<readonly [SwipeDirection]>()
+		const swipe = new Swipe(host, { handler: directions.handler })
+		onTestFinished(() => swipe.destroy())
+		host.dispatchEvent(
+			createPointerEvent('pointerdown', { pointerType: 'touch', pointerId: 1, clientX: 200 }),
+		)
+		host.dispatchEvent(
+			createPointerEvent('pointerup', { pointerType: 'touch', pointerId: 2, clientX: 20 }),
+		)
+		expect(directions.count).toBe(0)
+		host.dispatchEvent(
+			createPointerEvent('pointercancel', { pointerType: 'touch', pointerId: 1, clientX: 20 }),
+		)
+		host.dispatchEvent(
+			createPointerEvent('pointerup', { pointerType: 'touch', pointerId: 1, clientX: 20 }),
+		)
+		expect(directions.count).toBe(0)
+		host.dispatchEvent(
+			createPointerEvent('pointerdown', { pointerType: 'touch', pointerId: 4, clientX: 200 }),
+		)
+		host.dispatchEvent(
+			createPointerEvent('pointerdown', { pointerType: 'touch', pointerId: 5, clientX: 300 }),
+		)
+		host.dispatchEvent(
+			createPointerEvent('pointerup', { pointerType: 'touch', pointerId: 4, clientX: 20 }),
+		)
+		expect(directions.count).toBe(0)
+		host.dispatchEvent(
+			createPointerEvent('pointerup', { pointerType: 'touch', pointerId: 5, clientX: 250 }),
+		)
+		expect(directions.calls).toEqual([['left']])
+		host.dispatchEvent(
+			createPointerEvent('pointerup', { pointerType: 'touch', pointerId: 5, clientX: 20 }),
+		)
+		expect(directions.calls).toEqual([['left']])
+	})
+
+	it('adds its pointer token at construction and restores the host on destruction, reporting nothing after', () => {
+		const root = scene.mount(`
+			<div id="bare"></div>
+			<div id="classed" class="carousel"></div>
+			<div id="marked" class="pointer-event"></div>`)
+		const bare = requireValue(root.querySelector<HTMLElement>('#bare'), 'No bare host')
+		const classed = requireValue(root.querySelector<HTMLElement>('#classed'), 'No classed host')
+		const marked = requireValue(root.querySelector<HTMLElement>('#marked'), 'No marked host')
+		const directions = createRecorder<readonly [SwipeDirection]>()
+		const swipes = [bare, classed, marked].map(
+			(host) => new Swipe(host, { handler: directions.handler }),
+		)
+		onTestFinished(() => {
+			for (const swipe of swipes) swipe.destroy()
+		})
+		expect(Array.from(bare.classList)).toEqual(['pointer-event'])
+		expect(Array.from(classed.classList)).toEqual(['carousel', 'pointer-event'])
+		expect(Array.from(marked.classList)).toEqual(['pointer-event'])
+		classed.classList.add('consumer')
+		for (const swipe of swipes) swipe.destroy()
+		expect(bare.hasAttribute('class')).toBe(false)
+		expect(Array.from(classed.classList)).toEqual(['carousel', 'consumer'])
+		expect(Array.from(marked.classList)).toEqual(['pointer-event'])
+		bare.dispatchEvent(createPointerEvent('pointerdown', { pointerType: 'touch', clientX: 200 }))
+		bare.dispatchEvent(createPointerEvent('pointerup', { pointerType: 'touch', clientX: 20 }))
+		expect(directions.count).toBe(0)
+		swipes[0]?.destroy()
+		expect(bare.hasAttribute('class')).toBe(false)
+	})
+
+	it('writes the replacing token, measures the replacing threshold, and refuses an invalid host, token, or threshold', () => {
+		const root = scene.mount('<div id="track"></div>')
+		const host = requireValue(root.querySelector<HTMLElement>('#track'), 'No host')
+		const directions = createRecorder<readonly [SwipeDirection]>()
+		const swipe = new Swipe(host, {
+			handler: directions.handler,
+			threshold: 10,
+			classes: { pointer: 'is-swipeable' },
+		})
+		onTestFinished(() => swipe.destroy())
+		expect(Array.from(host.classList)).toEqual(['is-swipeable'])
+		host.dispatchEvent(createPointerEvent('pointerdown', { pointerType: 'touch', clientX: 100 }))
+		host.dispatchEvent(createPointerEvent('pointerup', { pointerType: 'touch', clientX: 89 }))
+		expect(directions.calls).toEqual([['left']])
+		swipe.destroy()
+		expect(host.hasAttribute('class')).toBe(false)
+		expect(
+			attempt(() => Reflect.construct(Swipe, [null, { handler: directions.handler }])),
+		).toMatchObject({
+			success: false,
+			error: { code: 'SWIPE_HOST_INVALID', context: { tag: undefined } },
+		})
+		expect(
+			attempt(
+				() =>
+					new Swipe(host, { handler: directions.handler, classes: { pointer: 'is swipeable' } }),
+			),
+		).toMatchObject({
+			success: false,
+			error: { code: 'SWIPE_OPTION_INVALID', context: { key: 'pointer' } },
+		})
+		for (const threshold of [-1, Number.NaN, Number.POSITIVE_INFINITY]) {
+			expect(
+				attempt(() => new Swipe(host, { handler: directions.handler, threshold })),
+			).toMatchObject({
+				success: false,
+				error: { code: 'SWIPE_OPTION_INVALID', context: { key: 'threshold' } },
+			})
+		}
+		expect(host.hasAttribute('class')).toBe(false)
+		const zero = new Swipe(host, { handler: directions.handler, threshold: -0 })
+		onTestFinished(() => zero.destroy())
+		host.dispatchEvent(createPointerEvent('pointerdown', { pointerType: 'touch', clientX: 100 }))
+		host.dispatchEvent(createPointerEvent('pointerup', { pointerType: 'touch', clientX: 101 }))
+		expect(directions.calls).toEqual([['left'], ['right']])
+	})
+})
