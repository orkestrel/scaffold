+import { AppError } from '@src/core'
+import { isFiniteNumber, isInstance } from '@orkestrel/contract'
+import { SWIPE_CLASSES, SWIPE_DEFAULTS } from './constants.js'
+import { readTag, resolveVocabulary } from './helpers.js'
