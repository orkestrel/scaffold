+		event.preventDefault()
+		void this.#step(event.key === 'ArrowRight', true)
+	}
+
+	// Stops the timer when a touch or pen lifts and resumes it after the touch delay and the interval,
+	// so the compatibility mouse events the lift fires cannot leave the hover pause in place.
+	#defer(event: PointerEvent): void {
+		if (event.pointerType === 'mouse') return
+		this.#suspend()
+		clearTimeout(this.#touch)
+		this.#touch = setTimeout(() => this.#resume(), CAROUSEL_TOUCH_DELAY + this.#period())
+	}
+
+	// Slides forward on a leftward swipe and back on a rightward one, as the content moves.
+	#swiped(direction: SwipeDirection): void {
+		void this.#step(direction === 'left', true)
+	}
+
+	// Refuses the native drag of an image inside an item, which would take over a swipe.
+	#refuse(event: DragEvent): void {
+		const image = `:is(${this.#selectors.entry}) :is(${this.#selectors.image})`
+		if (isInstance(event.target, Element) && event.target.matches(image)) event.preventDefault()
+	}
+}
