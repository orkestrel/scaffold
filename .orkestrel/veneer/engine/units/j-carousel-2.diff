+		this.#host = host
+		this.#interval = resolved.interval
+		this.#ride = resolved.ride
+		this.#wrap = resolved.wrap
+		this.#hover = resolved.pause
+		const signal = this.#controller.signal
+		bindEventMap(host, CAROUSEL_EVENTS, isCarouselEvent, options?.on, signal)
