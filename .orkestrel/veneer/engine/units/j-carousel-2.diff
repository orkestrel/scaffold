+			host.addEventListener('keydown', (event) => this.#navigate(event), { signal })
+		}
+		if (resolved.pause) {
+			host.addEventListener('mouseenter', () => this.#disarm(), { signal })
+			host.addEventListener('mouseleave', () => this.#leave(), { signal })
+		}
+		const swipe = resolved.touch
+			? new Swipe(host, {
+					handler: this.#swiped.bind(this),
+					classes: { pointer: this.#classes.pointer },
+				})
+			: undefined
