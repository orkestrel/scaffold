+		incoming: HTMLElement,
+		forward: boolean,
+		interactive: boolean,
+	): Promise<boolean> {
+		const items = this.#items()
+		const detail: CarouselDetail = {
+			relatedTarget: incoming,
+			direction: forward ? 'left' : 'right',
+			from: items.indexOf(outgoing),
+			to: items.indexOf(incoming),
+		}
