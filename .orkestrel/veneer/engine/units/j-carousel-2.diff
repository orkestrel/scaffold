index 0000000..83d0a4e
--- /dev/null
+++ b/src/browser/Swipe.ts
@@ -0,0 +1,107 @@
+import type { SwipeClassMap, SwipeDirection, SwipeInterface, SwipeOptions } from './types.js'
+import { AppError } from '@src/core'
+import { isFiniteNumber, isInstance } from '@orkestrel/contract'
+import { SWIPE_CLASSES, SWIPE_DEFAULTS } from './constants.js'
+import { readTag, resolveVocabulary } from './helpers.js'
+import { HostSnapshot } from './HostSnapshot.js'
+import { isClassToken } from './validators.js'
+
+/**
+ * Reports each horizontal touch or pen swipe on a host from its pointer events.
+ *
+ * @remarks
+ * The host must be an HTMLElement in the current realm. Construction validates and copies the
+ * `classes` group and the `threshold`, writes the `pointer` token, which the cascade reads to leave
+ * horizontal panning to the swipe, and listens for `pointerdown`, `pointerup`, and `pointercancel`
+ * on the host. A touch or pen pointer going down records its horizontal position; the release of
+ * that same pointer measures the distance it travelled, and a distance past the threshold calls the
+ * handler with `left` or `right`, the way the content moved. A pointer going down replaces the one
+ * recorded before it, a cancelled pointer is discarded, and a mouse pointer is never read.
+ * Destruction removes the listeners and restores the host's `pointer` token.
+ *
+ * @example
+ * ```ts
+ * const swipe = new Swipe(host, { handler: (direction) => console.log(direction) })
+ * swipe.destroy()
+ * ```
+ */
+export class Swipe implements SwipeInterface {
+	readonly #host: HTMLElement
+	readonly #handler: (direction: SwipeDirection) => void
+	readonly #threshold: number
+	readonly #snapshot = new HostSnapshot()
+	readonly #controller = new AbortController()
+	// The pointer that went down last and the horizontal position it went down at, or undefined when
+	// no touch or pen pointer is down.
+	#pointer: number | undefined
+	#origin = 0
+
+	/**
+	 * Writes the host's `pointer` token and listens for its pointer events.
+	 *
+	 * @param host - The HTML element whose pointer events are read.
+	 * @param options - The handler each swipe calls, the threshold, and the markup vocabulary.
+	 * @throws Thrown when the host is not an HTMLElement, as an `AppError` carrying the `SWIPE_HOST_INVALID` code, or when a `classes` value is not a class token or the threshold is not a finite number at or above zero, as an `AppError` carrying the `SWIPE_OPTION_INVALID` code.
+	 */
+	constructor(host: HTMLElement, options: SwipeOptions) {
+		if (!isInstance(host, HTMLElement)) {
+			throw new AppError('Swipe requires an HTMLElement host', 'SWIPE_HOST_INVALID', {
+				tag: readTag(host),
+			})
+		}
+		const classes: SwipeClassMap = resolveVocabulary(
+			'SWIPE_OPTION_INVALID',
+			SWIPE_CLASSES,
+			isClassToken,
+			options.classes,
+		)
+		const threshold = options.threshold ?? SWIPE_DEFAULTS.threshold
+		if (!isFiniteNumber(threshold) || threshold < 0) {
+			throw new AppError('Swipe threshold fails validation', 'SWIPE_OPTION_INVALID', {
+				key: 'threshold',
+			})
+		}
+		this.#host = host
+		this.#handler = options.handler
+		this.#threshold = threshold
+		this.#snapshot.save({ category: 'token', element: host, name: classes.pointer })
+		host.classList.add(classes.pointer)
+		const signal = this.#controller.signal
+		host.addEventListener('pointerdown', (event) => this.#press(event), { signal })
+		host.addEventListener('pointerup', (event) => this.#release(event), { signal })
+		host.addEventListener('pointercancel', (event) => this.#cancel(event), { signal })
+	}
+
+	get host(): HTMLElement {
+		return this.#host
+	}
+
+	destroy(): void {
+		if (this.#controller.signal.aborted) return
+		this.#controller.abort()
+		this.#snapshot.restore()
+	}
+
+	// Records a touch or pen pointer going down and where it went down, replacing any pointer
+	// recorded before it.
+	#press(event: PointerEvent): void {
+		if (event.pointerType !== 'touch' && event.pointerType !== 'pen') return
+		this.#pointer = event.pointerId
+		this.#origin = event.clientX
+	}
+
+	// Measures the recorded pointer's release and reports a swipe past the threshold, the content
+	// moving right for a positive distance and left for a negative one.
+	#release(event: PointerEvent): void {
+		if (event.pointerId !== this.#pointer) return
+		this.#pointer = undefined
+		const distance = event.clientX - this.#origin
+		if (Math.abs(distance) <= this.#threshold) return
+		this.#handler(distance > 0 ? 'right' : 'left')
+	}
+
+	// Discards the recorded pointer when the platform cancels it, such as for a vertical scroll.
+	#cancel(event: PointerEvent): void {
+		if (event.pointerId === this.#pointer) this.#pointer = undefined
+	}
+}
