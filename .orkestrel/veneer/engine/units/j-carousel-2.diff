+		// so a swipe constructed for a destroyed carousel is destroyed rather than kept.
+		if (signal.aborted) {
+			swipe?.destroy()
+			this.#swipe = undefined
+		} else this.#swipe = swipe
+		if (resolved.touch) {
+			host.addEventListener('dragstart', (event) => this.#refuse(event), { signal })
+		}
+		if (resolved.touch && resolved.pause) {
+			host.addEventListener('pointerup', (event) => this.#defer(event), { signal })
+		}
+		const lifetime = options?.signal
+		if (lifetime?.aborted) this.destroy()
+		else {
+			lifetime?.addEventListener('abort', () => this.destroy(), { once: true, signal })
+		}
