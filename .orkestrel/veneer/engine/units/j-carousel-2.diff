+	static readonly #registry = new Registry<Carousel>({ code: 'CAROUSEL_HOST_OWNED' })
+	readonly #host: HTMLElement
+	readonly #classes: CarouselClassMap
+	readonly #attributes: CarouselAttributeMap
+	readonly #selectors: CarouselSelectorMap
+	readonly #interval: number
+	readonly #ride: CarouselRide | undefined
