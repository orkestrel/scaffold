+	// Slides one item forward or back from the active item, wrapping past either end when `wrap` is
+	// true; a step while a slide is in flight, with no active item, or whose neighbour is the active
+	// item resolves false and dispatches nothing.
+	async #step(forward: boolean, interactive: boolean): Promise<boolean> {
+		if (this.#controller.signal.aborted || this.#change !== undefined) return false
+		const items = this.#items()
+		const outgoing = this.#active(items)
+		if (outgoing === undefined) return false
+		const count = items.length
+		const target = items.indexOf(outgoing) + (forward ? 1 : -1)
+		const incoming = items[this.#wrap ? (target + count) % count : target]
+		if (incoming === undefined || incoming === outgoing) return false
+		return this.#move(outgoing, incoming, forward, interactive)
+	}
+
+	// Runs one slide from the outgoing item to the incoming one. Each door reads the lifetime, that
+	// both items are still items of the host, and the items and indicators for its phase: the outgoing
+	// item keeps the `active` token and the incoming item lacks it until the completion moves it, the
+	// outgoing item lacks the order token from the order token's write on, the incoming item carries
