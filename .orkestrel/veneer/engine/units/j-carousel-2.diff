+	/**
+	 * Returns the live carousel that owns a host, mirroring Bootstrap's `getInstance`.
+	 *
+	 * @param host - The carousel to look up.
+	 * @returns The owning carousel, or undefined when no live carousel owns the host.
+	 * @example
+	 * ```ts
+	 * await Carousel.find(host)?.next()
+	 * ```
+	 */
+	static find(host: HTMLElement): CarouselInterface | undefined {
+		return Carousel.#registry.find(host)
+	}
+
+	get host(): HTMLElement {
+		return this.#host
+	}
+
+	get index(): number | undefined {
+		const items = this.#items()
+		const active = this.#active(items)
+		return active === undefined ? undefined : items.indexOf(active)
+	}
+
+	next(): Promise<boolean> {
+		return this.#step(true, true)
+	}
+
+	previous(): Promise<boolean> {
+		return this.#step(false, true)
+	}
+
+	async slide(index: number): Promise<boolean> {
+		// A slide in flight finishes first, as Bootstrap's `to` waits for `slid`, and every wait reads
+		// the items again, because the slide that finished moved them.
+		while (this.#change !== undefined) await this.#change.promise
+		if (this.#controller.signal.aborted) return false
+		const items = this.#items()
+		const outgoing = this.#active(items)
+		const incoming = items[index]
+		if (outgoing === undefined || incoming === undefined || incoming === outgoing) return false
+		return this.#move(outgoing, incoming, index > items.indexOf(outgoing), true)
+	}
