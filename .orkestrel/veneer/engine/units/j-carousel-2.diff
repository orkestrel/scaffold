+					)
+				) {
+					return false
+				}
+			}
+			const blocked: ReadonlyArray<readonly [HTMLElement, string]> = [
+				[incoming, active],
+				[outgoing, order],
+			]
+			if (
+				!this.#apply(
+					() => incoming.classList.add(order),
+					pair,
+					[
