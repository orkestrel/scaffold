+			'interval' | 'keyboard' | 'pause' | 'ride' | 'touch' | 'wrap'
+		>(
+			host,
+			this.#attributes,
+			'CAROUSEL_OPTION_INVALID',
+			CAROUSEL_DEFAULTS,
+			{
+				interval: parseNumber,
+				keyboard: parseBoolean,
+				pause: parseBoolean,
+				ride: parseRide,
+				touch: parseBoolean,
+				wrap: parseBoolean,
+			},
+			options,
+		)
