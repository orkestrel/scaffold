+			CAROUSEL_CLASSES,
+			isClassToken,
+			options?.classes,
+		)
+		this.#attributes = resolveVocabulary(
+			'CAROUSEL_OPTION_INVALID',
+			CAROUSEL_ATTRIBUTES,
+			isAttributeName,
+			options?.attributes,
+		)
+		this.#selectors = resolveVocabulary(
+			'CAROUSEL_OPTION_INVALID',
+			CAROUSEL_SELECTORS,
+			isSelector,
+			options?.selectors,
+		)
