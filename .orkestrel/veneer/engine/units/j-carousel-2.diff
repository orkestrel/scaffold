+		if (!emitEvent(this.#host, CAROUSEL_EVENTS.slide, detail, true)) return false
+		// A listener runs inside the dispatch and can destroy this carousel or slide it itself, even
+		// back to this slide's outgoing item, so the refusals and the slide tally are read again before
+		// any write.
+		const { active } = this.#classes
+		const current = this.#items()
+		if (
+			this.#controller.signal.aborted ||
+			this.#change !== undefined ||
+			this.#slides !== slides ||
+			this.#active(current) !== outgoing ||
+			!current.includes(incoming) ||
+			incoming.classList.contains(active)
+		) {
+			return false
+		}
+		const change = Promise.withResolvers<void>()
+		this.#change = change
+		this.#slides += 1
+		// The timer stops for the slide. After the slide completes or stops it is armed again where it
+		// was running when the slide began, and arming reads whether cycling is still wanted.
+		const cycling = this.#timer !== undefined
+		const pauses = this.#pauses
+		this.#disarm()
+		try {
+			const order = forward ? this.#classes.next : this.#classes.previous
+			const direction = forward ? this.#classes.start : this.#classes.end
