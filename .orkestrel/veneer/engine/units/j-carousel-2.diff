+	start(): void {
+		if (this.#controller.signal.aborted) return
+		this.#started = true
+		this.#arm()
+	}
+
+	pause(): void {
+		this.#started = false
+		this.#pauses += 1
+		this.#disarm()
+	}
+
+	destroy(): void {
+		if (this.#controller.signal.aborted) return
+		this.#controller.abort()
+		this.#disarm()
+		clearTimeout(this.#touch)
+		// The claim goes before the host is restored, so an engine constructed while restoration runs
+		// can claim the host, and its snapshot takes the values this one has still to write back. The
+		// items and indicators restore before the swipe's token, so a carousel a reaction to that token
+		// constructs finds them restored.
+		Carousel.#registry.release(this.#host, this)
+		this.#snapshot.restore()
+		this.#swipe?.destroy()
+	}
