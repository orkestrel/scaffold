--- /dev/null
+++ b/src/browser/Carousel.ts
@@ -0,0 +1,687 @@
+import type {
+	CarouselAttributeMap,
+	CarouselClassMap,
+	CarouselDetail,
+	CarouselInterface,
+	CarouselOptions,
+	CarouselRide,
+	CarouselSelectorMap,
+	SwipeDirection,
+	SwipeInterface,
+} from './types.js'
+import { AppError } from '@src/core'
+import { instanceOf, isInstance, parseBoolean, parseNumber } from '@orkestrel/contract'
+import {
+	CAROUSEL_ATTRIBUTES,
+	CAROUSEL_CLASSES,
+	CAROUSEL_DEFAULTS,
+	CAROUSEL_EVENTS,
+	CAROUSEL_SELECTORS,
+	CAROUSEL_TOUCH_DELAY,
+} from './constants.js'
+import {
+	bindEventMap,
+	emitEvent,
+	matchesReducedMotion,
+	readTag,
+	reflow,
+	resolveOptions,
+	resolveVocabulary,
+	settleAnimations,
+} from './helpers.js'
+import { HostSnapshot } from './HostSnapshot.js'
+import { parseRide } from './parsers.js'
+import { Registry } from './Registry.js'
+import { Swipe } from './Swipe.js'
+import { isAttributeName, isCarouselEvent, isClassToken, isSelector } from './validators.js'
+
+/**
+ * Moves a carousel between its items through their order and direction tokens, by call, key,
+ * swipe, or its own timer.
+ *
+ * @remarks
+ * The host must be an HTMLElement in the current realm and have no live carousel owner.
+ * Construction validates and copies the `classes`, `attributes`, and `selectors` groups, resolves
+ * the `interval`, `keyboard`, `pause`, `ride`, `touch`, and `wrap` options from the defaults, the
+ * attributes the `attributes` group names, and the constructor, claims the host, binds the hooks,
+ * and listens on the host: for the arrow keys when `keyboard` is true, for the pointer entering and
+ * leaving when `pause` is true, and, when `touch` is true, for swipes through a `Swipe` it
+ * constructs with its `pointer` token and for the drag of an item's image, and for a touch or pen
+ * release when `pause` is true as well. A swipe constructed while a reaction to its token write
+ * destroyed the carousel is destroyed at once. A `load` ride starts cycling. The items are the
+ * elements the `entry` selector matches inside the host that sit inside no other item, and the
+ * active item is the first of them carrying the `active` token, both read at each call. A slide
+ * dispatches the cancelable `slide.vn.carousel` event, moves the indicator, writes the incoming
+ * item's order token, the direction token to both items, waits for the incoming item's transition
+ * when the host carries the `slide` token, moves the `active` token, and dispatches
+ * `slid.vn.carousel`. A slide that another slide started inside its `slide.vn.carousel` dispatch
+ * took over resolves `false`. After each write and await, a slide reads its lifetime, that both
+ * items are still items of the host, and the tokens and indicator values the phase requires, and
+ * it stops, writing and dispatching nothing more, and resolves `false`, when any read fails. The
+ * timer is a chain of native timeouts at the active item's interval attribute or the `interval`
+ * option. Arming reads whether cycling is wanted, whether a touch deferral is pending, whether the
+ * pointer over the host holds it under `pause`, and whether the view prefers reduced motion, and
+ * arms nothing when any holds; each tick slides forward only while the document is visible and the
+ * host is rendered. A `pause` call made during a slide, a `slide.vn.carousel` or `slid.vn.carousel`
+ * listener's included, holds through the slide's re-arming and through the `interaction` ride's
+ * start. The hover a tap leaves behind holds nothing until the pointer leaves the host or a mouse
+ * moves, presses, or releases inside it, and at that mouse movement, press, or release the timer
+ * clears when the pointer over the host holds it. Destruction restores the items and indicators before the swipe's token. An
+ * aborted `signal` destroys the carousel.
+ *
+ * @example
+ * ```ts
+ * const carousel = new Carousel(host, { interval: 3000 })
+ * carousel.start()
+ * await carousel.next()
+ * carousel.destroy()
+ * ```
+ */
+export class Carousel implements CarouselInterface {
+	static readonly #registry = new Registry<Carousel>({ code: 'CAROUSEL_HOST_OWNED' })
+	readonly #host: HTMLElement
+	readonly #classes: CarouselClassMap
+	readonly #attributes: CarouselAttributeMap
+	readonly #selectors: CarouselSelectorMap
+	readonly #interval: number
+	readonly #ride: CarouselRide | undefined
+	readonly #wrap: boolean
+	// Whether the pointer over the host holds the timer, the `pause` option.
+	readonly #hover: boolean
+	readonly #snapshot = new HostSnapshot()
+	readonly #controller = new AbortController()
+	readonly #swipe: SwipeInterface | undefined
+	// The slide in flight, whose promise settles when that slide completes or stops. A `slide` call
+	// waits on it, and `next` and `previous` refuse while it is set.
+	#change: PromiseWithResolvers<void> | undefined
