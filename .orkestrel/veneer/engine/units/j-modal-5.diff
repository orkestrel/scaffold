+	/**
+	 * Claims the host, resolves its vocabulary and options, binds initial hooks, and listens for its
+	 * input.
+	 *
+	 * @param host - The HTML element to own, the carousel.
+	 * @param options - The cycling, input, and wrapping options, markup vocabulary, initial event subscriptions, and lifetime.
+	 * @throws Thrown when the host is not an HTMLElement, when a group value is not a class token, an attribute name, or a selector, when an attribute the `attributes` group names fails coercion and the constructor leaves its option undefined, or when the host already has a live owner.
+	 */
+	constructor(host: HTMLElement, options?: CarouselOptions) {
