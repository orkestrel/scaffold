+	// the timer without clearing it, so the pointer leaving and the touch delay ending arm it again.
+	#started = false
+	// The tally of `pause` calls, read before a slide's `slide` dispatch and at its completion, so a
+	// pause made during the slide, a `slide` or `slid` listener's included, holds.
+	#pauses = 0
+	// The tally of slides that began writing, read across the `slide` dispatch so a slide a listener
+	// ran inside it takes the change over.
+	#slides = 0
+	#timer: ReturnType<typeof setTimeout> | undefined
