+			const order = forward ? this.#classes.next : this.#classes.previous
+			const direction = forward ? this.#classes.start : this.#classes.end
+			const pair: readonly [HTMLElement, HTMLElement] = [outgoing, incoming]
+			const leaving = this.#indicators(`.${CSS.escape(active)}`)
+			const arriving = this.#indicators(
+				`[${CSS.escape(this.#attributes.index)}="${String(detail.to)}"]`,
+			)
