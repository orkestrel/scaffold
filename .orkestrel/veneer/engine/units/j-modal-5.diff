+					() => incoming.classList.add(order),
+					pair,
+					[
+						[outgoing, active],
+						[incoming, order],
+					],
+					blocked,
+				)
+			) {
+				return false
+			}
+			reflow(incoming)
+			if (
+				!this.#apply(
+					() => outgoing.classList.add(direction),
+					pair,
+					[
+						[outgoing, active],
+						[outgoing, direction],
+						[incoming, order],
+					],
+					blocked,
+				)
+			) {
+				return false
+			}
+			const moving: ReadonlyArray<readonly [HTMLElement, string]> = [
+				[outgoing, active],
+				[outgoing, direction],
+				[incoming, order],
+				[incoming, direction],
+			]
+			if (!this.#apply(() => incoming.classList.add(direction), pair, moving, blocked)) {
+				return false
+			}
+			if (this.#host.classList.contains(this.#classes.slide)) {
+				await settleAnimations(incoming, this.#controller.signal)
+				if (!this.#holds(pair, moving, blocked, [])) return false
+			}
+			if (
+				!this.#apply(
+					() => incoming.classList.remove(direction, order),
+					pair,
+					[
+						[outgoing, active],
+						[outgoing, direction],
+					],
+					[
+						[incoming, active],
+						[incoming, order],
+						[incoming, direction],
+						[outgoing, order],
+					],
+				)
+			) {
+				return false
+			}
+			if (
+				!this.#apply(
+					() => incoming.classList.add(active),
+					pair,
+					[
+						[outgoing, active],
+						[outgoing, direction],
+						[incoming, active],
+					],
+					[
+						[incoming, order],
+						[incoming, direction],
+						[outgoing, order],
+					],
+				)
+			) {
+				return false
+			}
+			if (
+				!this.#apply(
+					() => outgoing.classList.remove(active, order, direction),
+					pair,
+					[[incoming, active]],
+					[
+						[incoming, order],
+						[incoming, direction],
+						[outgoing, active],
+						[outgoing, direction],
+						[outgoing, order],
+					],
+				)
+			) {
