+				if (
+					!this.#apply(
+						() => indicator.classList.remove(active),
+						pair,
+						[[outgoing, active]],
+						[
+							[incoming, active],
+							[indicator, active],
+						],
+						[[indicator, marked]],
+					)
+				) {
+					return false
+				}
