+			host,
+			this.#attributes,
+			'CAROUSEL_OPTION_INVALID',
+			CAROUSEL_DEFAULTS,
+			{
+				interval: parseNumber,
+				keyboard: parseBoolean,
+				pause: parseBoolean,
+				ride: parseRide,
+				touch: parseBoolean,
+				wrap: parseBoolean,
+			},
+			options,
+		)
+		Carousel.#registry.claim(host, this)
+		this.#host = host
+		this.#interval = resolved.interval
+		this.#ride = resolved.ride
+		this.#wrap = resolved.wrap
+		this.#hover = resolved.pause
+		const signal = this.#controller.signal
+		bindEventMap(host, CAROUSEL_EVENTS, isCarouselEvent, options?.on, signal)
+		if (resolved.keyboard) {
+			host.addEventListener('keydown', (event) => this.#navigate(event), { signal })
+		}
+		if (resolved.pause) {
+			host.addEventListener('mouseenter', () => this.#disarm(), { signal })
+			host.addEventListener('mouseleave', () => this.#leave(), { signal })
+		}
+		const swipe = resolved.touch
+			? new Swipe(host, {
+					handler: this.#swiped.bind(this),
+					classes: { pointer: this.#classes.pointer },
+				})
+			: undefined
+		// A reaction to the swipe's token write can destroy this carousel before the swipe is assigned,
+		// so a swipe constructed for a destroyed carousel is destroyed rather than kept.
+		if (signal.aborted) {
+			swipe?.destroy()
+			this.#swipe = undefined
+		} else this.#swipe = swipe
+		if (resolved.touch) {
+			host.addEventListener('dragstart', (event) => this.#refuse(event), { signal })
+		}
+		if (resolved.touch && resolved.pause) {
+			host.addEventListener('pointerup', (event) => this.#defer(event), { signal })
+			host.addEventListener('pointermove', (event) => this.#notice(event), { signal })
+			host.addEventListener('pointerdown', (event) => this.#notice(event), { signal })
+			host.addEventListener('pointerup', (event) => this.#notice(event), { signal })
+		}
+		const lifetime = options?.signal
+		if (lifetime?.aborted) this.destroy()
+		else {
+			lifetime?.addEventListener('abort', () => this.destroy(), { once: true, signal })
+		}
+		if (this.#ride === 'load') this.start()
+	}
+
+	/**
+	 * Returns the live carousel that owns a host, mirroring Bootstrap's `getInstance`.
+	 *
+	 * @param host - The carousel to look up.
+	 * @returns The owning carousel, or undefined when no live carousel owns the host.
+	 * @example
+	 * ```ts
+	 * await Carousel.find(host)?.next()
+	 * ```
+	 */
+	static find(host: HTMLElement): CarouselInterface | undefined {
+		return Carousel.#registry.find(host)
+	}
+
+	get host(): HTMLElement {
+		return this.#host
+	}
+
+	get index(): number | undefined {
+		const items = this.#items()
+		const active = this.#active(items)
+		return active === undefined ? undefined : items.indexOf(active)
+	}
+
+	next(): Promise<boolean> {
+		return this.#step(true, true)
+	}
+
+	previous(): Promise<boolean> {
+		return this.#step(false, true)
+	}
+
+	async slide(index: number): Promise<boolean> {
+		// A slide in flight finishes first, as Bootstrap's `to` waits for `slid`, and every wait reads
+		// the items again, because the slide that finished moved them.
+		while (this.#change !== undefined) await this.#change.promise
+		if (this.#controller.signal.aborted) return false
+		const items = this.#items()
+		const outgoing = this.#active(items)
+		const incoming = items[index]
+		if (outgoing === undefined || incoming === undefined || incoming === outgoing) return false
+		return this.#move(outgoing, incoming, index > items.indexOf(outgoing), true)
+	}
+
+	start(): void {
+		if (this.#controller.signal.aborted) return
+		this.#started = true
+		this.#arm()
+	}
+
+	pause(): void {
+		this.#started = false
+		this.#pauses += 1
+		this.#disarm()
+	}
+
+	destroy(): void {
+		if (this.#controller.signal.aborted) return
+		this.#controller.abort()
+		this.#disarm()
+		clearTimeout(this.#touch)
+		// The claim goes before the host is restored, so an engine constructed while restoration runs
+		// can claim the host, and its snapshot takes the values this one has still to write back. The
+		// items and indicators restore before the swipe's token, so a carousel a reaction to that token
+		// constructs finds them restored.
+		Carousel.#registry.release(this.#host, this)
+		this.#snapshot.restore()
+		this.#swipe?.destroy()
+	}
+
+	// Slides one item forward or back from the active item, wrapping past either end when `wrap` is
+	// true; a step while a slide is in flight, with no active item, or whose neighbour is the active
+	// item resolves false and dispatches nothing.
+	async #step(forward: boolean, interactive: boolean): Promise<boolean> {
+		if (this.#controller.signal.aborted || this.#change !== undefined) return false
+		const items = this.#items()
+		const outgoing = this.#active(items)
+		if (outgoing === undefined) return false
+		const count = items.length
+		const target = items.indexOf(outgoing) + (forward ? 1 : -1)
+		const incoming = items[this.#wrap ? (target + count) % count : target]
+		if (incoming === undefined || incoming === outgoing) return false
+		return this.#move(outgoing, incoming, forward, interactive)
+	}
