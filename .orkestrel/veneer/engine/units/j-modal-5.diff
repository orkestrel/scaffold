+		} finally {
+			this.#finish(change)
+			if (cycling) this.#arm()
+		}
+	}
+
+	// Reports whether the slide still holds its change: the carousel is live, both items of the pair
+	// are still items of the host, each element carries every token `present` pairs it with and none
+	// `absent` pairs it with, and each indicator carries the `aria-current` value `marks` pairs it with.
+	#holds(
+		pair: readonly [HTMLElement, HTMLElement],
+		present: ReadonlyArray<readonly [HTMLElement, string]>,
+		absent: ReadonlyArray<readonly [HTMLElement, string]>,
+		marks: ReadonlyArray<readonly [HTMLElement, string | null]>,
+	): boolean {
+		const items = this.#items()
+		return (
+			!this.#controller.signal.aborted &&
+			pair.every((item) => items.includes(item)) &&
+			present.every(([element, token]) => element.classList.contains(token)) &&
+			!absent.some(([element, token]) => element.classList.contains(token)) &&
+			marks.every(([element, value]) => element.getAttribute('aria-current') === value)
+		)
+	}
+
+	// Runs one write a reaction can run inside, then reads whether the slide still holds its change.
+	#apply(
+		write: () => void,
+		pair: readonly [HTMLElement, HTMLElement],
+		present: ReadonlyArray<readonly [HTMLElement, string]>,
+		absent: ReadonlyArray<readonly [HTMLElement, string]>,
+		marks: ReadonlyArray<readonly [HTMLElement, string | null]> = [],
+	): boolean {
+		write()
+		return this.#holds(pair, present, absent, marks)
+	}
+
+	// Ends the slide in flight when it is this one, and releases every `slide` call waiting on it.
+	#finish(change: PromiseWithResolvers<void>): void {
+		if (this.#change === change) this.#change = undefined
+		change.resolve()
+	}
+
+	// Lists the items: the elements the `entry` selector matches inside the host that sit inside no
+	// other item, so a nested carousel's items are its own.
+	#items(): readonly HTMLElement[] {
+		const entry = `:is(${this.#selectors.entry})`
+		const nested = new Set(this.#host.querySelectorAll(`:scope ${entry} ${entry}`))
+		return Array.from(this.#host.querySelectorAll(this.#selectors.entry))
+			.filter(instanceOf(HTMLElement))
+			.filter((item) => !nested.has(item))
+	}
+
+	// Returns the first item carrying the `active` token, or undefined when none does.
+	#active(items: readonly HTMLElement[]): HTMLElement | undefined {
+		return items.find((item) => item.classList.contains(this.#classes.active))
+	}
+
