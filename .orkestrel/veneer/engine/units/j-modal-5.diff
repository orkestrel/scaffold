diff --git a/src/browser/ScrollSpy.ts b/src/browser/ScrollSpy.ts
new file mode 100644
index 0000000..7bea6fa
--- /dev/null
+++ b/src/browser/ScrollSpy.ts
@@ -0,0 +1,390 @@
+import type {
+	ScrollSpyClassMap,
+	ScrollSpyInterface,
+	ScrollSpyOptions,
+	ScrollSpySelectorMap,
+} from './types.js'
+import { AppError } from '@src/core'
+import { instanceOf, isInstance, parseBoolean } from '@orkestrel/contract'
+import {
+	SCROLL_SPY_ATTRIBUTES,
+	SCROLL_SPY_CLASSES,
+	SCROLL_SPY_DEFAULTS,
+	SCROLL_SPY_EVENTS,
+	SCROLL_SPY_SELECTORS,
+} from './constants.js'
+import { bindEventMap, emitEvent, readTag, resolveOptions, resolveVocabulary } from './helpers.js'
+import { HostSnapshot } from './HostSnapshot.js'
+import { parseElement, parseRootMargin, parseThreshold } from './parsers.js'
+import { Registry } from './Registry.js'
+import { isAttributeName, isClassToken, isScrollSpyEvent, isSelector } from './validators.js'
+
+/**
+ * Activates the navigation link whose section is in view as its host scrolls, and the links that lead to it.
+ *
+ * @remarks
+ * The host is the scrolling element; it must be an HTMLElement in the current realm and have no
+ * live scrollspy owner. Construction validates and copies the `classes`, `attributes`, and
+ * `selectors` groups, resolves the `target`, `smooth`, and `intersection` options from the
+ * constructor and the host's attributes, claims the host, binds the hooks, and refreshes. A refresh
+ * reads every `[href]` link inside the target whose fragment names a visible element inside the
+ * host, skipping a link carrying the `disabled` token or a `disabled` attribute whose value is not
+ * `false`, and replaces its
+ * `IntersectionObserver` with one observing each named section, whose root is the host when its
+ * `overflow-y` value is not `visible`, and the viewport otherwise. At each delivery a section that
+ * leaves clears its link's `active` token; scrolling down, each entering section not higher than
+ * the last one activated activates its link, and scrolling up, each entering section higher than it
+ * does. An activation clears the `active` token from the target and every `[href]` link inside it,
+ * gives it to the link and to the links that lead to it, and dispatches `activate.vn.scrollspy` on
+ * the host. After each write and the dispatch the delivery reads its lifetime again; after each
+ * removal the removed token must be absent, and after the link's own write and after the dispatch
+ * the link must carry its token. A delivery that finds the scrollspy destroyed, a later refresh
+ * made, a removed token back, or the link without its token stops, writing and dispatching nothing
+ * more, and reads no further entry.
+ * With `smooth`, a click on a link inside the target whose section is observed scrolls the root
+ * smoothly to that section and prevents the click's navigation. Destruction disconnects the
+ * observer and restores every `active` token the scrollspy wrote or removed. An aborted `signal`
+ * destroys the scrollspy.
+ *
+ * @example
+ * ```ts
+ * const container = document.createElement('div')
+ * container.style.cssText = 'height: 100px; overflow-y: auto'
+ * const spy = new ScrollSpy(container, { target: document.createElement('nav') })
+ * spy.refresh()
+ * spy.destroy()
+ * ```
+ */
+export class ScrollSpy implements ScrollSpyInterface {
+	static readonly #registry = new Registry<ScrollSpy>({ code: 'SCROLL_SPY_HOST_OWNED' })
+	readonly #host: HTMLElement
+	readonly #target: HTMLElement
+	readonly #margin: string
+	readonly #threshold: readonly number[]
+	readonly #classes: ScrollSpyClassMap
+	readonly #selectors: ScrollSpySelectorMap
+	readonly #snapshot = new HostSnapshot()
+	readonly #controller = new AbortController()
+	// The observer the last refresh created. A delivery holds its change only while its observer is
+	// this one, so a delivery that resumes after a refresh or a destruction reads that it no longer
+	// holds it.
+	#observer: IntersectionObserver | undefined
+	// Each observed section mapped to the link naming it, and each link to its section, as the last
+	// refresh read them.
+	#links = new Map<Element, HTMLElement>()
+	#sections = new Map<HTMLElement, HTMLElement>()
+	// The link the last activation selected, which the `link` getter reports while it carries its
+	// token.
+	#link: HTMLElement | undefined
+	// The offset of the section the last activation selected and the root's scroll position at the
+	// last delivery, which together decide the scroll direction's candidate.
+	#top = 0
+	#scroll = 0
+
+	/**
+	 * Claims the host, resolves its vocabulary and options, binds initial hooks, and observes the target's sections.
+	 *
+	 * @param host - The HTML element to own, the scrolling element.
+	 * @param options - The navigation, smooth scrolling, observer settings, markup vocabulary, initial event subscriptions, and lifetime.
+	 * @throws Thrown when the host is not an HTMLElement, when a group value is not a class token, an attribute name, or a selector, when a declared attribute fails coercion, when the resolved margin or threshold is one the observer refuses, or when the host already has a live owner.
+	 */
+	constructor(host: HTMLElement, options?: ScrollSpyOptions) {
+		if (!isInstance(host, HTMLElement)) {
+			throw new AppError('ScrollSpy requires an HTMLElement host', 'SCROLL_SPY_HOST_INVALID', {
+				tag: readTag(host),
+			})
+		}
+		this.#classes = resolveVocabulary(
+			'SCROLL_SPY_OPTION_INVALID',
+			SCROLL_SPY_CLASSES,
+			isClassToken,
+			options?.classes,
+		)
+		const attributes = resolveVocabulary(
+			'SCROLL_SPY_OPTION_INVALID',
+			SCROLL_SPY_ATTRIBUTES,
+			isAttributeName,
+			options?.attributes,
+		)
+		this.#selectors = resolveVocabulary(
+			'SCROLL_SPY_OPTION_INVALID',
+			SCROLL_SPY_SELECTORS,
+			isSelector,
+			options?.selectors,
+		)
+		const resolved = resolveOptions<
+			Pick<ScrollSpyOptions, 'target' | 'smooth'>,
+			'target' | 'smooth'
+		>(
+			host,
+			attributes,
+			'SCROLL_SPY_OPTION_INVALID',
+			{ smooth: SCROLL_SPY_DEFAULTS.smooth },
+			{ target: parseElement, smooth: parseBoolean },
+			options,
+		)
+		// The group's keys have no top-level option key of their own, so the group is resolved as its
+		// own layer: its defaults, then the attributes its keys name, then the constructor's group, key
+		// by key.
+		const intersection = resolveOptions<
+			Required<NonNullable<ScrollSpyOptions['intersection']>>,
+			'margin' | 'threshold'
+		>(
+			host,
+			attributes,
+			'SCROLL_SPY_OPTION_INVALID',
+			SCROLL_SPY_DEFAULTS.intersection,
+			{ margin: parseRootMargin, threshold: parseThreshold },
+			options?.intersection,
+		)
+		const margin = parseRootMargin(intersection.margin)
+		const threshold = parseThreshold(intersection.threshold)
+		if (margin === undefined || threshold === undefined) {
+			throw new AppError('Option value fails validation', 'SCROLL_SPY_OPTION_INVALID', {
+				key: margin === undefined ? 'margin' : 'threshold',
+			})
+		}
+		this.#margin = margin
+		// A copy, so a later change to the caller's array leaves the ratios read here.
+		this.#threshold = Object.freeze([...threshold])
+		ScrollSpy.#registry.claim(host, this)
+		this.#host = host
+		this.#target = resolved.target ?? host.ownerDocument.body
+		bindEventMap(host, SCROLL_SPY_EVENTS, isScrollSpyEvent, options?.on, this.#controller.signal)
+		if (resolved.smooth === true) {
+			this.#target.addEventListener('click', (event) => this.#scrollTo(event), {
+				signal: this.#controller.signal,
+			})
+		}
+		const signal = options?.signal
+		if (signal?.aborted) this.destroy()
+		else {
+			signal?.addEventListener('abort', () => this.destroy(), {
+				once: true,
+				signal: this.#controller.signal,
+			})
+			this.refresh()
+		}
+	}
+
+	/**
+	 * Returns the live scrollspy that owns a scrolling element, mirroring Bootstrap's `getInstance`.
+	 *
+	 * @param host - The scrolling element to look up.
+	 * @returns The owning scrollspy, or undefined when no live scrollspy owns the element.
+	 * @example
+	 * ```ts
+	 * ScrollSpy.find(container)?.refresh()
+	 * ```
+	 */
+	static find(host: HTMLElement): ScrollSpyInterface | undefined {
+		return ScrollSpy.#registry.find(host)
+	}
+
+	get host(): HTMLElement {
+		return this.#host
+	}
+
+	get target(): HTMLElement {
+		return this.#target
+	}
+
+	get link(): HTMLElement | undefined {
+		const link = this.#link
+		return link?.classList.contains(this.#classes.active) ? link : undefined
+	}
+
+	refresh(): void {
+		if (this.#controller.signal.aborted) return
+		this.#observer?.disconnect()
+		const links = new Map<Element, HTMLElement>()
+		const sections = new Map<HTMLElement, HTMLElement>()
+		for (const link of Array.from(this.#target.querySelectorAll('[href]')).filter(
+			instanceOf(HTMLElement),
+		)) {
+			const section = this.#section(link)
+			if (section === undefined) continue
+			links.set(section, link)
+			sections.set(link, section)
+		}
+		this.#links = links
+		this.#sections = sections
+		if (this.#link !== undefined && !sections.has(this.#link)) this.#link = undefined
+		const observer = new IntersectionObserver(
+			(entries, current) => this.#deliver(current, entries),
+			{
+				root: getComputedStyle(this.#host).overflowY === 'visible' ? null : this.#host,
+				rootMargin: this.#margin,
+				threshold: [...this.#threshold],
+			},
+		)
+		this.#observer = observer
+		for (const section of links.keys()) observer.observe(section)
+	}
+
+	destroy(): void {
+		if (this.#controller.signal.aborted) return
+		this.#controller.abort()
+		this.#observer?.disconnect()
+		this.#observer = undefined
+		this.#link = undefined
+		// The claim goes before the links are restored, so an engine constructed while restoration runs
+		// can claim the host, and its snapshot takes the values this one has still to write back.
+		ScrollSpy.#registry.release(this.#host, this)
+		this.#snapshot.restore()
+	}
+
+	// Returns the visible HTML element inside the host a link's fragment names, or undefined for a link
+	// with no fragment, a disabled link, or a fragment naming no visible HTML element there.
+	#section(link: HTMLElement): HTMLElement | undefined {
+		const hash =
+			isInstance(link, HTMLAnchorElement) || isInstance(link, HTMLAreaElement) ? link.hash : ''
+		const disabled = link.getAttribute('disabled')
+		if (
+			hash === '' ||
+			link.classList.contains(this.#classes.disabled) ||
+			(disabled !== null && disabled !== 'false')
+		) {
+			return undefined
+		}
+		let id = ''
+		try {
+			id = decodeURI(hash.slice(1))
+		} catch {
+			return undefined
+		}
+		const section = this.#host.querySelector(`#${CSS.escape(id)}`)
+		return isInstance(section, HTMLElement) && section.checkVisibility({ visibilityProperty: true })
+			? section
+			: undefined
+	}
+
+	// Follows Bootstrap's selection rule over one delivery: a leaving section clears its link, and an
+	// entering section activates its link when it is lower than the last one activated while the root
+	// scrolls down, or higher while it scrolls up. Scrolling down while the root's scroll position is
+	// zero, the first activation ends the delivery.
+	#deliver(observer: IntersectionObserver, entries: readonly IntersectionObserverEntry[]): void {
+		if (!this.#holds(observer, [], [])) return
+		const root = observer.root
+		const scroll = (isInstance(root, Element) ? root : this.#host.ownerDocument.documentElement)
+			.scrollTop
+		const down = scroll >= this.#scroll
+		this.#scroll = scroll
+		for (const entry of entries) {
+			const section = entry.target
+			const link = this.#links.get(section)
+			if (link === undefined || !isInstance(section, HTMLElement)) continue
+			if (!entry.isIntersecting) {
+				if (this.#link === link) this.#link = undefined
+				if (!this.#apply(observer, [], [link], link, false)) return
+				continue
+			}
+			const top = section.offsetTop
+			if (down !== top >= this.#top) continue
+			this.#top = top
+			if (!this.#activate(observer, link)) return
+			if (down && scroll === 0) return
+		}
+	}
+
+	// Clears the active token inside the target, gives it to the link and to the links that lead to it,
+	// and dispatches the activate event, reading after each write and the dispatch whether the
+	// delivery still holds its change. A link already active is left as it is.
+	#activate(observer: IntersectionObserver, link: HTMLElement): boolean {
+		const { active } = this.#classes
+		if (this.#link === link && link.classList.contains(active)) return true
+		this.#link = link
+		const cleared = Array.from(this.#target.querySelectorAll(`[href].${CSS.escape(active)}`))
+		for (const element of [this.#target, ...cleared.filter(instanceOf(HTMLElement))]) {
+			if (!this.#apply(observer, [], [element], element, false)) return false
+		}
+		if (!this.#apply(observer, [link], [], link, true)) return false
+		for (const parent of this.#parents(link)) {
+			if (!this.#apply(observer, [link], [], parent, true)) return false
+		}
+		emitEvent(this.#host, SCROLL_SPY_EVENTS.activate, { relatedTarget: link }, false)
+		return this.#holds(observer, [link], [])
+	}
+
+	// Lists the elements inside the target that turn active with a link: the toggle of the dropdown
+	// holding a menu link, or else the nearest preceding parent link of each list that holds the link.
+	#parents(link: HTMLElement): readonly HTMLElement[] {
+		const { list, parent, dropdown, toggle } = this.#selectors
+		const target = this.#target
+		if (link.classList.contains(this.#classes.entry)) {
+			const menu = link.closest(dropdown)
+			const found = menu !== null && target.contains(menu) ? menu.querySelector(toggle) : null
+			return isInstance(found, HTMLElement) ? [found] : []
+		}
+		const parents: HTMLElement[] = []
+		let holder = link.parentElement?.closest(list)
+		while (
+			holder !== null &&
+			holder !== undefined &&
+			holder !== target &&
+			target.contains(holder)
+		) {
+			let previous = holder.previousElementSibling
+			while (previous !== null && !previous.matches(parent)) {
+				previous = previous.previousElementSibling
+			}
+			if (isInstance(previous, HTMLElement)) parents.push(previous)
+			holder = holder.parentElement?.closest(list)
+		}
+		return parents
+	}
+
+	// Reports whether a delivery still holds its change: the scrollspy is live, no refresh replaced its
+	// observer, each element in `present` carries the active token, and none in `absent` does.
+	#holds(
+		observer: IntersectionObserver,
+		present: readonly HTMLElement[],
+		absent: readonly HTMLElement[],
+	): boolean {
+		const { active } = this.#classes
+		return (
+			!this.#controller.signal.aborted &&
+			this.#observer === observer &&
+			present.every((element) => element.classList.contains(active)) &&
+			!absent.some((element) => element.classList.contains(active))
+		)
+	}
+
+	// Records an element's active token and writes the state when the element does not carry it, a
+	// write a reaction can run inside, then reads whether the delivery still holds its change.
+	#apply(
+		observer: IntersectionObserver,
+		present: readonly HTMLElement[],
+		absent: readonly HTMLElement[],
+		element: HTMLElement,
+		active: boolean,
+	): boolean {
+		const token = this.#classes.active
+		if (element.classList.contains(token) !== active) {
+			this.#snapshot.save({ category: 'token', element, name: token })
+			element.classList.toggle(token, active)
+		}
+		return this.#holds(observer, present, absent)
+	}
+
+	// Scrolls the observer's root smoothly to the section the clicked link names, and prevents the
+	// click's navigation; a click on any other link inside the target is left alone.
+	#scrollTo(event: Event): void {
+		const origin = event.target
+		const link = isInstance(origin, Element) ? origin.closest('[href]') : null
+		const section = isInstance(link, HTMLElement) ? this.#sections.get(link) : undefined
+		if (section === undefined) return
+		event.preventDefault()
+		const root = this.#observer?.root
+		const top = section.getBoundingClientRect().top
+		if (isInstance(root, HTMLElement)) {
+			root.scrollTo({
+				top: top - root.getBoundingClientRect().top - root.clientTop + root.scrollTop,
+				behavior: 'smooth',
+			})
+			return
+		}
+		const view = this.#host.ownerDocument.defaultView
+		view?.scrollTo({ top: top + view.scrollY, behavior: 'smooth' })
+	}
+}
diff --git a/src/browser/Swipe.ts b/src/browser/Swipe.ts
new file mode 100644
index 0000000..83d0a4e
--- /dev/null
+++ b/src/browser/Swipe.ts
@@ -0,0 +1,107 @@
+import type { SwipeClassMap, SwipeDirection, SwipeInterface, SwipeOptions } from './types.js'
+import { AppError } from '@src/core'
+import { isFiniteNumber, isInstance } from '@orkestrel/contract'
+import { SWIPE_CLASSES, SWIPE_DEFAULTS } from './constants.js'
+import { readTag, resolveVocabulary } from './helpers.js'
+import { HostSnapshot } from './HostSnapshot.js'
+import { isClassToken } from './validators.js'
+
+/**
+ * Reports each horizontal touch or pen swipe on a host from its pointer events.
+ *
+ * @remarks
+ * The host must be an HTMLElement in the current realm. Construction validates and copies the
+ * `classes` group and the `threshold`, writes the `pointer` token, which the cascade reads to leave
+ * horizontal panning to the swipe, and listens for `pointerdown`, `pointerup`, and `pointercancel`
+ * on the host. A touch or pen pointer going down records its horizontal position; the release of
+ * that same pointer measures the distance it travelled, and a distance past the threshold calls the
+ * handler with `left` or `right`, the way the content moved. A pointer going down replaces the one
+ * recorded before it, a cancelled pointer is discarded, and a mouse pointer is never read.
+ * Destruction removes the listeners and restores the host's `pointer` token.
+ *
+ * @example
+ * ```ts
+ * const swipe = new Swipe(host, { handler: (direction) => console.log(direction) })
+ * swipe.destroy()
+ * ```
+ */
+export class Swipe implements SwipeInterface {
+	readonly #host: HTMLElement
+	readonly #handler: (direction: SwipeDirection) => void
+	readonly #threshold: number
+	readonly #snapshot = new HostSnapshot()
+	readonly #controller = new AbortController()
+	// The pointer that went down last and the horizontal position it went down at, or undefined when
+	// no touch or pen pointer is down.
+	#pointer: number | undefined
+	#origin = 0
+
+	/**
+	 * Writes the host's `pointer` token and listens for its pointer events.
+	 *
+	 * @param host - The HTML element whose pointer events are read.
+	 * @param options - The handler each swipe calls, the threshold, and the markup vocabulary.
+	 * @throws Thrown when the host is not an HTMLElement, as an `AppError` carrying the `SWIPE_HOST_INVALID` code, or when a `classes` value is not a class token or the threshold is not a finite number at or above zero, as an `AppError` carrying the `SWIPE_OPTION_INVALID` code.
+	 */
+	constructor(host: HTMLElement, options: SwipeOptions) {
+		if (!isInstance(host, HTMLElement)) {
+			throw new AppError('Swipe requires an HTMLElement host', 'SWIPE_HOST_INVALID', {
+				tag: readTag(host),
+			})
+		}
+		const classes: SwipeClassMap = resolveVocabulary(
+			'SWIPE_OPTION_INVALID',
+			SWIPE_CLASSES,
+			isClassToken,
+			options.classes,
+		)
+		const threshold = options.threshold ?? SWIPE_DEFAULTS.threshold
+		if (!isFiniteNumber(threshold) || threshold < 0) {
+			throw new AppError('Swipe threshold fails validation', 'SWIPE_OPTION_INVALID', {
+				key: 'threshold',
+			})
+		}
+		this.#host = host
+		this.#handler = options.handler
+		this.#threshold = threshold
+		this.#snapshot.save({ category: 'token', element: host, name: classes.pointer })
+		host.classList.add(classes.pointer)
+		const signal = this.#controller.signal
+		host.addEventListener('pointerdown', (event) => this.#press(event), { signal })
+		host.addEventListener('pointerup', (event) => this.#release(event), { signal })
+		host.addEventListener('pointercancel', (event) => this.#cancel(event), { signal })
+	}
+
+	get host(): HTMLElement {
+		return this.#host
+	}
+
+	destroy(): void {
+		if (this.#controller.signal.aborted) return
+		this.#controller.abort()
+		this.#snapshot.restore()
+	}
+
+	// Records a touch or pen pointer going down and where it went down, replacing any pointer
+	// recorded before it.
+	#press(event: PointerEvent): void {
+		if (event.pointerType !== 'touch' && event.pointerType !== 'pen') return
+		this.#pointer = event.pointerId
+		this.#origin = event.clientX
+	}
+
+	// Measures the recorded pointer's release and reports a swipe past the threshold, the content
+	// moving right for a positive distance and left for a negative one.
+	#release(event: PointerEvent): void {
+		if (event.pointerId !== this.#pointer) return
+		this.#pointer = undefined
+		const distance = event.clientX - this.#origin
+		if (Math.abs(distance) <= this.#threshold) return
+		this.#handler(distance > 0 ? 'right' : 'left')
+	}
+
+	// Discards the recorded pointer when the platform cancels it, such as for a vertical scroll.
+	#cancel(event: PointerEvent): void {
+		if (event.pointerId === this.#pointer) this.#pointer = undefined
+	}
+}
diff --git a/src/browser/Tab.ts b/src/browser/Tab.ts
new file mode 100644
index 0000000..6e37738
--- /dev/null
+++ b/src/browser/Tab.ts
@@ -0,0 +1,412 @@
+import type {
+	TabAttributeMap,
+	TabClassMap,
+	TabDropdown,
+	TabInitialWrite,
+	TabInterface,
+	TabOptions,
+	TabSelectorMap,
+} from './types.js'
+import { AppError } from '@src/core'
+import { isInstance } from '@orkestrel/contract'
+import { TAB_ATTRIBUTES, TAB_CLASSES, TAB_EVENTS, TAB_SELECTORS } from './constants.js'
+import {
+	bindEventMap,
+	emitEvent,
+	readControls,
+	readTag,
+	readTarget,
+	reflow,
+	resolveVocabulary,
+	settleAnimations,
+} from './helpers.js'
+import { HostSnapshot } from './HostSnapshot.js'
+import { Registry } from './Registry.js'
+import { isAttributeName, isClassToken, isSelector, isTabEvent } from './validators.js'
+
+/**
+ * Activates a tab control and its pane, deactivating the active sibling control and its pane.
+ *
+ * @remarks
+ * The host must be an HTMLElement in the current realm and have no live tab owner. Construction
+ * validates and copies the `classes`, `attributes`, and `selectors` groups, resolves the pane the
+ * host's target attribute or `href` fragment names, claims the host, and binds the hooks. When the
+ * host or one of its ancestors matches the `list` selector, construction then writes the roles and
+ * states Bootstrap writes: `role="tablist"` on the list when it has no role; on each control of the
+ * list, `aria-selected`, `tabindex="-1"` when it is not active, and `role="tab"` when it has no
+ * role; `role="presentation"` on each control's wrapper when it has no role; and on each control's
+ * pane, `role="tabpanel"` when it has no role and `aria-labelledby` naming the control's id when it
+ * has none. A control outside any list writes nothing at construction and has no sibling. Showing
+ * dispatches `hide.vn.tab` on the active sibling and `show.vn.tab` on the host, refuses when either
+ * is prevented, deactivates the sibling and its pane, activates the host and its pane, waits for a
+ * pane carrying the `fade` token to settle, and dispatches `hidden.vn.tab` and `shown.vn.tab`. After
+ * each write, dispatch, and await, a call reads its lifetime, the list, the host, and the pane
+ * again: from the removal of the sibling's `active` token no control of the list but the host may
+ * carry that token, from the write of the host's `active` token the host must carry it, and from
+ * each write to the pane the pane must carry every token written so far. A call that finds the tab
+ * destroyed, a later call started, or the list, the host, or the pane otherwise stops, writing and
+ * dispatching nothing more, and resolves `false`. Destruction restores every value the tab wrote.
+ * An aborted `signal` destroys the tab. The keyboard is the delegate's: the tab listens for no key.
+ *
+ * @example
+ * ```ts
+ * const control = document.querySelector<HTMLElement>('#profile-tab')
+ * if (control !== null) {
+ * 	const tab = new Tab(control)
+ * 	await tab.show()
+ * 	tab.destroy()
+ * }
+ * ```
+ */
+export class Tab implements TabInterface {
+	static readonly #registry = new Registry<Tab>({ code: 'TAB_HOST_OWNED' })
+	readonly #host: HTMLElement
+	readonly #pane: HTMLElement | undefined
+	readonly #classes: TabClassMap
+	readonly #attributes: TabAttributeMap
+	readonly #selectors: TabSelectorMap
+	readonly #snapshot = new HostSnapshot()
+	readonly #controller = new AbortController()
+	// The identity of the latest call that started a change. A call holds its change only while this
+	// is its identity, so a call resuming after a later one started sees that it no longer holds it.
+	#change: object | undefined
+
+	/**
+	 * Claims the host, resolves its vocabulary and pane, binds initial hooks, and writes the list's initial roles and states.
+	 *
+	 * @param host - The HTML element to own, the control.
+	 * @param options - The markup vocabulary, initial event subscriptions, and lifetime.
+	 * @throws Thrown when the host is not an HTMLElement, when a group value is not a class token, an attribute name, or a selector, or when the host already has a live owner. Thrown as the platform's `SyntaxError` when a control of the list names its pane by a selector that is not valid CSS.
+	 */
+	constructor(host: HTMLElement, options?: TabOptions) {
+		if (!isInstance(host, HTMLElement)) {
+			throw new AppError('Tab requires an HTMLElement host', 'TAB_HOST_INVALID', {
+				tag: readTag(host),
+			})
+		}
+		this.#classes = resolveVocabulary(
+			'TAB_OPTION_INVALID',
+			TAB_CLASSES,
+			isClassToken,
+			options?.classes,
+		)
+		this.#attributes = resolveVocabulary(
+			'TAB_OPTION_INVALID',
+			TAB_ATTRIBUTES,
+			isAttributeName,
+			options?.attributes,
+		)
+		this.#selectors = resolveVocabulary(
+			'TAB_OPTION_INVALID',
+			TAB_SELECTORS,
+			isSelector,
+			options?.selectors,
+		)
+		this.#host = host
+		this.#pane = readTarget(host, this.#attributes)
+		// The initial writes are read before the claim, so a pane selector that throws leaves the host unclaimed.
+		const writes = this.#planInitial()
+		Tab.#registry.claim(host, this)
+		bindEventMap(host, TAB_EVENTS, isTabEvent, options?.on, this.#controller.signal)
+		const signal = options?.signal
+		if (signal?.aborted) this.destroy()
+		else {
+			signal?.addEventListener('abort', () => this.destroy(), {
+				once: true,
+				signal: this.#controller.signal,
+			})
+			this.#writeInitial(writes)
+		}
+	}
+
+	/**
+	 * Returns the live tab that owns a control, mirroring Bootstrap's `getInstance`.
+	 *
+	 * @param host - The control to look up.
+	 * @returns The owning tab, or undefined when no live tab owns the control.
+	 * @example
+	 * ```ts
+	 * await Tab.find(control)?.show()
+	 * ```
+	 */
+	static find(host: HTMLElement): TabInterface | undefined {
+		return Tab.#registry.find(host)
+	}
+
+	get host(): HTMLElement {
+		return this.#host
+	}
+
+	get pane(): HTMLElement | undefined {
+		return this.#pane
+	}
+
+	get active(): boolean {
+		return this.#host.classList.contains(this.#classes.active)
+	}
+
+	async show(): Promise<boolean> {
+		if (this.#refused()) return false
+		const host = this.#host
+		const outgoing = this.#sibling()
+		// Both pre-change events are dispatched before either is read, as Bootstrap's `show` does; a
+		// listener that destroys the tab inside the first one stops the second.
+		const hiding =
+			outgoing === undefined || emitEvent(outgoing, TAB_EVENTS.hide, { relatedTarget: host }, true)
+		if (this.#controller.signal.aborted) return false
+		const showing = emitEvent(host, TAB_EVENTS.show, { relatedTarget: outgoing }, true)
+		if (!hiding || !showing) return false
+		// A listener runs inside each dispatch and can destroy this tab, activate this control, or
+		// activate another sibling, so the refusals and the active sibling are read again before any
+		// write.
+		if (this.#refused() || this.#sibling() !== outgoing) return false
+		const change = {}
+		this.#change = change
+		const { active, shown, fade } = this.#classes
+		const pane = this.#pane
+		const previous =
+			outgoing === undefined
+				? undefined
+				: (Tab.#registry.find(outgoing)?.pane ?? readTarget(outgoing, this.#attributes))
+		const leaving = outgoing?.getAttribute('role') === 'tab'
+		const entering = host.getAttribute('role') === 'tab'
+		if (outgoing !== undefined) this.#save(outgoing, previous, leaving)
+		this.#save(host, pane, entering)
+		// Each write door reads the list, the host, and the pane for its phase: no control but the host
+		// active from the sibling's first write on, the host's `active` token from its write on, and
+		// each pane token from its write on.
+		if (outgoing !== undefined) {
+			if (!this.#apply(change, [], [], () => outgoing.classList.remove(active))) return false
+			if (!this.#apply(change, [], [], () => outgoing.blur())) return false
+			if (
+				previous !== undefined &&
+				!this.#apply(change, [], [], () => previous.classList.remove(active, shown))
+			) {
+				return false
+			}
+			if (leaving && !this.#select(change, [], [], outgoing, false)) return false
+		}
+		const held = [active]
+		if (!this.#apply(change, held, [], () => host.classList.add(active))) return false
+		if (entering && !this.#select(change, held, [], host, true)) return false
+		const settled = [active, shown]
+		if (pane !== undefined) {
+			if (!this.#apply(change, held, [active], () => pane.classList.add(active))) return false
+			const fading = pane.classList.contains(fade)
+			// Laying the pane out with its `active` token lets the `shown` token written next fade it.
+			if (fading) reflow(pane)
+			if (!this.#apply(change, held, settled, () => pane.classList.add(shown))) return false
+			if (fading) {
+				await settleAnimations(pane, this.#controller.signal)
+				if (!this.#holds(change, held, settled)) return false
+			}
+		}
+		if (outgoing !== undefined) {
+			emitEvent(outgoing, TAB_EVENTS.hidden, { relatedTarget: host }, false)
+			if (!this.#holds(change, held, settled)) return false
+		}
+		this.#change = undefined
+		emitEvent(host, TAB_EVENTS.shown, { relatedTarget: outgoing }, false)
+		return !this.#controller.signal.aborted
+	}
+
+	destroy(): void {
+		if (this.#controller.signal.aborted) return
+		this.#controller.abort()
+		// The claim goes before the controls are restored, so an engine constructed while restoration
+		// runs can claim the host, and its snapshot takes the values this one has still to write back.
+		Tab.#registry.release(this.#host, this)
+		this.#snapshot.restore()
+	}
+
+	// Reports whether a call cannot start: the tab is destroyed or the host is already active.
+	#refused(): boolean {
+		return this.#controller.signal.aborted || this.active
+	}
+
+	// Reports whether the call still holds its change: the tab is live, no later call started a
+	// change, no control of the list but the host carries the `active` token, the host carries every
+	// token in `host`, and the pane, when there is one, carries every token in `pane`.
+	#holds(change: object, host: readonly string[], pane: readonly string[]): boolean {
+		const element = this.#pane
+		return (
+			!this.#controller.signal.aborted &&
+			this.#change === change &&
+			this.#sibling() === undefined &&
+			host.every((token) => this.#host.classList.contains(token)) &&
+			(element === undefined || pane.every((token) => element.classList.contains(token)))
+		)
+	}
+
+	// Runs one write a reaction can run inside, then reads whether the call still holds its change
+	// with the host carrying every token in `host` and the pane every token in `pane`.
+	#apply(
+		change: object,
+		host: readonly string[],
+		pane: readonly string[],
+		write: () => void,
+	): boolean {
+		write()
+		return this.#holds(change, host, pane)
+	}
+
+	// Returns the list that holds the host, or undefined when neither the host nor an ancestor
+	// matches the `list` selector.
+	#list(): HTMLElement | undefined {
+		const list = this.#host.closest(this.#selectors.list)
+		return isInstance(list, HTMLElement) ? list : undefined
+	}
+
+	// Returns the active control of the host's list other than the host, or undefined when the list
+	// has none or the host has no list.
+	#sibling(): HTMLElement | undefined {
+		const list = this.#list()
+		if (list === undefined) return undefined
+		return readControls(list, this.#selectors).find(
+			(control) => control !== this.#host && control.classList.contains(this.#classes.active),
+		)
+	}
+
+	// Returns the element that wraps a control inside its list, or the control itself when neither
+	// the control nor an ancestor matches the `wrapper` or `entry` selector.
+	#wrapper(control: HTMLElement): HTMLElement {
+		const wrapper = control.closest(`:is(${this.#selectors.wrapper}, ${this.#selectors.entry})`)
+		return isInstance(wrapper, HTMLElement) ? wrapper : control
+	}
+
+	// Returns the dropdown a control's wrapper forms, or undefined when the wrapper carries no
+	// `dropdown` token.
+	#dropdown(control: HTMLElement): TabDropdown | undefined {
+		const wrapper = this.#wrapper(control)
+		if (!wrapper.classList.contains(this.#classes.dropdown)) return undefined
+		const toggle = wrapper.querySelector(this.#selectors.toggle)
+		const menu = wrapper.querySelector(this.#selectors.menu)
+		return {
+			wrapper,
+			toggle: isInstance(toggle, HTMLElement) ? toggle : undefined,
+			menu: isInstance(menu, HTMLElement) ? menu : undefined,
+		}
+	}
+
+	// Lists the initial roles and states the markup does not already carry; the first write planned
+	// for an attribute wins, as Bootstrap's `_setAttributeIfNotExists` leaves the first value in place.
+	#planInitial(): readonly TabInitialWrite[] {
+		const list = this.#list()
+		if (list === undefined) return []
+		const planned: TabInitialWrite[] = []
+		if (this.#absent(planned, list, 'role')) {
+			planned.push({ element: list, name: 'role', value: 'tablist' })
+		}
+		for (const control of readControls(list, this.#selectors)) {
+			const active = control.classList.contains(this.#classes.active)
+			planned.push({ element: control, name: 'aria-selected', value: String(active) })
+			const wrapper = this.#wrapper(control)
+			if (wrapper !== control && this.#absent(planned, wrapper, 'role')) {
+				planned.push({ element: wrapper, name: 'role', value: 'presentation' })
+			}
