+/**
+ * Checks whether a DOM event is a dropdown event, whose detail carries an optional click.
+ *
+ * @param value - The value to inspect.
+ * @returns True if the value is a CustomEvent whose detail is an object whose `click` member is absent, undefined, or a MouseEvent; false otherwise.
+ * @remarks
+ * A dropdown dispatches each event with a detail whose `click` member carries the click that closed
+ * the menu, or undefined for every other cause, so a consumer's own event under a dropdown wire name
+ * that carries no detail or another payload is refused. The class half reads the `isInstance`
+ * function `@orkestrel/contract` publishes, which narrows the value to a `CustomEvent` whose detail
+ * this guard then reads as `unknown`. The containment covers a `detail` or `click` accessor that
+ * throws, as the button event guard does.
+ * @example
+ * ```ts
+ * isDropdownEvent(new CustomEvent('hide.vn.dropdown', { detail: { click: new MouseEvent('click') } })) // true
+ * isDropdownEvent(new CustomEvent('hide.vn.dropdown')) // false
+ * ```
+ */
+export function isDropdownEvent(value: unknown): value is DropdownEventMap['show'] {
+	try {
+		if (!isInstance(value, CustomEvent)) return false
+		const detail: unknown = value.detail
+		if (typeof detail !== 'object' || detail === null) return false
+		const click: unknown = 'click' in detail ? detail.click : undefined
+		return click === undefined || isInstance(click, MouseEvent)
+	} catch {
+		return false
+	}
+}
