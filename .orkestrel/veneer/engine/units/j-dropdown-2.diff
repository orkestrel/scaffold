+	// Hides the open menu for a click or a Tab key release its dismissal allows: a click on the toggle
+	// never counts, a secondary button never counts, a click inside the menu counts when `dismiss.inside`
+	// is true unless it lands on a form control, and a click or Tab release outside it counts when
+	// `dismiss.outside` is true. A click travels into the events as their `click` detail.
+	#lightDismiss(event: Event): void {
+		if (!this.shown) return
+		const click = isInstance(event, MouseEvent) && event.type === 'click' ? event : undefined
+		if (click === undefined && !(isInstance(event, KeyboardEvent) && event.key === 'Tab')) return
+		if (click?.button === 2) return
+		const path = event.composedPath()
+		if (path.includes(this.#host)) return
+		const inside = path.includes(this.#menu)
+		if (!(inside ? this.#dismiss.inside : this.#dismiss.outside)) return
+		const target = event.target
+		if (
+			inside &&
+			(click === undefined ||
+				(isInstance(target, Element) && /input|select|option|textarea|form/i.test(target.tagName)))
