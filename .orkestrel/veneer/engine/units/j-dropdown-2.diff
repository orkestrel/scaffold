+		const { up, end, start, center } = this.#classes
+		if (tokens?.contains(end)) return 'right-start'
+		if (tokens?.contains(start)) return 'left-start'
+		if (tokens?.contains(center.up)) return 'top'
+		if (tokens?.contains(center.down)) return 'bottom'
