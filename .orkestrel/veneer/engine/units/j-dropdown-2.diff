+describe('isDropdownEvent', () => {
+	it('requires a custom event whose detail is an object carrying an optional click', () => {
+		const click = new MouseEvent('click')
+		expect(isDropdownEvent(new CustomEvent('hide.vn.dropdown', { detail: { click } }))).toBe(true)
+		expect(
+			isDropdownEvent(new CustomEvent('show.vn.dropdown', { detail: { click: undefined } })),
+		).toBe(true)
+		expect(isDropdownEvent(new CustomEvent('shown.vn.dropdown', { detail: {} }))).toBe(true)
+		expect(
+			isDropdownEvent(
+				new CustomEvent('hide.vn.dropdown', { detail: { click: new KeyboardEvent('keyup') } }),
+			),
+		).toBe(false)
+		expect(
+			isDropdownEvent(new CustomEvent('hide.vn.dropdown', { detail: { click: 'outside' } })),
+		).toBe(false)
+		expect(isDropdownEvent(new CustomEvent('hide.vn.dropdown', { detail: { click: null } }))).toBe(
+			false,
+		)
+		expect(isDropdownEvent(new CustomEvent('shown.vn.dropdown'))).toBe(false)
+		expect(isDropdownEvent(new CustomEvent('shown.vn.dropdown', { detail: 'click' }))).toBe(false)
+		expect(isDropdownEvent(new Event('shown.vn.dropdown'))).toBe(false)
+		expect(isDropdownEvent(undefined)).toBe(false)
+		expect(isDropdownEvent(null)).toBe(false)
+	})
