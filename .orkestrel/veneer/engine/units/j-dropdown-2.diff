+	// Records the `shown` tokens and the toggle's `aria-expanded` value before the first write, so
+	// destruction restores them.
+	#save(): void {
+		const { shown } = this.#classes
+		this.#snapshot.save({ category: 'token', element: this.#host, name: shown })
+		this.#snapshot.save({ category: 'token', element: this.#menu, name: shown })
+		this.#snapshot.save({ category: 'attribute', element: this.#host, name: 'aria-expanded' })
+	}
+}
