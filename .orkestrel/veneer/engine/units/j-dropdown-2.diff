+describe('parseDismiss', () => {
+	it('projects each Bootstrap auto-close value into the inside and outside switches', () => {
+		expect(parseDismiss('true')).toStrictEqual({ inside: true, outside: true })
+		expect(parseDismiss(true)).toStrictEqual({ inside: true, outside: true })
+		expect(parseDismiss('false')).toStrictEqual({ inside: false, outside: false })
+		expect(parseDismiss(false)).toStrictEqual({ inside: false, outside: false })
+		expect(parseDismiss('inside')).toStrictEqual({ inside: true, outside: false })
+		expect(parseDismiss('outside')).toStrictEqual({ inside: false, outside: true })
+	})
+
+	it('returns undefined for every value other than the auto-close values', () => {
+		expect(parseDismiss('')).toBeUndefined()
+		expect(parseDismiss('Inside')).toBeUndefined()
+		expect(parseDismiss(' outside')).toBeUndefined()
+		expect(parseDismiss('1')).toBeUndefined()
+		expect(parseDismiss(1)).toBeUndefined()
+		expect(parseDismiss(null)).toBeUndefined()
+		expect(parseDismiss(undefined)).toBeUndefined()
+		expect(parseDismiss({ inside: true })).toBeUndefined()
+	})
+})
+
+describe('parseOffset', () => {
+	it('reads two comma-separated numbers, and a pair of finite numbers, as a new pair', () => {
+		expect(parseOffset('0,2')).toStrictEqual([0, 2])
+		expect(parseOffset(' 10 , -20 ')).toStrictEqual([10, -20])
+		expect(parseOffset('1.5,0')).toStrictEqual([1.5, 0])
+		const pair = [3, 4]
+		const parsed = parseOffset(pair)
+		expect(parsed).toStrictEqual([3, 4])
+		expect(parsed).not.toBe(pair)
+	})
+
+	it('returns undefined for a value that is not exactly two finite numbers', () => {
+		expect(parseOffset('10')).toBeUndefined()
+		expect(parseOffset('1,2,3')).toBeUndefined()
+		expect(parseOffset('10px,2')).toBeUndefined()
+		expect(parseOffset(',2')).toBeUndefined()
+		expect(parseOffset('NaN,2')).toBeUndefined()
+		expect(parseOffset('Infinity,2')).toBeUndefined()
+		expect(parseOffset('')).toBeUndefined()
+		expect(parseOffset([1])).toBeUndefined()
+		expect(parseOffset([1, '2'])).toBeUndefined()
+		expect(parseOffset([1, Number.NaN])).toBeUndefined()
+		expect(parseOffset(2)).toBeUndefined()
+		expect(parseOffset(undefined)).toBeUndefined()
+	})
+})
