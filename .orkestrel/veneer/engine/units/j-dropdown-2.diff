--- /dev/null
+++ b/src/browser/Placement.ts
@@ -0,0 +1,220 @@
+import type {
+	PlacementAttributeMap,
+	PlacementInput,
+	PlacementInterface,
+	PlacementOptions,
+	PlacementSide,
+} from './types.js'
+import { AppError } from '@src/core'
+import { isInstance } from '@orkestrel/contract'
+import {
+	PLACEMENT_AREAS,
+	PLACEMENT_ATTRIBUTES,
+	PLACEMENT_DEFAULTS,
+	POPOVER_PROPERTIES,
+} from './constants.js'
+import { readTag, resolveVocabulary } from './helpers.js'
+import { HostSnapshot } from './HostSnapshot.js'
+import { isAttributeName } from './validators.js'
+
+/**
+ * Anchors a menu or a tip to its reference through CSS anchor positioning in the top layer.
+ *
+ * @remarks
+ * Construction validates both elements and the `attributes` group, then places the element at once.
+ * A static placement writes `static` to the attribute `attributes.popper` names and leaves the
+ * element in flow, promoting and anchoring nothing. Every other placement reads the properties the
+ * platform's popover rule sets, promotes the element with the HTML `popover` attribute and the
+ * `showPopover` method, and writes each of those properties back to its unpromoted value wherever the
+ * promotion changed it, so the cascade's own rules for the element keep winning. It then writes, as
+ * inline declarations, `position: fixed`, an `auto` inset, the offset as margins, the `position-area`
+ * value the position maps to, the fallbacks, and `position-try-order: normal`, and adds a generated
+ * anchor name to the reference's `anchor-name` list. The side the element resolved to is measured by
+ * comparing the two elements' rectangles, and written to the attribute `attributes.side` names at
+ * construction, at each `update` call, at each resize of the reference, and at each scroll end in its
+ * document, whenever the element renders. When the platform refuses the promotion, such as when a
+ * `beforetoggle` listener prevents it, the placement restores what it wrote and throws. The `signal`
+ * option destroys the placement when it aborts; it is read after the `popover` attribute write and
+ * after the promotion, and a placement it destroys during construction writes nothing more.
+ * Destruction hides the popover and restores every attribute and declaration the placement wrote,
+ * keeping every later edit.
+ *
+ * @example
+ * ```ts
+ * const placement = new Placement({ reference: toggle, element: menu }, { position: 'bottom-start' })
+ * placement.destroy()
+ * ```
+ */
+export class Placement implements PlacementInterface {
+	static #count = 0
+	readonly #reference: HTMLElement
+	readonly #element: HTMLElement
+	readonly #attributes: PlacementAttributeMap
+	readonly #static: boolean
+	readonly #snapshot = new HostSnapshot()
+	readonly #controller = new AbortController()
+	readonly #observer = new ResizeObserver(() => this.update())
+
+	/**
+	 * Validates the elements and places the element against its reference.
+	 *
+	 * @param input - The reference, the positioned element, and the popover mode it is promoted with.
+	 * @param options - The position, offset, fallbacks, static display, attribute names, and lifetime.
+	 * @throws Thrown when the reference or the element is not an HTMLElement, when a placement that is not static receives an element outside a document, or when an `attributes` value is not an attribute name, as an `AppError` carrying the `PLACEMENT_INPUT_INVALID` or `PLACEMENT_OPTION_INVALID` code; and when the platform refuses the promotion, such as when a `beforetoggle` listener prevents it, as an `AppError` carrying the `PLACEMENT_PROMOTION_REFUSED` code, after the placement restores what it wrote.
+	 */
+	constructor(input: PlacementInput, options?: PlacementOptions) {
+		const { reference, element } = input
+		for (const candidate of [reference, element]) {
+			if (!isInstance(candidate, HTMLElement)) {
+				throw new AppError('Placement requires HTML elements', 'PLACEMENT_INPUT_INVALID', {
+					tag: readTag(candidate),
+				})
+			}
+		}
+		this.#attributes = resolveVocabulary(
+			'PLACEMENT_OPTION_INVALID',
+			PLACEMENT_ATTRIBUTES,
+			isAttributeName,
+			options?.attributes,
+		)
+		this.#static = options?.static ?? PLACEMENT_DEFAULTS.static
+		if (!this.#static && !element.isConnected) {
+			throw new AppError('Placement requires a connected element', 'PLACEMENT_INPUT_INVALID', {
+				tag: element.tagName,
+			})
+		}
+		this.#reference = reference
+		this.#element = element
+		const signal = options?.signal
+		signal?.addEventListener('abort', () => this.destroy(), {
+			once: true,
+			signal: this.#controller.signal,
+		})
+		if (this.#static) {
+			this.#snapshot.save({ category: 'attribute', element, name: this.#attributes.popper })
+			element.setAttribute(this.#attributes.popper, 'static')
+			return
+		}
+		const style = getComputedStyle(element)
+		const unpromoted = POPOVER_PROPERTIES.map((name) => style.getPropertyValue(name))
+		this.#snapshot.save({ category: 'attribute', element, name: 'popover' })
+		element.setAttribute('popover', input.popover ?? 'manual')
+		// A reaction to the attribute write, and a listener to the `beforetoggle` event the promotion
+		// dispatches, can abort the signal or refuse the promotion, so both are read after each one.
+		if (this.#halted(signal)) return
+		try {
+			element.showPopover()
+		} catch (error) {
+			if (this.#halted(signal)) return
+			throw this.#refuse(error)
+		}
+		if (this.#halted(signal)) return
+		if (!element.matches(':popover-open')) throw this.#refuse(undefined)
+		POPOVER_PROPERTIES.forEach((name, index) => {
+			const value = unpromoted[index]
+			if (value !== undefined && style.getPropertyValue(name) !== value) {
+				this.#write(element, name, value)
+			}
+		})
+		const area = PLACEMENT_AREAS[options?.position ?? PLACEMENT_DEFAULTS.position]
+		const side = area.split(' ')[0]
+		const vertical = side === 'top' || side === 'bottom'
+		const [skid, distance] = options?.offset ?? PLACEMENT_DEFAULTS.offset
+		const fallbacks = options?.fallbacks
+		const anchor = `--vn-placement-${Placement.#count++}`
+		this.#write(element, 'position', 'fixed')
+		for (const edge of ['top', 'right', 'bottom', 'left']) this.#write(element, edge, 'auto')
+		this.#write(element, 'margin-top', `${side === 'bottom' ? distance : vertical ? 0 : skid}px`)
+		this.#write(element, 'margin-right', `${side === 'left' ? distance : vertical ? -skid : 0}px`)
+		this.#write(element, 'margin-bottom', `${side === 'top' ? distance : vertical ? 0 : -skid}px`)
+		this.#write(element, 'margin-left', `${side === 'right' ? distance : vertical ? skid : 0}px`)
+		this.#write(element, 'position-anchor', anchor)
+		this.#write(element, 'position-area', area)
+		this.#write(
+			element,
+			'position-try-fallbacks',
+			fallbacks === undefined
+				? vertical
+					? 'flip-block'
+					: 'flip-inline'
+				: fallbacks.length === 0
+					? 'none'
+					: fallbacks.map((fallback) => PLACEMENT_AREAS[fallback]).join(', '),
+		)
+		this.#write(element, 'position-try-order', 'normal')
+		const names = getComputedStyle(reference).getPropertyValue('anchor-name')
+		this.#write(reference, 'anchor-name', names === 'none' ? anchor : `${names}, ${anchor}`)
+		if (this.#controller.signal.aborted) return
+		this.#observer.observe(reference)
+		reference.ownerDocument.addEventListener('scrollend', () => this.update(), {
+			capture: true,
+			signal: this.#controller.signal,
+		})
+		this.update()
+	}
+
+	get reference(): HTMLElement {
+		return this.#reference
+	}
+
+	get element(): HTMLElement {
+		return this.#element
+	}
+
+	get side(): PlacementSide | undefined {
+		if (this.#static || this.#controller.signal.aborted || !this.#element.checkVisibility()) {
+			return undefined
+		}
+		const element = this.#element.getBoundingClientRect()
+		const reference = this.#reference.getBoundingClientRect()
+		const gaps: ReadonlyArray<readonly [PlacementSide, number]> = [
+			['top', reference.top - element.bottom],
+			['right', element.left - reference.right],
+			['bottom', element.top - reference.bottom],
+			['left', reference.left - element.right],
+		]
+		return gaps.reduce((widest, gap) => (gap[1] > widest[1] ? gap : widest))[0]
+	}
+
+	update(): void {
+		const side = this.side
+		if (side === undefined) return
+		const name = this.#attributes.side
+		this.#snapshot.save({ category: 'attribute', element: this.#element, name })
+		this.#element.setAttribute(name, side)
+	}
+
+	destroy(): void {
+		if (this.#controller.signal.aborted) return
+		this.#controller.abort()
+		this.#observer.disconnect()
+		if (this.#element.matches(':popover-open')) this.#element.hidePopover()
+		this.#snapshot.restore()
+	}
+
+	// Reports whether the signal aborted or the placement is destroyed, destroying it so it writes
+	// nothing more; a placement the signal destroyed has already restored what it wrote.
+	#halted(signal: AbortSignal | undefined): boolean {
+		if (signal?.aborted === true) this.destroy()
+		return this.#controller.signal.aborted
+	}
+
+	// Restores what the placement wrote and returns the error that reports the refused promotion.
+	#refuse(cause: unknown): AppError {
+		this.destroy()
+		return new AppError(
+			'The platform refused the popover promotion',
+			'PLACEMENT_PROMOTION_REFUSED',
+			{ tag: this.#element.tagName },
+			{ cause },
+		)
+	}
+
+	// Records an inline property before its first write, so destruction restores it; a destroyed
+	// placement writes nothing.
+	#write(element: HTMLElement, name: string, value: string): void {
+		if (this.#controller.signal.aborted) return
+		this.#snapshot.save({ category: 'property', element, name })
+		element.style.setProperty(name, value)
+	}
+}
