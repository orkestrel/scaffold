+
+/**
+ * Returns the member of a list that comes after or before the current one, Bootstrap's `getNextActiveElement`.
+ *
+ * @param list - The members in order, such as the entries a menu's arrow keys move focus between.
+ * @param current - The member focus leaves, or a value outside the list.
+ * @param forward - If `true`, steps to the next member; if `false`, to the previous one.
+ * @param wrap - If `true`, steps past each end to the member at the other end; if `false`, stays at the end it reached.
+ * @returns The neighboring member; the first member when the current one is outside the list, or the last one when stepping backward with wrap; undefined for an empty list.
+ * @example
+ * ```ts
+ * computeNeighbor(['one', 'two'], 'one', true, false) // 'two'
+ * ```
+ */
+export function computeNeighbor<T>(
+	list: readonly T[],
+	current: T | undefined,
+	forward: boolean,
+	wrap: boolean,
+): T | undefined {
+	const index = current === undefined ? -1 : list.indexOf(current)
+	if (index === -1) return !forward && wrap ? list.at(-1) : list[0]
+	const next = index + (forward ? 1 : -1)
+	if (wrap) return list[(next + list.length) % list.length]
+	return list[Math.max(0, Math.min(next, list.length - 1))]
+}
