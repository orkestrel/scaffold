+			const constructor: unknown = Reflect.get(globalThis, 'Sanitizer')
+			const platform: unknown = isFunction(constructor)
+				? Reflect.construct(constructor, [{}])
+				: undefined
+			const removeUnsafe: unknown = isObject(platform)
+				? Reflect.get(platform, 'removeUnsafe')
+				: undefined
+			const get: unknown = isObject(platform) ? Reflect.get(platform, 'get') : undefined
+			if (!isObject(platform) || !isFunction(removeUnsafe) || !isFunction(get)) {
+				throw new Error('The Sanitizer class carries no removeUnsafe and get methods')
+			}
+			Reflect.apply(removeUnsafe, platform, [])
+			const reading: unknown = Reflect.apply(get, platform, [])
+			if (
+				!objectOf({
+					removeElements: arrayOf(objectOf({ name: isString, namespace: isString })),
+					removeAttributes: arrayOf(objectOf({ name: isString })),
+				})(reading)
+			) {
+				throw new Error('The baseline reading has no removal lists')
+			}
+			expect(reading.removeElements.length).toBeGreaterThan(0)
+			expect(reading.removeAttributes.length).toBeGreaterThan(0)
+			expect(
+				reading.removeElements.filter(
+					(entry) => !matchesBaselineElement({ name: entry.name, namespace: entry.namespace }),
+				),
+			).toEqual([])
+			const host = build('div')
+			expect(
+				reading.removeAttributes.filter((entry) => {
+					host.setAttribute(entry.name, 'alert(1)')
+					const attribute = host.getAttributeNode(entry.name)
+					return (
+						attribute === null ||
+						!matchesBaselineAttribute({ name: 'div', namespace: SANITIZER_NAMESPACE }, attribute)
+					)
+				}),
+			).toEqual([])
+		},
+	)
+
+	// The platform's `setHTML` method refuses an invalid configuration with a `TypeError`. Chromium 141
+	// carries no `setHTML` method, so there is no refusal to agree with.
+	it.skipIf(typeof Reflect.get(build('div'), 'setHTML') !== 'function')(
+		'admits exactly the configurations the setHTML method of the platform accepts',
+		() => {
+			const agreements = SANITIZER_CONFIGS.map((config) => {
+				const slot = build('div')
+				const setHTML: unknown = Reflect.get(slot, 'setHTML')
+				const accepted =
+					isFunction(setHTML) &&
+					attempt(() => Reflect.apply(setHTML, slot, ['<b>x</b>', { sanitizer: config }])).success
+				return { config: JSON.stringify(config), accepted, admitted: isSanitizerConfig(config) }
+			})
+			expect(new Set(agreements.map((agreement) => agreement.accepted))).toEqual(
+				new Set([true, false]),
+			)
+			expect(agreements.filter((agreement) => agreement.accepted !== agreement.admitted)).toEqual(
+				[],
+			)
+		},
+	)
+})
