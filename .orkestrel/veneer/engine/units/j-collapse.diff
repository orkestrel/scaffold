 	}
 }
+
+/**
+ * Checks whether a DOM event is a collapse event, which carries no payload.
+ *
+ * @param value - The value to inspect.
+ * @returns True if the value is a CustomEvent whose detail is null; false otherwise.
+ * @remarks
+ * A collapse dispatches each event with no detail, and the platform reads an absent `detail` as
+ * `null`, so a consumer's own event under a collapse wire name that carries a payload is refused.
+ * The containment covers a `detail` accessor that throws, as the button event guard does.
+ * @example
+ * ```ts
+ * isCollapseEvent(new CustomEvent('shown.vn.collapse')) // true
+ * isCollapseEvent(new CustomEvent('shown.vn.collapse', { detail: { shown: true } })) // false
+ * ```
+ */
+export function isCollapseEvent(value: unknown): value is CollapseEventMap['show'] {
+	try {
+		return value instanceof CustomEvent && value.detail === null
+	} catch {
+		return false
+	}
+}
