+	}
+
+	// Writes each trigger's `collapsed` token and `aria-expanded` value for the state the panel moves
+	// to, reporting whether the call still holds the change after every write.
+	#writeTriggers(change: object, triggers: readonly HTMLElement[], expanded: boolean): boolean {
+		const { collapsed } = this.#classes
+		for (const trigger of triggers) {
