@@ -0,0 +1,28 @@
+import { instanceOf } from '@orkestrel/contract'
+
+/**
+ * Parses a selector, or an element, to the HTML element it names in the document.
+ *
+ * @param value - The value to parse: a selector string, or an HTML element returned unchanged.
+ * @returns The first HTML element the selector matches in the global document, or the element
+ *   itself; undefined when the value is neither a string nor an HTML element, when the selector is
+ *   not valid CSS, or when it matches no HTML element.
+ * @remarks
+ * This is Bootstrap's `getElement` coercion, which the `parent` option of a collapse reads from its
+ * `data-bs-parent` attribute. The selector is resolved in the global `document`, as Bootstrap
+ * resolves it, and an invalid selector returns undefined rather than throwing.
+ * @example
+ * ```ts
+ * const accordion = parseElement('#accordion')
+ * ```
+ */
+export function parseElement(value: unknown): HTMLElement | undefined {
+	if (instanceOf(HTMLElement)(value)) return value
+	if (typeof value !== 'string') return undefined
+	try {
+		const element = document.querySelector(value)
+		return instanceOf(HTMLElement)(element) ? element : undefined
+	} catch {
+		return undefined
+	}
+}
