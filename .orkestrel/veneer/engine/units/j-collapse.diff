+import type { CollapseInterface } from '@src/browser'
+import {
+	Button,
+	Collapse,
+	COLLAPSE_ATTRIBUTES,
+	COLLAPSE_CLASSES,
+	COLLAPSE_EVENTS,
+	COLLAPSE_SELECTORS,
+	Delegate,
+} from '@src/browser'
+import { isAppError } from '@src/core'
+import { attempt } from '@orkestrel/contract'
+import { createRecorder, requireValue, waitForCondition, waitForEvent } from '@orkestrel/test'
+import { clickAccessible, releaseMedia, stageMedia } from '@orkestrel/test/browser'
+import { afterEach, describe, expect, it, onTestFinished } from 'vitest'
+import collapseCascade from '../../../src/styles/components/_collapse.scss?inline'
+import { recordListeners, scene } from '../../setupBrowser.js'
+
+afterEach(() => scene.clear())
+
+describe('Collapse', () => {
+	it('publishes frozen default tables that name the cascade tokens, Bootstrap attributes, and wire events', () => {
+		expect(COLLAPSE_CLASSES).toStrictEqual({
+			host: 'collapse',
+			shown: 'show',
+			transition: 'collapsing',
+			horizontal: 'collapse-horizontal',
+			collapsed: 'collapsed',
+		})
+		expect(COLLAPSE_ATTRIBUTES).toStrictEqual({
+			target: 'data-bs-target',
+			parent: 'data-bs-parent',
+		})
+		expect(COLLAPSE_SELECTORS).toStrictEqual({ trigger: '[data-bs-toggle="collapse"]' })
+		expect(COLLAPSE_EVENTS).toStrictEqual({
+			show: 'show.vn.collapse',
+			shown: 'shown.vn.collapse',
+			hide: 'hide.vn.collapse',
+			hidden: 'hidden.vn.collapse',
+		})
+		for (const table of [
+			COLLAPSE_CLASSES,
+			COLLAPSE_ATTRIBUTES,
+			COLLAPSE_SELECTORS,
+			COLLAPSE_EVENTS,
+		]) {
+			expect(Object.isFrozen(table)).toBe(true)
+		}
+	})
+
+	it('reads the shipped collapse declarations the motion proofs run under', () => {
+		const sheet = requireValue(scene.load(collapseCascade).sheet, 'The cascade sheet did not load')
+		const panel = scene.mount('<div class="collapsing collapse-horizontal"></div>')
+		const probe = requireValue(panel.querySelector('div'), 'No probe')
+		expect(sheet.cssRules.length).toBeGreaterThan(0)
+		expect(getComputedStyle(probe).transitionProperty).toBe('width')
+		expect(getComputedStyle(probe).transitionDuration).toBe('0.35s')
+		probe.classList.remove('collapse-horizontal')
+		expect(getComputedStyle(probe).transitionProperty).toBe('height')
+		expect(getComputedStyle(probe).height).toBe('0px')
+		expect(getComputedStyle(probe).overflow).toBe('hidden')
+		probe.className = 'collapse'
+		expect(getComputedStyle(probe).display).toBe('none')
+	})
+
+	it('shows through the transition token and an inline pixel height, then writes the host and shown tokens and expands every trigger', async () => {
+		scene.load(collapseCascade)
+		const root = scene.mount(`
+			<button type="button" class="collapsed" aria-expanded="false" data-bs-toggle="collapse" data-bs-target="#details">Details</button>
+			<a href="#details" role="button" data-bs-toggle="collapse">Details link</a>
+			<button type="button" data-bs-toggle="collapse" data-bs-target="#other">Other</button>
+			<div id="details" class="collapse"><div style="height: 40px"></div></div>
+			<div id="other" class="collapse"></div>`)
+		const panel = requireValue(root.querySelector<HTMLElement>('#details'), 'No panel')
+		const [button, link, other] = Array.from(root.querySelectorAll('[data-bs-toggle]'))
+		const collapse = new Collapse(panel)
+		onTestFinished(() => collapse.destroy())
+		expect(collapse.host).toBe(panel)
+		expect(collapse.shown).toBe(false)
+		const showing = collapse.show()
+		expect(Array.from(panel.classList)).toEqual(['collapsing'])
+		expect(panel.style.height).toBe('40px')
+		expect(
+			panel
+				.getAnimations()
+				.map((animation) =>
+					animation instanceof CSSTransition ? animation.transitionProperty : animation.id,
+				),
+		).toEqual(['height'])
+		expect(button?.classList.contains('collapsed')).toBe(false)
+		expect(button?.getAttribute('aria-expanded')).toBe('true')
+		expect(link?.getAttribute('aria-expanded')).toBe('true')
+		expect(other?.hasAttribute('aria-expanded')).toBe(false)
+		expect(collapse.shown).toBe(false)
+		expect(await showing).toBe(true)
+		expect(Array.from(panel.classList)).toEqual(['collapse', 'show'])
+		expect(panel.style.height).toBe('')
+		expect(collapse.shown).toBe(true)
+		const later = root.appendChild(document.createElement('button'))
+		later.setAttribute('data-bs-toggle', 'collapse')
+		later.setAttribute('data-bs-target', '#details')
+		const hiding = collapse.hide()
+		expect(later.classList.contains('collapsed')).toBe(true)
+		expect(later.getAttribute('aria-expanded')).toBe('false')
+		expect(Array.from(panel.classList)).toEqual(['collapsing'])
+		expect(
+			panel
+				.getAnimations()
+				.map((animation) =>
+					animation instanceof CSSTransition ? animation.transitionProperty : animation.id,
+				),
+		).toEqual(['height'])
+		expect(button?.classList.contains('collapsed')).toBe(true)
+		expect(button?.getAttribute('aria-expanded')).toBe('false')
+		expect(link?.classList.contains('collapsed')).toBe(true)
+		expect(link?.getAttribute('aria-expanded')).toBe('false')
+		expect(await hiding).toBe(true)
+		expect(Array.from(panel.classList)).toEqual(['collapse'])
+		expect(panel.style.height).toBe('')
+		expect(collapse.shown).toBe(false)
+		expect(await collapse.toggle()).toBe(true)
+		expect(collapse.shown).toBe(true)
+		expect(await collapse.toggle()).toBe(true)
+		expect(collapse.shown).toBe(false)
