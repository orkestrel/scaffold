+		root.addEventListener('toggle.vn.button', () => pressing.destroy(), {
+			signal: controller.signal,
+		})
+		both?.click()
+		await Promise.resolve()
+		expect(Collapse.find(details)).toBeUndefined()
+		expect(Array.from(details.classList)).toEqual(['collapse'])
+		expect(both?.hasAttribute('aria-expanded')).toBe(false)
+		const opening = new Delegate({ root })
+		onTestFinished(() => opening.destroy())
+		first.addEventListener('show.vn.collapse', () => opening.destroy(), {
+			signal: controller.signal,
+		})
+		panels?.click()
+		await Promise.resolve()
+		expect(Collapse.find(first)).toBeUndefined()
+		expect(Collapse.find(second)).toBeUndefined()
+		expect(Array.from(second.classList)).toEqual(['collapse'])
+	})
+
+	it('refuses a collapse group value that is not a class token, an attribute name, or a selector at construction', () => {
+		const root = build('div')
+		expect(
+			attempt(() => new Delegate({ root, collapse: { classes: { collapsed: 'is shut' } } })),
+		).toMatchObject({
+			success: false,
+			error: { code: 'COLLAPSE_OPTION_INVALID', context: { key: 'collapsed' } },
+		})
+		expect(
+			attempt(() => new Delegate({ root, collapse: { attributes: { parent: 'data parent' } } })),
+		).toMatchObject({
+			success: false,
+			error: { code: 'COLLAPSE_OPTION_INVALID', context: { key: 'parent' } },
+		})
+		const refused = attempt(() => new Delegate({ root, collapse: { selectors: { trigger: '' } } }))
+		expect(refused).toEqual({ success: false, error: expect.toSatisfy(isAppError) })
+		expect(refused).toMatchObject({
+			error: { code: 'COLLAPSE_OPTION_INVALID', context: { key: 'trigger' } },
+		})
+	})
 })
