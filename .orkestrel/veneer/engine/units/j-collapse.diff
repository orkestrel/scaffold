--- /dev/null
+++ b/src/browser/Collapse.ts
@@ -0,0 +1,340 @@
+import type {
+	CollapseAttributeMap,
+	CollapseClassMap,
+	CollapseInterface,
+	CollapseOptions,
+	CollapseSelectorMap,
+} from './types.js'
+import { AppError } from '@src/core'
+import { instanceOf } from '@orkestrel/contract'
+import {
+	COLLAPSE_ATTRIBUTES,
+	COLLAPSE_CLASSES,
+	COLLAPSE_EVENTS,
+	COLLAPSE_SELECTORS,
+} from './constants.js'
+import {
+	bindEventMap,
+	emitEvent,
+	readTargets,
+	reflow,
+	resolveOptions,
+	resolveVocabulary,
+	settleAnimations,
+} from './helpers.js'
+import { HostSnapshot } from './HostSnapshot.js'
+import { parseElement } from './parsers.js'
+import { Registry } from './Registry.js'
+import { isAttributeName, isClassToken, isCollapseEvent, isSelector } from './validators.js'
+
+/**
+ * Shows and hides a panel through its size transition, keeping its triggers' expanded state in step.
+ *
+ * @remarks
+ * The host must be an HTMLElement in the current realm and have no live collapse owner.
+ * Construction writes nothing: it validates and copies the `classes`, `attributes`, and
+ * `selectors` groups, resolves the `parent` option from the constructor or from the attribute
+ * `attributes.parent` names, claims the host, and binds the hooks. A trigger is any element the
+ * `trigger` selector matches in the host's document whose target attribute or `href` fragment names
+ * the host. Showing writes the `transition` token and an inline size, sets every trigger's
+ * `aria-expanded` to `true` without its `collapsed` token, waits for the transition to settle, and
+ * then writes the `host` and `shown` tokens and clears the size; hiding runs the reverse and
+ * collapses each trigger none of whose panels is shown. A panel carrying the `horizontal` token sizes
+ * its width instead of its height. With a `parent`, showing first hides every open first-level panel
+ * inside it through that panel's own collapse, constructing one with the same groups and parent
+ * where the panel has none; the collapse owns each one it constructs and destroys it on its own
+ * destruction. After each write, dispatch, and await, a call reads its lifetime and the host again,
+ * and it stops, resolving `false`, when the collapse was destroyed or another call took the change
+ * over. An aborted `signal` destroys the collapse.
+ *
+ * @example
+ * ```ts
+ * const collapse = new Collapse(document.createElement('div'))
+ * await collapse.toggle()
+ * collapse.destroy()
+ * ```
+ */
+export class Collapse implements CollapseInterface {
+	static readonly #registry = new Registry<Collapse>({ code: 'COLLAPSE_HOST_OWNED' })
+	readonly #host: HTMLElement
+	readonly #parent: HTMLElement | undefined
+	readonly #classes: CollapseClassMap
+	readonly #attributes: CollapseAttributeMap
+	readonly #selectors: CollapseSelectorMap
+	readonly #snapshot = new HostSnapshot()
+	readonly #controller = new AbortController()
+	readonly #siblings = new Set<Collapse>()
+	// The change in flight: the call that wrote the `transition` token holds this identity until it
+	// completes, so a call resuming after another took the panel over sees that it no longer holds it.
+	#change: object | undefined
+
+	/**
+	 * Claims the host, resolves its vocabulary and parent, and binds initial hooks.
+	 *
+	 * @param host - The HTML element to own, the panel.
+	 * @param options - The accordion parent, markup vocabulary, initial event subscriptions, and lifetime.
+	 * @throws Thrown when the host is not an HTMLElement, when a group value is not a class token, an attribute name, or a selector, when the parent attribute names no HTML element, or when the host already has a live owner.
+	 */
+	constructor(host: HTMLElement, options?: CollapseOptions) {
+		if (!instanceOf(HTMLElement)(host)) {
+			let tag: string | undefined
+			try {
+				const value: unknown = host
+				if (value instanceof Element) tag = value.tagName
+			} catch {
+				tag = undefined
+			}
+			throw new AppError('Collapse requires an HTMLElement host', 'COLLAPSE_HOST_INVALID', { tag })
+		}
+		this.#classes = resolveVocabulary(
+			'COLLAPSE_OPTION_INVALID',
+			COLLAPSE_CLASSES,
+			isClassToken,
+			options?.classes,
+		)
+		this.#attributes = resolveVocabulary(
+			'COLLAPSE_OPTION_INVALID',
+			COLLAPSE_ATTRIBUTES,
+			isAttributeName,
+			options?.attributes,
+		)
+		this.#selectors = resolveVocabulary(
+			'COLLAPSE_OPTION_INVALID',
+			COLLAPSE_SELECTORS,
+			isSelector,
+			options?.selectors,
+		)
+		this.#parent = resolveOptions<Pick<CollapseOptions, 'parent'>, 'parent'>(
+			host,
+			this.#attributes,
+			'COLLAPSE_OPTION_INVALID',
+			{},
+			{ parent: parseElement },
+			options,
+		).parent
+		Collapse.#registry.claim(host, this)
+		this.#host = host
+		bindEventMap(host, COLLAPSE_EVENTS, isCollapseEvent, options?.on, this.#controller.signal)
+		const signal = options?.signal
+		if (signal?.aborted) this.destroy()
+		else {
+			signal?.addEventListener('abort', () => this.destroy(), {
+				once: true,
+				signal: this.#controller.signal,
+			})
+		}
+	}
+
+	/**
+	 * Returns the live collapse that owns a panel, mirroring Bootstrap's `getInstance`.
+	 *
+	 * @param host - The panel to look up.
+	 * @returns The owning collapse, or undefined when no live collapse owns the panel.
+	 * @example
+	 * ```ts
+	 * await Collapse.find(panel)?.toggle()
+	 * ```
+	 */
+	static find(host: HTMLElement): CollapseInterface | undefined {
+		return Collapse.#registry.find(host)
+	}
+
+	get host(): HTMLElement {
+		return this.#host
+	}
+
+	get shown(): boolean {
+		return this.#host.classList.contains(this.#classes.shown)
+	}
+
+	async show(): Promise<boolean> {
+		if (this.#refused(true) || this.#moving(this.#open())) return false
+		if (!emitEvent(this.#host, COLLAPSE_EVENTS.show, undefined, true)) return false
+		// A listener runs inside the dispatch and can destroy this collapse, show or hide the panel
+		// itself, or start a sibling's transition, so every refusal is read again before any write.
+		const open = this.#open()
+		if (this.#refused(true) || this.#moving(open)) return false
+		const change = {}
+		this.#change = change
+		if (!this.#close(change, open)) return false
+		const host = this.#host
+		const { transition, shown } = this.#classes
+		const dimension = this.#dimension()
+		const triggers = this.#triggers()
+		this.#save(dimension, triggers)
+		if (!this.#apply(change, () => host.classList.add(transition))) return false
+		if (!this.#apply(change, () => host.classList.remove(this.#classes.host))) return false
+		if (!this.#apply(change, () => host.style.setProperty(dimension, '0px'))) return false
+		if (!this.#writeTriggers(change, triggers, true)) return false
+		// Reading the scroll size lays the panel out at zero, so the size written next transitions.
+		const size = dimension === 'width' ? host.scrollWidth : host.scrollHeight
+		if (!this.#apply(change, () => host.style.setProperty(dimension, `${size}px`))) return false
+		await settleAnimations(host, this.#controller.signal)
+		if (this.#taken(change) || !host.classList.contains(transition)) return false
+		if (!this.#apply(change, () => host.classList.add(this.#classes.host, shown))) return false
+		if (!this.#apply(change, () => host.classList.remove(transition))) return false
+		if (!this.#apply(change, () => host.style.removeProperty(dimension))) return false
+		this.#change = undefined
+		emitEvent(host, COLLAPSE_EVENTS.shown, undefined, false)
+		return !this.#controller.signal.aborted
+	}
+
+	async hide(): Promise<boolean> {
+		if (this.#refused(false)) return false
+		if (!emitEvent(this.#host, COLLAPSE_EVENTS.hide, undefined, true)) return false
+		if (this.#refused(false)) return false
+		const change = {}
+		this.#change = change
+		const host = this.#host
+		const { transition, shown } = this.#classes
+		const dimension = this.#dimension()
+		const triggers = this.#triggers()
+		this.#save(dimension, triggers)
+		const size = host.getBoundingClientRect()[dimension]
+		if (!this.#apply(change, () => host.style.setProperty(dimension, `${size}px`))) return false
+		reflow(host)
+		if (!this.#apply(change, () => host.classList.add(transition))) return false
+		if (!this.#apply(change, () => host.classList.remove(this.#classes.host, shown))) return false
+		const collapsed = triggers.filter(
+			(trigger) =>
+				!readTargets(trigger, this.#attributes).some((panel) => panel.classList.contains(shown)),
+		)
+		if (!this.#writeTriggers(change, collapsed, false)) return false
+		if (!this.#apply(change, () => host.style.removeProperty(dimension))) return false
+		await settleAnimations(host, this.#controller.signal)
+		if (this.#taken(change) || !host.classList.contains(transition)) return false
+		if (!this.#apply(change, () => host.classList.add(this.#classes.host))) return false
+		if (!this.#apply(change, () => host.classList.remove(transition))) return false
+		this.#change = undefined
+		emitEvent(host, COLLAPSE_EVENTS.hidden, undefined, false)
+		return !this.#controller.signal.aborted
+	}
+
+	toggle(): Promise<boolean> {
+		return this.shown ? this.hide() : this.show()
+	}
+
+	destroy(): void {
+		if (this.#controller.signal.aborted) return
+		this.#controller.abort()
+		// The claim goes before the panel is restored, so an engine constructed while restoration runs
+		// can claim the panel, and its snapshot takes the values this one has still to write back.
+		Collapse.#registry.release(this.#host, this)
+		this.#snapshot.restore()
+		for (const engine of this.#siblings) engine.destroy()
+		this.#siblings.clear()
+	}
+
+	// Reports whether a call that would leave the panel shown or hidden cannot start: the collapse is
+	// destroyed, the panel transitions, or it already carries the state.
+	#refused(shown: boolean): boolean {
+		return (
+			this.#controller.signal.aborted ||
+			this.#host.classList.contains(this.#classes.transition) ||
+			this.shown === shown
+		)
+	}
+
+	// Reports whether any of the panels carries the `transition` token.
+	#moving(panels: readonly HTMLElement[]): boolean {
+		return panels.some((panel) => panel.classList.contains(this.#classes.transition))
+	}
+
+	// Reports whether the call holding the change stops: the collapse is destroyed or another call
+	// took the change over.
+	#taken(change: object): boolean {
+		return this.#controller.signal.aborted || this.#change !== change
+	}
+
+	// Runs one write a reaction can run inside, then reports whether the call still holds the change.
+	#apply(change: object, write: () => void): boolean {
+		write()
+		return !this.#taken(change)
+	}
+
+	// Names the inline size the panel transitions: its width with the `horizontal` token, else its
+	// height.
+	#dimension(): 'width' | 'height' {
+		return this.#host.classList.contains(this.#classes.horizontal) ? 'width' : 'height'
+	}
+
+	// Lists the elements the `trigger` selector matches in the panel's document that name the panel.
+	#triggers(): readonly HTMLElement[] {
