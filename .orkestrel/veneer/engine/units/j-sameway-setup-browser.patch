+/**
+ * Lists the doors of a modal's show before its token step, where the agreement proof has the host add the `shown` token first.
+ *
+ * @remarks
+ * Each door follows the `show.vn.modal` dispatch, the scroll lock's construction, the body's `open`
+ * token, the host's padding, the backdrop's show, the host's insertion into the body, or one of the
+ * host's `display`, `aria-hidden`, `aria-modal`, and `role` writes.
+ */
+export const MODAL_SHOW_DOORS = Object.freeze([
+	'event',
+	'lock',
+	'open',
+	'adjust',
+	'backdrop',
+	'append',
+	'display',
+	'aria-hidden',
+	'aria-modal',
+	'role',
+] as const)
+
+/**
+ * Lists the doors of an offcanvas panel's show before its token step, where the agreement proof has the host add the `shown` token first.
+ *
+ * @remarks
+ * Each door follows the `show.vn.offcanvas` dispatch, the scroll lock's construction, the held
+ * backdrop's insertion, or one of the host's `aria-modal`, `role`, and `showing` writes.
+ */
+export const OFFCANVAS_SHOW_DOORS = Object.freeze([
+	'event',
+	'lock',
+	'insertion',
+	'aria-modal',
+	'role',
+	'showing',
+] as const)
+
+/**
+ * Lists the doors of a modal's hide before its token step, where the agreement proof has the host remove the `shown` token first, each with and without the `fade` token.
+ *
+ * @remarks
+ * Each door follows the `hide.vn.modal` dispatch or the isolation's release.
+ */
+export const MODAL_HIDE_DOORS = Object.freeze(
+	(['event', 'isolation'] as const).flatMap((door) =>
+		[false, true].map((fade) => Object.freeze({ door, fade })),
+	),
+)
+
+/**
+ * Lists the doors of an offcanvas panel's hide before its token step, where the agreement proof has the host remove the `shown` token first.
+ *
+ * @remarks
+ * Each door follows the `hide.vn.offcanvas` dispatch, the isolation's release, or the `hiding` write.
+ */
+export const OFFCANVAS_HIDE_DOORS = Object.freeze(['event', 'isolation', 'hiding'] as const)
+
+/**
+ * Lists the reversal proof's rows: the door at which the host moves the `shown` token to a show's end, and the later door at which it moves the token back.
+ *
+ * @remarks
+ * A row whose `early` door is the pre-change dispatch reverses before the show's token step, and a
+ * row whose `early` door is the `role` write reverses after it, inside the focus move.
+ */
+export const SHOW_REVERSALS = Object.freeze([
+	Object.freeze({ early: 'event', late: 'role' } as const),
+	Object.freeze({ early: 'role', late: 'focus' } as const),
+])
+
+/**
+ * Lists the reactions inside a stopped show's isolation release that start a change of their own, for the modal and the offcanvas panel.
+ *
+ * @remarks
+ * The `source` names what reacts: a sibling whose `inert` claim is released, the trigger the release
