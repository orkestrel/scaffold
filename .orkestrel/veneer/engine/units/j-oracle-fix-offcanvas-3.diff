+// Each case reads the platform's own `activeElement` beside the helper, so a read that stops at the
+// root it starts from reads what the platform reads there and breaks the case.
+describe('readFocusedElement', () => {
+	it('returns the focused element of a document whose focus sits in its own tree', () => {
+		const button = mount(build('button'))
+		onTestFinished(() => button.remove())
+		button.focus()
+		expect([document.activeElement, readFocusedElement(document)]).toEqual([button, button])
+	})
+
+	it('returns the focused element inside one open shadow root, which the document reads as its host', () => {
+		const host = mount(build('div'))
+		onTestFinished(() => host.remove())
+		const shadow = host.attachShadow({ mode: 'open' })
+		const button = build('button')
+		shadow.append(button)
+		button.focus()
+		expect({
+			document: document.activeElement,
+			deep: readFocusedElement(document),
+			root: readFocusedElement(shadow),
+		}).toEqual({ document: host, deep: button, root: button })
+	})
+
+	it('returns the focused element two open shadow roots down, from the document and from the outer root', () => {
+		const outer = mount(build('div'))
+		onTestFinished(() => outer.remove())
+		const first = outer.attachShadow({ mode: 'open' })
+		const inner = build('div')
+		first.append(inner)
+		const second = inner.attachShadow({ mode: 'open' })
+		const button = build('button')
+		second.append(button)
+		button.focus()
+		expect({
+			document: document.activeElement,
+			outer: first.activeElement,
+			deep: readFocusedElement(document),
+			root: readFocusedElement(first),
+		}).toEqual({ document: outer, outer: inner, deep: button, root: button })
+	})
+
+	it('ends the read at the host of a closed shadow root, which exposes no shadow root to read down', () => {
+		const host = mount(build('div'))
+		onTestFinished(() => host.remove())
+		const shadow = host.attachShadow({ mode: 'closed' })
+		const button = build('button')
+		shadow.append(button)
+		button.focus()
+		expect({
+			exposed: host.shadowRoot,
+			deep: readFocusedElement(document),
+			root: readFocusedElement(shadow),
+		}).toEqual({ exposed: null, deep: host, root: button })
+	})
+
+	it('ends the read at a focused host whose open shadow root holds no focus', () => {
+		const host = mount(build('div'))
+		onTestFinished(() => host.remove())
+		host.tabIndex = 0
+		host.attachShadow({ mode: 'open' }).append(build('button'))
+		host.focus()
+		expect([document.activeElement, readFocusedElement(document)]).toEqual([host, host])
+	})
+
+	it('returns undefined for a shadow root nothing inside has focus, and the body for a document nothing has focus in', () => {
+		const host = mount(build('div'))
+		onTestFinished(() => host.remove())
+		const shadow = host.attachShadow({ mode: 'open' })
+		const button = build('button')
+		shadow.append(button)
+		button.focus()
+		button.blur()
+		expect({
+			root: shadow.activeElement,
+			deep: readFocusedElement(shadow),
+			document: readFocusedElement(document),
+		}).toEqual({ root: null, deep: undefined, document: document.body })
+	})
+})
