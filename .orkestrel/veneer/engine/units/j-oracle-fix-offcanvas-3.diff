+/**
+ * Returns the deepest focused element under a document or a shadow root, reading down through each open shadow root.
+ *
+ * @param root - The document or shadow root whose focused element is read.
+ * @returns The focused element the read ends at; undefined when nothing under the root has focus,
+ *   which the root reports as a `null` active element.
+ * @remarks
+ * The read starts at the root's `activeElement` and, while that element carries an open shadow root
+ * whose `activeElement` is set, moves to it. The platform retargets focus inside a shadow root to
+ * the root's host for every reader outside it, so a read of one root alone misses a focus move
+ * between two elements of a shadow root below it. A closed shadow root exposes no `shadowRoot`
+ * member, so the read ends at its host. A document reports its body as active when nothing else
+ * has focus, so the read under a document returns the body then.
+ * @example
+ * ```ts
+ * const focused = readFocusedElement(document)
+ * ```
+ */
+export function readFocusedElement(root: DocumentOrShadowRoot): Element | undefined {
+	let focused = root.activeElement ?? undefined
+	let inner = focused?.shadowRoot?.activeElement ?? undefined
+	while (inner !== undefined) {
+		focused = inner
+		inner = inner.shadowRoot?.activeElement ?? undefined
+	}
+	return focused
+}
