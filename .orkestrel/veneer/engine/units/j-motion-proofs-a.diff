index bd8f1c7..2064832 100644
--- a/tests/setupBrowser.ts
+++ b/tests/setupBrowser.ts
@@ -1783,6 +1783,33 @@ export class SceneManager {
  */
 export const scene = new SceneManager()
 
+/**
+ * Returns the longest transition duration an element's computed style declares, in milliseconds.
+ *
+ * @param element - The element whose `transition-duration` list is read.
+ * @returns The largest entry of the list in milliseconds, which is `0` when the element declares no transition.
+ * @remarks
+ * A motion proof reads a duration the cascade owns rather than pinning one. It sets up a condition
+ * from the reading, such as lengthening one element's motion past another's, or compares two readings
+ * of one element, such as the ratio a motion factor makes. The list holds one entry per transitioned
+ * property, each a CSS time in seconds or milliseconds. The reading starts nothing; the running
+ * transition's own timing is what `getAnimations` reports.
+ * @example
+ * ```ts
+ * dialog.style.setProperty('transition-duration', `${2 * readDuration(host)}ms`)
+ * ```
+ */
+export function readDuration(element: Element): number {
+	return Math.max(
+		...getComputedStyle(element)
+			.transitionDuration.split(',')
+			.map((entry) => {
+				const time = entry.trim()
+				return Number.parseFloat(time) * (time.endsWith('ms') ? 1 : 1000)
+			}),
+	)
+}
