 	now: Date.now,
 })
 
+// Reflected-index text, built from the coercion captured above.
+
+/**
+ * The decimal text of every array index from `0` through `1023`, frozen.
+ *
+ * @remarks
+ * {@link readArrayEntries} puts one question to a reflected own-key population
+ * before it walks: whether the key at each position is that position's decimal
+ * text, with `length` last. Building that text is the whole cost of the
+ * question, so every answer this table covers is built once — while this module
+ * evaluates, through the captured `text` coercion — and compared rather than
+ * rebuilt per call.
+ *
+ * The table's length is a COST bound and never an answer bound. A position past
+ * the end is compared against the same coercion the table was built from, so an
+ * array of any length reaches the same verdict, the same entries, and the same
+ * `dense` fact; only the price of the comparison differs. Nothing here selects
+ * an algorithm, and no companion limit constant gates one: an index below 1024
+ * is compared against text already built, an index above it against text built
+ * on the spot, and the snapshot is identical either way. A slot the fill below
+ * failed to write would compare unequal and send that population down the walk,
+ * which is the same answer more slowly — so even a damaged table decides cost
+ * alone.
+ *
+ * @example
+ * ```ts
+ * INDEX_TEXTS[7] // '7'
+ * ```
+ */
+export const INDEX_TEXTS: readonly string[] = new INTRINSICS.list<string>()
+// Filled in place through the captured write, ascending, and frozen after: the
+// published type stays readonly while the table is built, and an array appended
+// in order carries no hole for the per-position comparison to step over.
+for (let index = 0; index < 1024; index += 1) {
+	INTRINSICS.write(INDEX_TEXTS, index, INTRINSICS.text(index))
+}
+INTRINSICS.freeze(INDEX_TEXTS)
+
 // JSON-related constants. Kept as plain frozen data so the shipped combinators
 // and parsers operate on them directly — there is deliberately no bespoke
 // JSON-Schema guard (AGENTS §14 — the deep recursive validators stay out by
